{% extends 'base.html.twig' %}
{% block title %}📥 Importer : {{ deck.titre }}{% endblock %}

{% block body %}
<style>
:root {
  --coral: #FF6B6B; --coral-lt: #FFF0F0; --coral-dk: #D93636;
  --teal: #20C9A0; --teal-lt: #E3FAF4; --teal-dk: #0EA37E;
  --lemon: #FFD93D; --lemon-lt: #FFFBE6;
  --lilac: #A78BFA; --lilac-lt: #F0EBFF;
  --sky: #38BDF8; --sky-lt: #E8F6FF;
  --ink: #1E1B3A; --ink-2: #4A4768;
  --muted: #9095B0; --border: #EBEEf8;
  --bg: #F7F9FF; --card: #FFFFFF;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: var(--bg); color: var(--ink); min-height: 100vh; display: flex; align-items: center; justify-content: center; }

.container { max-width: 700px; margin: 2rem auto; padding: 0 1rem; width: 100%; }

/* Import Card */
.import-card {
  background: var(--card);
  border-radius: 24px;
  box-shadow: 0 8px 40px rgba(30,27,58,.13);
  overflow: hidden;
  animation: slideUp 0.4s ease;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.card-header {
  background: linear-gradient(135deg, var(--teal) 0%, var(--sky) 100%);
  padding: 2.5rem 2rem;
  text-align: center;
  color: white;
}

.icon-badge {
  width: 80px;
  height: 80px;
  background: rgba(255,255,255,.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  margin: 0 auto 1rem;
  backdrop-filter: blur(10px);
}

.card-header h1 {
  font-size: 1.8rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.card-header p {
  opacity: 0.9;
  font-size: 1rem;
}

/* Deck Preview */
.deck-preview {
  padding: 2rem;
}

.deck-title {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid var(--border);
}

.deck-emoji {
  font-size: 3rem;
  flex-shrink: 0;
}

.deck-title-text {
  flex: 1;
}

.deck-title-text h2 {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 0.3rem;
}

.deck-subtitle {
  color: var(--muted);
  font-size: 0.9rem;
  font-weight: 600;
}

/* Info Stats */
.info-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.stat-card {
  background: var(--bg);
  padding: 1.2rem;
  border-radius: 12px;
  text-align: center;
  border: 2px solid var(--border);
  transition: all 0.3s;
}

.stat-card:hover {
  border-color: var(--teal);
  transform: translateY(-2px);
}

.stat-icon {
  font-size: 2rem;
  margin-bottom: 0.5rem;
  display: block;
}

.stat-label {
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  color: var(--muted);
  letter-spacing: 0.05em;
  margin-bottom: 0.3rem;
}

.stat-value {
  font-size: 1.3rem;
  font-weight: 800;
  color: var(--ink);
}

/* Description */
.description-section {
  background: var(--lemon-lt);
  padding: 1.2rem;
  border-radius: 12px;
  border-left: 4px solid var(--lemon);
  margin-bottom: 1.5rem;
}

.description-label {
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.description-text {
  color: var(--ink-2);
  line-height: 1.6;
  font-size: 0.95rem;
}

/* Warning Box */
.warning-box {
  background: var(--coral-lt);
  border-left: 4px solid var(--coral);
  padding: 1rem 1.2rem;
  border-radius: 12px;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: start;
  gap: 0.8rem;
}

.warning-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.warning-content {
  flex: 1;
}

.warning-title {
  font-weight: 700;
  color: var(--coral-dk);
  margin-bottom: 0.3rem;
  font-size: 0.95rem;
}

.warning-text {
  color: var(--ink-2);
  font-size: 0.85rem;
  line-height: 1.5;
}

/* Action Buttons */
.action-section {
  padding: 1.5rem 2rem 2rem;
  background: var(--bg);
  border-top: 2px solid var(--border);
}

form {
  margin: 0;
}

.button-group {
  display: flex;
  gap: 1rem;
  justify-content: center;
}

.btn {
  padding: 1rem 2rem;
  border-radius: 12px;
  font-weight: 800;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
  border: none;
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  justify-content: center;
  flex: 1;
  max-width: 250px;
}

.btn-import {
  background: var(--teal);
  color: white;
  box-shadow: 0 4px 14px rgba(32,201,160,.3);
}

.btn-import:hover {
  background: var(--teal-dk);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(32,201,160,.4);
}

.btn-import:active {
  transform: translateY(0);
}

.btn-cancel {
  background: white;
  color: var(--ink-2);
  border: 2px solid var(--border);
}

.btn-cancel:hover {
  border-color: var(--ink-2);
  background: var(--bg);
}

/* Success Animation */
.success-icon {
  display: inline-block;
  animation: bounce 0.6s ease;
}

@keyframes bounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* Responsive */
@media (max-width: 640px) {
  .info-stats {
    grid-template-columns: 1fr;
  }
  
  .button-group {
    flex-direction: column;
  }
  
  .btn {
    max-width: none;
  }
}
</style>

<div class="container">
  
  <div class="import-card">
    
    <!-- Header -->
    <div class="card-header">
      <div class="icon-badge">📥</div>
      <h1>Importer ce Deck</h1>
      <p>Ajoutez ce deck de flashcards à votre collection</p>
    </div>

    <!-- Deck Preview -->
    <div class="deck-preview">
      
      <!-- Title -->
      <div class="deck-title">
        <span class="deck-emoji">{{ deck.emoji|default('📚') }}</span>
        <div class="deck-title-text">
          <h2>{{ deck.titre }}</h2>
          <div class="deck-subtitle">Partagé par {{ deck.user.email|default('un utilisateur') }}</div>
        </div>
      </div>

      <!-- Stats -->
      <div class="info-stats">
        <div class="stat-card">
          <span class="stat-icon">🃏</span>
          <div class="stat-label">Flashcards</div>
          <div class="stat-value">{{ flashcardsCount }}</div>
        </div>
        
        <div class="stat-card">
          <span class="stat-icon">📂</span>
          <div class="stat-label">Catégorie</div>
          <div class="stat-value">{{ deck.categorie|default('Général') }}</div>
        </div>
        
        {% if deck.matiere %}
        <div class="stat-card">
          <span class="stat-icon">📖</span>
          <div class="stat-label">Matière</div>
          <div class="stat-value">{{ deck.matiere }}</div>
        </div>
        {% endif %}
        
        {% if deck.niveau %}
        <div class="stat-card">
          <span class="stat-icon">🎓</span>
          <div class="stat-label">Niveau</div>
          <div class="stat-value">{{ deck.niveau }}</div>
        </div>
        {% endif %}
      </div>

      <!-- Description -->
      {% if deck.description %}
      <div class="description-section">
        <div class="description-label">📝 Description</div>
        <div class="description-text">{{ deck.description }}</div>
      </div>
      {% endif %}

      <!-- Warning -->
      <div class="warning-box">
        <span class="warning-icon">ℹ️</span>
        <div class="warning-content">
          <div class="warning-title">Ce qui sera importé</div>
          <div class="warning-text">
            Une copie de ce deck et de ses {{ flashcardsCount }} flashcard{{ flashcardsCount > 1 ? 's' : '' }} 
            sera créée dans votre collection. Le deck original ne sera pas modifié.
          </div>
        </div>
      </div>

    </div>

    <!-- Action Buttons -->
    <div class="action-section">
      <form method="post" action="{{ path('app_qrcode_import', {token: token}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('import_deck') }}">
        
        <div class="button-group">
          {% if app.user %}
            <button type="submit" class="btn btn-import">
              <span class="success-icon">✨</span>
              Importer ce Deck
            </button>
          {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-import" style="justify-content:center;">
              🔐 Se connecter pour importer
            </a>
          {% endif %}
          
          <a href="{{ path('app_revisions') }}" class="btn btn-cancel">
            ✖️ Annuler
          </a>
        </div>
      </form>
    </div>

  </div>

</div>

{% endblock %}
