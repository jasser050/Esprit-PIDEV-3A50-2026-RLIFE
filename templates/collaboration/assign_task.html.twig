{% extends 'base.html.twig' %}

{% block title %}Assigner la tâche - {{ assignment.titre }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="mb-6">
            <h1 class="text-3xl font-bold mb-2">Assigner la tâche</h1>
            <p class="text-gray-600">Tâche : {{ assignment.titre }}</p>
            <p class="text-sm text-gray-500">Projet : {{ assignment.project.titre }}</p>
        </div>

        <!-- Formulaire d'assignation -->
        <div class="bg-white shadow-md rounded-lg p-6 mb-8">
            <h2 class="text-xl font-semibold mb-4">Assigner à un collaborateur</h2>
            
            <form method="post">
                <div class="mb-4">
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                        Email de l'utilisateur
                    </label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        required
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        placeholder="utilisateur@example.com"
                    >
                    <p class="text-xs text-gray-500 mt-1">
                        ⚠️ Le projet doit d'abord être partagé avec cet utilisateur
                    </p>
                </div>

                <button 
                    type="submit" 
                    class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition"
                >
                    Assigner la tâche
                </button>
                
                <a 
                    href="{{ path('app_assignments_show', {id: assignment.id}) }}" 
                    class="ml-4 text-gray-600 hover:text-gray-800"
                >
                    Annuler
                </a>
            </form>
        </div>

        <!-- Liste des collaborateurs assignés -->
        <div class="bg-white shadow-md rounded-lg p-6">
            <h2 class="text-xl font-semibold mb-4">
                Collaborateurs assignés ({{ collaborators|length }})
            </h2>
            
            {% if collaborators|length > 0 %}
                <div class="space-y-4">
                    {% for collaborator in collaborators %}
                        <div class="flex justify-between items-center p-4 bg-gray-50 rounded-lg">
                            <div>
                                <p class="font-medium text-gray-800">{{ collaborator.user.email }}</p>
                                <p class="text-xs text-gray-400">
                                    Assigné par {{ collaborator.assignedByUser.email }} le {{ collaborator.createdAt|date('d/m/Y à H:i') }}
                                </p>
                            </div>
                            
                            <form method="post" action="{{ path('app_collaboration_remove_collaborator', {assignmentId: assignment.id, collaboratorId: collaborator.id}) }}" class="inline">
                                <button 
                                    type="submit" 
                                    class="text-red-600 hover:text-red-800 text-sm"
                                    onclick="return confirm('Êtes-vous sûr de vouloir retirer ce collaborateur ?')"
                                >
                                    Retirer
                                </button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-gray-600">Cette tâche n'est assignée à personne pour le moment.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
