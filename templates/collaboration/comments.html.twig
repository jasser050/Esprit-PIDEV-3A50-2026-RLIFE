{% extends 'base.html.twig' %}

{% block title %}Commentaires - {{ assignment.titre }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold">Commentaires sur la tâche : {{ assignment.titre }}</h1>

    <div class="card p-6">
        {{ form_start(form) }}
            {{ form_row(form.content, {'attr': {'rows': 4, 'placeholder': 'Ajouter un commentaire...'}}) }}
            <button type="submit" class="btn btn-primary mt-4">
                <i data-lucide="send" class="w-5 h-5"></i>
                Envoyer
            </button>
        {{ form_end(form) }}
    </div>

    <div id="comments-list" class="space-y-4">
        {% for comment in comments %}
            <div id="comment-{{ comment.id }}" class="card p-5">
                <div class="flex justify-between items-start">
                    <div>
                        <strong>{{ comment.user.fullName ?? comment.user.email }}</strong>
                        <span class="text-sm text-secondary-500 ml-3">{{ comment.createdAt|date('d/m/Y H:i') }}</span>
                    </div>
                    {% if comment.user == app.user %}
                        <form method="post" action="{{ path('app_collaboration_delete_comment', {'id': comment.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-comment' ~ comment.id) }}">
                            <button type="submit" class="text-danger-600 hover:text-danger-800">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    {% endif %}
                </div>
                <p class="mt-3 whitespace-pre-wrap">{{ comment.content|nl2br }}</p>
            </div>
        {% else %}
            <p class="text-center text-secondary-500">Aucun commentaire pour le moment.</p>
        {% endfor %}
    </div>
</div>

<script src="https://js.pusher.com/8.4/pusher.min.js"></script>
<script>
    const pusher = new Pusher('{{ pusher_app_key|default('your_key') }}', {
        cluster: '{{ pusher_app_cluster|default('your_cluster') }}',
        forceTLS: true
    });

    const channel = pusher.subscribe('comments-channel-{{ assignment.id }}');

    channel.bind('new-comment', function(data) {
        const list = document.getElementById('comments-list');
        const div = document.createElement('div');
        div.id = 'comment-' + data.comment_id;
        div.className = 'card p-5';
        div.innerHTML = `
            <div class="flex justify-between items-start">
                <div>
                    <strong>${data.author}</strong>
                    <span class="text-sm text-secondary-500 ml-3">${data.created_at}</span>
                </div>
            </div>
            <p class="mt-3 whitespace-pre-wrap">${data.content.replace(/\n/g, '<br>')}</p>
        `;
        list.prepend(div);
    });

    channel.bind('comment-deleted', function(data) {
        const comment = document.getElementById('comment-' + data.comment_id);
        if (comment) comment.remove();
    });
</script>
{% endblock %}