{% extends 'admin/base_admin.html.twig' %}

{% block title %}Statistics{% endblock %}

{% block body %}
<!-- Animated Background Pattern -->
<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 right-1/4 w-96 h-96 rounded-full opacity-10 animate-pulse" style="background: radial-gradient(circle, #06b6d4 0%, transparent 70%); animation-duration: 5s;"></div>
    <div class="absolute bottom-1/4 left-1/4 w-96 h-96 rounded-full opacity-10 animate-pulse" style="background: radial-gradient(circle, #10b981 0%, transparent 70%); animation-duration: 6s; animation-delay: 1s;"></div>
    <div class="absolute top-1/3 left-1/2 w-96 h-96 rounded-full opacity-10 animate-pulse" style="background: radial-gradient(circle, #a855f7 0%, transparent 70%); animation-duration: 7s; animation-delay: 2s;"></div>
</div>

<!-- Page Header with Gradient -->
<div class="mb-10">
    <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
        <div>
            <h1 class="text-4xl font-black mb-2" style="background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 40%, #a855f7 80%, #ec4899 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                Analytics & Insights
            </h1>
            <p class="text-slate-600 dark:text-slate-400 flex items-center gap-2 text-lg">
                <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
                <span>Real-time statistics and data visualization for RLIFE platform</span>
            </p>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_admin_statistics_export') }}" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:scale-105 hover:shadow-lg inline-flex items-center gap-2" style="background: linear-gradient(135deg, #06b6d4, #3b82f6); box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);">
                <i data-lucide="download" class="w-4 h-4"></i>
                <span>Export Report</span>
            </a>
            <button class="px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 hover:border-blue-300 dark:hover:border-blue-600 transition-all inline-flex items-center gap-2">
                <i data-lucide="calendar" class="w-4 h-4"></i>
                <span>Last 7 Days</span>
            </button>
        </div>
    </div>
</div>

<!-- Main Charts Grid -->
<div class="grid grid-cols-1 gap-6 mb-8 lg:grid-cols-2">
    <!-- User Growth Chart with Gradient Card -->
    <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-3xl border-2 border-slate-200 dark:border-slate-800 hover:border-blue-300 dark:hover:border-blue-600 transition-all duration-300 hover:shadow-2xl group">
        <!-- Gradient Header -->
        <div class="p-6 pb-4 border-b-2 border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1), rgba(59, 130, 246, 0.1));">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                        <i data-lucide="trending-up" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-black text-slate-900 dark:text-white">User Growth</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Last 7 days performance</p>
                    </div>
                </div>
                <div class="px-3 py-1.5 rounded-lg text-xs font-bold text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-900/30">
                    <i data-lucide="arrow-up" class="w-3 h-3 inline"></i> +24%
                </div>
            </div>
        </div>
        <!-- Chart Container -->
        <div class="p-6">
            <div class="h-72 relative">
                <canvas id="userGrowthChart"></canvas>
            </div>
            <!-- Chart Stats -->
            <div class="mt-4 grid grid-cols-3 gap-4">
                <div class="text-center p-3 rounded-xl bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 border border-blue-200 dark:border-blue-800">
                    <p class="text-2xl font-black text-slate-900 dark:text-white">{{ user_growth|reduce((sum, g) => sum + g.count, 0) }}</p>
                    <p class="text-xs text-slate-600 dark:text-slate-400 font-semibold mt-1">Total New</p>
                </div>
                <div class="text-center p-3 rounded-xl bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 border border-purple-200 dark:border-purple-800">
                    <p class="text-2xl font-black text-slate-900 dark:text-white">{{ (user_growth|reduce((sum, g) => sum + g.count, 0) / 7)|round(1) }}</p>
                    <p class="text-xs text-slate-600 dark:text-slate-400 font-semibold mt-1">Avg/Day</p>
                </div>
                <div class="text-center p-3 rounded-xl bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 border border-green-200 dark:border-green-800">
                    <p class="text-2xl font-black text-slate-900 dark:text-white">{{ user_growth|last.count }}</p>
                    <p class="text-xs text-slate-600 dark:text-slate-400 font-semibold mt-1">Today</p>
                </div>
            </div>
        </div>
        <div class="absolute top-0 right-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(59, 130, 246, 0.2), transparent); filter: blur(40px);"></div>
    </div>

    <!-- Gender Distribution with Gradient Card -->
    <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-3xl border-2 border-slate-200 dark:border-slate-800 hover:border-purple-300 dark:hover:border-purple-600 transition-all duration-300 hover:shadow-2xl group">
        <!-- Gradient Header -->
        <div class="p-6 pb-4 border-b-2 border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.1), rgba(236, 72, 153, 0.1));">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #a855f7, #ec4899);">
                        <i data-lucide="pie-chart" class="w-6 h-6 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-black text-slate-900 dark:text-white">Gender Distribution</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">User demographics breakdown</p>
                    </div>
                </div>
                <div class="px-3 py-1.5 rounded-lg text-xs font-bold text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-900/30">
                    <i data-lucide="users" class="w-3 h-3 inline"></i> Diversity
                </div>
            </div>
        </div>
        <!-- Chart Container -->
        <div class="p-6">
            <div class="h-72 flex items-center justify-center">
                <canvas id="genderChart"></canvas>
            </div>
            <!-- Gender Stats List -->
            <div class="mt-6 space-y-3">
                {% for stat in gender_stats %}
                <div class="flex items-center justify-between p-3 rounded-xl bg-gradient-to-r from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-700 hover:scale-105 transition-transform">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center shadow-md" 
                             style="background: {% if stat.gender == 'male' %}linear-gradient(135deg, #3b82f6, #06b6d4){% elseif stat.gender == 'female' %}linear-gradient(135deg, #ec4899, #f43f5e){% else %}linear-gradient(135deg, #a855f7, #7c3aed){% endif %};">
                            <i data-lucide="{% if stat.gender == 'male' %}user{% elseif stat.gender == 'female' %}user{% else %}users{% endif %}" class="w-5 h-5 text-white"></i>
                        </div>
                        <span class="font-bold text-slate-900 dark:text-white capitalize">{{ stat.gender }}</span>
                    </div>
                    <div class="text-right">
                        <p class="text-lg font-black text-slate-900 dark:text-white">{{ stat.count }}</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">users</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        <div class="absolute bottom-0 left-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(168, 85, 247, 0.2), transparent); filter: blur(40px);"></div>
    </div>
</div>

<!-- University Distribution - Stunning Design -->
<div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-3xl border-2 border-slate-200 dark:border-slate-800 hover:border-green-300 dark:hover:border-green-600 transition-all duration-300 hover:shadow-2xl group mb-8">
    <!-- Gradient Header -->
    <div class="p-6 pb-4 border-b-2 border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1));">
        <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #10b981, #059669);">
                    <i data-lucide="graduation-cap" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h2 class="text-xl font-black text-slate-900 dark:text-white">Top Universities</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Leading academic institutions</p>
                </div>
            </div>
            <div class="px-3 py-1.5 rounded-lg text-xs font-bold text-green-700 dark:text-green-300 bg-green-100 dark:bg-green-900/30">
                <i data-lucide="trophy" class="w-3 h-3 inline"></i> Top 5
            </div>
        </div>
    </div>
    
    <!-- University Cards Grid -->
    <div class="p-6">
        {% set total = university_stats|reduce((sum, stat) => sum + stat.count, 0) %}
        {% set colors = [
            {from: '#06b6d4', to: '#3b82f6', light: 'from-cyan-500 to-blue-500', border: 'border-cyan-200 dark:border-cyan-800', bg: 'from-cyan-50 to-blue-50 dark:from-cyan-900/20 dark:to-blue-900/20'},
            {from: '#10b981', to: '#059669', light: 'from-emerald-500 to-green-600', border: 'border-emerald-200 dark:border-emerald-800', bg: 'from-emerald-50 to-green-50 dark:from-emerald-900/20 dark:to-green-900/20'},
            {from: '#a855f7', to: '#7c3aed', light: 'from-purple-500 to-violet-600', border: 'border-purple-200 dark:border-purple-800', bg: 'from-purple-50 to-violet-50 dark:from-purple-900/20 dark:to-violet-900/20'},
            {from: '#f59e0b', to: '#ef4444', light: 'from-amber-500 to-red-500', border: 'border-amber-200 dark:border-amber-800', bg: 'from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20'},
            {from: '#ec4899', to: '#f43f5e', light: 'from-pink-500 to-rose-500', border: 'border-pink-200 dark:border-pink-800', bg: 'from-pink-50 to-rose-50 dark:from-pink-900/20 dark:to-rose-900/20'}
        ] %}
        
        <div class="space-y-4">
            {% for stat in university_stats %}
            {% set color = colors[loop.index0] %}
            {% set percentage = (stat.count / total * 100)|round(1) %}
            
            <div class="relative group/item hover:scale-105 transition-all duration-300">
                <!-- Rank Badge -->
                <div class="absolute -left-3 -top-3 w-12 h-12 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-lg z-10 transform group-hover/item:rotate-12 transition-transform" 
                     style="background: linear-gradient(135deg, {{ color.from }}, {{ color.to }});">
                    #{{ loop.index }}
                </div>
                
                <!-- University Card -->
                <div class="ml-6 p-5 rounded-2xl border-2 {{ color.border }} bg-gradient-to-br {{ color.bg }} hover:shadow-xl transition-all">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-lg flex items-center justify-center shadow-md" 
                                 style="background: linear-gradient(135deg, {{ color.from }}, {{ color.to }});">
                                <i data-lucide="school" class="w-5 h-5 text-white"></i>
                            </div>
                            <div>
                                <h3 class="font-black text-lg text-slate-900 dark:text-white">{{ stat.university }}</h3>
                                <p class="text-xs text-slate-600 dark:text-slate-400 font-semibold">Academic Institution</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-3xl font-black text-slate-900 dark:text-white">{{ stat.count }}</p>
                            <p class="text-xs text-slate-600 dark:text-slate-400 font-semibold">Students</p>
                        </div>
                    </div>
                    
                    <!-- Animated Progress Bar -->
                    <div class="relative">
                        <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300 mb-2">
                            <span>Student Distribution</span>
                            <span class="px-2 py-1 rounded-lg" style="background: linear-gradient(135deg, {{ color.from }}, {{ color.to }}); color: white;">{{ percentage }}%</span>
                        </div>
                        <div class="h-3 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden shadow-inner">
                            <div class="h-full rounded-full shadow-lg transition-all duration-1000 ease-out transform origin-left" 
                                 style="background: linear-gradient(90deg, {{ color.from }}, {{ color.to }}); width: {{ percentage }}%; animation: slideIn 1s ease-out {{ loop.index0 * 0.1 }}s both;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="text-center py-12">
                <div class="w-16 h-16 mx-auto rounded-2xl flex items-center justify-center mb-4" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1));">
                    <i data-lucide="inbox" class="w-8 h-8 text-slate-400"></i>
                </div>
                <p class="text-slate-500 dark:text-slate-400 font-semibold">No university data available</p>
            </div>
            {% endfor %}
        </div>
    </div>
    
    <div class="absolute top-0 right-0 w-40 h-40 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(16, 185, 129, 0.2), transparent); filter: blur(50px);"></div>
</div>

<!-- Additional Analytics Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Active Users Card -->
    <div class="relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:scale-105 hover:shadow-2xl cursor-pointer group" style="background: linear-gradient(135deg, #06b6d4, #3b82f6); box-shadow: 0 10px 25px rgba(59, 130, 246, 0.3);">
        <div class="absolute top-0 right-0 w-24 h-24 rounded-full opacity-20 group-hover:scale-150 transition-transform duration-500" style="background: rgba(255, 255, 255, 0.3); filter: blur(30px);"></div>
        <div class="relative">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4 shadow-xl" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px);">
                <i data-lucide="zap" class="w-7 h-7 text-white"></i>
            </div>
            <p class="text-4xl font-black text-white mb-2">1,248</p>
            <p class="text-sm font-semibold text-white/90">Active Users</p>
            <p class="text-xs text-white/70 mt-2">↑ 15% from last week</p>
        </div>
    </div>
    
    <!-- Course Enrollments -->
    <div class="relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:scale-105 hover:shadow-2xl cursor-pointer group" style="background: linear-gradient(135deg, #10b981, #059669); box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);">
        <div class="absolute top-0 right-0 w-24 h-24 rounded-full opacity-20 group-hover:scale-150 transition-transform duration-500" style="background: rgba(255, 255, 255, 0.3); filter: blur(30px);"></div>
        <div class="relative">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4 shadow-xl" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px);">
                <i data-lucide="book-open" class="w-7 h-7 text-white"></i>
            </div>
            <p class="text-4xl font-black text-white mb-2">3,567</p>
            <p class="text-sm font-semibold text-white/90">Course Enrollments</p>
            <p class="text-xs text-white/70 mt-2">↑ 28% growth rate</p>
        </div>
    </div>
    
    <!-- Avg Session Time -->
    <div class="relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:scale-105 hover:shadow-2xl cursor-pointer group" style="background: linear-gradient(135deg, #a855f7, #7c3aed); box-shadow: 0 10px 25px rgba(168, 85, 247, 0.3);">
        <div class="absolute top-0 right-0 w-24 h-24 rounded-full opacity-20 group-hover:scale-150 transition-transform duration-500" style="background: rgba(255, 255, 255, 0.3); filter: blur(30px);"></div>
        <div class="relative">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-4 shadow-xl" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px);">
                <i data-lucide="clock" class="w-7 h-7 text-white"></i>
            </div>
            <p class="text-4xl font-black text-white mb-2">24m</p>
            <p class="text-sm font-semibold text-white/90">Avg Session Time</p>
            <p class="text-xs text-white/70 mt-2">↑ 8% improvement</p>
        </div>
    </div>
</div>

<style>
@keyframes slideIn {
    from {
        transform: scaleX(0);
    }
    to {
        transform: scaleX(1);
    }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Configure Chart.js defaults for modern look
Chart.defaults.font.family = "'Inter', system-ui, -apple-system, sans-serif";
Chart.defaults.color = document.documentElement.classList.contains('dark') ? '#94a3b8' : '#64748b';

// User Growth Chart with Stunning Animations
const userGrowthCtx = document.getElementById('userGrowthChart').getContext('2d');

// Create gradient for area fill
const gradient = userGrowthCtx.createLinearGradient(0, 0, 0, 400);
gradient.addColorStop(0, 'rgba(6, 182, 212, 0.4)');
gradient.addColorStop(0.5, 'rgba(59, 130, 246, 0.2)');
gradient.addColorStop(1, 'rgba(59, 130, 246, 0.0)');

// Create gradient for line
const lineGradient = userGrowthCtx.createLinearGradient(0, 0, 600, 0);
lineGradient.addColorStop(0, '#06b6d4');
lineGradient.addColorStop(0.5, '#3b82f6');
lineGradient.addColorStop(1, '#4f46e5');

new Chart(userGrowthCtx, {
    type: 'line',
    data: {
        labels: {{ user_growth|map(g => g.date)|json_encode|raw }},
        datasets: [{
            label: 'New Users',
            data: {{ user_growth|map(g => g.count)|json_encode|raw }},
            borderColor: lineGradient,
            backgroundColor: gradient,
            borderWidth: 4,
            pointRadius: 6,
            pointHoverRadius: 10,
            pointBackgroundColor: '#ffffff',
            pointBorderColor: lineGradient,
            pointBorderWidth: 3,
            pointHoverBackgroundColor: '#3b82f6',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3,
            tension: 0.4,
            fill: true,
            cubicInterpolationMode: 'monotone'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: {
            duration: 2000,
            easing: 'easeInOutQuart',
            onComplete: function() {
                // Add bounce animation to points
                this.update({
                    duration: 400,
                    easing: 'easeOutBounce'
                });
            }
        },
        interaction: {
            intersect: false,
            mode: 'index'
        },
        plugins: {
            legend: {
                display: false
            },
            tooltip: {
                enabled: true,
                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                titleColor: '#fff',
                bodyColor: '#e2e8f0',
                titleFont: {
                    size: 14,
                    weight: 'bold'
                },
                bodyFont: {
                    size: 13
                },
                padding: 12,
                borderColor: 'rgba(59, 130, 246, 0.5)',
                borderWidth: 2,
                displayColors: false,
                callbacks: {
                    label: function(context) {
                        return 'New Users: ' + context.parsed.y;
                    }
                }
            }
        },
        scales: {
            x: {
                grid: {
                    display: false
                },
                ticks: {
                    font: {
                        size: 12,
                        weight: '600'
                    },
                    color: document.documentElement.classList.contains('dark') ? '#94a3b8' : '#64748b'
                }
            },
            y: {
                beginAtZero: true,
                grid: {
                    color: document.documentElement.classList.contains('dark') ? 'rgba(51, 65, 85, 0.5)' : 'rgba(226, 232, 240, 0.8)',
                    drawBorder: false
                },
                ticks: {
                    stepSize: 1,
                    font: {
                        size: 12,
                        weight: '600'
                    },
                    color: document.documentElement.classList.contains('dark') ? '#94a3b8' : '#64748b',
                    padding: 10
                }
            }
        }
    }
});

// Gender Distribution Chart with Beautiful Animations
const genderCtx = document.getElementById('genderChart').getContext('2d');

// Create gradients for each gender
const maleGradient = genderCtx.createLinearGradient(0, 0, 0, 300);
maleGradient.addColorStop(0, '#06b6d4');
maleGradient.addColorStop(1, '#3b82f6');

const femaleGradient = genderCtx.createLinearGradient(0, 0, 0, 300);
femaleGradient.addColorStop(0, '#ec4899');
femaleGradient.addColorStop(1, '#f43f5e');

const otherGradient = genderCtx.createLinearGradient(0, 0, 0, 300);
otherGradient.addColorStop(0, '#a855f7');
otherGradient.addColorStop(1, '#7c3aed');

// Get gender data
const genderLabels = {{ gender_stats|map(g => g.gender|capitalize)|json_encode|raw }};
const genderData = {{ gender_stats|map(g => g.count)|json_encode|raw }};

// Assign colors based on gender
const backgroundColors = genderLabels.map(label => {
    if (label.toLowerCase() === 'male') return maleGradient;
    if (label.toLowerCase() === 'female') return femaleGradient;
    return otherGradient;
});

const borderColors = genderLabels.map(label => {
    if (label.toLowerCase() === 'male') return '#3b82f6';
    if (label.toLowerCase() === 'female') return '#ec4899';
    return '#a855f7';
});

new Chart(genderCtx, {
    type: 'doughnut',
    data: {
        labels: genderLabels,
        datasets: [{
            data: genderData,
            backgroundColor: backgroundColors,
            borderColor: borderColors,
            borderWidth: 4,
            hoverOffset: 25,
            hoverBorderWidth: 5,
            hoverBorderColor: '#ffffff',
            spacing: 2
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: {
            animateRotate: true,
            animateScale: true,
            duration: 2000,
            easing: 'easeInOutQuart'
        },
        plugins: {
            legend: {
                display: true,
                position: 'bottom',
                labels: {
                    padding: 20,
                    font: {
                        size: 13,
                        weight: '600'
                    },
                    color: document.documentElement.classList.contains('dark') ? '#e2e8f0' : '#334155',
                    usePointStyle: true,
                    pointStyle: 'circle',
                    generateLabels: function(chart) {
                        const data = chart.data;
                        if (data.labels.length && data.datasets.length) {
                            return data.labels.map(function(label, i) {
                                const value = data.datasets[0].data[i];
                                const total = data.datasets[0].data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / total) * 100).toFixed(1);
                                
                                return {
                                    text: `${label}: ${value} (${percentage}%)`,
                                    fillStyle: data.datasets[0].borderColor[i],
                                    hidden: false,
                                    index: i
                                };
                            });
                        }
                        return [];
                    }
                }
            },
            tooltip: {
                enabled: true,
                backgroundColor: 'rgba(15, 23, 42, 0.95)',
                titleColor: '#fff',
                bodyColor: '#e2e8f0',
                titleFont: {
                    size: 14,
                    weight: 'bold'
                },
                bodyFont: {
                    size: 13
                },
                padding: 12,
                borderWidth: 2,
                displayColors: true,
                callbacks: {
                    label: function(context) {
                        const label = context.label || '';
                        const value = context.parsed || 0;
                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                        const percentage = ((value / total) * 100).toFixed(1);
                        return `${label}: ${value} users (${percentage}%)`;
                    }
                }
            }
        },
        cutout: '65%',
        radius: '90%'
    }
});

// Add animation to stats on page load
document.addEventListener('DOMContentLoaded', function() {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '0';
                entry.target.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    entry.target.style.transition = 'all 0.6s ease-out';
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }, 100);
            }
        });
    }, { threshold: 0.1 });

    document.querySelectorAll('.group\\/item').forEach(el => observer.observe(el));
});
</script>
{% endblock %}
