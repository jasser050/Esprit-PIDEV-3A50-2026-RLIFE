{% extends 'admin/base_admin.html.twig' %}

{% block title %}Deck Management{% endblock %}
{% block page_title %}Deck Management{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Deck Management</h1>
            <p class="mt-2 text-slate-600 dark:text-slate-400">Manage flashcard decks for all users</p>
        </div>
        <a href="{{ path('app_admin_deck_new') }}" 
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors shadow-sm">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Create New Deck
        </a>
    </div>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <!-- Total Decks -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <i data-lucide="layers" class="w-6 h-6 text-primary-600 dark:text-primary-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ total_decks }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Total Decks</p>
            </div>
        </div>
    </div>

    <!-- Total Flashcards -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                <i data-lucide="credit-card" class="w-6 h-6 text-success-600 dark:text-success-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ total_flashcards }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Total Flashcards</p>
            </div>
        </div>
    </div>

    <!-- Average Cards per Deck -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-secondary-100 dark:bg-secondary-900/30 flex items-center justify-center">
                <i data-lucide="bar-chart-3" class="w-6 h-6 text-secondary-600 dark:text-secondary-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ total_decks > 0 ? (total_flashcards / total_decks)|round(1) : 0 }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Avg Cards/Deck</p>
            </div>
        </div>
    </div>
</div>

<!-- Decks Grid -->
{% if decks is empty %}
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-12 text-center shadow-sm">
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
            <i data-lucide="layers" class="w-10 h-10 text-slate-400"></i>
        </div>
        <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">No Decks Yet</h3>
        <p class="text-slate-600 dark:text-slate-400 mb-6">Create your first deck to get started</p>
        <a href="{{ path('app_admin_deck_new') }}" 
           class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-xl transition-colors">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Create First Deck
        </a>
    </div>
{% else %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {% set colorPalettes = [
            {from: '#dbeafe', accent: '#2563eb'},
            {from: '#f3e8ff', accent: '#7c3aed'},
            {from: '#fce7f3', accent: '#ec4899'},
            {from: '#d1fae5', accent: '#10b981'},
            {from: '#cffafe', accent: '#06b6d4'},
            {from: '#fef3c7', accent: '#d97706'},
            {from: '#d1fae5', accent: '#059669'},
            {from: '#fae8ff', accent: '#c026d3'},
            {from: '#f3e8ff', accent: '#9333ea'},
            {from: '#e0f2fe', accent: '#0284c7'},
            {from: '#ffe4e6', accent: '#e11d48'},
            {from: '#ecfccb', accent: '#65a30d'}
        ] %}

        {% for deck in decks %}
            {% set palette = colorPalettes[loop.index0 % colorPalettes|length] %}
            <div class="rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 group border flex flex-col"
                 style="background: linear-gradient(to bottom, {{ palette.from }}, white); border-color: {{ palette.from }};">
                
                <!-- Image -->
                <div class="h-32 overflow-hidden relative">
                    {% if deck.image %}
                        <img src="{{ asset('uploads/decks/' ~ deck.image) }}"
                             alt="{{ deck.titre }}"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                    {% else %}
                        <div class="w-full h-full flex items-center justify-center bg-white/50">
                            <i data-lucide="layers" class="w-16 h-16 opacity-80" style="color: {{ palette.accent }};"></i>
                        </div>
                    {% endif %}
                </div>

                <!-- Content -->
                <div class="p-5 flex flex-col flex-grow">
                    <h3 class="text-lg font-semibold mb-2 line-clamp-2" style="color: {{ palette.accent }};">
                        {{ deck.titre }}
                    </h3>

                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2 flex items-center gap-1.5">
                        <i data-lucide="book-open" class="w-4 h-4"></i>
                        {{ deck.matiere }} • {{ deck.niveau }}
                    </p>

                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-4 line-clamp-3 flex-grow">
                        {{ deck.description ?: 'No description' }}
                    </p>

                    <!-- Stats -->
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="px-2.5 py-1 rounded-lg text-xs font-semibold shadow-sm"
                              style="background-color: {{ palette.from }}; color: {{ palette.accent }}; border: 1px solid {{ palette.from }};">
                            <i data-lucide="credit-card" class="w-3 h-3 inline-block mr-1"></i>
                            {{ deck.flashcards|length }} cards
                        </span>
                        {% if deck.pdf %}
                            <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-danger-100 dark:bg-danger-900/30 text-danger-700 dark:text-danger-400">
                                <i data-lucide="file-text" class="w-3 h-3 inline-block mr-1"></i>
                                PDF
                            </span>
                        {% endif %}
                    </div>

                    <p class="text-xs text-slate-400 dark:text-slate-500 mb-4">
                        Created {{ deck.dateCreation|date('M d, Y') }}
                    </p>

                    <!-- Actions -->
                    <div class="flex flex-col gap-2 mt-auto">
                        <a href="{{ path('app_admin_deck_view', {id: deck.id}) }}"
                           class="inline-flex items-center justify-center px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-lg transition-colors">
                            <i data-lucide="eye" class="w-4 h-4 mr-2"></i>
                            View Details
                        </a>
                        
                        <div class="flex gap-2">
                            <a href="{{ path('app_admin_deck_edit', {id: deck.id}) }}"
                               class="flex-1 inline-flex items-center justify-center px-3 py-2 text-sm font-medium rounded-lg transition-colors"
                               style="background-color: #2563eb; color: #ffffff;">
                                <i data-lucide="edit" class="w-4 h-4 mr-1" style="stroke: white;"></i>
                                <span style="color: white;">Edit</span>
                            </a>
                            
                            <button type="button"
                                    onclick="confirmDelete({{ deck.id }}, '{{ deck.titre|e('js') }}')"
                                    class="flex-1 inline-flex items-center justify-center px-3 py-2 bg-danger-600 hover:bg-danger-700 text-white text-sm font-medium rounded-lg transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4 mr-1"></i>
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl max-w-md w-full">
        <div class="p-6 border-b border-slate-200 dark:border-slate-800">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="alert-triangle" class="w-5 h-5 text-danger-500"></i>
                Confirm Deletion
            </h3>
        </div>
        
        <div class="p-6">
            <p class="text-slate-600 dark:text-slate-400 mb-4">
                Are you sure you want to delete the deck "<span id="deckTitle" class="font-semibold text-slate-900 dark:text-white"></span>"?
            </p>
            <p class="text-sm text-danger-600 dark:text-danger-400">
                <i data-lucide="alert-circle" class="w-4 h-4 inline-block mr-1"></i>
                This will also delete all flashcards in this deck. This action cannot be undone.
            </p>
        </div>
        
        <div class="p-6 border-t border-slate-200 dark:border-slate-800 flex justify-end gap-3">
            <button type="button" 
                    onclick="closeDeleteModal()"
                    class="px-6 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-xl transition-colors">
                Cancel
            </button>
            <form id="deleteForm" method="POST" class="inline">
                <button type="submit"
                        class="px-6 py-2.5 bg-danger-600 hover:bg-danger-700 text-white font-medium rounded-xl transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4 inline-block mr-2"></i>
                    Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

<script>
function confirmDelete(deckId, deckTitle) {
    document.getElementById('deckTitle').textContent = deckTitle;
    document.getElementById('deleteForm').action = '/admin/decks/' + deckId + '/delete';
    document.getElementById('deleteModal').classList.remove('hidden');
    
    // Reinitialize Lucide icons
    if (window.lucide) {
        lucide.createIcons();
    }
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
}

// Close modal on Escape key
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeDeleteModal();
    }
});

// Close modal when clicking outside
document.getElementById('deleteModal').addEventListener('click', function(event) {
    if (event.target === this) {
        closeDeleteModal();
    }
});
</script>
{% endblock %}
