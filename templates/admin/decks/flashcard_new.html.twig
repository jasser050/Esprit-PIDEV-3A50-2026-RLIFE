{% extends 'admin/base_admin.html.twig' %}

{% block title %}Add Flashcard{% endblock %}
{% block page_title %}Add Flashcard{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Add Flashcard</h1>
            <p class="mt-2 text-slate-600 dark:text-slate-400">Add a new flashcard to: <span class="font-semibold text-primary-600 dark:text-primary-400">{{ deck.titre }}</span></p>
        </div>
        <a href="{{ path('app_admin_deck_view', {id: deck.id}) }}" 
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-600 hover:bg-slate-700 text-white text-sm font-medium rounded-xl transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Deck
        </a>
    </div>
</div>

<!-- Form Card -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden max-w-4xl mx-auto">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Flashcard Information</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Create a new card with question and answer</p>
    </div>

    <div class="p-6">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'space-y-6'}}) }}
        
        <!-- Title (Optional) -->
        <div>
            {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
            {{ form_widget(form.titre) }}
            {{ form_errors(form.titre) }}
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Optional - A title helps organize your cards</p>
        </div>

        <!-- Question & Answer Row -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Question -->
            <div>
                {{ form_label(form.question, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.question) }}
                {{ form_errors(form.question) }}
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">This is what the user will see first (Front of card)</p>
            </div>

            <!-- Answer -->
            <div>
                {{ form_label(form.reponse, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.reponse) }}
                {{ form_errors(form.reponse) }}
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">This is the answer (Back of card)</p>
            </div>
        </div>

        <!-- Description (Optional) -->
        <div>
            {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Optional - Add hints, context, or additional notes</p>
        </div>

        <!-- Difficulty & Status Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Difficulty Level -->
            <div>
                {{ form_label(form.niveauDifficulte, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.niveauDifficulte) }}
                {{ form_errors(form.niveauDifficulte) }}
                <div class="flex gap-1 mt-2">
                    {% for i in 1..5 %}
                        <div class="w-8 h-2 rounded-full bg-slate-200 dark:bg-slate-700" id="diff-bar-{{ i }}"></div>
                    {% endfor %}
                </div>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">1 = Very Easy, 5 = Very Difficult</p>
            </div>

            <!-- Status -->
            <div>
                {{ form_label(form.etat, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.etat) }}
                {{ form_errors(form.etat) }}
            </div>
        </div>

        <!-- File Uploads -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Image Upload -->
            <div>
                {{ form_label(form.imageFile, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.imageFile) }}
                {{ form_errors(form.imageFile) }}
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    <i data-lucide="info" class="w-3 h-3 inline-block mr-1"></i>
                    Max 5MB - JPEG, PNG, WEBP
                </p>
            </div>

            <!-- PDF Upload -->
            <div>
                {{ form_label(form.pdfFile, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.pdfFile) }}
                {{ form_errors(form.pdfFile) }}
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    <i data-lucide="info" class="w-3 h-3 inline-block mr-1"></i>
                    Max 10MB - PDF only
                </p>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-slate-200 dark:border-slate-800">
            <button type="submit" 
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-success-600 hover:bg-success-700 text-white font-medium rounded-xl transition-colors">
                <i data-lucide="check" class="w-4 h-4"></i>
                Add Flashcard
            </button>
            
            <a href="{{ path('app_admin_deck_view', {id: deck.id}) }}" 
               class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium rounded-xl transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
                Cancel
            </a>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<script>
// Difficulty level visual indicator
const diffInput = document.querySelector('input[name$="[niveauDifficulte]"]');
if (diffInput) {
    function updateDiffBars() {
        const value = parseInt(diffInput.value) || 0;
        for (let i = 1; i <= 5; i++) {
            const bar = document.getElementById('diff-bar-' + i);
            if (bar) {
                if (i <= value) {
                    bar.className = 'w-8 h-2 rounded-full transition-colors ' + 
                        (value <= 2 ? 'bg-success-500' : value <= 4 ? 'bg-warning-500' : 'bg-danger-500');
                } else {
                    bar.className = 'w-8 h-2 rounded-full bg-slate-200 dark:bg-slate-700 transition-colors';
                }
            }
        }
    }
    
    diffInput.addEventListener('input', updateDiffBars);
    diffInput.addEventListener('change', updateDiffBars);
    updateDiffBars(); // Initial state
}
</script>
{% endblock %}