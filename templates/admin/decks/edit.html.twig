{% extends 'admin/base_admin.html.twig' %}

{% block title %}Edit Deck{% endblock %}
{% block page_title %}Edit Deck{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Edit Deck</h1>
            <p class="mt-2 text-slate-600 dark:text-slate-400">Update deck information</p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('app_admin_deck_view', {id: deck.id}) }}" 
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-info-600 hover:bg-info-700 text-white text-sm font-medium rounded-xl transition-colors">
                <i data-lucide="eye" class="w-4 h-4"></i>
                View Deck
            </a>
            <a href="{{ path('app_admin_decks') }}" 
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-600 hover:bg-slate-700 text-white text-sm font-medium rounded-xl transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back
            </a>
        </div>
    </div>
</div>

<!-- Form Card -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Deck Information</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Update the details below</p>
    </div>

    <div class="p-6">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'space-y-6'}}) }}
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Title -->
            <div>
                {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.titre) }}
                {{ form_errors(form.titre) }}
            </div>

            <!-- Subject -->
            <div>
                {{ form_label(form.matiere, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.matiere) }}
                {{ form_errors(form.matiere) }}
            </div>
        </div>

        <!-- Level -->
        <div>
            {{ form_label(form.niveau, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
            {{ form_widget(form.niveau) }}
            {{ form_errors(form.niveau) }}
        </div>

        <!-- Description -->
        <div>
            {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        <!-- Current Image -->
        {% if deck.image %}
        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">Current Image</p>
            <div class="flex items-center gap-4">
                <img src="{{ asset('uploads/decks/' ~ deck.image) }}" 
                     alt="{{ deck.titre }}" 
                     class="w-32 h-32 object-cover rounded-lg border border-slate-200 dark:border-slate-700">
                <div>
                    <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Upload a new image to replace the current one</p>
                    {{ form_widget(form.imageFile) }}
                    {{ form_errors(form.imageFile) }}
                </div>
            </div>
        </div>
        {% else %}
        <!-- Image Upload (no current image) -->
        <div>
            {{ form_label(form.imageFile, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
            {{ form_widget(form.imageFile) }}
            {{ form_errors(form.imageFile) }}
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                <i data-lucide="info" class="w-3 h-3 inline-block mr-1"></i>
                Max 5MB - JPEG, PNG, WEBP
            </p>
        </div>
        {% endif %}

        <!-- Current PDF -->
        {% if deck.pdf %}
        <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
            <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">Current PDF</p>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 px-4 py-3 bg-danger-100 dark:bg-danger-900/30 text-danger-700 dark:text-danger-400 rounded-lg">
                    <i data-lucide="file-text" class="w-5 h-5"></i>
                    <span class="font-medium">PDF Document</span>
                </div>
                <a href="{{ asset('uploads/decks/' ~ deck.pdf) }}" 
                   target="_blank"
                   class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:underline">
                    <i data-lucide="external-link" class="w-4 h-4"></i>
                    View Current PDF
                </a>
            </div>
            <div class="mt-3">
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Upload a new PDF to replace the current one</p>
                {{ form_widget(form.pdfFile) }}
                {{ form_errors(form.pdfFile) }}
            </div>
        </div>
        {% else %}
        <!-- PDF Upload (no current PDF) -->
        <div>
            {{ form_label(form.pdfFile, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
            {{ form_widget(form.pdfFile) }}
            {{ form_errors(form.pdfFile) }}
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                <i data-lucide="info" class="w-3 h-3 inline-block mr-1"></i>
                Max 10MB - PDF only
            </p>
        </div>
        {% endif %}

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
            <button type="submit" 
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-xl transition-colors">
                <i data-lucide="check" class="w-4 h-4"></i>
                Update Deck
            </button>
            
            <a href="{{ path('app_admin_decks') }}" 
               class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium rounded-xl transition-colors">
                <i data-lucide="x" class="w-4 h-4"></i>
                Cancel
            </a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}