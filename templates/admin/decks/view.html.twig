{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ deck.titre }}{% endblock %}
{% block page_title %}Deck Details{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">{{ deck.titre }}</h1>
            <div class="flex flex-wrap items-center gap-2 mt-2">
                <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-400">
                    {{ deck.matiere }}
                </span>
                <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-secondary-100 dark:bg-secondary-900/30 text-secondary-700 dark:text-secondary-400">
                    {{ deck.niveau }}
                </span>
                <span class="text-sm text-slate-500 dark:text-slate-400">
                    <i data-lucide="calendar" class="w-4 h-4 inline-block mr-1"></i>
                    Created {{ deck.dateCreation|date('M d, Y') }}
                </span>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('app_admin_deck_edit', {id: deck.id}) }}" 
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors">
                <i data-lucide="edit" class="w-4 h-4"></i>
                Edit Deck
            </a>
            <a href="{{ path('app_admin_deck_new') }}" 
               class="inline-flex items-center gap-2 px-4 py-2.5 bg-success-600 hover:bg-success-700 text-white text-sm font-medium rounded-xl transition-colors">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Add Flashcard
            </a>
            <button type="button" 
                    onclick="confirmDelete({{ deck.id }}, '{{ deck.titre|e('js') }}')"
                    class="inline-flex items-center gap-2 px-4 py-2.5 bg-danger-600 hover:bg-danger-700 text-white text-sm font-medium rounded-xl transition-colors">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                Delete Deck
            </button>
        </div>
    </div>
</div>

<!-- Deck Details Card -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden mb-8">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Deck Information</h2>
    </div>
    <div class="p-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Image -->
            <div class="lg:col-span-1">
                {% if deck.image %}
                    <img src="{{ asset('uploads/decks/' ~ deck.image) }}" 
                         alt="{{ deck.titre }}"
                         class="w-full h-64 object-cover rounded-xl border border-slate-200 dark:border-slate-700">
                {% else %}
                    <div class="w-full h-64 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-center bg-gradient-to-br from-primary-100 to-primary-50 dark:from-primary-900/20 dark:to-primary-900/10">
                        <i data-lucide="layers" class="w-20 h-20 text-primary-600 dark:text-primary-400"></i>
                    </div>
                {% endif %}
            </div>
            
            <!-- Info -->
            <div class="lg:col-span-2 space-y-4">
                <div>
                    <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-1">Description</h3>
                    <p class="text-slate-600 dark:text-slate-400">
                        {{ deck.description ?: 'No description provided.' }}
                    </p>
                </div>
                
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4">
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ flashcards|length }}</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Flashcards</p>
                    </div>
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ deck.matiere }}</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Subject</p>
                    </div>
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ deck.niveau }}</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Level</p>
                    </div>
                    {% if deck.pdf %}
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl">
                        <a href="{{ asset('uploads/decks/' ~ deck.pdf) }}" 
                           target="_blank"
                           class="inline-flex items-center gap-2 text-danger-600 dark:text-danger-400 hover:underline">
                            <i data-lucide="file-text" class="w-5 h-5"></i>
                            <span class="text-sm font-medium">View PDF</span>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Flashcards Section -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
        <div>
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Flashcards</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{{ flashcards|length }} card(s) in this deck</p>
        </div>
        <a href="{{ path('app_admin_flashcard_new', {deck_id: deck.id}) }}" 
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-success-600 hover:bg-success-700 text-white text-sm font-medium rounded-xl transition-colors">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Add Flashcard
        </a>
    </div>

    <div class="p-6">
        {% if flashcards is empty %}
            <div class="text-center py-12">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                    <i data-lucide="credit-card" class="w-8 h-8 text-slate-400"></i>
                </div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">No Flashcards Yet</h3>
                <p class="text-slate-600 dark:text-slate-400 mb-4">Add flashcards to this deck</p>
                <a href="{{ path('app_admin_flashcard_new', {deck_id: deck.id}) }}" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-success-600 hover:bg-success-700 text-white font-medium rounded-xl transition-colors">
                    <i data-lucide="plus" class="w-5 h-5"></i>
                    Add First Flashcard
                </a>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for flashcard in flashcards %}
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary-300 dark:hover:border-primary-700 transition-colors">
                        <div class="flex items-start justify-between mb-3">
                            <h3 class="font-semibold text-slate-900 dark:text-white">
                                {{ flashcard.titre ?: 'Untitled Card' }}
                            </h3>
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded text-xs font-medium
                                    {% if flashcard.etat == 'maitrisee' %}bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-400
                                    {% elseif flashcard.etat == 'en_cours' %}bg-warning-100 dark:bg-warning-900/30 text-warning-700 dark:text-warning-400
                                    {% else %}bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400{% endif %}">
                                    {{ flashcard.etat|replace({'a_apprendre': 'To Learn', 'en_cours': 'In Progress', 'maitrisee': 'Mastered'}) }}
                                </span>
                                <span class="px-2 py-0.5 rounded text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-400">
                                    Diff: {{ flashcard.niveauDifficulte }}/5
                                </span>
                            </div>
                        </div>
                        
                        <div class="space-y-3 mb-4">
                            <div class="p-3 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700">
                                <p class="text-xs text-slate-500 dark:text-slate-400 mb-1">Question</p>
                                <p class="text-sm text-slate-900 dark:text-white line-clamp-3">{{ flashcard.question }}</p>
                            </div>
                            <div class="p-3 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-700">
                                <p class="text-xs text-slate-500 dark:text-slate-400 mb-1">Answer</p>
                                <p class="text-sm text-slate-900 dark:text-white line-clamp-3">{{ flashcard.reponse }}</p>
                            </div>
                        </div>
                        
                        {% if flashcard.description %}
                            <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">
                                <i data-lucide="info" class="w-3 h-3 inline-block mr-1"></i>
                                {{ flashcard.description|slice(0, 100) }}{% if flashcard.description|length > 100 %}...{% endif %}
                            </p>
                        {% endif %}
                        
                        <div class="flex items-center gap-2 pt-3 border-t border-slate-200 dark:border-slate-700">
                            {% if flashcard.image %}
                                <span class="inline-flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400">
                                    <i data-lucide="image" class="w-3 h-3"></i>
                                    Has image
                                </span>
                            {% endif %}
                            {% if flashcard.pdf %}
                                <span class="inline-flex items-center gap-1 text-xs text-slate-500 dark:text-slate-400">
                                    <i data-lucide="file-text" class="w-3 h-3"></i>
                                    Has PDF
                                </span>
                            {% endif %}
                            
                            <form method="POST" 
                                  action="{{ path('app_admin_flashcard_delete', {id: flashcard.id}) }}"
                                  class="ml-auto"
                                  data-confirm="Are you sure you want to delete this flashcard?">
                                <button type="submit" 
                                        class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-danger-600 dark:text-danger-400 hover:bg-danger-50 dark:hover:bg-danger-900/20 rounded-lg transition-colors">
                                    <i data-lucide="trash-2" class="w-3 h-3"></i>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<!-- Delete Deck Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl max-w-md w-full">
        <div class="p-6 border-b border-slate-200 dark:border-slate-800">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="alert-triangle" class="w-5 h-5 text-danger-500"></i>
                Confirm Deletion
            </h3>
        </div>
        
        <div class="p-6">
            <p class="text-slate-600 dark:text-slate-400 mb-4">
                Are you sure you want to delete the deck "<span id="deckTitle" class="font-semibold text-slate-900 dark:text-white"></span>"?
            </p>
            <p class="text-sm text-danger-600 dark:text-danger-400">
                <i data-lucide="alert-circle" class="w-4 h-4 inline-block mr-1"></i>
                This will also delete all {{ flashcards|length }} flashcard(s) in this deck. This action cannot be undone.
            </p>
        </div>
        
        <div class="p-6 border-t border-slate-200 dark:border-slate-800 flex justify-end gap-3">
            <button type="button" 
                    onclick="closeDeleteModal()"
                    class="px-6 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-xl transition-colors">
                Cancel
            </button>
            <form id="deleteForm" method="POST" class="inline">
                <button type="submit"
                        class="px-6 py-2.5 bg-danger-600 hover:bg-danger-700 text-white font-medium rounded-xl transition-colors">
                    <i data-lucide="trash-2" class="w-4 h-4 inline-block mr-2"></i>
                    Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

<script>
function confirmDelete(deckId, deckTitle) {
    document.getElementById('deckTitle').textContent = deckTitle;
    document.getElementById('deleteForm').action = '/admin/decks/' + deckId + '/delete';
    document.getElementById('deleteModal').classList.remove('hidden');
    
    if (window.lucide) {
        lucide.createIcons();
    }
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
}

document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeDeleteModal();
    }
});

document.getElementById('deleteModal').addEventListener('click', function(event) {
    if (event.target === this) {
        closeDeleteModal();
    }
});
</script>
{% endblock %}
