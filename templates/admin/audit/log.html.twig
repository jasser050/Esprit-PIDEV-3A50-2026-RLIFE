{% extends 'admin/base_admin.html.twig' %}

{% block title %}Audit Log{% endblock %}
{% block page_title %}Audit Log{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Audit Trail</h1>
            <p class="mt-2 text-slate-600 dark:text-slate-400">Track all administrative actions and changes</p>
        </div>
        <a href="{{ path('app_admin_audit_export_csv') }}" 
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors shadow-sm">
            <i data-lucide="download" class="w-4 h-4"></i>
            Export CSV
        </a>
    </div>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-1 gap-4 sm:gap-6 mb-6 sm:grid-cols-3">
    <!-- Total Logs -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center">
                <i data-lucide="activity" class="w-6 h-6 text-primary-600 dark:text-primary-400"></i>
            </div>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ total_logs }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Total Actions</p>
        </div>
    </div>

    <!-- Last 7 Days -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-success-50 dark:bg-success-900/20 flex items-center justify-center">
                <i data-lucide="trending-up" class="w-6 h-6 text-success-600 dark:text-success-400"></i>
            </div>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ logs_last_7_days }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Last 7 Days</p>
        </div>
    </div>

    <!-- Action Types -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-info-50 dark:bg-info-900/20 flex items-center justify-center">
                <i data-lucide="list" class="w-6 h-6 text-info-600 dark:text-info-400"></i>
            </div>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ action_counts|length }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Action Types</p>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 mb-6">
    <form method="get" action="{{ path('app_admin_audit_log') }}" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Action Type Filter -->
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Action Type</label>
                <select name="action_type" class="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
                    <option value="">All Actions</option>
                    <option value="user_banned" {{ filters.action_type == 'user_banned' ? 'selected' : '' }}>User Banned</option>
                    <option value="user_unbanned" {{ filters.action_type == 'user_unbanned' ? 'selected' : '' }}>User Unbanned</option>
                    <option value="user_promoted" {{ filters.action_type == 'user_promoted' ? 'selected' : '' }}>User Promoted</option>
                    <option value="user_demoted" {{ filters.action_type == 'user_demoted' ? 'selected' : '' }}>User Demoted</option>
                    <option value="project_deleted" {{ filters.action_type == 'project_deleted' ? 'selected' : '' }}>Project Deleted</option>
                    <option value="assignment_deleted" {{ filters.action_type == 'assignment_deleted' ? 'selected' : '' }}>Assignment Deleted</option>
                    <option value="deck_deleted" {{ filters.action_type == 'deck_deleted' ? 'selected' : '' }}>Deck Deleted</option>
                    <option value="email_sent" {{ filters.action_type == 'email_sent' ? 'selected' : '' }}>Email Sent</option>
                </select>
            </div>

            <!-- Date From -->
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">From Date</label>
                <input type="date" name="date_from" value="{{ filters.date_from }}" 
                       class="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            </div>

            <!-- Date To -->
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">To Date</label>
                <input type="date" name="date_to" value="{{ filters.date_to }}" 
                       class="w-full px-3 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500">
            </div>

            <!-- Submit Button -->
            <div class="flex items-end">
                <button type="submit" class="w-full px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-lg transition-colors">
                    <i data-lucide="filter" class="w-4 h-4 inline-block mr-2"></i>
                    Apply Filters
                </button>
            </div>
        </div>

        {% if filters.action_type or filters.date_from or filters.date_to %}
        <div class="flex justify-end">
            <a href="{{ path('app_admin_audit_log') }}" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                <i data-lucide="x" class="w-4 h-4 inline-block mr-1"></i>
                Clear Filters
            </a>
        </div>
        {% endif %}
    </form>
</div>

<!-- Audit Log Table -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Activity Log</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ logs|length }} records found</p>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">ID</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Admin</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Action</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Description</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider hidden lg:table-cell">IP Address</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Date</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                {% for log in logs %}
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="text-sm font-mono text-slate-600 dark:text-slate-400">#{{ log.id }}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-xs">
                                {{ log.adminUser ? log.adminUser.firstName|first ~ log.adminUser.lastName|first : 'N/A' }}
                            </div>
                            <div>
                                <p class="text-sm font-medium text-slate-900 dark:text-white">{{ log.adminUser ? log.adminUser.fullName : 'Unknown' }}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-lg {{ log.badgeColorClass }}">
                            <i data-lucide="{{ log.icon }}" class="w-3 h-3"></i>
                            {{ log.actionLabel }}
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md truncate">{{ log.description ?? 'No description' }}</p>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap hidden lg:table-cell">
                        <span class="text-sm font-mono text-slate-500 dark:text-slate-400">{{ log.ipAddress ?? 'N/A' }}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-slate-900 dark:text-white">{{ log.createdAt|date('M d, Y') }}</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ log.createdAt|date('H:i:s') }}</div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                                <i data-lucide="inbox" class="w-6 h-6 text-slate-400"></i>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400">No audit logs found</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
