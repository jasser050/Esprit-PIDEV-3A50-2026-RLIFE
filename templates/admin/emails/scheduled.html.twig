{% extends 'admin/base_admin.html.twig' %}

{% block title %}Scheduled Emails{% endblock %}
{% block page_title %}Scheduled Emails{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Scheduled Emails</h1>
            <p class="mt-2 text-slate-600 dark:text-slate-400">Manage and view scheduled emails</p>
        </div>
        <a href="{{ path('app_admin_email_compose') }}" 
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Compose New Email
        </a>
    </div>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <!-- Total Scheduled -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <i data-lucide="clock" class="w-6 h-6 text-primary-600 dark:text-primary-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ scheduled_emails|length }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Total Scheduled</p>
            </div>
        </div>
    </div>

    <!-- Pending -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                <i data-lucide="hourglass" class="w-6 h-6 text-warning-600 dark:text-warning-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ pending_count }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Pending</p>
            </div>
        </div>
    </div>

    <!-- Sent -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                <i data-lucide="check-circle" class="w-6 h-6 text-success-600 dark:text-success-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ sent_count }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Sent</p>
            </div>
        </div>
    </div>

    <!-- Failed -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center">
                <i data-lucide="x-circle" class="w-6 h-6 text-danger-600 dark:text-danger-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ failed_count }}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">Failed</p>
            </div>
        </div>
    </div>
</div>

<!-- Scheduled Emails Table -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">All Scheduled Emails</h2>
    </div>

    {% if scheduled_emails is empty %}
        <div class="p-12 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                <i data-lucide="calendar-x" class="w-8 h-8 text-slate-400"></i>
            </div>
            <p class="text-slate-500 dark:text-slate-400 mb-4">No scheduled emails found</p>
            <a href="{{ path('app_admin_email_compose') }}" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:underline">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Schedule your first email
            </a>
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Subject</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Recipients</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Scheduled For</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Admin</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    {% for scheduledEmail in scheduled_emails %}
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-slate-900 dark:text-white">
                                    {{ scheduledEmail.subject }}
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-1">
                                    {{ scheduledEmail.message|striptags|slice(0, 60) }}...
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold {{ scheduledEmail.recipientType == 'all' ? 'bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-400' : (scheduledEmail.recipientType == 'active' ? 'bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-400' : (scheduledEmail.recipientType == 'banned' ? 'bg-danger-100 dark:bg-danger-900/30 text-danger-700 dark:text-danger-400' : 'bg-secondary-100 dark:bg-secondary-900/30 text-secondary-700 dark:text-secondary-400')) }}">
                                    {{ scheduledEmail.recipientTypeLabel }}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-slate-900 dark:text-white">
                                    {{ scheduledEmail.scheduledAt|date('M d, Y') }}
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">
                                    {{ scheduledEmail.scheduledAt|date('H:i') }}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold {{ scheduledEmail.statusBadgeClass }}">
                                    {% if scheduledEmail.status == 'pending' %}
                                        <i data-lucide="clock" class="w-3 h-3"></i>
                                    {% elseif scheduledEmail.status == 'sent' %}
                                        <i data-lucide="check-circle" class="w-3 h-3"></i>
                                    {% elseif scheduledEmail.status == 'failed' %}
                                        <i data-lucide="x-circle" class="w-3 h-3"></i>
                                    {% else %}
                                        <i data-lucide="ban" class="w-3 h-3"></i>
                                    {% endif %}
                                    {{ scheduledEmail.statusLabel }}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-slate-900 dark:text-white">
                                    {{ scheduledEmail.adminUser.firstName }} {{ scheduledEmail.adminUser.lastName }}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                {% if scheduledEmail.canBeCancelled %}
                                    <form method="POST" action="{{ path('app_admin_email_cancel_scheduled', {id: scheduledEmail.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_scheduled_' ~ scheduledEmail.id) }}">
                                        <button type="submit" 
                                                onclick="return confirm('Are you sure you want to cancel this scheduled email?')"
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-danger-600 dark:text-danger-400 hover:bg-danger-50 dark:hover:bg-danger-900/20 rounded-lg transition-colors">
                                            <i data-lucide="x" class="w-3 h-3"></i>
                                            Cancel
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="text-xs text-slate-400 dark:text-slate-500">-</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
