{% extends 'admin/base_admin.html.twig' %}

{% block title %}Email History{% endblock %}
{% block page_title %}Email History{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Email History</h1>
            <p class="mt-2 text-slate-600 dark:text-slate-400">View all sent emails</p>
        </div>
        <a href="{{ path('app_admin_email_compose') }}" 
           class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-medium rounded-xl transition-colors shadow-sm">
            <i data-lucide="mail-plus" class="w-4 h-4"></i>
            Compose New Email
        </a>
    </div>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-1 gap-4 sm:gap-6 mb-6 sm:grid-cols-3">
    <!-- Total Emails -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center">
                <i data-lucide="mail" class="w-6 h-6 text-primary-600 dark:text-primary-400"></i>
            </div>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ total_emails }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Total Emails Sent</p>
        </div>
    </div>

    <!-- Last 7 Days -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-success-50 dark:bg-success-900/20 flex items-center justify-center">
                <i data-lucide="calendar" class="w-6 h-6 text-success-600 dark:text-success-400"></i>
            </div>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ emails_last_7_days }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Last 7 Days</p>
        </div>
    </div>

    <!-- Total Recipients -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-info-50 dark:bg-info-900/20 flex items-center justify-center">
                <i data-lucide="users" class="w-6 h-6 text-info-600 dark:text-info-400"></i>
            </div>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ total_recipients }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Total Recipients</p>
        </div>
    </div>
</div>

<!-- Email History Table -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Sent Emails</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{{ emails|length }} records found</p>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">ID</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Sent By</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Recipients</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Subject</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Count</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Date</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                {% for email in emails %}
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="text-sm font-mono text-slate-600 dark:text-slate-400">#{{ email.id }}</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-xs">
                                {{ email.adminUser ? email.adminUser.firstName|first ~ email.adminUser.lastName|first : 'N/A' }}
                            </div>
                            <div>
                                <p class="text-sm font-medium text-slate-900 dark:text-white">{{ email.adminUser ? email.adminUser.fullName : 'Unknown' }}</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold rounded-lg {{ email.badgeColorClass }}">
                            <i data-lucide="users" class="w-3 h-3"></i>
                            {{ email.recipientTypeLabel }}
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <p class="text-sm text-slate-900 dark:text-white font-medium max-w-md truncate">{{ email.subject }}</p>
                        {% if email.message %}
                        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-md truncate mt-1">{{ email.message }}</p>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-2">
                            <i data-lucide="send" class="w-4 h-4 text-slate-400"></i>
                            <span class="text-sm font-semibold text-slate-900 dark:text-white">{{ email.recipientCount }}</span>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-slate-900 dark:text-white">{{ email.sentAt|date('M d, Y') }}</div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">{{ email.sentAt|date('H:i:s') }}</div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                                <i data-lucide="inbox" class="w-6 h-6 text-slate-400"></i>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400">No emails sent yet</p>
                            <a href="{{ path('app_admin_email_compose') }}" 
                               class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20 rounded-xl transition-colors">
                                <i data-lucide="mail-plus" class="w-4 h-4"></i>
                                Send Your First Email
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
