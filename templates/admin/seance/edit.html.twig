{% extends 'admin/base_admin.html.twig' %}

{% block title %}Edit Session{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto animate-fade-in">

    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Schedule', href: path('app_admin_planning') },
            { label: 'Sessions', href: path('app_admin_seance_index') },
            { label: 'Edit Session' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Edit Session',
        subtitle: 'Update or delete a session'
    } %}

    <div class="card p-6 space-y-6">
        {# EDIT FORM #}
        <form method="post" class="space-y-6">

            {% include 'components/input.html.twig' with {
                name: 'titre',
                label: 'Title',
                type: 'text',
                required: true,
                value: seance.titre
            } %}

            {% include 'components/select.html.twig' with {
                name: 'type_seance_id',
                label: 'Session Type',
                required: true,
                value: seance.typeSeance ? seance.typeSeance.id : '',
                options: types|default([])|map(t => { value: t.id, label: t.name })
            } %}

            <div class="space-y-2">
                <label class="text-sm font-medium text-secondary-900 dark:text-white">
                    Description
                </label>
                <textarea name="description"
                          rows="4"
                          class="w-full rounded-xl border border-secondary-200 dark:border-secondary-800 bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">{{ seance.description|default('') }}</textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-secondary-200 dark:border-secondary-800">
                <a href="{{ path('app_admin_seance_index') }}" class="btn btn-secondary">
                    Back
                </a>
                <button class="btn btn-primary" type="submit">
                    Save
                </button>
            </div>
        </form>

        {# DELETE SECTION #}
        <div class="pt-6 border-t border-secondary-200 dark:border-secondary-800">
            <div class="rounded-xl border border-red-200 dark:border-red-900/40 bg-red-50 dark:bg-red-900/20 p-4">
                <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center flex-shrink-0">
                        <i data-lucide="trash-2" class="w-5 h-5 text-red-600 dark:text-red-300"></i>
                    </div>

                    <div class="flex-1">
                        <p class="font-semibold text-secondary-900 dark:text-white">
                            Danger Zone
                        </p>
                        <p class="text-sm text-secondary-600 dark:text-secondary-300 mt-1">
                            Deletion is permanent. This session will be removed and cannot be recovered.
                        </p>

                        <form method="post"
                              action="{{ path('app_admin_seance_delete', {id: seance.id}) }}"
                              onsubmit="return confirm('Are you sure you want to delete this session?');"
                              class="mt-4 flex items-center justify-end">

                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete_seance_' ~ seance.id) }}">

                            <button class="btn btn-secondary" type="submit">
                                <i data-lucide="trash" class="w-4 h-4 mr-2"></i>
                                Delete Session
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
