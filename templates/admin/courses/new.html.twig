{% extends 'admin/base_admin.html.twig' %}

{% block title %}Add New Course{% endblock %}
{% block page_title %}New Course{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-4">
            <a href="{{ path('app_admin_courses') }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to Courses
            </a>
        </div>
        
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Add New Course</h1>
        <p class="mt-2 text-slate-600 dark:text-slate-400">Create a new course in the system</p>
    </div>

    <!-- Form -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        {{ form_start(form) }}
        
        <div class="space-y-6">
            <!-- Code & Name -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.code, 'Course Code', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.code, {'attr': {'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white', 'placeholder': 'Ex: MATH101'}}) }}
                    {{ form_errors(form.code) }}
                </div>

                <div>
                    {{ form_label(form.nomMatiere, 'Course Name', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.nomMatiere, {'attr': {'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white', 'placeholder': 'Ex: Mathematics'}}) }}
                    {{ form_errors(form.nomMatiere) }}
                </div>
            </div>

            <!-- Section & Type -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.sectionMatiere, 'Section', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.sectionMatiere, {'attr': {'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white'}}) }}
                    {{ form_errors(form.sectionMatiere) }}
                </div>

                <div>
                    {{ form_label(form.typeMatiere, 'Type', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.typeMatiere, {'attr': {'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white'}}) }}
                    {{ form_errors(form.typeMatiere) }}
                </div>
            </div>

            <!-- Coefficient & Hours -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.coefficientMatiere, 'Coefficient', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.coefficientMatiere, {'attr': {'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white', 'step': '0.5'}}) }}
                    {{ form_errors(form.coefficientMatiere) }}
                </div>

                <div>
                    {{ form_label(form.heureMatiere, 'Hours per Week', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.heureMatiere, {'attr': {'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white', 'step': '0.5'}}) }}
                    {{ form_errors(form.heureMatiere) }}
                </div>
            </div>

<!-- user celon de chaque user elle va ce modifier-->


            <!-- Description -->
            <div>
                {{ form_label(form.description, 'Description (Optional)', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white', 'rows': '4', 'placeholder': 'Course description...'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-colors">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Create Course
                </button>
                <a href="{{ path('app_admin_courses') }}" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl transition-colors">
                    Cancel
                </a>
            </div>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}