{% extends 'admin/base_admin.html.twig' %}

{% block title %}Add New Course{% endblock %}
{% block page_title %}New Course{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-4">
            <a href="{{ path('app_admin_courses') }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-xl transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to Courses
            </a>
        </div>
        
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Add New Course</h1>
        <p class="mt-2 text-slate-600 dark:text-slate-400">Create a new course in the system</p>
    </div>

    <!-- Form -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6">
        {{ form_start(form) }}
        
        <div class="space-y-6">
            <!-- Code & Name -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Course Code -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Course Code <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.code, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white' ~ (form.code.vars.errors|length > 0 ? ' border-red-500' : ''),
                            'placeholder': 'Ex: MATH101'
                        }
                    }) }}
                    {% if form.code.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600 dark:text-red-400">
                            {{ form_errors(form.code) }}
                        </p>
                    {% else %}
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            Unique identifier for the course (2-10 characters)
                        </p>
                    {% endif %}
                </div>

                <!-- Course Name -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Course Name <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.nomMatiere, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white' ~ (form.nomMatiere.vars.errors|length > 0 ? ' border-red-500' : ''),
                            'placeholder': 'Ex: Mathematics'
                        }
                    }) }}
                    {% if form.nomMatiere.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600 dark:text-red-400">
                            {{ form_errors(form.nomMatiere) }}
                        </p>
                    {% else %}
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            Full name of the course (3-255 characters)
                        </p>
                    {% endif %}
                </div>
            </div>

            <!-- Section & Type -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Section -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Section <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.sectionMatiere, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white' ~ (form.sectionMatiere.vars.errors|length > 0 ? ' border-red-500' : '')
                        }
                    }) }}
                    {% if form.sectionMatiere.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600 dark:text-red-400">
                            {{ form_errors(form.sectionMatiere) }}
                        </p>
                    {% else %}
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            Academic department or field of study
                        </p>
                    {% endif %}
                </div>

                <!-- Type -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Type <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.typeMatiere, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white' ~ (form.typeMatiere.vars.errors|length > 0 ? ' border-red-500' : '')
                        }
                    }) }}
                    {% if form.typeMatiere.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600 dark:text-red-400">
                            {{ form_errors(form.typeMatiere) }}
                        </p>
                    {% else %}
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            Teaching method: Lecture, Tutorial, or Practical
                        </p>
                    {% endif %}
                </div>
            </div>

            <!-- Coefficient & Hours -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Coefficient -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Coefficient <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.coefficientMatiere, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white' ~ (form.coefficientMatiere.vars.errors|length > 0 ? ' border-red-500' : ''),
                            'step': '0.5',
                            'min': '0.1',
                            'max': '20'
                        }
                    }) }}
                    {% if form.coefficientMatiere.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600 dark:text-red-400">
                            {{ form_errors(form.coefficientMatiere) }}
                        </p>
                    {% else %}
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            Weight of this course (0.1 to 20)
                        </p>
                    {% endif %}
                </div>

                <!-- Hours per Week -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Hours per Week <span class="text-red-500">*</span>
                    </label>
                    {{ form_widget(form.heureMatiere, {
                        'attr': {
                            'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white' ~ (form.heureMatiere.vars.errors|length > 0 ? ' border-red-500' : ''),
                            'step': '0.5',
                            'min': '0',
                            'max': '40'
                        }
                    }) }}
                    {% if form.heureMatiere.vars.errors|length > 0 %}
                        <p class="mt-1 text-sm text-red-600 dark:text-red-400">
                            {{ form_errors(form.heureMatiere) }}
                        </p>
                    {% else %}
                        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                            Weekly teaching hours (0 to 40)
                        </p>
                    {% endif %}
                </div>
            </div>

            <!-- Description -->
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                    Description (Optional)
                </label>
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-transparent text-slate-900 dark:text-white' ~ (form.description.vars.errors|length > 0 ? ' border-red-500' : ''),
                        'rows': '4',
                        'placeholder': 'Course description...',
                        'maxlength': '500'
                    }
                }) }}
                {% if form.description.vars.errors|length > 0 %}
                    <p class="mt-1 text-sm text-red-600 dark:text-red-400">
                        {{ form_errors(form.description) }}
                    </p>
                {% else %}
                    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                        Optional - Describe the course content and objectives (max 500 characters)
                    </p>
                {% endif %}
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 rounded-xl transition-colors">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Create Course
                </button>
                <a href="{{ path('app_admin_courses') }}" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-xl transition-colors">
                    Cancel
                </a>
            </div>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<style>
/* Style pour les champs en erreur */
.border-red-500 {
    border-color: #ef4444 !important;
    background-color: #fef2f2 !important;
}

.dark .border-red-500 {
    background-color: rgba(239, 68, 68, 0.1) !important;
}
</style>
{% endblock %}