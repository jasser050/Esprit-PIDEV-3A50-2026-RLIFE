{% extends 'admin/base_admin.html.twig' %}

{% block title %}Edit Course{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-slate-900">
    <div class="container mx-auto px-4 py-8 max-w-4xl">
        <div class="mb-8">
            <a href="{{ path('app_admin_courses') }}" 
               class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m15 18-6-6 6-6"/>
                </svg>
                Back to Course
            </a>
            
            <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-2">Edit {{ matiere.nomMatiere }}</h1>
            <p class="text-slate-600 dark:text-slate-400">{{ matiere.code }}</p>
        </div>

        {# Affichage des messages flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 p-4 rounded-xl {% if label == 'success' %}bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 border border-green-300 dark:border-green-700{% else %}bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300 border border-red-300 dark:border-red-700{% endif %}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-8 shadow-sm">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                
                <!-- Code & Nom matiere -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        {{ form_label(form.code, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                        {{ form_widget(form.code, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all'}}) }}
                        {{ form_errors(form.code) }}
                        <p class="text-xs text-slate-500 mt-1">Course code (e.g., CS101)</p>
                    </div>
                    
                    <div>
                        {{ form_label(form.nomMatiere, 'Course Name', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                        {{ form_widget(form.nomMatiere, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all'}}) }}
                        {{ form_errors(form.nomMatiere) }}
                        <p class="text-xs text-slate-500 mt-1">3-100 characters</p>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all', 'rows': '4'}}) }}
                    {{ form_errors(form.description) }}
                    <p class="text-xs text-slate-500 mt-1">Maximum 1000 characters</p>
                </div>

                <!-- Coefficient, Heure & Type -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        {{ form_label(form.coefficientMatiere, 'Coefficient', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                        {{ form_widget(form.coefficientMatiere, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all', 'step': '0.5'}}) }}
                        {{ form_errors(form.coefficientMatiere) }}
                        <p class="text-xs text-slate-500 mt-1">Between 0 and 20</p>
                    </div>
                    
                    <div>
                        {{ form_label(form.heureMatiere, 'Hours/Week', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                        {{ form_widget(form.heureMatiere, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all', 'step': '0.5'}}) }}
                        {{ form_errors(form.heureMatiere) }}
                        <p class="text-xs text-slate-500 mt-1">Between 0 and 40</p>
                    </div>
                    
                    <div>
                        {{ form_label(form.typeMatiere, 'Type', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                        {{ form_widget(form.typeMatiere, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all'}}) }}
                        {{ form_errors(form.typeMatiere) }}
                    </div>
                </div>

                <!-- Section -->
                <div>
                    {{ form_label(form.sectionMatiere, 'Section', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.sectionMatiere, {'attr': {'class': 'w-full px-4 py-3 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all'}}) }}
                    {{ form_errors(form.sectionMatiere) }}
                </div>

                <!-- Boutons -->
                <div class="flex items-center gap-4 pt-6 border-t border-slate-200 dark:border-slate-700">
                    <button type="submit" 
                            class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl transition-colors shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>
                        </svg>
                        Save Changes
                    </button>
                    
                    <a href="{{ path('app_admin_courses') }}" 
                       class="px-6 py-3 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-900 dark:text-white font-medium rounded-xl transition-colors">
                        Cancel
                    </a>
                </div>

                <p class="text-xs text-slate-500 mt-4">
                    <span class="text-red-500">*</span> Required fields
                </p>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
