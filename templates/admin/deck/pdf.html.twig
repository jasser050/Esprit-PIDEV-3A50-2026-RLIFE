<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Decks - Revisions</title>
    <style>
        * { margin: 0; padding: 0; font-family: 'DejaVu Sans', sans-serif; }
        body { background: #f8fafc; color: #1e293b; font-size: 12px; line-height: 1.5; }
        .header { 
            background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); 
            color: white; 
            padding: 30px 40px; 
            margin-bottom: 30px;
        }
        .header h1 { font-size: 28px; font-weight: bold; margin-bottom: 5px; }
        .header p { font-size: 14px; opacity: 0.95; }
        .deck { 
            background: white; 
            margin-bottom: 20px; 
            padding: 25px; 
            border-radius: 12px; 
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border-left: 5px solid #3b82f6;
        }
        .deck-title { 
            font-size: 18px; 
            font-weight: bold; 
            color: #1e293b; 
            margin-bottom: 10px; 
        }
        .deck-meta { 
            display: flex; 
            gap: 20px; 
            margin-bottom: 15px; 
            font-size: 12px; 
        }
        .meta-item { display: flex; align-items: center; gap: 6px; }
        .progress-bar { 
            background: #e2e8f0; 
            height: 8px; 
            border-radius: 4px; 
            overflow: hidden; 
            margin-top: 5px;
        }
        .progress-fill { 
            height: 100%; 
            background: linear-gradient(90deg, #10b981, #059669); 
            border-radius: 4px; 
            transition: width 0.3s ease;
        }
        .footer { 
            margin-top: 50px; 
            padding-top: 30px; 
            border-top: 2px solid #e2e8f0; 
            text-align: center; 
            color: #64748b; 
            font-size: 11px;
        }
        .page-break { page-break-before: always; }
        @page { margin: 20mm; }
    </style>
</head>
<body>
    <div class="header">
        <h1>📚 Liste des Decks Revisions</h1>
        <p>Généré le {{ "now"|date('d/m/Y \\à H:i') }} | {{ decks|length }} deck(s) au total</p>
    </div>

    {% for deck in decks %}
        {% set demoStats = [40, 50, 75, 70, 75, 50, 71, 67, 73, 71, 69, 75] %}
        {% set palette = ['#f59e0b', '#3b82f6', '#ec4899', '#10b981', '#6366f1'][loop.index0 % 5] %}
        {% set progress = demoStats[loop.index0 % demoStats|length] %}
        {% set cards = 10 + loop.index0 * 2 %}

        <div class="deck" style="border-left-color: {{ palette }};">
            <div class="deck-title" style="color: {{ palette }};">{{ loop.index }}. {{ deck.titre|default('Sans titre') }}</div>
            
            <div class="deck-meta">
                <div class="meta-item">
                    📖 <strong>{{ deck.matiere|default('—') }}</strong> • {{ deck.niveau|default('—') }}
                </div>
                <div class="meta-item">
                    🗓️ {{ deck.dateCreation ? deck.dateCreation|date('d/m/Y') : '—' }}
                </div>
                <div class="meta-item">
                    🎴 {{ cards }} cartes ({{ deck.flashcards|length }} réelles)
                </div>
            </div>

            {% if deck.description %}
                <p style="color: #64748b; margin-bottom: 15px; font-style: italic;">
                    "{{ deck.description|slice(0, 150) ~ (deck.description|length > 150 ? '...' : '') }}"
                </p>
            {% endif %}

            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <strong>Progression: {{ progress }}%</strong>
                </div>
                <div style="width: 200px;">
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: {{ progress }}%"></div>
                    </div>
                </div>
            </div>
        </div>

        {% if loop.index is divisibleby(8) and not loop.last %}
            <div class="page-break"></div>
        {% endif %}
    {% endfor %}

    {% if decks is empty %}
        <div style="text-align: center; padding: 100px 40px; color: #64748b;">
            <div style="font-size: 80px; margin-bottom: 30px;">📚</div>
            <h2 style="font-size: 28px; margin-bottom: 20px; color: #1e293b;">Aucun deck trouvé</h2>
            <p>Créez votre premier deck pour commencer vos révisions !</p>
        </div>
    {% endif %}

    <div class="footer">
        <p><strong>Revisions App</strong> - Application de révision par flashcards</p>
        <p>Généré automatiquement le {{ "now"|date('d/m/Y \\à H:i') }} | Page {{ page() }}/{{ pages() }}</p>
    </div>
</body>
</html>