{% extends 'admin/base_admin.html.twig' %}

{% block title %}Créer un Deck - RLIFE Admin{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto px-4 sm:px-6">

    <!-- Breadcrumbs -->
    <nav class="flex items-center text-sm text-slate-500 dark:text-slate-400 mb-6">
        <a href="{{ path('app_admin_dashboard') }}" class="hover:text-slate-900 dark:hover:text-white transition">Dashboard</a>
        <span class="mx-2">›</span>
        <a href="{{ path('app_admin_revision') }}" class="hover:text-slate-900 dark:hover:text-white transition">Révisions</a>
        <span class="mx-2">›</span>
        <span class="font-medium text-slate-900 dark:text-white">Créer un Deck</span>
    </nav>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Créer un Deck</h1>
            <p class="mt-1 text-slate-600 dark:text-slate-400 text-sm sm:text-base">
                Organise tes flashcards et commence à réviser efficacement
            </p>
        </div>
        <a href="{{ path('app_admin_revision') }}" 
           class="inline-flex items-center px-5 py-2.5 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition text-sm">
            <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
            Retour
        </a>
    </div>

    <!-- Formulaire clair et normal -->
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow border border-slate-200 dark:border-slate-700 overflow-hidden">
        <div class="p-6 sm:p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

            <!-- Titre -->
            <div>
                {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                {{ form_widget(form.titre, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all duration-200 text-base',
                        'placeholder': 'Ex: Biologie - Système nerveux, Vocabulaire espagnol A2...'
                    }
                }) }}
                {{ form_errors(form.titre, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <!-- Matière -->
            <div>
                {{ form_label(form.matiere, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                {{ form_widget(form.matiere, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all duration-200 text-base',
                        'placeholder': 'Ex: Biologie, Anglais, Mathématiques, Histoire...'
                    }
                }) }}
                {{ form_errors(form.matiere, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <!-- Niveau -->
            <div>
                {{ form_label(form.niveau, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                {{ form_widget(form.niveau, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all duration-200 text-base',
                        'placeholder': 'Ex: Terminale, Licence 1, B1, Master 2...'
                    }
                }) }}
                {{ form_errors(form.niveau, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <!-- Description -->
            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                {{ form_widget(form.description, {
                    'attr': {
                        'rows': 4,
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all duration-200 min-h-[110px] text-base',
                        'placeholder': 'Décris le contenu, les objectifs, les chapitres ou les compétences visées...'
                    }
                }) }}
                {{ form_errors(form.description, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <!-- Image -->
            <div class="space-y-1.5">
                {{ form_label(form.imageFile, 'Image de couverture (jpg, png, webp)', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300'}}) }}
                {{ form_widget(form.imageFile, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 dark:file:bg-indigo-900/30 dark:file:text-indigo-400 transition cursor-pointer'
                    }
                }) }}
                <p class="text-xs text-slate-500 dark:text-slate-400">Max 5 Mo – Format idéal : 16:9 ou carré</p>
                {{ form_errors(form.imageFile, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <!-- PDF -->
            <div class="space-y-1.5">
                {{ form_label(form.pdfFile, 'Fichier PDF (optionnel – cours ou résumé)', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300'}}) }}
                {{ form_widget(form.pdfFile, {
                    'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-lg border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 dark:file:bg-indigo-900/30 dark:file:text-indigo-400 transition cursor-pointer'
                    }
                }) }}
                <p class="text-xs text-slate-500 dark:text-slate-400">Max 10 Mo</p>
                {{ form_errors(form.pdfFile, {'attr': {'class': 'text-red-600 text-xs mt-1'}}) }}
            </div>

            <!-- Boutons -->
            <div class="flex flex-col sm:flex-row justify-end gap-3 pt-6 border-t border-slate-200 dark:border-slate-700">
                <a href="{{ path('app_admin_revision') }}" 
                   class="px-6 py-2.5 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition text-center text-sm">
                    Annuler
                </a>
                <button type="submit" 
                        class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition shadow-sm flex items-center justify-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Créer le Deck
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

</div>
{% endblock %}