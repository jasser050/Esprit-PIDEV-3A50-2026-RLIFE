{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier Question Stress{% endblock %}

{% block body %}
<div class="container mx-auto p-6 max-w-3xl">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Modifier la question</h1>
            <p class="text-gray-400 mt-2">Modifiez le texte et les paramètres de la question</p>
        </div>
        <a href="{{ path('app_admin_question_stress_index') }}" class="btn btn-outline gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Retour à la liste
        </a>
    </div>

    <div class="card bg-gradient-to-br from-gray-900 to-gray-800 shadow-2xl rounded-2xl border border-gray-700/50">
        <div class="card-body p-8">
            <h2 class="text-2xl font-semibold text-white mb-6">Détails de la question</h2>

            {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

            <!-- Question Text -->
            <div class="form-control">
                {{ form_label(form.label, null, {'label_attr': {'class': 'label-text font-medium text-lg text-white'}}) }}
                {{ form_widget(form.label, {'attr': {'class': 'textarea textarea-bordered w-full h-28 text-base placeholder-gray-500 bg-white text-black rounded-xl'}}) }}
                {{ form_errors(form.label) }}
            </div>

            <!-- Grille pour les champs numériques -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="form-control">
                    {{ form_label(form.orderIndex, null, {'label_attr': {'class': 'label-text font-medium text-lg text-white'}}) }}
                    {{ form_widget(form.orderIndex, {'attr': {'class': 'input input-bordered w-full bg-white text-black rounded-xl'}}) }}
                    {{ form_errors(form.orderIndex) }}
                    <p class="text-sm text-gray-500 mt-2">Position dans le questionnaire (1 = première)</p>
                </div>

                <div class="form-control">
                    {{ form_label(form.minValue, null, {'label_attr': {'class': 'label-text font-medium text-lg text-white'}}) }}
                    {{ form_widget(form.minValue, {'attr': {'class': 'input input-bordered w-full bg-white text-black rounded-xl'}}) }}
                    {{ form_errors(form.minValue) }}
                </div>

                <div class="form-control">
                    {{ form_label(form.maxValue, null, {'label_attr': {'class': 'label-text font-medium text-lg text-white'}}) }}
                    {{ form_widget(form.maxValue, {'attr': {'class': 'input input-bordered w-full bg-white text-black rounded-xl'}}) }}
                    {{ form_errors(form.maxValue) }}
                </div>
            </div>

            <!-- Boutons -->
            <div class="flex justify-end gap-6 mt-12">
                <a href="{{ path('app_admin_question_stress_index') }}" class="btn btn-outline btn-lg px-8 text-white border-gray-600 hover:border-gray-500">
                    Annuler
                </a>
                <button type="submit" class="btn btn-primary btn-lg px-8 bg-gradient-to-r from-indigo-600 to-purple-600 text-white hover:from-indigo-700 hover:to-purple-700">
                    Sauvegarder les modifications
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

    <!-- Carte des tips (optionnelle) -->
    <div class="card bg-gradient-to-br from-gray-900 to-gray-800 shadow-2xl rounded-2xl border border-gray-700/50 mt-8">
        <div class="card-body p-8">
            <h2 class="text-2xl font-semibold text-white mb-6">Conseils pour de bonnes questions</h2>
            <ul class="space-y-4 text-gray-300 text-lg">
                <li class="flex items-start">
                    <span class="text-indigo-400 mr-3">•</span>
                    Utilisez un langage clair et simple, compréhensible par tous.
                </li>
                <li class="flex items-start">
                    <span class="text-indigo-400 mr-3">•</span>
                    Privilégiez les questions sur les 4 dernières semaines / le dernier mois.
                </li>
                <li class="flex items-start">
                    <span class="text-indigo-400 mr-3">•</span>
                    Utilisez une échelle de 5 points (1 = Jamais → 5 = Très souvent) par défaut.
                </li>
                <li class="flex items-start">
                    <span class="text-indigo-400 mr-3">•</span>
                    Numérotez les questions logiquement (1, 2, 3...).
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}