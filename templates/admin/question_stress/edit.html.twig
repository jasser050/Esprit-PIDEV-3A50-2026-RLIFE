{% extends 'admin/base_admin.html.twig' %}

{% block title %}Edit Question{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto">
    <div class="mb-6">
        <a href="{{ path('app_admin_question_stress_index') }}" class="text-sm text-secondary-500 hover:text-secondary-700 flex items-center gap-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Questions
        </a>
    </div>

    <div class="card p-6 md:p-8">
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white mb-6">
            Edit Question #{{ question_stress.position }}
        </h1>

        <div class="rounded-xl border border-primary-200 dark:border-primary-800 bg-primary-50 dark:bg-primary-900/20 px-4 py-3 mb-6">
            <p class="text-sm text-primary-800 dark:text-primary-200 flex items-center gap-2">
                <i data-lucide="move-vertical" class="w-4 h-4"></i>
                Question order is managed from the list using drag-and-drop.
            </p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
            <div>
                {{ form_label(form.questionText, 'Question Text', {'label_attr': {'class': 'block text-sm font-semibold text-secondary-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.questionText, {'attr': {'class': 'textarea textarea-bordered w-full', 'rows': 4}}) }}
                {{ form_errors(form.questionText) }}
            </div>

            <div class="flex items-center gap-3">
                {{ form_widget(form.isActive) }}
                {{ form_label(form.isActive, 'Active', {'label_attr': {'class': 'text-sm font-medium text-secondary-700 dark:text-secondary-300'}}) }}
            </div>

            <div class="flex gap-4 pt-4 border-t border-secondary-200 dark:border-secondary-800">
                <a href="{{ path('app_admin_question_stress_index') }}" class="btn btn-secondary flex-1">Cancel</a>
                <button type="submit" class="btn btn-primary flex-1">
                    <i data-lucide="save" class="w-5 h-5 mr-2 inline"></i>
                    Update Question
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}