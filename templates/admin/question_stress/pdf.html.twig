<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Stress Questions Report</title>
    <style>
        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            font-size: 11px;
            line-height: 1.6;
            color: #333;
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #6366f1;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header h1 {
            color: #6366f1;
            font-size: 24px;
            margin: 0;
        }
        .header p {
            color: #666;
            margin: 10px 0 0 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th {
            background: #6366f1;
            color: white;
            padding: 10px;
            text-align: left;
            font-size: 10px;
        }
        td {
            padding: 8px 10px;
            border-bottom: 1px solid #e5e7eb;
        }
        tr:nth-child(even) {
            background: #f9fafb;
        }
        .status-active {
            color: #22c55e;
            font-weight: bold;
        }
        .status-inactive {
            color: #6b7280;
        }
        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 10px;
            color: #999;
            border-top: 1px solid #e5e7eb;
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Stress Assessment Questions</h1>
        <p>Generated on {{ exportDate|date('F j, Y') }}</p>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 10%;">Pos</th> <!-- Changé de # à Pos pour éviter confusion -->
                <th style="width: 60%;">Question</th>
                <th style="width: 15%;">Status</th>
                <th style="width: 15%;">Created</th>
            </tr>
        </thead>
        <tbody>
            {% for question in questions %}
            <tr>
                <td>{{ question.position }}</td>           <!-- ← Correction ici : position au lieu de questionNumber -->
                <td>{{ question.questionText }}</td>
                <td class="{{ question.isActive ? 'status-active' : 'status-inactive' }}">
                    {{ question.isActive ? '✓ Active' : '✗ Inactive' }}
                </td>
                <td>{{ question.createdAt|date('M j, Y') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        <p>RLife Admin - Wellbeing Module</p>
        <p>Total Questions: {{ questions|length }}</p>
    </div>
</body>
</html>