{# templates/admin/question_stress/index.html.twig #}
{% extends 'admin/base_admin.html.twig' %}

{% block title %}Questions Stress{% endblock %}
{% block page_title %}Questions Stress{% endblock %}

{% block body %}
<div class="space-y-6">

    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-semibold">Questions</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">Manage QuestionStress (CRUD)</p>
        </div>
        <a href="{{ path('app_admin_question_stress_new') }}"
           class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold">
            <i data-lucide="plus" class="w-4 h-4"></i>
            New Question
        </a>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 dark:bg-slate-800/40 text-slate-600 dark:text-slate-300">
                <tr>
                    <th class="text-left px-4 py-3">ID</th>
                    <th class="text-left px-4 py-3">Number</th>
                    <th class="text-left px-4 py-3">Question</th>
                    <th class="text-left px-4 py-3">Active</th>
                    <th class="text-right px-4 py-3">Actions</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {% if question_stresses is defined and question_stresses|length > 0 %}
                {% for q in question_stresses %}
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30">
                        <td class="px-4 py-3">{{ q.id }}</td>
                        <td class="px-4 py-3">{{ attribute(q, 'questionNumberQues') ?? '-' }}</td>
                        <td class="px-4 py-3">
                            {{ attribute(q, 'questionTextQues') ?? '-' }}
                        </td>
                        <td class="px-4 py-3">
                            {% set active = attribute(q, 'isActiveQues') ?? false %}
                            <span class="px-2 py-1 rounded-full text-xs font-semibold
                                {{ active ? 'bg-success-100 text-success-700 dark:bg-success-900/30 dark:text-success-300' : 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300' }}">
                                {{ active ? 'Yes' : 'No' }}
                            </span>
                        </td>

                        <td class="px-4 py-3 text-right">
                            <a href="{{ path('app_admin_question_stress_edit', {id: q.id}) }}"
                               class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700">
                                <i data-lucide="edit" class="w-4 h-4"></i> Edit
                            </a>

                            <form method="post"
                                  action="{{ path('app_admin_question_stress_delete', {id: q.id}) }}"
                                  class="inline-block"
                                  onsubmit="return confirm('Delete this question?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ q.id) }}">
                                <button class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-danger-50 text-danger-700 hover:bg-danger-100 dark:bg-danger-900/20 dark:text-danger-300 dark:hover:bg-danger-900/30">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-slate-500 dark:text-slate-400">
                        No questions found.
                    </td>
                </tr>
            {% endif %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}
