{% extends 'admin/base_admin.html.twig' %}

{% block title %}Questions Stress{% endblock %}

{% block body %}
<div class="container mx-auto p-6">
    <!-- En-tête -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="text-3xl md:text-4xl font-bold text-white">Questions Stress</h1>
            <p class="text-gray-400 mt-2">Gérez toutes les questions du questionnaire d'évaluation du stress</p>
        </div>
        <a href="{{ path('app_admin_question_stress_new') }}"
           class="btn bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white gap-2 shadow-lg transform hover:scale-105 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nouvelle Question
        </a>
    </div>

    <!-- Carte principale -->
    <div class="card bg-gradient-to-br from-gray-900 to-gray-800 shadow-2xl rounded-2xl overflow-hidden border border-gray-700/50">
        <div class="card-body p-0">
            {% if question_stresses|length > 0 %}
                <div class="overflow-x-auto">
                    <table class="table table-zebra w-full text-base-content">
                        <thead class="bg-gray-800/80">
                            <tr>
                                <th class="text-left py-4 px-6">ID</th>
                                <th class="text-left py-4 px-6">Question</th>
                                <th class="text-center py-4 px-6">Ordre</th>
                                <th class="text-center py-4 px-6">Échelle</th>
                                <th class="text-center py-4 px-6">Quiz</th>
                                <th class="text-right py-4 px-6">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for q in question_stresses %}
                                <tr class="hover:bg-gray-800/60 transition-colors duration-200">
                                    <td class="font-medium px-6 py-4">{{ q.id }}</td>
                                    <td class="font-semibold text-white px-6 py-4">{{ q.label }}</td>
                                    <td class="text-center px-6 py-4">{{ q.orderIndex }}</td>
                                    <td class="text-center px-6 py-4">
                                        <div class="badge badge-outline badge-info">
                                            {{ q.minValue }} → {{ q.maxValue }}
                                        </div>
                                    </td>
                                    <td class="text-center px-6 py-4">
                                        {% if q.quiz %}
                                            <div class="badge badge-outline badge-success">
                                                {{ q.quiz.title|default('Quiz #' ~ q.quiz.id)|slice(0, 20) ~ '...' }}
                                            </div>
                                        {% else %}
                                            <div class="badge badge-ghost">Aucun</div>
                                        {% endif %}
                                    </td>
                                    <td class="text-right px-6 py-4 space-x-2">
                                        <a href="{{ path('app_admin_question_stress_edit', {id: q.id}) }}"
                                           class="btn btn-sm btn-info gap-1 hover:scale-105 transition-transform">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                            Modifier
                                        </a>

                                        <form method="post" action="{{ path('app_admin_question_stress_delete', {id: q.id}) }}" class="inline-block" onsubmit="return confirm('Supprimer cette question ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ q.id) }}">
                                            <button type="submit" class="btn btn-sm btn-error gap-1 hover:scale-105 transition-transform">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                                Supprimer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="p-16 text-center">
                    <div class="text-7xl mb-6 opacity-50">📝</div>
                    <h3 class="text-2xl font-semibold text-gray-300 mb-4">Aucune question pour le moment</h3>
                    <p class="text-gray-400 mb-8">Commencez à créer vos questions d'évaluation du stress</p>
                    <a href="{{ path('app_admin_question_stress_new') }}" class="btn btn-primary btn-lg gap-2">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Créer la première question
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}