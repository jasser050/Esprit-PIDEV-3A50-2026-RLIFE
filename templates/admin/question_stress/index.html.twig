<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script>
function initQuestionStressSortable() {
    const tbody = document.getElementById('sortable-body');
    if (!tbody) {
        return;
    }
    if (tbody.dataset.sortableInitialized === '1') {
        return;
    }
    tbody.dataset.sortableInitialized = '1';

    const reorderUrl = '{{ path('app_admin_question_stress_reorder') }}';

    Sortable.create(tbody, {
        animation: 150,
        ghostClass: 'bg-amber-100',
        onEnd: async function() {
            const rows = tbody.querySelectorAll('tr');
            const orderedIds = Array.from(rows).map(row => row.dataset.id);

            try {
                const response = await fetch(reorderUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(orderedIds)
                });

                const data = await response.json();
                if (data.success) {
                    // Refresh visible order numbers without reloading the page
                    Array.from(rows).forEach((row, index) => {
                        const firstCell = row.querySelector('td');
                        if (firstCell) {
                            firstCell.textContent = String(index + 1);
                        }
                    });
                } else {
                    alert(data.message || 'Unable to save order.');
                }
            } catch (err) {
                alert(err.message || 'Connection error.');
            }
        }
    });
}

document.addEventListener('DOMContentLoaded', initQuestionStressSortable);
document.addEventListener('turbo:load', initQuestionStressSortable);
</script>
{% endblock %}
