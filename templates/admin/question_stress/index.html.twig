{% extends 'admin/base_admin.html.twig' %}

{% block title %}Stress Questions{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Stress Assessment Questions</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">Manage quiz questions for stress evaluation</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_admin_question_stress_export_pdf') }}" class="btn btn-secondary">
                <i data-lucide="file-down" class="w-5 h-5 mr-2"></i>
                Export PDF
            </a>
            <a href="{{ path('app_admin_question_stress_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                Add Question
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card p-6 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-blue-500 text-white flex items-center justify-center">
                    <i data-lucide="help-circle" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ stats.total }}</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Total Questions</p>
                </div>
            </div>
        </div>
        <div class="card p-6 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-green-500 text-white flex items-center justify-center">
                    <i data-lucide="check-circle" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ stats.active }}</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Active Questions</p>
                </div>
            </div>
        </div>
        <div class="card p-6 bg-gradient-to-br from-gray-50 to-slate-100 dark:from-gray-900/20 dark:to-slate-900/20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-slate-500 text-white flex items-center justify-center">
                    <i data-lucide="x-circle" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ stats.inactive }}</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Inactive Questions</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card p-4 border-slate-700/40 dark:border-slate-700 bg-slate-900/50 dark:bg-slate-900">
        <form method="get" class="flex flex-col md:flex-row gap-3 items-stretch">
            <button type="submit" class="filter-icon-btn shrink-0" aria-label="Search">
                <i data-lucide="search" class="w-5 h-5"></i>
            </button>

            <input type="text"
                   name="search"
                   value="{{ search }}"
                   placeholder="Search questions..."
                   class="filter-control w-full md:flex-1">

            <select name="sort" class="filter-control w-full md:w-[280px]">
                <option value="id" {{ sort == 'id' ? 'selected' : '' }}>Sort by ID</option>
                <option value="position" {{ sort == 'position' ? 'selected' : '' }}>Sort by Position</option>
                <option value="createdAt" {{ sort == 'createdAt' ? 'selected' : '' }}>Sort by Date</option>
            </select>

            <select name="order" class="filter-control w-full md:w-[280px]">
                <option value="ASC" {{ order == 'ASC' ? 'selected' : '' }}>Ascending</option>
                <option value="DESC" {{ order == 'DESC' ? 'selected' : '' }}>Descending</option>
            </select>

            <button type="submit" class="filter-action-btn filter-action-btn-primary" aria-label="Apply filters">
                <i data-lucide="funnel" class="w-5 h-5"></i>
            </button>
            <a href="{{ path('app_admin_question_stress_index') }}" class="filter-action-btn filter-action-btn-reset" aria-label="Reset filters">
                <i data-lucide="x" class="w-5 h-5"></i>
            </a>
        </form>
    </div>

    <div class="card overflow-hidden">
        {% if questionStresses|length > 0 %}
        <div class="overflow-x-auto">
            <table class="table" id="sortable-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Question</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="sortable-body">
                    {% for question in questionStresses %}
                    <tr data-id="{{ question.id }}">
                        <td class="p-4 font-medium">{{ question.position }}</td>
                        <td class="p-4">
                            <p class="line-clamp-2">{{ question.questionText }}</p>
                        </td>
                        <td class="p-4">
                            {% if question.isActive %}
                                <span class="badge badge-success">Active</span>
                            {% else %}
                                <span class="badge badge-secondary">Inactive</span>
                            {% endif %}
                        </td>
                        <td class="p-4 text-sm text-slate-500">
                            {{ question.createdAt|date('M j, Y') }}
                        </td>
                        <td class="p-4 text-right">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('app_admin_question_stress_show', {id: question.id}) }}" class="btn btn-sm btn-ghost">
                                    <i data-lucide="eye" class="w-4 h-4"></i>
                                </a>
                                <a href="{{ path('app_admin_question_stress_edit', {id: question.id}) }}" class="btn btn-sm btn-secondary">
                                    <i data-lucide="edit" class="w-4 h-4"></i>
                                </a>
                                <form method="post" action="{{ path('app_admin_question_stress_delete', {id: question.id}) }}"
                                      data-confirm="Are you sure you want to delete this question?"
                                      class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ question.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i data-lucide="trash" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="p-12 text-center">
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">No questions found</h3>
                <p class="text-slate-500 dark:text-slate-400 mb-4">Start by adding your first stress assessment question.</p>
                <a href="{{ path('app_admin_question_stress_new') }}" class="btn btn-primary">Add Question</a>
            </div>
        {% endif %}
    </div>
</div>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.filter-control {
    min-height: 52px;
    border-radius: 14px;
    border: 1px solid rgb(51 65 85 / 0.9);
    background: rgb(30 41 59 / 0.65);
    color: rgb(248 250 252);
    padding: 0 16px;
}

.filter-control:focus {
    outline: none;
    border-color: rgb(99 102 241 / 0.7);
    box-shadow: 0 0 0 2px rgb(99 102 241 / 0.2);
}

.filter-icon-btn,
.filter-action-btn {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(51 65 85 / 0.9);
    transition: all 150ms ease;
}

.filter-icon-btn {
    background: rgb(30 41 59 / 0.75);
    color: rgb(45 212 191);
}

.filter-action-btn-primary {
    background: linear-gradient(135deg, rgb(99 102 241), rgb(124 58 237));
    color: white;
    border-color: transparent;
}

.filter-action-btn-reset {
    background: rgb(30 41 59 / 0.75);
    color: rgb(148 163 184);
}

.filter-icon-btn:hover,
.filter-action-btn:hover,
.filter-control:hover {
    border-color: rgb(71 85 105);
}
</style>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script>
function initQuestionStressSortable() {
    const tbody = document.getElementById('sortable-body');
    if (!tbody) {
        return;
    }
    if (tbody.dataset.sortableInitialized === '1') {
        return;
    }
    tbody.dataset.sortableInitialized = '1';

    const reorderUrl = '{{ path('app_admin_question_stress_reorder') }}';

    Sortable.create(tbody, {
        animation: 150,
        ghostClass: 'bg-amber-100',
        onEnd: async function() {
            const rows = tbody.querySelectorAll('tr');
            const orderedIds = Array.from(rows).map(row => row.dataset.id);

            try {
                const response = await fetch(reorderUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(orderedIds)
                });

                const data = await response.json();
                if (data.success) {
                    // Refresh visible order numbers without reloading the page
                    Array.from(rows).forEach((row, index) => {
                        const firstCell = row.querySelector('td');
                        if (firstCell) {
                            firstCell.textContent = String(index + 1);
                        }
                    });
                } else {
                    alert(data.message || 'Unable to save order.');
                }
            } catch (err) {
                alert(err.message || 'Connection error.');
            }
        }
    });
}

document.addEventListener('DOMContentLoaded', initQuestionStressSortable);
document.addEventListener('turbo:load', initQuestionStressSortable);
</script>
{% endblock %}