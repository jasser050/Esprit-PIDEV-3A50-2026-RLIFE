{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ question_stress.id ? 'Edit' : 'New' }} Question{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <a href="{{ path('app_admin_question_stress_index') }}" class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 mb-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Back to Questions
            </a>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Add Stress Question</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-1">Create a new question for the stress assessment.</p>
        </div>
        <a href="{{ path('app_admin_question_stress_index') }}" class="btn btn-secondary">
            <i data-lucide="list-ordered" class="w-5 h-5"></i>
            Manage Order
        </a>
    </div>

    <div class="card p-6 md:p-8 space-y-6">
        <div class="rounded-xl border border-primary-200 dark:border-primary-800 bg-primary-50 dark:bg-primary-900/20 px-4 py-3">
            <p class="text-sm text-primary-800 dark:text-primary-200 flex items-center gap-2">
                <i data-lucide="move-vertical" class="w-4 h-4"></i>
                The display order is managed by drag-and-drop from the questions list.
            </p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
            {{ form_errors(form) }}

            <div>
                {{ form_label(form.questionText, 'Question Text', {'label_attr': {'class': 'block text-sm font-semibold text-slate-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.questionText, {'attr': {'class': 'textarea w-full min-h-[140px]', 'rows': 4, 'placeholder': 'e.g. How often do you feel overwhelmed during your day?'}}) }}
                {{ form_errors(form.questionText) }}
            </div>

            <div class="flex items-center gap-3">
                {{ form_widget(form.isActive) }}
                {{ form_label(form.isActive, 'Active', {'label_attr': {'class': 'text-sm font-medium text-slate-700 dark:text-slate-300'}}) }}
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
                <a href="{{ path('app_admin_question_stress_index') }}" class="btn btn-secondary flex-1">Cancel</a>
                <button type="submit" class="btn btn-primary flex-1">
                    <i data-lucide="save" class="w-5 h-5 mr-2 inline"></i>
                    Create Question
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
