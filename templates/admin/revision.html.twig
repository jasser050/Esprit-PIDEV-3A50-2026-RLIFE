{% extends 'admin/base_admin.html.twig' %}
{% block title %}Révisions{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Barre de recherche principale */
        .search-container {
            position: relative;
            max-width: 100%;
        }
       
        .search-input {
            width: 100%;
            padding: 12px 48px 12px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 16px;
            transition: all 0.3s ease;
            background-color: white;
        }
       
        .search-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
       
        .search-input.dark {
            background-color: #1e293b;
            border-color: #475569;
            color: white;
        }
       
        .search-button {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #64748b;
            cursor: pointer;
            padding: 8px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
       
        .search-button:hover {
            background-color: #f1f5f9;
            color: #3b82f6;
        }
       
        .search-button.dark:hover {
            background-color: #334155;
            color: #60a5fa;
        }
       
        /* Filtres et tris */
        .controls-container {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-top: 16px;
        }
       
        .filters-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
        }
       
        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
       
        .filter-label {
            font-size: 14px;
            font-weight: 500;
            color: #64748b;
        }
       
        .filter-label.dark {
            color: #94a3b8;
        }
       
        .filter-select {
            padding: 8px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            background-color: white;
            cursor: pointer;
            min-width: 150px;
            transition: all 0.3s ease;
        }
       
        .filter-select:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
       
        .filter-select.dark {
            background-color: #1e293b;
            border-color: #475569;
            color: white;
        }
       
        .filter-select.dark:focus {
            border-color: #60a5fa;
        }
       
        /* Recherche par date */
        .date-search-container {
            display: flex;
            gap: 8px;
            align-items: center;
        }
       
        .date-input {
            padding: 8px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            width: 150px;
            transition: all 0.3s ease;
        }
       
        .date-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
       
        .date-input.dark {
            background-color: #1e293b;
            border-color: #475569;
            color: white;
        }
       
        /* Boutons de tri */
        .sort-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
       
        .sort-button {
            padding: 8px 16px;
            border-radius: 20px;
            border: 2px solid #e2e8f0;
            background-color: white;
            color: #64748b;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }
       
        .sort-button:hover {
            border-color: #3b82f6;
            color: #3b82f6;
        }
       
        .sort-button.active {
            background-color: #3b82f6;
            color: white;
            border-color: #3b82f6;
        }
       
        .sort-button.dark {
            background-color: #1e293b;
            border-color: #475569;
            color: #cbd5e1;
        }
       
        .sort-button.dark:hover {
            border-color: #60a5fa;
            color: #60a5fa;
        }
       
        .sort-button.dark.active {
            background-color: #60a5fa;
            color: white;
            border-color: #60a5fa;
        }
       
        /* Boutons d'action */
        .action-buttons {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
       
        .action-button {
            padding: 8px 16px;
            border-radius: 8px;
            border: none;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }
       
        .action-button.reset {
            background-color: #f1f5f9;
            color: #64748b;
        }
       
        .action-button.reset:hover {
            background-color: #e2e8f0;
        }
       
        .action-button.reset.dark {
            background-color: #334155;
            color: #cbd5e1;
        }
       
        .action-button.reset.dark:hover {
            background-color: #475569;
        }

        /* Style pour le bouton PDF */
        .action-button.pdf {
            background: linear-gradient(to right, #7c3aed, #a855f7);
            color: white;
        }
       
        .action-button.pdf:hover {
            opacity: 0.92;
            transform: translateY(-1px);
        }
       
        /* Compteur de résultats */
        .results-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #e2e8f0;
        }
       
        .results-info.dark {
            border-top-color: #475569;
        }
       
        .deck-counter {
            color: #64748b;
            font-size: 14px;
            font-weight: 500;
        }
       
        .deck-counter.dark {
            color: #94a3b8;
        }
       
        .sort-indicator {
            color: #3b82f6;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
        }
       
        .sort-indicator.dark {
            color: #60a5fa;
        }
       
        /* Message "Aucun résultat" */
        .no-results {
            text-align: center;
            padding: 60px 20px;
            grid-column: 1 / -1;
        }
       
        .no-results-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            color: #cbd5e1;
        }
       
        .no-results.dark .no-results-icon {
            color: #475569;
        }
       
        /* Animation pour les cartes */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
       
        .deck-card {
            animation: fadeIn 0.3s ease-out;
        }
       
        /* Badge pour le nombre de cartes */
        .cards-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
       
        /* Responsive */
        @media (max-width: 768px) {
            .filters-row {
                flex-direction: column;
                align-items: stretch;
            }
           
            .filter-select, .date-input {
                width: 100%;
            }
           
            .date-search-container {
                flex-direction: column;
            }
           
            .results-info {
                flex-direction: column;
                gap: 12px;
                align-items: flex-start;
            }
        }

        /* Statistiques en haut */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }
        
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            gap: 16px;
        }
        
        .stat-card.dark {
            background: #1e293b;
            border-color: #475569;
        }
        
        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .stat-info h4 {
            font-size: 14px;
            color: #64748b;
            margin-bottom: 4px;
        }
        
        .stat-info .stat-value {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
        }
        
        .stat-info.dark .stat-value {
            color: white;
        }
    </style>
{% endblock %}

{% block body %}
<div class="space-y-8 animate-fade-in">
    <!-- Header + Bouton Créer Deck -->
    <div class="space-y-6 animate-fade-in">
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Révisions</h1>
                <p class="text-secondary-500 dark:text-secondary-400 mt-1">Étudiez efficacement avec des flashcards et la répétition espacée</p>
            </div>
            <a href="{{ path('app_admin_deck_new') }}"
               class="inline-flex items-center px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition shadow-md">
                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                Créer un deck
            </a>
        </div>

        <!-- Statistiques globales -->
        <div class="stats-grid">
            <div class="stat-card dark:stat-card.dark">
                <div class="stat-icon" style="background-color: #dbeafe;">
                    <i data-lucide="layers" class="w-6 h-6" style="color: #2563eb;"></i>
                </div>
                <div class="stat-info dark:stat-info.dark">
                    <h4>Total decks</h4>
                    <div class="stat-value" id="totalDecksStat">{{ decks|length }}</div>
                </div>
            </div>
            <div class="stat-card dark:stat-card.dark">
                <div class="stat-icon" style="background-color: #fef3c7;">
                    <i data-lucide="book-open" class="w-6 h-6" style="color: #d97706;"></i>
                </div>
                <div class="stat-info dark:stat-info.dark">
                    <h4>Matières</h4>
                    <div class="stat-value">{{ decks|map(d => d.matiere)|reduce((unique, item) => unique|merge([item]), [])|length }}</div>
                </div>
            </div>
            <div class="stat-card dark:stat-card.dark">
                <div class="stat-icon" style="background-color: #d1fae5;">
                    <i data-lucide="graduation-cap" class="w-6 h-6" style="color: #059669;"></i>
                </div>
                <div class="stat-info dark:stat-info.dark">
                    <h4>Niveaux</h4>
                    <div class="stat-value">{{ decks|map(d => d.niveau)|reduce((unique, item) => unique|merge([item]), [])|length }}</div>
                </div>
            </div>
            <div class="stat-card dark:stat-card.dark">
                <div class="stat-icon" style="background-color: #fce7f3;">
                    <i data-lucide="check-circle" class="w-6 h-6" style="color: #db2777;"></i>
                </div>
                <div class="stat-info dark:stat-info.dark">
                    <h4>Complétés</h4>
                    <div class="stat-value" id="completedDecksStat">0</div>
                </div>
            </div>
        </div>

        <!-- Barre de recherche et filtres -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-6">
            <!-- Barre de recherche principale -->
            <div class="search-container">
                <input type="text"
                       id="deckSearch"
                       placeholder="Rechercher par titre, matière, niveau ou description..."
                       value="{{ app.request.query.get('search') }}"
                       class="search-input dark:search-input.dark">
                <button type="button" id="searchButton" class="search-button dark:search-button.dark">
                    <i data-lucide="search" class="w-5 h-5"></i>
                </button>
            </div>
           
            <!-- Contrôles de filtrage et tri -->
            <div class="controls-container">
                <!-- Première ligne : Filtres -->
                <div class="filters-row">
                    <!-- Filtre par matière -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Matière</label>
                        <select id="subjectFilter" class="filter-select dark:filter-select.dark">
                            <option value="all" {% if app.request.query.get('subject') == 'all' or not app.request.query.get('subject') %}selected{% endif %}>Toutes les matières</option>
                            {% set subjects = [] %}
                            {% for deck in decks %}
                                {% if deck.matiere not in subjects %}
                                    {% set subjects = subjects|merge([deck.matiere]) %}
                                {% endif %}
                            {% endfor %}
                            {% for subject in subjects|sort %}
                                <option value="{{ subject|lower }}" {% if app.request.query.get('subject') == subject|lower %}selected{% endif %}>{{ subject }}</option>
                            {% endfor %}
                        </select>
                    </div>
                   
                    <!-- Filtre par niveau -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Niveau</label>
                        <select id="levelFilter" class="filter-select dark:filter-select.dark">
                            <option value="all" {% if app.request.query.get('level') == 'all' or not app.request.query.get('level') %}selected{% endif %}>Tous les niveaux</option>
                            {% set levels = [] %}
                            {% for deck in decks %}
                                {% if deck.niveau not in levels %}
                                    {% set levels = levels|merge([deck.niveau]) %}
                                {% endif %}
                            {% endfor %}
                            {% for level in levels|sort %}
                                <option value="{{ level|lower }}" {% if app.request.query.get('level') == level|lower %}selected{% endif %}>{{ level }}</option>
                            {% endfor %}
                        </select>
                    </div>
                   
                    <!-- Filtre par date -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Date de création</label>
                        <div class="date-search-container">
                            <input type="date" id="dateFrom" class="date-input dark:date-input.dark" value="{{ app.request.query.get('dateFrom') }}" placeholder="Du">
                            <span class="text-slate-400">au</span>
                            <input type="date" id="dateTo" class="date-input dark:date-input.dark" value="{{ app.request.query.get('dateTo') }}" placeholder="Au">
                        </div>
                    </div>
                   
                    <!-- Filtre par progression -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Progression</label>
                        <select id="progressFilter" class="filter-select dark:filter-select.dark">
                            <option value="all" {% if app.request.query.get('progress') == 'all' or not app.request.query.get('progress') %}selected{% endif %}>Toutes les progressions</option>
                            <option value="0-25" {% if app.request.query.get('progress') == '0-25' %}selected{% endif %}>0-25% (Débutant)</option>
                            <option value="26-50" {% if app.request.query.get('progress') == '26-50' %}selected{% endif %}>26-50% (Intermédiaire)</option>
                            <option value="51-75" {% if app.request.query.get('progress') == '51-75' %}selected{% endif %}>51-75% (Avancé)</option>
                            <option value="76-100" {% if app.request.query.get('progress') == '76-100' %}selected{% endif %}>76-100% (Expert)</option>
                            <option value="100" {% if app.request.query.get('progress') == '100' %}selected{% endif %}>100% (Complété)</option>
                        </select>
                    </div>
                </div>
               
                <!-- Deuxième ligne : Tris et actions -->
                <div class="filters-row">
                    <!-- Boutons de tri -->
                    <div class="filter-group" style="flex-grow: 1;">
                        <label class="filter-label dark:filter-label.dark">Trier par</label>
                        <div class="sort-buttons">
                            {% set currentSort = app.request.query.get('sort')|default('date-desc') %}
                            <button type="button" class="sort-button dark:sort-button.dark {% if currentSort == 'date-desc' %}active{% endif %}" data-sort="date-desc">
                                <i data-lucide="calendar" class="w-4 h-4"></i>
                                Plus récents
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark {% if currentSort == 'date' %}active{% endif %}" data-sort="date">
                                <i data-lucide="calendar" class="w-4 h-4"></i>
                                Plus anciens
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark {% if currentSort == 'title' %}active{% endif %}" data-sort="title">
                                <i data-lucide="arrow-up-a-z" class="w-4 h-4"></i>
                                Titre A-Z
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark {% if currentSort == 'title-desc' %}active{% endif %}" data-sort="title-desc">
                                <i data-lucide="arrow-down-z-a" class="w-4 h-4"></i>
                                Titre Z-A
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark {% if currentSort == 'progress' %}active{% endif %}" data-sort="progress">
                                <i data-lucide="trending-up" class="w-4 h-4"></i>
                                Progression ↑
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark {% if currentSort == 'progress-desc' %}active{% endif %}" data-sort="progress-desc">
                                <i data-lucide="trending-down" class="w-4 h-4"></i>
                                Progression ↓
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark {% if currentSort == 'cards' %}active{% endif %}" data-sort="cards">
                                <i data-lucide="layers" class="w-4 h-4"></i>
                                Nombre de cartes
                            </button>
                        </div>
                    </div>
                   
                    <!-- Boutons d'action -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark opacity-0">Actions</label>
                        <div class="action-buttons">
                            <button type="button" id="resetFilters" class="action-button reset dark:action-button.reset.dark">
                                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                                Réinitialiser
                            </button>
                            <a href="{{ path('app_admin_deck_pdf', app.request.query.all) }}" 
                               class="action-button pdf"
                               id="exportPdfBtn">
                                <i data-lucide="file-down" class="w-4 h-4"></i>
                                Exporter PDF
                            </a>
                        </div>
                    </div>
                </div>
            </div>
           
            <!-- Informations sur les résultats -->
            <div class="results-info dark:results-info.dark">
                <div id="resultCounter" class="deck-counter dark:deck-counter.dark">
                    {{ decks|length }} deck(s) affiché(s)
                </div>
                <div id="sortIndicator" class="sort-indicator dark:sort-indicator.dark">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    Tri : 
                    {% set currentSort = app.request.query.get('sort')|default('date-desc') %}
                    {% if currentSort == 'date-desc' %}Plus récents
                    {% elseif currentSort == 'date' %}Plus anciens
                    {% elseif currentSort == 'title' %}Titre A-Z
                    {% elseif currentSort == 'title-desc' %}Titre Z-A
                    {% elseif currentSort == 'progress' %}Progression ↑
                    {% elseif currentSort == 'progress-desc' %}Progression ↓
                    {% elseif currentSort == 'cards' %}Nombre de cartes
                    {% else %}Plus récents
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Liste des decks -->
        <div id="decksContainer">
            {% if decks is empty %}
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-12 text-center">
                <i data-lucide="layers" class="w-20 h-20 mx-auto text-slate-300 dark:text-slate-600 mb-6"></i>
                <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">Aucun deck pour le moment</h3>
                <p class="text-slate-600 dark:text-slate-400 mb-6">
                    Créez votre premier deck pour organiser vos flashcards et étudier efficacement
                </p>
                <a href="{{ path('app_admin_deck_new') }}"
                   class="inline-flex items-center px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl transition shadow-lg">
                    <i data-lucide="plus" class="w-6 h-6 mr-3"></i>
                    Créer mon premier deck
                </a>
            </div>
            {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {% set colorPalettes = [
                    {bg: '#fef3c7', border: '#f59e0b', text: '#d97706'},
                    {bg: '#dbeafe', border: '#3b82f6', text: '#2563eb'},
                    {bg: '#fce7f3', border: '#ec4899', text: '#db2777'},
                    {bg: '#d1fae5', border: '#10b981', text: '#059669'},
                    {bg: '#e0e7ff', border: '#6366f1', text: '#4f46e5'},
                    {bg: '#ffe4e6', border: '#f43f5e', text: '#e11d48'},
                    {bg: '#f3e8ff', border: '#a855f7', text: '#9333ea'},
                    {bg: '#ccfbf1', border: '#14b8a6', text: '#0d9488'}
                ] %}
                
                {% for deck in decks %}
                    {% set palette = colorPalettes[loop.index0 % colorPalettes|length] %}
                    {% set deckCards = deck.flashcards|length %}
                    {% set masteredCards = deck.flashcards|filter(f => f.maitrisee is defined and f.maitrisee == true)|length %}
                    {% set deckProgress = deckCards > 0 ? (masteredCards / deckCards * 100)|round : 0 %}
                   
                    <div class="deck-card bg-white rounded-2xl shadow-lg border-2 overflow-hidden hover:shadow-xl transition-all duration-300 group flex flex-col"
                         style="border-color: {{ palette.border }};"
                         data-title="{{ deck.titre|lower }}"
                         data-matiere="{{ deck.matiere|lower }}"
                         data-niveau="{{ deck.niveau|lower }}"
                         data-description="{{ deck.description|lower }}"
                         data-date="{{ deck.dateCreation ? deck.dateCreation|date('Y-m-d') : '' }}"
                         data-progress="{{ deckProgress }}"
                         data-cards="{{ deckCards }}"
                         data-id="{{ deck.idDeck }}">
                       
                        <!-- Image du deck -->
                        <div class="h-32 overflow-hidden relative">
                            {% if deck.image %}
                                <img src="{{ asset('uploads/decks/' ~ deck.image) }}"
                                     alt="{{ deck.titre }}"
                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center"
                                     style="background: linear-gradient(135deg, {{ palette.bg }}, {{ palette.border }});">
                                    <i data-lucide="layers" class="w-16 h-16 opacity-80" style="color: {{ palette.text }};"></i>
                                </div>
                            {% endif %}
                        </div>
                       
                        <div class="p-5 pb-0">
                            <div class="flex items-start justify-between mb-4">
                                <div class="w-12 h-12 rounded-lg backdrop-blur-sm flex items-center justify-center shadow-lg -mt-8 group-hover:scale-110 transition-transform"
                                     style="background-color: rgba(255, 255, 255, 0.9); border: 2px solid {{ palette.border }};">
                                    <i data-lucide="layers" class="w-6 h-6" style="color: {{ palette.text }};"></i>
                                </div>
                               
                                <span class="text-xs text-slate-500 font-medium">
                                    {{ deck.dateCreation ? deck.dateCreation|date('d/m/Y') : '—' }}
                                </span>
                            </div>
                            
                            <h3 class="text-xl font-bold mb-2 line-clamp-2" style="color: {{ palette.text }};">
                                {{ deck.titre }}
                            </h3>
                            
                            <p class="text-sm text-slate-600 mb-3 flex items-center gap-1.5">
                                <i data-lucide="book-open" class="w-4 h-4"></i>
                                {{ deck.matiere }} • {{ deck.niveau }}
                            </p>
                            
                            <p class="text-sm text-slate-500 mb-4 line-clamp-2">
                                {{ deck.description ?: 'Aucune description' }}
                            </p>
                        </div>
                        
                        <div class="px-5 pb-4">
                            <div class="flex gap-2 mb-4">
                                <span class="cards-badge"
                                      style="background-color: {{ palette.bg }}; color: {{ palette.text }}; border: 1px solid {{ palette.border }};">
                                    <i data-lucide="layers" class="w-3.5 h-3.5"></i>
                                    {{ deckCards }} carte{{ deckCards > 1 ? 's' : '' }}
                                </span>
                               
                                {% if masteredCards > 0 %}
                                <span class="cards-badge"
                                      style="background-color: #d1fae5; color: #059669; border: 1px solid #6ee7b7;">
                                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                                    {{ masteredCards }} maîtrisée{{ masteredCards > 1 ? 's' : '' }}
                                </span>
                                {% endif %}
                            </div>
                            
                            <div class="mb-4">
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-sm font-medium text-slate-600">Progression</span>
                                    <span class="text-sm font-bold" style="color: {{ palette.text }};">
                                        {{ deckProgress }}%
                                    </span>
                                </div>
                                <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                                    <div class="h-full rounded-full transition-all duration-500"
                                         style="width: {{ deckProgress }}%; background-color: {{ palette.text }};">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('app_admin_deck_show', {'id_deck': deck.idDeck}) }}"
                                   class="w-10 h-10 rounded-lg flex items-center justify-center transition-all hover:shadow-md hover:scale-110"
                                   style="background-color: #dbeafe; color: #2563eb;"
                                   title="Voir le deck et ses flashcards">
                                    <i data-lucide="eye" class="w-5 h-5"></i>
                                </a>
                               
                                <a href="{{ path('app_admin_deck_edit', {'id_deck': deck.idDeck}) }}"
                                   class="w-10 h-10 rounded-lg flex items-center justify-center transition-all hover:shadow-md hover:scale-110"
                                   style="background-color: {{ palette.bg }}; color: {{ palette.text }};"
                                   title="Modifier le deck">
                                    <i data-lucide="pencil" class="w-5 h-5"></i>
                                </a>
                               
                                <form method="post" action="{{ path('app_admin_deck_delete', {'id_deck': deck.idDeck}) }}"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce deck ?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ deck.idDeck) }}">
                                    <button type="submit"
                                            class="w-10 h-10 rounded-lg flex items-center justify-center bg-red-100 text-red-600 hover:bg-red-200 transition-all hover:shadow-md hover:scale-110"
                                            title="Supprimer le deck">
                                        <i data-lucide="trash-2" class="w-5 h-5"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Template pour "Aucun résultat" -->
    <template id="noResultsTemplate">
        <div class="no-results dark:no-results.dark bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-12 text-center">
            <i data-lucide="search" class="w-20 h-20 mx-auto no-results-icon mb-6"></i>
            <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">Aucun deck trouvé</h3>
            <p class="text-slate-600 dark:text-slate-400 mb-6">
                Ajustez vos filtres ou votre recherche pour trouver ce que vous cherchez.
            </p>
            <button type="button" id="clearSearchBtn" class="inline-flex items-center px-6 py-3 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition">
                <i data-lucide="x" class="w-5 h-5 mr-2"></i>
                Effacer tous les filtres
            </button>
        </div>
    </template>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Récupération des éléments DOM
        const deckSearch = document.getElementById('deckSearch');
        const searchButton = document.getElementById('searchButton');
        const subjectFilter = document.getElementById('subjectFilter');
        const levelFilter = document.getElementById('levelFilter');
        const dateFrom = document.getElementById('dateFrom');
        const dateTo = document.getElementById('dateTo');
        const progressFilter = document.getElementById('progressFilter');
        const sortButtons = document.querySelectorAll('.sort-button');
        const resetButton = document.getElementById('resetFilters');
        const deckCards = document.querySelectorAll('.deck-card');
        const decksContainer = document.getElementById('decksContainer');
        const resultCounter = document.getElementById('resultCounter');
        const sortIndicator = document.getElementById('sortIndicator');
        const completedDecksStat = document.getElementById('completedDecksStat');
        const totalDecksStat = document.getElementById('totalDecksStat');
        const noResultsTemplate = document.getElementById('noResultsTemplate');
        
        // Récupérer les paramètres de l'URL
        const urlParams = new URLSearchParams(window.location.search);
        
        // État actuel des filtres
        let currentState = {
            search: urlParams.get('search') || '',
            subject: urlParams.get('subject') || 'all',
            level: urlParams.get('level') || 'all',
            dateFrom: urlParams.get('dateFrom') || '',
            dateTo: urlParams.get('dateTo') || '',
            progress: urlParams.get('progress') || 'all',
            sort: urlParams.get('sort') || 'date-desc'
        };
        
        // Configuration des icônes et labels pour le tri
        const sortIcons = {
            'date-desc': 'calendar',
            'date': 'calendar',
            'title': 'arrow-up-a-z',
            'title-desc': 'arrow-down-z-a',
            'progress': 'trending-up',
            'progress-desc': 'trending-down',
            'cards': 'layers'
        };
        
        const sortLabels = {
            'date-desc': 'Plus récents',
            'date': 'Plus anciens',
            'title': 'Titre A-Z',
            'title-desc': 'Titre Z-A',
            'progress': 'Progression ↑',
            'progress-desc': 'Progression ↓',
            'cards': 'Nombre de cartes'
        };
        
        // Fonction pour vérifier si une date est dans l'intervalle
        function isDateInRange(dateString, from, to) {
            if (!dateString) return true;
            const date = new Date(dateString);
            date.setHours(0, 0, 0, 0);
            
            if (from) {
                const fromDate = new Date(from);
                fromDate.setHours(0, 0, 0, 0);
                if (date < fromDate) return false;
            }
            if (to) {
                const toDate = new Date(to);
                toDate.setHours(23, 59, 59, 999);
                if (date > toDate) return false;
            }
            return true;
        }
        
        // Fonction pour vérifier si la progression est dans l'intervalle
        function isProgressInRange(progress, range) {
            if (range === 'all') return true;
            if (range === '100') return progress == 100;
            const [min, max] = range.split('-').map(Number);
            return progress >= min && progress <= max;
        }
        
        // Fonction principale de filtrage
        function filterDecks() {
            let visibleCount = 0;
            let completedCount = 0;
            const visibleDecks = [];
            
            deckCards.forEach(card => {
                const title = card.getAttribute('data-title') || '';
                const matiere = card.getAttribute('data-matiere') || '';
                const niveau = card.getAttribute('data-niveau') || '';
                const description = card.getAttribute('data-description') || '';
                const date = card.getAttribute('data-date') || '';
                const progress = parseInt(card.getAttribute('data-progress')) || 0;
                const cards = parseInt(card.getAttribute('data-cards')) || 0;
                
                const searchMatch = currentState.search === '' ||
                    title.includes(currentState.search.toLowerCase()) ||
                    matiere.includes(currentState.search.toLowerCase()) ||
                    niveau.includes(currentState.search.toLowerCase()) ||
                    description.includes(currentState.search.toLowerCase());
                
                const subjectMatch = currentState.subject === 'all' ||
                    matiere === currentState.subject;
                
                const levelMatch = currentState.level === 'all' ||
                    niveau === currentState.level;
                
                const dateMatch = isDateInRange(date, currentState.dateFrom, currentState.dateTo);
                
                const progressMatch = isProgressInRange(progress, currentState.progress);
                
                if (searchMatch && subjectMatch && levelMatch && dateMatch && progressMatch) {
                    card.style.display = 'flex';
                    visibleCount++;
                    if (progress === 100) completedCount++;
                    visibleDecks.push({
                        element: card,
                        title: title,
                        date: date,
                        progress: progress,
                        cards: cards
                    });
                } else {
                    card.style.display = 'none';
                }
            });
            
            sortDecks(visibleDecks);
            updateUI(visibleCount, completedCount);
        }
        
        // Fonction de tri des decks
        function sortDecks(decks) {
            decks.sort((a, b) => {
                switch(currentState.sort) {
                    case 'date-desc':
                        return new Date(b.date) - new Date(a.date);
                    case 'date':
                        return new Date(a.date) - new Date(b.date);
                    case 'title':
                        return a.title.localeCompare(b.title);
                    case 'title-desc':
                        return b.title.localeCompare(a.title);
                    case 'progress':
                        return a.progress - b.progress;
                    case 'progress-desc':
                        return b.progress - a.progress;
                    case 'cards':
                        return a.cards - b.cards;
                    default:
                        return 0;
                }
            });
            
            const gridContainer = decksContainer.querySelector('.grid');
            if (gridContainer) {
                decks.forEach(deck => {
                    gridContainer.appendChild(deck.element);
                });
            }
        }
        
        // Mise à jour de l'interface
        function updateUI(visibleCount, completedCount) {
            // Mise à jour du compteur
            resultCounter.textContent = `${visibleCount} deck${visibleCount !== 1 ? 's' : ''} affiché${visibleCount !== 1 ? 's' : ''}`;
            
            // Mise à jour des statistiques
            if (totalDecksStat) {
                totalDecksStat.textContent = deckCards.length;
            }
            if (completedDecksStat) {
                completedDecksStat.textContent = completedCount || 0;
            }
            
            // Mise à jour de l'indicateur de tri
            const iconName = sortIcons[currentState.sort] || 'calendar';
            sortIndicator.innerHTML = `
                <i data-lucide="${iconName}" class="w-4 h-4"></i>
                Tri : ${sortLabels[currentState.sort] || 'Plus récents'}
            `;
            lucide.createIcons();
            
            // Gestion du message "Aucun résultat"
            const gridContainer = decksContainer.querySelector('.grid');
            if (gridContainer) {
                if (visibleCount === 0) {
                    gridContainer.style.display = 'none';
                    const noResults = noResultsTemplate.content.cloneNode(true);
                    const existingNoResults = decksContainer.querySelector('.no-results');
                    if (existingNoResults) existingNoResults.remove();
                    decksContainer.appendChild(noResults);
                    
                    setTimeout(() => {
                        const clearSearchBtn = decksContainer.querySelector('#clearSearchBtn');
                        if (clearSearchBtn) {
                            clearSearchBtn.addEventListener('click', resetAllFilters);
                        }
                        lucide.createIcons();
                    }, 100);
                } else {
                    gridContainer.style.display = 'grid';
                    const noResultsDiv = decksContainer.querySelector('.no-results');
                    if (noResultsDiv) noResultsDiv.remove();
                }
            }
        }
        
        // Réinitialisation de tous les filtres
        function resetAllFilters() {
            deckSearch.value = '';
            subjectFilter.value = 'all';
            levelFilter.value = 'all';
            dateFrom.value = '';
            dateTo.value = '';
            progressFilter.value = 'all';
            
            sortButtons.forEach(btn => btn.classList.remove('active'));
            const defaultSort = document.querySelector('.sort-button[data-sort="date-desc"]');
            if (defaultSort) defaultSort.classList.add('active');
            
            currentState = {
                search: '',
                subject: 'all',
                level: 'all',
                dateFrom: '',
                dateTo: '',
                progress: 'all',
                sort: 'date-desc'
            };
            
            // Mise à jour de l'URL sans recharger la page
            const url = new URL(window.location);
            url.search = '';
            window.history.pushState({}, '', url);
            
            filterDecks();
        }
        
        // Mise à jour de l'URL avec les filtres actuels
        function updateUrl() {
            const url = new URL(window.location);
            
            if (currentState.search) url.searchParams.set('search', currentState.search);
            else url.searchParams.delete('search');
            
            if (currentState.subject !== 'all') url.searchParams.set('subject', currentState.subject);
            else url.searchParams.delete('subject');
            
            if (currentState.level !== 'all') url.searchParams.set('level', currentState.level);
            else url.searchParams.delete('level');
            
            if (currentState.dateFrom) url.searchParams.set('dateFrom', currentState.dateFrom);
            else url.searchParams.delete('dateFrom');
            
            if (currentState.dateTo) url.searchParams.set('dateTo', currentState.dateTo);
            else url.searchParams.delete('dateTo');
            
            if (currentState.progress !== 'all') url.searchParams.set('progress', currentState.progress);
            else url.searchParams.delete('progress');
            
            if (currentState.sort !== 'date-desc') url.searchParams.set('sort', currentState.sort);
            else url.searchParams.delete('sort');
            
            window.history.pushState({}, '', url);
            
            // Mettre à jour le lien PDF
            const exportPdfBtn = document.getElementById('exportPdfBtn');
            if (exportPdfBtn) {
                exportPdfBtn.href = '{{ path("app_admin_deck_pdf") }}?' + url.searchParams.toString();
            }
        }
        
        // --- Event Listeners ---
        
        // Recherche en temps réel
        deckSearch.addEventListener('input', function() {
            currentState.search = this.value.trim().toLowerCase();
            updateUrl();
            filterDecks();
        });
        
        // Bouton de recherche
        searchButton.addEventListener('click', function() {
            currentState.search = deckSearch.value.trim().toLowerCase();
            updateUrl();
            filterDecks();
        });
        
        // Touche Entrée dans la recherche
        deckSearch.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                currentState.search = this.value.trim().toLowerCase();
                updateUrl();
                filterDecks();
            }
        });
        
        // Filtres
        subjectFilter.addEventListener('change', function() {
            currentState.subject = this.value;
            updateUrl();
            filterDecks();
        });
        
        levelFilter.addEventListener('change', function() {
            currentState.level = this.value;
            updateUrl();
            filterDecks();
        });
        
        dateFrom.addEventListener('change', function() {
            currentState.dateFrom = this.value;
            updateUrl();
            filterDecks();
        });
        
        dateTo.addEventListener('change', function() {
            currentState.dateTo = this.value;
            updateUrl();
            filterDecks();
        });
        
        progressFilter.addEventListener('change', function() {
            currentState.progress = this.value;
            updateUrl();
            filterDecks();
        });
        
        // Boutons de tri
        sortButtons.forEach(button => {
            button.addEventListener('click', function() {
                sortButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');
                currentState.sort = this.getAttribute('data-sort');
                updateUrl();
                filterDecks();
            });
        });
        
        // Bouton de réinitialisation
        resetButton.addEventListener('click', resetAllFilters);
        
        // Initialiser la valeur de recherche
        if (deckSearch) {
            deckSearch.value = currentState.search;
        }
        
        // Appliquer les filtres au chargement
        filterDecks();
    });
    </script>
{% endblock %}