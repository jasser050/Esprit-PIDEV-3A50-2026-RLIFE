{% extends 'admin/base_admin.html.twig' %}

{% block title %}Révisions - RLIFE Admin{% endblock %}

{% block body %}
<div class="space-y-8 animate-fade-in">

    <!-- Header + Bouton Créer Deck -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Révisions</h1>
            <p class="text-slate-600 dark:text-slate-400 mt-1">
                Étudie efficacement avec des flashcards et la répétition espacée
            </p>
        </div>
        <a href="{{ path('app_admin_deck_new') }}"
           class="inline-flex items-center px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition shadow-md">
            <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
            Créer un Deck
        </a>
    </div>

    <!-- Statistiques -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                <i data-lucide="layers" class="w-6 h-6 text-indigo-600 dark:text-indigo-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">{{ decks|length }}</p>
                <p class="text-sm text-slate-600 dark:text-slate-400">Decks au total</p>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
                <i data-lucide="check-circle" class="w-6 h-6 text-green-600 dark:text-green-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-green-600 dark:text-green-400">0</p>
                <p class="text-sm text-slate-600 dark:text-slate-400">Cartes maîtrisées</p>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                <i data-lucide="inbox" class="w-6 h-6 text-amber-600 dark:text-amber-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-amber-600 dark:text-amber-400">0</p>
                <p class="text-sm text-slate-600 dark:text-slate-400">Cartes totales</p>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
            <div class="w-12 h-12 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                <i data-lucide="flame" class="w-6 h-6 text-red-600 dark:text-red-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-red-600 dark:text-red-400">12</p>
                <p class="text-sm text-slate-600 dark:text-slate-400">À réviser aujourd’hui</p>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-2xl p-8 text-white relative overflow-hidden">
        <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div>
                <h3 class="text-2xl font-semibold">Prêt à réviser ?</h3>
                <p class="text-indigo-100">Crée un nouveau deck pour commencer à étudier</p>
            </div>
        </div>
    </div>

    <!-- Liste des decks -->
    {% if decks is empty %}
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-12 text-center">
        <i data-lucide="layers-2" class="w-20 h-20 mx-auto text-slate-300 dark:text-slate-600 mb-6"></i>
        <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">Aucun deck pour l'instant</h3>
        <p class="text-slate-600 dark:text-slate-400 mb-6">
            Crée ton premier deck pour organiser tes flashcards et réviser efficacement
        </p>
        <a href="{{ path('app_admin_deck_new') }}"
           class="inline-flex items-center px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl transition shadow-lg">
            <i data-lucide="plus" class="w-6 h-6 mr-3"></i>
            Créer ton premier Deck
        </a>
    </div>
    {% else %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {% set colorPalettes = [
            {from: '#dbeafe', accent: '#2563eb'},
            {from: '#f3e8ff', accent: '#7c3aed'},
            {from: '#fce7f3', accent: '#ec4899'},
            {from: '#d1fae5', accent: '#10b981'},
            {from: '#cffafe', accent: '#06b6d4'},
            {from: '#fef3c7', accent: '#d97706'},
            {from: '#d1fae5', accent: '#059669'},
            {from: '#fae8ff', accent: '#c026d3'},
            {from: '#f3e8ff', accent: '#9333ea'},
            {from: '#e0f2fe', accent: '#0284c7'},
            {from: '#ffe4e6', accent: '#e11d48'},
            {from: '#ecfccb', accent: '#65a30d'}
        ] %}

        {% for deck in decks %}
        {% set palette = colorPalettes[loop.index0 % colorPalettes|length] %}

        <div class="rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 group border"
             style="background: linear-gradient(to bottom, {{ palette.from }}, white); border-color: {{ palette.from }};">
            <!-- Photo de couverture -->
            <div class="h-32 overflow-hidden relative">
                {% if deck.image %}
                <img src="{{ asset('uploads/decks/' ~ deck.image) }}"
                     alt="{{ deck.titre }}"
                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                {% else %}
                <div class="w-full h-full flex items-center justify-center"
                     style="background: linear-gradient(135deg, {{ palette.from }}, white);">
                    <i data-lucide="layers" class="w-16 h-16 opacity-80"
                       style="color: {{ palette.accent }};"></i>
                </div>
                {% endif %}
            </div>

            <div class="p-4">
                <div class="flex items-start justify-between mb-3">
                    <div class="w-10 h-10 rounded-lg backdrop-blur-sm flex items-center justify-center group-hover:scale-110 transition-transform -mt-6 shadow-lg"
                         style="background-color: rgba(255, 255, 255, 0.9); border: 2px solid {{ palette.from }};">
                        <i data-lucide="layers" class="w-5 h-5"
                           style="color: {{ palette.accent }};"></i>
                    </div>
                    <span class="text-xs text-slate-500 dark:text-slate-400">
                        {{ deck.dateCreation ? deck.dateCreation|date('d/m/Y') : '—' }}
                    </span>
                </div>

                <h3 class="text-lg font-semibold mb-1 truncate" style="color: {{ palette.accent }};">
                    {{ deck.titre }}
                </h3>

                <p class="text-xs text-slate-600 dark:text-slate-400 mb-2 flex items-center gap-1">
                    <i data-lucide="book-open" class="w-3 h-3"></i>
                    {{ deck.matiere }} • {{ deck.niveau }}
                </p>

                <p class="text-xs text-slate-500 dark:text-slate-400 mb-3 line-clamp-2 h-8">
                    {{ deck.description ?: 'Aucune description' }}
                </p>

                <div class="flex flex-wrap gap-1.5 mb-3">
                    <span class="px-2 py-1 rounded text-xs font-medium shadow-sm"
                          style="background-color: {{ palette.from }}; color: {{ palette.accent }}; border: 1px solid {{ palette.from }};">
                        {{ deck.flashcards|length }} cartes
                    </span>
                    <span class="px-2 py-1 rounded text-xs font-medium shadow-sm"
                          style="background-color: #d1fae5; color: #059669; border: 1px solid #a7f3d0;">
                        0 maîtrisées
                    </span>
                </div>

                <div class="space-y-1.5 mb-4">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-slate-500 dark:text-slate-400">Progression</span>
                        <span class="font-semibold" style="color: {{ palette.accent }};">0%</span>
                    </div>
                    <div class="h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                        <div class="h-full transition-all duration-500"
                             style="width: 0%; background: linear-gradient(to right, {{ palette.accent }}, {{ palette.accent }});"></div>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <a href="{{ path('app_admin_deck_edit', {'id_deck': deck.id}) }}"
                       class="transition hover:scale-110"
                       style="color: {{ palette.accent }};">
                        <i data-lucide="edit-3" class="w-4 h-4"></i>
                    </a>

                    <form method="post" action="{{ path('app_admin_deck_delete', {'id_deck': deck.id}) }}"
                          onsubmit="return confirm('Vraiment supprimer ce deck ?');" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ deck.id) }}">
                        <button type="submit" class="text-red-600 dark:text-red-400 hover:text-red-700 transition hover:scale-110">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}