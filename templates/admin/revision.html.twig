{% extends 'admin/base_admin.html.twig' %}

{% block title %}Revisions{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Barre de recherche principale */
    .search-container {
        position: relative;
        max-width: 100%;
    }
    
    .search-input {
        width: 100%;
        padding: 12px 48px 12px 16px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 16px;
        transition: all 0.3s ease;
        background-color: white;
    }
    
    .search-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .search-input.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: white;
    }
    
    .search-button {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #64748b;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    .search-button:hover {
        background-color: #f1f5f9;
        color: #3b82f6;
    }
    
    .search-button.dark:hover {
        background-color: #334155;
        color: #60a5fa;
    }
    
    /* Filtres et tris */
    .controls-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 16px;
    }
    
    .filters-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }
    
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    
    .filter-label {
        font-size: 14px;
        font-weight: 500;
        color: #64748b;
    }
    
    .filter-label.dark {
        color: #94a3b8;
    }
    
    .filter-select {
        padding: 8px 12px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        background-color: white;
        cursor: pointer;
        min-width: 150px;
        transition: all 0.3s ease;
    }
    
    .filter-select:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .filter-select.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: white;
    }
    
    .filter-select.dark:focus {
        border-color: #60a5fa;
    }
    
    /* Recherche par date */
    .date-search-container {
        display: flex;
        gap: 8px;
        align-items: center;
    }
    
    .date-input {
        padding: 8px 12px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        width: 150px;
        transition: all 0.3s ease;
    }
    
    .date-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .date-input.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: white;
    }
    
    /* Boutons de tri */
    .sort-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    
    .sort-button {
        padding: 8px 16px;
        border-radius: 20px;
        border: 2px solid #e2e8f0;
        background-color: white;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .sort-button:hover {
        border-color: #3b82f6;
        color: #3b82f6;
    }
    
    .sort-button.active {
        background-color: #3b82f6;
        color: white;
        border-color: #3b82f6;
    }
    
    .sort-button.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: #cbd5e1;
    }
    
    .sort-button.dark:hover {
        border-color: #60a5fa;
        color: #60a5fa;
    }
    
    .sort-button.dark.active {
        background-color: #60a5fa;
        color: white;
        border-color: #60a5fa;
    }
    
    /* Boutons d'action */
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-button {
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .action-button.reset {
        background-color: #f1f5f9;
        color: #64748b;
    }
    
    .action-button.reset:hover {
        background-color: #e2e8f0;
    }
    
    .action-button.reset.dark {
        background-color: #334155;
        color: #cbd5e1;
    }
    
    .action-button.reset.dark:hover {
        background-color: #475569;
    }
    
    /* Compteur de résultats */
    .results-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }
    
    .results-info.dark {
        border-top-color: #475569;
    }
    
    .deck-counter {
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
    }
    
    .deck-counter.dark {
        color: #94a3b8;
    }
    
    .sort-indicator {
        color: #3b82f6;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .sort-indicator.dark {
        color: #60a5fa;
    }
    
    /* Message "Aucun résultat" */
    .no-results {
        text-align: center;
        padding: 60px 20px;
        grid-column: 1 / -1;
    }
    
    .no-results-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        color: #cbd5e1;
    }
    
    .no-results.dark .no-results-icon {
        color: #475569;
    }
    
    /* Animation pour les cartes */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .deck-card {
        animation: fadeIn 0.3s ease-out;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
        .filters-row {
            flex-direction: column;
            align-items: stretch;
        }
        
        .filter-select, .date-input {
            width: 100%;
        }
        
        .date-search-container {
            flex-direction: column;
        }
        
        .results-info {
            flex-direction: column;
            gap: 12px;
            align-items: flex-start;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="space-y-8 animate-fade-in">

    <!-- Header + Bouton Créer Deck -->
    <div class="space-y-6 animate-fade-in">
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Revisions</h1>
                <p class="text-secondary-500 dark:text-secondary-400 mt-1">Study efficiently with flashcards and spaced repetition</p>
            </div>
            <a href="{{ path('app_admin_deck_new') }}"
               class="inline-flex items-center px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg transition shadow-md">
                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                Create Deck
            </a>
        </div>

        <!-- Barre de recherche et filtres -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-6">
            <!-- Barre de recherche principale -->
            <div class="search-container">
                <input type="text" 
                       id="deckSearch" 
                       placeholder="Search decks by title, subject, level or description..." 
                       class="search-input dark:search-input.dark">
                <button type="button" id="searchButton" class="search-button dark:search-button.dark">
                    <i data-lucide="search" class="w-5 h-5"></i>
                </button>
            </div>
            
            <!-- Contrôles de filtrage et tri -->
            <div class="controls-container">
                <!-- Première ligne : Filtres -->
                <div class="filters-row">
                    <!-- Filtre par matière -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Subject</label>
                        <select id="subjectFilter" class="filter-select dark:filter-select.dark">
                            <option value="all">All Subjects</option>
                            {% set subjects = [] %}
                            {% for deck in decks %}
                                {% if deck.matiere not in subjects %}
                                    {% set subjects = subjects|merge([deck.matiere]) %}
                                {% endif %}
                            {% endfor %}
                            {% for subject in subjects|sort %}
                                <option value="{{ subject|lower }}">{{ subject }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <!-- Filtre par niveau -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Level</label>
                        <select id="levelFilter" class="filter-select dark:filter-select.dark">
                            <option value="all">All Levels</option>
                            {% set levels = [] %}
                            {% for deck in decks %}
                                {% if deck.niveau not in levels %}
                                    {% set levels = levels|merge([deck.niveau]) %}
                                {% endif %}
                            {% endfor %}
                            {% for level in levels|sort %}
                                <option value="{{ level|lower }}">{{ level }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <!-- Filtre par date -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Date Created</label>
                        <div class="date-search-container">
                            <input type="date" id="dateFrom" class="date-input dark:date-input.dark" placeholder="From">
                            <span class="text-slate-400">to</span>
                            <input type="date" id="dateTo" class="date-input dark:date-input.dark" placeholder="To">
                        </div>
                    </div>
                    
                    <!-- Filtre par progression -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark">Progress</label>
                        <select id="progressFilter" class="filter-select dark:filter-select.dark">
                            <option value="all">All Progress</option>
                            <option value="0-25">0-25% (Beginner)</option>
                            <option value="26-50">26-50% (Intermediate)</option>
                            <option value="51-75">51-75% (Advanced)</option>
                            <option value="76-100">76-100% (Master)</option>
                            <option value="100">100% (Completed)</option>
                        </select>
                    </div>
                </div>
                
                <!-- Deuxième ligne : Tris et actions -->
                <div class="filters-row">
                    <!-- Boutons de tri -->
                    <div class="filter-group" style="flex-grow: 1;">
                        <label class="filter-label dark:filter-label.dark">Sort by</label>
                        <div class="sort-buttons">
                            <button type="button" class="sort-button dark:sort-button.dark active" data-sort="date-desc">
                                <i data-lucide="calendar" class="w-4 h-4"></i>
                                Newest First
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark" data-sort="date">
                                <i data-lucide="calendar" class="w-4 h-4"></i>
                                Oldest First
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark" data-sort="title">
                                <i data-lucide="arrow-up-a-z" class="w-4 h-4"></i>
                                Title A-Z
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark" data-sort="title-desc">
                                <i data-lucide="arrow-down-z-a" class="w-4 h-4"></i>
                                Title Z-A
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark" data-sort="progress">
                                <i data-lucide="trending-up" class="w-4 h-4"></i>
                                Progress ↑
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark" data-sort="progress-desc">
                                <i data-lucide="trending-down" class="w-4 h-4"></i>
                                Progress ↓
                            </button>
                            <button type="button" class="sort-button dark:sort-button.dark" data-sort="cards">
                                <i data-lucide="layers" class="w-4 h-4"></i>
                                Cards Count
                            </button>
                        </div>
                    </div>
                    
                    <!-- Boutons d'action -->
                    <div class="filter-group">
                        <label class="filter-label dark:filter-label.dark opacity-0">Actions</label>
                        <div class="action-buttons">
                            <button type="button" id="resetFilters" class="action-button reset dark:action-button.reset.dark">
                                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                                Reset All
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Informations sur les résultats -->
            <div class="results-info dark:results-info.dark">
                <div id="resultCounter" class="deck-counter dark:deck-counter.dark">
                    Showing {{ decks|length }} decks
                </div>
                <div id="sortIndicator" class="sort-indicator dark:sort-indicator.dark">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    Sorted by: Newest First
                </div>
            </div>
        </div>

        <!-- Statistiques -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
            <!-- Statistiques restent inchangées -->
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                    <i data-lucide="layers" class="w-6 h-6 text-indigo-600 dark:text-indigo-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-indigo-600 dark:text-indigo-400" id="totalDecks">{{ decks|length }}</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Total Decks</p>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
                    <i data-lucide="check-circle" class="w-6 h-6 text-green-600 dark:text-green-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-slate-900 dark:text-white">6</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Mastered Cards</p>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                    <i data-lucide="inbox" class="w-6 h-6 text-amber-600 dark:text-amber-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-slate-900 dark:text-white">15</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400">Total Cards</p>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-6 flex items-center gap-5">
                <div class="w-12 h-12 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                    <i data-lucide="flame" class="w-6 h-6 text-red-600 dark:text-red-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-slate-900 dark:text-white">12</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400">To Review Today</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Liste des decks -->
    <div id="decksContainer">
        {% if decks is empty %}
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-12 text-center">
            <i data-lucide="layers-2" class="w-20 h-20 mx-auto text-slate-300 dark:text-slate-600 mb-6"></i>
            <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">No decks yet</h3>
            <p class="text-slate-600 dark:text-slate-400 mb-6">
                Create your first deck to organize your flashcards and study effectively
            </p>
            <a href="{{ path('app_admin_deck_new') }}"
               class="inline-flex items-center px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl transition shadow-lg">
                <i data-lucide="plus" class="w-6 h-6 mr-3"></i>
                Create your first Deck
            </a>
        </div>
        {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% set colorPalettes = [
                {bg: '#fef3c7', border: '#f59e0b', text: '#d97706'},
                {bg: '#dbeafe', border: '#3b82f6', text: '#2563eb'},
                {bg: '#fce7f3', border: '#ec4899', text: '#db2777'},
                {bg: '#d1fae5', border: '#10b981', text: '#059669'},
                {bg: '#e0e7ff', border: '#6366f1', text: '#4f46e5'},
                {bg: '#ffe4e6', border: '#f43f5e', text: '#e11d48'},
                {bg: '#f3e8ff', border: '#a855f7', text: '#9333ea'},
                {bg: '#ccfbf1', border: '#14b8a6', text: '#0d9488'},
                {bg: '#fef08a', border: '#eab308', text: '#ca8a04'},
                {bg: '#fbcfe8', border: '#ec4899', text: '#db2777'},
                {bg: '#bfdbfe', border: '#3b82f6', text: '#2563eb'},
                {bg: '#c7d2fe', border: '#818cf8', text: '#6366f1'}
            ] %}

            {% set demoStats = [
                {cards: 15, mastered: 6, progress: 40},
                {cards: 8, mastered: 4, progress: 50},
                {cards: 12, mastered: 9, progress: 75},
                {cards: 10, mastered: 7, progress: 70},
                {cards: 20, mastered: 15, progress: 75},
                {cards: 6, mastered: 3, progress: 50},
                {cards: 14, mastered: 10, progress: 71},
                {cards: 9, mastered: 6, progress: 67},
                {cards: 11, mastered: 8, progress: 73},
                {cards: 7, mastered: 5, progress: 71},
                {cards: 13, mastered: 9, progress: 69},
                {cards: 16, mastered: 12, progress: 75}
            ] %}

            {% for deck in decks %}
                {% set palette = colorPalettes[loop.index0 % colorPalettes|length] %}
                {% set demoIndex = loop.index0 % demoStats|length %}
                {% set deckCards = demoStats[demoIndex].cards %}
                {% set deckMastered = demoStats[demoIndex].mastered %}
                {% set deckProgress = demoStats[demoIndex].progress %}
                
                <div class="deck-card bg-white rounded-2xl shadow-lg border-2 overflow-hidden hover:shadow-xl transition-all duration-300 group flex flex-col"
                     style="border-color: {{ palette.border }};"
                     data-title="{{ deck.titre|lower }}"
                     data-matiere="{{ deck.matiere|lower }}"
                     data-niveau="{{ deck.niveau|lower }}"
                     data-description="{{ deck.description|lower }}"
                     data-date="{{ deck.dateCreation ? deck.dateCreation|date('Y-m-d') : '' }}"
                     data-progress="{{ deckProgress }}"
                     data-cards="{{ deckCards }}">
                    
                    <!-- Image du deck -->
                    <div class="h-32 overflow-hidden relative">
                        {% if deck.image %}
                            <img src="{{ asset('uploads/decks/' ~ deck.image) }}"
                                 alt="{{ deck.titre }}"
                                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center"
                                 style="background: linear-gradient(135deg, {{ palette.bg }}, {{ palette.border }});">
                                <i data-lucide="layers" class="w-16 h-16 opacity-80" style="color: {{ palette.text }};"></i>
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="p-5 pb-0">
                        <div class="flex items-start justify-between mb-4">
                            <div class="w-12 h-12 rounded-lg backdrop-blur-sm flex items-center justify-center shadow-lg -mt-8 group-hover:scale-110 transition-transform"
                                 style="background-color: rgba(255, 255, 255, 0.9); border: 2px solid {{ palette.border }};">
                                <i data-lucide="layers" class="w-6 h-6" style="color: {{ palette.text }};"></i>
                            </div>
                            
                            <span class="text-xs text-slate-500 font-medium">
                                {{ deck.dateCreation ? deck.dateCreation|date('d/m/Y') : '—' }}
                            </span>
                        </div>

                        <h3 class="text-xl font-bold mb-2 line-clamp-2" style="color: {{ palette.text }};">
                            {{ deck.titre }}
                        </h3>

                        <p class="text-sm text-slate-600 mb-3 flex items-center gap-1.5">
                            <i data-lucide="book-open" class="w-4 h-4"></i>
                            {{ deck.matiere }} • {{ deck.niveau }}
                        </p>

                        <p class="text-sm text-slate-500 mb-4 line-clamp-2">
                            {{ deck.description ?: 'No description available' }}
                        </p>
                    </div>

                    <div class="px-5 pb-4">
                        <div class="flex gap-2 mb-4">
                            <span class="px-3 py-1.5 rounded-lg text-sm font-semibold shadow-sm"
                                  style="background-color: {{ palette.bg }}; color: {{ palette.text }}; border: 1px solid {{ palette.border }};">
                                <i data-lucide="layers" class="w-3.5 h-3.5 inline mr-1"></i>
                                {{ deckCards }} cards
                            </span>
                            
                            <span class="px-3 py-1.5 rounded-lg text-sm font-semibold shadow-sm"
                                  style="background-color: #d1fae5; color: #059669; border: 1px solid #6ee7b7;">
                                <i data-lucide="check-circle" class="w-3.5 h-3.5 inline mr-1"></i>
                                {{ deckMastered }} mastered
                            </span>
                        </div>

                        <div class="mb-4">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-sm font-medium text-slate-600">Progress</span>
                                <span class="text-sm font-bold" style="color: {{ palette.text }};">
                                    {{ deckProgress }}%
                                </span>
                            </div>
                            <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                                <div class="h-full rounded-full transition-all duration-500"
                                     style="width: {{ deckProgress }}%; background-color: {{ palette.text }};">
                                </div>
                            </div>
                        </div>

                        {# ✨ SECTION MODIFIÉE : 3 boutons (View, Edit, Delete) #}
                        <div class="flex justify-end gap-2">
                            <!-- NOUVEAU : Bouton View (👁️) -->
                            <a href="{{ path('app_admin_deck_show', {'id_deck': deck.idDeck}) }}"
                               class="w-10 h-10 rounded-lg flex items-center justify-center transition-all hover:shadow-md hover:scale-110"
                               style="background-color: #dbeafe; color: #2563eb;"
                               title="View deck and flashcards">
                                <i data-lucide="eye" class="w-5 h-5"></i>
                            </a>
                            
                            <!-- Bouton Edit (✏️) -->
                            <a href="{{ path('app_admin_deck_edit', {'id_deck': deck.idDeck}) }}"
                               class="w-10 h-10 rounded-lg flex items-center justify-center transition-all hover:shadow-md hover:scale-110"
                               style="background-color: {{ palette.bg }}; color: {{ palette.text }};"
                               title="Edit deck">
                                <i data-lucide="pencil" class="w-5 h-5"></i>
                            </a>
                            
                            <!-- Bouton Delete (🗑️) -->
                            <form method="post" action="{{ path('app_admin_deck_delete', {'id_deck': deck.idDeck}) }}"
                                  onsubmit="return confirm('Really delete this deck?');" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ deck.idDeck) }}">
                                <button type="submit" 
                                        class="w-10 h-10 rounded-lg flex items-center justify-center bg-red-100 text-red-600 hover:bg-red-200 transition-all hover:shadow-md hover:scale-110"
                                        title="Delete deck">
                                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

<!-- Template pour "Aucun résultat" -->
<template id="noResultsTemplate">
    <div class="no-results dark:no-results.dark bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-12 text-center">
        <i data-lucide="search" class="w-20 h-20 mx-auto no-results-icon mb-6"></i>
        <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">No decks found</h3>
        <p class="text-slate-600 dark:text-slate-400 mb-6">
            Try adjusting your search or filter to find what you're looking for.
        </p>
        <button type="button" id="clearSearch" class="inline-flex items-center px-6 py-3 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition">
            <i data-lucide="x" class="w-5 h-5 mr-2"></i>
            Clear all filters
        </button>
    </div>
</template>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Éléments DOM
    const deckSearch = document.getElementById('deckSearch');
    const searchButton = document.getElementById('searchButton');
    const subjectFilter = document.getElementById('subjectFilter');
    const levelFilter = document.getElementById('levelFilter');
    const dateFrom = document.getElementById('dateFrom');
    const dateTo = document.getElementById('dateTo');
    const progressFilter = document.getElementById('progressFilter');
    const sortButtons = document.querySelectorAll('.sort-button');
    const resetButton = document.getElementById('resetFilters');
    const deckCards = document.querySelectorAll('.deck-card');
    const decksContainer = document.getElementById('decksContainer');
    const resultCounter = document.getElementById('resultCounter');
    const sortIndicator = document.getElementById('sortIndicator');
    const totalDecks = document.getElementById('totalDecks');
    const noResultsTemplate = document.getElementById('noResultsTemplate');
    
    // État courant
    let currentState = {
        search: '',
        subject: 'all',
        level: 'all',
        dateFrom: '',
        dateTo: '',
        progress: 'all',
        sort: 'date-desc'
    };
    
    // Icônes pour l'indicateur de tri
    const sortIcons = {
        'date-desc': 'calendar',
        'date': 'calendar',
        'title': 'arrow-up-a-z',
        'title-desc': 'arrow-down-z-a',
        'progress': 'trending-up',
        'progress-desc': 'trending-down',
        'cards': 'layers'
    };
    
    const sortLabels = {
        'date-desc': 'Newest First',
        'date': 'Oldest First',
        'title': 'Title A-Z',
        'title-desc': 'Title Z-A',
        'progress': 'Progress ↑',
        'progress-desc': 'Progress ↓',
        'cards': 'Cards Count'
    };
    
    // Fonction pour vérifier si une date est dans l'intervalle
    function isDateInRange(dateString, from, to) {
        if (!dateString) return false;
        
        const date = new Date(dateString);
        const fromDate = from ? new Date(from) : null;
        const toDate = to ? new Date(to) : null;
        
        if (fromDate && date < fromDate) return false;
        if (toDate && date > toDate) return false;
        
        return true;
    }
    
    // Fonction pour vérifier si la progression est dans la plage
    function isProgressInRange(progress, range) {
        if (range === 'all') return true;
        if (range === '100') return progress == 100;
        
        const [min, max] = range.split('-').map(Number);
        return progress >= min && progress <= max;
    }
    
    // Fonction pour filtrer les decks
    function filterDecks() {
        let visibleCount = 0;
        const visibleDecks = [];
        
        deckCards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const matiere = card.getAttribute('data-matiere') || '';
            const niveau = card.getAttribute('data-niveau') || '';
            const description = card.getAttribute('data-description') || '';
            const date = card.getAttribute('data-date') || '';
            const progress = parseInt(card.getAttribute('data-progress')) || 0;
            const cards = parseInt(card.getAttribute('data-cards')) || 0;
            
            // Vérifier la recherche
            const searchMatch = currentState.search === '' || 
                title.includes(currentState.search) ||
                matiere.includes(currentState.search) ||
                niveau.includes(currentState.search) ||
                description.includes(currentState.search);
            
            // Vérifier le sujet
            const subjectMatch = currentState.subject === 'all' || 
                matiere === currentState.subject;
            
            // Vérifier le niveau
            const levelMatch = currentState.level === 'all' || 
                niveau === currentState.level;
            
            // Vérifier la date
            const dateMatch = isDateInRange(date, currentState.dateFrom, currentState.dateTo);
            
            // Vérifier la progression
            const progressMatch = isProgressInRange(progress, currentState.progress);
            
            // Afficher ou cacher la carte
            if (searchMatch && subjectMatch && levelMatch && dateMatch && progressMatch) {
                card.style.display = 'flex';
                visibleCount++;
                visibleDecks.push({
                    element: card,
                    title: title,
                    date: date,
                    progress: progress,
                    cards: cards
                });
            } else {
                card.style.display = 'none';
            }
        });
        
        // Trier les decks visibles
        sortDecks(visibleDecks);
        
        // Mettre à jour l'interface
        updateUI(visibleCount);
    }
    
    // Fonction pour trier les decks
    function sortDecks(decks) {
        decks.sort((a, b) => {
            switch(currentState.sort) {
                case 'date-desc':
                    return new Date(b.date) - new Date(a.date);
                case 'date':
                    return new Date(a.date) - new Date(b.date);
                case 'title':
                    return a.title.localeCompare(b.title);
                case 'title-desc':
                    return b.title.localeCompare(a.title);
                case 'progress':
                    return a.progress - b.progress;
                case 'progress-desc':
                    return b.progress - a.progress;
                case 'cards':
                    return a.cards - b.cards;
                default:
                    return 0;
            }
        });
        
        // Réorganiser les cartes dans le DOM
        const gridContainer = decksContainer.querySelector('.grid');
        if (gridContainer) {
            decks.forEach(deck => {
                gridContainer.appendChild(deck.element);
            });
        }
    }
    
    // Fonction pour mettre à jour l'interface
    function updateUI(visibleCount) {
        // Mettre à jour le compteur
        resultCounter.textContent = `Showing ${visibleCount} deck${visibleCount !== 1 ? 's' : ''}`;
        
        // Mettre à jour l'indicateur de tri
        const iconName = sortIcons[currentState.sort];
        sortIndicator.innerHTML = `
            <i data-lucide="${iconName}" class="w-4 h-4"></i>
            Sorted by: ${sortLabels[currentState.sort]}
        `;
        lucide.createIcons();
        
        // Gérer l'affichage "Aucun résultat"
        const gridContainer = decksContainer.querySelector('.grid');
        if (gridContainer) {
            if (visibleCount === 0) {
                gridContainer.style.display = 'none';
                const noResults = noResultsTemplate.content.cloneNode(true);
                
                // Supprimer d'abord l'ancien message
                const existingNoResults = decksContainer.querySelector('.no-results');
                if (existingNoResults) {
                    existingNoResults.remove();
                }
                
                decksContainer.appendChild(noResults);
                
                // Ajouter l'écouteur d'événement pour effacer tout
                setTimeout(() => {
                    const clearSearchBtn = decksContainer.querySelector('#clearSearch');
                    if (clearSearchBtn) {
                        clearSearchBtn.addEventListener('click', resetAllFilters);
                    }
                    lucide.createIcons();
                }, 100);
            } else {
                gridContainer.style.display = 'grid';
                const noResultsDiv = decksContainer.querySelector('.no-results');
                if (noResultsDiv) {
                    noResultsDiv.remove();
                }
            }
        }
    }
    
    // Fonction pour réinitialiser tous les filtres
    function resetAllFilters() {
        deckSearch.value = '';
        subjectFilter.value = 'all';
        levelFilter.value = 'all';
        dateFrom.value = '';
        dateTo.value = '';
        progressFilter.value = 'all';
        
        // Réactiver le tri par défaut
        sortButtons.forEach(btn => btn.classList.remove('active'));
        const defaultSort = document.querySelector('.sort-button[data-sort="date-desc"]');
        if (defaultSort) defaultSort.classList.add('active');
        
        // Réinitialiser l'état
        currentState = {
            search: '',
            subject: 'all',
            level: 'all',
            dateFrom: '',
            dateTo: '',
            progress: 'all',
            sort: 'date-desc'
        };
        
        // Réappliquer les filtres
        filterDecks();
    }
    
    // Écouteurs d'événements
    // Recherche
    deckSearch.addEventListener('input', function() {
        currentState.search = this.value.trim().toLowerCase();
        filterDecks();
    });
    
    searchButton.addEventListener('click', function() {
        currentState.search = deckSearch.value.trim().toLowerCase();
        filterDecks();
    });
    
    deckSearch.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            currentState.search = this.value.trim().toLowerCase();
            filterDecks();
        }
    });
    
    // Filtres
    subjectFilter.addEventListener('change', function() {
        currentState.subject = this.value;
        filterDecks();
    });
    
    levelFilter.addEventListener('change', function() {
        currentState.level = this.value;
        filterDecks();
    });
    
    dateFrom.addEventListener('change', function() {
        currentState.dateFrom = this.value;
        filterDecks();
    });
    
    dateTo.addEventListener('change', function() {
        currentState.dateTo = this.value;
        filterDecks();
    });
    
    progressFilter.addEventListener('change', function() {
        currentState.progress = this.value;
        filterDecks();
    });
    
    // Tris
    sortButtons.forEach(button => {
        button.addEventListener('click', function() {
            // Retirer la classe active de tous les boutons
            sortButtons.forEach(btn => btn.classList.remove('active'));
            
            // Ajouter la classe active au bouton cliqué
            this.classList.add('active');
            
            // Mettre à jour le tri courant
            currentState.sort = this.getAttribute('data-sort');
            
            // Appliquer le tri
            filterDecks();
        });
    });
    
    // Réinitialisation
    resetButton.addEventListener('click', resetAllFilters);
    
    // Initialisation
    filterDecks();
    
    // Mode sombre/clair
    const darkModeMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
    const isDarkMode = darkModeMediaQuery.matches;
    
    if (isDarkMode) {
        deckSearch.classList.add('dark');
        searchButton.classList.add('dark');
        subjectFilter.classList.add('dark');
        levelFilter.classList.add('dark');
        dateFrom.classList.add('dark');
        dateTo.classList.add('dark');
        progressFilter.classList.add('dark');
        sortButtons.forEach(button => button.classList.add('dark'));
        resetButton.classList.add('dark');
    }
});
</script>
{% endblock %}
