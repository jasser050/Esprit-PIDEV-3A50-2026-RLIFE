{% extends 'admin/base_admin.html.twig' %}

{% block title %}Revisions{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    @keyframes fadeIn { from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);} }
    .deck-card { animation: fadeIn 0.3s ease-out; }
    .sort-button.active {
        background-color: #4f46e5 !important;
        color: white !important;
        border-color: #4f46e5 !important;
    }
    .rating-admin-block { background: linear-gradient(135deg, #fffbeb, #fef3c7); border: 1px solid #fde68a; border-radius: 12px; padding: 10px 14px; margin-bottom: 12px; }
    .rating-admin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
    .rating-admin-title { font-size: 11px; font-weight: 700; color: #92400e; text-transform: uppercase; letter-spacing: 0.06em; }
    .rating-admin-link { font-size: 11px; color: #d97706; text-decoration: none; font-weight: 600; }
    .rating-admin-link:hover { color: #b45309; text-decoration: underline; }
    .rating-stars-visual { display: flex; align-items: center; gap: 6px; }
    .rating-stars-row { display: flex; gap: 2px; }
    .rstar { font-size: 18px; line-height: 1; }
    .rstar.filled { color: #f59e0b; }
    .rstar.half   { color: #f59e0b; opacity: 0.5; }
    .rstar.empty  { color: #d1d5db; }
    .rating-avg-text { font-size: 16px; font-weight: 800; color: #f59e0b; }
    .rating-count-text { font-size: 12px; color: #92400e; font-weight: 500; }
    .rating-empty-badge { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #92400e; padding: 4px 0; }
</style>
{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Revisions</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Study efficiently with flashcards and spaced repetition</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_admin_deck_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                New Deck
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-indigo-100 dark:bg-indigo-900/30 flex items-center justify-center">
                    <i data-lucide="layers" class="w-8 h-8 text-indigo-600 dark:text-indigo-400"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ decks|length }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Decks</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                    <i data-lucide="star" class="w-8 h-8 text-amber-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-amber-500" id="kpi-total-ratings">—</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Ratings</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-8 h-8 text-green-600"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-green-600" id="kpi-avg-global">—</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Global Average</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
                    <i data-lucide="trophy" class="w-8 h-8 text-purple-600"></i>
                </div>
                <div>
                    <p class="text-sm font-bold text-purple-600 leading-tight" id="kpi-best-deck">—</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Best Rated Deck</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search and Filters Section -->
    <div class="card overflow-hidden">
        <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="search" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                </div>
                <h2 class="font-semibold text-secondary-900 dark:text-white">Search Decks</h2>
            </div>
        </div>
        <div class="p-5 space-y-4">
            <!-- Search Input -->
            <div class="relative">
                <input type="text" id="deckSearch"
                       placeholder="Search decks by title, subject, level or description..."
                       class="w-full px-4 py-3 pl-12 border border-secondary-300 dark:border-secondary-700 rounded-xl bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                <i data-lucide="search" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-secondary-400"></i>
            </div>

            <!-- Filters Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Subject</label>
                    <select id="subjectFilter" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <option value="all">All Subjects</option>
                        {% set subjects = [] %}
                        {% for deck in decks %}{% if deck.matiere not in subjects %}{% set subjects = subjects|merge([deck.matiere]) %}{% endif %}{% endfor %}
                        {% for subject in subjects|sort %}<option value="{{ subject|lower }}">{{ subject }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Level</label>
                    <select id="levelFilter" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <option value="all">All Levels</option>
                        {% set levels = [] %}
                        {% for deck in decks %}{% if deck.niveau not in levels %}{% set levels = levels|merge([deck.niveau]) %}{% endif %}{% endfor %}
                        {% for level in levels|sort %}<option value="{{ level|lower }}">{{ level }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Date From</label>
                    <input type="date" id="dateFrom" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Date To</label>
                    <input type="date" id="dateTo" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
            </div>

            <!-- Sort + Reset -->
            <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-medium text-secondary-700 dark:text-secondary-300">Sort by:</span>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 hover:border-primary-500 hover:text-primary-600 transition-all active" data-sort="date-desc">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>Newest
                        </button>
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 hover:border-primary-500 hover:text-primary-600 transition-all" data-sort="date">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>Oldest
                        </button>
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 hover:border-primary-500 hover:text-primary-600 transition-all" data-sort="title">
                            <i data-lucide="arrow-up-a-z" class="w-4 h-4 inline mr-1"></i>A-Z
                        </button>
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 hover:border-primary-500 hover:text-primary-600 transition-all" data-sort="title-desc">
                            <i data-lucide="arrow-down-z-a" class="w-4 h-4 inline mr-1"></i>Z-A
                        </button>
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 hover:border-primary-500 hover:text-primary-600 transition-all" data-sort="rating-desc">
                            <i data-lucide="star" class="w-4 h-4 inline mr-1"></i>Best Rated
                        </button>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" id="resetFilters" class="btn btn-secondary">
                        <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                        Reset All
                    </button>
                </div>
            </div>

            <!-- Counter + Sort Indicator -->
            <div class="flex items-center justify-between pt-4 border-t border-secondary-200 dark:border-secondary-800">
                <div id="resultCounter" class="text-sm font-medium text-secondary-600 dark:text-secondary-400">
                    Showing {{ decks|length }} deck{% if decks|length != 1 %}s{% endif %}
                </div>
                <div id="sortIndicator" class="text-sm text-primary-600 dark:text-primary-400 flex items-center gap-1">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    Sorted by: Newest First
                </div>
            </div>
        </div>
    </div>

    <!-- Decks Grid -->
    <div id="decksContainer">
        {% if decks is empty %}
        <div class="card p-12 text-center">
            <i data-lucide="layers-2" class="w-20 h-20 mx-auto text-secondary-300 dark:text-secondary-600 mb-6"></i>
            <h3 class="text-2xl font-semibold text-secondary-900 dark:text-white mb-3">No decks yet</h3>
            <a href="{{ path('app_admin_deck_new') }}" class="btn btn-primary mx-auto">
                <i data-lucide="plus" class="w-6 h-6 mr-2"></i> Create your first Deck
            </a>
        </div>
        {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% set colorPalettes = [
                {bg:'#fef3c7',border:'#f59e0b',text:'#d97706'},
                {bg:'#dbeafe',border:'#3b82f6',text:'#2563eb'},
                {bg:'#fce7f3',border:'#ec4899',text:'#db2777'},
                {bg:'#d1fae5',border:'#10b981',text:'#059669'},
                {bg:'#e0e7ff',border:'#6366f1',text:'#4f46e5'},
                {bg:'#ffe4e6',border:'#f43f5e',text:'#e11d48'},
                {bg:'#f3e8ff',border:'#a855f7',text:'#9333ea'},
                {bg:'#ccfbf1',border:'#14b8a6',text:'#0d9488'},
                {bg:'#fef08a',border:'#eab308',text:'#ca8a04'},
                {bg:'#fbcfe8',border:'#ec4899',text:'#db2777'},
                {bg:'#bfdbfe',border:'#3b82f6',text:'#2563eb'},
                {bg:'#c7d2fe',border:'#818cf8',text:'#6366f1'}
            ] %}

            {% set demoStats = [
                {cards:15,mastered:6,progress:40},{cards:8,mastered:4,progress:50},
                {cards:12,mastered:9,progress:75},{cards:10,mastered:7,progress:70},
                {cards:20,mastered:15,progress:75},{cards:6,mastered:3,progress:50},
                {cards:14,mastered:10,progress:71},{cards:9,mastered:6,progress:67},
                {cards:11,mastered:8,progress:73},{cards:7,mastered:5,progress:71},
                {cards:13,mastered:9,progress:69},{cards:16,mastered:12,progress:75}
            ] %}

            {% for deck in decks %}
                {% set palette   = colorPalettes[loop.index0 % colorPalettes|length] %}
                {% set di        = loop.index0 % demoStats|length %}
                {% set deckCards = demoStats[di].cards %}
                {% set deckMast  = demoStats[di].mastered %}
                {% set deckProg  = demoStats[di].progress %}

                <div class="deck-card card hover:shadow-lg transition-all duration-300 group flex flex-col h-full"
                     style="border-top: 3px solid {{ palette.border }};"
                     data-title="{{ deck.titre|lower }}"
                     data-matiere="{{ deck.matiere|lower }}"
                     data-niveau="{{ deck.niveau|lower }}"
                     data-description="{{ deck.description|lower }}"
                     data-date="{{ deck.dateCreation ? deck.dateCreation|date('Y-m-d') : '' }}"
                     data-progress="{{ deckProg }}"
                     data-cards="{{ deckCards }}"
                     data-rating="0"
                     data-deck-id="{{ deck.id }}">

                    <!-- Image -->
                    <div class="h-32 overflow-hidden rounded-t-xl relative">
                        {% if deck.image %}
                            <img src="{{ asset('uploads/decks/' ~ deck.image) }}" alt="{{ deck.titre }}"
                                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center"
                                 style="background:linear-gradient(135deg,{{ palette.bg }},{{ palette.border }});">
                                <i data-lucide="layers" class="w-16 h-16 opacity-80" style="color:{{ palette.text }};"></i>
                            </div>
                        {% endif %}
                    </div>

                    <div class="p-5 flex-1 flex flex-col">
                        <div class="flex items-start justify-between mb-4">
                            <div class="w-12 h-12 rounded-xl bg-white dark:bg-secondary-800 shadow-md flex items-center justify-center -mt-8 border-2" style="border-color:{{ palette.border }};">
                                <i data-lucide="layers" class="w-6 h-6" style="color:{{ palette.text }};"></i>
                            </div>
                            <span class="text-xs text-secondary-500 font-medium">{{ deck.dateCreation ? deck.dateCreation|date('d/m/Y') : '—' }}</span>
                        </div>

                        <h3 class="text-xl font-bold mb-2 line-clamp-2" style="color:{{ palette.text }};">{{ deck.titre }}</h3>
                        <p class="text-sm text-secondary-600 dark:text-secondary-400 mb-3 flex items-center gap-1.5">
                            <i data-lucide="book-open" class="w-4 h-4"></i>
                            {{ deck.matiere }} • {{ deck.niveau }}
                        </p>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-4 line-clamp-2">{{ deck.description ?: 'No description available' }}</p>

                        <div class="flex gap-2 mb-4">
                            <span class="px-3 py-1.5 rounded-lg text-sm font-semibold shadow-sm"
                                  style="background-color:{{ palette.bg }};color:{{ palette.text }};border:1px solid {{ palette.border }};">
                                <i data-lucide="layers" class="w-3.5 h-3.5 inline mr-1"></i>{{ deckCards }} cards
                            </span>
                            <span class="px-3 py-1.5 rounded-lg text-sm font-semibold bg-green-100 text-green-700 border border-green-300 shadow-sm">
                                <i data-lucide="check-circle" class="w-3.5 h-3.5 inline mr-1"></i>{{ deckMast }} mastered
                            </span>
                        </div>

                        <div class="mb-4">
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-sm font-medium text-secondary-600 dark:text-secondary-400">Progress</span>
                                <span class="text-sm font-bold" style="color:{{ palette.text }};">{{ deckProg }}%</span>
                            </div>
                            <div class="w-full bg-secondary-200 dark:bg-secondary-700 rounded-full h-2.5 overflow-hidden">
                                <div class="h-full rounded-full transition-all duration-500"
                                     style="width:{{ deckProg }}%;background-color:{{ palette.text }};"></div>
                            </div>
                        </div>

                        <!-- Bloc notation -->
                        <div class="rating-admin-block" id="rating-block-{{ deck.id }}">
                            <div class="rating-admin-header">
                                <span class="rating-admin-title">⭐ Student ratings</span>
                                <a href="{{ path('app_admin_ratings_deck', {'deckId': deck.id}) }}" class="rating-admin-link">View details →</a>
                            </div>
                            <div id="rating-content-{{ deck.id }}">
                                <div class="rating-empty-badge" style="color:#d97706; font-size:12px;">⏳ Loading...</div>
                            </div>
                        </div>

                        <!-- Boutons admin -->
                        <div class="flex justify-end gap-2 mt-auto pt-2">
                            <a href="{{ path('app_admin_deck_show', {'id_deck': deck.id}) }}"
                               class="btn btn-secondary px-3 py-2" title="View deck">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </a>
                            <a href="{{ path('app_admin_deck_edit', {'id_deck': deck.id}) }}"
                               class="btn px-3 py-2"
                               style="background-color:{{ palette.bg }};color:{{ palette.text }};border:1px solid {{ palette.border }};"
                               title="Edit deck">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                            </a>
                            <form method="post" action="{{ path('app_admin_deck_delete', {'id_deck': deck.id}) }}"
                                  onsubmit="return confirm('Really delete this deck?');" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ deck.id) }}">
                                <button type="submit"
                                        class="btn px-3 py-2 bg-red-100 text-red-600 hover:bg-red-200 border border-red-200"
                                        title="Delete deck">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <!-- No Results Template -->
    <template id="noResultsTemplate">
        <div class="card p-12 text-center">
            <i data-lucide="search-x" class="w-20 h-20 mx-auto text-secondary-300 dark:text-secondary-600 mb-6"></i>
            <h3 class="text-2xl font-semibold text-secondary-900 dark:text-white mb-3">No results found</h3>
            <p class="text-secondary-600 dark:text-secondary-400 mb-6">Try adjusting your filters or search terms</p>
            <button type="button" id="clearSearch" class="btn btn-secondary mx-auto">
                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                Clear all filters
            </button>
        </div>
    </template>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function loadDeckRatingSimple(deckId) {
    fetch('/rating/deck/' + deckId + '/my-rating')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            renderRatingBlock(deckId, data.average || 0, data.total || 0);
            var card = document.querySelector('[data-deck-id="' + deckId + '"]');
            if (card) card.setAttribute('data-rating', data.average || 0);
        })
        .catch(function() { renderRatingError(deckId); });
}

function renderRatingBlock(deckId, average, total) {
    var container = document.getElementById('rating-content-' + deckId);
    if (!container) return;
    if (total === 0 || !average) {
        container.innerHTML = '<div class="rating-empty-badge"><span style="font-size:16px;">📭</span><span>No student ratings yet</span></div>';
        return;
    }
    var starsHtml = '';
    for (var i = 1; i <= 5; i++) {
        if (i <= Math.floor(average)) starsHtml += '<span class="rstar filled">★</span>';
        else if (i - 0.5 <= average) starsHtml += '<span class="rstar half">★</span>';
        else starsHtml += '<span class="rstar empty">★</span>';
    }
    container.innerHTML =
        '<div class="rating-stars-visual">' +
        '<div class="rating-stars-row">' + starsHtml + '</div>' +
        '<span class="rating-avg-text">' + parseFloat(average).toFixed(1) + '</span>' +
        '<span class="rating-count-text">(' + total + ' rating' + (total > 1 ? 's' : '') + ')</span>' +
        '</div>';
}

function renderRatingError(deckId) {
    var container = document.getElementById('rating-content-' + deckId);
    if (container) container.innerHTML = '<div class="rating-empty-badge" style="color:#ef4444;">⚠️ Unable to load</div>';
}

function loadGlobalStats() {
    fetch('/admin/ratings/api/chart-data')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var totRatings = 0, sumAvg = 0, bestLabel = '—', bestAvg = 0;
            if (data.totals)  data.totals.forEach(function(t) { totRatings += t; });
            if (data.averages && data.labels) {
                data.averages.forEach(function(a, i) {
                    if (a > bestAvg) { bestAvg = a; bestLabel = data.labels[i]; }
                    sumAvg += a * (data.totals[i] || 0);
                });
            }
            var globalAvg = totRatings > 0 ? (sumAvg / totRatings).toFixed(1) : '—';
            var kpiR = document.getElementById('kpi-total-ratings');
            var kpiA = document.getElementById('kpi-avg-global');
            var kpiB = document.getElementById('kpi-best-deck');
            if (kpiR) kpiR.textContent = totRatings || '0';
            if (kpiA) kpiA.textContent = globalAvg !== '—' ? globalAvg + '★' : '—';
            if (kpiB) kpiB.textContent = bestLabel !== '—' ? bestLabel + ' (' + parseFloat(bestAvg).toFixed(1) + '★)' : '—';
        })
        .catch(function() {});
}

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-deck-id]').forEach(function(card) {
        var id = card.getAttribute('data-deck-id');
        if (id) loadDeckRatingSimple(id);
    });
    loadGlobalStats();

    var DS    = document.getElementById('deckSearch'),
        SF    = document.getElementById('subjectFilter'),
        LF    = document.getElementById('levelFilter'),
        DF    = document.getElementById('dateFrom'),
        DT    = document.getElementById('dateTo'),
        SORTS = document.querySelectorAll('.sort-button'),
        RESET = document.getElementById('resetFilters'),
        CARDS = document.querySelectorAll('.deck-card'),
        CONT  = document.getElementById('decksContainer'),
        RC    = document.getElementById('resultCounter'),
        SI    = document.getElementById('sortIndicator'),
        NRT   = document.getElementById('noResultsTemplate');

    var state = { search:'', subject:'all', level:'all', dateFrom:'', dateTo:'', sort:'date-desc' };
    var slabels = { 'date-desc':'Newest First', 'date':'Oldest First', 'title':'Title A-Z', 'title-desc':'Title Z-A', 'rating-desc':'Best Rated' };

    function filter() {
        var vc = 0, vd = [];
        CARDS.forEach(function(c) {
            var t  = c.getAttribute('data-title')       || '',
                m  = c.getAttribute('data-matiere')     || '',
                n  = c.getAttribute('data-niveau')      || '',
                de = c.getAttribute('data-description') || '',
                dt = c.getAttribute('data-date')        || '',
                pr = parseInt(c.getAttribute('data-progress')) || 0,
                ca = parseInt(c.getAttribute('data-cards'))    || 0,
                rt = parseFloat(c.getAttribute('data-rating')) || 0;

            var ok = (state.search === '' || t.includes(state.search) || m.includes(state.search) || n.includes(state.search) || de.includes(state.search))
                && (state.subject === 'all' || m === state.subject)
                && (state.level   === 'all' || n === state.level);
            if (state.dateFrom && dt && new Date(dt) < new Date(state.dateFrom)) ok = false;
            if (state.dateTo   && dt && new Date(dt) > new Date(state.dateTo))   ok = false;

            if (ok) { c.style.display = 'flex'; vc++; vd.push({element:c, title:t, date:dt, progress:pr, cards:ca, rating:rt}); }
            else    { c.style.display = 'none'; }
        });

        vd.sort(function(a, b) {
            switch (state.sort) {
                case 'date-desc':   return new Date(b.date) - new Date(a.date);
                case 'date':        return new Date(a.date) - new Date(b.date);
                case 'title':       return a.title.localeCompare(b.title);
                case 'title-desc':  return b.title.localeCompare(a.title);
                case 'rating-desc': return b.rating - a.rating;
                default: return 0;
            }
        });

        var g = CONT.querySelector('.grid');
        if (g) vd.forEach(function(d) { g.appendChild(d.element); });

        RC.textContent = 'Showing ' + vc + ' deck' + (vc !== 1 ? 's' : '');
        SI.innerHTML = '<i data-lucide="calendar" class="w-4 h-4 inline"></i> Sorted by: ' + (slabels[state.sort] || '');
        lucide.createIcons();

        if (!g) return;
        if (vc === 0) {
            g.style.display = 'none';
            var ex = CONT.querySelector('.no-results-msg'); if (ex) ex.remove();
            var clone = NRT.content.cloneNode(true);
            clone.firstElementChild && clone.firstElementChild.classList.add('no-results-msg');
            CONT.appendChild(clone);
            setTimeout(function() {
                var cb = CONT.querySelector('#clearSearch');
                if (cb) cb.addEventListener('click', resetAll);
                lucide.createIcons();
            }, 50);
        } else {
            g.style.display = 'grid';
            var nr = CONT.querySelector('.no-results-msg'); if (nr) nr.remove();
        }
    }

    function resetAll() {
        DS.value = ''; SF.value = 'all'; LF.value = 'all'; DF.value = ''; DT.value = '';
        SORTS.forEach(function(b) { b.classList.remove('active'); });
        var def = document.querySelector('.sort-button[data-sort="date-desc"]');
        if (def) def.classList.add('active');
        state = { search:'', subject:'all', level:'all', dateFrom:'', dateTo:'', sort:'date-desc' };
        filter();
    }

    DS.addEventListener('input',    function() { state.search   = this.value.trim().toLowerCase(); filter(); });
    DS.addEventListener('keypress', function(e) { if (e.key === 'Enter') { state.search = this.value.trim().toLowerCase(); filter(); } });
    SF.addEventListener('change',   function() { state.subject  = this.value; filter(); });
    LF.addEventListener('change',   function() { state.level    = this.value; filter(); });
    DF.addEventListener('change',   function() { state.dateFrom = this.value; filter(); });
    DT.addEventListener('change',   function() { state.dateTo   = this.value; filter(); });
    SORTS.forEach(function(b) {
        b.addEventListener('click', function() {
            SORTS.forEach(function(x) { x.classList.remove('active'); });
            b.classList.add('active');
            state.sort = b.getAttribute('data-sort');
            filter();
        });
    });
    RESET.addEventListener('click', resetAll);
    filter();
    lucide.createIcons();
});
</script>
{% endblock %}
