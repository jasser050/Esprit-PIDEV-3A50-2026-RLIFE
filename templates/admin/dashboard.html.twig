{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('galaxy-admin') }}
{% endblock %}

{% block body %}
<!-- Animated Gradient Background Pattern -->
<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full opacity-20 animate-pulse" style="background: radial-gradient(circle, #06b6d4 0%, transparent 70%); animation-duration: 4s;"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 rounded-full opacity-20 animate-pulse" style="background: radial-gradient(circle, #a855f7 0%, transparent 70%); animation-duration: 5s; animation-delay: 1s;"></div>
    <div class="absolute top-1/2 left-1/2 w-96 h-96 rounded-full opacity-15 animate-pulse" style="background: radial-gradient(circle, #10b981 0%, transparent 70%); animation-duration: 6s; animation-delay: 2s;"></div>
</div>

<!-- Page Header with Gradient Text -->
<div class="mb-8 relative">
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-3xl sm:text-4xl font-black mb-2" style="background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #a855f7 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                Welcome Back, Admin
            </h1>
            <p class="text-slate-600 dark:text-slate-400 flex items-center gap-2">
                <i data-lucide="activity" class="w-4 h-4"></i>
                <span>Monitor and manage your RLIFE platform in real-time</span>
            </p>
        </div>
        <div class="flex items-center gap-3">
            <div class="px-4 py-2 rounded-xl text-sm font-semibold text-white" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);">
                <i data-lucide="check-circle" class="w-4 h-4 inline mr-1"></i>
                System Online
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards with Enhanced Animations -->
<div class="grid grid-cols-1 gap-4 sm:gap-6 mb-8 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Registered Users - Ocean Blue & Cyan Gradient -->
    <div class="relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:-translate-y-2 hover:scale-105 group cursor-pointer" style="background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #4f46e5 100%); box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.3);">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);">
                <i data-lucide="users" class="w-8 h-8 text-white drop-shadow-lg"></i>
            </div>
            <div class="flex flex-col items-end gap-1">
                <span class="px-3 py-1 text-xs font-bold text-white rounded-lg" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px);">Total</span>
                <span class="text-xs text-white/70 font-medium">+12% this month</span>
            </div>
        </div>
        <div>
            <p class="text-5xl font-black text-white mb-2 tracking-tight">{{ total_users }}</p>
            <p class="text-sm font-semibold flex items-center gap-1" style="color: rgba(255, 255, 255, 0.9);">
                <i data-lucide="trending-up" class="w-4 h-4"></i>
                Registered Users
            </p>
        </div>
        <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full" style="background: rgba(255, 255, 255, 0.15); filter: blur(60px);"></div>
        <div class="absolute bottom-0 left-0 right-0 h-1 group-hover:h-2 transition-all duration-300" style="background: rgba(255, 255, 255, 0.3);"></div>
    </div>

    <!-- Active Accounts - Emerald Green Gradient -->
    <div class="relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:-translate-y-2 hover:scale-105 group cursor-pointer" style="background: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%); box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.3);">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);">
                <i data-lucide="user-check" class="w-8 h-8 text-white drop-shadow-lg"></i>
            </div>
            <div class="flex flex-col items-end gap-1">
                <span class="px-3 py-1 text-xs font-bold text-white rounded-lg" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px);">Active</span>
                <span class="text-xs text-white/70 font-medium">98% active rate</span>
            </div>
        </div>
        <div>
            <p class="text-5xl font-black text-white mb-2 tracking-tight">{{ active_users }}</p>
            <p class="text-sm font-semibold flex items-center gap-1" style="color: rgba(255, 255, 255, 0.9);">
                <i data-lucide="zap" class="w-4 h-4"></i>
                Active Accounts
            </p>
        </div>
        <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full" style="background: rgba(255, 255, 255, 0.15); filter: blur(60px);"></div>
        <div class="absolute bottom-0 left-0 right-0 h-1 group-hover:h-2 transition-all duration-300" style="background: rgba(255, 255, 255, 0.3);"></div>
    </div>

    <!-- Restricted Accounts - Red & Pink Gradient -->
    <div class="relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:-translate-y-2 hover:scale-105 group cursor-pointer" style="background: linear-gradient(135deg, #f43f5e 0%, #ef4444 50%, #ec4899 100%); box-shadow: 0 10px 25px -5px rgba(239, 68, 68, 0.3);">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);">
                <i data-lucide="user-x" class="w-8 h-8 text-white drop-shadow-lg"></i>
            </div>
            <div class="flex flex-col items-end gap-1">
                <span class="px-3 py-1 text-xs font-bold text-white rounded-lg" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px);">Banned</span>
                <span class="text-xs text-white/70 font-medium">Needs review</span>
            </div>
        </div>
        <div>
            <p class="text-5xl font-black text-white mb-2 tracking-tight">{{ banned_users }}</p>
            <p class="text-sm font-semibold flex items-center gap-1" style="color: rgba(255, 255, 255, 0.9);">
                <i data-lucide="shield-alert" class="w-4 h-4"></i>
                Restricted Accounts
            </p>
        </div>
        <div class="absolute -top-10 -left-10 w-40 h-40 rounded-full" style="background: rgba(255, 255, 255, 0.15); filter: blur(60px);"></div>
        <div class="absolute bottom-0 left-0 right-0 h-1 group-hover:h-2 transition-all duration-300" style="background: rgba(255, 255, 255, 0.3);"></div>
    </div>

    <!-- Administrators - Purple & Gold Gradient -->
    <div class="relative overflow-hidden rounded-2xl p-6 transition-all duration-300 hover:-translate-y-2 hover:scale-105 group cursor-pointer" style="background: linear-gradient(135deg, #fbbf24 0%, #a855f7 50%, #7c3aed 100%); box-shadow: 0 10px 25px -5px rgba(168, 85, 247, 0.3);">
        <div class="flex items-center justify-between mb-4">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);">
                <i data-lucide="crown" class="w-8 h-8 text-white drop-shadow-lg"></i>
            </div>
            <div class="flex flex-col items-end gap-1">
                <span class="px-3 py-1 text-xs font-bold text-white rounded-lg" style="background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px);">Admins</span>
                <span class="text-xs text-white/70 font-medium">Full access</span>
            </div>
        </div>
        <div>
            <p class="text-5xl font-black text-white mb-2 tracking-tight">{{ admin_users }}</p>
            <p class="text-sm font-semibold flex items-center gap-1" style="color: rgba(255, 255, 255, 0.9);">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
                Administrators
            </p>
        </div>
        <div class="absolute -bottom-10 -right-10 w-40 h-40 rounded-full" style="background: rgba(255, 255, 255, 0.15); filter: blur(60px);"></div>
        <div class="absolute bottom-0 left-0 right-0 h-1 group-hover:h-2 transition-all duration-300" style="background: rgba(255, 255, 255, 0.3);"></div>
    </div>
</div>

<!-- Quick Actions Panel -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2">
        <!-- Quick Stats Mini Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
            <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border-2 border-blue-100 dark:border-blue-900/30 hover:border-blue-300 dark:hover:border-blue-700 transition-colors">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                        <i data-lucide="book-open" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">{{ total_courses ?? 0 }}</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Total Courses</p>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border-2 border-purple-100 dark:border-purple-900/30 hover:border-purple-300 dark:hover:border-purple-700 transition-colors">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #a855f7, #7c3aed);">
                        <i data-lucide="folder" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">156</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Projects</p>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-slate-900 rounded-xl p-4 border-2 border-green-100 dark:border-green-900/30 hover:border-green-300 dark:hover:border-green-700 transition-colors">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i data-lucide="layers" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-slate-900 dark:text-white">89</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Flashcards</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Status Card -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200 dark:border-slate-800">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
            <i data-lucide="activity" class="w-5 h-5 text-blue-500"></i>
            System Status
        </h3>
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <span class="text-sm text-slate-600 dark:text-slate-400">Database</span>
                <span class="px-2 py-1 text-xs font-semibold text-green-700 dark:text-green-400 bg-green-100 dark:bg-green-900/30 rounded-lg">Online</span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-sm text-slate-600 dark:text-slate-400">API Server</span>
                <span class="px-2 py-1 text-xs font-semibold text-green-700 dark:text-green-400 bg-green-100 dark:bg-green-900/30 rounded-lg">Healthy</span>
            </div>
            <div class="flex items-center justify-between">
                <span class="text-sm text-slate-600 dark:text-slate-400">Email Service</span>
                <span class="px-2 py-1 text-xs font-semibold text-green-700 dark:text-green-400 bg-green-100 dark:bg-green-900/30 rounded-lg">Active</span>
            </div>
            <div class="mt-4 pt-4 border-t border-slate-200 dark:border-slate-800">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-500 dark:text-slate-400">Uptime</span>
                    <span class="font-semibold text-slate-900 dark:text-white">99.9%</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Users Table with Enhanced Design -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border-2 border-slate-200 dark:border-slate-800 overflow-hidden hover:border-blue-300 dark:hover:border-blue-700 transition-colors">
    <div class="p-6 border-b-2 border-slate-200 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.05), rgba(168, 85, 247, 0.05));">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                        <i data-lucide="users" class="w-4 h-4 text-white"></i>
                    </div>
                    Recent Users
                </h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Latest registered accounts on your platform</p>
            </div>
            <a href="{{ path('app_admin_users') }}" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white rounded-xl transition-all hover:scale-105 hover:shadow-lg" style="background: linear-gradient(135deg, #06b6d4, #3b82f6); box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);">
                <span>View All Users</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="border-b-2 border-slate-200 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.03), rgba(168, 85, 247, 0.03));">
                <tr>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">User</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Email</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider hidden lg:table-cell">University</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider hidden sm:table-cell">Joined</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                {% for user in recent_users %}
                <tr class="hover:bg-gradient-to-r hover:from-blue-50/50 hover:to-purple-50/50 dark:hover:from-blue-900/10 dark:hover:to-purple-900/10 transition-all duration-200">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <div class="relative">
                                <div class="w-12 h-12 rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-md" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                                    {{ user.firstName|first ~ user.lastName|first }}
                                </div>
                                <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white dark:border-slate-900"></div>
                            </div>
                            <div>
                                <p class="font-semibold text-slate-900 dark:text-white">{{ user.fullName }}</p>
                                {% if user.isAdmin() %}
                                <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 text-2xs font-bold text-white rounded-md" style="background: linear-gradient(135deg, #fbbf24, #a855f7);">
                                    <i data-lucide="shield" class="w-3 h-3"></i>
                                    Admin
                                </span>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-2">
                            <i data-lucide="mail" class="w-4 h-4 text-slate-400"></i>
                            <p class="text-sm font-medium text-slate-600 dark:text-slate-400">{{ user.email }}</p>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap hidden lg:table-cell">
                        <div class="flex items-center gap-2">
                            <i data-lucide="graduation-cap" class="w-4 h-4 text-slate-400"></i>
                            <p class="text-sm text-slate-600 dark:text-slate-400">{{ user.university ?? 'Not specified' }}</p>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {% if user.isBanned %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white rounded-lg shadow-sm" style="background: linear-gradient(135deg, #f43f5e, #ef4444);">
                            <i data-lucide="ban" class="w-3.5 h-3.5"></i>
                            Banned
                        </span>
                        {% else %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white rounded-lg shadow-sm" style="background: linear-gradient(135deg, #10b981, #059669);">
                            <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                            Active
                        </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap hidden sm:table-cell">
                        <div class="flex items-center gap-2">
                            <i data-lucide="calendar" class="w-4 h-4 text-slate-400"></i>
                            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">{{ user.createdAt|date('M d, Y') }}</p>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-16 text-center">
                        <div class="flex flex-col items-center gap-4">
                            <div class="w-16 h-16 rounded-2xl flex items-center justify-center" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1), rgba(168, 85, 247, 0.1));">
                                <i data-lucide="users" class="w-8 h-8 text-slate-400"></i>
                            </div>
                            <div>
                                <p class="text-base font-semibold text-slate-700 dark:text-slate-300">No users found</p>
                                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">New users will appear here</p>
                            </div>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <!-- Bloc Projets - Aperçu rapide -->
<div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mt-6">
    <div class="flex items-center justify-between mb-5">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
            <i data-lucide="folder-git" class="w-5 h-5 text-indigo-500"></i>
            Projets (tous utilisateurs)
        </h3>
        <a href="{{ path('admin_projects_index') }}" 
           class="text-sm text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300 flex items-center gap-1">
            Voir tous →
        </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="text-center">
            <div class="text-2xl font-bold text-indigo-600">{{ projectStats.total ?? 0 }}</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Total</div>
        </div>
        <div class="text-center">
            <div class="text-2xl font-bold text-green-600">{{ projectStats.termines ?? 0 }}</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">Terminés</div>
        </div>
        <div class="text-center">
            <div class="text-2xl font-bold text-blue-600">{{ projectStats.enCours ?? 0 }}</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">En cours</div>
        </div>
        <div class="text-center">
            <div class="text-2xl font-bold text-amber-600">{{ projectStats.enAttente ?? 0 }}</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">En attente</div>
        </div>
    </div>

    {% if recentProjects|length > 0 %}
    <div class="space-y-3">
        {% for project in recentProjects %}
        <div class="flex items-center justify-between py-2 border-t dark:border-gray-700 first:border-t-0">
            <div class="min-w-0">
                <div class="font-medium text-gray-900 dark:text-white truncate max-w-md">
                    {{ project.titre }}
                </div>
                <div class="text-xs text-gray-500 dark:text-gray-400">
                    {{ project.user.firstName|default(project.user.email) }} • {{ project.createdAt|date('d M Y') }}
                </div>
            </div>
            <span class="inline-flex px-2.5 py-1 text-xs font-medium rounded-full
                {% if project.statut == 'Terminé' %}bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300
                {% elseif project.statut == 'En cours' %}bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300
                {% else %}bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300{% endif %}">
                {{ project.statut }}
            </span>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <p class="text-center text-gray-500 dark:text-gray-400 py-6">
        Aucun projet créé pour le moment
    </p>
    {% endif %}
</div>
</div>

<!-- Footer Stats Bar -->
<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-xl p-4 border border-blue-200 dark:border-blue-800">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-1">Today's Registrations</p>
                <p class="text-2xl font-black text-slate-900 dark:text-white">12</p>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                <i data-lucide="user-plus" class="w-6 h-6 text-white"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-xl p-4 border border-purple-200 dark:border-purple-800">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-1">Active Sessions</p>
                <p class="text-2xl font-black text-slate-900 dark:text-white">48</p>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #a855f7, #ec4899);">
                <i data-lucide="activity" class="w-6 h-6 text-white"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-xl p-4 border border-green-200 dark:border-green-800">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-1">Response Time</p>
                <p class="text-2xl font-black text-slate-900 dark:text-white">142ms</p>
            </div>
            <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #10b981, #059669);">
                <i data-lucide="zap" class="w-6 h-6 text-white"></i>
            </div>
        </div>
    </div>
</div>

