    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-700/40">
        <div class="flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center"
                 style="background: rgba(139,92,246,0.2); border: 1px solid rgba(139,92,246,0.4);">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="#a78bfa" stroke-width="1.8">
                    <circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
            </div>
            <div>
                <h2 class="text-lg font-bold text-white">User Galaxy</h2>
                <p class="text-xs text-slate-400">
                    <span id="admin-galaxy-user-count" class="text-violet-400 font-semibold">…</span>
                    stars in your universe — drag to orbit, click a star to inspect
                </p>
            </div>
        </div>
        <!-- Legend -->
        <div class="hidden sm:flex items-center gap-4 text-xs text-slate-400">
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#ffd700;box-shadow:0 0 6px #ffd700;"></span>Admin</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#a5f3fc;box-shadow:0 0 5px #a5f3fc;"></span>Active</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#60a5fa;"></span>New</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#ff3333;box-shadow:0 0 5px #ff3333;"></span>Banned</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#475569;"></span>Inactive</span>
        </div>
    </div>

    <!-- Galaxy canvas -->
    <div id="admin-galaxy-container" style="width: 100%; height: 520px; cursor: grab;"
         onmousedown="this.style.cursor='grabbing'" onmouseup="this.style.cursor='grab'">
    </div>
</div>

<!-- Floating AI Terminal Button -->
<button id="ai-terminal-btn" 
        class="fixed bottom-6 right-6 w-16 h-16 rounded-full shadow-2xl flex items-center justify-center transition-all hover:scale-110 z-40"
        style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <i data-lucide="brain-circuit" class="w-7 h-7 text-white"></i>
</button>

<!-- AI Terminal Modal -->
<div id="ai-terminal-modal" class="fixed inset-0 z-50 hidden" style="display: none;">
    <!-- Backdrop -->
    <div class="absolute inset-0" style="background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px);" id="ai-modal-backdrop"></div>
    
    <!-- Modal Content -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[90vw] h-[85vh] max-w-5xl rounded-2xl shadow-2xl overflow-hidden" 
         style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1);">
        
        <!-- Header -->
        <div class="p-4 border-b" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-color: rgba(255, 255, 255, 0.1);">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center">
                        <i data-lucide="brain-circuit" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white">AI Terminal</h2>
                        <p class="text-xs text-white/70">Powered by Gemini 2.0 Flash</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button id="clear-history-btn" 
                            class="px-3 py-2 bg-white/10 hover:bg-white/20 rounded-lg text-sm font-medium transition-all text-white">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                    <button id="close-modal-btn" 
                            class="px-3 py-2 bg-white/10 hover:bg-white/20 rounded-lg transition-all text-white">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Messages Container -->
        <div id="terminal-messages" class="p-4 overflow-y-auto" style="height: calc(85vh - 180px); background: #0f172a;">
            <!-- Welcome Message -->
            <div class="mb-4">
                <div class="inline-block max-w-[80%] p-4 rounded-lg" style="background: rgba(102, 126, 234, 0.1); border: 1px solid rgba(102, 126, 234, 0.3);">
                    <div class="flex items-center gap-2 mb-2">
                        <i data-lucide="sparkles" class="w-4 h-4 text-violet-400"></i>
                        <span class="font-semibold text-violet-400">AI Assistant</span>
                    </div>
                    <p class="text-white text-sm">Welcome! I can help you manage users with natural language commands.</p>
                    <p class="mt-2 text-xs text-slate-400">Try: "Add student John with email john@test.com" or "Show user 5"</p>
                </div>
            </div>
        </div>

        <!-- Input Container -->
        <div class="p-4 border-t" style="background: #1e293b; border-color: rgba(255, 255, 255, 0.1);">
            <form id="terminal-form" class="flex gap-3">
                <input type="text" 
                       id="message-input" 
                       placeholder="Type your command here..."
                       autocomplete="off"
                       required
                       class="flex-1 px-4 py-3 rounded-lg text-white text-sm"
                       style="background: rgba(255, 255, 255, 0.08); border: 2px solid rgba(102, 126, 234, 0.3);">
                <button type="submit" 
                        id="send-button" 
                        class="px-6 py-3 rounded-lg font-semibold text-white transition-all hover:opacity-90"
                        style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i data-lucide="send" class="w-5 h-5"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    /* Modal Animation */
    #ai-terminal-modal:not(.hidden) {
        animation: fadeIn 0.2s ease-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Message Styles */
    .message {
        margin-bottom: 1rem;
        animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .message-user {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 1rem;
    }

    .message-assistant {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 1rem;
    }

    .message-bubble {
        max-width: 80%;
        padding: 1rem;
        border-radius: 0.75rem;
        font-size: 0.875rem;
    }

    .message-user .message-bubble {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .message-assistant .message-bubble {
        background: rgba(102, 126, 234, 0.1);
        border: 1px solid rgba(102, 126, 234, 0.3);
        color: #e2e8f0;
    }

    .message-bubble.success {
        border-left: 3px solid #10b981 !important;
    }

    .message-bubble.error {
        border-left: 3px solid #ef4444 !important;
    }

    /* User Result Card */
    .user-result {
        margin-top: 0.75rem;
        padding: 0.75rem;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.3);
        border-radius: 0.5rem;
    }

    .user-card {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 0.5rem;
        margin-top: 0.5rem;
    }

    .user-avatar {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.875rem;
    }

    /* Typing Indicator */
    .typing-indicator {
        display: flex;
        gap: 0.25rem;
        padding: 1rem;
    }

    .typing-dot {
        width: 0.5rem;
        height: 0.5rem;
        background: rgba(102, 126, 234, 0.8);
        border-radius: 50%;
        animation: typingBounce 1.4s infinite;
    }

    .typing-dot:nth-child(2) {
        animation-delay: 0.2s;
    }

    .typing-dot:nth-child(3) {
        animation-delay: 0.4s;
    }

    @keyframes typingBounce {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-8px); }
    }

    /* Input Focus */
    #message-input:focus {
        outline: none;
        border-color: #667eea !important;
        background: rgba(255, 255, 255, 0.12) !important;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2) !important;
    }

    /* Floating Button Pulse */
    #ai-terminal-btn {
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.7); }
        50% { box-shadow: 0 0 0 10px rgba(102, 126, 234, 0); }
    }
</style>

<script>
    // Modal controls
    const aiTerminalBtn = document.getElementById('ai-terminal-btn');
    const aiTerminalModal = document.getElementById('ai-terminal-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const aiModalBackdrop = document.getElementById('ai-modal-backdrop');

    // Open modal
    aiTerminalBtn.addEventListener('click', () => {
        aiTerminalModal.classList.remove('hidden');
        aiTerminalModal.style.display = 'block';
        setTimeout(() => {
            document.getElementById('message-input').focus();
            lucide.createIcons();
        }, 100);
    });

    // Close modal
    function closeModal() {
        aiTerminalModal.classList.add('hidden');
        aiTerminalModal.style.display = 'none';
    }

    closeModalBtn.addEventListener('click', closeModal);
    aiModalBackdrop.addEventListener('click', closeModal);

    // Escape key to close
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !aiTerminalModal.classList.contains('hidden')) {
            closeModal();
        }
    });

    // AI Terminal functionality
    const messagesContainer = document.getElementById('terminal-messages');
    const terminalForm = document.getElementById('terminal-form');
    const messageInput = document.getElementById('message-input');
    const sendButton = document.getElementById('send-button');
    const clearHistoryBtn = document.getElementById('clear-history-btn');

    // Load chat history on page load
    loadHistory();

    // Handle form submission
    terminalForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const message = messageInput.value.trim();
        if (!message) return;

        // Add user message to UI
        addMessage('user', message);
        messageInput.value = '';

        // Show typing indicator
        const typingId = showTypingIndicator();

        // Disable input while processing
        setInputState(false);

        try {
            const response = await fetch('{{ path('app_admin_ai_terminal_chat') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ message })
            });

            const data = await response.json();

            // Remove typing indicator
            removeTypingIndicator(typingId);

            // Add AI response
            addMessage('assistant', data.message, data.success ? 'success' : 'error', data.result);

        } catch (error) {
            removeTypingIndicator(typingId);
            addMessage('assistant', 'Error: Unable to connect to AI service. Please try again.', 'error');
        } finally {
            setInputState(true);
            messageInput.focus();
        }
    });

    // Clear history
    clearHistoryBtn.addEventListener('click', async () => {
        if (!confirm('Are you sure you want to clear the chat history?')) return;

        try {
            await fetch('{{ path('app_admin_ai_terminal_clear') }}', { method: 'POST' });
            
            // Clear messages except welcome message
            const messages = messagesContainer.querySelectorAll('.message');
            messages.forEach((msg, index) => {
                if (index > 0) msg.remove();
            });

        } catch (error) {
            alert('Error clearing history');
        }
    });

    // Load chat history
    async function loadHistory() {
        try {
            const response = await fetch('{{ path('app_admin_ai_terminal_history') }}');
            const data = await response.json();

            if (data.messages && data.messages.length > 0) {
                data.messages.forEach(msg => {
                    if (msg.role !== 'system') {
                        addMessage(msg.role, msg.content, null, null, false);
                    }
                });
            }
        } catch (error) {
            console.error('Error loading history:', error);
        }
    }

    // Add message to chat
    function addMessage(role, content, status = null, result = null, scroll = true) {
        const messageDiv = document.createElement('div');
        messageDiv.className = `message-${role}`;

        const bubbleDiv = document.createElement('div');
        bubbleDiv.className = `message-bubble ${status || ''}`;

        if (role === 'assistant') {
            const header = document.createElement('div');
            header.className = 'flex items-center gap-2 mb-2';
            header.innerHTML = `
                <i data-lucide="sparkles" class="w-4 h-4 text-violet-400"></i>
                <span class="font-semibold text-violet-400">AI Assistant</span>
            `;
            bubbleDiv.appendChild(header);
        }

        const contentP = document.createElement('p');
        contentP.textContent = content;
        contentP.className = 'text-sm';
        bubbleDiv.appendChild(contentP);

        // Add result display if present
        if (result) {
            const resultDiv = document.createElement('div');
            resultDiv.className = 'user-result';

            if (Array.isArray(result)) {
                result.forEach(user => {
                    const userCard = createUserCard(user);
                    resultDiv.appendChild(userCard);
                });
            } else {
                const userCard = createUserCard(result);
                resultDiv.appendChild(userCard);
            }

            bubbleDiv.appendChild(resultDiv);
        }

        messageDiv.appendChild(bubbleDiv);
        messagesContainer.appendChild(messageDiv);

        // Re-initialize Lucide icons
        lucide.createIcons();

        if (scroll) {
            scrollToBottom();
        }
    }

    // Create user card
    function createUserCard(user) {
        const card = document.createElement('div');
        card.className = 'user-card';
        
        const initials = (user.firstName?.[0] || '') + (user.lastName?.[0] || '');
        
        card.innerHTML = `
            <div class="user-avatar">${initials}</div>
            <div class="flex-1">
                <div class="font-semibold text-white text-sm">${user.fullName || 'N/A'}</div>
                <div class="text-xs text-slate-400">${user.email || 'No email'}</div>
                ${user.university ? `<div class="text-xs text-slate-500">${user.university}</div>` : ''}
            </div>
            <div class="text-xs text-slate-400 font-mono">ID: ${user.id}</div>
        `;
        
        return card;
    }

    // Show typing indicator
    function showTypingIndicator() {
        const id = 'typing-' + Date.now();
        const messageDiv = document.createElement('div');
        messageDiv.id = id;
        messageDiv.className = 'message-assistant';
        messageDiv.innerHTML = `
            <div class="message-bubble">
                <div class="typing-indicator">
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                </div>
            </div>
        `;
        messagesContainer.appendChild(messageDiv);
        scrollToBottom();
        return id;
    }

    // Remove typing indicator
    function removeTypingIndicator(id) {
        const indicator = document.getElementById(id);
        if (indicator) indicator.remove();
    }

    // Set input state
    function setInputState(enabled) {
        messageInput.disabled = !enabled;
        sendButton.disabled = !enabled;
    }

    // Scroll to bottom
    function scrollToBottom() {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
</script>
{% endblock %}
