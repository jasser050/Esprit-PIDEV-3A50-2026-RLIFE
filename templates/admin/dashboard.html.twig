{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}

{% block javascripts %}
{{ parent() }}
{{ encore_entry_script_tags('galaxy-admin') }}
{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Admin Dashboard</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">Monitor and manage your RLIFE platform</p>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-1 gap-4 sm:gap-6 mb-6 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Total Users -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 hover:shadow-card-hover transition-shadow">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-primary-50 dark:bg-primary-900/20 flex items-center justify-center">
                <i data-lucide="users" class="w-6 h-6 text-primary-600 dark:text-primary-400"></i>
            </div>
            <span class="px-2.5 py-1 text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-lg">Total</span>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ total_users }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Registered users</p>
        </div>
    </div>

    <!-- Active Users -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 hover:shadow-card-hover transition-shadow">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-success-50 dark:bg-success-900/20 flex items-center justify-center">
                <i data-lucide="user-check" class="w-6 h-6 text-success-600 dark:text-success-400"></i>
            </div>
            <span class="px-2.5 py-1 text-xs font-semibold bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-400 rounded-lg">Active</span>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ active_users }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Active accounts</p>
        </div>
    </div>

    <!-- Banned Users -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 hover:shadow-card-hover transition-shadow">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-danger-50 dark:bg-danger-900/20 flex items-center justify-center">
                <i data-lucide="user-x" class="w-6 h-6 text-danger-600 dark:text-danger-400"></i>
            </div>
            <span class="px-2.5 py-1 text-xs font-semibold bg-danger-100 dark:bg-danger-900/30 text-danger-700 dark:text-danger-400 rounded-lg">Banned</span>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ banned_users }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Restricted accounts</p>
        </div>
    </div>

    <!-- Admin Users -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 hover:shadow-card-hover transition-shadow">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-secondary-50 dark:bg-secondary-900/20 flex items-center justify-center">
                <i data-lucide="shield-check" class="w-6 h-6 text-secondary-600 dark:text-secondary-400"></i>
            </div>
            <span class="px-2.5 py-1 text-xs font-semibold bg-secondary-100 dark:bg-secondary-900/30 text-secondary-700 dark:text-secondary-400 rounded-lg">Admins</span>
        </div>
        <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{{ admin_users }}</p>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Administrators</p>
        </div>
    </div>
</div>

<!-- Recent Users Table -->
<div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Recent Users</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Latest registered accounts</p>
            </div>
            <a href="{{ path('app_admin_users') }}" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-900/20 rounded-xl transition-colors">
                <span>View all</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">User</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Email</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider hidden lg:table-cell">University</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider hidden sm:table-cell">Joined</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                {% for user in recent_users %}
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-sm shadow-sm">
                                {{ user.firstName|first ~ user.lastName|first }}
                            </div>
                            <div>
                                <p class="font-medium text-slate-900 dark:text-white">{{ user.fullName }}</p>
                                {% if user.isAdmin() %}
                                <span class="inline-flex items-center gap-1 mt-1 px-2 py-0.5 text-2xs font-semibold bg-secondary-100 dark:bg-secondary-900/30 text-secondary-700 dark:text-secondary-400 rounded-md">
                                    <i data-lucide="shield" class="w-3 h-3"></i>
                                    Admin
                                </span>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <p class="text-sm text-slate-600 dark:text-slate-400">{{ user.email }}</p>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap hidden lg:table-cell">
                        <p class="text-sm text-slate-600 dark:text-slate-400">{{ user.university ?? 'Not specified' }}</p>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {% if user.isBanned %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold bg-danger-100 dark:bg-danger-900/30 text-danger-700 dark:text-danger-400 rounded-lg">
                            <i data-lucide="ban" class="w-3 h-3"></i>
                            Banned
                        </span>
                        {% else %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-400 rounded-lg">
                            <i data-lucide="check" class="w-3 h-3"></i>
                            Active
                        </span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap hidden sm:table-cell">
                        <p class="text-sm text-slate-500 dark:text-slate-400">{{ user.createdAt|date('M d, Y') }}</p>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                                <i data-lucide="users" class="w-6 h-6 text-slate-400"></i>
                            </div>
                            <p class="text-sm text-slate-500 dark:text-slate-400">No users found</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════ -->
<!-- USER GALAXY — 3D interactive star map of all users                      -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<div class="mt-8 rounded-2xl overflow-hidden border border-slate-700/50 shadow-2xl"
     style="background: linear-gradient(135deg, #06060f 0%, #0a0a1a 50%, #040410 100%);">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-slate-700/40">
        <div class="flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center"
                 style="background: rgba(139,92,246,0.2); border: 1px solid rgba(139,92,246,0.4);">
                <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="#a78bfa" stroke-width="1.8">
                    <circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
                </svg>
            </div>
            <div>
                <h2 class="text-lg font-bold text-white">User Galaxy</h2>
                <p class="text-xs text-slate-400">
                    <span id="admin-galaxy-user-count" class="text-violet-400 font-semibold">…</span>
                    stars in your universe — drag to orbit, click a star to inspect
                </p>
            </div>
        </div>
        <!-- Legend -->
        <div class="hidden sm:flex items-center gap-4 text-xs text-slate-400">
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#ffd700;box-shadow:0 0 6px #ffd700;"></span>Admin</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#a5f3fc;box-shadow:0 0 5px #a5f3fc;"></span>Active</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#60a5fa;"></span>New</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#ff3333;box-shadow:0 0 5px #ff3333;"></span>Banned</span>
            <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#475569;"></span>Inactive</span>
        </div>
    </div>

    <!-- Galaxy canvas -->
    <div id="admin-galaxy-container" style="width: 100%; height: 520px; cursor: grab;"
         onmousedown="this.style.cursor='grabbing'" onmouseup="this.style.cursor='grab'">
    </div>
</div>
{% endblock %}
