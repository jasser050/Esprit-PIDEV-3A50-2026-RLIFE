{% extends 'admin/base_admin.html.twig' %}

{% block title %}New Recommendation{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto">
    <div class="mb-6">
        <a href="{{ path('app_admin_recommendation_stress_index') }}" class="text-sm text-secondary-500 hover:text-secondary-700 flex items-center gap-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Recommendations
        </a>
    </div>

    <div class="card p-6 md:p-8">
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white mb-6">
            Create New Recommendation
        </h1>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <div>
                {{ form_label(form.title, 'Title', {'label_attr': {'class': 'block text-sm font-semibold text-secondary-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'input input-bordered w-full', 'placeholder': 'e.g., Take a Short Walk'}}) }}
                {{ form_errors(form.title) }}
            </div>

            <div>
                {{ form_label(form.level, 'Stress Level', {'label_attr': {'class': 'block text-sm font-semibold text-secondary-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.level, {'attr': {'class': 'select select-bordered w-full'}}) }}
                {{ form_errors(form.level) }}
            </div>

            <div>
                {{ form_label(form.content, 'Content', {'label_attr': {'class': 'block text-sm font-semibold text-secondary-900 dark:text-white mb-2'}}) }}
                {{ form_widget(form.content, {'attr': {'class': 'textarea textarea-bordered w-full', 'rows': 5, 'placeholder': 'Detailed recommendation text...'}}) }}
                {{ form_errors(form.content) }}
            </div>

            <div class="flex items-center gap-3">
                {{ form_widget(form.isActive) }}
                {{ form_label(form.isActive, 'Active', {'label_attr': {'class': 'text-sm font-medium text-secondary-700 dark:text-secondary-300'}}) }}
            </div>

            <div class="flex gap-4 pt-4 border-t border-secondary-200 dark:border-secondary-800">
                <a href="{{ path('app_admin_recommendation_stress_index') }}" class="btn btn-secondary flex-1">Cancel</a>
                <button type="submit" class="btn btn-primary flex-1">
                    <i data-lucide="save" class="w-5 h-5 mr-2 inline"></i>
                    Create Recommendation
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
