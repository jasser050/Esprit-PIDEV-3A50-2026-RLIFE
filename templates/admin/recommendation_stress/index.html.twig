{% extends 'admin/base_admin.html.twig' %}

{% block title %}Stress Recommendations{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-secondary-900 dark:text-white">Stress Recommendations</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Manage personalized recommendations for students</p>
        </div>
        <a href="{{ path('app_admin_recommendation_stress_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
            Add Recommendation
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="card p-6 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-green-500 text-white flex items-center justify-center">
                    <i data-lucide="smile" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.low }}</p>
                    <p class="text-sm text-secondary-500">Low Stress</p>
                </div>
            </div>
        </div>
        <div class="card p-6 bg-gradient-to-br from-amber-50 to-yellow-50 dark:from-amber-900/20 dark:to-yellow-900/20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-amber-500 text-white flex items-center justify-center">
                    <i data-lucide="meh" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.medium }}</p>
                    <p class="text-sm text-secondary-500">Medium Stress</p>
                </div>
            </div>
        </div>
        <div class="card p-6 bg-gradient-to-br from-red-50 to-orange-50 dark:from-red-900/20 dark:to-orange-900/20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-red-500 text-white flex items-center justify-center">
                    <i data-lucide="frown" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.high }}</p>
                    <p class="text-sm text-secondary-500">High Stress</p>
                </div>
            </div>
        </div>
        <div class="card p-6 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-blue-500 text-white flex items-center justify-center">
                    <i data-lucide="list" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.total }}</p>
                    <p class="text-sm text-secondary-500">Total</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card overflow-hidden">
        {% if recommendations|length > 0 %}
        <div class="overflow-x-auto">
            <table class="table w-full">
                <thead class="bg-secondary-50 dark:bg-secondary-800/50">
                    <tr>
                        <th class="p-4 text-left">Title</th>
                        <th class="p-4 text-left">Level</th>
                        <th class="p-4 text-left">Preview</th>
                        <th class="p-4 text-center">Status</th>
                        <th class="p-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-secondary-200 dark:divide-secondary-800">
                    {% for rec in recommendations %}
                    <tr class="hover:bg-secondary-50 dark:hover:bg-secondary-800/30 transition-colors">
                        <td class="p-4">
                            <p class="font-medium text-secondary-900 dark:text-white">{{ rec.title }}</p>
                        </td>
                        <td class="p-4">
                            {% if rec.level == 'low' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                    Low Stress
                                </span>
                            {% elseif rec.level == 'medium' %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">
                                    Medium Stress
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">
                                    High Stress
                                </span>
                            {% endif %}
                        </td>
                        <td class="p-4 max-w-md">
                            <p class="text-secondary-600 dark:text-secondary-400 line-clamp-2">{{ rec.content }}</p>
                        </td>
                        <td class="p-4 text-center">
                            {% if rec.isIsActive %}
                                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                    Active
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200">
                                    Inactive
                                </span>
                            {% endif %}
                        </td>
                        <td class="p-4 text-right">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('app_admin_recommendation_stress_show', {id: rec.id}) }}" class="btn btn-sm btn-ghost">
                                    <i data-lucide="eye" class="w-4 h-4"></i>
                                </a>
                                <a href="{{ path('app_admin_recommendation_stress_edit', {id: rec.id}) }}" class="btn btn-sm btn-secondary">
                                    <i data-lucide="edit" class="w-4 h-4"></i>
                                </a>
                                <form method="post" action="{{ path('app_admin_recommendation_stress_delete', {id: rec.id}) }}" 
                                      onsubmit="return confirm('Are you sure you want to delete this recommendation?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rec.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i data-lucide="trash" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="p-12 text-center">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-secondary-100 dark:bg-secondary-800 flex items-center justify-center">
                    <i data-lucide="lightbulb" class="w-8 h-8 text-secondary-400"></i>
                </div>
                <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-2">No recommendations yet</h3>
                <p class="text-secondary-500 mb-4">Create your first stress recommendation for students</p>
                <a href="{{ path('app_admin_recommendation_stress_new') }}" class="btn btn-primary">Create Recommendation</a>
            </div>
        {% endif %}
    </div>
</div>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>
{% endblock %}
