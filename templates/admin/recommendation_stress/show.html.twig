{% extends 'admin/base_admin.html.twig' %}

{% block title %}Recommendation Details{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto">
    <div class="mb-6">
        <a href="{{ path('app_admin_recommendation_stress_index') }}" class="text-sm text-secondary-500 hover:text-secondary-700 flex items-center gap-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Recommendations
        </a>
    </div>

    <div class="card p-6 md:p-8">
        <div class="flex items-start justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">{{ recommendation.title }}</h1>
                <p class="text-secondary-500 mt-1">Created on {{ recommendation.createdAt|date('F j, Y') }}</p>
            </div>
            {% if recommendation.level == 'low' %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                    <i data-lucide="smile" class="w-4 h-4 mr-1"></i>
                    Low Stress
                </span>
            {% elseif recommendation.level == 'medium' %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">
                    <i data-lucide="meh" class="w-4 h-4 mr-1"></i>
                    Medium Stress
                </span>
            {% else %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200">
                    <i data-lucide="frown" class="w-4 h-4 mr-1"></i>
                    High Stress
                </span>
            {% endif %}
        </div>

        <div class="prose dark:prose-invert max-w-none mb-8">
            <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-3">Recommendation</h3>
            <div class="p-4 bg-secondary-50 dark:bg-secondary-800/50 rounded-lg">
                <p class="text-secondary-700 dark:text-secondary-300 whitespace-pre-wrap">{{ recommendation.content }}</p>
            </div>
        </div>

        <div class="flex items-center gap-4 mb-6">
            <span class="text-sm text-secondary-500">Status:</span>
            {% if recommendation.isIsActive %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                    <i data-lucide="check" class="w-4 h-4 mr-1"></i>
                    Active
                </span>
            {% else %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200">
                    <i data-lucide="x" class="w-4 h-4 mr-1"></i>
                    Inactive
                </span>
            {% endif %}
        </div>

        {% if recommendation.updatedAt %}
            <p class="text-sm text-secondary-500 mb-6">
                Last updated: {{ recommendation.updatedAt|date('F j, Y \\a\\t H:i') }}
            </p>
        {% endif %}

        <div class="flex gap-4 pt-4 border-t border-secondary-200 dark:border-secondary-800">
            <a href="{{ path('app_admin_recommendation_stress_index') }}" class="btn btn-secondary">Back</a>
            <a href="{{ path('app_admin_recommendation_stress_edit', {id: recommendation.id}) }}" class="btn btn-primary">
                <i data-lucide="edit" class="w-5 h-5 mr-2 inline"></i>
                Edit Recommendation
            </a>
            <form method="post" action="{{ path('app_admin_recommendation_stress_delete', {id: recommendation.id}) }}"
                  data-confirm="Are you sure you want to delete this recommendation?"
                  class="inline ml-auto">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recommendation.id) }}">
                <button type="submit" class="btn btn-danger">
                    <i data-lucide="trash" class="w-5 h-5 mr-2 inline"></i>
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
