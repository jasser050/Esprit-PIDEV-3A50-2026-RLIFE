{% extends 'base.html.twig' %}

{% block title %}Statistiques des notations{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ═══════════════════════════════════════════════════
   PAGE ADMIN - STATISTIQUES DES NOTATIONS
   ═══════════════════════════════════════════════════ */

.stats-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 32px;
    border-radius: 16px;
    margin-bottom: 32px;
}

.stats-header h1 {
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 8px;
}

.stats-header p {
    opacity: 0.85;
    margin: 0;
}

/* Cartes KPI en haut */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
}

.kpi-card {
    background: white;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-left: 4px solid;
}

.kpi-card.yellow { border-color: #f59e0b; }
.kpi-card.blue   { border-color: #3b82f6; }
.kpi-card.green  { border-color: #10b981; }
.kpi-card.purple { border-color: #8b5cf6; }

.kpi-label {
    font-size: 13px;
    font-weight: 500;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.kpi-value {
    font-size: 36px;
    font-weight: 700;
    color: #111827;
    line-height: 1;
}

.kpi-sub {
    font-size: 12px;
    color: #9ca3af;
}

/* Section graphique */
.chart-section {
    background: white;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    margin-bottom: 32px;
}

.chart-section h2 {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 20px;
}

.chart-container {
    position: relative;
    height: 300px;
}

/* Tableau des decks */
.table-section {
    background: white;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
}

.table-section h2 {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 20px;
}

.ratings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
}

.ratings-table thead tr {
    background: #f9fafb;
    border-bottom: 2px solid #e5e7eb;
}

.ratings-table th {
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    color: #374151;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.ratings-table td {
    padding: 14px 16px;
    border-bottom: 1px solid #f3f4f6;
    color: #374151;
    vertical-align: middle;
}

.ratings-table tr:hover td {
    background: #fafafa;
}

.ratings-table tr:last-child td {
    border-bottom: none;
}

/* Badges matière et niveau */
.badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
}

.badge-matiere {
    background: #ede9fe;
    color: #7c3aed;
}

.badge-niveau {
    background: #dbeafe;
    color: #1d4ed8;
}

/* Étoiles dans le tableau */
.stars-display {
    display: flex;
    align-items: center;
    gap: 6px;
}

.stars-visual {
    display: flex;
    gap: 1px;
}

.star-filled  { color: #f59e0b; font-size: 16px; }
.star-half    { color: #f59e0b; font-size: 16px; opacity: 0.5; }
.star-empty   { color: #d1d5db; font-size: 16px; }

.average-text {
    font-weight: 700;
    font-size: 15px;
    color: #111827;
}

.votes-count {
    color: #6b7280;
    font-size: 12px;
}

/* Barre de progression */
.progress-bar-wrap {
    background: #f3f4f6;
    border-radius: 999px;
    height: 8px;
    width: 100px;
    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #f59e0b, #f97316);
    transition: width 0.6s ease;
}

/* Bouton voir détail */
.btn-detail {
    padding: 6px 14px;
    border-radius: 8px;
    background: #f3f4f6;
    color: #374151;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: none;
    cursor: pointer;
}

.btn-detail:hover {
    background: #3b82f6;
    color: white;
}

/* Tableau "aucune donnée" */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #9ca3af;
}

.empty-state-icon {
    font-size: 48px;
    margin-bottom: 12px;
}

/* Top 5 */
.top-decks {
    background: white;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    margin-bottom: 32px;
}

.top-decks h2 {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 20px;
}

.top-deck-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #f3f4f6;
}

.top-deck-item:last-child {
    border-bottom: none;
}

.top-rank {
    font-size: 22px;
    width: 36px;
    text-align: center;
}

.top-info {
    flex: 1;
    min-width: 0;
}

.top-titre {
    font-weight: 600;
    color: #111827;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.top-meta {
    font-size: 12px;
    color: #6b7280;
    margin-top: 2px;
}

.top-stars {
    font-size: 16px;
    font-weight: 700;
    color: #f59e0b;
    white-space: nowrap;
}
</style>
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-7xl">

    {# ── En-tête ── #}
    <div class="stats-header">
        <h1>⭐ Statistiques des notations</h1>
        <p>Vue d'ensemble des notes données par les étudiants sur chaque deck</p>
    </div>

    {# ── KPI Cards ── #}
    <div class="kpi-grid">
        <div class="kpi-card yellow">
            <span class="kpi-label">Moyenne globale</span>
            <span class="kpi-value">{{ averageGlobal > 0 ? averageGlobal ~ '★' : '—' }}</span>
            <span class="kpi-sub">Tous decks confondus</span>
        </div>

        <div class="kpi-card blue">
            <span class="kpi-label">Total des votes</span>
            <span class="kpi-value">{{ totalVotesGlobal }}</span>
            <span class="kpi-sub">Avis d'étudiants</span>
        </div>

        <div class="kpi-card green">
            <span class="kpi-label">Decks notés</span>
            <span class="kpi-value">{{ globalStats|length }}</span>
            <span class="kpi-sub">Avec au moins 1 avis</span>
        </div>

        <div class="kpi-card purple">
            <span class="kpi-label">Meilleur deck</span>
            <span class="kpi-value" style="font-size:20px;">
                {% if topDecks|length > 0 %}
                    {{ topDecks[0]['deck'].titre|slice(0, 16) }}{% if topDecks[0]['deck'].titre|length > 16 %}…{% endif %}
                {% else %}
                    —
                {% endif %}
            </span>
            <span class="kpi-sub">
                {% if topDecks|length > 0 %}
                    {{ topDecks[0]['average']|number_format(1) }}★ ({{ topDecks[0]['total_votes'] }} votes)
                {% endif %}
            </span>
        </div>
    </div>

    {# ── Graphique + Top 5 en 2 colonnes ── #}
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 32px;">

        {# Graphique Chart.js #}
        <div class="chart-section">
            <h2>📊 Comparaison des moyennes (Top 10)</h2>
            {% if globalStats|length > 0 %}
                <div class="chart-container">
                    <canvas id="ratingsChart"></canvas>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-state-icon">📊</div>
                    <p>Aucune donnée disponible</p>
                </div>
            {% endif %}
        </div>

        {# Top 5 Decks #}
        <div class="top-decks" style="margin-bottom: 0;">
            <h2>🏆 Top 5 des decks les mieux notés</h2>
            {% if topDecks|length > 0 %}
                {% set medals = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'] %}
                {% for item in topDecks %}
                <div class="top-deck-item">
                    <span class="top-rank">{{ medals[loop.index0] ?? loop.index }}</span>
                    <div class="top-info">
                        <div class="top-titre">{{ item['deck'].titre }}</div>
                        <div class="top-meta">
                            {{ item['deck'].matiere }} · {{ item['deck'].niveau }}
                            · {{ item['total_votes'] }} vote{{ item['total_votes'] > 1 ? 's' : '' }}
                        </div>
                    </div>
                    <span class="top-stars">{{ item['average']|number_format(1) }}★</span>
                </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <div class="empty-state-icon">🏆</div>
                    <p>Aucun deck noté pour l'instant</p>
                </div>
            {% endif %}
        </div>
    </div>

    {# ── Tableau complet ── #}
    <div class="table-section">
        <h2>📋 Tous les decks notés</h2>

        {% if globalStats|length > 0 %}
        <table class="ratings-table">
            <thead>
                <tr>
                    <th>Deck</th>
                    <th>Matière</th>
                    <th>Niveau</th>
                    <th>Note moyenne</th>
                    <th>Barre</th>
                    <th>Votes</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for stat in globalStats %}
                <tr>
                    {# Titre #}
                    <td style="font-weight: 600; color: #111827;">
                        {{ stat['titre'] }}
                    </td>

                    {# Matière #}
                    <td>
                        <span class="badge badge-matiere">{{ stat['matiere'] }}</span>
                    </td>

                    {# Niveau #}
                    <td>
                        <span class="badge badge-niveau">{{ stat['niveau'] }}</span>
                    </td>

                    {# Étoiles #}
                    <td>
                        <div class="stars-display">
                            <div class="stars-visual">
                                {% set avg = stat['average']|round(0, 'floor') %}
                                {% for i in 1..5 %}
                                    {% if i <= avg %}
                                        <span class="star-filled">★</span>
                                    {% else %}
                                        <span class="star-empty">★</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <span class="average-text">{{ stat['average']|number_format(1) }}</span>
                        </div>
                    </td>

                    {# Barre de progression #}
                    <td>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar-fill"
                                 style="width: {{ (stat['average'] / 5 * 100)|round }}%;"></div>
                        </div>
                    </td>

                    {# Nombre de votes #}
                    <td>
                        <span class="votes-count">
                            {{ stat['total_votes'] }} vote{{ stat['total_votes'] > 1 ? 's' : '' }}
                        </span>
                    </td>

                    {# Bouton détail #}
                    <td>
                        <a href="{{ path('app_admin_ratings_deck', {'deckId': stat['deck_id']}) }}"
                           class="btn-detail">
                            🔍 Détail
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        {% else %}
            <div class="empty-state">
                <div class="empty-state-icon">⭐</div>
                <p style="font-size: 16px; font-weight: 500; color: #374151; margin-bottom: 8px;">
                    Aucune notation enregistrée
                </p>
                <p>Les étudiants n'ont pas encore noté de decks.</p>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
{# Chart.js depuis CDN #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const canvas = document.getElementById('ratingsChart');
    if (!canvas) return;

    // Charger les données depuis l'API admin
    fetch('/admin/ratings/api/chart-data')
        .then(r => r.json())
        .then(data => {
            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [
                        {
                            label: 'Moyenne ★',
                            data: data.averages,
                            backgroundColor: 'rgba(245, 158, 11, 0.7)',
                            borderColor: '#f59e0b',
                            borderWidth: 2,
                            borderRadius: 6,
                            yAxisID: 'y',
                        },
                        {
                            label: 'Nombre de votes',
                            data: data.totals,
                            type: 'line',
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            borderWidth: 2,
                            pointBackgroundColor: '#3b82f6',
                            pointRadius: 4,
                            tension: 0.3,
                            yAxisID: 'y2',
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: ctx => {
                                    if (ctx.dataset.label === 'Moyenne ★') {
                                        return ` Moyenne: ${ctx.parsed.y.toFixed(1)}★`;
                                    }
                                    return ` Votes: ${ctx.parsed.y}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            min: 0,
                            max: 5,
                            title: { display: true, text: 'Moyenne (★)' },
                            grid: { color: '#f3f4f6' }
                        },
                        y2: {
                            position: 'right',
                            title: { display: true, text: 'Nombre de votes' },
                            grid: { drawOnChartArea: false }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        })
        .catch(err => console.error('Erreur chart:', err));
});
</script>
{% endblock %}
