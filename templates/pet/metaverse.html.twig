                        padHandlers.push({ btn: btn, down: down, up: up });
                    });

                    if (claimBtn && !claimBtn.dataset.bound) {
                        claimBtn.dataset.bound = '1';
                        claimBtn.addEventListener('click', function() { claimCoins(); });
                    }
                    if (resetBtn && !resetBtn.dataset.bound) {
                        resetBtn.dataset.bound = '1';
                        resetBtn.addEventListener('click', function() {
                            gameData.pendingCoins = 0;
                            gameData.foundPets.clear();
                            gameData.foundTreasures.clear();
                            colliders.forEach(function(obj) {
                                obj.visible = true;
                                if (obj.userData) obj.userData.collected = false;
