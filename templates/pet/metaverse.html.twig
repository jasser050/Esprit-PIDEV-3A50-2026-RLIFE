                    const resizeHandler = function() {
                        if (!container._mvMapState || !container._mvMapState.alive) return;
                        const w = Math.max(280, container.clientWidth || 280);
                        const h = Math.max(220, container.clientHeight || 220);
                        camera.aspect = w / h;
                        camera.updateProjectionMatrix();
                        renderer.setSize(w, h);
                    };
                    window.addEventListener('resize', resizeHandler);

                    const state = {
                        alive: true,
                        renderer: renderer,
                        resizeHandler: resizeHandler,
                        pointerHandler: onPointerClick,
                        pointerMoveHandler: onPointerDownMove,
                        keyDownHandler: onKeyDown,
                        keyUpHandler: onKeyUp,
                        padHandlers: padHandlers,
                        lastNow: 0,
                        raf: 0
                    };
                    container._mvMapState = state;

                    const start = performance.now();
                    const animate = function(now) {
                        if (!state.alive) return;
                        const t = (now - start) / 1000;
                        const dt = Math.min(0.033, ((now - (state.lastNow || now)) / 1000) || 0.016);
                        state.lastNow = now;
                        // Animate water with wave effect
                        water.material.emissiveIntensity = 0.3 + ((Math.sin(t * 1.1) + 1) * 0.08);
                        water.position.y = -1.2 + Math.sin(t * 0.8) * 0.03;
                        
                        // Animate fountain water
                        fountainWater.material.emissiveIntensity = 0.35 + ((Math.sin(t * 2.8) + 1) * 0.18);
                        fountainJet.scale.y = 0.85 + ((Math.sin(t * 4.1) + 1) * 0.2);
                        
                        // Animate lamp glow
                        lampEmissives.forEach(function(mat, i) {
                            mat.emissiveIntensity = 0.5 + ((Math.sin((t * 1.7) + i * 0.5) + 1) * 0.25);
                        });

                        markerGroups.forEach(function(entry) {
                            entry.group.position.y = 0.82 + Math.sin((t * 1.8) + entry.offset) * 0.04;
                            const evoScaleBoost = entry.evolution ? (entry.evolution.index * 0.08) : 0;
                            const pulse = 1 + (Math.sin((t * 2.2) + entry.offset) * (0.1 + evoScaleBoost));
                            entry.beacon.scale.setScalar(pulse);
                            entry.aura.scale.setScalar(1 + (Math.sin((t * 1.9) + entry.offset) * (0.16 + evoScaleBoost)));
                            entry.aura.material.opacity = (entry.evolution ? entry.evolution.auraOpacity * 0.56 : 0.45) + ((Math.sin((t * 2.1) + entry.offset) + 1) * 0.2);
                            if (entry.aura2 && entry.aura2.material) {
                                entry.aura2.scale.setScalar(1 + (Math.sin((t * 2.5) + entry.offset) * (0.1 + evoScaleBoost * 0.8)));
                                entry.aura2.material.opacity = Math.max(0.25, (entry.evolution ? entry.evolution.auraOpacity * 0.48 : 0.36));
                            }
                            if (entry.petAnimate) {
                                entry.petAnimate(t + entry.offset, {
                                    stride: 0.14 + (entry.evolution ? entry.evolution.index * 0.02 : 0),
                                    activity: 0.5 + (entry.evolution ? entry.evolution.index * 0.08 : 0),
                                    blink: (Math.sin((t * 3.7) + entry.offset) + 1) * 0.12
                                });
                            }
                        });

                        const speed = 5.6;
                        const dir = new THREE.Vector3(
                            (moveState.right ? 1 : 0) - (moveState.left ? 1 : 0),
                            0,
                            (moveState.down ? 1 : 0) - (moveState.up ? 1 : 0)
                        );

                        const isMoving = dir.lengthSq() > 0;
                        if (isMoving) {
                            dir.normalize().multiplyScalar(speed * dt);
                            playerRig.position.add(dir);
                            playerRig.rotation.y = Math.atan2(dir.x, dir.z);
                        } else if (hasPointerTarget) {
                            const to = new THREE.Vector3(pointerTarget.x, playerRig.position.y, pointerTarget.z).sub(playerRig.position);
                            const len = to.length();
                            if (len > 0.2) {
                                to.normalize().multiplyScalar(Math.min(speed * dt, len));
                                playerRig.position.add(to);
                                playerRig.rotation.y = Math.atan2(to.x, to.z);
                            } else {
                                hasPointerTarget = false;
                            }
                        }

                        playerRig.position.x = Math.max(-(mapWidth / 2) + 0.7, Math.min((mapWidth / 2) - 0.7, playerRig.position.x));
                        playerRig.position.z = Math.max(-(mapDepth / 2) + 0.7, Math.min((mapDepth / 2) - 0.7, playerRig.position.z));
                        playerRig.position.y = 0.84 + (Math.sin(t * 6) * 0.02);
                        legL.rotation.x = Math.sin(t * 10) * (isMoving ? 0.7 : 0.08);
                        legR.rotation.x = -Math.sin(t * 10) * (isMoving ? 0.7 : 0.08);

                        colliders.forEach(function(obj) {
                            if (!obj.visible || !obj.userData || obj.userData.collected) return;
                            const dx = obj.position.x - playerRig.position.x;
                            const dz = obj.position.z - playerRig.position.z;
                            const dist = Math.sqrt(dx * dx + dz * dz);
                            if (dist > 0.78) return;

                            obj.userData.collected = true;
                            obj.visible = false;
                            const value = Number(obj.userData.value || 0);
                            gameData.pendingCoins += value;

                            if (obj.userData.kind === 'pet') {
                                gameData.foundPets.add(String(obj.userData.id));
                                setStatus('Friend pet found: +' + value + ' coins');
                            } else {
                                gameData.foundTreasures.add(String(obj.userData.id));
                                setStatus('Treasure found: +' + value + ' coins');
                            }

                            updateHud();
                            if (gameData.pendingCoins >= 40) claimCoins(40);
                            if (gameData.foundPets.size === gameData.totalPets && gameData.foundTreasures.size === gameData.totalTreasures) {
                                setStatus('Run complete! Claim your coins or reset for another run.');
                            }
                        });

                        camera.position.x = playerRig.position.x + 16;
                        camera.position.z = playerRig.position.z + 16;
                        camera.lookAt(playerRig.position.x, 0.75, playerRig.position.z);
                        renderer.render(scene, camera);
                        state.raf = requestAnimationFrame(animate);
                    };
                    state.raf = requestAnimationFrame(animate);
                    updateHud();
                    setStatus('Explore the map and collect pets + treasures.');
                });

                // Safety timeout: if canvas did not mount, fallback immediately.
                window.setTimeout(function() {
                    if (container.querySelector('canvas')) return;
                    if (container.querySelector('.mv-world-fallback')) return;
                    renderWorldFallback('Fallback map active');
                });
            }

            document.addEventListener('DOMContentLoaded', initMetaversePets);
            document.addEventListener('turbo:load', initMetaversePets);
            document.addEventListener('DOMContentLoaded', initWorldMap3D);
            document.addEventListener('turbo:load', initWorldMap3D);
            document.addEventListener('turbo:before-cache', function() {
                const map = document.getElementById('metaverseWorldMap');
                if (!map) return;

                if (map._mvRunnerState) {
                    const runnerState = map._mvRunnerState;
                    runnerState.alive = false;
                    if (runnerState.runner) runnerState.runner.alive = false;
                    if (runnerState.runner && runnerState.runner.raf) window.cancelAnimationFrame(runnerState.runner.raf);
                    else if (runnerState.raf) window.cancelAnimationFrame(runnerState.raf);
                    if (runnerState.resize) window.removeEventListener('resize', runnerState.resize);
                    if (runnerState.keydown) window.removeEventListener('keydown', runnerState.keydown);
                    if (runnerState.pointer && runnerState.canvas) runnerState.canvas.removeEventListener('pointerdown', runnerState.pointer);
                    delete map._mvRunnerState;
                }

                if (map._mvMapState) {
                    const state = map._mvMapState;
                    state.alive = false;
                    if (state.raf) window.cancelAnimationFrame(state.raf);
                    if (state.resizeHandler) window.removeEventListener('resize', state.resizeHandler);
                    if (state.pointerHandler) map.removeEventListener('click', state.pointerHandler);
                    if (state.pointerMoveHandler) map.removeEventListener('pointerdown', state.pointerMoveHandler);
                    if (state.keyDownHandler) window.removeEventListener('keydown', state.keyDownHandler);
                    if (state.keyUpHandler) window.removeEventListener('keyup', state.keyUpHandler);
                    if (Array.isArray(state.padHandlers)) {
                        state.padHandlers.forEach(function(item) {
                            item.btn.removeEventListener('pointerdown', item.down);
                            item.btn.removeEventListener('pointerup', item.up);
                            item.btn.removeEventListener('pointerleave', item.up);
                            item.btn.removeEventListener('touchcancel', item.up);
                        });
                    }
                    if (state.renderer) state.renderer.dispose();
                    delete map._mvMapState;
                }

                map.innerHTML = '';
            });
            window.setTimeout(initMetaversePets, 350);
            window.setTimeout(initWorldMap3D, 450);
        })();
    </script>
    <script>
        (function() {
            const mapPetsPayload = {{ mapPetsPayload|json_encode|raw }};
            const mapNode = document.getElementById('metaverseWorldMap');
            const rewardUrl = mapNode ? mapNode.dataset.rewardUrl : '';
            const actionUrl = mapNode ? mapNode.dataset.actionUrl : '';
            const communicateUrl = mapNode ? mapNode.dataset.communicateUrl : '';
            const communicationsUrl = mapNode ? mapNode.dataset.communicationsUrl : '';
            const gameModal = document.getElementById('mvMiniGameModal');
            const gameMeta = document.getElementById('mvMiniGameMeta');
            const gameTime = document.getElementById('mvMiniTime');
            const gameScore = document.getElementById('mvMiniScore');
            const gameStatus = document.getElementById('mvMiniStatus');
            const gameArena = document.getElementById('mvMiniArena');
            const gameTarget = document.getElementById('mvMiniTarget');
            const gameStartBtn = document.getElementById('mvMiniStart');
            const gameClaimBtn = document.getElementById('mvMiniClaim');
            const commsFeed = document.getElementById('mvCommsFeed');
            const commsBadge = document.getElementById('mvCommsBadge');

            const miniState = {
                memberId: null,
                petType: 'cat',
                petName: 'Pet',
                running: false,
                score: 0,
                seconds: 12,
                reward: 0,
                frameTimer: null,
                targetTimer: null,
                cooldownKey: ''
            };

            function postMapPayloadToIframe() {
                const iframe = document.querySelector('#metaverseWorldMap iframe, iframe[data-metaverse-map], #mvMapPanel iframe');
                if (!iframe || !iframe.contentWindow) return;
                iframe.contentWindow.postMessage({ type: 'METAVERSE_PET_DATA', payload: mapPetsPayload }, '*');
            }

            function showMiniModal() {
                if (!gameModal) return;
                gameModal.classList.remove('hidden');
                gameModal.classList.add('flex');
            }

            function hideMiniModal() {
                if (!gameModal) return;
                cleanupMiniTimers();
                gameModal.classList.add('hidden');
                gameModal.classList.remove('flex');
                miniState.running = false;
            }

            function cleanupMiniTimers() {
                if (miniState.frameTimer) {
                    window.clearInterval(miniState.frameTimer);
                    miniState.frameTimer = null;
                }
                if (miniState.targetTimer) {
                    window.clearInterval(miniState.targetTimer);
                    miniState.targetTimer = null;
                }
                if (gameTarget) gameTarget.classList.add('hidden');
            }

            function miniRewardForType(type, score) {
                const base = { cat: 14, dog: 12, dragon: 20, fox: 15, bird: 13, hamster: 10, panda: 16, rabbit: 11 };
                const value = Number(base[String(type || '').toLowerCase()] || 10) + Math.max(0, Math.min(20, score));
                return Math.max(8, Math.min(120, value));
            }

            function randomizeMiniTarget() {
                if (!gameArena || !gameTarget) return;
                const width = Math.max(120, gameArena.clientWidth);
                const height = Math.max(120, gameArena.clientHeight);
                const x = Math.floor(Math.random() * (width - 44));
                const y = Math.floor(Math.random() * (height - 44));
                gameTarget.style.left = x + 'px';
                gameTarget.style.top = y + 'px';
                gameTarget.classList.remove('hidden');
            }

            function finishMiniGame() {
                miniState.running = false;
                cleanupMiniTimers();
                miniState.reward = miniRewardForType(miniState.petType, miniState.score);
                if (gameStatus) gameStatus.textContent = 'Challenge complete. Reward ready: +' + miniState.reward + ' coins.';
                if (gameClaimBtn) gameClaimBtn.classList.remove('hidden');
                const cooldownUntil = Date.now() + 45000;
                if (miniState.cooldownKey) window.localStorage.setItem(miniState.cooldownKey, String(cooldownUntil));
            }

            function startMiniGame() {
                if (!gameStartBtn || !gameTime || !gameScore || !gameStatus) return;
                cleanupMiniTimers();
                miniState.running = true;
                miniState.score = 0;
                miniState.seconds = 12;
                miniState.reward = 0;
                gameScore.textContent = '0';
                gameTime.textContent = '12';
                gameStatus.textContent = 'Hit the moving orb as fast as you can.';
                if (gameClaimBtn) gameClaimBtn.classList.add('hidden');
                randomizeMiniTarget();

                miniState.frameTimer = window.setInterval(function() {
                    if (!miniState.running) return;
                    miniState.seconds -= 1;
                    gameTime.textContent = String(Math.max(0, miniState.seconds));
                    if (miniState.seconds <= 0) finishMiniGame();
                }, 1000);

                miniState.targetTimer = window.setInterval(function() {
                    if (!miniState.running) return;
                    randomizeMiniTarget();
                }, 600);
            }

            function applySkill(memberId, petType) {
                if (!actionUrl) return;
                const actionMap = { dragon: 'heal', panda: 'sleep', bird: 'play', dog: 'play', fox: 'play', hamster: 'feed', rabbit: 'feed', cat: 'play' };
                const action = actionMap[String(petType || '').toLowerCase()] || 'play';
                fetch(actionUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ action: action })
                })
                    .then(function(res) { return res.json().catch(function() { return {}; }); })
                    .then(function(data) {
                        const card = document.querySelector('[data-member-card=\"1\"][data-member-id=\"' + memberId + '\"]');
                        if (card) {
                            card.classList.add('mv-card-focus');
                            window.setTimeout(function() { card.classList.remove('mv-card-focus'); }, 900);
                        }
                        if (!data || !data.success) return;
                        const stage = document.getElementById('pet3d-metaverse-' + memberId);
                        if (stage && !stage.dataset.petEngine && window.RLife3D && typeof window.RLife3D.renderFallback === 'function') {
                            window.RLife3D.renderFallback(stage, { type: stage.dataset.petType || 'cat' });
                            stage.dataset.petEngine = 'fallback-card';
                        }
                    });
            }

            function sendCommunication(targetUserId, targetName, petName) {
                if (!communicateUrl) return;
                const text = window.prompt('Message to ' + targetName + ':');
                const message = String(text || '').trim();
                if (!message) return;
                fetch(communicateUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ recipientUserId: Number(targetUserId), message: message, petName: petName })
                }).then(function() { pollCommunications(); });
            }

            function renderCommunications(rows) {
                if (!commsFeed || !commsBadge) return;
                const items = Array.isArray(rows) ? rows : [];
                commsBadge.textContent = items.length + ' message' + (items.length > 1 ? 's' : '');
                if (!items.length) {
                    commsFeed.innerHTML = '<p class=\"text-xs text-slate-600 dark:text-cyan-200/70\">No communication yet.</p>';
                    return;
                }
                commsFeed.innerHTML = items.slice(0, 20).map(function(item) {
                    const directionClass = item.direction === 'in' ? 'border-cyan-400/35' : 'border-violet-400/35';
                    const from = item.fromName || 'Unknown';
                    const to = item.toName || 'Unknown';
                    const msg = String(item.message || '').replace(/[<>&]/g, '');
                    return '<div class=\"rounded-lg border ' + directionClass + ' bg-slate-900/70 px-3 py-2\">'
                        + '<p class=\"text-[11px] text-slate-400\">' + from + ' -> ' + to + '</p>'
                        + '<p class=\"text-xs text-slate-100 mt-0.5\">' + msg + '</p>'
                        + '</div>';
                }).join('');
            }

            function pollCommunications() {
                if (!communicationsUrl) return;
                fetch(communicationsUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function(res) { return res.json().catch(function() { return {}; }); })
                    .then(function(data) {
                        if (!data || !data.success) return;
                        renderCommunications(data.communications || []);
                    });
            }

            document.querySelectorAll('[data-mv-action=\"mini-game\"]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const memberId = String(btn.dataset.mvMemberId || '');
                    const petType = String(btn.dataset.mvPetType || 'cat');
                    const petName = String(btn.dataset.mvPetName || 'Pet');
                    const key = 'rlife.metaverse.minigame.cooldown.' + memberId;
                    const cooldownUntil = Number(window.localStorage.getItem(key) || '0');
                    if (cooldownUntil > Date.now()) {
                        const secondsLeft = Math.ceil((cooldownUntil - Date.now()) / 1000);
                        window.alert('Mini-game cooldown: ' + secondsLeft + 's');
                        return;
                    }
                    miniState.memberId = memberId;
                    miniState.petType = petType;
                    miniState.petName = petName;
                    miniState.cooldownKey = key;
                    if (gameMeta) gameMeta.textContent = 'Reflex Challenge for ' + petName + ' (' + petType + ').';
                    showMiniModal();
                });
            });

            document.querySelectorAll('[data-mv-action=\"skill\"]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    applySkill(String(btn.dataset.mvMemberId || ''), String(btn.dataset.mvPetType || 'cat'));
                });
            });

            document.querySelectorAll('[data-mv-action=\"communicate\"]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    sendCommunication(btn.dataset.mvMemberId, btn.dataset.mvUserName || 'member', btn.dataset.mvPetName || 'Pet');
                });
            });

            if (gameTarget) {
                gameTarget.addEventListener('click', function() {
                    if (!miniState.running) return;
                    miniState.score += 1;
                    if (gameScore) gameScore.textContent = String(miniState.score);
                    randomizeMiniTarget();
                });
            }
            if (gameStartBtn) gameStartBtn.addEventListener('click', startMiniGame);
            if (gameClaimBtn) {
                gameClaimBtn.addEventListener('click', function() {
                    if (!rewardUrl || miniState.reward <= 0) return;
                    fetch(rewardUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ coins: miniState.reward })
                    })
                        .then(function(res) { return res.json().catch(function() { return {}; }); })
                        .then(function(data) {
                            if (!data || !data.success) {
                                if (gameStatus) gameStatus.textContent = (data && data.error) ? data.error : 'Reward failed.';
                                return;
                            }
                            if (gameStatus) gameStatus.textContent = 'Reward claimed: +' + Number(data.grantedCoins || 0) + ' coins.';
                            miniState.reward = 0;
                            gameClaimBtn.classList.add('hidden');
                        });
                });
            }

            document.querySelectorAll('[data-mv-close-mini=\"1\"]').forEach(function(btn) {
                btn.addEventListener('click', hideMiniModal);
            });

            document.addEventListener('turbo:before-cache', cleanupMiniTimers);
            window.setInterval(pollCommunications, 4000);
            pollCommunications();
            window.setTimeout(postMapPayloadToIframe, 900);
            window.setTimeout(postMapPayloadToIframe, 1800);
        })();
    </script>
{% endblock %}
