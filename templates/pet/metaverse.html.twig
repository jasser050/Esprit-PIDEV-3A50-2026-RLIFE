{% extends 'base.html.twig' %}

{% block title %}Pet Metaverse{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Rajdhani:wght@500;600;700&display=swap');

        .metaverse-shell {
            --mv-bg-1: #06142d;
            --mv-bg-2: #0a1f3f;
            --mv-bg-3: #051024;
            --mv-neon: #42e8ff;
            --mv-neon-2: #ff6adf;
            --mv-text: #d9f3ff;
            --mv-muted: #8cb3c7;
            position: relative;
            overflow: hidden;
            border-radius: 28px;
            background:
                radial-gradient(circle at 20% 15%, #153e73 0%, var(--mv-bg-2) 38%, var(--mv-bg-1) 100%),
                linear-gradient(180deg, transparent 48%, rgba(4, 11, 26, 0.88) 100%);
            border: 1px solid rgba(66, 232, 255, 0.22);
            box-shadow: 0 40px 120px rgba(0, 8, 28, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        }

        .metaverse-shell::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 80% 12%, rgba(255, 106, 223, 0.25), transparent 44%),
                radial-gradient(circle at 15% 68%, rgba(66, 232, 255, 0.22), transparent 42%),
                repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 0, rgba(255, 255, 255, 0.03) 1px, transparent 1px, transparent 7px);
            pointer-events: none;
        }

        .metaverse-shell::after {
            content: "";
            position: absolute;
            inset: -10% -10% auto -10%;
            height: 70%;
            background: radial-gradient(circle at 50% 62%, rgba(66, 232, 255, 0.24), rgba(66, 232, 255, 0) 60%);
            filter: blur(16px);
            opacity: 0.8;
            animation: mv-aurora 9s ease-in-out infinite;
            pointer-events: none;
        }

        .metaverse-grid {
            position: absolute;
            left: -8%;
            right: -8%;
            bottom: -120px;
            height: 380px;
            transform: perspective(700px) rotateX(65deg);
            transform-origin: bottom center;
            background:
                linear-gradient(to top, rgba(66, 232, 255, 0.35), rgba(66, 232, 255, 0) 60%),
                repeating-linear-gradient(to right, rgba(66, 232, 255, 0.22) 0 1px, transparent 1px 52px),
                repeating-linear-gradient(to top, rgba(66, 232, 255, 0.18) 0 1px, transparent 1px 44px);
            opacity: 0.8;
            pointer-events: none;
            animation: mv-grid-shift 12s linear infinite;
        }

        .metaverse-stars {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image:
                radial-gradient(circle at 12% 20%, rgba(255,255,255,0.75) 1px, transparent 2px),
                radial-gradient(circle at 72% 14%, rgba(255,255,255,0.65) 1px, transparent 2px),
                radial-gradient(circle at 33% 46%, rgba(255,255,255,0.45) 1px, transparent 2px),
                radial-gradient(circle at 86% 35%, rgba(255,255,255,0.55) 1px, transparent 2px),
                radial-gradient(circle at 54% 25%, rgba(255,255,255,0.52) 1px, transparent 2px);
            animation: mv-stars-flicker 7s ease-in-out infinite alternate;
        }

        .metaverse-horizon {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 200px;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(66, 232, 255, 0.8), transparent);
            box-shadow: 0 0 20px rgba(66, 232, 255, 0.55);
            pointer-events: none;
        }

        .metaverse-orb {
            position: absolute;
            right: 9%;
            top: 10%;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.95), rgba(85, 184, 255, 0.75) 35%, rgba(11, 48, 80, 0.12) 72%);
            box-shadow: 0 0 42px rgba(66, 232, 255, 0.45);
            opacity: 0.76;
            animation: mv-orb-float 8s ease-in-out infinite;
            pointer-events: none;
        }

        .mv-title {
            font-family: "Orbitron", "Segoe UI", Tahoma, sans-serif;
            letter-spacing: 0.06em;
            color: var(--mv-text);
            text-shadow: 0 0 20px rgba(66, 232, 255, 0.35);
        }

        .mv-subtitle {
            color: var(--mv-muted);
            font-family: "Rajdhani", "Segoe UI", sans-serif;
            font-size: 1.1rem;
        }

        .mv-chip {
            border: 1px solid rgba(66, 232, 255, 0.35);
            color: #b9f6ff;
            background: linear-gradient(120deg, rgba(17, 44, 72, 0.75), rgba(15, 33, 61, 0.5));
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 18px rgba(66, 232, 255, 0.2);
        }

        .mv-card {
            position: relative;
            border-radius: 20px;
            border: 1px solid rgba(113, 171, 210, 0.24);
            background: linear-gradient(145deg, rgba(12, 32, 55, 0.82), rgba(8, 24, 44, 0.78));
            box-shadow: 0 20px 45px rgba(0, 7, 24, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
            transform-style: preserve-3d;
            transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
        }

        .mv-card:hover {
            transform: translateY(-6px) rotateX(4deg);
            border-color: rgba(66, 232, 255, 0.48);
            box-shadow: 0 28px 55px rgba(0, 9, 29, 0.52), 0 0 20px rgba(66, 232, 255, 0.18);
        }

        .mv-pet-card {
            --mv-pet-accent: rgba(66, 232, 255, 0.58);
            --mv-pet-glow: rgba(66, 232, 255, 0.26);
            overflow: hidden;
        }

        .mv-pet-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 10% 16%, color-mix(in srgb, var(--mv-pet-accent) 30%, transparent), transparent 58%),
                radial-gradient(circle at 85% 90%, color-mix(in srgb, var(--mv-pet-accent) 26%, transparent), transparent 56%);
            pointer-events: none;
            opacity: 0.75;
        }

        .mv-pet-card::after {
            content: "";
            position: absolute;
            inset: auto 10% 0 10%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--mv-pet-accent), transparent);
            box-shadow: 0 0 12px var(--mv-pet-glow);
            pointer-events: none;
        }

        .mv-pet-stage {
            border-radius: 16px;
            border: 1px solid rgba(66, 232, 255, 0.28);
            background:
                radial-gradient(circle at 50% 25%, rgba(66, 232, 255, 0.28), rgba(66, 232, 255, 0) 62%),
                linear-gradient(180deg, rgba(13, 45, 75, 0.66), rgba(6, 21, 41, 0.78));
            box-shadow: inset 0 0 30px rgba(3, 11, 22, 0.58);
            position: relative;
            overflow: hidden;
        }

        .mv-pet-stage::after {
            content: "";
            position: absolute;
            inset: 10% 10%;
            border-radius: 14px;
            border: 1px solid var(--mv-rarity-color, rgba(110, 231, 122, 0.55));
            box-shadow:
                0 0 14px var(--mv-rarity-color-soft, rgba(110, 231, 122, 0.3)),
                inset 0 0 18px var(--mv-rarity-color-soft, rgba(110, 231, 122, 0.2));
            pointer-events: none;
            animation: mv-rarity-pulse var(--mv-rarity-speed, 2.8s) ease-in-out infinite;
            opacity: 0.88;
        }

        .mv-meta {
            color: #b9d6e8;
            font-family: "Rajdhani", "Segoe UI", sans-serif;
            letter-spacing: 0.03em;
        }

        .mv-projects {
            border: 1px solid rgba(66, 232, 255, 0.2);
            background: linear-gradient(140deg, rgba(7, 26, 45, 0.86), rgba(5, 19, 35, 0.85));
        }

        .mv-presence {
            border: 1px solid rgba(88, 226, 255, 0.28);
            background: rgba(5, 22, 40, 0.58);
            color: #b8ebff;
            font-family: "Rajdhani", "Segoe UI", sans-serif;
            letter-spacing: 0.03em;
        }

        .mv-spline-viewer {
            width: 100%;
            height: 100%;
            display: block;
            border-radius: 16px;
            filter: saturate(1.04) contrast(1.03);
        }

        .mv-presence-dot {
            width: 8px;
            height: 8px;
            border-radius: 9999px;
            background: #42e8ff;
            box-shadow: 0 0 10px rgba(66, 232, 255, 0.7);
            animation: mv-presence-pulse 1.8s ease-in-out infinite;
        }

        .mv-map-wrap {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(66, 232, 255, 0.28);
            background: rgba(3, 13, 25, 0.7);
            box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.35);
        }

        .mv-map-frame {
            display: block;
            width: 100%;
            height: min(70vh, 760px);
            border: 0;
            background: #0a1a0a;
        }

        .mv-mini-badges {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
        }

        .mv-mini-badge {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            border-radius: 9999px;
            border: 1px solid color-mix(in srgb, var(--mv-pet-accent) 55%, rgba(255,255,255,0.2));
            color: #d8f7ff;
            padding: 0.2rem 0.55rem;
            background: color-mix(in srgb, var(--mv-pet-accent) 18%, rgba(2, 6, 23, 0.72));
            box-shadow: 0 0 10px color-mix(in srgb, var(--mv-pet-accent) 35%, transparent);
        }

        .mv-card[data-has-shared-projects="0"] .mv-presence-dot {
            background: #f59e0b;
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.65);
        }

        .mv-minigame-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            border: 1px solid rgba(66, 232, 255, 0.2);
            border-radius: 10px;
            padding: 0.45rem 0.6rem;
            background: rgba(8, 24, 44, 0.52);
        }

        .mv-mini-btn {
            font-family: "Rajdhani", "Segoe UI", sans-serif;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            border-radius: 9999px;
            border: 1px solid rgba(66, 232, 255, 0.35);
            color: #bff7ff;
            background: linear-gradient(120deg, rgba(26, 55, 84, 0.9), rgba(11, 38, 63, 0.85));
            padding: 0.28rem 0.72rem;
            transition: transform .15s ease, border-color .15s ease, opacity .15s ease;
        }

        .mv-mini-btn:hover {
            transform: translateY(-1px);
            border-color: rgba(66, 232, 255, 0.65);
        }

        .mv-mini-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        .mv-mini-score {
            font-size: 0.72rem;
            color: #9dd9ee;
            letter-spacing: 0.04em;
        }

        .mv-game-modal {
            position: fixed;
            inset: 0;
            z-index: 80;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: rgba(1, 6, 15, 0.72);
            backdrop-filter: blur(4px);
        }

        .mv-game-modal[hidden] {
            display: none !important;
        }

        .mv-game-panel {
            width: min(460px, 96vw);
            border-radius: 16px;
            border: 1px solid rgba(66, 232, 255, 0.34);
            background: linear-gradient(165deg, rgba(9, 28, 49, 0.96), rgba(6, 19, 36, 0.96));
            box-shadow: 0 20px 40px rgba(0, 8, 23, 0.45);
            padding: 0.95rem;
        }

        .mv-game-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            margin-bottom: 0.7rem;
        }

        .mv-game-title {
            font-size: 0.95rem;
            color: #d8f4ff;
            letter-spacing: 0.03em;
            font-family: "Orbitron", "Segoe UI", sans-serif;
        }

        .mv-game-meta {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            margin-bottom: 0.5rem;
        }

        .mv-game-chip {
            font-size: 0.68rem;
            color: #c2ecff;
            border: 1px solid rgba(66, 232, 255, 0.3);
            border-radius: 9999px;
            padding: 0.16rem 0.5rem;
            background: rgba(11, 38, 63, 0.65);
        }

        .mv-game-arena {
            position: relative;
            border-radius: 12px;
            border: 1px solid rgba(66, 232, 255, 0.28);
            background:
                radial-gradient(circle at 30% 25%, rgba(66, 232, 255, 0.15), transparent 60%),
                linear-gradient(180deg, rgba(5, 19, 35, 0.92), rgba(3, 12, 24, 0.95));
            height: 220px;
            overflow: hidden;
            margin-bottom: 0.7rem;
        }

        .mv-game-target {
            position: absolute;
            width: 44px;
            height: 44px;
            border-radius: 9999px;
            border: 1px solid rgba(255, 255, 255, 0.55);
            background: radial-gradient(circle at 34% 30%, #ffffff, #5ad8ff 44%, #1577ad 100%);
            box-shadow: 0 0 14px rgba(90, 216, 255, 0.65);
            transform: translate(-50%, -50%);
            cursor: pointer;
            left: 50%;
            top: 50%;
        }

        .mv-game-foot {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .mv-action-row {
            display: flex;
            gap: 0.45rem;
            flex-wrap: wrap;
        }

        .mv-emote {
            position: absolute;
            top: 8px;
            right: 10px;
            font-size: 1.2rem;
            opacity: 0;
            transform: translateY(4px) scale(0.9);
            transition: opacity .25s ease, transform .25s ease;
            pointer-events: none;
            z-index: 4;
        }

        .mv-emote.show {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        .mv-skill-flash {
            animation: mv-skill-flash 0.9s ease;
        }

        @keyframes mv-skill-flash {
            0% { box-shadow: inset 0 0 0 rgba(0,0,0,0), 0 0 0 rgba(66,232,255,0); }
            50% { box-shadow: inset 0 0 26px rgba(66,232,255,0.35), 0 0 24px rgba(66,232,255,0.38); }
            100% { box-shadow: inset 0 0 0 rgba(0,0,0,0), 0 0 0 rgba(66,232,255,0); }
        }

        .mv-evo-rise {
            animation: mv-evo-rise 1.1s ease;
        }

        @keyframes mv-evo-rise {
            0% { transform: scale(0.95); filter: saturate(0.9); }
            40% { transform: scale(1.03); filter: saturate(1.28); }
            100% { transform: scale(1); filter: saturate(1); }
        }

        html:not(.dark) .metaverse-shell {
            --mv-bg-1: #eef4ff;
            --mv-bg-2: #dfeeff;
            --mv-bg-3: #f6fbff;
            --mv-neon: #0284c7;
            --mv-neon-2: #9333ea;
            --mv-text: #0f172a;
            --mv-muted: #334155;
            border: 1px solid rgba(2, 132, 199, 0.24);
            box-shadow: 0 30px 70px rgba(15, 23, 42, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.7);
            background:
                radial-gradient(circle at 20% 15%, #ffffff 0%, var(--mv-bg-2) 38%, var(--mv-bg-1) 100%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.3) 46%, rgba(226, 232, 240, 0.75) 100%);
        }

        html:not(.dark) .metaverse-shell::before {
            background:
                radial-gradient(circle at 80% 12%, rgba(147, 51, 234, 0.16), transparent 44%),
                radial-gradient(circle at 15% 68%, rgba(2, 132, 199, 0.16), transparent 42%),
                repeating-linear-gradient(to bottom, rgba(15, 23, 42, 0.04) 0, rgba(15, 23, 42, 0.04) 1px, transparent 1px, transparent 7px);
        }

        html:not(.dark) .mv-title {
            color: #0f172a;
            text-shadow: 0 0 14px rgba(2, 132, 199, 0.2);
        }

        html:not(.dark) .mv-subtitle {
            color: #334155;
        }

        html:not(.dark) .mv-chip {
            border: 1px solid rgba(2, 132, 199, 0.25);
            color: #0f172a;
            background: linear-gradient(120deg, rgba(255, 255, 255, 0.9), rgba(226, 232, 240, 0.88));
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.8), 0 10px 18px rgba(2, 132, 199, 0.12);
        }

        html:not(.dark) .mv-card {
            border: 1px solid rgba(2, 132, 199, 0.2);
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(239, 246, 255, 0.92));
            box-shadow: 0 16px 32px rgba(15, 23, 42, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.9);
        }

        html:not(.dark) .mv-card:hover {
            border-color: rgba(2, 132, 199, 0.34);
            box-shadow: 0 20px 36px rgba(15, 23, 42, 0.14), 0 0 16px rgba(2, 132, 199, 0.18);
        }

        html:not(.dark) .mv-pet-stage {
            border: 1px solid rgba(2, 132, 199, 0.24);
            background:
                radial-gradient(circle at 50% 22%, rgba(2, 132, 199, 0.18), rgba(2, 132, 199, 0) 62%),
                linear-gradient(180deg, rgba(241, 245, 249, 0.95), rgba(226, 232, 240, 0.95));
            box-shadow: inset 0 0 24px rgba(148, 163, 184, 0.28);
        }

        html:not(.dark) .mv-meta {
            color: #334155;
        }

        html:not(.dark) .mv-projects {
            border: 1px solid rgba(2, 132, 199, 0.2);
            background: linear-gradient(140deg, rgba(248, 250, 252, 0.95), rgba(241, 245, 249, 0.94));
        }

        html:not(.dark) .mv-presence {
            border: 1px solid rgba(2, 132, 199, 0.24);
            background: rgba(241, 245, 249, 0.9);
            color: #0f172a;
        }

        html:not(.dark) .mv-map-wrap {
            border: 1px solid rgba(2, 132, 199, 0.24);
            background: rgba(255, 255, 255, 0.86);
            box-shadow: inset 0 0 20px rgba(148, 163, 184, 0.24);
        }

        html:not(.dark) .mv-mini-badge {
            color: #0f172a;
            background: color-mix(in srgb, var(--mv-pet-accent) 12%, #ffffff);
            border-color: color-mix(in srgb, var(--mv-pet-accent) 42%, rgba(2, 132, 199, 0.24));
        }

        html:not(.dark) .mv-minigame-bar {
            background: rgba(226, 232, 240, 0.75);
            border-color: rgba(2, 132, 199, 0.22);
        }

        html:not(.dark) .mv-mini-btn {
            color: #0f172a;
            background: linear-gradient(120deg, rgba(241, 245, 249, 0.95), rgba(226, 232, 240, 0.92));
            border-color: rgba(2, 132, 199, 0.35);
        }

        @keyframes mv-aurora {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); opacity: 0.75; }
            50% { transform: translate3d(0, 8px, 0) scale(1.08); opacity: 1; }
        }

        @keyframes mv-grid-shift {
            from { background-position: 0 0, 0 0, 0 0; }
            to { background-position: 0 0, 18px 0, 0 38px; }
        }

        @keyframes mv-stars-flicker {
            0% { opacity: 0.45; }
            100% { opacity: 0.92; }
        }

        @keyframes mv-orb-float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        @keyframes mv-presence-pulse {
            0%, 100% { transform: scale(1); opacity: 0.88; }
            50% { transform: scale(1.3); opacity: 1; }
        }

        @keyframes mv-rarity-pulse {
            0%, 100% { opacity: 0.7; transform: scale(0.985); }
            50% { opacity: 1; transform: scale(1); }
        }
    </style>
{% endblock %}

{% block body %}
{% set mapPetsPayload = community|map(m => {
    'userId': m.user.id,
    'type': m.pet.type,
    'name': m.pet.name,
    'owner': m.is_self ? 'You' : m.user.fullName,
    'level': m.pet.level,
    'mood': m.pet.mood|default('calm'),
    'rarity': m.pet.rarity|default('common'),
    'evolution': m.evolution.code|default('base'),
    'isSelf': m.is_self,
    'sharedProjectsCount': m.shared_projects|length,
    'hasSharedProjects': m.is_self ? true : ((m.shared_projects|length) > 0)
}) %}
<div class="max-w-7xl mx-auto py-6">
    <div class="metaverse-shell p-6 md:p-8">
        <div class="metaverse-stars"></div>
        <div class="metaverse-horizon"></div>
        <div class="metaverse-grid"></div>
        <div class="metaverse-orb"></div>

        <div class="relative z-10 space-y-6">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div>
                    <p class="text-xs tracking-[0.24em] uppercase text-sky-700 dark:text-cyan-300/85 mb-2">Social Habitat</p>
                    <h1 class="mv-title text-3xl md:text-4xl font-bold">Pet Metaverse</h1>
                    <p class="mv-subtitle mt-2 max-w-2xl">
                        A shared holographic world where companions of project collaborators gather in one immersive space.
                    </p>
                </div>
                <div class="mv-chip px-4 py-2.5 rounded-full text-sm font-semibold self-start lg:self-auto">
                    {{ community|length }} companion{{ community|length > 1 ? 's' : '' }} connected
                </div>
            </div>

            <div class="mv-card p-3 md:p-4">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <p class="text-xs uppercase tracking-wide text-slate-600 dark:text-cyan-200/80">Shared World Map</p>
                    <span class="mv-chip px-3 py-1.5 rounded-full text-xs font-semibold">PetVerse Garden</span>
                </div>
                <div class="mv-map-wrap">
                    <iframe
                        class="mv-map-frame"
                        src="{{ asset('assets/metaverse/petverse_map.html') }}?pets={{ mapPetsPayload|json_encode|url_encode }}"
                        title="PetVerse Garden Sky Map"
                        loading="lazy"
                        allowfullscreen></iframe>
                </div>
            </div>

            {% if community|length > 0 %}
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                    {% for member in community %}
                        <div class="mv-card mv-pet-card p-5 space-y-4 {{ member.is_self ? 'ring-1 ring-sky-400/50 dark:ring-cyan-300/45' : '' }}"
                             data-pet-type="{{ member.pet.type|lower }}"
                             data-pet-rarity="{{ member.pet.rarity|default('common')|lower }}"
                             data-pet-mood="{{ member.pet.mood|default('calm')|lower }}"
                             data-has-shared-projects="{{ member.is_self ? 1 : ((member.shared_projects|length) > 0 ? 1 : 0) }}">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="text-xs uppercase tracking-wide text-slate-600 dark:text-cyan-200/80">{{ member.is_self ? 'You' : member.user.fullName }}</p>
                                    <p class="text-xl font-semibold text-slate-900 dark:text-cyan-50 mt-0.5">{{ member.pet.name }}</p>
                                </div>
                                <span class="mv-chip px-3 py-1.5 rounded-full text-xs font-semibold">Lv. {{ member.pet.level }}</span>
                            </div>

                            <div id="pet3d-metaverse-{{ member.user.id }}"
                                 data-pet-type="{{ member.pet.type }}"
                                 data-hunger="{{ member.pet.hunger }}"
                                 data-mood="{{ member.pet.mood|default('calm') }}"
                                 data-rarity="{{ member.pet.rarity|default('common') }}"
                                 data-level="{{ member.pet.level }}"
                                 data-evolution="{{ member.evolution.code|default('base') }}"
                                 class="mv-pet-stage h-48">
                                 <span class="mv-emote" data-pet-emote>✨</span>
                            </div>

                            <div class="mv-meta text-xs flex items-center justify-between">
                                <span>Type: <strong>{{ member.pet.type|capitalize }}</strong></span>
                                <span>Mood: <strong>{{ member.pet.mood }}</strong></span>
                            </div>
                            <div class="mv-mini-badges">
                                <span class="mv-mini-badge">{{ member.pet.rarity|default('common')|capitalize }}</span>
                                <span class="mv-mini-badge">{{ member.evolution.label|default('Base Form') }}</span>
                            </div>
                            <div class="mv-presence rounded-lg px-3 py-2 text-xs flex items-center gap-2">
                                <span class="mv-presence-dot"></span>
                                <span data-pet-status>Scanning horizon...</span>
                            </div>
                            <div class="mv-minigame-bar">
                                <button class="mv-mini-btn"
                                        type="button"
                                        data-minigame-open
                                        data-user-id="{{ member.user.id }}"
                                        data-pet-type="{{ member.pet.type|lower }}"
                                        data-pet-name="{{ member.pet.name }}">
                                    Start mini-game
                                </button>
                                <span class="mv-mini-score" data-minigame-score data-user-id="{{ member.user.id }}">Wins: 0</span>
                            </div>
                            <div class="mv-action-row">
                                <button class="mv-mini-btn"
                                        type="button"
                                        data-skill-activate
                                        data-user-id="{{ member.user.id }}"
                                        data-pet-type="{{ member.pet.type|lower }}"
                                        data-pet-name="{{ member.pet.name }}">
                                    Use skill
                                </button>
                                {% if not member.is_self %}
                                    <button class="mv-mini-btn"
                                            type="button"
                                            data-communicate
                                            data-target-user-id="{{ member.user.id }}"
                                            data-target-pet-name="{{ member.pet.name }}"
                                            data-target-user-name="{{ member.user.fullName }}">
                                        Communicate
                                    </button>
                                {% endif %}
                            </div>

                            {% if not member.is_self %}
                                <div class="mv-projects rounded-xl p-3.5">
                                    <p class="text-xs font-semibold text-slate-700 dark:text-cyan-100 mb-1.5">Shared projects</p>
                                    {% if member.shared_projects|length > 0 %}
                                        {% for p in member.shared_projects|slice(0, 3) %}
                                            <p class="text-xs text-slate-600 dark:text-cyan-200/85">- {{ p }}</p>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-xs text-slate-500 dark:text-cyan-200/65">Connected collaborator</p>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="mv-card p-10 text-center">
                    <p class="text-xl font-semibold text-slate-900 dark:text-cyan-50">No companions in your metaverse yet</p>
                    <p class="text-sm text-slate-600 dark:text-cyan-200/75 mt-2">
                        Share projects with other users and this world will come alive.
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div id="mv-minigame-modal" class="mv-game-modal" hidden>
    <div class="mv-game-panel">
        <div class="mv-game-head">
            <h3 id="mv-game-title" class="mv-game-title">Reflex Challenge</h3>
            <button id="mv-game-close" class="mv-mini-btn" type="button">Close</button>
        </div>
        <div class="mv-game-meta">
            <span id="mv-game-pet" class="mv-game-chip">Pet</span>
            <span id="mv-game-goal" class="mv-game-chip">Goal</span>
            <span id="mv-game-time" class="mv-game-chip">Time</span>
        </div>
        <div id="mv-game-result" class="text-xs text-cyan-100/80 mb-2">Hit the moving orb before time runs out.</div>
        <div id="mv-game-arena" class="mv-game-arena">
            <button id="mv-game-target" class="mv-game-target" type="button" aria-label="Hit target"></button>
        </div>
        <div class="mv-game-foot">
            <span id="mv-game-score" class="mv-game-chip">Score: 0</span>
            <span id="mv-game-countdown" class="mv-game-chip">12.0s</span>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {% set mapPetsPayload = community|map(m => {
        'userId': m.user.id,
        'type': m.pet.type,
        'name': m.pet.name,
        'owner': m.is_self ? 'You' : m.user.fullName,
        'level': m.pet.level,
        'mood': m.pet.mood|default('calm'),
        'rarity': m.pet.rarity|default('common'),
        'evolution': m.evolution.code|default('base'),
        'isSelf': m.is_self,
        'sharedProjectsCount': m.shared_projects|length,
        'hasSharedProjects': m.is_self ? true : ((m.shared_projects|length) > 0)
    }) %}
    <script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.57/build/spline-viewer.js"></script>
    <script>
        (function() {
            const MAP_PETS_PAYLOAD = {{ mapPetsPayload|json_encode|raw }};
            const METAVERSE_SPLINE_URL = 'https://app.spline.design/file/b3af51c6-e447-4d4e-ae2f-8f846b560286';
            const PET_DESIGN_BY_TYPE = {
                cat: { icon: '🐱', rarity: 'Common', col: '#dd8844', accent: '#ff9955' },
                dog: { icon: '🐶', rarity: 'Common', col: '#aa6633', accent: '#cc8855' },
                dragon: { icon: '🐉', rarity: 'Legendary', col: '#228833', accent: '#44cc55' },
                fox: { icon: '🦊', rarity: 'Rare', col: '#cc5522', accent: '#ff7733' },
                bird: { icon: '🐦', rarity: 'Common', col: '#ddcc22', accent: '#ffee44' },
                hamster: { icon: '🐹', rarity: 'Common', col: '#ddaaaa', accent: '#eecccc' },
                panda: { icon: '🐼', rarity: 'Rare', col: '#111111', accent: '#ffffff' },
                rabbit: { icon: '🐰', rarity: 'Uncommon', col: '#ddccbb', accent: '#ffeedd' }
            };
            const FALLBACK_BY_TYPE = {
                cat: '{{ asset('pets/cat-design/cat-avatar.jpg') }}',
                dog: '{{ asset('pets/dog-design/dog-avatar.jpg') }}',
                dragon: '{{ asset('pets/dragon-design/dragon-avatar.jpg') }}',
                fox: '{{ asset('pets/fox-avatar.jpg') }}',
                bird: '{{ asset('pets/bird-avatar.jpg') }}',
                hamster: '{{ asset('pets/hamster-avatar.jpg') }}',
                panda: '{{ asset('pets/panda-design/panda-avatar.jpg') }}',
                rabbit: '{{ asset('pets/rabbit-avatar.jpg') }}'
            };

            let bootstrapTimer = null;
            let hydrateInProgress = false;
            const MINI_GAME_COOLDOWN_MS = 60000;
            const COMM_SEND_URL = '{{ path('app_pet_metaverse_communicate') }}';
            const COMM_FETCH_URL = '{{ path('app_pet_metaverse_communications') }}';
            const miniGameState = {
                active: false,
                userId: null,
                card: null,
                score: 0,
                goal: 8,
                durationMs: 12000,
                startedAt: 0,
                frameTimer: null,
                cooldownTicker: null,
                targetTimer: null
            };
            const commState = {
                lastId: 0,
                pollTimer: null
            };

            function csrfToken() {
                return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
            }

            function petSkillLabel(type) {
                const key = String(type || 'cat').toLowerCase();
                if (key === 'dragon') return 'Flame Pulse';
                if (key === 'fox') return 'Shadow Step';
                if (key === 'bird') return 'Sky Boost';
                if (key === 'dog') return 'Pack Rally';
                if (key === 'hamster') return 'Turbo Wheel';
                if (key === 'panda') return 'Zen Guard';
                if (key === 'rabbit') return 'Rapid Hop';
                return 'Purr Focus';
            }

            function emoteFromMood(mood, hunger) {
                if (hunger >= 80) return '🍖';
                const key = String(mood || 'calm').toLowerCase();
                if (['happy', 'excited', 'playful', 'joyful'].includes(key)) return '💖';
                if (['sad', 'tired', 'sleepy'].includes(key)) return '😴';
                if (['angry', 'wild', 'aggressive'].includes(key)) return '⚡';
                return '✨';
            }

            function minigameProfile(type) {
                const key = String(type || 'cat').toLowerCase();
                if (key === 'dragon') return { mode: 'Flame Dash', goal: 11, durationMs: 13000 };
                if (key === 'bird') return { mode: 'Sky Sprint', goal: 10, durationMs: 11000 };
                if (key === 'fox') return { mode: 'Shadow Dash', goal: 10, durationMs: 12000 };
                if (key === 'hamster') return { mode: 'Wheel Rush', goal: 8, durationMs: 10000 };
                if (key === 'panda') return { mode: 'Bamboo Focus', goal: 7, durationMs: 11000 };
                if (key === 'rabbit') return { mode: 'Hop Reflex', goal: 9, durationMs: 10500 };
                if (key === 'dog') return { mode: 'Fetch Boost', goal: 9, durationMs: 11000 };
                return { mode: 'Reflex Challenge', goal: 8, durationMs: 11000 };
            }

            function winsKey(userId) {
                return 'mv.minigame.wins.' + String(userId);
            }

            function cooldownKey(userId) {
                return 'mv.minigame.cooldown.' + String(userId);
            }

            function readWins(userId) {
                return parseInt(window.localStorage.getItem(winsKey(userId)) || '0', 10) || 0;
            }

            function incWins(userId) {
                const next = readWins(userId) + 1;
                window.localStorage.setItem(winsKey(userId), String(next));
                return next;
            }

            function cooldownLeftMs(userId) {
                const until = parseInt(window.localStorage.getItem(cooldownKey(userId)) || '0', 10) || 0;
                return Math.max(0, until - Date.now());
            }

            function setCooldown(userId) {
                window.localStorage.setItem(cooldownKey(userId), String(Date.now() + MINI_GAME_COOLDOWN_MS));
            }

            function fmtSec(ms) {
                return (Math.max(0, ms) / 1000).toFixed(1) + 's';
            }

            function moveTargetRandom() {
                const arena = document.getElementById('mv-game-arena');
                const target = document.getElementById('mv-game-target');
                if (!arena || !target) return;
                const x = 8 + Math.random() * 84;
                const y = 10 + Math.random() * 80;
                target.style.left = x + '%';
                target.style.top = y + '%';
            }

            function syncMiniButtons() {
                document.querySelectorAll('[data-minigame-open]').forEach(function(btn) {
                    const userId = btn.dataset.userId;
                    const left = cooldownLeftMs(userId);
                    if (left > 0) {
                        btn.disabled = true;
                        btn.textContent = 'Cooldown ' + Math.ceil(left / 1000) + 's';
                    } else {
                        btn.disabled = false;
                        btn.textContent = 'Start mini-game';
                    }
                });
                document.querySelectorAll('[data-minigame-score]').forEach(function(el) {
                    const userId = el.dataset.userId;
                    el.textContent = 'Wins: ' + readWins(userId);
                });
            }

            function endMiniGame(success) {
                if (!miniGameState.active) return;
                miniGameState.active = false;
                if (miniGameState.frameTimer) {
                    window.clearInterval(miniGameState.frameTimer);
                    miniGameState.frameTimer = null;
                }
                if (miniGameState.targetTimer) {
                    window.clearInterval(miniGameState.targetTimer);
                    miniGameState.targetTimer = null;
                }
                const result = document.getElementById('mv-game-result');
                const modal = document.getElementById('mv-minigame-modal');
                if (success) {
                    const wins = incWins(miniGameState.userId);
                    setCooldown(miniGameState.userId);
                    if (result) result.textContent = 'Win! Focus boost applied. Total wins: ' + wins;
                    const status = miniGameState.card?.querySelector('[data-pet-status]');
                    if (status) status.textContent = 'Mini-game won! Focus boost active.';
                } else {
                    if (result) result.textContent = 'Time up. Try again after cooldown.';
                }
                syncMiniButtons();
                window.setTimeout(function() {
                    if (modal) modal.hidden = true;
                }, 900);
            }

            function startMiniGame(button) {
                if (!button) return;
                const userId = button.dataset.userId;
                const left = cooldownLeftMs(userId);
                if (left > 0) {
                    syncMiniButtons();
                    return;
                }
                const petType = button.dataset.petType || 'cat';
                const petName = button.dataset.petName || 'Pet';
                const profile = minigameProfile(petType);
                const modal = document.getElementById('mv-minigame-modal');
                const title = document.getElementById('mv-game-title');
                const pet = document.getElementById('mv-game-pet');
                const goal = document.getElementById('mv-game-goal');
                const time = document.getElementById('mv-game-time');
                const score = document.getElementById('mv-game-score');
                const countdown = document.getElementById('mv-game-countdown');
                const result = document.getElementById('mv-game-result');
                if (!modal || !title || !pet || !goal || !time || !score || !countdown || !result) return;

                miniGameState.active = true;
                miniGameState.userId = userId;
                miniGameState.card = button.closest('.mv-card');
                miniGameState.score = 0;
                miniGameState.goal = profile.goal;
                miniGameState.durationMs = profile.durationMs;
                miniGameState.startedAt = Date.now();

                title.textContent = profile.mode;
                pet.textContent = 'Pet: ' + petName;
                goal.textContent = 'Goal: ' + profile.goal + ' hits';
                time.textContent = 'Duration: ' + fmtSec(profile.durationMs);
                score.textContent = 'Score: 0';
                countdown.textContent = fmtSec(profile.durationMs);
                result.textContent = 'Hit the moving orb before time runs out.';
                modal.hidden = false;
                const target = document.getElementById('mv-game-target');
                if (target) {
                    target.style.left = '50%';
                    target.style.top = '50%';
                }
                moveTargetRandom();

                if (miniGameState.frameTimer) window.clearInterval(miniGameState.frameTimer);
                miniGameState.frameTimer = window.setInterval(function() {
                    const elapsed = Date.now() - miniGameState.startedAt;
                    const leftMs = miniGameState.durationMs - elapsed;
                    countdown.textContent = fmtSec(leftMs);
                    if (leftMs <= 0) {
                        endMiniGame(false);
                    }
                }, 100);

                if (miniGameState.targetTimer) window.clearInterval(miniGameState.targetTimer);
                miniGameState.targetTimer = window.setInterval(function() {
                    if (miniGameState.active) moveTargetRandom();
                }, 850);
            }

            function initMiniGames() {
                const target = document.getElementById('mv-game-target');
                const close = document.getElementById('mv-game-close');
                const modal = document.getElementById('mv-minigame-modal');
                if (!target || !close || !modal) return;
                modal.hidden = true;

                if (!target.dataset.bound) {
                    target.dataset.bound = '1';
                    target.addEventListener('click', function() {
                        if (!miniGameState.active) return;
                        miniGameState.score += 1;
                        const score = document.getElementById('mv-game-score');
                        if (score) score.textContent = 'Score: ' + miniGameState.score;
                        moveTargetRandom();
                        if (miniGameState.score >= miniGameState.goal) {
                            endMiniGame(true);
                        }
                    });
                }

                if (!close.dataset.bound) {
                    close.dataset.bound = '1';
                    close.addEventListener('click', function() {
                        if (miniGameState.active) {
                            endMiniGame(false);
                        } else {
                            modal.hidden = true;
                        }
                    });
                }

                if (!modal.dataset.bound) {
                    modal.dataset.bound = '1';
                    modal.addEventListener('click', function(e) {
                        if (e.target === modal) {
                            if (miniGameState.active) endMiniGame(false);
                            else modal.hidden = true;
                        }
                    });
                }

                document.querySelectorAll('[data-minigame-open]').forEach(function(btn) {
                    if (btn.dataset.bound) return;
                    btn.dataset.bound = '1';
                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        try {
                            startMiniGame(btn);
                        } catch (_) {
                            modal.hidden = true;
                        }
                    });
                });

                syncMiniButtons();
                if (!miniGameState.cooldownTicker) {
                    miniGameState.cooldownTicker = window.setInterval(syncMiniButtons, 1000);
                }
            }

            function styleProfileFromType(type) {
                const key = String(type || 'cat').toLowerCase();
                const profiles = {
                    cat: ['#ffad77', '#ff8fab'],
                    dog: ['#f4b183', '#f59e0b'],
                    dragon: ['#22c55e', '#14b8a6'],
                    fox: ['#f97316', '#fb7185'],
                    bird: ['#facc15', '#38bdf8'],
                    hamster: ['#eab308', '#fca5a5'],
                    panda: ['#e2e8f0', '#94a3b8'],
                    rabbit: ['#fda4af', '#c4b5fd']
                };
                return profiles[key] || ['#67e8f9', '#22d3ee'];
            }

            function rarityStyle(rarity) {
                const key = String(rarity || 'common').toLowerCase();
                if (key === 'legendary') return { color: 'rgba(245,158,11,0.95)', soft: 'rgba(245,158,11,0.38)', speed: '1.6s' };
                if (key === 'epic') return { color: 'rgba(168,85,247,0.95)', soft: 'rgba(168,85,247,0.36)', speed: '2s' };
                if (key === 'rare') return { color: 'rgba(59,130,246,0.95)', soft: 'rgba(59,130,246,0.34)', speed: '2.3s' };
                if (key === 'uncommon') return { color: 'rgba(20,184,166,0.92)', soft: 'rgba(20,184,166,0.3)', speed: '2.5s' };
                return { color: 'rgba(110,231,122,0.9)', soft: 'rgba(110,231,122,0.28)', speed: '2.8s' };
            }

            function applyCardVisuals(card) {
                if (!card) return;
                const [accent, glow] = styleProfileFromType(card.dataset.petType);
                card.style.setProperty('--mv-pet-accent', accent);
                card.style.setProperty('--mv-pet-glow', glow);
            }

            function applyStageRarityAura(stage) {
                if (!stage) return;
                const rarity = rarityStyle(stage.dataset.rarity);
                stage.style.setProperty('--mv-rarity-color', rarity.color);
                stage.style.setProperty('--mv-rarity-color-soft', rarity.soft);
                stage.style.setProperty('--mv-rarity-speed', rarity.speed);
            }

            function applyEvolutionFx(stage) {
                if (!stage) return;
                const evo = String(stage.dataset.evolution || 'base').toLowerCase();
                if (evo === 'base') return;
                const key = 'mv.evo.seen.' + (stage.id || '');
                const alreadySeen = window.localStorage.getItem(key) === evo;
                if (!alreadySeen) {
                    stage.classList.add('mv-evo-rise');
                    window.setTimeout(function() { stage.classList.remove('mv-evo-rise'); }, 1200);
                    window.localStorage.setItem(key, evo);
                }
            }

            function triggerEmote(stage) {
                if (!stage) return;
                const emote = stage.querySelector('[data-pet-emote]');
                if (!emote) return;
                const hunger = Math.max(0, Math.min(100, parseInt(stage.dataset.hunger || '50', 10)));
                const mood = normalizeMood(stage.dataset.mood);
                emote.textContent = emoteFromMood(mood, hunger);
                emote.classList.add('show');
                window.setTimeout(function() {
                    emote.classList.remove('show');
                }, 1400);
            }

            function bindMoodEmotes(stage, index) {
                if (!stage || stage.dataset.emoteBound === '1') return;
                stage.dataset.emoteBound = '1';
                window.setInterval(function() {
                    triggerEmote(stage);
                }, 3600 + (index * 260));
                window.setTimeout(function() { triggerEmote(stage); }, 300 + (index * 100));
            }

            function activateSkill(button) {
                const card = button.closest('.mv-card');
                const stage = card?.querySelector('.mv-pet-stage');
                const status = card?.querySelector('[data-pet-status]');
                if (!stage || !status) return;
                stage.classList.add('mv-skill-flash');
                window.setTimeout(function() { stage.classList.remove('mv-skill-flash'); }, 950);
                const skill = petSkillLabel(button.dataset.petType);
                status.textContent = button.dataset.petName + ' used ' + skill + '!';
            }

            async function sendCommunication(button) {
                const card = button.closest('.mv-card');
                const status = card?.querySelector('[data-pet-status]');
                if (!status) return;
                const templates = ['hello', 'play', 'boost', 'team', 'guard'];
                const payload = {
                    targetUserId: parseInt(button.dataset.targetUserId || '0', 10),
                    template: templates[Math.floor(Math.random() * templates.length)]
                };
                if (!payload.targetUserId) return;

                button.disabled = true;
                status.textContent = 'Sending communication...';
                try {
                    const res = await fetch(COMM_SEND_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': csrfToken() },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        status.textContent = 'Communication failed.';
                    } else {
                        status.textContent = 'Message sent to ' + (button.dataset.targetPetName || 'pet') + '!';
                    }
                } catch (_) {
                    status.textContent = 'Communication failed.';
                } finally {
                    window.setTimeout(function() { button.disabled = false; }, 900);
                }
            }

            function showIncomingCommunication(message) {
                const stages = Array.from(document.querySelectorAll('[id^="pet3d-metaverse-"]'));
                if (!stages.length) return;
                const stage = stages[Math.floor(Math.random() * stages.length)];
                const status = stage.closest('.mv-card')?.querySelector('[data-pet-status]');
                if (status) status.textContent = 'Incoming: ' + String(message || 'A pet says hello.');
                triggerEmote(stage);
                stage.classList.add('mv-skill-flash');
                window.setTimeout(function() { stage.classList.remove('mv-skill-flash'); }, 900);
            }

            async function pollCommunications() {
                try {
                    const res = await fetch(COMM_FETCH_URL + '?sinceId=' + encodeURIComponent(String(commState.lastId)), {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data?.success) return;
                    const items = Array.isArray(data.messages) ? data.messages : [];
                    items.forEach(function(item) {
                        showIncomingCommunication(item.message);
                    });
                    commState.lastId = parseInt(String(data.lastId || commState.lastId), 10) || commState.lastId;
                } catch (_) {
                    // keep silent to avoid noisy UI
                }
            }

            function initActions() {
                document.querySelectorAll('[data-skill-activate]').forEach(function(btn) {
                    if (btn.dataset.boundSkill === '1') return;
                    btn.dataset.boundSkill = '1';
                    btn.addEventListener('click', function() { activateSkill(btn); });
                });
                document.querySelectorAll('[data-communicate]').forEach(function(btn) {
                    if (btn.dataset.boundComm === '1') return;
                    btn.dataset.boundComm = '1';
                    btn.addEventListener('click', function() { sendCommunication(btn); });
                });
                if (!commState.pollTimer) {
                    pollCommunications();
                    commState.pollTimer = window.setInterval(pollCommunications, 4000);
                }
            }

            function broadcastMapData() {
                const frame = document.querySelector('.mv-map-frame');
                if (!frame || !frame.contentWindow) return;
                frame.contentWindow.postMessage({
                    type: 'METAVERSE_PET_DATA',
                    petData: MAP_PETS_PAYLOAD,
                    community: MAP_PETS_PAYLOAD.map(function(item) {
                        return {
                            userId: item.userId,
                            hasSharedProjects: !!item.hasSharedProjects,
                            isSelf: !!item.isSelf
                        };
                    })
                }, '*');
            }

            function normalizeMood(mood) {
                return String(mood || 'calm').trim().toLowerCase();
            }

            function behaviorFromMood(mood, hunger) {
                const base = {
                    spin: 0.009 + (hunger / 100) * 0.004,
                    bobAmp: 0.05,
                    bobSpeed: 1.9,
                    tiltAmp: 0.03,
                    driftAmp: 0.08,
                    driftSpeed: 0.9,
                    hoverAmp: 0.02,
                    hoverSpeed: 1.6,
                    burstMultiplier: 2.1,
                    burstDurationMs: 620,
                    burstEveryMinMs: 3800,
                    burstEveryMaxMs: 7800,
                    wander: true,
                    arenaRadius: 1.1,
                    baseMoveSpeed: 0.42,
                    turnEase: 0.13
                };

                if (['happy', 'excited', 'playful', 'joyful'].includes(mood)) {
                    return { ...base, spin: 0.014, bobAmp: 0.072, bobSpeed: 2.7, driftAmp: 0.12, burstMultiplier: 2.5, baseMoveSpeed: 0.52 };
                }
                if (['sad', 'tired', 'sleepy'].includes(mood)) {
                    return { ...base, spin: 0.006, bobAmp: 0.03, bobSpeed: 1.2, driftAmp: 0.05, hoverAmp: 0.012, burstEveryMinMs: 6200, burstEveryMaxMs: 9800, baseMoveSpeed: 0.28 };
                }
                if (['angry', 'wild', 'aggressive'].includes(mood)) {
                    return { ...base, spin: 0.017, bobAmp: 0.064, bobSpeed: 3.1, tiltAmp: 0.045, burstMultiplier: 3.0, burstDurationMs: 760, baseMoveSpeed: 0.58 };
                }
                return base;
            }

            function messagesFromMood(mood, hunger) {
                if (hunger >= 78) return ['I need food soon.', 'Searching for snacks...', 'Energy dropping...'];
                if (['happy', 'excited', 'playful', 'joyful'].includes(mood)) return ['Zooming around!', 'Ready for missions!', 'Let us build together!'];
                if (['sad', 'tired', 'sleepy'].includes(mood)) return ['Taking a calm breath.', 'Need a short rest.', 'Still watching over projects.'];
                if (['angry', 'wild', 'aggressive'].includes(mood)) return ['Guard mode active.', 'Scanning for threats.', 'Powering up instincts.'];
                return ['Patrolling shared space.', 'Staying synced with team.', 'Exploring the metaverse.'];
            }

            function canUseSpline() {
                return typeof customElements !== 'undefined' && customElements.get('spline-viewer');
            }

            function renderSplinePet(stage) {
                if (!stage) return false;
                try {
                    if (window.RLife3D) window.RLife3D.dispose(stage);
                    stage.innerHTML = '';
                    const viewer = document.createElement('spline-viewer');
                    viewer.setAttribute('url', METAVERSE_SPLINE_URL);
                    viewer.className = 'mv-spline-viewer';
                    stage.appendChild(viewer);
                    stage.dataset.petEngine = 'spline';
                    return true;
                } catch (e) {
                    return false;
                }
            }

            function renderImmediatePlaceholder(stage) {
                if (!stage || stage.dataset.metaverseReady === '1' || stage.dataset.placeholderReady === '1') return;
                const type = String(stage.dataset.petType || 'cat').toLowerCase();
                const avatar = FALLBACK_BY_TYPE[type] || FALLBACK_BY_TYPE.cat;
                const design = PET_DESIGN_BY_TYPE[type] || PET_DESIGN_BY_TYPE.cat;
                const petName = stage.closest('.mv-card')?.querySelector('.text-xl')?.textContent?.trim() || type;
                const rarity = stage.dataset.rarity || design.rarity;

                stage.innerHTML = `
                    <div class="w-full h-full flex items-center justify-center">
                        <div style="width:84%;height:84%;border-radius:14px;position:relative;overflow:hidden;box-shadow:0 14px 28px rgba(2,6,23,0.36);background:radial-gradient(circle at 24% 18%, ${design.accent}55, transparent 54%),linear-gradient(145deg, ${design.col}55, #0b1324 70%);border:1px solid ${design.accent}88;">
                            ${avatar ? `<div style="position:absolute;inset:0;background-image:url('${avatar}');background-size:cover;background-position:center;opacity:.55;mix-blend-mode:screen;"></div>` : ''}
                            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.2rem;">
                                <div style="font-size:2.5rem;filter:drop-shadow(0 0 12px ${design.accent});">${design.icon}</div>
                                <div style="font-size:.72rem;font-weight:700;letter-spacing:.06em;color:#e6f6ff;background:#061427aa;padding:.18rem .5rem;border-radius:999px;border:1px solid ${design.accent}99;">${petName}</div>
                                <div style="font-size:.62rem;font-weight:700;letter-spacing:.05em;color:#c4e7ff;">${rarity}</div>
                            </div>
                        </div>
                    </div>
                `;
                stage.dataset.petEngine = 'placeholder';
                stage.dataset.placeholderReady = '1';
            }

            function bindStatus(stage, index, mood, hunger) {
                const status = stage.closest('.mv-card')?.querySelector('[data-pet-status]');
                if (!status) return;
                const messages = messagesFromMood(mood, hunger);
                const engineText = stage.dataset.petEngine === 'spline'
                    ? 'Spline live mode active.'
                    : (stage.dataset.petEngine === 'placeholder' ? 'Connecting 3D engine...' : messages[0]);
                status.textContent = engineText;

                if (!status.dataset.intervalBound) {
                    status.dataset.intervalBound = '1';
                    window.setInterval(function() {
                        const next = messages[Math.floor(Math.random() * messages.length)];
                        const text = stage.dataset.petEngine === 'spline'
                            ? 'Spline live mode active.'
                            : (stage.dataset.petEngine === 'placeholder' ? 'Connecting 3D engine...' : next);
                        status.textContent = text;
                    }, 3200 + (index * 270));
                }
            }

            function hydrateMetaversePets() {
                const stages = Array.from(document.querySelectorAll('[id^="pet3d-metaverse-"]'));
                if (!stages.length) return true;

                stages.forEach(function(stage, index) {
                    const hunger = Math.max(0, Math.min(100, parseInt(stage.dataset.hunger || '50', 10)));
                    const mood = normalizeMood(stage.dataset.mood);
                    applyCardVisuals(stage.closest('.mv-card'));
                    applyStageRarityAura(stage);
                    applyEvolutionFx(stage);
                    renderImmediatePlaceholder(stage);
                    bindStatus(stage, index, mood, hunger);
                    bindMoodEmotes(stage, index);
                });

                const hasEngine = window.RLife3D
                    && typeof window.RLife3D.ensureThree === 'function'
                    && typeof window.RLife3D.renderPet === 'function';
                if (!hasEngine || hydrateInProgress) {
                    return stages.every(function(stage) { return stage.dataset.metaverseReady === '1'; });
                }

                hydrateInProgress = true;
                window.RLife3D.ensureThree(function() {
                    stages.forEach(function(stage, index) {
                        if (stage.dataset.metaverseReady === '1') return;
                        const hunger = Math.max(0, Math.min(100, parseInt(stage.dataset.hunger || '50', 10)));
                        const mood = normalizeMood(stage.dataset.mood);
                        const behavior = behaviorFromMood(mood, hunger);
                        const useSpline = canUseSpline();

                        if (!useSpline || !renderSplinePet(stage)) {
                            window.RLife3D.renderPet(stage, {
                                type: stage.dataset.petType || 'cat',
                                hunger: hunger,
                                ...behavior
                            });
                            stage.dataset.petEngine = 'three';
                        }
                        stage.dataset.metaverseReady = '1';
                        bindStatus(stage, index, mood, hunger);
                    });

                    hydrateInProgress = false;
                    if (stages.every(function(stage) { return stage.dataset.metaverseReady === '1'; }) && bootstrapTimer) {
                        clearInterval(bootstrapTimer);
                        bootstrapTimer = null;
                    }
                });

                return stages.every(function(stage) { return stage.dataset.metaverseReady === '1'; });
            }

            function startMetaverseBootstrap() {
                if (bootstrapTimer) {
                    clearInterval(bootstrapTimer);
                    bootstrapTimer = null;
                }

                let attempts = 0;
                const maxAttempts = 40;
                const tick = function() {
                    attempts += 1;
                    const done = hydrateMetaversePets();
                    if (done || attempts >= maxAttempts) {
                        if (bootstrapTimer) {
                            clearInterval(bootstrapTimer);
                            bootstrapTimer = null;
                        }
                    }
                };

                tick();
                bootstrapTimer = window.setInterval(tick, 250);
            }

            document.addEventListener('DOMContentLoaded', startMetaverseBootstrap);
            document.addEventListener('turbo:load', startMetaverseBootstrap);
            document.addEventListener('DOMContentLoaded', initMiniGames);
            document.addEventListener('turbo:load', initMiniGames);
            document.addEventListener('DOMContentLoaded', initActions);
            document.addEventListener('turbo:load', initActions);
            document.addEventListener('DOMContentLoaded', broadcastMapData);
            document.addEventListener('turbo:load', broadcastMapData);
            window.addEventListener('load', function() {
                const frame = document.querySelector('.mv-map-frame');
                if (frame) frame.addEventListener('load', broadcastMapData, { once: false });
            });
            document.addEventListener('turbo:before-cache', function() {
                if (bootstrapTimer) {
                    clearInterval(bootstrapTimer);
                    bootstrapTimer = null;
                }
                if (commState.pollTimer) {
                    clearInterval(commState.pollTimer);
                    commState.pollTimer = null;
                }
            });
            window.setTimeout(startMetaverseBootstrap, 80);
        })();
    </script>
{% endblock %}
