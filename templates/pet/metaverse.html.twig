                    window.addEventListener('keydown', onKeyDown);
                    window.addEventListener('keyup', onKeyUp);

                    const padHandlers = [];
                    document.querySelectorAll('[data-mv-move]').forEach(function(btn) {
                        const dir = btn.getAttribute('data-mv-move');
                        if (!dir) return;
                        const down = function() { moveState[dir] = true; hasPointerTarget = false; };
                        const up = function() { moveState[dir] = false; };
                        btn.addEventListener('pointerdown', down);
                        btn.addEventListener('pointerup', up);
                        btn.addEventListener('pointerleave', up);
