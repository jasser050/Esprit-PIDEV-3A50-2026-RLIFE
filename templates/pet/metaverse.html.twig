                        chest.add(base, lid, trim, glow);
                        scene.add(chest);
                        colliders.push(chest);
                        clickTargets.push(chest);
                    };

                    stages.forEach(function(stage, index) {
                        const memberId = String(stage.id || '').replace('pet3d-metaverse-', '');
                        const mood = normalizeMood(stage.dataset.mood);
                        const level = Math.max(1, parseInt(stage.dataset.level || '1', 10));
                        const rarity = String(stage.dataset.rarity || 'common').toLowerCase();
                        const evolution = evolutionProfile(level, rarity, stage.dataset.evolutionCode);
                        const rarityTone = rarityColor(rarity);
                        const moodColor = colors[mood] || colors.default;
                        const displayColor = evolution.index >= 2 ? rarityTone : moodColor;
                        const angle = (Math.PI * 2 * index) / Math.max(stages.length, 1);
                        const radius = 8.2 + ((index % 5) * 2.2);

                        const markerGroup = new THREE.Group();
                        markerGroup.position.set(Math.cos(angle) * radius, 0.82, Math.sin(angle) * (radius * 0.8));
                        markerGroup.userData.kind = 'pet';
                        markerGroup.userData.id = memberId;
                        markerGroup.userData.collected = false;
                        markerGroup.userData.value = 20;

                        // Enhanced platform with glow
                        const base = new THREE.Mesh(
                            new THREE.CylinderGeometry(0.2, 0.22, 0.28, 28),
                            new THREE.MeshStandardMaterial({ 
                                color: 0x37474f, 
                                roughness: 0.35, 
                                metalness: 0.35,
                                emissive: displayColor,
                                emissiveIntensity: evolution.emissiveBoost * 0.2
                            })
                        );
                        base.castShadow = true;
                        markerGroup.add(base);

                        // Platform ring
                        const platformRing = new THREE.Mesh(
                            new THREE.RingGeometry(0.22, 0.28, 32),
                            new THREE.MeshStandardMaterial({ 
                                color: displayColor, 
                                emissive: displayColor, 
                                emissiveIntensity: evolution.emissiveBoost,
                                transparent: true,
                                opacity: 0.85,
                                side: THREE.DoubleSide
                            })
                        );
                        platformRing.rotation.x = -Math.PI / 2;
                        platformRing.position.y = 0.15;
                        markerGroup.add(platformRing);

                        const beacon = new THREE.Mesh(
                            new THREE.SphereGeometry(0.22, 24, 24),
                            new THREE.MeshStandardMaterial({ 
                                color: displayColor, 
                                emissive: displayColor, 
                                emissiveIntensity: evolution.emissiveBoost + 0.12, 
                                roughness: 0.3, 
                                metalness: 0.15,
                                transparent: true,
                                opacity: 0.95
                            })
                        );
                        beacon.position.y = 0.32;
                        beacon.castShadow = true;
                        markerGroup.add(beacon);

                        // Double aura rings
                        const aura = new THREE.Mesh(
                            new THREE.TorusGeometry(0.32, 0.025, 16, 48),
                            new THREE.MeshStandardMaterial({ 
                                color: displayColor, 
                                emissive: displayColor, 
                                emissiveIntensity: evolution.emissiveBoost * 0.92, 
                                transparent: true, 
                                opacity: evolution.auraOpacity
                            })
                        );
                        aura.rotation.x = Math.PI / 2;
                        aura.position.y = 0.1;
                        markerGroup.add(aura);

                        const aura2 = new THREE.Mesh(
                            new THREE.TorusGeometry(0.22, 0.015, 12, 32),
                            new THREE.MeshStandardMaterial({ 
                                color: 0xffffff, 
                                emissive: displayColor, 
                                emissiveIntensity: evolution.emissiveBoost + 0.15, 
