                            new THREE.BoxGeometry(0.54, 0.04, 0.4),
                            new THREE.MeshStandardMaterial({ 
                                color: 0xffd700, 
                                emissive: 0xffa500,
                                emissiveIntensity: 0.4,
                                roughness: 0.3,
                                metalness: 0.8
                            })
                        );
                        trim.position.y = 0.1;
                        
                        // Glow effect
                        const glow = new THREE.Mesh(
                            new THREE.SphereGeometry(0.25, 16, 16),
                            new THREE.MeshBasicMaterial({ 
