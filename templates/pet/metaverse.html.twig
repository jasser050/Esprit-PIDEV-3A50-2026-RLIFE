                        aura2.rotation.x = Math.PI / 2;
                        aura2.position.y = 0.22;
                        markerGroup.add(aura2);

                        const petType = stage.dataset.petType || 'cat';
                        const petDef = (window.RLife3D && typeof window.RLife3D.createPetModel === 'function')
                            ? window.RLife3D.createPetModel(petType, displayColor)
