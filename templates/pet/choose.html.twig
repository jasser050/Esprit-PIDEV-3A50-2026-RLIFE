{% extends 'base.html.twig' %}

{% block title %}Choose Your Companion{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-purple-50 via-pink-50 to-violet-50 dark:from-slate-950 dark:via-purple-950 dark:to-slate-950 py-12">
    <div class="max-w-4xl mx-auto px-4">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-3">
                Welcome to RLIFE!
            </h1>
            <p class="text-xl text-slate-600 dark:text-slate-400 max-w-md mx-auto">
                Choose a companion to join you throughout your journey
            </p>
        </div>

        <form method="post" class="space-y-10">
            <div>
                <label class="block text-lg font-medium text-slate-700 dark:text-slate-300 mb-6 text-center">
                    Which companion do you want?
                </label>

                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    {% for value, label in petOptions %}
                        <label class="pet-choice-card group cursor-pointer">
                            <input type="radio" name="petType" value="{{ value }}" class="hidden peer" required>

                            <div class="h-56 bg-white dark:bg-slate-800 rounded-3xl shadow-sm border-2 border-transparent peer-checked:border-purple-500 peer-checked:shadow-purple-200 transition-all overflow-hidden">
                                <div id="pet3d-{{ value }}" class="h-40 bg-gradient-to-br from-purple-100 to-pink-100 dark:from-purple-900/30 dark:to-pink-900/30 flex items-center justify-center">
                                    <!-- 3D preview injected by JS -->
                                </div>

                                <div class="p-4 text-center">
                                    <p class="font-semibold text-lg text-slate-800 dark:text-white">{{ label }}</p>
                                </div>
                            </div>
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div class="max-w-md mx-auto">
                <label for="petName" class="block text-lg font-medium text-slate-700 dark:text-slate-300 mb-3">
                    What is your companion's name?
                </label>
                <input type="text"
                       name="petName"
                       id="petName"
                       required
                       minlength="2"
                       maxlength="25"
                       class="w-full px-5 py-4 text-lg border border-slate-300 dark:border-slate-600 rounded-2xl focus:outline-none focus:border-purple-500 focus:ring-4 focus:ring-purple-100 dark:bg-slate-800 dark:text-white"
                       placeholder="Ex: Luna, Rex, Draco, Shadow...">
            </div>

            <div class="text-center">
                <button type="submit"
                        class="px-12 py-4 bg-gradient-to-r from-purple-600 to-violet-600 hover:from-purple-700 hover:to-violet-700 text-white font-semibold text-lg rounded-2xl shadow-lg shadow-purple-500/30 transition-all active:scale-95">
                    Confirm my choice
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function createPet3D(containerId, color) {
            const container = document.getElementById(containerId);
            if (!container) return;
            if (!window.RLife3D) return;
            window.RLife3D.renderPet(container, {
                color: color,
                emissive: 0x312e81,
                spin: 0.012
            });
        }

        function initChoose3D() {
            if (!window.RLife3D) return;
            window.RLife3D.ensureThree(() => {
                createPet3D('pet3d-cat', 0xf472b6);
                createPet3D('pet3d-dog', 0x60a5fa);
                createPet3D('pet3d-dragon', 0xa855f7);
                createPet3D('pet3d-fox', 0xfb923c);
                createPet3D('pet3d-bird', 0x4ade80);
                createPet3D('pet3d-hamster', 0xfbbf24);
                createPet3D('pet3d-panda', 0x94a3b8);
                createPet3D('pet3d-rabbit', 0xfda4af);
            });
        }

        document.addEventListener('DOMContentLoaded', initChoose3D);
        document.addEventListener('turbo:load', initChoose3D);

        document.addEventListener('turbo:before-cache', () => {
            ['pet3d-cat', 'pet3d-dog', 'pet3d-dragon', 'pet3d-fox', 'pet3d-bird', 'pet3d-hamster', 'pet3d-panda', 'pet3d-rabbit'].forEach((id) => {
                const container = document.getElementById(id);
                if (container && window.RLife3D) {
                    window.RLife3D.dispose(container);
                }
            });
        });
    </script>
{% endblock %}
