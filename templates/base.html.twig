        }

        function initPet3D() {
            const container = document.getElementById('pet3DModal');
            if (!container) return;
            const petType = (container.dataset.petType || 'cat').toLowerCase();
            const fallbackByType = {
                cat: window.RLife3D?.assets?.catFallback || '{{ asset('pets/cat-design/cat-avatar.jpg') }}',
                dog: window.RLife3D?.assets?.dogFallback || '{{ asset('pets/dog-design/dog-avatar.jpg') }}',
                fox: window.RLife3D?.assets?.foxFallback || '{{ asset('pets/fox-avatar.jpg') }}',
                dragon: window.RLife3D?.assets?.dragonFallback || '{{ asset('pets/dragon-design/dragon-avatar.jpg') }}',
                bird: window.RLife3D?.assets?.birdFallback || '{{ asset('pets/bird-avatar.jpg') }}',
                hamster: window.RLife3D?.assets?.hamsterFallback || '{{ asset('pets/hamster-avatar.jpg') }}',
                panda: window.RLife3D?.assets?.pandaFallback || '{{ asset('pets/panda-design/panda-avatar.jpg') }}',
                rabbit: window.RLife3D?.assets?.rabbitFallback || '{{ asset('pets/rabbit-avatar.jpg') }}'
            };
            const localFallback = function() {
                const avatar = fallbackByType[petType] || fallbackByType.cat || '';
                if (!avatar) return;
                container.innerHTML = `
                    <div class="w-full h-full flex items-center justify-center">
                        <div style="width:84%;height:84%;border-radius:22px;position:relative;overflow:hidden;box-shadow:0 16px 30px rgba(15,23,42,0.32);">
                            <div style="position:absolute;inset:0;background-image:url('${avatar}');background-size:cover;background-position:center;"></div>
                        </div>
                    </div>
                `;
            };

            if (!window.RLife3D || typeof window.RLife3D.ensureThree !== 'function' || typeof window.RLife3D.renderPet !== 'function') {
                localFallback();
                return;
            }

            // Always show immediate visual content, then upgrade to 3D.
            localFallback();

            window.RLife3D.ensureThree(function() {
                const opts = {
                    type: petType,
                    hunger: parseInt(container.dataset.hunger || '50', 10)
                };
                let attempts = 0;
                const tryRender = function() {
                    attempts += 1;
                    window.RLife3D.renderPet(container, opts);
                    if (container._rlife3d) return;
                    if (attempts >= 25) {
                        if (window.RLife3D && typeof window.RLife3D.renderFallback === 'function') {
                            window.RLife3D.renderFallback(container, opts);
                        } else {
                            localFallback();
                        }
                        return;
                    }
                    window.setTimeout(tryRender, 120);
                };
                tryRender();

                // If no real frame is rendered quickly, force fallback to avoid blank canvas.
                window.setTimeout(function() {
                    const state = container._rlife3d;
                    if (!state || state.hasFrame) return;
                    if (window.RLife3D && typeof window.RLife3D.dispose === 'function') window.RLife3D.dispose(container);
                    localFallback();
                }, 1600);
            });
        }

        async function refreshPetStatus(options = {}) {
            const rerender3d = Boolean(options.rerender3d);
            try {
                const response = await fetch('{{ path('app_pet_status') }}', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store'
                });
                const data = await response.json();
                if (!data || !data.hasPet) return;

                const nameNode = document.getElementById('petModalName');
                if (nameNode && data.name) nameNode.textContent = data.name;

                const mood = String(data.mood || '').trim();
                const moodLabel = mood ? mood.charAt(0).toUpperCase() + mood.slice(1) : 'Calm';
                const metaNode = document.getElementById('petModalMeta');
                if (metaNode) metaNode.textContent = `Lv. ${data.level} • ${moodLabel}`;

                const hunger = Number(data.hunger ?? 0);
                const hungerBar = document.getElementById('petModalHungerBar');
                if (hungerBar) hungerBar.style.width = `${Math.max(0, Math.min(100, 100 - hunger))}%`;
                const hungerValue = document.getElementById('petModalHungerValue');
                if (hungerValue) hungerValue.textContent = `${hunger}/100`;

                const coinText = `${Number(data.coins ?? 0)} coins`;
                const coinsNodes = ['petModalCoins', 'feedModalCoins'];
                coinsNodes.forEach(function(id) {
                    const node = document.getElementById(id);
                    if (node) node.textContent = coinText;
                });

                const renameInput = document.getElementById('petRenameInput');
                if (renameInput && data.name && renameInput.value !== data.name) {
                    renameInput.value = data.name;
                }

                const stage = document.getElementById('pet3DModal');
                if (stage) {
                    const currentType = String(data.type || stage.dataset.petType || 'cat').toLowerCase();
                    stage.dataset.petType = currentType;
                    stage.dataset.hunger = String(hunger);
                    if (rerender3d) {
                        if (window.RLife3D && typeof window.RLife3D.dispose === 'function') {
                            window.RLife3D.dispose(stage);
                        }
                        initPet3D();
                    }
                }
            } catch (e) {
                // Keep current UI values when network status refresh fails.
            }
        }

        async function submitPetFormAjax(form) {
            const body = new FormData(form);
            const response = await fetch(form.action, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body
            });
            const data = await response.json().catch(function() { return null; });
            if (!response.ok || !data || data.success === false) {
                throw new Error((data && (data.error || data.message)) || 'Pet action failed.');
            }
            return data;
        }

        async function runPetAction(action, trigger) {
            const normalized = String(action || '').trim().toLowerCase();
            if (!['play', 'sleep', 'heal', 'feed'].includes(normalized)) return;
            const feedback = document.getElementById('petActionFeedback');
            if (feedback) feedback.textContent = 'Running ' + normalized + '...';

            const stage = document.getElementById('pet3DModal');
            const hungerBar = document.getElementById('petModalHungerBar');
            const clearStageAnim = function() {
                if (!stage) return;
                stage.classList.remove('pet-stage-anim-play', 'pet-stage-anim-sleep', 'pet-stage-anim-heal', 'pet-stage-anim-feed');
            };
            const playActionBurst = function(target, actionName) {
                if (!target) return;
                const rect = target.getBoundingClientRect();
                const cx = rect.left + rect.width / 2;
                const cy = rect.top + rect.height / 2;
                const colorByAction = {
                    play: '#60a5fa',
                    sleep: '#818cf8',
                    heal: '#34d399',
                    feed: '#2dd4bf'
                };
                for (let i = 0; i < 8; i++) {
                    const dot = document.createElement('span');
                    dot.className = 'pet-action-burst';
                    dot.style.left = cx + 'px';
                    dot.style.top = cy + 'px';
                    dot.style.background = colorByAction[actionName] || '#60a5fa';
                    dot.style.setProperty('--dx', ((Math.random() * 80) - 40).toFixed(1) + 'px');
                    dot.style.setProperty('--dy', ((Math.random() * -70) - 16).toFixed(1) + 'px');
                    document.body.appendChild(dot);
                    window.setTimeout(function() { dot.remove(); }, 760);
                }
            };
            const applyActionAnim = function(actionName) {
                if (trigger) {
                    trigger.classList.remove('pet-action-btn-pop');
                    void trigger.offsetWidth;
                    trigger.classList.add('pet-action-btn-pop');
                    window.setTimeout(function() { trigger.classList.remove('pet-action-btn-pop'); }, 450);
                }

                clearStageAnim();
                if (stage) {
                    const classByAction = {
                        play: 'pet-stage-anim-play',
                        sleep: 'pet-stage-anim-sleep',
                        heal: 'pet-stage-anim-heal',
                        feed: 'pet-stage-anim-feed'
                    };
                    const stageAnimClass = classByAction[actionName];
                    if (stageAnimClass) {
                        void stage.offsetWidth;
                        stage.classList.add(stageAnimClass);
                        window.setTimeout(clearStageAnim, 1300);
                    }
                }

                if ((actionName === 'feed' || actionName === 'heal') && hungerBar) {
                    hungerBar.classList.remove('pet-hunger-boost');
                    void hungerBar.offsetWidth;
                    hungerBar.classList.add('pet-hunger-boost');
                    window.setTimeout(function() { hungerBar.classList.remove('pet-hunger-boost'); }, 980);
                }

                playActionBurst(trigger, actionName);
            };

            if (trigger && trigger.disabled) return;
            if (trigger) {
                trigger.disabled = true;
                trigger.classList.add('pet-action-btn-running');
            }
            try {
                const response = await fetch('{{ path('app_pet_action') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ action: normalized })
                });
                const data = await response.json().catch(function() { return null; });
                if (!response.ok || !data || data.success === false) {
                    const msg = (data && (data.error || data.message)) || 'Action failed.';
                    if (feedback) feedback.textContent = msg;
                    return;
                }

                let msg = normalized.charAt(0).toUpperCase() + normalized.slice(1) + ' complete.';
                if (data.levelUp) msg += ' Level up!';
                if (feedback) feedback.textContent = msg;
                applyActionAnim(normalized);
                await refreshPetStatus({ rerender3d: false });
            } catch (error) {
                if (feedback) feedback.textContent = 'Network error. Try again.';
            } finally {
                if (trigger) {
                    trigger.disabled = false;
                    trigger.classList.remove('pet-action-btn-running');
                }
            }
        }

        document.addEventListener('click', function(event) {
            const button = event.target instanceof Element ? event.target.closest('[data-pet-action]') : null;
            if (!button) return;
            event.preventDefault();
            const action = button.getAttribute('data-pet-action');
            runPetAction(action, button);
        });

        document.addEventListener('submit', async function(event) {
            const form = event.target;
            if (!(form instanceof HTMLFormElement)) return;
            const action = String(form.getAttribute('action') || '');
            const isPetFeed = action.includes('/pet/feed');
            const isPetRename = action.includes('/pet/rename');
            if (!isPetFeed && !isPetRename) return;

            event.preventDefault();
            const submitButton = form.querySelector('button[type="submit"]');
            if (submitButton) submitButton.disabled = true;
            try {
                await submitPetFormAjax(form);
                if (isPetFeed) {
                    const feedBtn = document.getElementById('petFeedPrimaryBtn');
                    if (feedBtn) {
                        feedBtn.classList.remove('pet-action-btn-pop');
                        void feedBtn.offsetWidth;
                        feedBtn.classList.add('pet-action-btn-pop');
                        window.setTimeout(function() { feedBtn.classList.remove('pet-action-btn-pop'); }, 450);
                    }

                    const stage = document.getElementById('pet3DModal');
                    if (stage) {
                        stage.classList.remove('pet-stage-anim-feed');
                        void stage.offsetWidth;
                        stage.classList.add('pet-stage-anim-feed');
                    }

                    const hungerBar = document.getElementById('petModalHungerBar');
                    if (hungerBar) {
                        hungerBar.classList.remove('pet-hunger-boost');
                        void hungerBar.offsetWidth;
                        hungerBar.classList.add('pet-hunger-boost');
                        window.setTimeout(function() { hungerBar.classList.remove('pet-hunger-boost'); }, 980);
                    }
                }

                if (isPetFeed) closeFeedModal();
                await refreshPetStatus({ rerender3d: isPetFeed });
            } catch (error) {
                console.error(error);
            } finally {
                if (submitButton) submitButton.disabled = false;
            }
        });

        (function() {
            const modal = document.getElementById('petManagementModal');
            if (!modal || typeof MutationObserver === 'undefined') return;
            const observer = new MutationObserver(function() {
                if (!modal.classList.contains('hidden')) {
                    initPet3D();
                }
            });
            observer.observe(modal, { attributes: true, attributeFilter: ['class'] });
        })();

        window.RLife3D.autoInitPetScenes = function() {
            const colorByType = {
                cat: 0xf472b6,
                dog: 0x60a5fa,
                dragon: 0xa855f7,
                fox: 0xfb923c,
                bird: 0x4ade80,
                hamster: 0xfbbf24,
                panda: 0x94a3b8,
                rabbit: 0xfda4af
            };

            const dashboard = document.getElementById('pet-3d-container');
            if (dashboard && !dashboard._rlife3d) {
                window.RLife3D.renderPet(dashboard, {
                    spin: 0.012,
                    hunger: parseInt(dashboard.dataset.hunger || '50', 10),
                    type: dashboard.dataset.petType || 'cat'
                });
            }

            const manage = document.getElementById('petScene');
            if (manage && !manage._rlife3d) {
                window.RLife3D.renderPet(manage, {
                    spin: 0.01,
                    hunger: parseInt(manage.dataset.petHunger || '50', 10),
                    type: manage.dataset.petType || 'cat'
                });
            }

            const previews = document.querySelectorAll('[id^="pet3d-"]');
            previews.forEach(function(container) {
                if (container.dataset.staticPreview === 'true') return;
                if (container.dataset.noAutoInit === 'true') return;
                if (container._rlife3d) return;
                const inferredType = container.dataset.petType || container.id.replace('pet3d-', '');
                window.RLife3D.renderPet(container, {
                    spin: 0.01,
                    type: inferredType,
                    color: colorByType[inferredType] || 0x8b5cf6
                });
            });
        };
    </script>
</head>

<body class="h-full font-sans antialiased app-shell text-slate-900 dark:text-slate-100"
      data-auth="{{ app.user ? '1' : '0' }}"
      data-route="{{ app.request.attributes.get('_route') }}">
    <script>
        (function () {
            function checkSessionGate() {
                try {
                    var body = document.body;
                    if (!body) return;
                    var isAuthed = body.dataset.auth === '1';
                    var route = body.dataset.route || '';
                    if (!isAuthed || route === 'app_login') return;

                    var key = 'rlife_browser_session';
                    var justKey = 'rlife_just_logged_in';
                    if (!sessionStorage.getItem(key)) {
                        var justLogged = sessionStorage.getItem(justKey) === '1';
                        sessionStorage.setItem(key, '1');
                        sessionStorage.removeItem(justKey);
                        if (!justLogged) {
                            window.location.replace('{{ path('app_logout') }}');
                        }
                    }
                } catch (e) {}
            }

            checkSessionGate();
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) checkSessionGate();
            });
        })();
    </script>
