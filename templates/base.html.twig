        window.RLife3D.loadImportedCatModel = function(onReady, onError) {
            const handleReady = typeof onReady === 'function' ? onReady : function() {};
            const handleError = typeof onError === 'function' ? onError : function() {};

            const parseObjToMesh = function(objText, material) {
                const verts = [];
                const uvs = [];
                const norms = [];
                const pos = [];
                const tex = [];
                const nrm = [];

                const lines = objText.split(/\r?\n/);
                for (let i = 0; i < lines.length; i += 1) {
                    const line = lines[i].trim();
                    if (!line || line.startsWith('#')) continue;

                    const parts = line.split(/\s+/);
                    const key = parts[0];

                    if (key === 'v' && parts.length >= 4) {
                        verts.push([parseFloat(parts[1]), parseFloat(parts[2]), parseFloat(parts[3])]);
                    } else if (key === 'vt' && parts.length >= 3) {
                        uvs.push([parseFloat(parts[1]), parseFloat(parts[2])]);
                    } else if (key === 'vn' && parts.length >= 4) {
                        norms.push([parseFloat(parts[1]), parseFloat(parts[2]), parseFloat(parts[3])]);
                    } else if (key === 'f' && parts.length >= 4) {
                        const face = parts.slice(1);
                        for (let t = 1; t < face.length - 1; t += 1) {
                            const tri = [face[0], face[t], face[t + 1]];
                            tri.forEach(function(token) {
                                const idx = token.split('/');
                                const vi = parseInt(idx[0], 10);
                                const ti = idx[1] ? parseInt(idx[1], 10) : 0;
                                const ni = idx[2] ? parseInt(idx[2], 10) : 0;

                                const v = verts[(vi < 0 ? verts.length + vi : vi - 1)] || [0, 0, 0];
                                pos.push(v[0], v[1], v[2]);

                                const uv = ti ? (uvs[(ti < 0 ? uvs.length + ti : ti - 1)] || [0, 0]) : [0, 0];
                                tex.push(uv[0], 1 - uv[1]);

                                const nn = ni ? (norms[(ni < 0 ? norms.length + ni : ni - 1)] || [0, 1, 0]) : [0, 1, 0];
                                nrm.push(nn[0], nn[1], nn[2]);
                            });
                        }
                    }
                }

                const geom = new THREE.BufferGeometry();
                geom.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
                if (tex.length === (pos.length / 3) * 2) geom.setAttribute('uv', new THREE.Float32BufferAttribute(tex, 2));
                if (nrm.length === pos.length) geom.setAttribute('normal', new THREE.Float32BufferAttribute(nrm, 3));
                else geom.computeVertexNormals();
                geom.computeBoundingBox();
                geom.computeBoundingSphere();

                const mesh = new THREE.Mesh(geom, material);
                const group = new THREE.Group();
                group.add(mesh);
                return group;
            };

            const buildCat = function() {
                try {
                    const source = window.RLife3D._catModelSource;
                    if (!source) {
                        handleError();
                        return;
                    }
                    const cat = source.clone(true);
                    const box = new THREE.Box3().setFromObject(cat);
                    const size = new THREE.Vector3();
                    const center = new THREE.Vector3();
                    box.getSize(size);
                    box.getCenter(center);
                    const maxDim = Math.max(size.x, size.y, size.z) || 1;
                    const normalizedScale = 1.8 / maxDim;
                    cat.scale.setScalar(normalizedScale);
                    cat.position.sub(center.multiplyScalar(normalizedScale));
                    const floorFix = new THREE.Box3().setFromObject(cat);
                    cat.position.y += -0.78 - floorFix.min.y;
                    handleReady(cat);
                } catch (e) {
                    handleError(e);
                }
            };

            if (window.RLife3D._catModelSource) {
                buildCat();
                return;
            }

            if (window.RLife3D._catModelLoading) {
                window.RLife3D._catModelQueue = window.RLife3D._catModelQueue || [];
                window.RLife3D._catModelQueue.push({ ok: handleReady, ko: handleError });
                return;
            }

            window.RLife3D._catModelLoading = true;
            window.RLife3D._catModelQueue = window.RLife3D._catModelQueue || [];
            window.RLife3D._catModelQueue.push({ ok: handleReady, ko: handleError });

            try {
                const texLoader = new THREE.TextureLoader();
                const diffuse = texLoader.load(window.RLife3D.assets.catDiffuse);
                const normal = texLoader.load(window.RLife3D.assets.catNormal);
                if (diffuse.colorSpace !== undefined && THREE.SRGBColorSpace !== undefined) {
                    diffuse.colorSpace = THREE.SRGBColorSpace;
                }

                const material = new THREE.MeshStandardMaterial({
                    map: diffuse,
                    normalMap: normal,
                    side: THREE.DoubleSide,
                    metalness: 0.08,
                    roughness: 0.82
                });

                fetch(window.RLife3D.assets.catObj)
                    .then(function(res) {
                        if (!res.ok) throw new Error('Failed to fetch base.obj');
                        return res.text();
                    })
                    .then(function(objText) {
                        return import(window.RLife3D.assets.objLoaderModule)
                            .then(function(mod) {
                                const loader = new mod.OBJLoader();
                                const object = loader.parse(objText);
                                object.traverse(function(node) {
                                    if (node.isMesh) {
                                        node.material = material;
                                        node.castShadow = false;
                                        node.receiveShadow = false;
                                    }
                                });
                                return object;
                            })
                            .catch(function() {
                                return parseObjToMesh(objText, material);
                            });
                    })
                    .then(function(object) {
                        window.RLife3D._catModelSource = object;
                        window.RLife3D._catModelLoading = false;

                        const queue = window.RLife3D._catModelQueue || [];
                        window.RLife3D._catModelQueue = [];
                        queue.forEach(function(item) {
                            try {
                                window.RLife3D.loadImportedCatModel(item.ok, item.ko);
                            } catch (e) {
                                item.ko(e);
                            }
                        });
                    })
                    .catch(function(err) {
                        window.RLife3D._catModelLoading = false;
                        const queue = window.RLife3D._catModelQueue || [];
                        window.RLife3D._catModelQueue = [];
                        queue.forEach(function(item) { item.ko(err); });
                    });
            } catch (err) {
                window.RLife3D._catModelLoading = false;
                const queue = window.RLife3D._catModelQueue || [];
                window.RLife3D._catModelQueue = [];
                queue.forEach(function(item) { item.ko(err); });
            }
        };

