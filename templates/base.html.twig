    .pet-action-btn-pop {
        animation: petBtnPop 360ms cubic-bezier(.2, .9, .28, 1.2);
    }

    .pet-stage-anim-play {
        animation: petStagePlay 650ms cubic-bezier(.22, .8, .25, 1);
    }

    .pet-stage-anim-sleep {
        animation: petStageSleep 1200ms ease-in-out;
    }

    .pet-stage-anim-heal {
        animation: petStageHeal 900ms ease-out;
    }

    .pet-stage-anim-feed {
        animation: petStageFeed 800ms cubic-bezier(.2, .82, .2, 1);
    }

    .pet-hunger-boost {
        animation: petHungerBoost 850ms cubic-bezier(.21, .93, .26, 1);
    }

    .pet-action-burst {
        position: fixed;
        z-index: 130;
        pointer-events: none;
        width: 10px;
        height: 10px;
        border-radius: 9999px;
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.2);
        animation: petBurst 700ms ease-out forwards;
    }

    @keyframes petBtnRunningPulse {
        0%, 100% { transform: translateY(0); box-shadow: 0 0 0 0 rgba(94, 234, 212, 0.12); }
        50% { transform: translateY(-1px); box-shadow: 0 0 0 5px rgba(94, 234, 212, 0); }
    }

    @keyframes petBtnPop {
        0% { transform: scale(1); }
        50% { transform: scale(0.94); }
        100% { transform: scale(1); }
    }

    @keyframes petStagePlay {
        0% { transform: translateY(0) scale(1) rotate(0deg); }
        25% { transform: translateY(-3px) scale(1.01) rotate(-1deg); }
        50% { transform: translateY(0) scale(1.015) rotate(1deg); }
        100% { transform: translateY(0) scale(1) rotate(0deg); }
    }

    @keyframes petStageSleep {
        0% { filter: saturate(1) brightness(1); }
        35% { filter: saturate(0.82) brightness(0.94); }
        100% { filter: saturate(1) brightness(1); }
