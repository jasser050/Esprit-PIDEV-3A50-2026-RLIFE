    function normalizeSpotifyUrl(url) {
        if (!url) return '';
        let clean = String(url).trim();
        clean = clean.replace('https://open.spotify.com/intl-fr/', 'https://open.spotify.com/');
        clean = clean.replace('https://open.spotify.com/intl-en/', 'https://open.spotify.com/');
        clean = clean.replace('https://open.spotify.com/intl/', 'https://open.spotify.com/');
        clean = clean.replace('https://open.spotify.com/', 'https://open.spotify.com/');
        clean = clean.split('?')[0];
        if (clean.includes('/embed/')) return clean + '?utm_source=generator';
        if (clean.includes('open.spotify.com/')) {
            clean = clean.replace('open.spotify.com/', 'open.spotify.com/embed/');
            return clean + '?utm_source=generator';
        }
        return url;
    }

    function normalizeSpotifyListUrl(url) {
        const clean = normalizeSpotifyUrl(url);
        if (clean.includes('/embed/playlist/')) {
            return clean + '&view=list&theme=0';
        }
        return clean;
    }

    function isSpotifyPinned() {
        try {
            return String(localStorage.getItem(spotifyPinnedKey) || '0') === '1';
        } catch (e) {
            return false;
        }
    }

    function setSpotifyPinned(value) {
        try {
            localStorage.setItem(spotifyPinnedKey, value ? '1' : '0');
        } catch (e) {}
