<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Prevent caching during development -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">

    <title>{% block title %}RLIFE{% endblock %} | RLIFE</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%234F46E5'/%3E%3Cstop offset='100%25' stop-color='%234338CA'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='8' fill='url(%23g)'/%3E%3Cpath d='M8 10h16M8 16h12M8 22h8' stroke='white' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Three.js pour le rendu 3D du pet -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.168.0/build/three.min.js"></script>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {{ encore_entry_script_tags('app') }}

    <!-- Theme + Icons init -->
    <script>
        (function() {
            var theme = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (theme === 'dark' || (!theme && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
            window.toggleTheme = function() {
                var html = document.documentElement;
                if (html.classList.contains('dark')) {
                    html.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    html.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            };
            window.initIcons = function() {
                if (typeof lucide !== 'undefined') lucide.createIcons();
            };
        })();
    </script>
        <!-- Pet Management Scripts -->
    <script>
        window.RLife3D = window.RLife3D || {};

        window.RLife3D.ensureThree = function(callback) {
            if (typeof THREE !== 'undefined') {
                callback();
                return;
            }

            const existing = document.getElementById('rlife-three-loader');
            if (existing) {
                existing.addEventListener('load', callback, { once: true });
                return;
            }

            const script = document.createElement('script');
            script.id = 'rlife-three-loader';
            script.src = 'https://cdn.jsdelivr.net/npm/three@0.168.0/build/three.min.js';
            script.onload = callback;
            script.onerror = function() {
                const fallback = document.createElement('script');
                fallback.src = 'https://unpkg.com/three@0.168.0/build/three.min.js';
                fallback.onload = callback;
                fallback.onerror = callback;
                document.head.appendChild(fallback);
            };
            document.head.appendChild(script);
        };

        window.RLife3D.dispose = function(container) {
            const state = container?._rlife3d;
            if (!state) return;

            state.isAlive = false;
            if (state.resizeObserver) state.resizeObserver.disconnect();

            if (state.renderer) {
                state.renderer.dispose();
                if (state.renderer.domElement && state.renderer.domElement.parentNode === container) {
                    container.removeChild(state.renderer.domElement);
                }
            }

            delete container._rlife3d;
        };

        window.RLife3D.inferType = function(container, options) {
            const opts = options || {};
            if (opts.type) return String(opts.type).toLowerCase();
            if (container?.dataset?.petType) return String(container.dataset.petType).toLowerCase();
            const id = container?.id || '';
            if (id.startsWith('pet3d-')) return id.replace('pet3d-', '').toLowerCase();
            return 'cat';
        };

        window.RLife3D.renderFallback = function(container, options) {
            window.RLife3D.dispose(container);
            const type = window.RLife3D.inferType(container, options || {});
            const emojiByType = {
                cat: '🐱', dog: '🐶', dragon: '🐉', fox: '🦊', bird: '🐦', hamster: '🐹'
            };
            const emoji = emojiByType[type] || '🐾';

            if (!document.getElementById('rlife-pet-fallback-style')) {
                const st = document.createElement('style');
                st.id = 'rlife-pet-fallback-style';
                st.textContent = '@keyframes rlifePetFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}';
                document.head.appendChild(st);
            }

            container.innerHTML = '<div class="w-full h-full flex items-center justify-center"><div style="font-size:56px; animation: rlifePetFloat 1.7s ease-in-out infinite;">' + emoji + '</div></div>';
            container._rlife3d = { isAlive: true, renderer: null, resizeObserver: null };
        };

        window.RLife3D.createPetModel = function(type, color) {
            const group = new THREE.Group();
            const baseMat = new THREE.MeshStandardMaterial({ color: color, metalness: 0.18, roughness: 0.42 });
            const accentMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, metalness: 0.05, roughness: 0.6 });
            const parts = {};

            if (type === 'cat') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.75, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.52, 24, 24), baseMat);
                head.position.set(0, 0.9, 0.15);
                const earL = new THREE.Mesh(new THREE.ConeGeometry(0.13, 0.28, 16), baseMat);
                const earR = earL.clone();
                earL.position.set(-0.25, 1.35, 0.1); earR.position.set(0.25, 1.35, 0.1);
                const tail = new THREE.Mesh(new THREE.TorusGeometry(0.35, 0.07, 10, 24, Math.PI), baseMat);
                tail.position.set(-0.78, 0.08, 0); tail.rotation.z = 1.2;
                group.add(body, head, earL, earR, tail);
                parts.tail = tail; parts.head = head;
            } else if (type === 'dog') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.78, 28, 28), baseMat); body.scale.set(1.1, 0.9, 1.0);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.5, 24, 24), baseMat); head.position.set(0.1, 0.82, 0.35);
                const earL = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.34, 0.08), baseMat); const earR = earL.clone();
                earL.position.set(-0.22, 1.12, 0.2); earR.position.set(0.33, 1.12, 0.2);
                const muzzle = new THREE.Mesh(new THREE.SphereGeometry(0.2, 16, 16), accentMat); muzzle.position.set(0.2, 0.72, 0.72);
                const tail = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.07, 0.6, 12), baseMat); tail.position.set(-0.9, 0.2, 0); tail.rotation.z = 1.0;
                group.add(body, head, earL, earR, muzzle, tail); parts.tail = tail;
            } else if (type === 'dragon') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.72, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.45, 22, 22), baseMat); head.position.set(0.12, 0.78, 0.35);
                const wingL = new THREE.Mesh(new THREE.ConeGeometry(0.34, 0.8, 3), baseMat);
                const wingR = wingL.clone(); wingL.position.set(-0.58, 0.55, 0.0); wingR.position.set(0.58, 0.55, 0.0);
                wingL.rotation.z = -1.3; wingR.rotation.z = 1.3;
                const spike = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.22, 10), accentMat); spike.position.set(0, 1.28, 0.15);
                group.add(body, head, wingL, wingR, spike); parts.wingL = wingL; parts.wingR = wingR;
            } else if (type === 'fox') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.74, 28, 28), baseMat); body.scale.set(1.12, 0.9, 0.95);
                const head = new THREE.Mesh(new THREE.ConeGeometry(0.42, 0.85, 20), baseMat); head.position.set(0.28, 0.78, 0.4); head.rotation.z = -1.45;
                const tail = new THREE.Mesh(new THREE.ConeGeometry(0.24, 1.1, 16), baseMat); tail.position.set(-0.88, 0.15, 0); tail.rotation.z = 1.35;
                group.add(body, head, tail); parts.tail = tail;
            } else if (type === 'bird') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.68, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.42, 20, 20), baseMat); head.position.set(0, 0.85, 0.28);
                const beak = new THREE.Mesh(new THREE.ConeGeometry(0.09, 0.24, 12), new THREE.MeshStandardMaterial({ color: 0xf59e0b }));
                beak.position.set(0, 0.8, 0.7); beak.rotation.x = Math.PI / 2;
                const wingL = new THREE.Mesh(new THREE.SphereGeometry(0.26, 16, 16), baseMat); const wingR = wingL.clone();
                wingL.position.set(-0.7, 0.2, 0); wingR.position.set(0.7, 0.2, 0);
                group.add(body, head, beak, wingL, wingR); parts.wingL = wingL; parts.wingR = wingR;
            } else {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.78, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.5, 24, 24), baseMat); head.position.set(0, 0.8, 0.25);
                const cheekL = new THREE.Mesh(new THREE.SphereGeometry(0.17, 16, 16), accentMat); const cheekR = cheekL.clone();
                cheekL.position.set(-0.24, 0.63, 0.62); cheekR.position.set(0.24, 0.63, 0.62);
                group.add(body, head, cheekL, cheekR); parts.cheekL = cheekL; parts.cheekR = cheekR;
            }

            return {
                group,
                animate: function(t) {
                    group.position.y = Math.sin(t * 1.8) * 0.05;
                    if (parts.tail) parts.tail.rotation.y = Math.sin(t * 4.5) * 0.35;
                    if (parts.head) parts.head.rotation.y = Math.sin(t * 2.1) * 0.12;
                    if (parts.wingL && parts.wingR) {
                        const flap = Math.sin(t * 7.0) * 0.45;
                        parts.wingL.rotation.y = flap; parts.wingR.rotation.y = -flap;
                    }
                    if (parts.cheekL && parts.cheekR) {
                        const puff = 1 + Math.sin(t * 5.5) * 0.05;
                        parts.cheekL.scale.setScalar(puff); parts.cheekR.scale.setScalar(puff);
                    }
                }
            };
        };

        window.RLife3D.renderPet = function(container, options) {
            if (!container) return;
            const opts = options || {};
            const rect = container.getBoundingClientRect();
            if (rect.width < 8 || rect.height < 8) {
                const retry = Number(opts.__retry || 0);
                if (retry < 20) {
                    window.setTimeout(function() {
                        window.RLife3D.renderPet(container, { ...opts, __retry: retry + 1 });
                    }, 120);
                }
                return;
            }

            if (typeof THREE === 'undefined') {
                window.RLife3D.renderFallback(container, opts);
                return;
            }

            window.RLife3D.dispose(container);
            const hunger = Math.max(0, Math.min(100, Number(opts.hunger ?? container.dataset.hunger ?? 50)));
            const spin = opts.spin || (0.004 + ((hunger / 100) * 0.012));
            const type = window.RLife3D.inferType(container, opts);
            const color = opts.color || (hunger > 70 ? 0xfb7185 : (hunger > 35 ? 0x60a5fa : 0x34d399));
            const w = container.clientWidth > 0 ? container.clientWidth : 220;
            const h = container.clientHeight > 0 ? container.clientHeight : 220;

            try {
                const scene = new THREE.Scene();
                const camera = new THREE.PerspectiveCamera(58, w / h, 0.1, 1000);
                camera.position.z = 4.2;

                const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
                renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
                renderer.setSize(w, h);
                renderer.setClearColor(0x000000, 0);
                if (renderer.outputColorSpace) renderer.outputColorSpace = THREE.SRGBColorSpace;
                if (renderer.toneMapping !== undefined) {
                    renderer.toneMapping = THREE.ACESFilmicToneMapping;
                    renderer.toneMappingExposure = 1.25;
                }
                container.innerHTML = '';
                container.appendChild(renderer.domElement);

                const model = window.RLife3D.createPetModel(type, color);
                scene.add(model.group);

                const hemi = new THREE.HemisphereLight(0xffffff, 0x223344, 0.95);
                const key = new THREE.DirectionalLight(0xffffff, 1.25);
                key.position.set(5, 8, 6);
                const rim = new THREE.PointLight(0xa78bfa, 0.9, 20);
                rim.position.set(-4, -2, 4);
                scene.add(hemi, key, rim);

                const state = { isAlive: true, renderer, resizeObserver: null };

                const animate = function() {
                    if (!state.isAlive) return;
                    requestAnimationFrame(animate);
                    const t = performance.now() / 1000;
                    model.group.rotation.y += spin;
                    model.group.rotation.x = Math.sin(t * 1.7) * 0.05;
                    if (typeof model.animate === 'function') model.animate(t);
                    renderer.render(scene, camera);
                };
                animate();

                const resizeObserver = new ResizeObserver(function() {
                    if (!state.isAlive) return;
                    const rw = container.clientWidth > 0 ? container.clientWidth : 220;
                    const rh = container.clientHeight > 0 ? container.clientHeight : 220;
                    camera.aspect = rw / rh;
                    camera.updateProjectionMatrix();
                    renderer.setSize(rw, rh);
                });
                resizeObserver.observe(container);
                state.resizeObserver = resizeObserver;
                container._rlife3d = state;
            } catch (e) {
                window.RLife3D.renderFallback(container, opts);
            }
        };

        function openPetManagementModal() {
            const modal = document.getElementById('petManagementModal');
            if (modal) {
                modal.classList.remove('hidden');
                initPet3D();
            }
        }
        function closePetManagementModal() {
            const container = document.getElementById('pet3DModal');
            if (container) window.RLife3D.dispose(container);
            document.getElementById('petManagementModal')?.classList.add('hidden');
        }
        function openFeedModal() {
            document.getElementById('feedModal')?.classList.remove('hidden');
        }
        function closeFeedModal() {
            document.getElementById('feedModal')?.classList.add('hidden');
        }
        function toggleRenameSection() {
            document.getElementById('renameSection')?.classList.toggle('hidden');
        }
        function goToChangePetType() {
            window.location.href = "{{ path('app_pet_change_type') }}";
        }
        function goToPetPage() {
            window.location.href = "{{ path('app_pet_manage') }}";
        }

        function initPet3D() {
            const container = document.getElementById('pet3DModal');
            if (!container) return;

            window.RLife3D.ensureThree(function() {
                window.RLife3D.renderPet(container, {
                    type: container.dataset.petType || 'cat',
                    hunger: parseInt(container.dataset.hunger || '50', 10)
                });
            });
        }

        window.RLife3D.autoInitPetScenes = function() {
            const colorByType = {
                cat: 0xf472b6,
                dog: 0x60a5fa,
                dragon: 0xa855f7,
                fox: 0xfb923c,
                bird: 0x4ade80,
                hamster: 0xfbbf24
            };

            const dashboard = document.getElementById('pet-3d-container');
            if (dashboard && !dashboard._rlife3d) {
                window.RLife3D.renderPet(dashboard, {
                    spin: 0.012,
                    hunger: parseInt(dashboard.dataset.hunger || '50', 10),
                    type: dashboard.dataset.petType || 'cat'
                });
            }

            const manage = document.getElementById('petScene');
            if (manage && !manage._rlife3d) {
                window.RLife3D.renderPet(manage, {
                    spin: 0.01,
                    hunger: parseInt(manage.dataset.petHunger || '50', 10),
                    type: manage.dataset.petType || 'cat'
                });
            }

            const previews = document.querySelectorAll('[id^="pet3d-"]');
            previews.forEach(function(container) {
                if (container._rlife3d) return;
                const type = container.id.replace('pet3d-', '');
                window.RLife3D.renderPet(container, {
                    spin: 0.01,
                    type: type,
                    color: colorByType[type] || 0x8b5cf6
                });
            });
        };
    </script>
</head>

<body class="h-full font-sans antialiased bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
<div class="min-h-screen" data-controller="sidebar">

    <!-- ==================== SIDEBAR ==================== -->
    <aside class="fixed left-0 top-0 z-40 h-screen w-64 -translate-x-full lg:translate-x-0 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 transition-transform duration-300 ease-in-out"
           data-sidebar-target="sidebar"
           id="sidebar">

        <!-- Logo -->
        <div class="flex items-center justify-between h-16 px-5 border-b border-slate-100 dark:border-slate-800">
            <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2.5">
                <img src="{{ asset('image/logo0.png') }}" alt="RLIFE Logo" class="w-14 h-14 object-cover">
                <div data-sidebar-target="brandText">
                    <span class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white">RLIFE</span>
                </div>
            </a>
            <button type="button"
                    class="lg:hidden p-2 -mr-2 rounded-lg text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800"
                    data-action="click->sidebar#toggle"
                    aria-label="Close sidebar">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">

            <!-- Main -->
            <div class="mb-6">
                <p class="px-3 mb-2 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider" data-sidebar-target="sectionLabel">Main</p>
                <a href="{{ path('app_dashboard') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="layout-dashboard" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Dashboard</span>
                </a>
                <a href="{{ path('app_courses') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') starts with 'app_courses' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="book-open" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Courses</span>
                </a>
                <a href="{{ path('app_assignments') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') starts with 'app_assignments' and app.request.attributes.get('_route') != 'app_collaboration_assigned_tasks' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="clipboard-check" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Assignments</span>
                    <span class="ml-auto px-2 py-0.5 text-xs font-semibold bg-warning-100 dark:bg-warning-900/30 text-warning-700 dark:text-warning-400 rounded-full" data-sidebar-target="badge">3</span>
                </a>
                <a href="{{ path('app_collaboration_assigned_tasks') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') == 'app_collaboration_assigned_tasks' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="user-check" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Assigned to Me</span>
                </a>
                <a href="{{ path('app_planning') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') starts with 'app_planning' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="calendar-days" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Planning</span>
                </a>
            </div>

            <!-- Study -->
            <div class="mb-6">
                <p class="px-3 mb-2 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider" data-sidebar-target="sectionLabel">Study</p>
                <a href="{{ path('app_revisions') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') starts with 'app_revisions' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="brain" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Revisions</span>
                    {% if is_granted('ROLE_USER') %}
                    <span class="ml-auto px-2 py-0.5 text-xs font-semibold bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-400 rounded-full" data-sidebar-target="badge">{{ deck_count() }}</span>
                    {% endif %}
                </a>
                <a href="{{ path('app_project_index') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') starts with 'app_project' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="users" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Projects</span>
                </a>
            </div>

            <!-- Wellness -->
            <div class="mb-6">
                <p class="px-3 mb-2 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider" data-sidebar-target="sectionLabel">Wellness</p>
                <a href="{{ path('app_wellbeing') }}"
                   class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                          {{ app.request.attributes.get('_route') starts with 'app_wellbeing' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                    <i data-lucide="heart-pulse" class="w-5 h-5 flex-shrink-0"></i>
                    <span data-sidebar-target="navText">Wellbeing</span>
                </a>
            </div>

            <!-- Pet Card -->
            {% if app.user %}
            <div class="mx-0 mt-2 mb-4">
                <div onclick="openPetManagementModal()"
                     class="flex items-center gap-3 px-4 py-3.5 bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/30 dark:to-pink-900/30 rounded-2xl border border-purple-200 dark:border-purple-700 cursor-pointer hover:shadow-xl transition-all group">
                    <div class="w-11 h-11 rounded-2xl bg-white dark:bg-slate-800 shadow-inner flex items-center justify-center text-2xl flex-shrink-0">
                        {% if app.user.mainPet %}
                            {% if app.user.mainPet.type == 'cat' %}🐱
                            {% elseif app.user.mainPet.type == 'dog' %}🐶
                            {% elseif app.user.mainPet.type == 'dragon' %}🐉
                            {% elseif app.user.mainPet.type == 'fox' %}🦊
                            {% else %}🐾{% endif %}
                        {% else %}🐾{% endif %}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-purple-700 dark:text-purple-300 text-sm group-hover:text-purple-600 transition-colors truncate">
                            {% if app.user.mainPet %}{{ app.user.mainPet.name }}{% else %}Choose My Pet{% endif %}
                        </p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 truncate">
                            {% if app.user.mainPet %}
                                Lv. {{ app.user.mainPet.level }} • {{ app.user.mainPet.getMood() }}
                            {% else %}
                                No companion yet
                            {% endif %}
                        </p>
                    </div>
                    <div class="text-right flex-shrink-0">
                        <p class="text-sm font-bold text-purple-600 dark:text-purple-400">{{ app.user.coins }} 🪙</p>
                    </div>
                </div>
            </div>
            {% endif %}

        </nav>

        <!-- Sidebar Footer -->
        <div class="p-3 border-t border-slate-100 dark:border-slate-800">
            <a href="{{ path('app_settings') }}"
               class="flex items-center gap-3 px-3 py-2.5 text-sm font-medium rounded-xl transition-all
                      {{ app.request.attributes.get('_route') starts with 'app_settings' ? 'bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 shadow-sm' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' }}">
                <i data-lucide="settings" class="w-5 h-5 flex-shrink-0"></i>
                <span data-sidebar-target="navText">Settings</span>
            </a>
            <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-800/50 rounded-xl" data-sidebar-target="userCard">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-sm shadow-sm overflow-hidden">
                        {% if app.user and app.user.profilePic %}
                            <img src="{% if app.user.profilePic starts with 'http' %}{{ app.user.profilePic }}{% else %}{{ asset('uploads/profiles/' ~ app.user.profilePic) }}{% endif %}" alt="Profile" class="w-full h-full object-cover">
                        {% else %}
                            {{ app.user ? app.user.firstName|first|upper ~ app.user.lastName|first|upper : 'U' }}
                        {% endif %}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-slate-900 dark:text-white truncate">{{ app.user ? app.user.fullName : 'User' }}</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">{{ app.user and app.user.isAdmin ? 'Administrator' : 'Student' }}</p>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Sidebar backdrop (mobile) -->
    <div class="fixed inset-0 z-30 bg-slate-900/50 backdrop-blur-sm lg:hidden hidden"
         data-sidebar-target="backdrop"
         data-action="click->sidebar#close"></div>

    <!-- ==================== MAIN CONTENT ==================== -->
    <div class="lg:ml-64 min-h-screen flex flex-col">

        <!-- Top Bar -->
        <header class="sticky top-0 z-20 h-16 px-4 lg:px-6 bg-white/80 dark:bg-slate-900/80 backdrop-blur-lg border-b border-slate-200/50 dark:border-slate-800/50">
            <div class="flex items-center justify-between gap-4 h-full">

                <!-- Left: mobile menu + search -->
                <div class="flex items-center gap-4">
                    <button type="button"
                            class="lg:hidden p-2 -ml-2 rounded-xl text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                            data-action="click->sidebar#toggle"
                            aria-label="Open menu">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>
                    <div class="relative hidden sm:block" id="globalSearch">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none z-10"></i>
                        <input type="search"
                               id="searchInput"
                               placeholder="Search courses, projects, assignments..."
                               autocomplete="off"
                               class="w-64 lg:w-80 pl-10 pr-4 py-2 text-sm bg-slate-100 dark:bg-slate-800 border-0 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 transition-all">
                        <div id="searchResults" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-xl max-h-96 overflow-y-auto hidden z-50"></div>
                    </div>
                </div>

                <!-- Right: actions -->
                <div class="flex items-center gap-2">

                    <!-- Quick Add -->
                    <div class="relative" data-controller="dropdown">
                        <button type="button"
                                class="inline-flex items-center gap-2 px-3 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl shadow-sm shadow-primary-500/25 transition-all"
                                data-action="click->dropdown#toggle">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span class="hidden sm:inline">New</span>
                        </button>
                        <div class="absolute right-0 top-full mt-2 w-56 p-2 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg hidden"
                             data-dropdown-target="menu">
                            <a href="{{ path('app_assignments') }}?action=new" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                <i data-lucide="clipboard-plus" class="w-4 h-4 text-primary-500"></i> New Assignment
                            </a>
                            <a href="{{ path('app_planning') }}?action=new" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                <i data-lucide="calendar-plus" class="w-4 h-4 text-accent-500"></i> New Event
                            </a>
                            <a href="{{ path('app_revisions') }}?action=new" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                <i data-lucide="layers-2" class="w-4 h-4 text-success-500"></i> New Flashcard Deck
                            </a>
                            <a href="{{ path('app_courses') }}?action=new" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                <i data-lucide="book-plus" class="w-4 h-4 text-secondary-500"></i> New Course
                            </a>
                        </div>
                    </div>

                    <!-- ==================== NOTIFICATIONS ==================== -->
                    <div class="relative" data-controller="dropdown">

                        {# Compute unread count server-side #}
                        {% set unreadCount = 0 %}
                        {% if app.user and app.user.notifications is defined %}
                            {% set unreadCount = app.user.notifications|filter(n => not n.isRead)|length %}
                        {% endif %}

                        <button type="button"
                                class="relative p-2 rounded-xl text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                data-action="click->dropdown#toggle"
                                aria-label="Notifications">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                            {# Badge: visible only when unread > 0 #}
                            <span id="notification-badge"
                                  class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center px-1 leading-none transition-all
                                         {{ unreadCount == 0 ? 'hidden' : '' }}">
                                {{ unreadCount > 0 ? unreadCount : '' }}
                            </span>
                        </button>

                        <!-- Notifications Dropdown -->
                        <div class="absolute right-0 top-full mt-2 w-80 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg hidden overflow-hidden"
                             data-dropdown-target="menu">

                            <!-- Header -->
                            <div class="px-4 py-3.5 border-b dark:border-slate-700 sticky top-0 bg-white dark:bg-slate-900 z-10 flex items-center justify-between">
                                <h3 class="font-semibold text-slate-900 dark:text-white">Notifications</h3>
                                {% if unreadCount > 0 %}
                                <span class="text-xs font-semibold bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400 px-2 py-0.5 rounded-full">
                                    {{ unreadCount }} non lue{{ unreadCount > 1 ? 's' : '' }}
                                </span>
                                {% endif %}
                            </div>

                            <!-- List -->
                            <div class="max-h-72 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-700/50">
                                {% if app.user and app.user.notifications is defined %}
                                    {% set notifications = app.user.notifications|slice(0, 10) %}
                                    {% if notifications|length > 0 %}
                                        {% for notif in notifications %}
                                        <a href="{{ notif.link ?: '#' }}"
                                           class="block p-4 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors {{ not notif.isRead ? 'bg-indigo-50/50 dark:bg-indigo-950/30' : '' }}"
                                           data-notification-id="{{ notif.id }}"
                                           onclick="markAsRead({{ notif.id }}); return false;">
                                            <div class="flex items-start gap-3">
                                                <!-- Icon -->
                                                <div class="w-9 h-9 rounded-full flex items-center justify-center text-lg flex-shrink-0
                                                    {{ notif.type == 'coins' ? 'bg-amber-100 dark:bg-amber-900/40' :
                                                       notif.type starts with 'deadline' ? 'bg-red-100 dark:bg-red-900/40' :
                                                       notif.type == 'project_shared' or notif.type == 'task_assigned' ? 'bg-blue-100 dark:bg-blue-900/40' :
                                                       notif.type == 'new_comment' ? 'bg-green-100 dark:bg-green-900/40' :
                                                       'bg-slate-100 dark:bg-slate-800' }}">
                                                    {% if notif.type == 'coins' %}🪙
                                                    {% elseif notif.type starts with 'deadline' %}⏰
                                                    {% elseif notif.type == 'project_shared' %}🔗
                                                    {% elseif notif.type == 'task_assigned' %}📋
                                                    {% elseif notif.type == 'new_comment' %}💬
                                                    {% else %}🔔{% endif %}
                                                </div>
                                                <!-- Text -->
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm font-semibold text-slate-900 dark:text-white line-clamp-1">{{ notif.title }}</p>
                                                    <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-0.5">{{ notif.message }}</p>
                                                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">{{ notif.createdAt|date('d/m/Y H:i') }}</p>
                                                </div>
                                                <!-- Unread dot -->
                                                {% if not notif.isRead %}
                                                <div class="w-2 h-2 rounded-full bg-indigo-500 flex-shrink-0 mt-1.5"></div>
                                                {% endif %}
                                            </div>
                                        </a>
                                        {% endfor %}
                                    {% else %}
                                        <div class="py-10 text-center text-slate-400 dark:text-slate-500">
                                            <i data-lucide="bell-off" class="w-10 h-10 mx-auto mb-3 opacity-40"></i>
                                            <p class="text-sm">Aucune nouvelle notification</p>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <div class="py-10 text-center text-slate-400 dark:text-slate-500">
                                        <i data-lucide="bell-off" class="w-10 h-10 mx-auto mb-3 opacity-40"></i>
                                        <p class="text-sm">Aucune nouvelle notification</p>
                                    </div>
                                {% endif %}
                            </div>

                            <!-- Footer -->
                            <div class="px-4 py-3 border-t dark:border-slate-700 text-center sticky bottom-0 bg-white dark:bg-slate-900 z-10">
                                <a href="{{ path('app_notifications_list') }}"
                                   class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline font-medium">
                                    Voir toutes les notifications →
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- ==================== END NOTIFICATIONS ==================== -->

                    <!-- Theme Toggle -->
                    <button type="button"
                            class="p-2 rounded-xl text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                            onclick="toggleTheme()"
                            aria-label="Toggle theme">
                        <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                        <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                    </button>

                    <!-- Profile -->
                    <div class="relative" data-controller="dropdown">
                        <button type="button"
                                class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                data-action="click->dropdown#toggle">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-sm overflow-hidden">
                                {% if app.user and app.user.profilePic %}
                                    <img src="{% if app.user.profilePic starts with 'http' %}{{ app.user.profilePic }}{% else %}{{ asset('uploads/profiles/' ~ app.user.profilePic) }}{% endif %}" alt="Profile" class="w-full h-full object-cover">
                                {% else %}
                                    {{ app.user ? app.user.firstName|first|upper ~ app.user.lastName|first|upper : 'U' }}
                                {% endif %}
                            </div>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 hidden sm:block"></i>
                        </button>
                        <div class="absolute right-0 top-full mt-2 w-56 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg hidden"
                             data-dropdown-target="menu">
                            <div class="p-4 border-b border-slate-100 dark:border-slate-700">
                                <p class="font-semibold text-slate-900 dark:text-white">{{ app.user ? app.user.fullName : 'User' }}</p>
                                <p class="text-sm text-slate-500 dark:text-slate-400">{{ app.user ? app.user.email : '' }}</p>
                            </div>
                            <div class="p-2">
                                <a href="{{ path('app_settings') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                    <i data-lucide="user" class="w-4 h-4"></i> Profile Settings
                                </a>
                                <a href="#" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                    <i data-lucide="help-circle" class="w-4 h-4"></i> Help & Support
                                </a>
                                <div class="h-px bg-slate-100 dark:bg-slate-700 my-2"></div>
                                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm text-danger-600 dark:text-danger-400 hover:bg-danger-50 dark:hover:bg-danger-900/20 rounded-lg transition-colors">
                                    <i data-lucide="log-out" class="w-4 h-4"></i> Sign Out
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 p-4 lg:p-6">
            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<!-- ==================== TOAST CONTAINER ==================== -->
<div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2" data-controller="toast">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="toast flex items-center gap-3 px-4 py-3 rounded-xl shadow-lg animate-fade-in-up cursor-pointer
                {{ label == 'success' ? 'bg-success-500 text-white' :
                   (label == 'error' or label == 'danger') ? 'bg-danger-500 text-white' :
                   label == 'warning' ? 'bg-warning-500 text-white' :
                   'bg-primary-500 text-white' }}"
                data-toast-target="toast"
                data-action="click->toast#dismiss">
                {% if label == 'success' %}<i data-lucide="check-circle" class="w-5 h-5"></i>
                {% elseif label == 'error' or label == 'danger' %}<i data-lucide="x-circle" class="w-5 h-5"></i>
                {% elseif label == 'warning' %}<i data-lucide="alert-triangle" class="w-5 h-5"></i>
                {% else %}<i data-lucide="info" class="w-5 h-5"></i>{% endif %}
                <span class="font-medium">{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<!-- ==================== PET MANAGEMENT MODAL ==================== -->
{% if app.user %}
<div id="petManagementModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-xl z-[100] flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 w-full max-w-md rounded-3xl shadow-2xl overflow-hidden border border-purple-200/30 dark:border-purple-800/30">

        <!-- Header -->
        <div class="px-6 py-5 border-b dark:border-slate-700 bg-gradient-to-r from-purple-50/80 to-pink-50/80 dark:from-purple-950/40 dark:to-pink-950/40 flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold text-purple-700 dark:text-purple-300">
                    {{ app.user.mainPet ? app.user.mainPet.name : 'My Companion' }}
                </h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">
                    {% if app.user.mainPet %}Lv. {{ app.user.mainPet.level }} • {{ app.user.mainPet.getMood() }}
                    {% else %}No companion adopted{% endif %}
                </p>
            </div>
            <button onclick="closePetManagementModal()" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                <i data-lucide="x" class="w-6 h-6 text-slate-500 dark:text-slate-400"></i>
            </button>
        </div>

        <div class="p-6 max-h-[80vh] overflow-y-auto">
            {% if app.user.mainPet %}

                <!-- 3D Viewer -->
                <div id="pet3DModal"
                     data-pet-type="{{ app.user.mainPet.type }}"
                     data-hunger="{{ app.user.mainPet.hunger }}"
                     class="w-full aspect-square bg-gradient-to-br from-purple-100/40 to-pink-100/40 dark:from-purple-900/30 dark:to-pink-900/30 rounded-2xl mb-6 shadow-inner overflow-hidden">
                </div>

                <!-- Stats -->
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="bg-slate-50 dark:bg-slate-800/60 p-4 rounded-2xl text-center">
                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">Hunger</p>
                        <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2.5 mb-2">
                            <div class="bg-gradient-to-r from-green-400 via-yellow-400 to-red-500 h-2.5 rounded-full transition-all duration-700"
                                 style="width: {{ 100 - app.user.mainPet.hunger }}%"></div>
                        </div>
                        <p class="text-lg font-bold text-slate-800 dark:text-white">{{ app.user.mainPet.hunger }}/100</p>
                    </div>
                    <div class="bg-slate-50 dark:bg-slate-800/60 p-4 rounded-2xl text-center">
                        <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">Coins</p>
                        <p class="text-2xl font-bold text-purple-600 dark:text-purple-400">{{ app.user.coins }} 🪙</p>
                    </div>
                </div>

                <!-- Actions -->
                <div class="space-y-3">
                    <button onclick="openFeedModal()"
                            class="w-full py-3.5 px-5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold rounded-2xl shadow-md transition-all flex items-center justify-center gap-2.5">
                        <span class="text-xl">🍎</span> Feed
                    </button>
                    <button onclick="toggleRenameSection()"
                            class="w-full py-3.5 px-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-semibold rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-700 transition flex items-center justify-center gap-2.5">
                        <span class="text-xl">✏️</span> Rename
                    </button>
                    <button onclick="goToChangePetType()"
                            class="w-full py-3.5 px-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-semibold rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-700 transition flex items-center justify-center gap-2.5">
                        <span class="text-xl">🔄</span> Change Companion Type
                    </button>
                    <button onclick="goToPetPage()"
                            class="w-full py-3.5 px-5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-semibold rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-700 transition flex items-center justify-center gap-2.5">
                        <span class="text-xl">🧭</span> Open Pet Page
                    </button>
                </div>

                <!-- Rename section (hidden by default) -->
                <div id="renameSection" class="hidden mt-5 pt-5 border-t dark:border-slate-700">
                    <form method="post" action="{{ path('app_pet_rename') }}" class="flex gap-3">
                        <input type="text" name="name" value="{{ app.user.mainPet.name }}" required minlength="2" maxlength="25"
                               class="flex-1 px-4 py-3 bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-400 text-slate-900 dark:text-white">
                        <button type="submit"
                                class="px-6 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-xl transition">
                            OK
                        </button>
                    </form>
                </div>

            {% else %}
                <div class="text-center py-12">
                    <div class="text-7xl mb-5">🐾</div>
                    <h3 class="text-xl font-semibold mb-3 text-slate-800 dark:text-white">No companion for now</h3>
