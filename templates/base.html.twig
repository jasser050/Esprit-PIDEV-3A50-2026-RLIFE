        window.RLife3D.createPetModel = function(type, color) {
            const group = new THREE.Group();
            const baseMat = new THREE.MeshStandardMaterial({ color: color, metalness: 0.18, roughness: 0.42 });
            const accentMat = new THREE.MeshStandardMaterial({ color: 0xf8fafc, metalness: 0.05, roughness: 0.6 });
            const eyeMat = new THREE.MeshStandardMaterial({ color: 0x0b1020, metalness: 0.15, roughness: 0.35 });
            const parts = {};
            parts.legs = [];

            const addLeg = function(x, y, z, len, radius) {
                const leg = new THREE.Mesh(new THREE.CapsuleGeometry(radius, len, 3, 8), baseMat);
                leg.position.set(x, y, z);
                group.add(leg);
                parts.legs.push(leg);
                return leg;
            };

            const addEyes = function(leftPos, rightPos, scale = 1) {
                const eyeGeom = new THREE.SphereGeometry(0.065 * scale, 12, 12);
                const eyeL = new THREE.Mesh(eyeGeom, eyeMat);
                const eyeR = new THREE.Mesh(eyeGeom, eyeMat);
                eyeL.position.copy(leftPos);
                eyeR.position.copy(rightPos);
                group.add(eyeL, eyeR);
                parts.eyeL = eyeL;
                parts.eyeR = eyeR;
            };

            if (type === 'cat') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.75, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.52, 24, 24), baseMat);
                head.position.set(0, 0.9, 0.15);
                const earL = new THREE.Mesh(new THREE.ConeGeometry(0.13, 0.28, 16), baseMat);
                const earR = earL.clone();
                earL.position.set(-0.25, 1.35, 0.1);
                earR.position.set(0.25, 1.35, 0.1);
                const tail = new THREE.Mesh(new THREE.TorusGeometry(0.35, 0.07, 10, 24, Math.PI), baseMat);
                tail.position.set(-0.78, 0.08, 0);
                tail.rotation.z = 1.2;
                group.add(body, head, earL, earR, tail);
                addLeg(-0.35, -0.42, 0.33, 0.36, 0.06);
                addLeg(0.35, -0.42, 0.33, 0.36, 0.06);
                addLeg(-0.35, -0.42, -0.33, 0.36, 0.06);
                addLeg(0.35, -0.42, -0.33, 0.36, 0.06);
                addEyes(new THREE.Vector3(-0.15, 0.95, 0.61), new THREE.Vector3(0.15, 0.95, 0.61));
                parts.tail = tail;
                parts.head = head;
            } else if (type === 'dog') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.78, 28, 28), baseMat); body.scale.set(1.1, 0.9, 1.0);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.5, 24, 24), baseMat); head.position.set(0.1, 0.82, 0.35);
                const earL = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.34, 0.08), baseMat); const earR = earL.clone();
                earL.position.set(-0.22, 1.12, 0.2); earR.position.set(0.33, 1.12, 0.2);
                const muzzle = new THREE.Mesh(new THREE.SphereGeometry(0.2, 16, 16), accentMat); muzzle.position.set(0.2, 0.72, 0.72);
                const tail = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.07, 0.6, 12), baseMat); tail.position.set(-0.9, 0.2, 0); tail.rotation.z = 1.0;
                group.add(body, head, earL, earR, muzzle, tail); parts.tail = tail;
                addLeg(-0.38, -0.42, 0.32, 0.4, 0.065);
                addLeg(0.38, -0.42, 0.32, 0.4, 0.065);
                addLeg(-0.38, -0.42, -0.32, 0.4, 0.065);
                addLeg(0.38, -0.42, -0.32, 0.4, 0.065);
                addEyes(new THREE.Vector3(-0.02, 0.86, 0.72), new THREE.Vector3(0.27, 0.86, 0.72), 1.05);
            } else if (type === 'dragon') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.72, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.45, 22, 22), baseMat); head.position.set(0.12, 0.78, 0.35);
                const wingL = new THREE.Mesh(new THREE.ConeGeometry(0.34, 0.8, 3), baseMat);
                const wingR = wingL.clone(); wingL.position.set(-0.58, 0.55, 0.0); wingR.position.set(0.58, 0.55, 0.0);
                wingL.rotation.z = -1.3; wingR.rotation.z = 1.3;
                const spike = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.22, 10), accentMat); spike.position.set(0, 1.28, 0.15);
                group.add(body, head, wingL, wingR, spike); parts.wingL = wingL; parts.wingR = wingR;
                addLeg(-0.25, -0.35, 0.26, 0.3, 0.055);
                addLeg(0.25, -0.35, 0.26, 0.3, 0.055);
                addEyes(new THREE.Vector3(-0.03, 0.86, 0.69), new THREE.Vector3(0.21, 0.86, 0.69), 0.95);
            } else if (type === 'fox') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.74, 28, 28), baseMat); body.scale.set(1.12, 0.9, 0.95);
                const head = new THREE.Mesh(new THREE.ConeGeometry(0.42, 0.85, 20), baseMat); head.position.set(0.28, 0.78, 0.4); head.rotation.z = -1.45;
                const tail = new THREE.Mesh(new THREE.ConeGeometry(0.24, 1.1, 16), baseMat); tail.position.set(-0.88, 0.15, 0); tail.rotation.z = 1.35;
                group.add(body, head, tail); parts.tail = tail;
                addLeg(-0.34, -0.42, 0.3, 0.37, 0.06);
                addLeg(0.34, -0.42, 0.3, 0.37, 0.06);
                addLeg(-0.34, -0.42, -0.3, 0.37, 0.06);
                addLeg(0.34, -0.42, -0.3, 0.37, 0.06);
                addEyes(new THREE.Vector3(0.15, 0.9, 0.66), new THREE.Vector3(0.35, 0.9, 0.66), 0.95);
            } else if (type === 'bird') {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.68, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.42, 20, 20), baseMat); head.position.set(0, 0.85, 0.28);
                const beak = new THREE.Mesh(new THREE.ConeGeometry(0.09, 0.24, 12), new THREE.MeshStandardMaterial({ color: 0xf59e0b }));
                beak.position.set(0, 0.8, 0.7); beak.rotation.x = Math.PI / 2;
                const wingL = new THREE.Mesh(new THREE.SphereGeometry(0.26, 16, 16), baseMat); const wingR = wingL.clone();
                wingL.position.set(-0.7, 0.2, 0); wingR.position.set(0.7, 0.2, 0);
                group.add(body, head, beak, wingL, wingR); parts.wingL = wingL; parts.wingR = wingR;
                addEyes(new THREE.Vector3(-0.1, 0.95, 0.62), new THREE.Vector3(0.1, 0.95, 0.62), 0.85);
            } else {
                const body = new THREE.Mesh(new THREE.SphereGeometry(0.78, 28, 28), baseMat);
                const head = new THREE.Mesh(new THREE.SphereGeometry(0.5, 24, 24), baseMat); head.position.set(0, 0.8, 0.25);
                const cheekL = new THREE.Mesh(new THREE.SphereGeometry(0.17, 16, 16), accentMat); const cheekR = cheekL.clone();
                cheekL.position.set(-0.24, 0.63, 0.62); cheekR.position.set(0.24, 0.63, 0.62);
                group.add(body, head, cheekL, cheekR); parts.cheekL = cheekL; parts.cheekR = cheekR;
                addLeg(-0.32, -0.44, 0.3, 0.34, 0.06);
                addLeg(0.32, -0.44, 0.3, 0.34, 0.06);
                addLeg(-0.32, -0.44, -0.3, 0.34, 0.06);
                addLeg(0.32, -0.44, -0.3, 0.34, 0.06);
                addEyes(new THREE.Vector3(-0.12, 0.85, 0.66), new THREE.Vector3(0.12, 0.85, 0.66), 0.95);
            }

            return {
                group,
                animate: function(t, motion) {
                    const m = motion || {};
                    const stride = Number(m.stride || 0);
                    const activity = Number(m.activity || 0.2);
                    const blink = Math.max(0, Math.min(1, Number(m.blink || 0)));

                    if (parts.tail) parts.tail.rotation.y = Math.sin(t * (4.0 + activity * 2.8)) * (0.25 + activity * 0.28);
                    if (parts.head) parts.head.rotation.y = Math.sin(t * 1.7) * (0.06 + activity * 0.09);
                    if (parts.wingL && parts.wingR) {
                        const flap = Math.sin(t * (5.6 + activity * 4.2)) * (0.28 + activity * 0.34);
                        parts.wingL.rotation.y = flap; parts.wingR.rotation.y = -flap;
                    }
                    if (parts.cheekL && parts.cheekR) {
                        const puff = 1 + Math.sin(t * 5.5) * 0.05;
                        parts.cheekL.scale.setScalar(puff); parts.cheekR.scale.setScalar(puff);
                    }
                    if (parts.legs.length >= 2) {
                        const gait = Math.sin(t * 7.2) * stride;
                        parts.legs.forEach(function(leg, idx) {
                            const dir = idx % 2 === 0 ? 1 : -1;
                            leg.rotation.x = gait * dir;
                            leg.position.y = -0.42 + Math.abs(gait) * 0.04;
                        });
                    }
                    if (parts.eyeL && parts.eyeR) {
                        const eyeOpen = Math.max(0.15, 1 - blink);
                        parts.eyeL.scale.y = eyeOpen;
                        parts.eyeR.scale.y = eyeOpen;
                    }
                }
            };
        };

        window.RLife3D.queueRenderWhenVisible = function(container, options) {
            if (!container) return;
            if (container._rlife3dPending) return;

            const opts = options || {};
            const pending = { tries: 0, timer: null };
            container._rlife3dPending = pending;

            const cleanup = function() {
                if (pending.timer) window.clearTimeout(pending.timer);
                if (container._rlife3dPending === pending) delete container._rlife3dPending;
            };

            const tick = function() {
                if (!document.body.contains(container)) {
                    cleanup();
                    return;
                }

                const rect = container.getBoundingClientRect();
                if (rect.width >= 8 && rect.height >= 8) {
                    cleanup();
                    window.RLife3D.renderPet(container, { ...opts, __retry: 0, __waitedVisible: true });
                    return;
                }

                pending.tries += 1;
                if (pending.tries > 240) {
                    cleanup();
                    window.RLife3D.renderFallback(container, opts);
                    return;
                }

                pending.timer = window.setTimeout(tick, 100);
            };

            tick();
        };

        window.RLife3D.createCityEnvironment = function(scene, options) {
            const opts = options || {};
            const density = Math.max(0.4, Math.min(1.4, Number(opts.cityBlockDensity ?? 1)));
            const cityTime = String(opts.cityTime || 'day').toLowerCase();
            const trafficLevel = Math.max(0.05, Math.min(1, Number(opts.cityTraffic ?? 0.38)));
            const tint = Number(opts.cityTint ?? 0x22d3ee);

            const palettes = {
                day: { ground: 0x8b9fb3, road: 0x2c3440, lane: 0xf8fafc, buildingA: 0xc8d4e4, buildingB: 0xa7bbd2, glow: 0xdbeafe },
                dawn: { ground: 0x7c8ea2, road: 0x222831, lane: 0xe2e8f0, buildingA: 0xb3bfd0, buildingB: 0x8da2bd, glow: 0xf1f5f9 },
                sunset: { ground: 0x8b7a6d, road: 0x31261f, lane: 0xffedd5, buildingA: 0xd0a78f, buildingB: 0xb1836f, glow: 0xfdba74 },
                night: { ground: 0x1f2937, road: 0x0f172a, lane: 0xe2e8f0, buildingA: 0x334155, buildingB: 0x475569, glow: 0xbfdbfe }
            };
            const palette = palettes[cityTime] || palettes.day;

            const group = new THREE.Group();
            const dynamic = [];
            scene.add(group);

            const ground = new THREE.Mesh(
                new THREE.CircleGeometry(6.8, 48),
                new THREE.MeshStandardMaterial({ color: palette.ground, roughness: 0.96, metalness: 0.05 })
            );
            ground.rotation.x = -Math.PI / 2;
            ground.position.y = -0.82;
            group.add(ground);

            const road = new THREE.Mesh(
                new THREE.RingGeometry(2.2, 3.35, 44),
                new THREE.MeshStandardMaterial({ color: palette.road, roughness: 0.78, metalness: 0.12 })
            );
            road.rotation.x = -Math.PI / 2;
            road.position.y = -0.79;
            group.add(road);

            for (let i = 0; i < 12; i++) {
                const angle = (Math.PI * 2 * i) / 12;
                const laneMark = new THREE.Mesh(
                    new THREE.BoxGeometry(0.18, 0.01, 0.06),
                    new THREE.MeshStandardMaterial({ color: palette.lane, roughness: 0.46, metalness: 0.1 })
                );
                laneMark.position.set(Math.cos(angle) * 2.75, -0.775, Math.sin(angle) * 2.75);
                laneMark.rotation.y = -angle;
                group.add(laneMark);
            }

            const buildingCount = Math.max(8, Math.round(14 * density));
            for (let i = 0; i < buildingCount; i++) {
                const angle = (Math.PI * 2 * i) / buildingCount;
                const radius = 4.1 + ((i % 3) * 0.42);
                const h = 0.75 + ((i % 5) * 0.36) + (Math.random() * 0.22);
                const w = 0.36 + ((i % 4) * 0.08);
                const d = 0.34 + ((i % 3) * 0.07);
                const color = (i % 2 === 0) ? palette.buildingA : palette.buildingB;
                const tower = new THREE.Mesh(
                    new THREE.BoxGeometry(w, h, d),
                    new THREE.MeshStandardMaterial({ color: color, roughness: 0.82, metalness: 0.08 })
                );
                tower.position.set(Math.cos(angle) * radius, -0.82 + (h / 2), Math.sin(angle) * radius);
                tower.lookAt(0, tower.position.y, 0);
                group.add(tower);
            }

            const lampCount = Math.max(6, Math.round(10 * density));
            for (let i = 0; i < lampCount; i++) {
                const angle = (Math.PI * 2 * i) / lampCount;
                const pole = new THREE.Mesh(
                    new THREE.CylinderGeometry(0.015, 0.02, 0.45, 8),
                    new THREE.MeshStandardMaterial({ color: 0x94a3b8, roughness: 0.55, metalness: 0.38 })
                );
                pole.position.set(Math.cos(angle) * 3.5, -0.58, Math.sin(angle) * 3.5);
                group.add(pole);

                const lamp = new THREE.Mesh(
                    new THREE.SphereGeometry(0.045, 10, 10),
                    new THREE.MeshStandardMaterial({ color: palette.glow, emissive: tint, emissiveIntensity: 0.45, roughness: 0.2, metalness: 0.12 })
                );
                lamp.position.set(pole.position.x, -0.34, pole.position.z);
                group.add(lamp);
            }

            const carCount = Math.max(2, Math.round((cityTime === 'night' ? 4 : 6) * trafficLevel));
            for (let i = 0; i < carCount; i++) {
                const car = new THREE.Mesh(
                    new THREE.BoxGeometry(0.14, 0.09, 0.24),
                    new THREE.MeshStandardMaterial({ color: (i % 2 ? 0xf59e0b : tint), roughness: 0.4, metalness: 0.2 })
                );
                car.userData.angle = (Math.PI * 2 * i) / carCount;
                car.userData.speed = 0.22 + (0.14 * trafficLevel) + (i % 3) * 0.04;
                car.userData.radius = 2.75 + (i % 2) * 0.22;
                car.position.y = -0.72;
                group.add(car);
                dynamic.push(car);
            }

            return {
                group: group,
                update: function(t, dt) {
                    const elapsed = Number(t || 0);
                    const frame = Number(dt || 0.016);
                    dynamic.forEach(function(car, idx) {
                        car.userData.angle += car.userData.speed * frame;
                        const a = car.userData.angle;
                        const r = car.userData.radius;
                        car.position.x = Math.cos(a) * r;
                        car.position.z = Math.sin(a) * r;
                        car.rotation.y = -a + Math.PI / 2;
                        car.position.y = -0.72 + Math.sin((elapsed * 5.2) + idx) * 0.005;
                    });
                },
                dispose: function() {
                    scene.remove(group);
                }
            };
        };

        window.RLife3D.renderPet = function(container, options) {
            if (!container) return;
            const opts = options || {};
            if (window.RLife3D.enable3D !== true) {
                window.RLife3D.renderFallback(container, opts);
                return;
            }
            const rect = container.getBoundingClientRect();
            if (rect.width < 8 || rect.height < 8) {
                window.RLife3D.queueRenderWhenVisible(container, opts);
                return;
            }

            if (typeof THREE === 'undefined') {
                window.RLife3D.renderFallback(container, opts);
                return;
            }

            window.RLife3D.dispose(container);
            const hunger = Math.max(0, Math.min(100, Number(opts.hunger ?? container.dataset.hunger ?? 50)));
            const spin = opts.spin || (0.004 + ((hunger / 100) * 0.012));
            const type = window.RLife3D.inferType(container, opts);
            const environment = String(opts.environment || 'none').toLowerCase();
            const color = opts.color || (hunger > 70 ? 0xfb7185 : (hunger > 35 ? 0x60a5fa : 0x34d399));
            const behavior = {
                bobAmp: Math.max(0, Number(opts.bobAmp ?? 0.05)),
                bobSpeed: Math.max(0.2, Number(opts.bobSpeed ?? 1.7)),
                tiltAmp: Math.max(0, Number(opts.tiltAmp ?? 0.03)),
                driftAmp: Math.max(0, Number(opts.driftAmp ?? 0)),
                driftSpeed: Math.max(0, Number(opts.driftSpeed ?? 0.8)),
                hoverAmp: Math.max(0, Number(opts.hoverAmp ?? 0)),
                hoverSpeed: Math.max(0.2, Number(opts.hoverSpeed ?? 1.4)),
                burstMultiplier: Math.max(1, Number(opts.burstMultiplier ?? 2.2)),
                burstDurationMs: Math.max(0, Number(opts.burstDurationMs ?? 750)),
                burstEveryMinMs: Math.max(1000, Number(opts.burstEveryMinMs ?? 4200)),
                burstEveryMaxMs: Math.max(1200, Number(opts.burstEveryMaxMs ?? 8600)),
                wander: Boolean(opts.wander ?? false),
                arenaRadius: Math.max(0.16, Number(opts.arenaRadius ?? 0.68)),
                baseMoveSpeed: Math.max(0.04, Number(opts.baseMoveSpeed ?? 0.33)),
                turnEase: Math.max(0.03, Number(opts.turnEase ?? 0.11))
            };
            const w = container.clientWidth > 0 ? container.clientWidth : 220;
            const h = container.clientHeight > 0 ? container.clientHeight : 220;

            try {
                const scene = new THREE.Scene();
                const camera = new THREE.PerspectiveCamera(58, w / h, 0.1, 1000);
                const cameraDistance = Math.max(2.8, Number(opts.cameraDistance ?? (environment === 'city' ? 5.6 : 4.2)));
                const cameraHeight = Number(opts.cameraHeight ?? (environment === 'city' ? 1.8 : 0));
                const cameraLookY = Number(opts.cameraLookY ?? (environment === 'city' ? 0.15 : 0));
                camera.position.set(0, cameraHeight, cameraDistance);
                camera.lookAt(0, cameraLookY, 0);

                let renderer = null;
                try {
                    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'high-performance' });
                } catch (e1) {
                    try {
                        renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true, powerPreference: 'low-power' });
                    } catch (e2) {
                        renderer = new THREE.WebGLRenderer({ antialias: false, alpha: false });
                    }
                }
                const maxPixelRatio = opts.lowQuality ? 1.1 : 1.5;
                renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, maxPixelRatio));
                renderer.setSize(w, h);
                renderer.setClearColor(0x000000, 0);
                if (renderer.outputColorSpace) renderer.outputColorSpace = THREE.SRGBColorSpace;
                if (renderer.toneMapping !== undefined) {
                    renderer.toneMapping = THREE.ACESFilmicToneMapping;
                    renderer.toneMappingExposure = environment === 'city' ? 1.12 : 1.25;
                }
                renderer.shadowMap.enabled = environment === 'city' && !opts.lowQuality;
                renderer.shadowMap.type = THREE.PCFSoftShadowMap;
                container.innerHTML = '';
                container.appendChild(renderer.domElement);

                let activeModel = window.RLife3D.createPetModel(type, color);
                scene.add(activeModel.group);

                const lightPack = [];
                if (environment === 'city') {
                    const sky = String(opts.cityTime || 'day').toLowerCase();
                    const skyColor = sky === 'night' ? 0x1e293b : (sky === 'sunset' ? 0xffedd5 : 0xe0f2fe);
                    const groundColor = sky === 'night' ? 0x0b1120 : 0x1f2937;
                    const hemi = new THREE.HemisphereLight(skyColor, groundColor, 0.82);
                    const sun = new THREE.DirectionalLight(0xfff7ed, sky === 'night' ? 0.5 : 0.95);
                    sun.position.set(3.6, 6.2, 3.8);
                    sun.castShadow = renderer.shadowMap.enabled;
                    if (sun.castShadow) {
                        sun.shadow.mapSize.width = 512;
                        sun.shadow.mapSize.height = 512;
                    }
                    const rim = new THREE.PointLight(Number(opts.cityTint ?? 0x38bdf8), sky === 'night' ? 0.9 : 0.45, 18);
                    rim.position.set(-2.4, 1.25, 2.2);
                    const fill = new THREE.PointLight(0xf8fafc, 0.35, 12);
                    fill.position.set(0.2, 0.9, 3.2);
                    lightPack.push(hemi, sun, rim, fill);
                    scene.add(hemi, sun, rim, fill);
                } else {
                    const hemi = new THREE.HemisphereLight(0xffffff, 0x223344, 0.95);
                    const key = new THREE.DirectionalLight(0xffffff, 1.25);
                    key.position.set(5, 8, 6);
                    const rim = new THREE.PointLight(0xa78bfa, 0.9, 20);
                    rim.position.set(-4, -2, 4);
                    lightPack.push(hemi, key, rim);
                    scene.add(hemi, key, rim);
                }

                const cityEnvironment = environment === 'city' && typeof window.RLife3D.createCityEnvironment === 'function'
                    ? window.RLife3D.createCityEnvironment(scene, opts)
                    : null;

                const nextBurstDelay = function() {
                    const minMs = Math.min(behavior.burstEveryMinMs, behavior.burstEveryMaxMs);
                    const maxMs = Math.max(behavior.burstEveryMinMs, behavior.burstEveryMaxMs);
                    return minMs + Math.random() * (maxMs - minMs);
                };

                const now = performance.now();
                const state = {
                    isAlive: true,
                    renderer,
                    resizeObserver: null,
                    hasFrame: false,
                    cleanup: function() {
                        if (cityEnvironment && typeof cityEnvironment.dispose === 'function') cityEnvironment.dispose();
                    },
                    burstUntil: 0,
                    nextBurstAt: now + nextBurstDelay(),
                    lastTick: now,
                    moveTarget: new THREE.Vector2((Math.random() - 0.5) * behavior.arenaRadius, (Math.random() - 0.5) * behavior.arenaRadius),
                    blinkUntil: 0,
                    nextBlinkAt: now + 1000 + (Math.random() * 2300)
                };
                container._rlife3d = state;

                const animate = function() {
                    if (!state.isAlive) return;
                    requestAnimationFrame(animate);
                    const currentMs = performance.now();
                    const t = currentMs / 1000;
                    const dt = Math.max(0.001, Math.min(0.05, (currentMs - state.lastTick) / 1000));
                    state.lastTick = currentMs;
                    if (behavior.burstDurationMs > 0 && currentMs >= state.nextBurstAt) {
                        state.burstUntil = currentMs + behavior.burstDurationMs;
                        state.nextBurstAt = currentMs + nextBurstDelay();
                    }
                    if (currentMs >= state.nextBlinkAt) {
                        state.blinkUntil = currentMs + 130;
                        state.nextBlinkAt = currentMs + 1800 + Math.random() * 4200;
                    }

                    const isBursting = currentMs < state.burstUntil;
                    const spinSpeed = isBursting ? spin * behavior.burstMultiplier : spin;
                    let moveSpeed = 0;

                    if (behavior.wander) {
                        const position2D = new THREE.Vector2(activeModel.group.position.x, activeModel.group.position.z);
                        const toTarget = state.moveTarget.clone().sub(position2D);
                        const distance = toTarget.length();
                        if (distance < 0.08) {
                            state.moveTarget.set(
                                (Math.random() - 0.5) * behavior.arenaRadius,
                                (Math.random() - 0.5) * behavior.arenaRadius
                            );
                        } else {
                            const desired = toTarget.normalize();
                            const speedScale = isBursting ? 1.65 : 1;
                            const frameSpeed = behavior.baseMoveSpeed * speedScale * dt;
                            activeModel.group.position.x += desired.x * frameSpeed;
                            activeModel.group.position.z += desired.y * frameSpeed;
                            moveSpeed = frameSpeed / dt;

                            const targetYaw = Math.atan2(desired.x, desired.y);
                            const yawDiff = Math.atan2(Math.sin(targetYaw - activeModel.group.rotation.y), Math.cos(targetYaw - activeModel.group.rotation.y));
                            activeModel.group.rotation.y += yawDiff * behavior.turnEase;
                        }
                    } else {
                        activeModel.group.rotation.y += spinSpeed;
                        if (behavior.driftAmp > 0) {
                            activeModel.group.position.x = Math.sin(t * behavior.driftSpeed) * behavior.driftAmp;
                            activeModel.group.position.z = Math.cos(t * (behavior.driftSpeed * 0.72)) * behavior.driftAmp * 0.42;
                        }
                    }

                    activeModel.group.rotation.x = (Math.sin(t * behavior.bobSpeed) * behavior.bobAmp) + (Math.sin(t * 0.95) * behavior.tiltAmp);
                    activeModel.group.position.y = Math.sin(t * behavior.bobSpeed * 1.02) * (behavior.bobAmp * 0.9);
                    if (behavior.hoverAmp > 0) activeModel.group.position.y += Math.sin(t * behavior.hoverSpeed) * behavior.hoverAmp;

                    const stride = Math.max(0.05, Math.min(0.45, moveSpeed * 0.7));
                    const activity = Math.max(0.12, Math.min(1, stride * 2 + (isBursting ? 0.28 : 0)));
                    const blink = currentMs < state.blinkUntil ? 1 : 0;
                    if (typeof activeModel.animate === 'function') activeModel.animate(t, { stride, activity, blink });
                    if (cityEnvironment && typeof cityEnvironment.update === 'function') cityEnvironment.update(t, dt);
                    renderer.render(scene, camera);
                    state.hasFrame = true;
                };
                animate();

                if ((type === 'cat' || type === 'dog') && !opts.disableImportedModel) {
                    const loadFn = type === 'cat' ? window.RLife3D.loadImportedCatModel : window.RLife3D.loadImportedDogModel;
                    loadFn(function(importedGroup) {
                        if (!state.isAlive || !importedGroup) return;
                        scene.remove(activeModel.group);
                        activeModel = { group: importedGroup };
                        scene.add(activeModel.group);
                    }, function() {
                        // Keep the procedural 3D model when imported assets fail to avoid emoji/flicker fallback.
                        if (!state.isAlive) return;
                    });
                }

                if (typeof ResizeObserver !== 'undefined') {
                    const resizeObserver = new ResizeObserver(function() {
                        if (!state.isAlive) return;
                        const rw = container.clientWidth > 0 ? container.clientWidth : 220;
                        const rh = container.clientHeight > 0 ? container.clientHeight : 220;
                        camera.aspect = rw / rh;
                        camera.updateProjectionMatrix();
                        renderer.setSize(rw, rh);
                    });
                    resizeObserver.observe(container);
                    state.resizeObserver = resizeObserver;
                }
            } catch (e) {
                window.RLife3D.renderFallback(container, opts);
            }
        };

        function openPetManagementModal() {
            const modal = document.getElementById('petManagementModal');
            if (modal) {
                modal.classList.remove('hidden');
                initPet3D();
                refreshPetStatus({ rerender3d: true });
                window.setTimeout(initPet3D, 120);
                window.setTimeout(initPet3D, 320);
            }
        }
        function closePetManagementModal() {
            const container = document.getElementById('pet3DModal');
            if (container) window.RLife3D.dispose(container);
            document.getElementById('petManagementModal')?.classList.add('hidden');
        }
        function openFeedModal() {
            document.getElementById('feedModal')?.classList.remove('hidden');
        }
        function closeFeedModal() {
            document.getElementById('feedModal')?.classList.add('hidden');
        }
        function toggleRenameSection() {
            document.getElementById('renameSection')?.classList.toggle('hidden');
        }
        function goToChangePetType() {
            window.location.href = "{{ path('app_pet_change_type') }}";
        }
        function goToPetPage() {
