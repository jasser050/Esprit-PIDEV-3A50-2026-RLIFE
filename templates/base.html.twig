    function getSpotifyTrackId(url) {
        if (!url) return '';
        const clean = String(url).split('?')[0];
        const match = clean.match(/(?:track|episode)\/([A-Za-z0-9]+)/);
        return match ? match[1] : '';
    }

    function toTrackEmbed(url) {
        if (!url) return '';
        let clean = String(url).trim();
        clean = clean.replace('https://open.spotify.com/intl-fr/', 'https://open.spotify.com/');
        clean = clean.replace('https://open.spotify.com/intl-en/', 'https://open.spotify.com/');
        clean = clean.replace('https://open.spotify.com/intl/', 'https://open.spotify.com/');
        clean = clean.split('?')[0];
        if (clean.includes('/embed/')) return clean + '?utm_source=generator';
        if (clean.includes('open.spotify.com/track/')) {
            clean = clean.replace('open.spotify.com/track/', 'open.spotify.com/embed/track/');
            return clean + '?utm_source=generator';
        }
        if (clean.includes('open.spotify.com/episode/')) {
            clean = clean.replace('open.spotify.com/episode/', 'open.spotify.com/embed/episode/');
            return clean + '?utm_source=generator';
        }
        return normalizeSpotifyUrl(url);
