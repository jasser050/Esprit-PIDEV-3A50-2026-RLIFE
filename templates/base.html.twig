    }

    function readSpotifyState() {
        if (window.RLifeSpotifyState && typeof window.RLifeSpotifyState === 'object') {
            spotifyState = { ...spotifyState, ...window.RLifeSpotifyState };
            return;
        }
        try {
            const raw = safeStorage.get('rlife_spotify_state');
            if (!raw) return;
            const parsed = JSON.parse(raw);
            const parsedVersion = Number(parsed.v || 0);
            spotifyState = {
                enabled: !!parsed.enabled,
                open: !!parsed.open,
                url: normalizeSpotifyUrl(String(parsed.url || '')),
                size: Number(parsed.size || 360),
                x: Number.isFinite(Number(parsed.x)) ? Number(parsed.x) : null,
                y: Number.isFinite(Number(parsed.y)) ? Number(parsed.y) : null,
                preset: String(parsed.preset || 'nature'),
                v: spotifyStateVersion,
            };
            if (spotifyState.preset === 'quran' && !spotifyState.url) {
                spotifyState.url = spotifyPresets.quran;
            }
            // Reset old saved positions from previous UI versions
            if (parsedVersion < spotifyStateVersion) {
                spotifyState.x = null;
                spotifyState.y = null;
                if (!Number.isFinite(spotifyState.size) || spotifyState.size < 200) {
                    spotifyState.size = 360;
                }
            }
        } catch (e) {}
    }

    function writeSpotifyState() {
        try {
            spotifyState.v = spotifyStateVersion;
            safeStorage.set('rlife_spotify_state', JSON.stringify(spotifyState));
            window.RLifeSpotifyState = { ...spotifyState };
        } catch (e) {}
    }

    function getSpotifyDefaultPosition() {
        const margin = 16;
        const size = Number(spotifyState.size || 360);
        const x = Math.max(8, window.innerWidth - size - margin);
        const y = Math.max(8, window.innerHeight - 240 - margin);
        return { x, y };
    }

    function applySpotifySize(sizeValue, isQuran = false) {
        const iframe = document.getElementById('global-spotify-iframe');
        const scIframe = document.getElementById('global-soundcloud-iframe');
        const wrap = document.getElementById('global-spotify-embed-wrap');
        const quranList = document.getElementById('spotify-quran-list');
        const quranItems = document.getElementById('spotify-quran-items');
        if (!iframe || !scIframe) return;

        const sizeKey = sizeValue >= 540 ? 'xl' : sizeValue >= 440 ? 'lg' : sizeValue >= 340 ? 'md' : 'sm';
        // Keep the Spotify iframe tight to avoid white bands.
        const iframeHeight = 152;
        // Scale the Quran list instead of the iframe to use extra space.
        const listMap = { sm: 80, md: 140, lg: 200, xl: 260 };
        const h = iframeHeight;
        iframe.style.height = h + 'px';
        iframe.setAttribute('height', String(h));
        scIframe.style.height = h + 'px';
        scIframe.setAttribute('height', String(h));
        scIframe.style.minHeight = h + 'px';
        if (wrap) {
            wrap.style.height = h + 'px';
        }

        if (quranList && quranItems) {
            const listHeight = listMap[sizeKey] || 0;
            if (!isQuran || listHeight === 0) {
                quranList.classList.add('hidden');
            } else {
                quranList.classList.remove('hidden');
                quranItems.style.maxHeight = listHeight + 'px';
            }
        }
    }

    function updateSpotifyLayout() {
        const root = document.getElementById('global-spotify-widget');
        const sizeInput = document.getElementById('spotify-size');
        const listRow = document.querySelector('.sp-playlist-row');
        if (!root || !sizeInput) return;
        if (!spotifyState.enabled) {
            root.classList.add('hidden');
            return;
        }
        root.classList.remove('hidden');
        root.classList.add('sp-visible');
        const sizeValue = Number(spotifyState.size || 360);
        sizeInput.value = String(sizeValue);
        root.classList.remove('sp-sm', 'sp-md', 'sp-lg', 'sp-xl');
        if (sizeValue >= 540) root.classList.add('sp-xl');
        else if (sizeValue >= 440) root.classList.add('sp-lg');
        else if (sizeValue >= 340) root.classList.add('sp-md');
        else root.classList.add('sp-sm');
        applySpotifySize(sizeValue, spotifyState.preset === 'quran');
        const pinBtn = document.getElementById('spotify-pin');
        if (pinBtn) {
            pinBtn.classList.toggle('sp-pin-active', isSpotifyPinned());
        }
        document.querySelectorAll('.sp-size-btn').forEach((btn) => {
            const key = String(btn.getAttribute('data-size') || 'sm');
            const active = (key === 'xl' && sizeValue >= 540)
                || (key === 'lg' && sizeValue >= 440 && sizeValue < 540)
                || (key === 'md' && sizeValue >= 340 && sizeValue < 440)
                || (key === 'sm' && sizeValue < 340);
            btn.classList.toggle('active', active);
        });
        if (listRow) {
        const hideList = String(safeStorage.get(spotifyListHiddenKey) || '0') === '1';
            listRow.classList.toggle('sp-list-hidden', hideList);
        }
        const maxX = Math.max(8, window.innerWidth - root.offsetWidth - 8);
        const maxY = Math.max(8, window.innerHeight - root.offsetHeight - 8);
        if (spotifyState.x !== null && spotifyState.y !== null) {
            let safeX = Math.max(8, Math.min(maxX, Number(spotifyState.x)));
            let safeY = Math.max(8, Math.min(maxY, Number(spotifyState.y)));
            if (safeY < 70) {
                const def = getSpotifyDefaultPosition();
                safeX = def.x;
                safeY = def.y;
                spotifyState.x = safeX;
                spotifyState.y = safeY;
                writeSpotifyState();
            }
            root.style.left = safeX + 'px';
            root.style.top = safeY + 'px';
            root.style.right = 'auto';
            root.style.bottom = 'auto';
        } else {
            const def = getSpotifyDefaultPosition();
            root.style.left = def.x + 'px';
            root.style.top = def.y + 'px';
            root.style.right = 'auto';
            root.style.bottom = 'auto';
        }
    }

    function renderSpotifyWidget() {
        const root = document.getElementById('global-spotify-widget');
        const fab = document.getElementById('global-spotify-fab');
        const panel = document.getElementById('global-spotify-panel');
        const iframe = document.getElementById('global-spotify-iframe');
        const scIframe = document.getElementById('global-soundcloud-iframe');
        const bubble = document.getElementById('sp-bubble');
        const ring = document.getElementById('sp-ring');
        const eq = document.getElementById('sp-eq');
        const logo = document.getElementById('sp-logo');
        const size = document.getElementById('spotify-size');
        const sizeButtons = document.querySelectorAll('.sp-size-btn');
        const title = document.getElementById('spotify-current-title');
        const loading = document.getElementById('spotify-loading');
        const quranList = document.getElementById('spotify-quran-list');
        const quranItems = document.getElementById('spotify-quran-items');
        const quranPlaylistBtn = document.getElementById('spotify-quran-playlist');
        const reciterLuhaidanBtn = document.getElementById('quran-reciter-luhaidan');
        const reciterDossariBtn = document.getElementById('quran-reciter-dossari');
        const scFallback = document.getElementById('spotify-soundcloud-fallback');
        const scFallbackOpen = document.getElementById('spotify-soundcloud-open');
        if (!root || !fab || !panel || !iframe || !scIframe || !size) return;

        if (!spotifyState.enabled) {
            root.classList.add('hidden');
            if (bubble) bubble.classList.add('hidden');
            return;
        }
        const started = getSpotifyStarted();

        updateSpotifyLayout();
        const rawUrl = spotifyState.url || spotifyPresets[spotifyState.preset] || spotifyPresets.nature;
        const normalizedUrl = (spotifyState.preset === 'nature' || spotifyState.preset === 'relax' || spotifyState.preset === 'motivation')
            ? normalizeSpotifyListUrl(rawUrl)
            : normalizeSpotifyUrl(rawUrl);
        if (title) {
            title.textContent = spotifyPresetLabels[spotifyState.preset] || 'Nature Sounds';
        }
        document.querySelectorAll('.spotify-preset').forEach((btn) => {
            const isActive = String(btn.getAttribute('data-preset') || '') === spotifyState.preset;
            btn.classList.toggle('active', isActive);
        });
        let activeReciterKey = spotifyState.preset === 'quran' ? getSelectedReciter() : '';
        const presetChanged = spotifyLastPreset !== spotifyState.preset;
        const urlChanged = spotifyLastUrl !== normalizedUrl;
        const reciterChanged = spotifyLastReciter !== activeReciterKey;
        const openChanged = spotifyLastOpen !== spotifyState.open;
        if (!presetChanged && !urlChanged && !reciterChanged && !openChanged) {
            if (spotifyState.open) panel.classList.remove('hidden');
            else panel.classList.add('hidden');
            return;
        }
        spotifyLastPreset = spotifyState.preset;
        spotifyLastUrl = normalizedUrl;
        spotifyLastReciter = activeReciterKey;
        spotifyLastOpen = spotifyState.open;
        if (spotifyState.preset === 'quran') {
            if (!activeReciterKey) {
                activeReciterKey = 'luhaidan';
                setSelectedReciter('luhaidan');
            }
            const activeReciter = quranReciters[activeReciterKey] || quranReciters.luhaidan;
            const tracks = Array.isArray(activeReciter?.tracks) ? activeReciter.tracks : [];
            const useSoundCloud = activeReciterKey === 'dossari' && tracks.length === 0;
            const defaultTrack = tracks[0] ? toTrackEmbed(tracks[0].url) : normalizedUrl;
            applySpotifySize(Number(spotifyState.size || 360), true);
            if (useSoundCloud) {
                if (spotifyIframeSrc !== '') {
                    iframe.src = '';
                    spotifyIframeSrc = '';
                    spotifyCurrentTrackId = '';
                }
                iframe.classList.add('hidden');
                scIframe.classList.remove('hidden');
                scIframe.style.display = 'block';
                scIframe.style.background = '#111';
                scIframe.style.visibility = 'visible';
                scIframe.style.opacity = '1';
                if (scFallback) scFallback.classList.add('sp-hidden');
                const desiredSc = 'https://w.soundcloud.com/player/?url=' + encodeURIComponent(quranDossariSoundcloud) +
                    '&color=%230a4b6b&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=true&visual=false';
                if (loading) loading.classList.remove('sp-hidden');
                if (forceSoundcloudOpen || soundcloudIframeSrc !== desiredSc) {
                    scIframe.src = desiredSc;
                    soundcloudIframeSrc = desiredSc;
                    window.RLifeSoundcloudIframeSrc = soundcloudIframeSrc;
                    forceSoundcloudOpen = false;
                }
                if (scFallbackTimer) {
                    window.clearTimeout(scFallbackTimer);
                    scFallbackTimer = null;
                }
                scIframe.onload = () => {
                    if (loading) loading.classList.add('sp-hidden');
                    if (scFallback) scFallback.classList.add('sp-hidden');
                };
                scFallbackTimer = window.setTimeout(() => {
                    if (loading) loading.classList.add('sp-hidden');
                    if (scFallback) scFallback.classList.remove('sp-hidden');
                }, 1800);
            } else {
                scIframe.classList.add('hidden');
                if (soundcloudIframeSrc !== '') {
                    scIframe.src = '';
                    soundcloudIframeSrc = '';
                    window.RLifeSoundcloudIframeSrc = '';
                }
                if (scFallback) scFallback.classList.add('sp-hidden');
                if (scFallbackTimer) {
                    window.clearTimeout(scFallbackTimer);
                    scFallbackTimer = null;
                }
                iframe.classList.remove('hidden');
            const desiredSpotify = (normalizedUrl.includes('/track/') || normalizedUrl.includes('/embed/track/')
                || normalizedUrl.includes('/episode/') || normalizedUrl.includes('/embed/episode/')
                    ? normalizedUrl
                    : defaultTrack);
                const desiredTrackId = getSpotifyTrackId(desiredSpotify);
                if (spotifyIframeSrc !== desiredSpotify && desiredTrackId !== spotifyCurrentTrackId) {
                    if (loading) loading.classList.remove('sp-hidden');
                    iframe.src = desiredSpotify;
                    spotifyIframeSrc = desiredSpotify;
                    spotifyCurrentTrackId = desiredTrackId;
                    window.RLifeSpotifyIframeSrc = spotifyIframeSrc;
                    window.RLifeSpotifyTrackId = spotifyCurrentTrackId;
                    iframe.onload = () => { if (loading) loading.classList.add('sp-hidden'); };
                }
            }
            if (quranList && quranItems) {
                if (tracks.length) {
                    quranItems.innerHTML = tracks.map((track, idx) => `
                        <button class="w-full text-left text-[11px] px-2 py-1.5 rounded-md bg-slate-800/60 hover:bg-slate-700/70 transition"
                                data-quran-track="${idx}">
                            ${activeReciter.label} — ${track.title}
                        </button>
                    `).join('');
                } else {
                    quranItems.innerHTML = useSoundCloud
                        ? `
                            <button class="w-full text-left text-[11px] px-2 py-1.5 rounded-md bg-slate-800/60 hover:bg-slate-700/70 transition"
                                    data-soundcloud="1">Yasser Al-Dossari — Playlist</button>
                            <button class="w-full text-left text-[11px] px-2 py-1.5 rounded-md bg-slate-800/60 hover:bg-slate-700/70 transition"
                                    data-soundcloud="1">Yasser Al-Dossari — Recitation</button>
                            <button class="w-full text-left text-[11px] px-2 py-1.5 rounded-md bg-slate-800/60 hover:bg-slate-700/70 transition"
                                    data-soundcloud="1">Yasser Al-Dossari — Quran</button>
                          `
                        : '<p class="text-[11px] text-slate-300/80">Add Spotify links for this reciter.</p>';
                }
                applySpotifySize(Number(spotifyState.size || 360), true);
            }
            if (quranPlaylistBtn) {
                quranPlaylistBtn.onclick = function() {
                    if (activeReciterKey === 'dossari') {
                        spotifyState.open = true;
                        renderSpotifyWidget();
                        return;
                    }
                    window.open(quranPlaylistUrl, '_blank');
                };
            }
            if (scFallbackOpen) {
                scFallbackOpen.onclick = function() {
                    spotifyState.open = true;
                    renderSpotifyWidget();
                };
            }
            if (reciterLuhaidanBtn && reciterDossariBtn) {
                const setActive = (key) => {
                    setSelectedReciter(key);
                    reciterLuhaidanBtn.className = key === 'luhaidan'
                        ? 'text-[11px] px-2 py-1 rounded-md bg-slate-700/80 hover:bg-slate-600 transition'
                        : 'text-[11px] px-2 py-1 rounded-md bg-slate-700/50 hover:bg-slate-600 transition';
                    reciterDossariBtn.className = key === 'dossari'
                        ? 'text-[11px] px-2 py-1 rounded-md bg-slate-700/80 hover:bg-slate-600 transition'
                        : 'text-[11px] px-2 py-1 rounded-md bg-slate-700/50 hover:bg-slate-600 transition';
                };
                setActive(activeReciterKey);
                reciterLuhaidanBtn.onclick = () => {
                    if (getSelectedReciter() === 'luhaidan') return;
                    setActive('luhaidan');
                    spotifyState.open = true;
                    spotifyState.preset = 'quran';
                    spotifyState.url = '';
                    spotifyLastPreset = '';
                    spotifyLastUrl = '';
                    spotifyLastReciter = '';
                    renderSpotifyWidget();
                };
                reciterDossariBtn.onclick = () => {
                    if (getSelectedReciter() === 'dossari') return;
                    setActive('dossari');
                    spotifyState.open = true;
                    spotifyState.preset = 'quran';
                    spotifyState.url = '';
                    spotifyLastPreset = '';
                    spotifyLastUrl = '';
                    spotifyLastReciter = '';
                    renderSpotifyWidget();
                };
            }
        } else {
            applySpotifySize(Number(spotifyState.size || 360), false);
            const desiredTrackId = getSpotifyTrackId(normalizedUrl);
            if (spotifyIframeSrc !== normalizedUrl && (desiredTrackId === '' || desiredTrackId !== spotifyCurrentTrackId)) {
                if (loading) loading.classList.remove('sp-hidden');
                iframe.src = normalizedUrl;
                spotifyIframeSrc = normalizedUrl;
                spotifyCurrentTrackId = desiredTrackId;
                window.RLifeSpotifyIframeSrc = spotifyIframeSrc;
                window.RLifeSpotifyTrackId = spotifyCurrentTrackId;
                iframe.onload = () => { if (loading) loading.classList.add('sp-hidden'); };
            }
            scIframe.classList.add('hidden');
            if (soundcloudIframeSrc !== '') {
                scIframe.src = '';
                soundcloudIframeSrc = '';
                window.RLifeSoundcloudIframeSrc = '';
            }
            if (scFallback) scFallback.classList.add('sp-hidden');
            if (scFallbackTimer) {
                window.clearTimeout(scFallbackTimer);
                scFallbackTimer = null;
            }
            if (quranList) quranList.classList.add('hidden');
        }
        const maxX = Math.max(8, window.innerWidth - spotifyState.size - 8);
        const maxY = Math.max(8, window.innerHeight - spotifyState.size - 8);
        if (spotifyState.x !== null && spotifyState.y !== null) {
            let safeX = Math.max(8, Math.min(maxX, Number(spotifyState.x)));
            let safeY = Math.max(8, Math.min(maxY, Number(spotifyState.y)));
            // Avoid top bar overlap on old saves
            if (safeY < 70) {
                const def = getSpotifyDefaultPosition();
                safeX = def.x;
                safeY = def.y;
                spotifyState.x = safeX;
                spotifyState.y = safeY;
                writeSpotifyState();
            }
            root.style.left = safeX + 'px';
            root.style.top = safeY + 'px';
            root.style.right = 'auto';
            root.style.bottom = 'auto';
        } else {
            const def = getSpotifyDefaultPosition();
            root.style.left = def.x + 'px';
            root.style.top = def.y + 'px';
            root.style.right = 'auto';
            root.style.bottom = 'auto';
        }

        if (bubble) {
            bubble.classList.toggle('hidden', !started);
            bubble.classList.toggle('sp-bubble-active', spotifyState.open);
            if (ring) ring.classList.add('playing');
            if (eq) eq.classList.remove('sp-eq-paused');
            if (logo) logo.style.display = 'none';
            if (eq) eq.style.display = 'flex';
        }
        if (!spotifyState.open) {
            panel.classList.add('hidden');
            return;
        }
        panel.classList.remove('hidden');
        bindSpotifyBubble();
    }

    function scheduleRenderSpotifyWidget() {
        if (spotifyRenderQueued) return;
        spotifyRenderQueued = true;
        window.setTimeout(() => {
            spotifyRenderQueued = false;
            renderSpotifyWidget();
        }, 150);
    }

    function toggleSpotifyPanelDirect() {
        const panel = document.getElementById('global-spotify-panel');
        const root = document.getElementById('global-spotify-widget');
        if (!panel || !root) return;
        const isHidden = panel.classList.contains('hidden') || panel.style.display === 'none';
        panel.classList.toggle('hidden', !isHidden);
        panel.style.display = isHidden ? 'block' : 'none';
        root.classList.remove('hidden');
        root.classList.add('sp-visible');
        spotifyState.open = isHidden;
        spotifyState.enabled = true;
        safeStorage.set(spotifyStartedKey, '1');
        writeSpotifyState();
    }
    window.RLifeToggleSpotifyPanel = () => {
        toggleSpotifyPanelDirect();
        renderSpotifyWidget();
    };

    function bindSpotifyBubble() {
        const bubble = document.getElementById('sp-bubble');
        if (!bubble || bubble.dataset.bound === '1') return;
        bubble.dataset.bound = '1';
        bubble.addEventListener('click', (event) => {
            event.stopPropagation();
            event.preventDefault();
            // Click handled via pointerup to avoid double-toggle.
        });
        bubble.addEventListener('pointerdown', (event) => {
            event.stopPropagation();
        });
    }

    function initSpotifyWidget() {
        readSpotifyState();
        const started = getSpotifyStarted();
        if (started && !spotifyState.enabled) {
            spotifyState.enabled = true;
            if (!spotifyState.url) {
                spotifyState.url = spotifyPresets[spotifyState.preset] || spotifyPresets.nature;
            }
            if (typeof spotifyState.open !== 'boolean') {
                spotifyState.open = true;
            }
            writeSpotifyState();
        }
        if (isSpotifyPinned()) {
            spotifyState.enabled = true;
            spotifyState.open = true;
        }
        renderSpotifyWidget();
        bindSpotifyBubble();

        const root = document.getElementById('global-spotify-widget');
        const fab = document.getElementById('global-spotify-fab');
        const panel = document.getElementById('global-spotify-panel');
        const iframe = document.getElementById('global-spotify-iframe');
        const deleteBtn = document.getElementById('spotify-delete');
        const toggleListBtn = document.getElementById('spotify-toggle-list');
        const minimizeBtn = document.getElementById('spotify-minimize');
        const bubble = document.getElementById('sp-bubble');
        const size = document.getElementById('spotify-size');
        const pinBtn = document.getElementById('spotify-pin');
        const sizeButtons = document.querySelectorAll('.sp-size-btn');
        const presetButtons = document.querySelectorAll('.spotify-preset');
        if (!root || !fab || !panel || !iframe || !deleteBtn || !size) return;
        // Preserve iframe src across Turbo navigation to avoid music restart.
        if (!window.RLifeSpotifyIframeSrc && iframe.src) {
            window.RLifeSpotifyIframeSrc = iframe.src;
        }
        if (!spotifyIframeSrc && window.RLifeSpotifyIframeSrc) {
            spotifyIframeSrc = window.RLifeSpotifyIframeSrc;
        }

        fab.addEventListener('pointerdown', function(event) {
            const target = event.target;
            if (target instanceof HTMLElement) {
                if (target.closest('.sp-topbar-actions')) return;
            }
            spotifyFabDragging = false;
            spotifyFabPointerId = event.pointerId;
            spotifyFabStartX = event.clientX;
            spotifyFabStartY = event.clientY;
            const rect = root.getBoundingClientRect();
            spotifyFabOriginX = rect.left;
            spotifyFabOriginY = rect.top;
            fab.setPointerCapture(event.pointerId);
            event.preventDefault();
        });

        fab.addEventListener('pointermove', function(event) {
            if (spotifyFabPointerId !== event.pointerId) return;
            const dx = event.clientX - spotifyFabStartX;
            const dy = event.clientY - spotifyFabStartY;
            if (!spotifyFabDragging && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
                spotifyFabDragging = true;
            }
            if (!spotifyFabDragging) return;
            let nextX = spotifyFabOriginX + dx;
            let nextY = spotifyFabOriginY + dy;
            const maxX = Math.max(8, window.innerWidth - 80);
            const maxY = Math.max(8, window.innerHeight - 90);
            nextX = Math.max(8, Math.min(maxX, nextX));
            nextY = Math.max(8, Math.min(maxY, nextY));
            spotifyState.x = Math.round(nextX);
            spotifyState.y = Math.round(nextY);
            writeSpotifyState();
            updateSpotifyLayout();
        });

        fab.addEventListener('pointerup', function(event) {
            if (spotifyFabPointerId !== event.pointerId) return;
            fab.releasePointerCapture(event.pointerId);
            if (!spotifyFabDragging) {
                spotifyState.open = !spotifyState.open;
                writeSpotifyState();
                renderSpotifyWidget();
            }
            spotifyFabPointerId = null;
            spotifyFabDragging = false;
        });

        fab.addEventListener('pointercancel', function(event) {
            if (spotifyFabPointerId !== event.pointerId) return;
            spotifyFabPointerId = null;
            spotifyFabDragging = false;
        });

        pinBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            const next = !isSpotifyPinned();
            setSpotifyPinned(next);
            if (next) {
                spotifyState.enabled = true;
                spotifyState.open = true;
                writeSpotifyState();
            }
            updateSpotifyLayout();
        });

        toggleListBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            const current = String(safeStorage.get(spotifyListHiddenKey) || '0') === '1';
            safeStorage.set(spotifyListHiddenKey, current ? '0' : '1');
            updateSpotifyLayout();
        });

        minimizeBtn?.addEventListener('click', (event) => {
            event.stopPropagation();
            if (window.RLifeToggleSpotifyPanel) window.RLifeToggleSpotifyPanel();
        });

        window.RLifeToggleSpotifyPanel = () => {
            toggleSpotifyPanelDirect();
            renderSpotifyWidget();
        };
        let bubbleDragging = false;
        let bubblePointerId = null;
        let bubbleStartX = 0;
        let bubbleStartY = 0;
        let bubbleOriginX = 0;
        let bubbleOriginY = 0;
        let bubbleIgnoreClickUntil = 0;
        const bubbleTapThreshold = 10;
        const bubbleDragThreshold = 12;

        bubble?.addEventListener('pointerdown', (event) => {
            bubbleDragging = false;
            bubblePointerId = event.pointerId;
            bubbleStartX = event.clientX;
            bubbleStartY = event.clientY;
            const rect = bubble.getBoundingClientRect();
            bubbleOriginX = rect.left;
            bubbleOriginY = rect.top;
            bubble.dataset.dragging = '0';
            bubble.setPointerCapture(event.pointerId);
        });

        bubble?.addEventListener('pointermove', (event) => {
            if (bubblePointerId !== event.pointerId) return;
            const dx = event.clientX - bubbleStartX;
            const dy = event.clientY - bubbleStartY;
            if (!bubbleDragging && (Math.abs(dx) > bubbleDragThreshold || Math.abs(dy) > bubbleDragThreshold)) {
                bubbleDragging = true;
                bubble.dataset.dragging = '1';
            }
            if (!bubbleDragging) return;
            let nextX = bubbleOriginX + dx;
            let nextY = bubbleOriginY + dy;
            const maxX = Math.max(8, window.innerWidth - bubble.offsetWidth - 8);
            const maxY = Math.max(8, window.innerHeight - bubble.offsetHeight - 8);
            nextX = Math.max(8, Math.min(maxX, nextX));
            nextY = Math.max(8, Math.min(maxY, nextY));
            bubble.style.left = nextX + 'px';
            bubble.style.top = nextY + 'px';
            bubble.style.right = 'auto';
            bubble.style.bottom = 'auto';
        });

        bubble?.addEventListener('pointerup', (event) => {
            if (bubblePointerId !== event.pointerId) return;
            bubble.releasePointerCapture(event.pointerId);
            const dx = event.clientX - bubbleStartX;
            const dy = event.clientY - bubbleStartY;
            const isTap = Math.abs(dx) <= bubbleTapThreshold && Math.abs(dy) <= bubbleTapThreshold;
            if (isTap) {
                // Treat as a tap/click to toggle the panel.
                bubbleIgnoreClickUntil = Date.now() + 300;
                event.preventDefault();
                event.stopPropagation();
                if (window.RLifeToggleSpotifyPanel) window.RLifeToggleSpotifyPanel();
                else toggleSpotifyPanelDirect();
            } else if (bubbleDragging) {
                bubbleIgnoreClickUntil = Date.now() + 300;
            }
            bubblePointerId = null;
            bubbleDragging = false;
            bubble.dataset.dragging = '0';
        });

        bubble?.addEventListener('pointercancel', (event) => {
            if (bubblePointerId !== event.pointerId) return;
            bubblePointerId = null;
            bubbleDragging = false;
            bubble.dataset.dragging = '0';
        });

        bubble?.addEventListener('click', (event) => {
            if (Date.now() < bubbleIgnoreClickUntil) return;
            event.preventDefault();
            event.stopPropagation();
            if (window.RLifeToggleSpotifyPanel) window.RLifeToggleSpotifyPanel();
            else toggleSpotifyPanelDirect();
        });

        // click handler handled in bindSpotifyBubble()

        // Always (re)bind global bubble handlers to survive page changes.
        const bubblePointerHandler = (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const bubbleTarget = target.closest('#sp-bubble');
            if (!bubbleTarget) return;
            if (bubbleTarget.dataset.dragging === '1') return;
            const now = Date.now();
            const lastTap = Number(window.RLifeLastBubbleTap || 0);
            if (now - lastTap < 250) return;
            window.RLifeLastBubbleTap = now;
            event.preventDefault();
            window.RLifeToggleSpotifyPanel();
        };
        const bubbleClickHandler = (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const bubbleTarget = target.closest('#sp-bubble');
            if (!bubbleTarget) return;
            if (bubbleTarget.dataset.dragging === '1') return;
            const now = Date.now();
            const lastTap = Number(window.RLifeLastBubbleTap || 0);
            if (now - lastTap < 250) return;
            window.RLifeLastBubbleTap = now;
            event.preventDefault();
            window.RLifeToggleSpotifyPanel();
        };
        if (window.RLifeBubblePointerHandler) {
            document.removeEventListener('pointerup', window.RLifeBubblePointerHandler, true);
        }
        if (window.RLifeBubbleClickHandler) {
            document.removeEventListener('click', window.RLifeBubbleClickHandler, true);
        }
        window.RLifeBubblePointerHandler = bubblePointerHandler;
        window.RLifeBubbleClickHandler = bubbleClickHandler;
        document.addEventListener('pointerup', bubblePointerHandler, true);
        document.addEventListener('click', bubbleClickHandler, true);

        deleteBtn.onclick = function() {
            spotifyState.enabled = false;
            spotifyState.open = false;
            spotifyState.url = '';
            spotifyState.preset = 'nature';
            safeStorage.set(spotifyStartedKey, '0');
            window.RLifeSpotifyState = null;
            writeSpotifyState();
            if (window.RLifeAudio && typeof window.RLifeAudio.stop === 'function') {
                window.RLifeAudio.stop();
            }
            const iframe = document.getElementById('global-spotify-iframe');
            const scIframe = document.getElementById('global-soundcloud-iframe');
            if (iframe) {
                iframe.src = '';
                spotifyIframeSrc = '';
                spotifyCurrentTrackId = '';
                window.RLifeSpotifyIframeSrc = '';
                window.RLifeSpotifyTrackId = '';
            }
            if (scIframe) {
                scIframe.src = '';
                soundcloudIframeSrc = '';
                window.RLifeSoundcloudIframeSrc = '';
            }
            const scFallback = document.getElementById('spotify-soundcloud-fallback');
            if (scFallback) scFallback.classList.add('sp-hidden');
            if (scFallbackTimer) {
                window.clearTimeout(scFallbackTimer);
                scFallbackTimer = null;
            }
            const root = document.getElementById('global-spotify-widget');
            const panel = document.getElementById('global-spotify-panel');
            if (panel) {
                panel.classList.add('hidden');
                panel.style.display = 'none';
            }
            if (root) {
                root.classList.add('hidden');
                root.classList.remove('sp-visible');
                root.style.display = 'none';
            }
            if (bubble) bubble.classList.add('hidden');
        };

        size.oninput = function() {
            spotifyState.size = Number(size.value || 360);
            writeSpotifyState();
            updateSpotifyLayout();
        };

        sizeButtons.forEach((btn) => {
            btn.addEventListener('pointerdown', (event) => {
                event.stopPropagation();
                event.preventDefault();
            });
            btn.addEventListener('click', (event) => {
                event.stopPropagation();
                const key = String(btn.getAttribute('data-size') || 'sm');
                const nextSize = key === 'xl' ? 580 : key === 'lg' ? 460 : key === 'md' ? 360 : 280;
                if (spotifyState.size === nextSize) return;
                spotifyState.size = nextSize;
                writeSpotifyState();
                updateSpotifyLayout();
            });
        });

        document.querySelectorAll('.sp-topbar-actions button').forEach((btn) => {
            btn.addEventListener('pointerdown', (event) => {
                event.stopPropagation();
                event.preventDefault();
            });
        });

        presetButtons.forEach((btn) => {
            btn.addEventListener('click', function() {
                const preset = String(btn.getAttribute('data-preset') || 'nature');
                if (spotifyState.preset === preset) return;
                const url = spotifyPresets[preset] || spotifyPresets.nature;
                spotifyState.enabled = true;
                spotifyState.open = true;
                spotifyState.preset = preset;
                spotifyState.url = url;
                writeSpotifyState();
                renderSpotifyWidget();
            });
        });

        panel.addEventListener('click', function(event) {
            const target = event.target;
            if (!(target instanceof HTMLElement)) return;
            if (target.getAttribute('data-soundcloud') === '1') {
                const scIframe = document.getElementById('global-soundcloud-iframe');
                if (scIframe) {
                    const desiredSc = 'https://w.soundcloud.com/player/?url=' + encodeURIComponent(quranDossariSoundcloud) +
                        '&color=%230a4b6b&auto_play=true&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=true&visual=false';
                    scIframe.src = desiredSc;
                    soundcloudIframeSrc = desiredSc;
                    window.RLifeSoundcloudIframeSrc = soundcloudIframeSrc;
                }
                forceSoundcloudOpen = true;
                spotifyState.preset = 'quran';
                setSelectedReciter('dossari');
                spotifyLastPreset = '';
                spotifyLastReciter = '';
                spotifyState.url = '';
                spotifyState.open = true;
                renderSpotifyWidget();
                return;
            }
            const idx = target.getAttribute('data-quran-track');
            if (idx === null) return;
            const activeReciterKey = getSelectedReciter();
            const activeReciter = quranReciters[activeReciterKey] || quranReciters.luhaidan;
            const tracks = Array.isArray(activeReciter?.tracks) ? activeReciter.tracks : [];
            const track = tracks[Number(idx)];
            if (!track) return;
            const nextEmbed = toTrackEmbed(track.url);
            const nextTrackId = getSpotifyTrackId(nextEmbed);
            if (nextTrackId && nextTrackId === spotifyCurrentTrackId) return;
            spotifyState.enabled = true;
            spotifyState.open = true;
            spotifyState.preset = 'quran';
            spotifyState.url = nextEmbed;
            writeSpotifyState();
            scheduleRenderSpotifyWidget();
        });


        window.addEventListener('rlife-spotify-start', function(event) {
            const detail = event.detail || {};
            spotifyState.enabled = true;
            spotifyState.open = true;
            const preset = String(detail.preset || 'nature');
            spotifyState.preset = preset;
            spotifyState.url = String(detail.url || spotifyPresets[preset] || spotifyPresets.nature);
            safeStorage.set(spotifyStartedKey, '1');
            window.RLifeSpotifyState = { ...spotifyState };
            spotifyState.x = null;
            spotifyState.y = null;
            spotifyLastPreset = '';
            spotifyLastUrl = '';
            spotifyLastReciter = '';
            spotifyLastOpen = false;
            writeSpotifyState();
            const root = document.getElementById('global-spotify-widget');
            const panel = document.getElementById('global-spotify-panel');
            if (root) {
                root.classList.remove('hidden');
                root.classList.add('sp-visible');
                root.style.display = 'block';
            }
            if (panel) {
                panel.classList.remove('hidden');
                panel.style.display = 'block';
            }
            const bubble = document.getElementById('sp-bubble');
            if (bubble) bubble.classList.remove('hidden');
            updateSpotifyLayout();
            renderSpotifyWidget();
        });
    }

    function isQuoteEnabled() {
        try {
            return String(localStorage.getItem('rlife_quote_enabled') || '1') !== '0';
        } catch (e) {
            return true;
        }
    }

    function getStoredQuotePosition() {
        try {
            const raw = localStorage.getItem('rlife_quote_position');
            if (!raw) return null;
            const pos = JSON.parse(raw);
            if (!pos || !Number.isFinite(pos.x) || !Number.isFinite(pos.y)) return null;
            return { x: Number(pos.x), y: Number(pos.y) };
        } catch (e) {
            return null;
        }
    }

    function getDismissedUntil() {
        try {
            const raw = localStorage.getItem('rlife_quote_dismissed_until');
            const value = Number(raw || 0);
            return Number.isFinite(value) ? value : 0;
        } catch (e) {
            return 0;
        }
    }

    function applyQuotePosition() {
        const box = document.getElementById('global-motivation-quote');
        if (!box) return;
        const pos = getStoredQuotePosition();
        if (!pos) {
            box.style.left = '1rem';
            box.style.bottom = '1rem';
            box.style.right = 'auto';
            box.style.top = 'auto';
            return;
        }
        box.style.left = pos.x + 'px';
        box.style.top = pos.y + 'px';
        box.style.right = 'auto';
        box.style.bottom = 'auto';
    }

    function resetQuoteDragVisuals() {
        const box = document.getElementById('global-motivation-quote');
        const zone = document.getElementById('global-quote-dropzone');
        if (box) {
            box.style.transform = '';
            box.style.opacity = '';
        }
        if (zone) {
            zone.classList.remove('scale-110');
            zone.classList.remove('flex');
            zone.classList.add('hidden');
        }
    }

    function quoteIsOverDropzone() {
        const box = document.getElementById('global-motivation-quote');
        const zone = document.getElementById('global-quote-dropzone');
        if (!box || !zone) return false;
        const a = box.getBoundingClientRect();
        const b = zone.getBoundingClientRect();
        return !(a.right < b.left || a.left > b.right || a.bottom < b.top || a.top > b.bottom);
    }

    function bindQuoteDrag() {
        if (globalQuoteDragBound) return;
        const box = document.getElementById('global-motivation-quote');
        const zone = document.getElementById('global-quote-dropzone');
        if (!box || !zone) return;
        globalQuoteDragBound = true;

        box.addEventListener('pointerdown', function(event) {
            if (box.classList.contains('hidden')) return;
            if (event.button !== undefined && event.button !== 0) return;
            if (event.target && event.target.closest && event.target.closest('#global-quote-close')) return;
            const rect = box.getBoundingClientRect();
            box.style.left = rect.left + 'px';
            box.style.top = rect.top + 'px';
            box.style.right = 'auto';
            box.style.bottom = 'auto';
            box._rlifeStartLeft = rect.left;
            box._rlifeStartTop = rect.top;
            box._rlifeStartX = event.clientX;
            box._rlifeStartY = event.clientY;
            box.style.transition = 'none';
            box.classList.add('rlife-quote-dragging');
            box.setPointerCapture(event.pointerId);
            zone.classList.remove('hidden');
            zone.classList.add('flex');
            event.preventDefault();
        });

        box.addEventListener('pointermove', function(event) {
            if (!box.classList.contains('rlife-quote-dragging')) return;
            const dx = event.clientX - box._rlifeStartX;
            const dy = event.clientY - box._rlifeStartY;
            box.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
            if (quoteIsOverDropzone()) zone.classList.add('scale-110');
            else zone.classList.remove('scale-110');
        });

        function onDragEnd(event) {
            if (!box.classList.contains('rlife-quote-dragging')) return;
            const dx = event.clientX - box._rlifeStartX;
            const dy = event.clientY - box._rlifeStartY;
            const shouldDismiss = quoteIsOverDropzone() || (dy > 140 && dx > 50);
            if (shouldDismiss) {
                box.classList.add('hidden');
                try {
                    localStorage.setItem('rlife_quote_dismissed_until', String(Date.now() + 900000));
                } catch (e) {}
            } else {
                const startLeft = Number(box._rlifeStartLeft || 0);
                const startTop = Number(box._rlifeStartTop || 0);
                const nextLeft = startLeft + dx;
                const nextTop = startTop + dy;
                const maxLeft = Math.max(8, window.innerWidth - box.offsetWidth - 8);
                const maxTop = Math.max(8, window.innerHeight - box.offsetHeight - 8);
                const clampedLeft = Math.min(Math.max(8, nextLeft), maxLeft);
                const clampedTop = Math.min(Math.max(8, nextTop), maxTop);
                box.style.left = clampedLeft + 'px';
                box.style.top = clampedTop + 'px';
                box.style.right = 'auto';
                box.style.bottom = 'auto';
                try {
                    localStorage.setItem('rlife_quote_position', JSON.stringify({ x: clampedLeft, y: clampedTop }));
                } catch (e) {}
            }
            box.style.transform = '';
            box.style.transition = '';
            box.classList.remove('rlife-quote-dragging');
            resetQuoteDragVisuals();
        }

        box.addEventListener('pointerup', onDragEnd);
        box.addEventListener('pointercancel', onDragEnd);
    }

    function bindQuoteClose() {
        if (globalQuoteCloseBound) return;
        const closeBtn = document.getElementById('global-quote-close');
        const box = document.getElementById('global-motivation-quote');
        if (!closeBtn || !box) return;
        globalQuoteCloseBound = true;
        closeBtn.addEventListener('click', () => {
            box.classList.add('hidden');
            if (nextQuoteTimeout) {
                clearTimeout(nextQuoteTimeout);
                nextQuoteTimeout = null;
            }
            try {
                localStorage.setItem('rlife_quote_dismissed_until', String(Date.now() + 900000));
            } catch (e) {}
        });
    }

    async function loadGlobalQuote() {
        const box = document.getElementById('global-motivation-quote');
        const text = document.getElementById('global-quote-text');
        const author = document.getElementById('global-quote-author');
        if (!box || !text) return;
        applyQuotePosition();
        if (!isQuoteEnabled()) {
            box.classList.add('hidden');
            return;
        }
        const dismissedUntil = getDismissedUntil();
        if (dismissedUntil && Date.now() < dismissedUntil) {
            box.classList.add('hidden');
            return;
        }
        try {
            let quoteType = 'motivation';
            try {
                quoteType = String(localStorage.getItem('rlife_quote_type') || 'motivation').trim() || 'motivation';
            } catch (e) {}
            const response = await fetch('{{ path('app_wellbeing_motivation_quote') }}' + '?type=' + encodeURIComponent(quoteType), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                cache: 'no-store'
            });
            const data = await response.json();
            text.textContent = data.quote || 'One focused step now beats overthinking.';
            if (author) {
                const typeLabel = (quoteType || 'motivation').toUpperCase();
                author.textContent = '— ' + typeLabel;
            }
            box.classList.remove('hidden');
            bindQuoteDrag();
            bindQuoteClose();
        } catch (e) {
            box.classList.add('hidden');
        }
    }

    function initGlobalQuoteTicker() {
        if (globalQuoteTimer) {
            clearInterval(globalQuoteTimer);
            globalQuoteTimer = null;
        }
        if (nextQuoteTimeout) {
            clearTimeout(nextQuoteTimeout);
            nextQuoteTimeout = null;
        }
        resetQuoteDragVisuals();
        applyQuotePosition();
        if (!isQuoteEnabled()) {
            const box = document.getElementById('global-motivation-quote');
            if (box) box.classList.add('hidden');
            return;
        }
        loadGlobalQuote();
        globalQuoteTimer = setInterval(loadGlobalQuote, 120000);
    }

    window.applyQuotePosition = applyQuotePosition;
    window.initGlobalQuoteTicker = initGlobalQuoteTicker;
    window.initSpotifyWidget = initSpotifyWidget;
</script>

