            function bindUnlock() {
                const opts = { once: true, passive: true };
                window.addEventListener('pointerdown', unlockIfNeeded, opts);
                window.addEventListener('keydown', unlockIfNeeded, opts);
                window.addEventListener('touchstart', unlockIfNeeded, opts);
