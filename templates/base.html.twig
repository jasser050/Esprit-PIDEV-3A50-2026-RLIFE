    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">

    <title>{% block title %}RLIFE{% endblock %} | RLIFE</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%234F46E5'/%3E%3Cstop offset='100%25' stop-color='%234338CA'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='8' fill='url(%23g)'/%3E%3Cpath d='M8 10h16M8 16h12M8 22h8' stroke='white' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Three.js module preload for local/offline-safe pet 3D rendering -->
    <script type="module">
        import * as THREE from '{{ asset('vendor/three/build/three.module.min.js') }}';
        window.THREE = window.THREE || THREE;
    </script>

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% if app.user and app.user.settings %}
    <script>
        (function() {
            try {
                var accent = '{{ app.user.settings.accentColor|default("#6366f1") }}';
                if (accent && accent !== 'default') {
                    var darken = function(hex, percent) {
                        try {
                            var r = Math.max(0, parseInt(hex.slice(1, 3), 16) - Math.round(parseInt(hex.slice(1, 3), 16) * percent / 100));
                            var g = Math.max(0, parseInt(hex.slice(3, 5), 16) - Math.round(parseInt(hex.slice(3, 5), 16) * percent / 100));
                            var b = Math.max(0, parseInt(hex.slice(5, 7), 16) - Math.round(parseInt(hex.slice(5, 7), 16) * percent / 100));
                            return '#' + r.toString(16).padStart(2, '0') + g.toString(16).padStart(2, '0') + b.toString(16).padStart(2, '0');
                        } catch (e) { return hex; }
                    };
                    document.documentElement.style.setProperty('--accent', accent);
                    document.documentElement.style.setProperty('--accent-dark', darken(accent, 20));
                    var saved = localStorage.getItem('accessibility_settings');
                    var data = saved ? JSON.parse(saved) : {};
                    if (!data || typeof data !== 'object') data = {};
                    data.accentColor = accent;
                    localStorage.setItem('accessibility_settings', JSON.stringify(data));
                    localStorage.setItem('accent_color', accent);
                }
            } catch (e) {}
        })();
    </script>
    {% endif %}
    {{ encore_entry_script_tags('app') }}

    <!-- Theme + Icons init -->
    <script>
        (function() {
            var theme = localStorage.getItem('theme');
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (theme === 'dark' || (!theme && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
            window.toggleTheme = function() {
                var html = document.documentElement;
                if (html.classList.contains('dark')) {
                    html.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                } else {
                    html.classList.add('dark');
                    localStorage.setItem('theme', 'dark');
                }
            };
            window.initIcons = function() {
                if (typeof lucide !== 'undefined') lucide.createIcons();
            };
        })();
    </script>
        <!-- Pet Management Scripts -->
    <script>
        window.RLife3D = window.RLife3D || {};
        window.RLife3D.enable3D = false;
        window.RLife3D.assets = window.RLife3D.assets || {
            threeModule: '{{ asset('vendor/three/build/three.module.min.js') }}',
            objLoaderModule: '{{ asset('vendor/three/examples/jsm/loaders/OBJLoader.js') }}',
            catObj: '{{ asset('pets/cat-design/base.obj') }}',
            catDiffuse: '{{ asset('pets/cat-design/texture_diffuse.png') }}',
            catNormal: '{{ asset('pets/cat-design/texture_normal.png') }}',
            catFallback: '{{ asset('pets/cat-design/cat-avatar.jpg') }}?v=20260225-cat',
            dogObj: '{{ asset('pets/dog-design/base.obj') }}',
            dogDiffuse: '{{ asset('pets/dog-design/texture_diffuse.png') }}',
            dogNormal: '{{ asset('pets/dog-design/texture_normal.png') }}',
            dogFallback: '{{ asset('pets/dog-design/dog-avatar.jpg') }}',
            foxFallback: '{{ asset('pets/fox-avatar.jpg') }}?v=20260225-fox',
            dragonFallback: '{{ asset('pets/dragon-design/dragon-avatar.jpg') }}',
            birdFallback: '{{ asset('pets/bird-avatar.jpg') }}?v=20260225-bird3',
            hamsterFallback: '{{ asset('pets/hamster-avatar.jpg') }}',
            pandaFallback: '{{ asset('pets/panda-design/panda-avatar.jpg') }}',
            rabbitFallback: '{{ asset('pets/rabbit-avatar.jpg') }}'
        };

        window.RLife3D.ensureThree = function(callback) {
            if (window.RLife3D.enable3D !== true) {
                callback();
                return;
            }
            if (typeof THREE !== 'undefined') {
                callback();
                return;
            }

            if (!window.RLife3D._threePromise) {
                const localModule = window.RLife3D.assets?.threeModule || '/vendor/three/build/three.module.min.js';
                window.RLife3D._threePromise = import(localModule)
                    .then(function(mod) {
                        if (mod) window.THREE = mod;
                        return mod;
                    })
                    .catch(function(err) {
                        console.error('[RLife3D] Failed to load local Three.js module:', err);
                        return null;
                    });
            }

            window.RLife3D._threePromise.then(function() {
                callback();
            }).catch(function() {
                callback();
            });
        };

        window.RLife3D.ensureOBJLoader = function(callback) {
            window.RLife3D.ensureThree(function() {
                if (typeof THREE !== 'undefined' && typeof THREE.OBJLoader !== 'undefined') {
                    callback();
                    return;
                }

                if (!window.RLife3D._objLoaderPromise) {
                    const localObjLoader = window.RLife3D.assets?.objLoaderModule || '/vendor/three/examples/jsm/loaders/OBJLoader.js';
                    window.RLife3D._objLoaderPromise = import(localObjLoader)
                        .then(function(mod) {
                            if (typeof THREE !== 'undefined' && mod && mod.OBJLoader) {
                                window.THREE.OBJLoader = mod.OBJLoader;
                            }
                            return mod;
                        })
                        .catch(function(err) {
                            console.error('[RLife3D] Failed to load local OBJLoader module:', err);
                            return null;
                        });
                }

                window.RLife3D._objLoaderPromise.then(function() {
                    callback();
                }).catch(function() {
                    callback();
                });
            });
        };

        window.RLife3D.dispose = function(container) {
            const pending = container?._rlife3dPending;
            if (pending) {
                if (pending.timer) window.clearTimeout(pending.timer);
                delete container._rlife3dPending;
            }

            const state = container?._rlife3d;
            if (!state) return;

            state.isAlive = false;
            if (state.resizeObserver) state.resizeObserver.disconnect();
            if (typeof state.cleanup === 'function') state.cleanup();

            if (state.renderer) {
                state.renderer.dispose();
                if (state.renderer.domElement && state.renderer.domElement.parentNode === container) {
                    container.removeChild(state.renderer.domElement);
                }
            }

            delete container._rlife3d;
        };

        window.RLife3D.inferType = function(container, options) {
            const opts = options || {};
            if (opts.type) return String(opts.type).toLowerCase();
            if (container?.dataset?.petType) return String(container.dataset.petType).toLowerCase();
            const id = container?.id || '';
            if (id.startsWith('pet3d-')) return id.replace('pet3d-', '').toLowerCase();
            return 'cat';
        };

