    }

    @keyframes petStageFeed {
        0% { transform: scale(1); }
        40% { transform: scale(1.02); }
        100% { transform: scale(1); }
    }

    @keyframes petHungerBoost {
        0% { filter: brightness(1); transform: scaleX(1); }
        45% { filter: brightness(1.28); transform: scaleX(1.02); }
        100% { filter: brightness(1); transform: scaleX(1); }
    }

    @keyframes petBurst {
        0% { opacity: .95; transform: translate(-50%, -50%) scale(0.2); }
        100% { opacity: 0; transform: translate(-50%, -50%) translate(var(--dx, 0px), var(--dy, -30px)) scale(1.2); }
    }
</style>
