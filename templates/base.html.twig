    if (!window.RLifeAudio) {
        (function() {
            const stateKey = 'rlife_global_audio_state';
            let audio = null;
            let state = { playing: false, src: '', volume: 0.6, loop: true };

            function readState() {
                try {
                    const raw = localStorage.getItem(stateKey);
                    if (!raw) return;
                    const parsed = JSON.parse(raw);
                    state = {
                        playing: !!parsed.playing,
                        src: String(parsed.src || ''),
                        volume: Number(parsed.volume || 0.6),
                        loop: parsed.loop !== false
                    };
                } catch (e) {}
            }

            function writeState() {
                try {
                    localStorage.setItem(stateKey, JSON.stringify(state));
                } catch (e) {}
            }

            function ensureAudio() {
                if (audio) return;
                audio = new Audio();
                audio.loop = true;
                audio.volume = state.volume || 0.6;
            }

            function play(src, opts) {
                ensureAudio();
                const options = opts || {};
                if (src) {
                    audio.src = src;
                    state.src = src;
                }
                if (typeof options.volume === 'number') {
                    audio.volume = Math.min(1, Math.max(0, options.volume));
                    state.volume = audio.volume;
                }
                audio.loop = options.loop !== false;
                state.loop = audio.loop;
                state.playing = true;
                writeState();
                audio.play().catch(() => {});
            }

            function stop() {
                if (!audio) {
                    state.playing = false;
                    writeState();
                    return;
                }
                try {
                    audio.pause();
                    audio.currentTime = 0;
                } catch (e) {}
                state.playing = false;
                writeState();
