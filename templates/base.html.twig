    const safeStorage = {
        get(key) {
            try { return localStorage.getItem(key); } catch (e) {}
            try { return sessionStorage.getItem(key); } catch (e) {}
            try {
                const m = document.cookie.match(new RegExp('(?:^|; )' + encodeURIComponent(key) + '=([^;]*)'));
                return m ? decodeURIComponent(m[1]) : null;
            } catch (e) {}
            return null;
        },
        set(key, value) {
            try { localStorage.setItem(key, value); return; } catch (e) {}
            try { sessionStorage.setItem(key, value); } catch (e) {}
            try {
                document.cookie = encodeURIComponent(key) + '=' + encodeURIComponent(String(value)) + '; path=/; max-age=31536000';
            } catch (e) {}
        }
    };
