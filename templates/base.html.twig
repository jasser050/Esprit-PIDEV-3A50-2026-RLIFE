                        <button type="button"
                                class="relative p-2 rounded-xl text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                data-action="click->dropdown#toggle"
                                aria-label="Notifications">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                            {# Badge: visible only when unread > 0 #}
                            <span id="notification-badge"
                                  class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold rounded-full min-w-[18px] h-[18px] flex items-center justify-center px-1 leading-none transition-all
                                         {{ unreadCount == 0 ? 'hidden' : '' }}">
                                {{ unreadCount > 0 ? unreadCount : '' }}
                            </span>
                        </button>

                        <!-- Notifications Dropdown -->
                        <div class="absolute right-0 top-full mt-2 w-80 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg hidden overflow-hidden"
                             data-dropdown-target="menu">

                            <!-- Header -->
                            <div class="px-4 py-3.5 border-b dark:border-slate-700 sticky top-0 bg-white dark:bg-slate-900 z-10 flex items-center justify-between">
                                <h3 class="font-semibold text-slate-900 dark:text-white">Notifications</h3>
                                {% if unreadCount > 0 %}
                                <span class="text-xs font-semibold bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400 px-2 py-0.5 rounded-full">
                                    {{ unreadCount }} unread
                                </span>
                                {% endif %}
                            </div>

                            <!-- List -->
                            <div class="max-h-72 overflow-y-auto divide-y divide-slate-100 dark:divide-slate-700/50">
                                {% if app.user %}
                                    {% set notifications = notifications|slice(0, 10) %}
                                    {% if notifications|length > 0 %}
                                        {% for notif in notifications %}
                                        <a href="{{ notif.link ?: '#' }}"
                                           class="block p-4 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors {{ not notif.isRead ? 'bg-indigo-50/50 dark:bg-indigo-950/30' : '' }}"
                                           data-notification-id="{{ notif.id }}"
                                           onclick="markAsRead({{ notif.id }}); return false;">
                                            <div class="flex items-start gap-3">
                                                <!-- Icon -->
                                                <div class="w-9 h-9 rounded-full flex items-center justify-center text-lg flex-shrink-0
                                                    {{ notif.type == 'coins' ? 'bg-amber-100 dark:bg-amber-900/40' :
                                                       notif.type starts with 'deadline' ? 'bg-red-100 dark:bg-red-900/40' :
                                                       notif.type == 'project_shared' or notif.type == 'task_assigned' ? 'bg-blue-100 dark:bg-blue-900/40' :
                                                       notif.type == 'new_comment' ? 'bg-green-100 dark:bg-green-900/40' :
                                                       'bg-slate-100 dark:bg-slate-800' }}">
                                                    {% if notif.type == 'coins' %}<i data-lucide="coins" class="w-4 h-4 text-amber-600 dark:text-amber-300"></i>
                                                    {% elseif notif.type starts with 'deadline' %}<i data-lucide="alarm-clock" class="w-4 h-4 text-red-600 dark:text-red-300"></i>
                                                    {% elseif notif.type == 'project_shared' %}<i data-lucide="link" class="w-4 h-4 text-blue-600 dark:text-blue-300"></i>
                                                    {% elseif notif.type == 'task_assigned' %}<i data-lucide="clipboard-list" class="w-4 h-4 text-blue-600 dark:text-blue-300"></i>
                                                    {% elseif notif.type == 'new_comment' %}<i data-lucide="message-circle" class="w-4 h-4 text-green-600 dark:text-green-300"></i>
                                                    {% else %}<i data-lucide="bell" class="w-4 h-4 text-slate-600 dark:text-slate-300"></i>{% endif %}
                                                </div>
                                                <!-- Text -->
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm font-semibold text-slate-900 dark:text-white line-clamp-1">{{ notif.title }}</p>
                                                    <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-0.5">{{ notif.message }}</p>
                                                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">{{ notif.createdAt|date('d/m/Y H:i') }}</p>
                                                </div>
                                                <!-- Unread dot -->
                                                {% if not notif.isRead %}
                                                <div class="w-2 h-2 rounded-full bg-indigo-500 flex-shrink-0 mt-1.5"></div>
                                                {% endif %}
                                            </div>
                                        </a>
                                        {% endfor %}
                                    {% else %}
                                        <div class="py-10 text-center text-slate-400 dark:text-slate-500">
                                            <i data-lucide="bell-off" class="w-10 h-10 mx-auto mb-3 opacity-40"></i>
                                            <p class="text-sm">No new notifications</p>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <div class="py-10 text-center text-slate-400 dark:text-slate-500">
                                        <i data-lucide="bell-off" class="w-10 h-10 mx-auto mb-3 opacity-40"></i>
                                        <p class="text-sm">No new notifications</p>
                                    </div>
                                {% endif %}
                            </div>

                            <!-- Footer -->
                            <div class="px-4 py-3 border-t dark:border-slate-700 text-center sticky bottom-0 bg-white dark:bg-slate-900 z-10">
                                <a href="{{ path('app_notifications_list') }}"
                                   class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline font-medium">
                                    View all notifications ->
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- ==================== END NOTIFICATIONS ==================== -->

                    <!-- Theme Toggle -->
                    <button type="button"
                            class="p-2 rounded-xl text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                            onclick="toggleTheme()"
                            aria-label="Toggle theme">
                        <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                        <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                    </button>

                    <!-- Profile -->
                    <div class="relative" data-controller="dropdown">
                        <button type="button"
                                class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                                data-action="click->dropdown#toggle">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-sm overflow-hidden">
                                {% if app.user and app.user.profilePic %}
                                    <img src="{% if app.user.profilePic starts with 'http' %}{{ app.user.profilePic }}{% else %}{{ asset('uploads/profiles/' ~ app.user.profilePic) }}{% endif %}" alt="Profile" class="w-full h-full object-cover">
                                {% else %}
                                    {{ app.user ? app.user.firstName|first|upper ~ app.user.lastName|first|upper : 'U' }}
                                {% endif %}
                            </div>
                            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400 hidden sm:block"></i>
                        </button>
                        <div class="absolute right-0 top-full mt-2 w-56 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-lg hidden"
                             data-dropdown-target="menu">
                            <div class="p-4 border-b border-slate-100 dark:border-slate-700">
                                <p class="font-semibold text-slate-900 dark:text-white">{{ app.user ? app.user.fullName : 'User' }}</p>
                                <p class="text-sm text-slate-500 dark:text-slate-400">{{ app.user ? app.user.email : '' }}</p>
                            </div>
                            <div class="p-2">
                                <a href="{{ path('app_settings') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                    <i data-lucide="user" class="w-4 h-4"></i> Profile Settings
                                </a>
                                <a href="#" class="flex items-center gap-3 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                                    <i data-lucide="help-circle" class="w-4 h-4"></i> Help & Support
                                </a>
                                <div class="h-px bg-slate-100 dark:bg-slate-700 my-2"></div>
                                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-3 py-2.5 text-sm text-danger-600 dark:text-danger-400 hover:bg-danger-50 dark:hover:bg-danger-900/20 rounded-lg transition-colors">
                                    <i data-lucide="log-out" class="w-4 h-4"></i> Sign Out
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </header>

        <!-- Page Content -->
        <main class="flex-1 p-4 lg:p-6">
            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<!-- ==================== TOAST CONTAINER ==================== -->
<div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2" data-controller="toast">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="toast flex items-center gap-3 px-4 py-3 rounded-xl shadow-lg animate-fade-in-up cursor-pointer
                {{ label == 'success' ? 'bg-success-500 text-white' :
                   (label == 'error' or label == 'danger') ? 'bg-danger-500 text-white' :
                   label == 'warning' ? 'bg-warning-500 text-white' :
                   'bg-primary-500 text-white' }}"
                data-toast-target="toast"
                data-action="click->toast#dismiss">
                {% if label == 'success' %}<i data-lucide="check-circle" class="w-5 h-5"></i>
                {% elseif label == 'error' or label == 'danger' %}<i data-lucide="x-circle" class="w-5 h-5"></i>
                {% elseif label == 'warning' %}<i data-lucide="alert-triangle" class="w-5 h-5"></i>
                {% else %}<i data-lucide="info" class="w-5 h-5"></i>{% endif %}
                <span class="font-medium">{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}
</div>

