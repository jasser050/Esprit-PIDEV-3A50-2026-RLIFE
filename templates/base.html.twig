<!-- Global init -->
<script>
    function rlifeRunGlobalInit() {
        window.initIcons();
        if (window.RLife3D) {
            window.RLife3D.autoInitPetScenes();
            setTimeout(() => window.RLife3D.autoInitPetScenes(), 250);
        }
        if (window.RLifeAudio && typeof window.RLifeAudio.resume === 'function') {
            window.RLifeAudio.resume();
        }
        if (typeof window.initGlobalQuoteTicker === 'function') {
            window.initGlobalQuoteTicker();
        }
        if (typeof window.initSpotifyWidget === 'function') {
            window.initSpotifyWidget();
        }
    }

    function rlifeDispatchCompatibilityReady() {
        document.dispatchEvent(new CustomEvent('rlife:ready'));
        // Compatibility shim: many project scripts only listen to DOMContentLoaded.
        document.dispatchEvent(new Event('DOMContentLoaded'));
    }

    document.addEventListener('DOMContentLoaded', function() {
        rlifeRunGlobalInit();
        console.log('Page initialized: Icons loaded');
    });
    document.addEventListener('turbo:load', function() {
        rlifeRunGlobalInit();
        rlifeDispatchCompatibilityReady();
    });
    document.addEventListener('turbo:frame-load', function() {
        rlifeRunGlobalInit();
        rlifeDispatchCompatibilityReady();
    });
    // Ensure same-origin links use Turbo to preserve Spotify across navigation.
    if (!window.RLifeTurboLinkGuard) {
        window.RLifeTurboLinkGuard = true;
        document.addEventListener('click', (event) => {
            if (!window.Turbo || typeof window.Turbo.visit !== 'function') return;
            if (event.defaultPrevented) return;
            if (event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const target = event.target;
            if (!(target instanceof Element)) return;
            const link = target.closest('a[href]');
            if (!link) return;
            if (link.hasAttribute('download')) return;
            const linkTarget = link.getAttribute('target');
            if (linkTarget && linkTarget !== '_self') return;
            if (link.getAttribute('data-turbo') === 'false') return;
            const href = link.getAttribute('href') || '';
            if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
            let url;
            try { url = new URL(href, window.location.href); } catch (e) { return; }
            if (url.origin !== window.location.origin) return;
            event.preventDefault();
            window.Turbo.visit(url.toString());
        }, true);
    }
</script>

<!-- Global Search -->
<script>
    (function() {
        'use strict';

        function initGlobalSearch() {
            const searchInput = document.getElementById('searchInput');
            const searchResults = document.getElementById('searchResults');
            const globalSearch = document.getElementById('globalSearch');
            if (!searchInput || !searchResults || !globalSearch) return;
            if (searchInput.dataset.globalSearchInit === '1') return;
            searchInput.dataset.globalSearchInit = '1';

            let searchTimeout;
            let isSearching = false;
            let lastQuery = '';
            let cachedResults = null;

            const typeLabels = { course:'Courses', project:'Projects', assignment:'Assignments', deck:'Flashcards', page:'Pages', user:'Users' };
            const typeIcons = { course:'book-open', project:'folder', assignment:'clipboard-list', deck:'layers', page:'file-text', user:'user' };

            function showLoading() {
                searchResults.innerHTML = `<div class="p-4 text-center text-slate-500 dark:text-slate-300"><i data-lucide="loader-2" class="inline-block animate-spin w-6 h-6"></i><p class="text-xs mt-2">Searching...</p></div>`;
                searchResults.classList.remove('hidden');
                window.initIcons();
            }

            function displayResults(results) {
                if (!results || results.length === 0) {
                    searchResults.innerHTML = `<div class="p-6 text-center text-slate-500 dark:text-slate-300"><i data-lucide="search-x" class="w-8 h-8 mx-auto mb-2"></i><p class="text-sm font-medium">No results found</p></div>`;
                    searchResults.classList.remove('hidden');
                    window.initIcons();
                    return;
                }
                const grouped = {};
                results.forEach(r => { if (!grouped[r.type]) grouped[r.type] = []; grouped[r.type].push(r); });
                let html = '<div class="p-2">';
                Object.keys(grouped).forEach((type, i) => {
                    if (i > 0) html += '<div class="h-px bg-slate-200 dark:bg-slate-700 my-2"></div>';
                    html += `<div class="mb-2"><p class="px-3 py-1 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase">${typeLabels[type] || type}</p>`;
                    grouped[type].forEach(result => {
                        html += `<a href="${result.url}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700/60 transition-colors">
                            <div class="w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 flex items-center justify-center text-lg"><i data-lucide="${typeIcons[result.type] || 'circle'}" class="w-4 h-4 text-slate-600 dark:text-slate-200"></i></div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate">${result.title}</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">${result.subtitle}</p>
                            </div></a>`;
                    });
                    html += '</div>';
                });
                html += '</div>';
                searchResults.innerHTML = html;
                searchResults.classList.remove('hidden');
                window.initIcons();
            }

            function performSearch(query) {
                if (isSearching) return;
                isSearching = true;
                fetch('/api/search?q=' + encodeURIComponent(query))
                    .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(data => {
                        lastQuery = query;
                        cachedResults = data.results || [];
                        displayResults(cachedResults);
                    })
                    .catch(err => {
                        searchResults.innerHTML = `<div class="p-4 text-center text-red-500 dark:text-red-300"><p class="text-sm">Search failed</p><p class="text-xs">${err.message}</p></div>`;
                        searchResults.classList.remove('hidden');
                    })
                    .finally(() => { isSearching = false; });
            }

            searchInput.addEventListener('input', function(e) {
                clearTimeout(searchTimeout);
                const query = e.target.value.trim();
                if (query.length < 2) {
                    searchResults.classList.add('hidden');
                    cachedResults = null;
                    return;
                }
                if (query === lastQuery && cachedResults) {
                    displayResults(cachedResults);
                    return;
                }
                showLoading();
                searchTimeout = setTimeout(function() { performSearch(query); }, 300);
            });

            searchInput.addEventListener('focus', function() {
                const query = searchInput.value.trim();
                if (query.length < 2) return;
                if (cachedResults && query === lastQuery) {
                    displayResults(cachedResults);
                    return;
                }
                showLoading();
                performSearch(query);
            });

            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    searchResults.classList.add('hidden');
                    searchInput.blur();
                }
            });

            if (!window.__rlifeGlobalSearchDocBound) {
                document.addEventListener('click', function(e) {
                    const currentGlobalSearch = document.getElementById('globalSearch');
                    const currentSearchResults = document.getElementById('searchResults');
                    if (currentGlobalSearch && currentSearchResults && !currentGlobalSearch.contains(e.target)) {
                        currentSearchResults.classList.add('hidden');
                    }
                });
                window.__rlifeGlobalSearchDocBound = true;
            }
        }

        document.addEventListener('DOMContentLoaded', initGlobalSearch);
        document.addEventListener('turbo:load', initGlobalSearch);
        initGlobalSearch();
    })();
</script>

<!-- Mark notification as read (AJAX) -->
<script>
    async function markAsRead(notificationId) {
        try {
            const response = await fetch(`/notifications/${notificationId}/read`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) throw new Error('Failed to mark notification as read');
            const data = await response.json();
            if (data.success) {
                // Remove unread highlight
                const el = document.querySelector(`[data-notification-id="${notificationId}"]`);
                if (el) el.classList.remove('bg-indigo-50/50', 'dark:bg-indigo-950/30');
                // Update badge count
                const badge = document.getElementById('notification-badge');
                if (badge) {
                    let count = parseInt(badge.textContent || '0') - 1;
                    if (count > 0) {
                        badge.textContent = count;
                    } else {
                        badge.textContent = '';
                        badge.classList.add('hidden');
                    }
                }
                // Follow the link after marking as read
                const link = document.querySelector(`[data-notification-id="${notificationId}"]`);
                if (link && link.getAttribute('href') && link.getAttribute('href') !== '#') {
                    window.location.href = link.getAttribute('href');
                }
            }
        } catch (error) {
            console.error('Notification mark-as-read error:', error);
        }
    }
</script>

<script>
    (function() {
        if (window.__rlifeDropdownFallbackBound) return;
        window.__rlifeDropdownFallbackBound = true;

        function getDropdownRoot(node) {
            if (!(node instanceof Element)) return null;
            return node.closest('[data-controller~="dropdown"]');
        }

        function getDropdownMenu(root) {
            if (!root) return null;
            return root.querySelector('[data-dropdown-target="menu"]');
        }

        function closeAllDropdowns() {
            document.querySelectorAll('[data-controller~="dropdown"] [data-dropdown-target="menu"]').forEach(function(menu) {
                menu.classList.add('hidden');
            });
        }

        document.addEventListener('click', function(event) {
            const target = event.target;
            const trigger = target instanceof Element ? target.closest('[data-action*="dropdown#toggle"]') : null;
            const root = getDropdownRoot(target);

            if (trigger) {
                const dropdownRoot = getDropdownRoot(trigger);
                const menu = getDropdownMenu(dropdownRoot);
                if (!menu) return;
                event.preventDefault();
                event.stopPropagation();
                const willOpen = menu.classList.contains('hidden');
                closeAllDropdowns();
                if (willOpen) menu.classList.remove('hidden');
                return;
            }

            if (!root) {
                closeAllDropdowns();
            }
        }, true);

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') closeAllDropdowns();
        });

        document.addEventListener('turbo:before-cache', function() {
            closeAllDropdowns();
        });
    })();
</script>

