<!-- Global init -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        window.initIcons();
        if (window.RLife3D) {
            window.RLife3D.autoInitPetScenes();
            setTimeout(() => window.RLife3D.autoInitPetScenes(), 250);
        }
        console.log('✅ Page initialized: Icons loaded');
    });
    document.addEventListener('turbo:load', function() {
        window.initIcons();
        if (window.RLife3D) {
            window.RLife3D.autoInitPetScenes();
            setTimeout(() => window.RLife3D.autoInitPetScenes(), 250);
        }
    });
    document.addEventListener('turbo:frame-load', function() { window.initIcons(); });
</script>

<!-- Global Search -->
<script>
    (function() {
        'use strict';
        const searchInput   = document.getElementById('searchInput');
        const searchResults = document.getElementById('searchResults');
        const globalSearch  = document.getElementById('globalSearch');
        if (!searchInput || !searchResults) return;

        let searchTimeout, isSearching = false, lastQuery = '', cachedResults = null;

        const typeLabels = { course:'📚 Courses', project:'📁 Projects', assignment:'📝 Assignments', deck:'🗂️ Flashcards', page:'📄 Pages', user:'👤 Users' };
        const typeIcons  = { course:'📚', project:'📁', assignment:'📝', deck:'🗂️', page:'📄', user:'👤' };

        searchInput.addEventListener('input', function(e) {
            clearTimeout(searchTimeout);
            const query = e.target.value.trim();
            if (query.length < 2) { searchResults.classList.add('hidden'); cachedResults = null; return; }
            if (query === lastQuery && cachedResults) { displayResults(cachedResults); return; }
            showLoading();
            searchTimeout = setTimeout(() => performSearch(query), 300);
        });

        function showLoading() {
            searchResults.innerHTML = `<div class="p-4 text-center text-slate-500"><div class="inline-block animate-spin text-2xl">⏳</div><p class="text-xs mt-2">Searching...</p></div>`;
            searchResults.classList.remove('hidden');
        }

        function performSearch(query) {
            if (isSearching) return;
            isSearching = true;
            fetch('/api/search?q=' + encodeURIComponent(query))
                .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(data => { lastQuery = query; cachedResults = data.results; displayResults(data.results); })
                .catch(err => {
                    searchResults.innerHTML = `<div class="p-4 text-center text-red-500"><p class="text-sm">Search failed</p><p class="text-xs">${err.message}</p></div>`;
                    searchResults.classList.remove('hidden');
                })
                .finally(() => { isSearching = false; });
        }

        function displayResults(results) {
            if (!results || results.length === 0) {
                searchResults.innerHTML = `<div class="p-6 text-center text-slate-500"><div class="text-4xl mb-2">🔍</div><p class="text-sm font-medium">No results found</p></div>`;
                searchResults.classList.remove('hidden');
                return;
            }
            const grouped = {};
            results.forEach(r => { if (!grouped[r.type]) grouped[r.type] = []; grouped[r.type].push(r); });
            let html = '<div class="p-2">';
            Object.keys(grouped).forEach((type, i) => {
                if (i > 0) html += '<div class="h-px bg-slate-200 dark:bg-slate-700 my-2"></div>';
                html += `<div class="mb-2"><p class="px-3 py-1 text-xs font-bold text-slate-500 uppercase">${typeLabels[type]}</p>`;
                grouped[type].forEach(result => {
                    html += `<a href="${result.url}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-slate-100 transition-colors">
                        <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-lg">${typeIcons[result.type] || '•'}</div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-slate-800 truncate">${result.title}</p>
                            <p class="text-xs text-slate-500">${result.subtitle}</p>
                        </div></a>`;
                });
                html += '</div>';
            });
            html += '</div>';
            searchResults.innerHTML = html;
            searchResults.classList.remove('hidden');
        }

        document.addEventListener('click', e => { if (globalSearch && !globalSearch.contains(e.target)) searchResults.classList.add('hidden'); });
        searchInput.addEventListener('focus', function() {
            const query = searchInput.value.trim();
            if (query.length >= 2) {
                cachedResults && query === lastQuery ? displayResults(cachedResults) : (showLoading(), performSearch(query));
            }
        });
        searchInput.addEventListener('keydown', e => {
            if (e.key === 'Escape') { searchResults.classList.add('hidden'); searchInput.blur(); }
        });
    })();
</script>

<!-- Mark notification as read (AJAX) -->
<script>
    async function markAsRead(notificationId) {
        try {
            const response = await fetch(`/notifications/${notificationId}/read`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) throw new Error('Erreur lors du marquage');
            const data = await response.json();
            if (data.success) {
                // Remove unread highlight
                const el = document.querySelector(`[data-notification-id="${notificationId}"]`);
                if (el) el.classList.remove('bg-indigo-50/50', 'dark:bg-indigo-950/30');
                // Update badge count
                const badge = document.getElementById('notification-badge');
                if (badge) {
                    let count = parseInt(badge.textContent || '0') - 1;
                    if (count > 0) {
                        badge.textContent = count;
                    } else {
                        badge.textContent = '';
                        badge.classList.add('hidden');
                    }
                }
                // Follow the link after marking as read
                const link = document.querySelector(`[data-notification-id="${notificationId}"]`);
                if (link && link.getAttribute('href') && link.getAttribute('href') !== '#') {
                    window.location.href = link.getAttribute('href');
                }
            }
        } catch (error) {
            console.error('Erreur marquage notification:', error);
        }
    }
</script>

