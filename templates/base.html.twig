<style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Inter:wght@300;400;500;600;700&display=swap');
    :root {
        --sp-green: #1DB954;
        --sp-green2: #1ed760;
        --sp-black: #121212;
        --sp-dark: #181818;
        --sp-surface: #282828;
        --sp-text: #FFFFFF;
        --sp-muted: #B3B3B3;
        --sp-radius: 16px;
    }

    .sp-widget {
        position: fixed;
        bottom: 32px;
        right: 32px;
        z-index: 9999;
        user-select: none;
        font-family: 'DM Sans', sans-serif;
        display: none;
        animation: spSlideIn .45s cubic-bezier(.34,1.4,.64,1) both;
    }
    .sp-widget.sp-visible { display: block; }
    .sp-widget.sp-sm { width: 280px; }
    .sp-widget.sp-md { width: 360px; }
    .sp-widget.sp-lg { width: 460px; }
    .sp-widget.sp-xl { width: 580px; }

    .sp-shell {
        background: var(--sp-dark);
        border-radius: var(--sp-radius);
        overflow: hidden;
        box-shadow: 0 24px 80px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.08), inset 0 1px 0 rgba(255,255,255,.06);
    }
    @keyframes spSlideIn {
        from { opacity:0; transform:translateY(40px) scale(.92); }
        to   { opacity:1; transform:translateY(0) scale(1); }
    }

    .sp-topbar {
        background: var(--sp-black);
        padding: 10px 14px 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: grab;
        border-bottom: 1px solid rgba(255,255,255,.06);
        gap: 8px;
    }
    .sp-topbar:active { cursor: grabbing; }
    .sp-drag-dots { display: flex; gap: 4px; align-items: center; flex: 0 0 auto; }
    .sp-drag-dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,.2); }
    .sp-topbar-label {
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--sp-muted);
        flex: 1;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .sp-topbar-actions { display: flex; gap: 4px; align-items: center; }
    .sp-size-btn {
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.1);
        color: var(--sp-muted);
        padding: 3px 7px;
        border-radius: 6px;
        font-size: .62rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .15s;
        line-height: 1;
    }
    .sp-size-btn:hover { background: rgba(255,255,255,.12); color: white; }
    .sp-size-btn.active { background: var(--sp-green); border-color: var(--sp-green); color: #000; }
    .sp-close-btn {
        width: 22px; height: 22px; border-radius: 50%;
        background: rgba(255,255,255,.08);
        border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        color: var(--sp-muted); font-size: .7rem; transition: all .15s; margin-left: 2px;
    }
    .sp-close-btn:hover { background: #e22134; color: white; }
    .sp-close-btn.sp-pin-active { background: var(--sp-green); color: #000; }

    .sp-playlist-row {
        background: var(--sp-black);
        padding: 8px 12px;
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }
    .sp-playlist-row.sp-list-hidden { display: none; }
    .sp-pl-btn {
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.1);
        color: var(--sp-muted);
        padding: 4px 10px;
        border-radius: 50px;
        font-size: .72rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }
    .sp-pl-btn:hover { background: rgba(255,255,255,.14); color: white; }
    .sp-pl-btn.active {
        background: var(--sp-green);
        border-color: var(--sp-green);
        color: #000;
        font-weight: 700;
        box-shadow: 0 0 12px rgba(29,185,84,.35);
    }

    .sp-embed-wrap { position: relative; overflow: hidden; background: var(--sp-black); }
    #global-spotify-iframe, #global-soundcloud-iframe { width: 100%; border: none; display: block; transition: height .35s cubic-bezier(.4,0,.2,1); }
    .sp-loading { position: absolute; inset: 0; background: var(--sp-black); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; z-index: 2; transition: opacity .4s; }
    .sp-loading.sp-hidden { opacity: 0; pointer-events: none; }
    .sp-loading-icon { width: 48px; height: 48px; }
