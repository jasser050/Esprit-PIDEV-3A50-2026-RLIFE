{% extends 'base.html.twig' %}

{% block title %}Edit: {{ deck.name }}{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Revisions', href: path('app_revisions') },
            { label: deck.name, href: path('app_revisions_deck', { id: deck.id }) },
            { label: 'Edit' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Edit Deck',
        subtitle: 'Update deck settings'
    } %}

    <form action="{{ path('app_revisions_deck_edit', { id: deck.id }) }}" method="POST" class="card p-6">
        <div class="space-y-6">
            <!-- Deck Name -->
            {% include 'components/input.html.twig' with {
                name: 'name',
                label: 'Deck Name',
                value: deck.name,
                placeholder: 'e.g., Data Structures, Organic Chemistry',
                required: true
            } %}

            <!-- Related Course -->
            {% include 'components/select.html.twig' with {
                name: 'course_id',
                label: 'Related Course',
                value: deck.course_id|default(''),
                required: true,
                options: courses|map(c => { value: c.id, label: c.name ~ ' (' ~ c.code ~ ')' })
            } %}

            <!-- Color -->
            {% include 'components/select.html.twig' with {
                name: 'color',
                label: 'Deck Color',
                value: deck.color,
                options: [
                    { value: 'indigo', label: 'Indigo (Primary)' },
                    { value: 'teal', label: 'Teal (Secondary)' },
                    { value: 'amber', label: 'Amber (Accent)' },
                    { value: 'blue', label: 'Blue' },
                    { value: 'green', label: 'Green' },
                    { value: 'red', label: 'Red' },
                    { value: 'purple', label: 'Purple' },
                    { value: 'pink', label: 'Pink' }
                ]
            } %}

            <!-- Description -->
            {% include 'components/textarea.html.twig' with {
                name: 'description',
                label: 'Description (Optional)',
                value: deck.description|default(''),
                placeholder: 'What topics does this deck cover?',
                rows: 3
            } %}

            <!-- Actions -->
            <div class="flex items-center justify-between pt-4 border-t border-light-border dark:border-dark-border">
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete Deck
                </button>
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_revisions_deck', { id: deck.id }) }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Delete Confirmation Modal -->
{% include 'components/modal.html.twig' with {
    id: 'delete-modal',
    title: 'Delete Deck',
    content: '<p class="text-light-muted dark:text-dark-muted">Are you sure you want to delete this deck? All cards in this deck will also be deleted. This action cannot be undone.</p>',
    footer: '<button type="button" class="btn btn-secondary" data-action="modal#close">Cancel</button>
             <form action="' ~ path('app_revisions_deck_delete', { id: deck.id }) ~ '" method="POST" class="inline">
                 <button type="submit" class="btn btn-danger">Delete Deck</button>
             </form>'
} %}

<script>
function confirmDelete() {
    document.getElementById('delete-modal').classList.remove('hidden');
}
</script>
{% endblock %}
