document.addEventListener('DOMContentLoaded', function() {
    const deckSearch = document.getElementById('deckSearch');
    const searchButton = document.getElementById('searchButton');
    const subjectFilter = document.getElementById('subjectFilter');
    const levelFilter = document.getElementById('levelFilter');
    const dateFrom = document.getElementById('dateFrom');
    const dateTo = document.getElementById('dateTo');
    const sortButtons = document.querySelectorAll('.sort-button');
    const resetButton = document.getElementById('resetFilters');
    const deckCards = document.querySelectorAll('.deck-card');
    const decksContainer = document.getElementById('decksContainer');
    const resultCounter = document.getElementById('resultCounter');
    const sortIndicator = document.getElementById('sortIndicator');
    const noResultsTemplate = document.getElementById('noResultsTemplate');
    
    // État courant
    let currentState = {
        search: '',
        subject: 'all',
        level: 'all',
        dateFrom: '',
        dateTo: '',
        sort: 'date-desc'
    };
    
    // Icônes pour l'indicateur de tri
    const sortIcons = {
        'date-desc': 'calendar',
        'date': 'calendar',
        'title': 'arrow-up-a-z',
        'title-desc': 'arrow-down-z-a'
    };
    
    const sortLabels = {
        'date-desc': 'Newest First',
        'date': 'Oldest First',
        'title': 'Title A-Z',
        'title-desc': 'Title Z-A'
    };
    
    // Fonction pour vérifier si une date est dans l'intervalle
    function isDateInRange(dateString, from, to) {
        if (!dateString) return false;
        
        const date = new Date(dateString);
        const fromDate = from ? new Date(from) : null;
        const toDate = to ? new Date(to) : null;
        
        if (fromDate && date < fromDate) return false;
        if (toDate && date > toDate) return false;
        
        return true;
    }
    
    // Fonction pour filtrer les decks
    function filterDecks() {
        let visibleCount = 0;
        const visibleDecks = [];
        
        deckCards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const matiere = card.getAttribute('data-matiere') || '';
            const niveau = card.getAttribute('data-niveau') || '';
            const description = card.getAttribute('data-description') || '';
            const date = card.getAttribute('data-date') || '';
            
            // Vérifier la recherche
            const searchMatch = currentState.search === '' || 
                title.includes(currentState.search) ||
                matiere.includes(currentState.search) ||
                niveau.includes(currentState.search) ||
                description.includes(currentState.search);
            
            // Vérifier le sujet
            const subjectMatch = currentState.subject === 'all' || 
                matiere === currentState.subject;
            
            // Vérifier le niveau
            const levelMatch = currentState.level === 'all' || 
                niveau === currentState.level;
            
            // Vérifier la date
            const dateMatch = isDateInRange(date, currentState.dateFrom, currentState.dateTo);
            
            // Afficher ou cacher la carte
            if (searchMatch && subjectMatch && levelMatch && dateMatch) {
                card.style.display = 'flex';
                visibleCount++;
                visibleDecks.push({
                    element: card,
                    title: title,
                    date: date
                });
            } else {
                card.style.display = 'none';
            }
        });
        
        // Trier les decks visibles
        sortDecks(visibleDecks);
        
        // Mettre à jour l'interface
        updateUI(visibleCount);
    }
    
    // Fonction pour trier les decks
    function sortDecks(decks) {
        decks.sort((a, b) => {
            switch(currentState.sort) {
                case 'date-desc':
                    return new Date(b.date) - new Date(a.date);
                case 'date':
                    return new Date(a.date) - new Date(b.date);
                case 'title':
                    return a.title.localeCompare(b.title);
                case 'title-desc':
                    return b.title.localeCompare(a.title);
                default:
                    return 0;
            }
        });
        
        // Réorganiser les cartes dans le DOM
        const gridContainer = decksContainer.querySelector('.grid');
        if (gridContainer) {
            decks.forEach(deck => {
                gridContainer.appendChild(deck.element);
            });
        }
    }
    
    // Fonction pour mettre à jour l'interface
    function updateUI(visibleCount) {
        // Mettre à jour le compteur
        resultCounter.textContent = `Showing ${visibleCount} deck${visibleCount !== 1 ? 's' : ''}`;
        
        // Mettre à jour l'indicateur de tri
        const iconName = sortIcons[currentState.sort];
        sortIndicator.innerHTML = `
            <i data-lucide="${iconName}" class="w-4 h-4"></i>
            Sorted by: ${sortLabels[currentState.sort]}
        `;
        lucide.createIcons();
        
        // Gérer l'affichage "Aucun résultat"
        const gridContainer = decksContainer.querySelector('.grid');
        if (gridContainer) {
            if (visibleCount === 0) {
                gridContainer.style.display = 'none';
                const noResults = noResultsTemplate.content.cloneNode(true);
                
                // Supprimer d'abord l'ancien message
                const existingNoResults = decksContainer.querySelector('.no-results');
                if (existingNoResults) {
                    existingNoResults.remove();
                }
                
                decksContainer.appendChild(noResults);
                
                // Ajouter l'écouteur d'événement pour effacer tout
                setTimeout(() => {
                    const clearSearchBtn = decksContainer.querySelector('#clearSearch');
                    if (clearSearchBtn) {
                        clearSearchBtn.addEventListener('click', resetAllFilters);
                    }
                    lucide.createIcons();
                }, 100);
            } else {
                gridContainer.style.display = 'grid';
                const noResultsDiv = decksContainer.querySelector('.no-results');
                if (noResultsDiv) {
                    noResultsDiv.remove();
                }
            }
        }
    }
    
    // Fonction pour réinitialiser tous les filtres
    function resetAllFilters() {
        deckSearch.value = '';
        subjectFilter.value = 'all';
        levelFilter.value = 'all';
        dateFrom.value = '';
        dateTo.value = '';
        
        // Réactiver le tri par défaut
        sortButtons.forEach(btn => btn.classList.remove('active'));
        const defaultSort = document.querySelector('.sort-button[data-sort="date-desc"]');
        if (defaultSort) defaultSort.classList.add('active');
        
        // Réinitialiser l'état
        currentState = {
            search: '',
            subject: 'all',
            level: 'all',
            dateFrom: '',
            dateTo: '',
            sort: 'date-desc'
        };
        
        // Réappliquer les filtres
        filterDecks();
    }
    
    // Écouteurs d'événements
    // Recherche
    deckSearch.addEventListener('input', function() {
        currentState.search = this.value.trim().toLowerCase();
        filterDecks();
    });
    
    searchButton.addEventListener('click', function() {
        currentState.search = deckSearch.value.trim().toLowerCase();
        filterDecks();
    });
    
    deckSearch.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            currentState.search = this.value.trim().toLowerCase();
            filterDecks();
        }
    });
    
    // Filtres
    subjectFilter.addEventListener('change', function() {
        currentState.subject = this.value;
        filterDecks();
    });
    
    levelFilter.addEventListener('change', function() {
        currentState.level = this.value;
        filterDecks();
    });
    
    dateFrom.addEventListener('change', function() {
        currentState.dateFrom = this.value;
        filterDecks();
    });
    
    dateTo.addEventListener('change', function() {
        currentState.dateTo = this.value;
        filterDecks();
    });
    
    // Tris
    sortButtons.forEach(button => {
        button.addEventListener('click', function() {
            // Retirer la classe active de tous les boutons
            sortButtons.forEach(btn => btn.classList.remove('active'));
            
            // Ajouter la classe active au bouton cliqué
            this.classList.add('active');
            
            // Mettre à jour le tri courant
            currentState.sort = this.getAttribute('data-sort');
            
            // Appliquer le tri
            filterDecks();
        });
    });
    
    // Réinitialisation
    resetButton.addEventListener('click', resetAllFilters);
    
    // Initialisation
    filterDecks();
    
    // Créer les icônes Lucide
<!-- Gamification Toast -->
<div class="fixed bottom-6 right-6 bg-white dark:bg-secondary-800 rounded-xl shadow-2xl border-l-4 border-primary-500 p-4 transform translate-x-[120%] transition-transform duration-300 z-50 max-w-sm" id="gami-toast">
    <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center text-2xl" id="gami-toast-icon">🎖</div>
        <div>
            <h4 class="font-semibold text-secondary-900 dark:text-white" id="gami-toast-title">Badge unlocked!</h4>
            <p class="text-sm text-secondary-500 dark:text-secondary-400" id="gami-toast-msg">Master Deck 🎖</p>
        </div>
    </div>
</div>

<script>
// QR Modal Functions
function showQRModal(id, title) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-modal-image');
    const loading = document.getElementById('qr-loading');
    const shareLink = document.getElementById('qr-modal-share');
    
    document.getElementById('qr-modal-title').textContent = title;
    shareLink.href = '/qr/share/' + id;
    
    img.style.display = 'none';
    loading.style.display = 'block';
    modal.classList.remove('hidden');
    
    img.onload = function() {
        img.style.display = 'block';
        loading.style.display = 'none';
    };
    
    img.onerror = function() {
        const fallback = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + 
                        encodeURIComponent(window.location.origin + '/qr/import/preview-' + id);
        if (img.src !== fallback) {
            img.src = fallback;
        } else {
            loading.innerHTML = '<p class="text-danger-500">❌ Unable to generate QR code</p>';
        }
    };
    
    img.alt = 'QR - ' + title;
    img.src = '/qr/deck/' + id;
}

function closeQRModal() {
    document.getElementById('qr-modal').classList.add('hidden');
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeQRModal();
});

// Gamification Toast
function showGamiToast(icon, title, msg) {
    const toast = document.getElementById('gami-toast');
    if (!toast) return;
    
    document.getElementById('gami-toast-icon').textContent = icon;
    document.getElementById('gami-toast-title').textContent = title;
    document.getElementById('gami-toast-msg').textContent = msg;
    
    toast.classList.remove('translate-x-[120%]');
    setTimeout(() => toast.classList.add('translate-x-[120%]'), 4000);
}

function gamiCorrectAnswer() {
    fetch('/gamification/correct-answer', { 
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(d => {
        if (!d.success) return;
        if (d.newBadges && d.newBadges.length > 0) {
            showGamiToast('🎖', 'Badge unlocked!', d.newBadges[0]);
        } else {
            showGamiToast('🎯', '+10 XP', d.message || 'Correct answer!');
        }
    })
    .catch(() => {});
}

function gamiDeckCompleted(deckId) {
    fetch('/gamification/deck-completed/' + deckId, { 
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(d => {
        if (!d.success) return;
        if (d.newBadges && d.newBadges.length > 0) {
            showGamiToast('🏆', 'Badge earned!', d.newBadges[0]);
        } else {
            showGamiToast('🏆', '+50 XP', 'Deck completed!');
        }
    })
    .catch(() => {});
}

// Load Community Scores
function loadDeckScore(deckId) {
    fetch('/rating/deck/' + deckId + '/my-rating')
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;

        const dcs = document.getElementById('dcs-' + deckId);
        if (dcs) {
            if (data.total > 0 && data.average > 0) {
                dcs.innerHTML = 
                    '<span class="text-warning-500">★</span>' +
                    '<span class="font-semibold text-warning-600 dark:text-warning-400 mx-1">' + 
                    parseFloat(data.average).toFixed(1) + '</span>' +
                    '<span class="text-secondary-400">·</span>' +
                    '<span class="text-secondary-500 ml-1">' + data.total + ' rating' + (data.total > 1 ? 's' : '') + '</span>';
            } else {
                dcs.innerHTML = '<span class="text-secondary-400">No ratings yet</span>';
            }
        }

        if (data.userStars) {
            const labelEl = document.getElementById('rate-btn-label-' + deckId);
            const starsEl = document.getElementById('rate-btn-stars-' + deckId);
            const badgeEl = document.getElementById('rate-badge-' + deckId);

            if (labelEl) labelEl.textContent = 'My rating';
            if (badgeEl) {
                badgeEl.textContent = data.userStars + '★';
                badgeEl.classList.add('inline');
            }
            if (starsEl) {
                starsEl.querySelectorAll('.btn-mini-star').forEach((s, i) => {
                    s.className = i < data.userStars ? 'btn-mini-star text-warning-400' : 'btn-mini-star text-white/30';
                });
            }
        }
    })
    .catch(() => {
        const dcs = document.getElementById('dcs-' + deckId);
        if (dcs) dcs.innerHTML = '';
    });
}

// Search & Filter
document.addEventListener('DOMContentLoaded', function() {
    // Load scores
    document.querySelectorAll('[id^="rate-btn-"]').forEach(btn => {
        const id = btn.id.replace('rate-btn-', '');
        if (id) loadDeckScore(id);
    });

    const DS = document.getElementById('deckSearch');
    const SF = document.getElementById('subjectFilter');
    const LF = document.getElementById('levelFilter');
    const DF = document.getElementById('dateFrom');
    const DT = document.getElementById('dateTo');
    const SORTS = document.querySelectorAll('.sort-button');
    const RESET = document.getElementById('resetFilters');
    const CARDS = document.querySelectorAll('.deck-card');
    const CONT = document.getElementById('decksContainer');
    const RC = document.getElementById('resultCounter');
    const SI = document.getElementById('sortIndicator');
    const NRT = document.getElementById('noResultsTemplate');

    let state = { search: '', subject: 'all', level: 'all', dateFrom: '', dateTo: '', sort: 'date-desc' };
    const sicons = { 'date-desc': 'calendar', 'date': 'calendar', 'title': 'arrow-up-a-z', 'title-desc': 'arrow-down-z-a' };
    const slabels = { 'date-desc': 'Newest First', 'date': 'Oldest First', 'title': 'Title A-Z', 'title-desc': 'Title Z-A' };

    function inRange(ds, from, to) {
        if (!ds) return false;
        const d = new Date(ds);
        if (from && d < new Date(from)) return false;
        if (to && d > new Date(to)) return false;
        return true;
    }

    function filter() {
        let visibleCount = 0;
        let visibleDecks = [];

        CARDS.forEach(c => {
            const t = c.getAttribute('data-title') || '';
            const m = c.getAttribute('data-matiere') || '';
            const n = c.getAttribute('data-niveau') || '';
            const de = c.getAttribute('data-description') || '';
            const dt = c.getAttribute('data-date') || '';
            
            const searchMatch = state.search === '' || 
                t.includes(state.search) || 
                m.includes(state.search) || 
                n.includes(state.search) || 
                de.includes(state.search);
            
            const subjectMatch = state.subject === 'all' || m === state.subject;
            const levelMatch = state.level === 'all' || n === state.level;
            const dateMatch = inRange(dt, state.dateFrom, state.dateTo);
            
            const ok = searchMatch && subjectMatch && levelMatch && dateMatch;
            
            if (ok) {
                c.style.display = 'flex';
                visibleCount++;
                visibleDecks.push({ element: c, title: t, date: dt });
            } else {
                c.style.display = 'none';
            }
        });

        sortCards(visibleDecks);
        updateUI(visibleCount);
    }

    function sortCards(decks) {
        decks.sort((a, b) => {
            switch(state.sort) {
                case 'date-desc': return new Date(b.date) - new Date(a.date);
                case 'date': return new Date(a.date) - new Date(b.date);
                case 'title': return a.title.localeCompare(b.title);
                case 'title-desc': return b.title.localeCompare(a.title);
                default: return 0;
            }
        });
        
        const grid = CONT.querySelector('.grid');
        if (grid) {
            decks.forEach(d => grid.appendChild(d.element));
        }
    }

    function updateUI(visibleCount) {
        RC.textContent = 'Showing ' + visibleCount + ' deck' + (visibleCount !== 1 ? 's' : '');
        SI.innerHTML = '<i data-lucide="' + sicons[state.sort] + '" class="w-4 h-4 mr-1"></i> Sorted by: ' + slabels[state.sort];
        lucide.createIcons();

        const grid = CONT.querySelector('.grid');
        if (!grid) return;

        if (visibleCount === 0) {
            grid.style.display = 'none';
            const nr = NRT.content.cloneNode(true);
            const existing = CONT.querySelector('.no-results');
            if (existing) existing.remove();
            CONT.appendChild(nr);
            setTimeout(() => {
                const cb = CONT.querySelector('#clearSearch');
                if (cb) cb.addEventListener('click', resetAll);
                lucide.createIcons();
            }, 100);
        } else {
            grid.style.display = 'grid';
            const nr = CONT.querySelector('.no-results');
            if (nr) nr.remove();
        }
    }

    function resetAll() {
        DS.value = '';
        SF.value = 'all';
        LF.value = 'all';
        DF.value = '';
        DT.value = '';
        
        SORTS.forEach(b => b.classList.remove('active'));
        const def = document.querySelector('.sort-button[data-sort="date-desc"]');
        if (def) def.classList.add('active');
        
        state = { search: '', subject: 'all', level: 'all', dateFrom: '', dateTo: '', sort: 'date-desc' };
        filter();
    }

    DS.addEventListener('input', () => {
        state.search = DS.value.trim().toLowerCase();
        filter();
    });

    DS.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            state.search = DS.value.trim().toLowerCase();
            filter();
        }
    });

    SF.addEventListener('change', () => {
        state.subject = SF.value;
        filter();
    });

    LF.addEventListener('change', () => {
        state.level = LF.value;
        filter();
    });

    DF.addEventListener('change', () => {
        state.dateFrom = DF.value;
        filter();
    });

    DT.addEventListener('change', () => {
        state.dateTo = DT.value;
        filter();
    });

    SORTS.forEach(b => {
        b.addEventListener('click', function() {
            SORTS.forEach(x => x.classList.remove('active'));
            b.classList.add('active');
            state.sort = b.getAttribute('data-sort');
            filter();
        });
    });

    RESET.addEventListener('click', resetAll);
    
    // Initialize active sort button
    SORTS.forEach(b => b.classList.remove('active'));
    document.querySelector('.sort-button[data-sort="date-desc"]')?.classList.add('active');
    
    filter();
    lucide.createIcons();
});
</script>
