{% extends 'base.html.twig' %}

{% block title %}Revisions{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Page Header -->
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Revisions</h1>
        <p class="text-secondary-500 dark:text-secondary-400 mt-1">Study with flashcards and spaced repetition</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <i data-lucide="layers" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ decks|length }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Decks</p>
            </div>
        </div>
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                <i data-lucide="check-circle" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
            </div>
            <div>
                {% set total_mastered = 0 %}
                {% for deck in decks %}{% set total_mastered = total_mastered + deck.masteredCount %}{% endfor %}
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ total_mastered }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Cards Mastered</p>
            </div>
        </div>
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                <i data-lucide="inbox" class="w-5 h-5 text-accent-600 dark:text-accent-400"></i>
            </div>
            <div>
                {% set total_cards = 0 %}
                {% for deck in decks %}{% set total_cards = total_cards + deck.cardCount %}{% endfor %}
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ total_cards }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Cards</p>
            </div>
        </div>
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                <i data-lucide="flame" class="w-5 h-5 text-warning-600 dark:text-warning-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ due_today|default(12) }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Due Today</p>
            </div>
        </div>
    </div>

    <!-- Due Today Section -->
    {% if due_today|default(0) > 0 %}
    <div class="card p-5 bg-gradient-to-r from-primary-500 to-primary-600">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center">
                    <i data-lucide="brain" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-white">Ready to review?</h3>
                    <p class="text-primary-100">You have {{ due_today|default(12) }} cards due for review today</p>
                </div>
            </div>
            <button class="btn bg-white text-primary-600 hover:bg-primary-50">
                <i data-lucide="play" class="w-5 h-5"></i>
                Start Session
            </button>
        </div>
    </div>
    {% endif %}

    <!-- Decks Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {% for deck in decks %}
        <div class="card card-hover overflow-hidden group">
            <!-- Deck Image -->
            {% if deck.image %}
            <div class="w-full h-20 overflow-hidden bg-slate-100 dark:bg-slate-800">
                <img src="{{ asset('uploads/decks/' ~ deck.image) }}" alt="{{ deck.titre }}" class="w-full h-full object-cover">
            </div>
            {% else %}
            <div class="w-full h-20 bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center">
                <i data-lucide="layers" class="w-10 h-10 text-white/80"></i>
            </div>
            {% endif %}
            
            <div class="p-5">
                <div class="flex items-start justify-between mb-4">
                    <span class="text-sm text-secondary-500 dark:text-secondary-400 flex items-center gap-1">
                        <i data-lucide="clock" class="w-3 h-3"></i>
                        {{ deck.dateCreation|date('Y-m-d') }}
                    </span>
                </div>

                <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{{ deck.titre }}</h3>
                <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-4 flex items-center gap-1.5">
                    <i data-lucide="book-open" class="w-3 h-3"></i>
                    {{ deck.matiere }}
                </p>

                <div class="flex items-center gap-3 mb-5">
                    <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-secondary-100 dark:bg-secondary-800 text-secondary-600 dark:text-secondary-400 text-sm">
                        <i data-lucide="inbox" class="w-3 h-3"></i>
                        {{ deck.cardCount }} cards
                    </span>
                    <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-success-100 dark:bg-success-900/30 text-success-600 dark:text-success-400 text-sm">
                        <i data-lucide="check" class="w-3 h-3"></i>
                        {{ deck.masteredCount }} mastered
                    </span>
                </div>

                <div class="space-y-2 mb-5">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-secondary-500 dark:text-secondary-400">Progress</span>
                        <span class="font-semibold text-secondary-900 dark:text-white">{{ deck.cardCount > 0 ? ((deck.masteredCount / deck.cardCount) * 100)|round : 0 }}%</span>
                    </div>
                    <div class="progress-bar">
                        {% set progress = deck.cardCount > 0 ? (deck.masteredCount / deck.cardCount) * 100 : 0 %}
                        {% if progress < 30 %}
                            <div class="progress-bar-fill" style="width: {{ progress }}%; background: linear-gradient(to right, #ef4444, #f87171);"></div>
                        {% elseif progress < 70 %}
                            <div class="progress-bar-fill" style="width: {{ progress }}%; background: linear-gradient(to right, #eab308, #facc15);"></div>
                        {% else %}
                            <div class="progress-bar-fill" style="width: {{ progress }}%; background: linear-gradient(to right, #22c55e, #4ade80);"></div>
                        {% endif %}
                    </div>
                </div>

                <a href="{{ path('app_revisions_deck_study', {id: deck.id}) }}" class="btn btn-primary w-full">
                    <i data-lucide="play-circle" class="w-5 h-5"></i>
                    Study Now
                </a>
            </div>
        </div>
        {% else %}
        <div class="col-span-full">
            <div class="card">
                <div class="empty-state py-16">
                    <i data-lucide="layers-2" class="w-16 h-16 empty-state-icon"></i>
                    <p class="empty-state-title">No decks yet</p>
                    <p class="empty-state-description">Create your first flashcard deck to start studying with spaced repetition</p>
                    <a href="{{ path('app_revisions_deck_new') }}" class="btn btn-primary mt-4">
                        <i data-lucide="plus" class="w-5 h-5"></i>
                        Create Your First Deck
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
