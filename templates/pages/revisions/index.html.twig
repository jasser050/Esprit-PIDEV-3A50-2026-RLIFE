{% extends 'base.html.twig' %}

{% block title %}Revisions{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">

    <!-- Page Header -->
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Revisions</h1>
        <p class="text-secondary-500 dark:text-secondary-400 mt-1">Track and manage your Review</p>
    </div>

    <!-- Stats Overview Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                    <i data-lucide="calendar-clock" class="w-8 h-8 text-warning-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">3</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Assignments due</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                    <i data-lucide="clock" class="w-8 h-8 text-success-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">5</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Hours per day this week</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-8 h-8 text-primary-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">+3</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Study time this week</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                    <i data-lucide="layers" class="w-8 h-8 text-accent-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">45</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Cards reviewed</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Gamification Banner -->
    {% if gamification is defined and gamification %}
    <div class="card overflow-hidden border-0" style="background:linear-gradient(135deg,#16a34a 0%,#15803d 50%,#166534 100%);">
        <div class="p-5">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl flex items-center justify-center" style="background:rgba(255,255,255,0.2);">
                        <span class="text-3xl">🎓</span>
                    </div>
                    <div>
                        <p class="text-sm" style="color:#bbf7d0;">Your progress</p>
                        <h3 class="text-2xl font-bold text-white">Level {{ gamification.level }} <span style="color:#bbf7d0;">⭐</span></h3>
                        <p class="text-sm" style="color:#86efac;">{{ gamification.points }} XP total</p>
                    </div>
                </div>
                <div class="flex items-center gap-6 flex-wrap">
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">🔥 {{ gamification.streak }}</p>
                        <p class="text-xs" style="color:#86efac;">Day streak</p>
                    </div>
                    <div class="w-px h-8" style="background:rgba(255,255,255,0.3);"></div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">{{ gamification.totalDecksCompleted }}</p>
                        <p class="text-xs" style="color:#86efac;">Decks done</p>
                    </div>
                    <div class="w-px h-8" style="background:rgba(255,255,255,0.3);"></div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">{{ gamification.totalCorrectAnswers }}</p>
                        <p class="text-xs" style="color:#86efac;">Correct</p>
                    </div>
                </div>
                <div class="flex-1 min-w-[200px]">
                    {% set currentLevelXp = (gamification.level - 1) * 100 %}
                    {% set nextLevelXp = gamification.level * 100 %}
                    {% set progress = gamification.points > currentLevelXp ? ((gamification.points - currentLevelXp) / (nextLevelXp - currentLevelXp) * 100)|round : 0 %}
                    {% set progress = progress > 100 ? 100 : progress %}
                    <div class="flex justify-between text-xs mb-2">
                        <span style="color:#bbf7d0;">Level {{ gamification.level }}</span>
                        <span style="color:#4ade80;">{{ progress }}% → Lvl {{ gamification.level + 1 }}</span>
                    </div>
                    <div class="h-2 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.2);">
                        <div class="h-full rounded-full transition-all duration-500" style="width:{{ progress }}%;background:#4ade80;"></div>
                    </div>
                </div>
                <a href="{{ path('gamification_dashboard') }}" class="btn border-0 text-white font-semibold" style="background:rgba(255,255,255,0.2);">
                    <i data-lucide="trophy" class="w-4 h-4"></i>
                    Full Dashboard
                </a>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Search and Filters -->
    <div class="card overflow-hidden">
        <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="search" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                </div>
                <h2 class="font-semibold text-secondary-900 dark:text-white">Search Decks</h2>
            </div>
        </div>
        <div class="p-5 space-y-4">
            <div class="relative">
                <input type="text" id="deckSearch" placeholder="Search decks by title, subject, level or description..."
                       class="w-full px-4 py-3 pl-12 border border-secondary-300 dark:border-secondary-700 rounded-xl bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                <i data-lucide="search" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-secondary-400"></i>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Subject</label>
                    <select id="subjectFilter" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <option value="all">All Subjects</option>
                        {% set subjects = [] %}
                        {% for deck in decks %}{% if deck.matiere not in subjects %}{% set subjects = subjects|merge([deck.matiere]) %}{% endif %}{% endfor %}
                        {% for subject in subjects|sort %}<option value="{{ subject|lower }}">{{ subject }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Level</label>
                    <select id="levelFilter" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <option value="all">All Levels</option>
                        {% set levels = [] %}
                        {% for deck in decks %}{% if deck.niveau not in levels %}{% set levels = levels|merge([deck.niveau]) %}{% endif %}{% endfor %}
                        {% for level in levels|sort %}<option value="{{ level|lower }}">{{ level }}</option>{% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Date From</label>
                    <input type="date" id="dateFrom" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Date To</label>
                    <input type="date" id="dateTo" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
                <div class="flex items-center gap-3">
                    <span class="text-sm font-medium text-secondary-700 dark:text-secondary-300">Sort by:</span>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:border-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-all active" data-sort="date-desc">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>Newest
                        </button>
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:border-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-all" data-sort="date">
                            <i data-lucide="calendar" class="w-4 h-4 inline mr-1"></i>Oldest
                        </button>
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:border-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-all" data-sort="title">
                            <i data-lucide="arrow-up-a-z" class="w-4 h-4 inline mr-1"></i>A-Z
                        </button>
                        <button type="button" class="sort-button px-3 py-1.5 rounded-lg text-sm font-medium border border-secondary-300 dark:border-secondary-700 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:border-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-all" data-sort="title-desc">
                            <i data-lucide="arrow-down-z-a" class="w-4 h-4 inline mr-1"></i>Z-A
                        </button>
                    </div>
                </div>
                <button type="button" id="resetFilters" class="btn btn-secondary">
                    <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                    Reset All
                </button>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-secondary-200 dark:border-secondary-800">
                <div id="resultCounter" class="text-sm font-medium text-secondary-600 dark:text-secondary-400">
                    Showing {{ decks|length }} deck{% if decks|length != 1 %}s{% endif %}
                </div>
                <div id="sortIndicator" class="text-sm text-primary-600 dark:text-primary-400 flex items-center gap-1">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    Sorted by: Newest First
                </div>
            </div>
        </div>
    </div>

    <!-- Decks Grid -->
    <div id="decksContainer">
        {% if decks is empty %}
            <div class="card p-12 text-center">
                <i data-lucide="layers" class="w-20 h-20 mx-auto text-secondary-300 dark:text-secondary-600 mb-6"></i>
                <h3 class="text-2xl font-semibold text-secondary-900 dark:text-white mb-3">No decks available</h3>
                <p class="text-secondary-600 dark:text-secondary-400">Connect to create or view your decks</p>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

                {% set colorPalettes = [
                    {bg:'#fef9c3', border:'#eab308', text:'#a16207', icon:'#ca8a04'},
                    {bg:'#dbeafe', border:'#3b82f6', text:'#1d4ed8', icon:'#2563eb'},
                    {bg:'#fce7f3', border:'#ec4899', text:'#9d174d', icon:'#db2777'},
                    {bg:'#dcfce7', border:'#22c55e', text:'#15803d', icon:'#16a34a'},
                    {bg:'#ede9fe', border:'#8b5cf6', text:'#5b21b6', icon:'#7c3aed'},
                    {bg:'#ffe4e6', border:'#f43f5e', text:'#be123c', icon:'#e11d48'},
                    {bg:'#f3e8ff', border:'#a855f7', text:'#7e22ce', icon:'#9333ea'},
                    {bg:'#ccfbf1', border:'#14b8a6', text:'#0f766e', icon:'#0d9488'},
                    {bg:'#fef3c7', border:'#f59e0b', text:'#b45309', icon:'#d97706'},
                    {bg:'#fce7f3', border:'#f472b6', text:'#9d174d', icon:'#ec4899'},
                    {bg:'#bfdbfe', border:'#60a5fa', text:'#1e40af', icon:'#3b82f6'},
                    {bg:'#c7d2fe', border:'#818cf8', text:'#3730a3', icon:'#6366f1'}
                ] %}

                {% for deck in decks %}
                    {% set palette = colorPalettes[loop.index0 % colorPalettes|length] %}
                    {% set mastered = 0 %}
                    {% for flashcard in deck.flashcards %}
                        {% if flashcard.niveauDifficulte == 4 %}{% set mastered = mastered + 1 %}{% endif %}
                    {% endfor %}
                    {% set progressPct = deck.flashcards|length > 0 ? ((mastered / deck.flashcards|length) * 100)|round : 0 %}

                    <div class="deck-card card hover:shadow-xl transition-all duration-300 group flex flex-col h-full overflow-hidden"
                         data-title="{{ deck.titre|lower }}"
                         data-matiere="{{ deck.matiere|lower }}"
                         data-niveau="{{ deck.niveau|lower }}"
                         data-description="{{ deck.description|lower }}"
                         data-date="{{ deck.dateCreation ? deck.dateCreation|date('Y-m-d') : '' }}">

                        {# ── Bannière top ── #}
                        <div class="h-16 overflow-hidden relative flex-shrink-0">
                            {% if deck.image %}
                                <img src="{{ asset('uploads/decks/' ~ deck.image) }}" alt="{{ deck.titre }}"
                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                            {% else %}
                                <div class="w-full h-full"
                                     style="background:linear-gradient(135deg,{{ palette.bg }},{{ palette.border }}88);"></div>
                            {% endif %}
                        </div>

                        {# ── Corps ── #}
                        <div class="p-5 flex-1 flex flex-col">

                            {# Icône style rounded-square coloré + date #}
                            <div class="flex items-start justify-between mb-3 -mt-10">
                                <div class="w-14 h-14 rounded-2xl shadow-lg flex items-center justify-center border-2 border-white dark:border-secondary-900"
                                     style="background-color:{{ palette.bg }};">
                                    <i data-lucide="layers" class="w-7 h-7" style="color:{{ palette.icon }};"></i>
                                </div>
                                <span class="mt-10 text-xs text-secondary-400 dark:text-secondary-500 font-medium">
                                    {{ deck.dateCreation ? deck.dateCreation|date('d/m/Y') : '—' }}
                                </span>
                            </div>

                            {# Titre #}
                            <h3 class="text-lg font-bold mb-1 line-clamp-2" style="color:{{ palette.text }};">
                                {{ deck.titre }}
                            </h3>

                            {# Matière • Niveau #}
                            <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-3 flex items-center gap-1.5">
                                <i data-lucide="book-open" class="w-3.5 h-3.5 shrink-0"></i>
                                {{ deck.matiere }} • {{ deck.niveau }}
                            </p>

                            {# Description #}
                            <p class="text-sm text-secondary-400 dark:text-secondary-500 mb-4 line-clamp-2 leading-relaxed">
                                {{ deck.description ?: 'No description available' }}
                            </p>

                            {# Badges cards / mastered #}
                            <div class="flex items-center gap-2 mb-4">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold"
                                      style="background-color:{{ palette.bg }};color:{{ palette.text }};border:1.5px solid {{ palette.border }};">
                                    <i data-lucide="layers" class="w-3 h-3"></i>
                                    {{ deck.flashcards|length }} cards
                                </span>
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold"
                                      style="background-color:#f0fdf4;color:#15803d;border:1.5px solid #86efac;">
                                    <i data-lucide="check-circle" class="w-3 h-3"></i>
                                    {{ mastered }} mastered
                                </span>
                            </div>

                            {# Progress bar #}
                            <div class="mb-5">
                                <div class="flex justify-between items-center mb-1.5">
                                    <span class="text-xs font-medium text-secondary-500 dark:text-secondary-400">Progress</span>
                                    <span class="text-xs font-bold" style="color:{{ palette.text }};">{{ progressPct }}%</span>
                                </div>
                                <div class="w-full bg-secondary-100 dark:bg-secondary-700 rounded-full h-2 overflow-hidden">
                                    <div class="h-full rounded-full transition-all duration-500"
                                         style="width:{{ progressPct }}%;background-color:{{ palette.icon }};"></div>
                                </div>
                            </div>

                            {# ══ BOUTONS — tous identiques: h-11 rounded-xl text-sm font-semibold ══ #}
                            <div class="mt-auto space-y-2">

                                {# Rangée 1 : Rate | Study #}
                                <div class="grid grid-cols-2 gap-2">

                                    {# Rate — fond violet dégradé, texte blanc #}
                                    <a href="{{ path('app_rating_page', {deckId: deck.id}) }}"
                                       id="rate-btn-{{ deck.id }}"
                                       class="flex items-center justify-center gap-1.5 h-11 rounded-xl text-sm font-semibold text-white transition-opacity hover:opacity-90"
                                       style="background:linear-gradient(135deg,#7c3aed,#6d28d9);">
                                        <span class="shrink-0">⭐</span>
                                        <span id="rate-btn-label-{{ deck.id }}">Rate</span>
                                        <span class="hidden text-xs font-bold" id="rate-badge-{{ deck.id }}"></span>
                                    </a>

                                    {# Study — fond couleur palette, texte blanc #}
                                    <a href="{{ path('app_revisions_deck_study', {id: deck.id}) }}"
                                       class="flex items-center justify-center gap-1.5 h-11 rounded-xl text-sm font-semibold text-white transition-opacity hover:opacity-90"
                                       style="background-color:{{ palette.icon }};">
                                        <i data-lucide="play-circle" class="w-4 h-4 shrink-0"></i>
                                        <span>Study</span>
                                    </a>
                                </div>

                                {# Rangée 2 : QR Code | Add card
                                   MÊME style exact que Rate/Study :
                                   h-11 · rounded-xl · text-sm · font-semibold · texte blanc
                                   Seule différence : couleurs différentes #}
                                <div class="grid grid-cols-2 gap-2">

                                    {# QR Code — fond gris ardoise, texte blanc #}
                                    <button type="button"
                                            onclick="showQRModal({{ deck.id }}, '{{ deck.titre|e('js') }}')"
                                            class="flex items-center justify-center gap-1.5 h-11 rounded-xl text-sm font-semibold text-white transition-opacity hover:opacity-90"
                                            style="background:linear-gradient(135deg,#475569,#334155);">
                                        <i data-lucide="qr-code" class="w-4 h-4 shrink-0"></i>
                                        <span>QR Code</span>
                                    </button>

                                    {# Add card — dégradé vert émeraude distinct de Study #}
                                    <a href="{{ path('app_flashcard_new', {deck_id: deck.id}) }}"
                                       class="flex items-center justify-center gap-1.5 h-11 rounded-xl text-sm font-semibold text-white transition-opacity hover:opacity-90"
                                       style="background:linear-gradient(135deg,#059669,#047857);">
                                        <i data-lucide="plus-circle" class="w-4 h-4 shrink-0"></i>
                                        <span>Add card</span>
                                    </a>
                                </div>

                            </div>
                            {# ══ FIN BOUTONS ══ #}

                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <!-- No Results Template -->
    <template id="noResultsTemplate">
        <div class="card p-12 text-center no-results">
            <i data-lucide="search-x" class="w-20 h-20 mx-auto text-secondary-300 dark:text-secondary-600 mb-6"></i>
            <h3 class="text-2xl font-semibold text-secondary-900 dark:text-white mb-3">No results found</h3>
            <p class="text-secondary-600 dark:text-secondary-400 mb-6">Try adjusting your filters or search terms</p>
            <button type="button" id="clearSearch" class="btn btn-secondary mx-auto">
                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                Clear all filters
            </button>
        </div>
    </template>
</div>

<!-- QR Modal -->
<div class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center hidden z-50"
     id="qr-modal" onclick="if(event.target===this)closeQRModal()">
    <div class="bg-white dark:bg-secondary-800 rounded-2xl max-w-md w-full mx-4 shadow-2xl animate-fade-in">
        <div class="p-6 text-center">
            <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-1" id="qr-modal-title">Share this deck</h3>
            <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-6">Scan to import instantly</p>
            <div class="bg-secondary-100 dark:bg-secondary-700 rounded-xl p-4 mb-6">
                <img id="qr-modal-image" src="" alt="QR Code" class="mx-auto rounded-lg max-w-full h-auto" style="display:none;">
                <div id="qr-loading" class="py-8 text-center">
                    <div class="inline-block w-8 h-8 border-4 border-primary-500 border-t-transparent rounded-full animate-spin mb-3"></div>
                    <p class="text-sm text-secondary-600 dark:text-secondary-400">Generating QR Code...</p>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
                <a id="qr-modal-share" href="#" class="btn btn-primary flex-1 justify-center">
                    <i data-lucide="share-2" class="w-4 h-4 mr-2"></i>Share Options
                </a>
                <button type="button" onclick="closeQRModal()" class="btn btn-secondary flex-1 justify-center">
                    <i data-lucide="x" class="w-4 h-4 mr-2"></i>Close
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Gamification Toast -->
<div class="fixed bottom-6 right-6 bg-white dark:bg-secondary-800 rounded-xl shadow-2xl border-l-4 border-primary-500 p-4 transform translate-x-[120%] transition-transform duration-300 z-50 max-w-sm"
     id="gami-toast">
    <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center text-2xl" id="gami-toast-icon">🎖</div>
        <div>
            <h4 class="font-semibold text-secondary-900 dark:text-white" id="gami-toast-title">Badge unlocked!</h4>
            <p class="text-sm text-secondary-500 dark:text-secondary-400" id="gami-toast-msg">Master Deck 🎖</p>
        </div>
    </div>
</div>

<script>
/* ── QR Modal ── */
function showQRModal(id, title) {
    const modal   = document.getElementById('qr-modal');
    const img     = document.getElementById('qr-modal-image');
    const loading = document.getElementById('qr-loading');
    const share   = document.getElementById('qr-modal-share');
    document.getElementById('qr-modal-title').textContent = title;
    share.href = '/qr/share/' + id;
    img.style.display = 'none';
    loading.style.display = 'block';
    modal.classList.remove('hidden');
    img.onload  = () => { img.style.display = 'block'; loading.style.display = 'none'; };
    img.onerror = () => {
        const fb = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' +
                   encodeURIComponent(window.location.origin + '/qr/import/preview-' + id);
        if (img.src !== fb) { img.src = fb; }
        else { loading.innerHTML = '<p style="color:#ef4444;">❌ Unable to generate QR code</p>'; }
    };
    img.alt = 'QR - ' + title;
    img.src = '/qr/deck/' + id;
}
function closeQRModal() { document.getElementById('qr-modal').classList.add('hidden'); }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeQRModal(); });

/* ── Gamification Toast ── */
function showGamiToast(icon, title, msg) {
    const toast = document.getElementById('gami-toast');
    if (!toast) return;
    document.getElementById('gami-toast-icon').textContent  = icon;
    document.getElementById('gami-toast-title').textContent = title;
    document.getElementById('gami-toast-msg').textContent   = msg;
    toast.classList.remove('translate-x-[120%]');
    setTimeout(() => toast.classList.add('translate-x-[120%]'), 4000);
}
function gamiCorrectAnswer() {
    fetch('/gamification/correct-answer', { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'} })
    .then(r=>r.json()).then(d => {
        if (!d.success) return;
        showGamiToast(d.newBadges?.length ? '🎖':'🎯',
                      d.newBadges?.length ? 'Badge unlocked!':'+10 XP',
                      d.newBadges?.[0] ?? d.message ?? 'Correct!');
    }).catch(()=>{});
}
function gamiDeckCompleted(deckId) {
    fetch('/gamification/deck-completed/'+deckId, { method:'POST', headers:{'X-Requested-With':'XMLHttpRequest'} })
    .then(r=>r.json()).then(d => {
        if (!d.success) return;
        showGamiToast('🏆', d.newBadges?.length ? 'Badge earned!':'+50 XP',
                      d.newBadges?.[0] ?? 'Deck completed!');
    }).catch(()=>{});
}

/* ── Rating : met à jour le bouton Rate uniquement ── */
function loadDeckRating(deckId) {
    fetch('/rating/deck/' + deckId + '/my-rating')
    .then(r => r.json())
    .then(data => {
        if (!data.success || !data.userStars) return;
        const labelEl = document.getElementById('rate-btn-label-' + deckId);
        const badgeEl = document.getElementById('rate-badge-' + deckId);
        if (labelEl) labelEl.textContent = 'My rating';
        if (badgeEl) { badgeEl.textContent = data.userStars + '★'; badgeEl.classList.remove('hidden'); }
    })
    .catch(() => {});
}

/* ── Search & Filter ── */
document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('[id^="rate-btn-"]').forEach(btn => {
        const id = btn.id.replace('rate-btn-', '');
        if (id) loadDeckRating(id);
    });

    const DS    = document.getElementById('deckSearch');
    const SF    = document.getElementById('subjectFilter');
    const LF    = document.getElementById('levelFilter');
    const DF    = document.getElementById('dateFrom');
    const DT    = document.getElementById('dateTo');
    const SORTS = document.querySelectorAll('.sort-button');
    const RESET = document.getElementById('resetFilters');
    const CARDS = document.querySelectorAll('.deck-card');
    const CONT  = document.getElementById('decksContainer');
    const RC    = document.getElementById('resultCounter');
    const SI    = document.getElementById('sortIndicator');
    const NRT   = document.getElementById('noResultsTemplate');

    let state = { search:'', subject:'all', level:'all', dateFrom:'', dateTo:'', sort:'date-desc' };
    const sicons  = {'date-desc':'calendar','date':'calendar','title':'arrow-up-a-z','title-desc':'arrow-down-z-a'};
    const slabels = {'date-desc':'Newest First','date':'Oldest First','title':'Title A-Z','title-desc':'Title Z-A'};

    function inRange(ds, from, to) {
        if (!ds) return false;
        const d = new Date(ds);
        if (from && d < new Date(from)) return false;
        if (to   && d > new Date(to))   return false;
        return true;
    }

    function filter() {
        let count = 0, visible = [];
        CARDS.forEach(c => {
            const ok =
                (state.search === '' ||
                 [c.dataset.title, c.dataset.matiere, c.dataset.niveau, c.dataset.description]
                 .some(v => v && v.includes(state.search)))
                && (state.subject === 'all' || c.dataset.matiere === state.subject)
                && (state.level   === 'all' || c.dataset.niveau  === state.level)
                && inRange(c.dataset.date, state.dateFrom, state.dateTo);
            if (ok) { c.style.display = 'flex'; count++; visible.push({element:c, title:c.dataset.title||'', date:c.dataset.date||''}); }
            else    { c.style.display = 'none'; }
        });
        sortCards(visible);
        updateUI(count);
    }

    function sortCards(decks) {
        decks.sort((a, b) => {
            if (state.sort === 'date-desc') return new Date(b.date) - new Date(a.date);
            if (state.sort === 'date')      return new Date(a.date) - new Date(b.date);
            if (state.sort === 'title')     return a.title.localeCompare(b.title);
            if (state.sort === 'title-desc')return b.title.localeCompare(a.title);
            return 0;
        });
        const grid = CONT.querySelector('.grid');
        if (grid) decks.forEach(d => grid.appendChild(d.element));
    }

    function updateUI(count) {
        RC.textContent = 'Showing ' + count + ' deck' + (count !== 1 ? 's' : '');
        SI.innerHTML   = '<i data-lucide="' + sicons[state.sort] + '" class="w-4 h-4 mr-1"></i> Sorted by: ' + slabels[state.sort];
        lucide.createIcons();
        const grid = CONT.querySelector('.grid');
        if (!grid) return;
        if (count === 0) {
            grid.style.display = 'none';
            CONT.querySelector('.no-results')?.remove();
            CONT.appendChild(NRT.content.cloneNode(true));
            setTimeout(() => {
                CONT.querySelector('#clearSearch')?.addEventListener('click', resetAll);
                lucide.createIcons();
            }, 50);
        } else {
            grid.style.display = 'grid';
            CONT.querySelector('.no-results')?.remove();
        }
    }

    function resetAll() {
        DS.value=''; SF.value='all'; LF.value='all'; DF.value=''; DT.value='';
        SORTS.forEach(b => b.classList.remove('active'));
        document.querySelector('.sort-button[data-sort="date-desc"]')?.classList.add('active');
        state = { search:'', subject:'all', level:'all', dateFrom:'', dateTo:'', sort:'date-desc' };
        filter();
    }

    DS.addEventListener('input',   () => { state.search   = DS.value.trim().toLowerCase(); filter(); });
    DS.addEventListener('keypress', e => { if (e.key==='Enter') { state.search = DS.value.trim().toLowerCase(); filter(); } });
    SF.addEventListener('change',  () => { state.subject  = SF.value; filter(); });
    LF.addEventListener('change',  () => { state.level    = LF.value; filter(); });
    DF.addEventListener('change',  () => { state.dateFrom = DF.value; filter(); });
    DT.addEventListener('change',  () => { state.dateTo   = DT.value; filter(); });
    SORTS.forEach(b => b.addEventListener('click', function() {
        SORTS.forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        state.sort = b.dataset.sort;
        filter();
    }));
    RESET.addEventListener('click', resetAll);

    SORTS.forEach(b => b.classList.remove('active'));
    document.querySelector('.sort-button[data-sort="date-desc"]')?.classList.add('active');
    filter();
    lucide.createIcons();
});
</script>
{% endblock %}
