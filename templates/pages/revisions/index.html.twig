{% extends 'base.html.twig' %}

{% block title %}Revisions{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Barre de recherche principale */
    .search-container {
        position: relative;
        max-width: 100%;
    }
    
    .search-input {
        width: 100%;
        padding: 12px 48px 12px 16px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 16px;
        transition: all 0.3s ease;
        background-color: white;
    }
    
    .search-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .search-input.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: white;
    }
    
    .search-button {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #64748b;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    
    .search-button:hover {
        background-color: #f1f5f9;
        color: #3b82f6;
    }
    
    .search-button.dark:hover {
        background-color: #334155;
        color: #60a5fa;
    }
    
    /* Filtres et tris */
    .controls-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 16px;
    }
    
    .filters-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
    }
    
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    
    .filter-label {
        font-size: 14px;
        font-weight: 500;
        color: #64748b;
    }
    
    .filter-label.dark {
        color: #94a3b8;
    }
    
    .filter-select {
        padding: 8px 12px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        background-color: white;
        cursor: pointer;
        min-width: 150px;
        transition: all 0.3s ease;
    }
    
    .filter-select:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .filter-select.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: white;
    }
    
    .filter-select.dark:focus {
        border-color: #60a5fa;
    }
    
    /* Recherche par date */
    .date-search-container {
        display: flex;
        gap: 8px;
        align-items: center;
    }
    
    .date-input {
        padding: 8px 12px;
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        font-size: 14px;
        width: 150px;
        transition: all 0.3s ease;
    }
    
    .date-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    .date-input.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: white;
    }
    
    /* Boutons de tri */
    .sort-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    
    .sort-button {
        padding: 8px 16px;
        border-radius: 20px;
        border: 2px solid #e2e8f0;
        background-color: white;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .sort-button:hover {
        border-color: #3b82f6;
        color: #3b82f6;
    }
    
    .sort-button.active {
        background-color: #3b82f6;
        color: white;
        border-color: #3b82f6;
    }
    
    .sort-button.dark {
        background-color: #1e293b;
        border-color: #475569;
        color: #cbd5e1;
    }
    
    .sort-button.dark:hover {
        border-color: #60a5fa;
        color: #60a5fa;
    }
    
    .sort-button.dark.active {
        background-color: #60a5fa;
        color: white;
        border-color: #60a5fa;
    }
    
    /* Boutons d'action */
    .action-buttons {
        display: flex;
        gap: 8px;
    }
    
    .action-button {
        padding: 8px 16px;
        border-radius: 8px;
        border: none;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .action-button.reset {
        background-color: #f1f5f9;
        color: #64748b;
    }
    
    .action-button.reset:hover {
        background-color: #e2e8f0;
    }
    
    .action-button.reset.dark {
        background-color: #334155;
        color: #cbd5e1;
    }
    
    .action-button.reset.dark:hover {
        background-color: #475569;
    }
    
    /* Compteur de résultats */
    .results-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }
    
    .results-info.dark {
        border-top-color: #475569;
    }
    
    .deck-counter {
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
    }
    
    .deck-counter.dark {
        color: #94a3b8;
    }
    
    .sort-indicator {
        color: #3b82f6;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .sort-indicator.dark {
        color: #60a5fa;
    }
    
    /* Message "Aucun résultat" */
    .no-results {
        text-align: center;
        padding: 60px 20px;
        grid-column: 1 / -1;
    }
    
    .no-results-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        color: #e2e8f0;
    }
    
    .no-results.dark .no-results-icon {
        color: #475569;
    }
    
    /* Animation pour les cartes */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .deck-card {
        animation: fadeIn 0.3s ease-out;
    }

    /* ═══════════════════════════════════════════════
       📱 QR CODE BUTTON & MODAL - NOUVEAU
    ═══════════════════════════════════════════════ */
    
    .qr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 16px;
        background: linear-gradient(135deg, #A78BFA 0%, #7c5ce4 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 2px 8px rgba(167,139,250,.3);
    }
    
    .qr-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(167,139,250,.5);
    }
    
    .qr-btn:active {
        transform: translateY(0);
    }
    
    /* Modal QR Code */
    .qr-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
        animation: fadeIn 0.3s ease;
    }
    
    .qr-modal.show {
        display: flex;
    }
    
    .qr-modal-content {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        animation: modalSlideIn 0.3s ease;
    }
    
    @keyframes modalSlideIn {
        from { opacity: 0; transform: scale(0.9) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
    
    .qr-modal-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }
    
    .qr-modal-header h3 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 0.5rem;
    }
    
    .qr-modal-header p {
        color: #64748b;
        font-size: 0.9rem;
    }
    
    .qr-modal-qr {
        background: #f8fafc;
        padding: 1.5rem;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 1rem;
    }
    
    .qr-modal-qr img {
        border-radius: 8px;
        max-width: 100%;
        height: auto;
    }
    
    .qr-loading {
        padding: 3rem;
        text-align: center;
        color: #64748b;
    }
    
    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e2e8f0;
        border-top-color: #A78BFA;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
    }
    
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    .qr-modal-actions {
        display: flex;
        gap: 0.8rem;
    }
    
    .qr-modal-btn {
        flex: 1;
        padding: 0.9rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        text-decoration: none;
    }
    
    .qr-modal-btn.primary {
        background: #20C9A0;
        color: white;
        box-shadow: 0 4px 12px rgba(32,201,160,.3);
    }
    
    .qr-modal-btn.primary:hover {
        background: #0EA37E;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(32,201,160,.4);
    }
    
    .qr-modal-btn.secondary {
        background: #f1f5f9;
        color: #475569;
        border: 2px solid #e2e8f0;
    }
    
    .qr-modal-btn.secondary:hover {
        border-color: #cbd5e1;
        background: #e2e8f0;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
        .filters-row {
            flex-direction: column;
            align-items: stretch;
        }
        
        .filter-select, .date-input {
            width: 100%;
        }
        
        .date-search-container {
            flex-direction: column;
        }
        
        .results-info {
            flex-direction: column;
            gap: 12px;
            align-items: flex-start;
        }
        
        .qr-modal-actions {
            flex-direction: column;
        }
        
        .qr-modal-content {
            padding: 1.5rem;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Revisions</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Track and manage your Review</p>
        </div>
        <a href="{{ path('app_admin_deck_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-5 h-5"></i>
            New deck
        </a>
    </div>

    <!-- Barre de recherche et filtres -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-6">
        <!-- Barre de recherche principale -->
        <div class="search-container">
            <input type="text" 
                   id="deckSearch" 
                   placeholder="Search decks by title, subject, level or description..." 
                   class="search-input dark:search-input.dark">
            <button type="button" id="searchButton" class="search-button dark:search-button.dark">
                <i data-lucide="search" class="w-5 h-5"></i>
            </button>
        </div>
        
        <!-- Contrôles de filtrage et tri -->
        <div class="controls-container">
            <!-- Première ligne : Filtres -->
            <div class="filters-row">
                <!-- Filtre par matière -->
                <div class="filter-group">
                    <label class="filter-label dark:filter-label.dark">Subject</label>
                    <select id="subjectFilter" class="filter-select dark:filter-select.dark">
                        <option value="all">All Subjects</option>
                        {% set subjects = [] %}
                        {% for deck in decks %}
                            {% if deck.matiere not in subjects %}
                                {% set subjects = subjects|merge([deck.matiere]) %}
                            {% endif %}
                        {% endfor %}
                        {% for subject in subjects|sort %}
                            <option value="{{ subject|lower }}">{{ subject }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <!-- Filtre par niveau -->
                <div class="filter-group">
                    <label class="filter-label dark:filter-label.dark">Level</label>
                    <select id="levelFilter" class="filter-select dark:filter-select.dark">
                        <option value="all">All Levels</option>
                        {% set levels = [] %}
                        {% for deck in decks %}
                            {% if deck.niveau not in levels %}
                                {% set levels = levels|merge([deck.niveau]) %}
                            {% endif %}
                        {% endfor %}
                        {% for level in levels|sort %}
                            <option value="{{ level|lower }}">{{ level }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <!-- Filtre par date -->
                <div class="filter-group">
                    <label class="filter-label dark:filter-label.dark">Date Created</label>
                    <div class="date-search-container">
                        <input type="date" id="dateFrom" class="date-input dark:date-input.dark" placeholder="From">
                        <span class="text-slate-400">to</span>
                        <input type="date" id="dateTo" class="date-input dark:date-input.dark" placeholder="To">
                    </div>
                </div>
            </div>
            
            <!-- Deuxième ligne : Tris et actions -->
            <div class="filters-row">
                <!-- Boutons de tri -->
                <div class="filter-group" style="flex-grow: 1;">
                    <label class="filter-label dark:filter-label.dark">Sort by</label>
                    <div class="sort-buttons">
                        <button type="button" class="sort-button dark:sort-button.dark active" data-sort="date-desc">
                            <i data-lucide="calendar" class="w-4 h-4"></i>
                            Newest First
                        </button>
                        <button type="button" class="sort-button dark:sort-button.dark" data-sort="date">
                            <i data-lucide="calendar" class="w-4 h-4"></i>
                            Oldest First
                        </button>
                        <button type="button" class="sort-button dark:sort-button.dark" data-sort="title">
                            <i data-lucide="arrow-up-a-z" class="w-4 h-4"></i>
                            Title A-Z
                        </button>
                        <button type="button" class="sort-button dark:sort-button.dark" data-sort="title-desc">
                            <i data-lucide="arrow-down-z-a" class="w-4 h-4"></i>
                            Title Z-A
        <div class="flex items-center gap-3">
            <a href="{{ path('app_admin_deck_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                New deck
            </a>
        </div>
    </div>

    <!-- Stats Overview Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                    <i data-lucide="calendar-clock" class="w-8 h-8 text-warning-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">3</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Assignments due</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                    <i data-lucide="clock" class="w-8 h-8 text-success-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">5</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Hours per day this week</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="trending-up" class="w-8 h-8 text-primary-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">+3</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Study time this week</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                    <i data-lucide="layers" class="w-8 h-8 text-accent-500"></i>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">45</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Cards reviewed</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Gamification Banner -->
    {% if gamification is defined and gamification %}
    <div class="card overflow-hidden border-0" style="background: linear-gradient(135deg, #16a34a 0%, #15803d 50%, #166534 100%);">
        <div class="p-5">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-2xl flex items-center justify-center" style="background: rgba(255,255,255,0.2);">
                        <span class="text-3xl">🎓</span>
                    </div>
                    <div>
                        <p class="text-sm" style="color: #bbf7d0;">Your progress</p>
                        <h3 class="text-2xl font-bold text-white">Level {{ gamification.level }} <span style="color: #bbf7d0;">⭐</span></h3>
                        <p class="text-sm" style="color: #86efac;">{{ gamification.points }} XP total</p>
                    </div>
                </div>
                <div class="flex items-center gap-6 flex-wrap">
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">🔥 {{ gamification.streak }}</p>
                        <p class="text-xs" style="color: #86efac;">Day streak</p>
                    </div>
                    <div class="w-px h-8" style="background: rgba(255,255,255,0.3);"></div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">{{ gamification.totalDecksCompleted }}</p>
                        <p class="text-xs" style="color: #86efac;">Decks done</p>
                    </div>
                    <div class="w-px h-8" style="background: rgba(255,255,255,0.3);"></div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-white">{{ gamification.totalCorrectAnswers }}</p>
                        <p class="text-xs" style="color: #86efac;">Correct</p>
                    </div>
                </div>
                <div class="flex-1 min-w-[200px]">
                    {% set currentLevelXp = (gamification.level - 1) * 100 %}
                    {% set nextLevelXp = gamification.level * 100 %}
                    {% set progress = gamification.points > currentLevelXp ? ((gamification.points - currentLevelXp) / (nextLevelXp - currentLevelXp) * 100)|round : 0 %}
                    {% set progress = progress > 100 ? 100 : progress %}
                    <div class="flex justify-between text-xs mb-2">
                        <span style="color: #bbf7d0;">Level {{ gamification.level }}</span>
                        <span style="color: #4ade80;">{{ progress }}% → Lvl {{ gamification.level + 1 }}</span>
                    </div>
                    <div class="h-2 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.2);">
                        <div class="h-full rounded-full transition-all duration-500" style="width: {{ progress }}%; background: #4ade80;"></div>
                    </div>
                </div>
                <a href="{{ path('gamification_dashboard') }}" class="btn border-0 text-white font-semibold" style="background: rgba(255,255,255,0.2);">
                    <i data-lucide="trophy" class="w-4 h-4"></i>
                    Full Dashboard
                </a>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Search and Filters Section -->
    <div class="card overflow-hidden">
        <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="search" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                </div>
                <h2 class="font-semibold text-secondary-900 dark:text-white">Search Decks</h2>
            </div>
        </div>
        <div class="p-5 space-y-4">
            <div class="relative">
                <input type="text" id="deckSearch" placeholder="Search decks by title, subject, level or description..." 
                       class="w-full px-4 py-3 pl-12 border border-secondary-300 dark:border-secondary-700 rounded-xl bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                <i data-lucide="search" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-secondary-400"></i>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Subject</label>
                    <select id="subjectFilter" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <option value="all">All Subjects</option>
                        {% set subjects = [] %}
                        {% for deck in decks %}{% if deck.matiere not in subjects %}{% set subjects = subjects|merge([deck.matiere]) %}{% endif %}{% endfor %}
                        {% for subject in subjects|sort %}<option value="{{ subject|lower }}">{{ subject }}</option>{% endfor %}
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Level</label>
                    <select id="levelFilter" class="w-full px-3 py-2 border border-secondary-300 dark:border-secondary-700 rounded-lg bg-white dark:bg-secondary-800 text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                        <option value="all">All Levels</option>
                        {% set levels = [] %}
                        {% for deck in decks %}{% if deck.niveau not in levels %}{% set levels = levels|merge([deck.niveau]) %}{% endif %}{% endfor %}
                        {% for level in levels|sort %}<option value="{{ level|lower }}">{{ level }}</option>{% endfor %}
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Date From</label>
