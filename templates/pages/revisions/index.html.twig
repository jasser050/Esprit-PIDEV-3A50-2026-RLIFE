{{ parent() }}
<script>
// ═══════════════════════════════════════════════
//  📱 QR CODE MODAL FUNCTIONS - NOUVEAU
// ═══════════════════════════════════════════════

function showQRModal(deckId, deckTitle) {
    const modal = document.getElementById('qr-modal');
    const titleEl = document.getElementById('qr-modal-title');
    const imageEl = document.getElementById('qr-modal-image');
    const loadingEl = document.getElementById('qr-loading');
    const shareLink = document.getElementById('qr-modal-share');
    
    // Mettre à jour le contenu
    titleEl.textContent = deckTitle;
    shareLink.href = `/qr/share/${deckId}`;
    
    // Afficher le loading
    imageEl.style.display = 'none';
    loadingEl.style.display = 'block';
    
    // Afficher le modal
    modal.classList.add('show');
    
    // Charger le QR Code directement dans l'élément img
    imageEl.onload = function() {
        imageEl.style.display = 'block';
        loadingEl.style.display = 'none';
    };
    imageEl.onerror = function() {
        // Fallback vers api.qrserver.com si l'endpoint PHP échoue
        const fallbackUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(window.location.origin + '/qr/import/preview-' + deckId);
        if (imageEl.src !== fallbackUrl) {
            imageEl.src = fallbackUrl;
        } else {
            loadingEl.innerHTML = '<p style="color: #ef4444; font-family: sans-serif;">❌ QR Code indisponible. Utilisez le lien de partage.</p>';
        }
    };
    imageEl.alt = `QR Code - ${deckTitle}`;
    imageEl.src = `/qr/deck/${deckId}`;
    
    // Fermer en cliquant en dehors
    modal.onclick = function(e) {
        if (e.target === modal) {
            closeQRModal();
        }
    };
}

function closeQRModal() {
    const modal = document.getElementById('qr-modal');
    modal.classList.remove('show');
}

// Fermer avec la touche Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeQRModal();
    }
});

// ═══════════════════════════════════════════════
