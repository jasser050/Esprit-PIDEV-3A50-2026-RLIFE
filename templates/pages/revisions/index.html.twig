<script>
document.addEventListener('DOMContentLoaded', function() {
    // Éléments DOM
    const deckSearch = document.getElementById('deckSearch');
    const searchButton = document.getElementById('searchButton');
    const subjectFilter = document.getElementById('subjectFilter');
    const levelFilter = document.getElementById('levelFilter');
    const dateFrom = document.getElementById('dateFrom');
    const dateTo = document.getElementById('dateTo');
    const sortButtons = document.querySelectorAll('.sort-button');
    const resetButton = document.getElementById('resetFilters');
    const deckCards = document.querySelectorAll('.deck-card');
    const decksContainer = document.getElementById('decksContainer');
    const resultCounter = document.getElementById('resultCounter');
    const sortIndicator = document.getElementById('sortIndicator');
    const noResultsTemplate = document.getElementById('noResultsTemplate');
    
    // État courant
    let currentState = {
        search: '',
        subject: 'all',
        level: 'all',
        dateFrom: '',
        dateTo: '',
        sort: 'date-desc'
    };
    
    // Icônes pour l'indicateur de tri
    const sortIcons = {
        'date-desc': 'calendar',
        'date': 'calendar',
        'title': 'arrow-up-a-z',
        'title-desc': 'arrow-down-z-a'
    };
    
    const sortLabels = {
        'date-desc': 'Newest First',
        'date': 'Oldest First',
        'title': 'Title A-Z',
        'title-desc': 'Title Z-A'
    };
    
    // Fonction pour vérifier si une date est dans l'intervalle
    function isDateInRange(dateString, from, to) {
        if (!dateString) return false;
        
        const date = new Date(dateString);
        const fromDate = from ? new Date(from) : null;
        const toDate = to ? new Date(to) : null;
        
        if (fromDate && date < fromDate) return false;
        if (toDate && date > toDate) return false;
        
        return true;
    }
    
    // Fonction pour filtrer les decks
    function filterDecks() {
        let visibleCount = 0;
        const visibleDecks = [];
        
        deckCards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const matiere = card.getAttribute('data-matiere') || '';
            const niveau = card.getAttribute('data-niveau') || '';
            const description = card.getAttribute('data-description') || '';
            const date = card.getAttribute('data-date') || '';
            
            // Vérifier la recherche
            const searchMatch = currentState.search === '' || 
                title.includes(currentState.search) ||
                matiere.includes(currentState.search) ||
                niveau.includes(currentState.search) ||
                description.includes(currentState.search);
            
            // Vérifier le sujet
            const subjectMatch = currentState.subject === 'all' || 
                matiere === currentState.subject;
            
            // Vérifier le niveau
            const levelMatch = currentState.level === 'all' || 
                niveau === currentState.level;
            
            // Vérifier la date
            const dateMatch = isDateInRange(date, currentState.dateFrom, currentState.dateTo);
            
            // Afficher ou cacher la carte
            if (searchMatch && subjectMatch && levelMatch && dateMatch) {
                card.style.display = 'flex';
                visibleCount++;
                visibleDecks.push({
                    element: card,
                    title: title,
                    date: date
                });
            } else {
                card.style.display = 'none';
            }
        });
        
        // Trier les decks visibles
        sortDecks(visibleDecks);
        
        // Mettre à jour l'interface
        updateUI(visibleCount);
    }
    
    // Fonction pour trier les decks
    function sortDecks(decks) {
        decks.sort((a, b) => {
            switch(currentState.sort) {
                case 'date-desc':
                    return new Date(b.date) - new Date(a.date);
                case 'date':
                    return new Date(a.date) - new Date(b.date);
                case 'title':
                    return a.title.localeCompare(b.title);
                case 'title-desc':
                    return b.title.localeCompare(a.title);
                default:
                    return 0;
            }
        });
        
        // Réorganiser les cartes dans le DOM
        const gridContainer = decksContainer.querySelector('.grid');
        if (gridContainer) {
            decks.forEach(deck => {
                gridContainer.appendChild(deck.element);
            });
        }
    }
    
    // Fonction pour mettre à jour l'interface
    function updateUI(visibleCount) {
        // Mettre à jour le compteur
        resultCounter.textContent = `Showing ${visibleCount} deck${visibleCount !== 1 ? 's' : ''}`;
        
        // Mettre à jour l'indicateur de tri
        const iconName = sortIcons[currentState.sort];
        sortIndicator.innerHTML = `
            <i data-lucide="${iconName}" class="w-4 h-4"></i>
            Sorted by: ${sortLabels[currentState.sort]}
        `;
        lucide.create();
        
        // Gérer l'affichage "Aucun résultat"
        const gridContainer = decksContainer.querySelector('.grid');
        if (gridContainer) {
            if (visibleCount === 0) {
                gridContainer.style.display = 'none';
                const noResults = noResultsTemplate.content.cloneNode(true);
                
                // Supprimer d'abord l'ancien message
                const existingNoResults = decksContainer.querySelector('.no-results');
                if (existingNoResults) {
                    existingNoResults.remove();
                }
                
                decksContainer.appendChild(noResults);
                
                // Ajouter l'écouteur d'événement pour effacer tout
                setTimeout(() => {
                    const clearSearchBtn = decksContainer.querySelector('#clearSearch');
                    if (clearSearchBtn) {
                        clearSearchBtn.addEventListener('click', resetAllFilters);
                    }
                }, 100);
            } else {
                gridContainer.style.display = 'grid';
                const noResultsDiv = decksContainer.querySelector('.no-results');
                if (noResultsDiv) {
                    noResultsDiv.remove();
                }
            }
        }
    }
    
    // Fonction pour réinitialiser tous les filtres
    function resetAllFilters() {
        deckSearch.value = '';
        subjectFilter.value = 'all';
        levelFilter.value = 'all';
        dateFrom.value = '';
        dateTo.value = '';
        
        // Réactiver le tri par défaut
        sortButtons.forEach(btn => btn.classList.remove('active'));
        const defaultSort = document.querySelector('.sort-button[data-sort="date-desc"]');
        if (defaultSort) defaultSort.classList.add('active');
        
        // Réinitialiser l'état
        currentState = {
            search: '',
            subject: 'all',
            level: 'all',
            dateFrom: '',
            dateTo: '',
            sort: 'date-desc'
        };
        
        // Réappliquer les filtres
        filterDecks();
    }
    
    // Écouteurs d'événements
    // Recherche
    deckSearch.addEventListener('input', function() {
        currentState.search = this.value.trim().toLowerCase();
        filterDecks();
    });
    
    searchButton.addEventListener('click', function() {
        currentState.search = deckSearch.value.trim().toLowerCase();
        filterDecks();
    });
    
    deckSearch.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            currentState.search = this.value.trim().toLowerCase();
            filterDecks();
        }
    });
    
    // Filtres
    subjectFilter.addEventListener('change', function() {
        currentState.subject = this.value;
        filterDecks();
    });
    
    levelFilter.addEventListener('change', function() {
        currentState.level = this.value;
        filterDecks();
    });
    
    dateFrom.addEventListener('change', function() {
        currentState.dateFrom = this.value;
        filterDecks();
    });
    
    dateTo.addEventListener('change', function() {
        currentState.dateTo = this.value;
        filterDecks();
    });
    
    // Tris
    sortButtons.forEach(button => {
        button.addEventListener('click', function() {
            // Retirer la classe active de tous les boutons
            sortButtons.forEach(btn => btn.classList.remove('active'));
            
            // Ajouter la classe active au bouton cliqué
            this.classList.add('active');
            
            // Mettre à jour le tri courant
            currentState.sort = this.getAttribute('data-sort');
            
            // Appliquer le tri
            filterDecks();
        });
    });
    
    // Réinitialisation
    resetButton.addEventListener('click', resetAllFilters);
    
    // Initialisation
    filterDecks();
    
    // Mode sombre/clair
    const darkModeMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
    const isDarkMode = darkModeMediaQuery.matches;
    
    if (isDarkMode) {
        deckSearch.classList.add('dark');
        searchButton.classList.add('dark');
        subjectFilter.classList.add('dark');
        levelFilter.classList.add('dark');
        dateFrom.classList.add('dark');
        dateTo.classList.add('dark');
        sortButtons.forEach(button => button.classList.add('dark'));
        resetButton.classList.add('dark');
        
        // Add dark mode to labels
        document.querySelectorAll('.filter-label').forEach(label => {
            label.classList.add('dark');
        });
    }
});
</script>
{% endblock %}
