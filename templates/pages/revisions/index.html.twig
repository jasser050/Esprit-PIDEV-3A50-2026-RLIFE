{% extends 'base.html.twig' %}

{% block title %}Révisions - RLIFE{% endblock %}

{% block body %}
<div class="space-y-8 animate-fade-in px-4 sm:px-6 lg:px-8 py-8 max-w-7xl mx-auto">

    <!-- Titre simple -->
    <div class="text-center mb-10">
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white">Révisions</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
            Choisis un deck et commence à réviser efficacement
        </p>
    </div>

    <!-- Liste des decks -->
    {% if decks is empty %}
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow border border-slate-200 dark:border-slate-700 p-12 text-center">
            <i data-lucide="layers-2" class="w-20 h-20 mx-auto text-slate-300 dark:text-slate-600 mb-6"></i>
            <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-3">Aucun deck disponible</h3>
            <p class="text-slate-600 dark:text-slate-400">
                Connecte-toi pour créer ou voir tes decks
            </p>
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% set colorPalettes = [
                {from: '#dbeafe', accent: '#2563eb'},
                {from: '#f3e8ff', accent: '#7c3aed'},
                {from: '#fce7f3', accent: '#ec4899'},
                {from: '#d1fae5', accent: '#10b981'},
                {from: '#cffafe', accent: '#06b6d4'},
                {from: '#fef3c7', accent: '#d97706'},
                {from: '#d1fae5', accent: '#059669'},
                {from: '#fae8ff', accent: '#c026d3'},
                {from: '#f3e8ff', accent: '#9333ea'},
                {from: '#e0f2fe', accent: '#0284c7'},
                {from: '#ffe4e6', accent: '#e11d48'},
                {from: '#ecfccb', accent: '#65a30d'}
            ] %}

            {% for deck in decks %}
                {% set palette = colorPalettes[loop.index0 % colorPalettes|length] %}
                <div class="rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 group border flex flex-col"
                     style="background: linear-gradient(to bottom, {{ palette.from }}, white); border-color: {{ palette.from }};">
                    
                    <!-- Photo -->
                    <div class="h-32 overflow-hidden relative">
                        {% if deck.image %}
                            <img src="{{ asset('uploads/decks/' ~ deck.image) }}"
                                 alt="{{ deck.titre }}"
                                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center"
                                 style="background: linear-gradient(135deg, {{ palette.from }}, white);">
                                <i data-lucide="layers" class="w-16 h-16 opacity-80" style="color: {{ palette.accent }};"></i>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Contenu principal -->
                    <div class="p-5 flex flex-col flex-grow">
                        <h3 class="text-lg font-semibold mb-2 line-clamp-2" style="color: {{ palette.accent }};">
                            {{ deck.titre }}
                        </h3>

                        <p class="text-sm text-slate-600 dark:text-slate-400 mb-2 flex items-center gap-1.5">
                            <i data-lucide="book-open" class="w-4 h-4"></i>
                            {{ deck.matiere }} • {{ deck.niveau }}
                        </p>

                        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4 line-clamp-3 flex-grow">
                            {{ deck.description ?: 'Aucune description' }}
                        </p>

                        <div class="flex flex-wrap gap-2 mb-4">
                            <span class="px-2.5 py-1 rounded text-xs font-medium shadow-sm"
                                  style="background-color: {{ palette.from }}; color: {{ palette.accent }}; border: 1px solid {{ palette.from }};">
                                {{ deck.flashcards|length }} cartes
                            </span>
                        </div>

                        <!-- Boutons en bas de la carte -->
                        <div class="flex flex-col gap-3 mt-auto">
                            <a href="{{ path('app_revisions_deck_study', {id: deck.id}) }}"
                               class="inline-flex items-center justify-center px-4 py-2.5 bg-{{ palette.accent }} hover:bg-opacity-90 text-white font-medium rounded-lg transition shadow-sm">
                                <i data-lucide="play-circle" class="w-5 h-5 mr-2"></i>
                                Étudier ce deck
                            </a>

                            {% if is_granted('ROLE_USER') %}
                            <a href="{{ path('app_flashcard_new', {deck_id: deck.id}) }}"
                               class="inline-flex items-center justify-center px-4 py-2.5 bg-slate-600 hover:bg-slate-700 text-white font-medium rounded-lg transition shadow-sm">
                                <i data-lucide="plus-circle" class="w-5 h-5 mr-2"></i>
                                Ajouter une flashcard
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}