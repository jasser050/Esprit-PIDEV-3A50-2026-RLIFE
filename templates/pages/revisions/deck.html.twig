{% extends 'base.html.twig' %}

{% block title %}{{ deck.name }}{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Breadcrumbs -->
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Revisions', url: path('app_revisions') },
            { label: deck.name }
        ]
    } %}

    <!-- Header with actions -->
    <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <a href="{{ path('app_revisions') }}" class="p-2 rounded-xl hover:bg-light-card dark:hover:bg-dark-card transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </a>
            <div>
                <h1 class="text-2xl font-bold">{{ deck.name }}</h1>
                <p class="text-light-muted dark:text-dark-muted">{{ deck.course }} &bull; {{ cards|length }} cards</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_revisions_card_new', { deckId: deck.id }) }}" class="btn btn-secondary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Card
            </a>
            <a href="{{ path('app_revisions_deck_edit', { id: deck.id }) }}" class="btn btn-ghost">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit Deck
            </a>
        </div>
    </div>

    {% if cards|length > 0 %}
    <!-- Flashcard Player -->
    <div class="max-w-2xl mx-auto" data-controller="flashcard">
        <div class="flashcard cursor-pointer" data-action="click->flashcard#flip" data-flashcard-target="card">
            <div class="flashcard-inner">
                <div class="flashcard-front">
                    <p class="text-xl text-center" data-flashcard-target="front">
                        {{ cards[0].front }}
                    </p>
                    <p class="text-sm text-light-muted dark:text-dark-muted mt-4">Click to reveal answer</p>
                </div>
                <div class="flashcard-back">
                    <p class="text-xl text-center" data-flashcard-target="back">
                        {{ cards[0].back }}
                    </p>
                </div>
            </div>
        </div>

        <!-- Controls -->
        <div class="flex items-center justify-center gap-4 mt-6">
            <button class="btn btn-danger" data-action="click->flashcard#markWrong">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Again
            </button>
            <button class="btn btn-warning" data-action="click->flashcard#markHard">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Hard
            </button>
            <button class="btn btn-success" data-action="click->flashcard#markEasy">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Easy
            </button>
        </div>

        <!-- Progress -->
        <div class="text-center mt-6">
            <p class="text-sm text-light-muted dark:text-dark-muted">
                Card <span data-flashcard-target="current">1</span> of {{ cards|length }}
            </p>
            <div class="w-full h-2 bg-light-border dark:bg-dark-border rounded-full mt-2 overflow-hidden">
                <div class="h-full bg-primary-500 rounded-full transition-all" data-flashcard-target="progress" style="width: {{ (1 / cards|length * 100) }}%"></div>
            </div>
        </div>
    </div>

    <!-- Cards List -->
    <div class="card p-6 max-w-2xl mx-auto">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold">All Cards</h2>
            <span class="text-sm text-light-muted dark:text-dark-muted">{{ cards|length }} cards</span>
        </div>
        <div class="space-y-3">
            {% for card in cards %}
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg group">
                <div class="flex items-start justify-between gap-4">
                    <div class="flex-1 min-w-0">
                        <p class="font-medium">{{ card.front }}</p>
                        <p class="text-sm text-light-muted dark:text-dark-muted mt-1">{{ card.back }}</p>
                    </div>
                    <div class="flex items-center gap-2">
                        {% if card.mastered %}
                            <span class="badge badge-success">Mastered</span>
                        {% else %}
                            <span class="badge badge-secondary">Learning</span>
                        {% endif %}
                        <a href="{{ path('app_revisions_card_edit', { deckId: deck.id, cardId: card.id }) }}" 
                           class="p-2 rounded-lg hover:bg-light-card dark:hover:bg-dark-card opacity-0 group-hover:opacity-100 transition-all"
                           title="Edit card">
                            <svg class="w-4 h-4 text-light-muted dark:text-dark-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    <!-- Flashcard data for JS -->
    <script>
        window.flashcardData = {{ cards|json_encode|raw }};
    </script>
    {% else %}
    <!-- Empty State -->
    <div class="max-w-2xl mx-auto">
        {% include 'components/empty_state.html.twig' with {
            icon: '<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>',
            title: 'No cards yet',
            description: 'Add flashcards to this deck to start studying.',
            action_url: path('app_revisions_card_new', { deckId: deck.id }),
            action_label: 'Add First Card'
        } %}
    </div>
    {% endif %}
</div>
{% endblock %}
