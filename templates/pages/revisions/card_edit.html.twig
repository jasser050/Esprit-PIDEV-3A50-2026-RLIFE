{% extends 'base.html.twig' %}

{% block title %}Edit Flashcard{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Revisions', href: path('app_revisions') },
            { label: deck.name, href: path('app_revisions_deck', { id: deck.id }) },
            { label: 'Edit Card' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Edit Flashcard',
        subtitle: 'Update card content'
    } %}

    <form action="{{ path('app_revisions_card_edit', { deck_id: deck.id, card_id: card.id }) }}" method="POST" class="card p-6">
        <div class="space-y-6">
            <!-- Front (Question) -->
            {% include 'components/textarea.html.twig' with {
                name: 'front',
                label: 'Front (Question)',
                value: card.front,
                placeholder: 'Enter the question or prompt...',
                rows: 4,
                required: true
            } %}

            <!-- Back (Answer) -->
            {% include 'components/textarea.html.twig' with {
                name: 'back',
                label: 'Back (Answer)',
                value: card.back,
                placeholder: 'Enter the answer or explanation...',
                rows: 4,
                required: true
            } %}

            <!-- Tags -->
            {% include 'components/input.html.twig' with {
                name: 'tags',
                label: 'Tags (Optional)',
                value: card.tags|default([])|join(', '),
                placeholder: 'e.g., important, chapter-5, exam-material (comma-separated)'
            } %}

            <!-- Difficulty -->
            {% include 'components/select.html.twig' with {
                name: 'difficulty',
                label: 'Difficulty',
                value: card.difficulty|default('medium'),
                options: [
                    { value: 'easy', label: 'Easy' },
                    { value: 'medium', label: 'Medium' },
                    { value: 'hard', label: 'Hard' }
                ]
            } %}

            <!-- Study Stats (Read-Only Info) -->
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <h4 class="font-medium mb-3">Study Statistics</h4>
                <div class="grid grid-cols-3 gap-4 text-sm">
                    <div>
                        <p class="text-light-muted dark:text-dark-muted">Times Reviewed</p>
                        <p class="font-semibold">{{ card.review_count|default(0) }}</p>
                    </div>
                    <div>
                        <p class="text-light-muted dark:text-dark-muted">Correct Rate</p>
                        <p class="font-semibold text-success-600">{{ card.correct_rate|default(0) }}%</p>
                    </div>
                    <div>
                        <p class="text-light-muted dark:text-dark-muted">Status</p>
                        <p class="font-semibold">
                            {% if card.mastered|default(false) %}
                                <span class="text-success-600">Mastered</span>
                            {% else %}
                                <span class="text-accent-600">Learning</span>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-between pt-4 border-t border-light-border dark:border-dark-border">
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                    Delete
                </button>
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_revisions_deck', { id: deck.id }) }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Delete Confirmation Modal -->
{% include 'components/modal.html.twig' with {
    id: 'delete-modal',
    title: 'Delete Flashcard',
    content: '<p class="text-light-muted dark:text-dark-muted">Are you sure you want to delete this flashcard? This action cannot be undone.</p>',
    footer: '<button type="button" class="btn btn-secondary" data-action="modal#close">Cancel</button>
             <form action="' ~ path('app_revisions_card_delete', { deck_id: deck.id, card_id: card.id }) ~ '" method="POST" class="inline">
                 <button type="submit" class="btn btn-danger">Delete Card</button>
             </form>'
} %}

<script>
function confirmDelete() {
    document.getElementById('delete-modal').classList.remove('hidden');
}
</script>
{% endblock %}
