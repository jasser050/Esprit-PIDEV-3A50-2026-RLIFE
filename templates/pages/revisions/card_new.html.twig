{% extends 'base.html.twig' %}

{% block title %}New Flashcard{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Revisions', href: path('app_revisions') },
            { label: deck.name, href: path('app_revisions_deck', { id: deck.id }) },
            { label: 'New Card' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'New Flashcard',
        subtitle: 'Add a new card to ' ~ deck.name
    } %}

    <form action="{{ path('app_revisions_card_new', { deck_id: deck.id }) }}" method="POST" class="card p-6">
        <div class="space-y-6">
            <!-- Front (Question) -->
            {% include 'components/textarea.html.twig' with {
                name: 'front',
                label: 'Front (Question)',
                placeholder: 'Enter the question or prompt...',
                rows: 4,
                required: true
            } %}

            <!-- Back (Answer) -->
            {% include 'components/textarea.html.twig' with {
                name: 'back',
                label: 'Back (Answer)',
                placeholder: 'Enter the answer or explanation...',
                rows: 4,
                required: true
            } %}

            <!-- Tags -->
            {% include 'components/input.html.twig' with {
                name: 'tags',
                label: 'Tags (Optional)',
                placeholder: 'e.g., important, chapter-5, exam-material (comma-separated)'
            } %}

            <!-- Difficulty -->
            {% include 'components/select.html.twig' with {
                name: 'difficulty',
                label: 'Initial Difficulty',
                options: [
                    { value: 'easy', label: 'Easy' },
                    { value: 'medium', label: 'Medium' },
                    { value: 'hard', label: 'Hard' }
                ]
            } %}

            <!-- Add Another Toggle -->
            <label class="flex items-center gap-3 p-4 rounded-xl bg-light-bg dark:bg-dark-bg cursor-pointer">
                <input type="checkbox" name="add_another" class="checkbox">
                <span>Add another card after saving</span>
            </label>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-light-border dark:border-dark-border">
                <a href="{{ path('app_revisions_deck', { id: deck.id }) }}" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Add Card
                </button>
            </div>
        </div>
    </form>

    <!-- Quick Preview -->
    <div class="card p-6">
        <h3 class="text-lg font-semibold mb-4">Preview</h3>
        <p class="text-sm text-light-muted dark:text-dark-muted mb-4">This is how your flashcard will look:</p>
        <div class="flashcard cursor-pointer" data-controller="flashcard" data-flashcard-single-value="true">
            <div class="flashcard-inner" data-flashcard-target="cardInner">
                <div class="flashcard-front">
                    <p class="text-center text-light-muted dark:text-dark-muted italic">Your question will appear here</p>
                </div>
                <div class="flashcard-back">
                    <p class="text-center text-light-muted dark:text-dark-muted italic">Your answer will appear here</p>
                </div>
            </div>
        </div>
        <p class="text-xs text-center text-light-muted dark:text-dark-muted mt-2">Click to flip</p>
    </div>
</div>
{% endblock %}
