{% extends 'base.html.twig' %}

{% block title %}Create New Deck{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Header -->
    <div class="flex items-center gap-4">
        <a href="{{ path('app_revisions') }}" class="btn btn-ghost btn-sm">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Create New Deck</h1>
            <p class="text-slate-500 dark:text-slate-400">Create a new flashcard deck</p>
        </div>
    </div>

    <!-- Form -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-200 dark:border-slate-800">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-white">Deck Information</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Fill in the details below to create a new deck</p>
        </div>

        <div class="p-6">
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'space-y-6'}}) }}
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Title -->
                <div>
                    {{ form_label(form.titre, 'Deck Title', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.titre, {'attr': {'class': 'block w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-slate-900 dark:text-white placeholder-slate-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none transition-colors', 'placeholder': 'e.g., Data Structures'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <!-- Subject -->
                <div>
                    {{ form_label(form.matiere, 'Subject/Matiere', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.matiere, {'attr': {'class': 'block w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-slate-900 dark:text-white placeholder-slate-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none transition-colors', 'placeholder': 'e.g., Computer Science'}}) }}
                    {{ form_errors(form.matiere) }}
                </div>
            </div>

            <!-- Level -->
            <div>
                {{ form_label(form.niveau, 'Level', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.niveau, {'attr': {'class': 'block w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-slate-900 dark:text-white focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none transition-colors'}}) }}
                {{ form_errors(form.niveau) }}
            </div>

            <!-- Description -->
            <div>
                {{ form_label(form.description, 'Description (Optional)', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'block w-full rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 px-4 py-3 text-slate-900 dark:text-white placeholder-slate-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 focus:outline-none transition-colors resize-none', 'rows': 4, 'placeholder': 'Describe what this deck covers...'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <!-- File Uploads -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Image Upload -->
                <div>
                    {{ form_label(form.imageFile, 'Cover Image (Optional)', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.imageFile, {'attr': {'class': 'block w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 dark:file:bg-primary-900/20 dark:file:text-primary-300'}}) }}
                    <p class="text-xs text-slate-500 mt-1">Max 5MB - JPEG, PNG, WEBP</p>
                    {{ form_errors(form.imageFile) }}
                </div>

                <!-- PDF Upload -->
                <div>
                    {{ form_label(form.pdfFile, 'PDF Document (Optional)', {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.pdfFile, {'attr': {'class': 'block w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 dark:file:bg-primary-900/20 dark:file:text-primary-300'}}) }}
                    <p class="text-xs text-slate-500 mt-1">Max 10MB - PDF only</p>
                    {{ form_errors(form.pdfFile) }}
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
                <button type="submit" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-xl transition-colors">
                    <i data-lucide="plus" class="w-5 h-5"></i>
                    Create Deck
                </button>
                <a href="{{ path('app_revisions') }}" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 font-medium rounded-xl transition-colors">
                    <i data-lucide="x" class="w-5 h-5"></i>
                    Cancel
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
