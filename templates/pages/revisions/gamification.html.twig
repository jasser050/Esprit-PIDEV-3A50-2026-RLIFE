  const ggr=ctx.createLinearGradient(0,GY,0,H);
  ggr.addColorStop(0,'#0a2010'); ggr.addColorStop(1,'#050f08');
  ctx.fillStyle=ggr; ctx.fillRect(0,GY,W,H-GY);
  ctx.strokeStyle='rgba(0,255,100,.25)'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(0,GY); ctx.lineTo(W,GY); ctx.stroke();
  ctx.strokeStyle='rgba(0,255,100,.1)'; ctx.lineWidth=.5;
  for(let x=-(runnerBgOffset*1.5)%60;x<W;x+=60){ctx.beginPath();ctx.moveTo(x,GY);ctx.lineTo(x+20,H);ctx.stroke();}
  // Particles
  runnerParticles.forEach(p=>{ctx.globalAlpha=p.life/25;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();});
  ctx.globalAlpha=1;
  // Obstacles
  const GY2=268;
  runnerObs.forEach(o=>{
    const oy=GY2-o.h; ctx.shadowBlur=15;
    if(o.type==='spike'){
      ctx.shadowColor='#ff4400';
      const spG=ctx.createLinearGradient(o.x,oy,o.x+o.w,oy+o.h);
      spG.addColorStop(0,'#cc3300'); spG.addColorStop(1,'#660000');
      ctx.fillStyle=spG; ctx.beginPath(); ctx.moveTo(o.x,oy+o.h); ctx.lineTo(o.x+o.w/2,oy); ctx.lineTo(o.x+o.w,oy+o.h); ctx.closePath(); ctx.fill();
      ctx.strokeStyle='rgba(255,100,0,.5)'; ctx.lineWidth=1.5;
      ctx.beginPath(); ctx.moveTo(o.x+o.w/2,oy); ctx.lineTo(o.x+o.w/2+3,oy+o.h*.6); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(o.x+o.w/2,oy); ctx.lineTo(o.x+o.w/2-3,oy+o.h*.6); ctx.stroke();
    } else if(o.type==='robot'){
      ctx.shadowColor='#ff00aa';
