let runnerInterval=null, runnerRunning=false;
let runner={x:90,y:230,vy:0,jumps:0}, runnerObs=[], runnerDist=0, runnerBest=0, runnerFrame=0, runnerParticles=[];
let runnerClouds=[], runnerBgOffset=0;
const GROUND=230, RUNNER_GRAVITY=.72, JUMP_FORCE=-14;

function startRunner(){
  runner={x:90,y:GROUND,vy:0,jumps:0}; runnerObs=[]; runnerDist=0; runnerRunning=true; runnerFrame=0;
  runnerParticles=[]; runnerBgOffset=0;
  runnerClouds=Array.from({length:6},(_,i)=>({x:i*200+Math.random()*100,y:20+Math.random()*60,w:80+Math.random()*60,speed:.4+Math.random()*.3}));
  clearInterval(runnerInterval); runnerInterval=setInterval(runnerTick,16);
}
function stopRunner(){ clearInterval(runnerInterval); runnerRunning=false; }
function jump(){ if(!runnerRunning)return; if(runner.jumps<2){runner.vy=JUMP_FORCE;runner.jumps++;for(let i=0;i<12;i++)runnerParticles.push({x:runner.x+14,y:GROUND+4,vx:(Math.random()-.5)*5,vy:-(1+Math.random()*3),life:20,color:`hsl(${180+Math.random()*60},100%,60%)`,size:2+Math.random()*3});}}
document.addEventListener('keydown',e=>{if(e.code==='Space'&&runnerRunning){e.preventDefault();jump();}});
document.getElementById('runner-canvas')?.addEventListener('click',jump);

function runnerTick(){
  runnerFrame++;
  const speed=2.2+runnerDist/180;
  runnerDist+=speed/10; runnerBgOffset+=speed*.5;
  document.getElementById('runner-score').textContent=Math.floor(runnerDist);
  document.getElementById('game-score-display').textContent=Math.floor(runnerDist);
  runner.vy+=RUNNER_GRAVITY; runner.y+=runner.vy;
  if(runner.y>=GROUND){runner.y=GROUND;runner.vy=0;runner.jumps=0;if(runnerFrame%4===0)runnerParticles.push({x:runner.x+7,y:GROUND+28,vx:-(1+Math.random()*2),vy:-Math.random()*1.5,life:18,color:'rgba(0,200,255,.45)',size:3});}
  runnerClouds.forEach(c=>{c.x-=c.speed;if(c.x<-c.w)c.x=1100;});
  runnerParticles.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.15;p.life--;});
  runnerParticles=runnerParticles.filter(p=>p.life>0);
  const spawnRate=Math.max(35,80-Math.floor(runnerDist/45));
  if(runnerFrame%spawnRate===0){const types=['spike','robot','fire'];const type=types[Math.floor(Math.random()*types.length)];runnerObs.push({x:1070,h:type==='robot'?80:50,w:28,type,frame:0});}
  runnerObs.forEach(o=>{o.x-=speed;o.frame++;});
  runnerObs=runnerObs.filter(o=>o.x>-40);
  const GY=268;
  for(const o of runnerObs){
    if(runner.x+24>o.x&&runner.x<o.x+o.w&&runner.y+32>GY-o.h){
      stopRunner();
      if(runnerDist>runnerBest){runnerBest=Math.floor(runnerDist);document.getElementById('runner-best').textContent=runnerBest;}
      const xp=Math.max(5,Math.floor(runnerDist/5));
      addXP(xp); spawnFloater(`+${xp} XP 🏃`,'#00ddff');
      addActivity('🏃',`${playerName} — Runner 3D: ${Math.floor(runnerDist)}m!`,xp);
      if(runnerDist>=60) launchConfetti();
      return;
    }
  }
  drawRunner3D();
}

function drawRunner3D(){
  const canvas=document.getElementById('runner-canvas'), ctx=canvas.getContext('2d');
  const W=1060, H=300, GY=268;
  ctx.clearRect(0,0,W,H);
  // Sky
  const skyG=ctx.createLinearGradient(0,0,0,H);
  skyG.addColorStop(0,'#0a0520'); skyG.addColorStop(.3,'#1a0a40'); skyG.addColorStop(.6,'#2d1060'); skyG.addColorStop(.85,'#1a2a00'); skyG.addColorStop(1,'#0d1800');
  ctx.fillStyle=skyG; ctx.fillRect(0,0,W,H);
  // Stars
  ctx.fillStyle='rgba(255,255,255,.55)';
  for(let i=0;i<40;i++){const sx=(i*137.5+runnerBgOffset*.1)%W;ctx.fillRect(sx,i*4+2,1.5,1.5);}
  // Planet
  const pg=ctx.createRadialGradient(820,70,0,820,70,90);
  pg.addColorStop(0,'rgba(255,120,60,.6)'); pg.addColorStop(.5,'rgba(200,60,120,.3)'); pg.addColorStop(1,'transparent');
