    ctx.shadowBlur=0;
  });
  // Ground glow
  const gg=ctx.createLinearGradient(0,H-ROWS*CELL-5,0,H-ROWS*CELL+12);
  gg.addColorStop(0,'rgba(0,255,136,0.55)'); gg.addColorStop(1,'rgba(0,255,136,0)');
  ctx.fillStyle=gg; ctx.fillRect(0,H-ROWS*CELL-5,W,18);
  // Grid
  ctx.strokeStyle='rgba(0,255,136,0.07)'; ctx.lineWidth=.7;
  for(let x=0;x<=COLS;x++){ctx.beginPath();ctx.moveTo(x*CELL,0);ctx.lineTo(x*CELL,ROWS*CELL);ctx.stroke();}
  for(let y=0;y<=ROWS;y++){ctx.beginPath();ctx.moveTo(0,y*CELL);ctx.lineTo(COLS*CELL,y*CELL);ctx.stroke();}
  // Particles
  snakeParticles=snakeParticles.filter(p=>p.life>0);
  snakeParticles.forEach(p=>{
    p.x+=p.vx; p.y+=p.vy; p.vy+=.18; p.life--;
