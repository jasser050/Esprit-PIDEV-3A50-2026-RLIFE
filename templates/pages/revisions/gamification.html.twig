</div>

{# HIDDEN DATA #}
<div id="gami-data"
  data-points="{{ gamification.points }}"
  data-level="{{ gamification.level }}"
  data-streak="{{ gamification.streak }}"
  data-progress="{{ progressPercent }}"
  data-correct="{{ gamification.totalCorrectAnswers }}"
  data-decks="{{ gamification.totalDecksCompleted }}">
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// ═══════════════════════════════════════════════════════
//  GLOBAL STATE
// ═══════════════════════════════════════════════════════
const DATA = document.getElementById('gami-data').dataset;
let state = {
  points:  parseInt(DATA.points),
  level:   parseInt(DATA.level),
  streak:  parseInt(DATA.streak),
  progress: parseInt(DATA.progress),
  correct: parseInt(DATA.correct),
  decks:   parseInt(DATA.decks),
};

let cooldowns = { correct: 0, daily: 0, roulette: 0 };
let activityLog = [];
let challengeProgress = { c1: 0, c2: 0, c3: 0, c4: 0 };

// ═══════════════════════════════════════════════════════
//  UI UPDATE
// ═══════════════════════════════════════════════════════
function updateUI(newData) {
  const oldLevel = state.level;

  if (newData.points  !== undefined) state.points  = newData.points;
  if (newData.level   !== undefined) state.level   = newData.level;
  if (newData.streak  !== undefined) state.streak  = newData.streak;

  // XP display
  animateCount('xp-display', state.points, ' <small>XP</small>');
  animateCount('s-xp',       state.points);
  animateCount('s-lvl',      state.level);
  animateCount('s-streak',   state.streak);

  document.getElementById('cur-level').textContent  = state.level;
  document.getElementById('cur-streak').textContent = state.streak;
  document.getElementById('lv-cur').textContent     = state.level;
  document.getElementById('lv-next').textContent    = state.level + 1;
  document.getElementById('streak-count').textContent = state.streak + ' days';

  // XP bar
  const pct = state.points % 100;
  document.getElementById('xp-bar-fill').style.width = pct + '%';
  document.getElementById('xp-prog-txt').textContent = pct + '% → Lv' + (state.level + 1);

  // Level up?
  if (state.level > oldLevel) {
    setTimeout(() => showLevelUp(state.level), 600);
  }

  // Update badges count if provided
  if (newData.badges !== undefined) {
    const earned = newData.badges.length;
    document.getElementById('cur-badges').textContent = earned;
  }
}

function animateCount(id, target, suffix = '') {
  const el = document.getElementById(id);
  if (!el) return;
  const start = parseInt(el.textContent) || 0;
  const diff  = target - start;
  if (diff === 0) { el.innerHTML = target + suffix; return; }
  const steps = 20; let step = 0;
  const timer = setInterval(() => {
    step++;
    el.innerHTML = Math.round(start + (diff * (step / steps))) + suffix;
    if (step >= steps) { el.innerHTML = target + suffix; clearInterval(timer); }
  }, 30);
}

// ═══════════════════════════════════════════════════════
//  XP FLOATER
// ═══════════════════════════════════════════════════════
function spawnFloater(text, color = '#00f5ff') {
  const el = document.createElement('div');
  el.className = 'xp-floater';
  el.textContent = text;
  el.style.cssText = `left:${40 + Math.random() * 20}%;top:${30 + Math.random() * 30}%;color:${color};text-shadow:0 0 20px ${color};`;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 1500);
}

// ═══════════════════════════════════════════════════════
//  ACTIVITY FEED
// ═══════════════════════════════════════════════════════
function addActivity(icon, text, xp) {
  activityLog.unshift({ icon, text, xp, time: 'now' });
  if (activityLog.length > 20) activityLog.pop();

  const feed = document.getElementById('activity-feed');
  const item = document.createElement('div');
  item.className = 'act-item';
  item.innerHTML = `
    <span class="act-icon">${icon}</span>
    <span class="act-text">${text}</span>
    ${xp ? `<span class="act-xp">+${xp} XP</span>` : ''}
    <span class="act-time">now</span>
  `;
  feed.insertBefore(item, feed.firstChild);
  if (feed.children.length > 8) feed.removeChild(feed.lastChild);
}

// ═══════════════════════════════════════════════════════
//  LEVEL UP
// ═══════════════════════════════════════════════════════
function showLevelUp(level) {
  document.getElementById('lu-num').textContent = level;
  document.getElementById('levelup-overlay').classList.add('show');
  launchConfetti();
}
function closeLevelUp() {
  document.getElementById('levelup-overlay').classList.remove('show');
  stopConfetti();
}

// ═══════════════════════════════════════════════════════
//  BADGE TOAST
// ═══════════════════════════════════════════════════════
function showBadgeToast(badgeName) {
  const area = document.getElementById('badge-toast-area');
  const toast = document.createElement('div');
  toast.className = 'badge-toast';
  toast.innerHTML = `
    <span class="bt-icon">🏅</span>
    <div>
      <div class="bt-title">🎉 NEW BADGE!</div>
      <div class="bt-name">${badgeName}</div>
    </div>
  `;
  area.appendChild(toast);
  setTimeout(() => toast.style.opacity = '0', 4000);
  setTimeout(() => toast.remove(), 4500);
}

// ═══════════════════════════════════════════════════════
//  COOLDOWN SYSTEM
// ═══════════════════════════════════════════════════════
function setCooldown(key, seconds) {
  cooldowns[key] = Date.now() + seconds * 1000;
}

function checkCooldown(key) {
  return cooldowns[key] ? Date.now() < cooldowns[key] : false;
}

function updateCooldownUI() {
  const cdCorrect = document.getElementById('cd-correct');
  const cdDaily   = document.getElementById('cd-daily');

  if (checkCooldown('correct')) {
    const rem = Math.ceil((cooldowns.correct - Date.now()) / 1000);
    cdCorrect.textContent = rem + 's';
    cdCorrect.style.color = 'var(--neon-pink)';
  } else {
    cdCorrect.textContent = 'READY';
    cdCorrect.style.color = 'var(--neon-green)';
  }

  if (checkCooldown('daily')) {
    cdDaily.textContent = 'DONE TODAY';
    cdDaily.style.color = 'var(--neon-yellow)';
  } else {
    cdDaily.textContent = 'READY';
    cdDaily.style.color = 'var(--neon-green)';
  }
}
setInterval(updateCooldownUI, 500);

// ═══════════════════════════════════════════════════════
//  CHALLENGES
// ═══════════════════════════════════════════════════════
const CHALLENGES = [
  { id:'c1', icon:'🎯', name:'Answer Machine',   desc:'Get 5 correct answers',   target:5,  reward:25,  color:'var(--neon-cyan)' },
  { id:'c2', icon:'🔥', name:'On Fire',          desc:'Maintain 3-day streak',   target:3,  reward:30,  color:'var(--neon-orange)' },
  { id:'c3', icon:'📚', name:'Deck Destroyer',   desc:'Complete 2 decks',        target:2,  reward:50,  color:'var(--neon-pink)' },
  { id:'c4', icon:'⚡', name:'Speed Demon',      desc:'Score 7+ in Speed Quiz',  target:7,  reward:40,  color:'var(--neon-yellow)' },
];

function renderChallenges() {
  const list = document.getElementById('challenge-list');
  list.innerHTML = '';
  CHALLENGES.forEach(ch => {
    const prog = challengeProgress[ch.id] || 0;
    const done = prog >= ch.target;
    const pct  = Math.min(100, Math.round((prog / ch.target) * 100));
    list.innerHTML += `
      <div class="challenge-item ${done ? 'done' : ''}">
        <span class="ch-icon">${ch.icon}</span>
        <div class="ch-info">
          <div class="ch-name">${ch.name}</div>
          <div class="ch-desc">${ch.desc} (${Math.min(prog, ch.target)}/${ch.target})</div>
          <div class="ch-prog-wrap">
            <div class="ch-prog-track">
              <div class="ch-prog-fill" style="width:${pct}%;background:${ch.color};box-shadow:0 0 8px ${ch.color};"></div>
            </div>
          </div>
        </div>
        ${done
          ? '<span class="ch-done-icon">✅</span>'
          : `<span class="ch-reward">+${ch.reward} XP</span>`}
      </div>`;
  });
}

function progressChallenge(id, amount = 1) {
  if (!challengeProgress[id]) challengeProgress[id] = 0;
  const ch = CHALLENGES.find(c => c.id === id);
  if (!ch || challengeProgress[id] >= ch.target) return;
  challengeProgress[id] = Math.min(ch.target, challengeProgress[id] + amount);
  if (challengeProgress[id] >= ch.target) {
    addActivity('🏆', `Challenge completed: ${ch.name}!`, ch.reward);
    spawnFloater(`CHALLENGE! +${ch.reward} XP`, 'var(--neon-yellow)');
    showBadgeToast(`Challenge: ${ch.name}`);
    launchConfetti();
    // Give XP for challenge completion
    callAPI('/gamification/correct-answer', {});
  }
  renderChallenges();
}

// ═══════════════════════════════════════════════════════
//  API CALLS
// ═══════════════════════════════════════════════════════
async function callAPI(url, body = {}) {
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify(body),
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    return await res.json();
  } catch(e) {
    console.warn('API error:', e.message);
    return null;
  }
}

// ═══════════════════════════════════════════════════════
//  EARN XP ACTIONS
// ═══════════════════════════════════════════════════════
async function earnCorrectAnswer() {
  if (checkCooldown('correct')) return;
  setCooldown('correct', 3);

  const btn = document.getElementById('btn-correct');
  btn.disabled = true;

  const data = await callAPI('/gamification/correct-answer');

  if (data && data.success) {
    spawnFloater('+10 XP 🎯', 'var(--neon-green)');
    addActivity('🎯', 'Correct answer!', 10);
    updateUI(data);
    if (data.newBadges && data.newBadges.length) data.newBadges.forEach(b => showBadgeToast(b));

    // Challenge progress
    progressChallenge('c1');

    state.correct++;
    document.getElementById('s-correct').textContent = state.correct;
  } else {
    // Fallback demo mode
    state.points += 10;
    spawnFloater('+10 XP 🎯', 'var(--neon-green)');
    addActivity('🎯', 'Correct answer! (demo)', 10);
    state.correct++;
    document.getElementById('s-correct').textContent = state.correct;
    updateUI({ points: state.points, level: Math.floor(state.points / 100) + 1 });
    progressChallenge('c1');
  }

  setTimeout(() => { btn.disabled = false; }, 3000);
}

async function earnDeckCompleted() {
  const btn = document.getElementById('btn-deck');
  btn.disabled = true;

  const data = await callAPI('/gamification/deck-completed/0');

  if (data && data.success) {
    spawnFloater('+50 XP 📚', 'var(--neon-pink)');
    addActivity('📚', 'Deck completed!', 50);
    updateUI(data);
    if (data.newBadges && data.newBadges.length) data.newBadges.forEach(b => showBadgeToast(b));
    state.decks++;
    document.getElementById('s-decks').textContent = state.decks;
    progressChallenge('c3');
    launchConfetti();
  } else {
    state.points += 50;
    spawnFloater('+50 XP 📚', 'var(--neon-pink)');
    addActivity('📚', 'Deck completed! (demo)', 50);
    state.decks++;
    document.getElementById('s-decks').textContent = state.decks;
    updateUI({ points: state.points, level: Math.floor(state.points / 100) + 1 });
    progressChallenge('c3');
    launchConfetti();
  }

  setTimeout(() => { btn.disabled = false; }, 3000);
}

async function earnDailyRevision() {
  if (checkCooldown('daily')) {
    addActivity('ℹ️', 'Daily revision already claimed today!');
    return;
  }
  setCooldown('daily', 86400);

  const btn = document.getElementById('btn-daily');
  btn.disabled = true;

  const data = await callAPI('/gamification/daily-revision');

  if (data) {
    if (data.success) {
      spawnFloater('+15 XP 📅', 'var(--neon-yellow)');
      addActivity('📅', 'Daily revision bonus!', 15);
      updateUI(data);
    } else {
      addActivity('ℹ️', 'Already claimed today — come back tomorrow!');
    }
  } else {
    state.points += 15;
    spawnFloater('+15 XP 📅', 'var(--neon-yellow)');
    addActivity('📅', 'Daily revision! (demo)', 15);
    updateUI({ points: state.points, level: Math.floor(state.points / 100) + 1 });
  }

  setTimeout(() => { btn.disabled = false; }, 2000);
}

async function doStreak10() {
  const btn = document.getElementById('btn-streak');
  btn.disabled = true;
  btn.textContent = 'Earning...';

  // 10 correct answers = 100 XP
  let total = 0;
  for (let i = 0; i < 10; i++) {
    const data = await callAPI('/gamification/correct-answer');
    if (data && data.success) { total += 10; updateUI(data); }
    else { state.points += 10; total += 10; updateUI({ points: state.points, level: Math.floor(state.points / 100) + 1 }); }
    await new Promise(r => setTimeout(r, 100));
  }

  spawnFloater('+100 XP 🔥🔥🔥', 'var(--neon-orange)');
  addActivity('🔥', '10-answer streak bonus!', 100);
  launchConfetti();

  btn.disabled = false;
  btn.textContent = '🔥 Streak Bonus';
}

// ═══════════════════════════════════════════════════════
//  MEMORY GAME
// ═══════════════════════════════════════════════════════
const MEM_EMOJIS = ['🎯','📚','🔥','⭐','🏆','🎮','⚡','💎'];
let memCards = [], memFlipped = [], memMatched = 0, memMoves = 0;
let memTimerVal = 0, memTimerInt = null, memStarted = false;

function initMemory() {
  clearInterval(memTimerInt);
  memCards = []; memFlipped = []; memMatched = 0; memMoves = 0; memTimerVal = 0; memStarted = false;
  document.getElementById('mem-moves').textContent = '0';
  document.getElementById('mem-pairs').textContent = '0/8';
  document.getElementById('mem-timer').textContent = '0s';

  const pairs = [...MEM_EMOJIS, ...MEM_EMOJIS].sort(() => Math.random() - 0.5);
  const grid = document.getElementById('memory-grid');
  grid.innerHTML = '';

  pairs.forEach((emoji, i) => {
    const card = document.createElement('div');
    card.className = 'mem-card';
    card.dataset.emoji = emoji;
    card.dataset.idx   = i;
    card.innerHTML = `<div class="mem-face">?</div><div class="mem-back">${emoji}</div>`;
    card.addEventListener('click', () => flipMemCard(card));
    grid.appendChild(card);
    memCards.push(card);
  });
}

function flipMemCard(card) {
  if (card.classList.contains('flipped') || card.classList.contains('matched') || memFlipped.length >= 2) return;

  if (!memStarted) {
    memStarted = true;
    memTimerInt = setInterval(() => {
      memTimerVal++;
      document.getElementById('mem-timer').textContent = memTimerVal + 's';
    }, 1000);
  }

  card.classList.add('flipped');
  memFlipped.push(card);

  if (memFlipped.length === 2) {
    memMoves++;
    document.getElementById('mem-moves').textContent = memMoves;

    if (memFlipped[0].dataset.emoji === memFlipped[1].dataset.emoji) {
      memFlipped[0].classList.add('matched');
      memFlipped[1].classList.add('matched');
      memMatched++;
      document.getElementById('mem-pairs').textContent = memMatched + '/8';
      memFlipped = [];

      if (memMatched === 8) {
        clearInterval(memTimerInt);
        setTimeout(async () => {
          const xp = Math.max(10, 30 - Math.floor(memMoves / 3));
          addActivity('🃏', `Memory Game won in ${memMoves} moves!`, xp);
          spawnFloater(`+${xp} XP 🃏`, 'var(--neon-purple)');
          launchConfetti();
          // Give XP
          for (let i = 0; i < Math.ceil(xp/10); i++) {
            await callAPI('/gamification/correct-answer');
            state.points += 10;
          }
          updateUI({ points: state.points, level: Math.floor(state.points / 100) + 1 });
        }, 400);
      }
    } else {
      setTimeout(() => {
        memFlipped[0].classList.remove('flipped');
        memFlipped[1].classList.remove('flipped');
        memFlipped = [];
      }, 900);
    }
  }
}

// ═══════════════════════════════════════════════════════
//  SPEED QUIZ
// ═══════════════════════════════════════════════════════
const QUIZ_QUESTIONS = [
  { q: 'What is the capital of France?',         opts: ['Berlin','Paris','Madrid','Rome'],          ans: 1 },
  { q: 'What is 7 × 8?',                         opts: ['54','56','58','64'],                       ans: 1 },
  { q: 'Who painted the Mona Lisa?',             opts: ['Picasso','Rembrandt','da Vinci','Monet'],  ans: 2 },
  { q: 'What planet is closest to the Sun?',     opts: ['Venus','Earth','Mercury','Mars'],          ans: 2 },
  { q: 'H₂O is the formula for...?',             opts: ['Hydrogen','Oxygen','Water','Salt'],        ans: 2 },
  { q: 'How many continents are there?',         opts: ['5','6','7','8'],                           ans: 2 },
  { q: 'What year did WW2 end?',                 opts: ['1943','1944','1945','1946'],                ans: 2 },
  { q: 'Speed of light ≈ ?',                     opts: ['300 km/s','300,000 km/s','30,000 km/s','3,000 km/s'], ans: 1 },
  { q: 'Largest ocean on Earth?',                opts: ['Atlantic','Indian','Arctic','Pacific'],    ans: 3 },
  { q: 'How many sides does a hexagon have?',    opts: ['5','6','7','8'],                           ans: 1 },
];

let qzIdx = 0, qzScore = 0, qzCorrect = 0, qzStreak = 0;
let qzTimerInt = null, qzTime = 10, qzRunning = false;

function startQuiz() {
  qzIdx = 0; qzScore = 0; qzCorrect = 0; qzStreak = 0;
  qzRunning = true;
  loadQuizQ();
}

function loadQuizQ() {
  if (qzIdx >= QUIZ_QUESTIONS.length) { endQuiz(); return; }
  clearInterval(qzTimerInt);
  qzTime = 10;

  const q = QUIZ_QUESTIONS[qzIdx];
  document.getElementById('qz-question').textContent = q.q;
  document.getElementById('qz-num').textContent = qzIdx + 1;
  document.getElementById('qz-time').textContent = qzTime;
  document.getElementById('qz-timer-bar').style.width = '100%';

  const opts = document.getElementById('qz-opts');
  opts.innerHTML = '';
  q.opts.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'quiz-opt';
    btn.textContent = opt;
    btn.onclick = () => answerQuiz(i, q.ans);
    opts.appendChild(btn);
  });

  qzTimerInt = setInterval(() => {
    qzTime--;
    document.getElementById('qz-time').textContent = qzTime;
    document.getElementById('qz-timer-bar').style.width = (qzTime / 10 * 100) + '%';
    if (qzTime <= 0) { clearInterval(qzTimerInt); timeoutQuiz(q.ans); }
  }, 1000);
}

function answerQuiz(chosen, correct) {
  clearInterval(qzTimerInt);
  const opts = document.querySelectorAll('.quiz-opt');
  opts.forEach((o, i) => {
    o.disabled = true;
    if (i === correct) o.classList.add('correct');
    else if (i === chosen && chosen !== correct) o.classList.add('wrong');
  });

  if (chosen === correct) {
    qzCorrect++;
    qzStreak++;
    const pts = 10 + qzStreak * 2 + qzTime;
    qzScore += pts;
    document.getElementById('qz-correct').textContent = qzCorrect;
    document.getElementById('qz-streak').textContent = qzStreak;
    document.getElementById('qz-score-top').textContent = qzScore + 'pts';
    spawnFloater(`+${pts}pts ⚡`, 'var(--neon-cyan)');
    progressChallenge('c4');
  } else {
    qzStreak = 0;
    document.getElementById('qz-streak').textContent = 0;
  }

  qzIdx++;
  setTimeout(loadQuizQ, 1000);
}

function timeoutQuiz(correct) {
  const opts = document.querySelectorAll('.quiz-opt');
  opts.forEach((o, i) => { o.disabled = true; if (i === correct) o.classList.add('correct'); });
  qzStreak = 0;
  qzIdx++;
  setTimeout(loadQuizQ, 1200);
}

async function endQuiz() {
  qzRunning = false;
  const xpEarned = Math.ceil(qzScore / 10);
  document.getElementById('qz-question').innerHTML = `
    <div style="text-align:center">
      <div style="font-size:1.5rem;margin-bottom:.5rem;">🏁 Quiz Done!</div>
      <div style="font-family:'Orbitron',monospace;font-size:.9rem;color:var(--neon-cyan);">${qzCorrect}/10 correct</div>
      <div style="font-size:.8rem;color:var(--text-dim);margin-top:.3rem;">${qzScore} points → ~${xpEarned} XP</div>
    </div>`;
  document.getElementById('qz-opts').innerHTML = `<button class="quiz-opt" onclick="startQuiz()" style="grid-column:1/-1;padding:1rem;">🔄 Play Again</button>`;
  document.getElementById('qz-timer-bar').style.width = '0%';

  addActivity('⚡', `Speed Quiz: ${qzCorrect}/10 correct, ${qzScore}pts`, xpEarned);
  spawnFloater(`+${xpEarned} XP ⚡`, 'var(--neon-cyan)');

  // Give real XP
  for (let i = 0; i < Math.min(xpEarned, 10); i++) {
    await callAPI('/gamification/correct-answer');
    state.points += 10;
    await new Promise(r => setTimeout(r, 80));
  }
  updateUI({ points: state.points, level: Math.floor(state.points / 100) + 1 });
  if (qzCorrect >= 7) launchConfetti();
}

// ═══════════════════════════════════════════════════════
//  ROULETTE
// ═══════════════════════════════════════════════════════
const ROULETTE_XP = [5, 10, 25, 50, 15, 30, 5, 10];
let rouletteSpun = false;

async function spinRoulette() {
  if (rouletteSpun) {
    addActivity('ℹ️', 'Roulette: 1 spin per session!');
    return;
  }
  rouletteSpun = true;

  const btn = document.getElementById('spin-btn');
  btn.disabled = true;
  btn.textContent = '🌀 Spinning...';

  const wheel = document.getElementById('roulette-wheel');
  const center = document.getElementById('roulette-center');

  const sectorIdx = Math.floor(Math.random() * 8);
  const xp        = ROULETTE_XP[sectorIdx];
  const extraRot  = 360 * 5 + (sectorIdx * 45);

  wheel.style.transform = `rotate(${extraRot}deg)`;
  center.textContent    = '...';

  setTimeout(async () => {
    center.textContent = '+' + xp;
    spawnFloater(`+${xp} XP 🎰`, 'var(--neon-yellow)');
    addActivity('🎰', `Roulette win!`, xp);

    // Give XP
    for (let i = 0; i < Math.ceil(xp / 10); i++) {
      await callAPI('/gamification/correct-answer');
      state.points += 10;
      await new Promise(r => setTimeout(r, 100));
    }
    updateUI({ points: state.points, level: Math.floor(state.points / 100) + 1 });
    if (xp >= 25) launchConfetti();

    btn.textContent = '✅ Used today!';
  }, 3200);
}

// ═══════════════════════════════════════════════════════
//  STREAK CALENDAR
// ═══════════════════════════════════════════════════════
function buildStreakCal() {
  const cal = document.getElementById('streak-cal');
  cal.innerHTML = '';
  const today = new Date();
  const streak = state.streak;

  for (let i = 27; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(today.getDate() - i);
    const isToday   = i === 0;
    const isActive  = i < streak;
    const day       = d.getDate();

    const cell = document.createElement('div');
    cell.className = 'streak-day' + (isActive ? ' active' : '') + (isToday ? ' today' : '');
    if (!isActive) cell.textContent = day;
    cal.appendChild(cell);
  }
}

// ═══════════════════════════════════════════════════════
//  CONFETTI
// ═══════════════════════════════════════════════════════
let confettiParts = [], confettiRunning = false;
const COLORS = ['#00f5ff','#ff006e','#39ff14','#ffea00','#bf00ff','#ff6b00'];

function launchConfetti() {
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  canvas.width  = window.innerWidth;
  canvas.height = window.innerHeight;
  canvas.classList.add('show');

  for (let i = 0; i < 120; i++) {
    confettiParts.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height - canvas.height,
      w: 6 + Math.random() * 8,
      h: 10 + Math.random() * 12,
      color: COLORS[Math.floor(Math.random() * COLORS.length)],
      vy: 3 + Math.random() * 5,
      vx: (Math.random() - 0.5) * 4,
      rot: Math.random() * 360,
      vr: (Math.random() - 0.5) * 8,
    });
  }

  if (!confettiRunning) {
    confettiRunning = true;
    animateConfetti(ctx, canvas);
  }

  setTimeout(stopConfetti, 3500);
}

function animateConfetti(ctx, canvas) {
  if (!confettiRunning) return;
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  confettiParts = confettiParts.filter(p => p.y < canvas.height + 20);
  confettiParts.forEach(p => {
    p.y += p.vy; p.x += p.vx; p.rot += p.vr;
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(p.rot * Math.PI / 180);
    ctx.fillStyle = p.color;
    ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
    ctx.restore();
  });
  requestAnimationFrame(() => animateConfetti(ctx, canvas));
}

function stopConfetti() {
  confettiRunning = false;
  confettiParts = [];
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  canvas.classList.remove('show');
}

// ═══════════════════════════════════════════════════════
//  LEADERBOARD REFRESH
// ═══════════════════════════════════════════════════════
async function refreshLeaderboard() {
  const list = document.getElementById('leaderboard-list');
  list.style.opacity = '.4';
  await new Promise(r => setTimeout(r, 500));
  list.style.opacity = '1';
  addActivity('📡', 'Leaderboard refreshed');
}

// ═══════════════════════════════════════════════════════
//  CHALLENGE TIMER COUNTDOWN
// ═══════════════════════════════════════════════════════
function updateChallengeTimer() {
  const now  = new Date();
  const midnight = new Date(now); midnight.setHours(24,0,0,0);
  const diff = Math.floor((midnight - now) / 1000);
  const h = Math.floor(diff / 3600);
  const m = Math.floor((diff % 3600) / 60);
  const s = diff % 60;
  const el = document.getElementById('challenge-timer');
  if (el) el.textContent = `Resets in ${h}h ${m}m ${s}s`;
}
setInterval(updateChallengeTimer, 1000);

// ═══════════════════════════════════════════════════════
//  INIT
// ═══════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  initMemory();
  renderChallenges();
  buildStreakCal();
  updateChallengeTimer();

  // Set challenge progress from real data
  challengeProgress.c1 = Math.min(state.correct, 5);
  challengeProgress.c2 = Math.min(state.streak, 3);
  challengeProgress.c3 = Math.min(state.decks, 2);
  renderChallenges();

  // Animate XP bar
  setTimeout(() => {
    const fill = document.getElementById('xp-bar-fill');
    if (fill) { const w = fill.style.width; fill.style.width = '0'; setTimeout(() => fill.style.width = w, 200); }
  }, 300);

  addActivity('🚀', 'Welcome to XP Arena!');
});
</script>
