{% extends 'base.html.twig' %}
{% block title %}⚡ XP Arena — Gamification{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  .arena-wrap, .arena-wrap * { font-family: 'Plus Jakarta Sans', sans-serif; }

  .xp-bar-fill {
    transition: width 1.5s cubic-bezier(.4,0,.2,1);
    background: linear-gradient(90deg, #8b5cf6, #22c55e);
  }

  .card-lift { transition: transform .2s ease, box-shadow .2s ease; }
  .card-lift:hover { transform: translateY(-3px); }

  /* Memory cards — fixed size to avoid aspect-ratio issues */
  #memory-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
  .mem-card { width:100%; padding-top:100%; border-radius:10px; cursor:pointer; position:relative; transform-style:preserve-3d; transition:transform .4s; }
  .mem-card.flipped, .mem-card.matched { transform: rotateY(180deg); }
  .mem-card.matched .mem-back { background:#dcfce7 !important; border-color:#22c55e !important; }
  .mem-face, .mem-back { position:absolute; inset:0; border-radius:10px; display:flex; align-items:center; justify-content:center; backface-visibility:hidden; }
  .mem-face { background:#f3f4f6; border:2px solid #e5e7eb; color:#9ca3af; font-size:.9rem; }
  .dark .mem-face { background:#1e293b; border-color:#334155; color:#475569; }
  .mem-back { background:#ede9fe; border:2px solid #a78bfa; font-size:1.2rem; transform:rotateY(180deg); }
  .dark .mem-back { background:#2e1065; border-color:#7c3aed; }

  /* Roulette */
  .roulette-wheel {
    width:160px; height:160px; margin:0 auto; border-radius:50%;
    background: conic-gradient(#f472b6 0deg 45deg,#818cf8 45deg 90deg,#fbbf24 90deg 135deg,#34d399 135deg 180deg,#a78bfa 180deg 225deg,#fb923c 225deg 270deg,#f472b6 270deg 315deg,#60a5fa 315deg 360deg);
    border:4px solid white; box-shadow:0 4px 24px rgba(0,0,0,.12); transition:transform 3s cubic-bezier(.17,.67,.12,.99); position:relative;
  }
  .dark .roulette-wheel { border-color:#1e293b; }
  .roulette-center { position:absolute; inset:22%; border-radius:50%; background:white; border:3px solid #e5e7eb; display:flex; align-items:center; justify-content:center; font-size:.75rem; font-weight:800; color:#7c3aed; }
  .dark .roulette-center { background:#0f172a; border-color:#334155; color:#a78bfa; }

  /* Streak calendar — explicit height avoids aspect-ratio bloat */
  #streak-cal { display:grid !important; grid-template-columns:repeat(7,1fr) !important; gap:4px; }
  .streak-day { height:26px; min-height:26px; max-height:26px; border-radius:5px; background:#f3f4f6; border:1px solid #e5e7eb; display:flex; align-items:center; justify-content:center; font-size:.52rem; color:#9ca3af; position:relative; overflow:hidden; }
  .dark .streak-day { background:#1e293b; border-color:#334155; color:#475569; }
  .streak-day.active { background:#fff7ed; border-color:#fb923c; color:transparent; font-size:0; }
  .dark .streak-day.active { background:rgba(251,146,60,.15); border-color:#fb923c; }
  .streak-day.active::after { content:'🔥'; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:.7rem; }
  .streak-day.today { border:2px solid #8b5cf6; box-shadow:0 0 0 2px rgba(139,92,246,.12); }

  /* Activity feed */
  .activity-feed { max-height:280px; overflow-y:auto; }
  .activity-feed::-webkit-scrollbar { width:4px; }
  .activity-feed::-webkit-scrollbar-thumb { background:#e5e7eb; border-radius:99px; }
  .dark .activity-feed::-webkit-scrollbar-thumb { background:#334155; }

  .act-item { animation:actSlide .3s ease-out; }
  @keyframes actSlide { from{opacity:0;transform:translateX(-12px)} to{opacity:1;transform:translateX(0)} }

  /* Quiz */
  .quiz-opt { transition:all .15s; }
  .quiz-opt:hover:not(:disabled) { background:#ede9fe; border-color:#8b5cf6; color:#7c3aed; }
  .dark .quiz-opt:hover:not(:disabled) { background:rgba(139,92,246,.15); border-color:#8b5cf6; color:#a78bfa; }
  .quiz-opt.correct { background:#dcfce7 !important; border-color:#22c55e !important; color:#16a34a !important; }
  .quiz-opt.wrong   { background:#fee2e2 !important; border-color:#ef4444 !important; color:#dc2626 !important; }
  .dark .quiz-opt.correct { background:rgba(34,197,94,.15) !important; color:#4ade80 !important; }
  .dark .quiz-opt.wrong   { background:rgba(239,68,68,.15)  !important; color:#f87171 !important; }

  /* XP Floater */
  .xp-floater { position:fixed; font-family:'Plus Jakarta Sans',sans-serif; font-size:1rem; font-weight:800; pointer-events:none; z-index:9999; animation:floatUp 1.5s ease-out forwards; }
  @keyframes floatUp { 0%{opacity:1;transform:translateY(0) scale(1)} 100%{opacity:0;transform:translateY(-100px) scale(1.2)} }

  /* Level up */
  #levelup-overlay { display:none; position:fixed; inset:0; z-index:9998; background:rgba(0,0,0,.55); align-items:center; justify-content:center; backdrop-filter:blur(6px); }
  #levelup-overlay.show { display:flex; }
  .levelup-box { animation:bounceIn .5s cubic-bezier(.36,.07,.19,.97); }
  @keyframes bounceIn { 0%{transform:scale(.6);opacity:0} 70%{transform:scale(1.05)} 100%{transform:scale(1);opacity:1} }

  /* Badge toasts */
  #badge-toast-area { position:fixed; top:1.5rem; right:1.5rem; z-index:9990; display:flex; flex-direction:column; gap:.5rem; }
  .badge-toast { animation:toastIn .4s ease forwards; }
  @keyframes toastIn { from{transform:translateX(80px);opacity:0} to{transform:translateX(0);opacity:1} }

  /* Confetti */
  #confetti-canvas { position:fixed; inset:0; z-index:9997; pointer-events:none; display:none; }
  #confetti-canvas.show { display:block; }

  /* Live dot */
  @keyframes livePulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.6;transform:scale(1.3)} }
  .live-dot { animation:livePulse 1.2s ease-in-out infinite; }

  /* Challenge progress */
  .ch-prog-fill { height:100%; border-radius:99px; transition:width 1s ease; }

  /* Earn XP buttons */
  .xp-earn-btn {
    display:flex; flex-direction:column; align-items:center; gap:.35rem;
    padding:1rem; border-radius:12px; border:2px solid transparent;
    cursor:pointer; text-align:center; transition:all .2s;
    font-family:'Plus Jakarta Sans',sans-serif; background:transparent;
  }
  .xp-earn-btn:hover { transform:translateY(-2px); }
  .xp-earn-btn:disabled { opacity:.4; cursor:not-allowed; transform:none; }
</style>
{% endblock %}

{% block body %}
<canvas id="confetti-canvas"></canvas>

{# Level Up Overlay #}
<div id="levelup-overlay">
  <div class="levelup-box card p-10 text-center max-w-sm w-11/12 mx-4">
    <div class="text-6xl mb-4">🚀</div>
    <p class="text-xs font-bold text-secondary-400 dark:text-secondary-500 uppercase tracking-widest mb-1">Level Up!</p>
    <div id="lu-num" class="text-7xl font-extrabold text-primary-600 dark:text-primary-400">2</div>
    <p class="text-secondary-500 dark:text-secondary-400 text-sm mt-3 mb-6">You reached a new level — keep going! 🔥</p>
    <button onclick="closeLevelUp()" class="btn btn-primary w-full justify-center">⚡ Continue</button>
  </div>
</div>

{# Badge Toasts #}
<div id="badge-toast-area"></div>

<div class="arena-wrap space-y-6 animate-fade-in">

  {# Page Header #}
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div>
      <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">⚡ XP Arena</h1>
      <p class="text-secondary-500 dark:text-secondary-400 mt-1">Your gamification dashboard</p>
    </div>
    <a href="{{ path('app_revisions') }}" class="btn btn-secondary">← Back to Revisions</a>
  </div>

  {# Hero Banner #}
  <div class="card overflow-hidden">
    <div class="p-5">
      <div class="flex items-center justify-between flex-wrap gap-5">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl flex-shrink-0"
               style="background:linear-gradient(135deg,#ede9fe,#dcfce7)">🎓</div>
          <div>
            <h2 class="text-xl font-bold text-secondary-900 dark:text-white">
              Level <span id="cur-level" class="text-primary-600 dark:text-primary-400">{{ gamification.level }}</span> — Your Arena
            </h2>
            <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-0.5">
              🔥 <span id="cur-streak" class="font-semibold text-warning-500">{{ gamification.streak }}</span> day streak &nbsp;·&nbsp;
              🏆 Rank <span class="font-semibold text-primary-600 dark:text-primary-400">#<span id="cur-rank">{{ userRank }}</span></span> &nbsp;·&nbsp;
              🎖 <span id="cur-badges" class="font-semibold text-warning-500">{{ gamification.badges|length }}</span> badge{{ gamification.badges|length != 1 ? 's' : '' }}
            </p>
            {% if gamification.badges|length > 0 %}
            <div class="flex gap-1.5 mt-2 flex-wrap">
              {% for badge in gamification.badges|slice(0,3) %}
              <span class="bg-warning-100 dark:bg-warning-900/30 border border-warning-300 dark:border-warning-700 text-warning-700 dark:text-warning-400 text-xs font-bold px-2.5 py-0.5 rounded-full">{{ badge.name }}</span>
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>

        <div class="min-w-64 flex-1 max-w-sm">
          <div class="flex items-baseline gap-1.5 justify-end mb-2">
            <span id="xp-display" class="text-3xl font-extrabold text-primary-600 dark:text-primary-400">{{ gamification.points }}</span>
            <span class="text-secondary-400 dark:text-secondary-500 font-semibold text-sm">XP</span>
          </div>
          <div class="flex justify-between text-xs text-secondary-500 dark:text-secondary-400 font-medium mb-1.5">
            <span>Lv <span id="lv-cur">{{ gamification.level }}</span></span>
            <span id="xp-prog-txt">{{ gamification.levelProgress }}% → Lv<span id="lv-next">{{ gamification.level + 1 }}</span></span>
          </div>
          <div class="h-3 bg-secondary-100 dark:bg-secondary-700 rounded-full overflow-hidden border border-secondary-200 dark:border-secondary-700">
            <div class="xp-bar-fill h-full rounded-full" id="xp-bar-fill" style="width:{{ progressPercent }}%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# Stat Cards #}
  <div class="grid grid-cols-3 md:grid-cols-6 gap-4">
    <div class="card p-4 card-lift text-center">
      <div class="w-11 h-11 rounded-xl mx-auto mb-2 flex items-center justify-center bg-primary-100 dark:bg-primary-900/30 text-2xl">💎</div>
      <div id="s-xp" class="text-2xl font-extrabold text-secondary-900 dark:text-white">{{ gamification.points }}</div>
      <div class="text-xs text-secondary-400 dark:text-secondary-500 font-semibold uppercase tracking-wide mt-0.5">Total XP</div>
    </div>
    <div class="card p-4 card-lift text-center">
      <div class="w-11 h-11 rounded-xl mx-auto mb-2 flex items-center justify-center bg-accent-100 dark:bg-accent-900/30 text-2xl">⭐</div>
      <div id="s-lvl" class="text-2xl font-extrabold text-secondary-900 dark:text-white">{{ gamification.level }}</div>
      <div class="text-xs text-secondary-400 dark:text-secondary-500 font-semibold uppercase tracking-wide mt-0.5">Level</div>
    </div>
    <div class="card p-4 card-lift text-center">
      <div class="w-11 h-11 rounded-xl mx-auto mb-2 flex items-center justify-center bg-warning-100 dark:bg-warning-900/30 text-2xl">🔥</div>
      <div id="s-streak" class="text-2xl font-extrabold text-secondary-900 dark:text-white">{{ gamification.streak }}</div>
      <div class="text-xs text-secondary-400 dark:text-secondary-500 font-semibold uppercase tracking-wide mt-0.5">Day Streak</div>
    </div>
    <div class="card p-4 card-lift text-center">
      <div class="w-11 h-11 rounded-xl mx-auto mb-2 flex items-center justify-center bg-warning-100 dark:bg-warning-900/30 text-2xl">🏆</div>
      <div class="text-2xl font-extrabold text-secondary-900 dark:text-white">#<span id="s-rank">{{ userRank }}</span></div>
      <div class="text-xs text-secondary-400 dark:text-secondary-500 font-semibold uppercase tracking-wide mt-0.5">Rank</div>
    </div>
    <div class="card p-4 card-lift text-center">
      <div class="w-11 h-11 rounded-xl mx-auto mb-2 flex items-center justify-center bg-primary-100 dark:bg-primary-900/30 text-2xl">📚</div>
      <div id="s-decks" class="text-2xl font-extrabold text-secondary-900 dark:text-white">{{ gamification.totalDecksCompleted }}</div>
      <div class="text-xs text-secondary-400 dark:text-secondary-500 font-semibold uppercase tracking-wide mt-0.5">Decks Done</div>
    </div>
    <div class="card p-4 card-lift text-center">
      <div class="w-11 h-11 rounded-xl mx-auto mb-2 flex items-center justify-center bg-success-100 dark:bg-success-900/30 text-2xl">✅</div>
      <div id="s-correct" class="text-2xl font-extrabold text-secondary-900 dark:text-white">{{ gamification.totalCorrectAnswers }}</div>
      <div class="text-xs text-secondary-400 dark:text-secondary-500 font-semibold uppercase tracking-wide mt-0.5">Correct Ans.</div>
    </div>
  </div>

  {# Row 1: Earn XP + Daily Challenges #}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

    {# Earn XP #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center text-sm">⚡</div>
          Earn XP
        </h3>
        <span class="text-xs text-secondary-400 dark:text-secondary-500">Click to gain points!</span>
      </div>
      <div class="p-5">
        <div class="grid grid-cols-2 gap-3">
          <button id="btn-correct" onclick="earnCorrectAnswer()"
            class="xp-earn-btn bg-success-50 dark:bg-success-900/20 border-success-200 dark:border-success-800 hover:border-success-400">
            <span class="text-2xl">🎯</span>
            <span class="text-sm font-bold text-secondary-800 dark:text-white">Correct Answer</span>
            <span class="text-xs text-secondary-400 dark:text-secondary-500">Simulate a right answer</span>
            <span class="text-xs font-extrabold text-success-600 dark:text-success-400 bg-success-100 dark:bg-success-900/30 px-2.5 py-0.5 rounded-full">+10 XP</span>
          </button>
          <button id="btn-deck" onclick="earnDeckCompleted()"
            class="xp-earn-btn bg-primary-50 dark:bg-primary-900/20 border-primary-200 dark:border-primary-800 hover:border-primary-400">
            <span class="text-2xl">📚</span>
            <span class="text-sm font-bold text-secondary-800 dark:text-white">Complete Deck</span>
            <span class="text-xs text-secondary-400 dark:text-secondary-500">Finish a study deck</span>
            <span class="text-xs font-extrabold text-primary-600 dark:text-primary-400 bg-primary-100 dark:bg-primary-900/30 px-2.5 py-0.5 rounded-full">+50 XP</span>
          </button>
          <button id="btn-daily" onclick="earnDailyRevision()"
            class="xp-earn-btn bg-warning-50 dark:bg-warning-900/20 border-warning-200 dark:border-warning-800 hover:border-warning-400">
            <span class="text-2xl">📅</span>
            <span class="text-sm font-bold text-secondary-800 dark:text-white">Daily Revision</span>
            <span class="text-xs text-secondary-400 dark:text-secondary-500">1× per day bonus</span>
            <span class="text-xs font-extrabold text-warning-600 dark:text-warning-400 bg-warning-100 dark:bg-warning-900/30 px-2.5 py-0.5 rounded-full">+15 XP</span>
          </button>
          <button id="btn-streak" onclick="doStreak10()"
            class="xp-earn-btn bg-orange-50 dark:bg-orange-900/20 border-orange-200 dark:border-orange-800 hover:border-orange-400">
            <span class="text-2xl">🔥</span>
            <span class="text-sm font-bold text-secondary-800 dark:text-white">Streak Bonus</span>
            <span class="text-xs text-secondary-400 dark:text-secondary-500">10 correct in a row</span>
            <span class="text-xs font-extrabold text-orange-600 dark:text-orange-400 bg-orange-100 dark:bg-orange-900/30 px-2.5 py-0.5 rounded-full">+100 XP</span>
          </button>
        </div>
        <div class="mt-4 bg-secondary-50 dark:bg-secondary-800 rounded-xl p-3 border border-secondary-200 dark:border-secondary-700">
          <p class="text-xs font-bold text-secondary-400 dark:text-secondary-500 uppercase tracking-wide mb-2">⏱️ Cooldowns</p>
          <div class="flex flex-col gap-1.5">
            <div class="flex justify-between text-sm">
              <span class="text-secondary-600 dark:text-secondary-400">Correct Answer</span>
              <span id="cd-correct" class="font-bold text-xs text-success-500">READY</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-secondary-600 dark:text-secondary-400">Daily Revision</span>
              <span id="cd-daily" class="font-bold text-xs text-success-500">READY</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {# Daily Challenges #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center text-sm">🎯</div>
          Daily Challenges
        </h3>
        <span id="challenge-timer" class="text-xs text-secondary-400 dark:text-secondary-500">Resets at midnight</span>
      </div>
      <div class="p-5">
        <div class="flex flex-col gap-3" id="challenge-list"></div>
      </div>
    </div>
  </div>

  {# Row 2: Memory + Speed Quiz + Leaderboard #}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    {# Memory Game #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center text-sm">🃏</div>
          Memory Game
        </h3>
        <button onclick="initMemory()" class="btn btn-secondary" style="padding:.3rem .7rem;font-size:.72rem;">↺ Reset</button>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-3 gap-2 mb-3">
          <div class="bg-secondary-50 dark:bg-secondary-800 rounded-xl p-2 text-center border border-secondary-200 dark:border-secondary-700">
            <div id="mem-moves" class="text-lg font-extrabold text-secondary-900 dark:text-white">0</div>
            <div class="text-xs text-secondary-400 dark:text-secondary-500 font-medium">Moves</div>
          </div>
          <div class="bg-secondary-50 dark:bg-secondary-800 rounded-xl p-2 text-center border border-secondary-200 dark:border-secondary-700">
            <div id="mem-pairs" class="text-lg font-extrabold text-secondary-900 dark:text-white">0/8</div>
            <div class="text-xs text-secondary-400 dark:text-secondary-500 font-medium">Pairs</div>
          </div>
          <div class="bg-secondary-50 dark:bg-secondary-800 rounded-xl p-2 text-center border border-secondary-200 dark:border-secondary-700">
            <div id="mem-timer" class="text-lg font-extrabold text-secondary-900 dark:text-white">0s</div>
            <div class="text-xs text-secondary-400 dark:text-secondary-500 font-medium">Time</div>
          </div>
        </div>
        <div id="memory-grid"></div>
        <p class="text-xs text-secondary-400 dark:text-secondary-500 text-center mt-2.5">
          🏆 Complete to earn <strong class="text-warning-500">+30 XP</strong>
        </p>
      </div>
    </div>

    {# Speed Quiz #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center text-sm">⚡</div>
          Speed Quiz
        </h3>
        <div class="flex items-center gap-2">
          <span class="text-xs text-secondary-400 dark:text-secondary-500">Q <span id="qz-num">1</span>/10</span>
          <span class="text-xs font-bold text-primary-600 dark:text-primary-400" id="qz-score-top">0 pts</span>
        </div>
      </div>
      <div class="p-4">
        <div class="h-1.5 bg-secondary-100 dark:bg-secondary-700 rounded-full overflow-hidden mb-3">
          <div id="qz-timer-bar" class="h-full rounded-full" style="width:100%;background:linear-gradient(90deg,#22c55e,#fbbf24,#ef4444);transition:width .1s linear;"></div>
        </div>
        <div id="qz-question"
             class="min-h-16 flex items-center justify-center text-sm font-semibold text-secondary-700 dark:text-secondary-300 text-center bg-secondary-50 dark:bg-secondary-800 rounded-xl p-4 mb-3 border border-secondary-200 dark:border-secondary-700">
          Press START to play!
        </div>
        <div class="grid grid-cols-2 gap-2 mb-3" id="qz-opts">
          <button onclick="startQuiz()" class="col-span-2 btn btn-primary justify-center text-sm py-3">🚀 Start Quiz</button>
        </div>
        <div class="flex justify-between text-xs text-secondary-400 dark:text-secondary-500 font-medium">
          <span>⏱ <span id="qz-time">10</span>s</span>
          <span>✅ <span id="qz-correct">0</span> correct</span>
          <span>🔥 Streak <span id="qz-streak">0</span></span>
        </div>
      </div>
    </div>

    {# Leaderboard #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center text-sm">🥇</div>
          Leaderboard
        </h3>
        <button onclick="refreshLeaderboard()" class="btn btn-secondary" style="padding:.3rem .7rem;font-size:.72rem;">↺</button>
      </div>
      <div class="p-3">
        <div id="leaderboard-list" class="flex flex-col gap-1">
          {% for item in leaderboard %}
          {% set rank = loop.index %}
          <div class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl transition-colors
            hover:bg-secondary-50 dark:hover:bg-secondary-800
            {{ item.user == app.user ? 'bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800' : '' }}">
            <div class="w-7 text-center font-extrabold text-sm flex-shrink-0
              {{ rank == 1 ? 'text-warning-500' : (rank == 2 ? 'text-secondary-400 dark:text-secondary-500' : (rank == 3 ? 'text-orange-400' : 'text-secondary-400 dark:text-secondary-500')) }}">
              {{ rank == 1 ? '🥇' : (rank == 2 ? '🥈' : (rank == 3 ? '🥉' : rank)) }}
            </div>
            <div class="w-8 h-8 rounded-lg flex items-center justify-center text-white font-bold text-xs flex-shrink-0"
                 style="background:linear-gradient(135deg,#8b5cf6,#22c55e)">
              {{ item.user.email|slice(0,1)|upper }}
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-bold text-secondary-800 dark:text-secondary-200 truncate">
                {{ item.user.email|slice(0,16) }}{% if item.user.email|length > 16 %}…{% endif %}
                {% if item.user == app.user %}<span class="text-primary-500 dark:text-primary-400 text-xs"> (you)</span>{% endif %}
              </div>
              <div class="text-xs text-secondary-400 dark:text-secondary-500">Level {{ item.level }}</div>
            </div>
            <div class="text-sm font-extrabold text-primary-600 dark:text-primary-400">{{ item.points }}</div>
          </div>
          {% else %}
          <div class="text-center py-8 text-secondary-400 dark:text-secondary-500 text-sm">Be the first! Earn XP now 🚀</div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  {# Row 3: Roulette + Streak Calendar + Activity #}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    {# XP Roulette #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
