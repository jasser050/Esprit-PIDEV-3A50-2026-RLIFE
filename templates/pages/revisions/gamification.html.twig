  ctx.fillStyle='rgba(255,255,255,.4)';
  for(let i=0;i<50;i++){const sx=(i*137)%W, sy=(i*89)%120; ctx.fillRect(sx,sy,i%4===0?2:1,i%4===0?2:1);}
  // Buildings
  const bldgs=[{x:0,w:60,h:180,hue:260},{x:60,w:45,h:140,hue:280},{x:100,w:80,h:210,hue:240},{x:175,w:40,h:160,hue:270},{x:210,w:55,h:175,hue:220},{x:260,w:50,h:145,hue:260},{x:305,w:70,h:195,hue:290},{x:370,w:45,h:125,hue:250},{x:410,w:60,h:170,hue:230},{x:465,w:55,h:185,hue:270},{x:515,w:40,h:150,hue:240},{x:550,w:75,h:215,hue:280},{x:620,w:45,h:140,hue:260},{x:660,w:60,h:180,hue:200},{x:715,w:50,h:160,hue:270},{x:760,w:80,h:200,hue:250},{x:835,w:45,h:145,hue:230},{x:875,w:55,h:190,hue:280},{x:925,w:70,h:165,hue:260},{x:990,w:50,h:205,hue:290}];
  bldgs.forEach(b=>{
    const by=H-b.h-ROWS*CELL;
    const bg=ctx.createLinearGradient(b.x,by,b.x+b.w,by+b.h);
    bg.addColorStop(0,`hsla(${b.hue},60%,18%,0.92)`); bg.addColorStop(1,`hsla(${b.hue},60%,8%,0.92)`);
    ctx.fillStyle=bg; ctx.fillRect(b.x,by,b.w,b.h);
    for(let wy=by+10;wy<by+b.h-10;wy+=13){
