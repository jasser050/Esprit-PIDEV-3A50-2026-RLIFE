      ctx.fillStyle=rG; ctx.fillRect(o.x,oy,o.w,28);
      ctx.fillStyle='rgba(255,200,255,.3)'; ctx.fillRect(o.x,oy,o.w,6);
      const ep=Math.sin(o.frame*.15);
      ctx.fillStyle=`rgba(255,${Math.floor(200+ep*55)},0,.95)`;
      ctx.shadowColor='#ff8800'; ctx.shadowBlur=10;
      ctx.beginPath(); ctx.arc(o.x+8,oy+14,4,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(o.x+o.w-8,oy+14,4,0,Math.PI*2); ctx.fill();
      ctx.strokeStyle='#ff0000'; ctx.lineWidth=2;
      ctx.beginPath(); ctx.moveTo(o.x+4,oy+8); ctx.lineTo(o.x+12,oy+10); ctx.stroke();
