  ctx.fillText(Math.floor(runnerDist)+'m',10,32);
  if(runner.jumps>0){ctx.fillStyle='rgba(255,220,0,.85)';ctx.fillText('JUMP×'+runner.jumps,10,46);}
  ctx.shadowBlur=0;
}

/* ══════════════════════════════════════════════════════
   🎯 ARCHER 3D — CRYSTAL REALM
══════════════════════════════════════════════════════ */
let archerRunning=false, archerHits=0, archerCombo=0, archerTimeLeft=30, archerTimerInt=null;
let archerBgParticles=[], archerFrame3D=0;

function startArcher(){
  archerHits=0; archerCombo=0; archerTimeLeft=30; archerRunning=true; archerFrame3D=0;
  const arena=document.getElementById('archer-arena');
  arena.innerHTML=''; arena.style.background='transparent';
  const bgCanvas=document.createElement('canvas');
  bgCanvas.style.cssText='position:absolute;inset:0;border-radius:16px;pointer-events:none;';
  bgCanvas.width=arena.offsetWidth||900; bgCanvas.height=380; bgCanvas.id='archer-bg-canvas';
  arena.appendChild(bgCanvas);
  archerBgParticles=Array.from({length:50},()=>({x:Math.random()*900,y:Math.random()*380,vx:(Math.random()-.5)*.5,vy:-.3-Math.random()*.5,size:1+Math.random()*3,life:Math.random()*100,maxLife:100,hue:Math.floor(Math.random()*360)}));
  const golden=137.5, silver=100;
  function animateBg(){
    if(!archerRunning)return; archerFrame3D++;
    const bc=document.getElementById('archer-bg-canvas')?.getContext('2d'); if(!bc)return;
    const W=bc.canvas.width, H=380;
    bc.clearRect(0,0,W,H);
    const sg=bc.createLinearGradient(0,0,0,H);
    sg.addColorStop(0,'#020815'); sg.addColorStop(.4,'#050f2a'); sg.addColorStop(.75,'#0a1a05'); sg.addColorStop(1,'#040c02');
    bc.fillStyle=sg; bc.fillRect(0,0,W,H);
    const t2=archerFrame3D*.008;
    [[W*.15,H*.3,160,280],[W*.5,H*.2,200,200],[W*.82,H*.4,140,320]].forEach(([cx,cy,r,hue])=>{
      const ng=bc.createRadialGradient(cx,cy,0,cx,cy,r);
      ng.addColorStop(0,`hsla(${hue+t2*10},80%,30%,.24)`); ng.addColorStop(1,'transparent');
      bc.fillStyle=ng; bc.fillRect(0,0,W,H);
    });
    for(let i=0;i<60;i++){const sx=(i*golden)%W, sy=(i*silver)%180, tw=.4+Math.sin(t2*3+i)*.4;bc.fillStyle=`rgba(255,255,255,${tw})`;bc.fillRect(sx,sy,i%3===0?2:1.2,i%3===0?2:1.2);}
    [50,150,W-50,W-160,W*.4,W*.6].forEach((tx,ti)=>{
      bc.fillStyle=`rgba(0,${30+ti*5},${10+ti*3},.7)`;
      bc.beginPath(); bc.moveTo(tx-20,H); bc.lineTo(tx,H-160-ti*20); bc.lineTo(tx+20,H); bc.closePath(); bc.fill();
      bc.fillStyle=`rgba(0,${80+ti*8},${40+ti*5},.5)`;
      bc.beginPath(); bc.moveTo(tx-15,H-80); bc.lineTo(tx,H-210-ti*15); bc.lineTo(tx+15,H-80); bc.closePath(); bc.fill();
      bc.shadowColor=`hsl(${140+ti*20},100%,60%)`; bc.shadowBlur=12;
      bc.fillStyle=`hsl(${140+ti*20},100%,70%)`;
      bc.beginPath(); bc.arc(tx,H-160-ti*20,3,0,Math.PI*2); bc.fill();
      bc.shadowBlur=0;
    });
    const mg=bc.createLinearGradient(0,H-80,0,H);
    mg.addColorStop(0,'rgba(0,100,30,0)'); mg.addColorStop(1,'rgba(0,80,20,.4)');
    bc.fillStyle=mg; bc.fillRect(0,H-80,W,80);
    archerBgParticles.forEach(p=>{
      p.x+=p.vx; p.y+=p.vy; p.life++;
      if(p.life>p.maxLife){p.x=Math.random()*W;p.y=H;p.life=0;}
      const a=Math.min(1,Math.min(p.life,p.maxLife-p.life)/20);
      bc.shadowColor=`hsl(${p.hue},100%,70%)`; bc.shadowBlur=8;
      bc.fillStyle=`hsla(${p.hue},100%,70%,${a*.55})`;
      bc.beginPath(); bc.arc(p.x,p.y,p.size,0,Math.PI*2); bc.fill(); bc.shadowBlur=0;
    });
    requestAnimationFrame(animateBg);
  }
  animateBg();
  clearInterval(archerTimerInt);
  function spawnTarget(){
    if(!archerRunning)return;
    const t=document.createElement('div'); t.className='archer-target';
    const size=Math.max(38,75-archerHits*1.8), life=Math.max(800,2000-archerHits*50);
    const hues=[0,30,60,120,180,270,300]; const hue=hues[Math.floor(Math.random()*hues.length)];
    t.style.cssText=`width:${size}px;height:${size}px;left:${8+Math.random()*78}%;top:${8+Math.random()*68}%;background:radial-gradient(circle at 35% 35%,hsl(${hue},100%,82%),hsl(${hue},100%,42%),hsl(${hue},100%,16%));box-shadow:0 0 ${size*.65}px hsl(${hue},100%,62%),0 0 ${size*1.6}px hsl(${hue},100%,32%),inset 0 0 ${size*.35}px rgba(255,255,255,.35);border:3px solid hsl(${hue},100%,72%);cursor:crosshair;z-index:10;`;
    const rc=Math.ceil(size/22);
    const rings=Array.from({length:rc},(_,ri)=>`<div style="position:absolute;border-radius:50%;border:${ri===0?3:1}px solid hsla(${hue},100%,${90-ri*18}%,${.55-ri*.1});inset:${ri*10}px;"></div>`).join('');
    t.innerHTML=`${rings}<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:${size*.32}px;">💎</div>`;
    let pId=setInterval(()=>{if(!t.parentNode){clearInterval(pId);return;}t.style.transform=`scale(${1+Math.sin(Date.now()*.006)*.06}) rotate(${Math.sin(Date.now()*.003)*8}deg)`;},16);
    const fT=setTimeout(()=>{if(t.parentNode){t.style.opacity='.22';t.style.filter='blur(2px)';}},life*.6);
    t.addEventListener('click',e=>{
      clearTimeout(fT); clearInterval(pId);
      archerHits++; archerCombo++;
      document.getElementById('archer-hits').textContent=archerHits;
      document.getElementById('archer-combo').textContent='×'+archerCombo;
      document.getElementById('game-score-display').textContent=archerHits*archerCombo;
      for(let i=0;i<16;i++){
        const sp=document.createElement('div'), angle=Math.random()*Math.PI*2, dist=30+Math.random()*60;
        sp.style.cssText=`position:fixed;pointer-events:none;z-index:9999;width:${4+Math.random()*6}px;height:${4+Math.random()*6}px;border-radius:50%;background:hsl(${hue},100%,65%);box-shadow:0 0 8px hsl(${hue},100%,70%);left:${e.clientX}px;top:${e.clientY}px;transition:all 0.65s ease-out;`;
        document.body.appendChild(sp);
        setTimeout(()=>{sp.style.transform=`translate(${Math.cos(angle)*dist}px,${Math.sin(angle)*dist}px) scale(.15)`;sp.style.opacity='0';},10);
        setTimeout(()=>sp.remove(),720);
      }
      spawnFloater(`×${archerCombo} 💎`,`hsl(${hue},100%,68%)`);
      t.style.transform='scale(2.8)'; t.style.opacity='0'; t.style.transition='all .28s ease-out';
      setTimeout(()=>t.remove(),290);
    });
    arena.appendChild(t);
    setTimeout(()=>{if(t.parentNode){clearInterval(pId);t.remove();archerCombo=Math.max(0,archerCombo-1);document.getElementById('archer-combo').textContent='×'+Math.max(1,archerCombo);}},life);
    if(archerRunning) setTimeout(spawnTarget,Math.max(300,1100-archerHits*30));
  }
  spawnTarget();
  archerTimerInt=setInterval(()=>{
    archerTimeLeft--; document.getElementById('archer-time').textContent=archerTimeLeft;
    if(archerTimeLeft<=0){clearInterval(archerTimerInt);stopArcher();const xp=Math.max(5,archerHits*4);addXP(xp);spawnFloater(`+${xp} XP 🎯`,'#aa44ff');addActivity('🎯',`${playerName} — Archer 3D: ${archerHits} hits!`,xp);if(archerHits>=15)launchConfetti();}
  },1000);
}
function stopArcher(){archerRunning=false;clearInterval(archerTimerInt);document.getElementById('archer-arena').innerHTML='';document.getElementById('archer-arena').style.background='#020815';}

/* ══════════════════════════════════════════════════════
   ⚔️ CARD BATTLE
══════════════════════════════════════════════════════ */
const BATTLE_CARDS=[
  {name:'Algorithm',   emoji:'⚡',power:90,type:'TECH',   color:'#00ff88',effect:'stun',   effectVal:15},
  {name:'Mathematics', emoji:'📐',power:72,type:'SCIENCE',color:'#00ddff',effect:'shield', effectVal:10},
  {name:'Physics',     emoji:'🔭',power:68,type:'SCIENCE',color:'#0088ff',effect:'absorb', effectVal:8},
  {name:'History',     emoji:'📜',power:58,type:'HISTORY',color:'#ff8800',effect:'heal',   effectVal:12},
  {name:'Biology',     emoji:'🧬',power:76,type:'SCIENCE',color:'#00cc44',effect:'regen',  effectVal:6},
  {name:'Chemistry',   emoji:'⚗️',power:84,type:'TECH',  color:'#ff00aa',effect:'poison', effectVal:10},
  {name:'Literature',  emoji:'📖',power:54,type:'ARTS',   color:'#aa44ff',effect:'inspire',effectVal:8},
  {name:'Logic',       emoji:'🧩',power:80,type:'TECH',   color:'#ffdd00',effect:'confuse',effectVal:12},
];
const EFX={stun:'Stun +',shield:'Shield +',absorb:'Absorb +',heal:'Heal +',regen:'Regen +',poison:'Poison -',inspire:'Inspire +',confuse:'Confuse +'};
let playerHP=100,aiHP=100,battleActive=false,playerHand=[],aiHand=[],turnNum=0;
function initBattle(){
  playerHP=100;aiHP=100;battleActive=true;turnNum=0;
  playerHand=[...BATTLE_CARDS].sort(()=>Math.random()-.5).slice(0,5);
  aiHand=[...BATTLE_CARDS].sort(()=>Math.random()-.5).slice(0,5);
  document.getElementById('battle-result').textContent='Select a card to play!';
  document.getElementById('battle-result').style.color='#475569';
  document.getElementById('battle-log').innerHTML='<div style="color:#334155;font-size:.62rem;">Round begins — your move!</div>';
  if(playerName) document.getElementById('battle-player-label').textContent='— '+playerName.toUpperCase()+' —';
  renderBattleUI();
}
function renderBattleUI(){
  document.getElementById('player-hp-fill').style.width=Math.max(0,playerHP)+'%';
  document.getElementById('ai-hp-fill').style.width=Math.max(0,aiHP)+'%';
  document.getElementById('player-hp-num').textContent=Math.max(0,playerHP);
  document.getElementById('ai-hp-num').textContent=Math.max(0,aiHP);
  document.getElementById('player-hp-fill').style.background=playerHP>50?'linear-gradient(90deg,#00ff88,#00ddaa)':'linear-gradient(90deg,#ff8800,#ff4444)';
  const pc=document.getElementById('player-cards'); pc.innerHTML='';
  playerHand.forEach((card,i)=>{
    const el=document.createElement('div'); el.className='bcard'; el.style.borderColor=card.color+'66';
    el.innerHTML=`<div class="bcard-type" style="color:${card.color}66;">${card.type}</div><div class="bcard-icon">${card.emoji}</div><div class="bcard-name" style="color:${card.color};">${card.name}</div><div class="bcard-power" style="color:${card.color};text-shadow:0 0 10px ${card.color};">${card.power}</div><div class="bcard-bar" style="background:${card.color}22;"><div style="width:${card.power}%;height:100%;background:${card.color};border-radius:99px;transition:width .3s;"></div></div><div class="bcard-type" style="color:${card.color}88;">${EFX[card.effect]||''}${card.effectVal}</div>`;
    // Holographic shimmer on hover
    el.addEventListener('mouseenter',()=>{el.style.boxShadow=`0 24px 48px rgba(0,0,0,.7),0 0 24px ${card.color}44`;el.style.borderColor=card.color;});
    el.addEventListener('mouseleave',()=>{el.style.boxShadow='';el.style.borderColor=card.color+'66';});
    el.addEventListener('click',()=>battlePlayCard(i));
    pc.appendChild(el);
  });
  const ac=document.getElementById('ai-cards'); ac.innerHTML='';
  aiHand.forEach(()=>{
    const el=document.createElement('div'); el.className='bcard ai-card-back';
    el.innerHTML=`<div style="font-size:2.2rem;opacity:.5;">🤖</div><div class="bcard-name" style="color:#ff00aa66;">AI CARD</div><div class="bcard-power" style="color:#ff00aa;">???</div>`;
    ac.appendChild(el);
  });
}
async function battlePlayCard(idx){
  if(!battleActive||!playerHand[idx])return; battleActive=false; turnNum++;
  const pCard=playerHand[idx];
  const sortedAI=[...aiHand].sort((a,b)=>a.power-b.power);
  const aiCard=sortedAI.find(c=>c.power>pCard.power)||sortedAI[sortedAI.length-1];
  document.getElementById('player-cards').children[idx]?.classList.add('played-card');
  await new Promise(r=>setTimeout(r,450));
  const log=document.getElementById('battle-log'), result=document.getElementById('battle-result');
  let logEntry='';
  if(pCard.power>aiCard.power){
    const dmg=Math.floor((pCard.power-aiCard.power)*.5)+10; let bonus='';
    if(pCard.effect==='poison'){aiHP=Math.max(0,aiHP-dmg-pCard.effectVal);bonus=' +Poison';}
    else aiHP=Math.max(0,aiHP-dmg);
    result.textContent=`⚔️ WIN round ${turnNum}! −${dmg} HP${bonus}`; result.style.color='#00ff88';
    spawnFloater(`−${dmg} HP! ⚔️`,'#00ff88');
    logEntry=`<div style="color:#00ff88;font-size:.6rem;">R${turnNum}: ${pCard.emoji}${pCard.power} vs ${aiCard.emoji}${aiCard.power} → WIN −${dmg}HP</div>`;
  } else if(pCard.power<aiCard.power){
    const dmg=Math.floor((aiCard.power-pCard.power)*.5)+6; let heal=0;
    if(pCard.effect==='heal'){heal=pCard.effectVal;playerHP=Math.min(100,playerHP+heal);}
    else if(pCard.effect==='shield'){heal=Math.floor(dmg*.4);playerHP=Math.min(100,playerHP+heal);}
    playerHP=Math.max(0,playerHP-dmg);
    result.textContent=`💀 AI wins round ${turnNum}! −${dmg}${heal?' (+'+heal+')':''}`; result.style.color='#ff00aa';
    spawnFloater(`−${dmg} HP! 💀`,'#ff00aa');
    logEntry=`<div style="color:#ff00aa;font-size:.6rem;">R${turnNum}: LOSE −${dmg}HP</div>`;
  } else {
    result.textContent=`🤝 Draw round ${turnNum}!`; result.style.color='#ff8800';
    spawnFloater('DRAW! 🤝','#ff8800');
    logEntry=`<div style="color:#ff8800;font-size:.6rem;">R${turnNum}: DRAW</div>`;
  }
  log.innerHTML=logEntry+log.innerHTML;
  playerHand.splice(idx,1); aiHand=aiHand.filter(c=>c!==aiCard);
  renderBattleUI();
  await new Promise(r=>setTimeout(r,600));
  if(aiHP<=0||playerHP<=0||playerHand.length===0){
    if(aiHP<=0){
      result.textContent='🏆 VICTORY! AI DEFEATED!'; result.style.color='#ffdd00';
      const xp=200+turnNum*10; await addXP(xp);
      spawnFloater(`+${xp} XP ⚔️`,'#ffdd00');
      addActivity('⚔️',`${playerName} — BATTLE VICTORY!`,xp);
      launchConfetti(); showBadgeToast('Card Battle Champion ⚔️');
    } else {
      result.textContent='💀 Defeated! Try again!'; result.style.color='#ff00aa';
      const xp=30; await addXP(xp); spawnFloater(`+${xp} XP`,'#666'); addActivity('⚔️',`${playerName} — Battle ended`,xp);
    }
    document.getElementById('battle-btn').textContent='🔄 REMATCH'; battleActive=false;
  } else { battleActive=true; }
}

/* ══════════════════════════════════════════════════════
   🧩 PUZZLE
══════════════════════════════════════════════════════ */
const PUZZLE_SETS=[
  ['🎓','📚','✏️','🔬','🧬','⚡','🏆','💎','🎯','📐','🔭','🌟','🧩','🚀','💡','🎮'],
  ['🌈','🦋','🐉','🦄','🌸','🍀','🌺','🎨','🎭','🎪','🌊','⛰️','🌙','☀️','🌿','🏔️'],
  ['🤖','👾','🎲','🃏','🎰','🎸','🥁','🎺','🎻','🎤','🎵','🎶','🎼','🎹','🎬','📡'],
  ['⚽','🏀','🏈','⚾','🎾','🏐','🏉','🎱','🏓','🏸','🥊','🥋','🎿','⛷️','🏊','🚴'],
];
let puzzleTarget=[],puzzleGrid=[],puzzleMoves=0,puzzleDragIdx=null,puzzleComplete=false;
function initPuzzle(){
  puzzleMoves=0;puzzleDragIdx=null;puzzleComplete=false;
  document.getElementById('puzzle-moves').textContent='0';
  document.getElementById('pz-progress').style.width='0%';
  document.getElementById('pz-correct-count').textContent='0';
  const set=PUZZLE_SETS[Math.floor(Math.random()*PUZZLE_SETS.length)];
  puzzleTarget=[...set].slice(0,16);
  const prev=document.getElementById('pz-preview-grid'); prev.innerHTML='';
  puzzleTarget.forEach(e=>{const d=document.createElement('div');d.className='pz-ref-piece';d.textContent=e;prev.appendChild(d);});
  puzzleGrid=[...puzzleTarget].sort(()=>Math.random()-.5);
  renderPuzzle();
}
function renderPuzzle(){
  const board=document.getElementById('puzzle-board'); board.innerHTML=''; let correct=0;
  puzzleGrid.forEach((emoji,i)=>{
    const ok=emoji===puzzleTarget[i]; if(ok)correct++;
    const el=document.createElement('div'); el.className='pz-piece'+(ok?' pz-correct':'');
    el.draggable=!ok; el.dataset.idx=i;
    el.innerHTML=`${emoji}<span class="piece-num">${i+1}</span>`;
    el.addEventListener('dragstart',e=>{if(ok)return;puzzleDragIdx=i;el.classList.add('pz-dragging');e.dataTransfer.effectAllowed='move';});
    el.addEventListener('dragend',()=>el.classList.remove('pz-dragging'));
    el.addEventListener('dragover',e=>{e.preventDefault();if(!ok)el.classList.add('pz-drag-over');});
    el.addEventListener('dragleave',()=>el.classList.remove('pz-drag-over'));
    el.addEventListener('drop',e=>{e.preventDefault();el.classList.remove('pz-drag-over');if(puzzleDragIdx===null||puzzleDragIdx===i)return;[puzzleGrid[puzzleDragIdx],puzzleGrid[i]]=[puzzleGrid[i],puzzleGrid[puzzleDragIdx]];puzzleMoves++;document.getElementById('puzzle-moves').textContent=puzzleMoves;puzzleDragIdx=null;renderPuzzle();});
    el.addEventListener('click',()=>{if(ok)return;if(puzzleDragIdx===null){puzzleDragIdx=i;el.style.outline='3px solid #ff8800';}else{if(puzzleDragIdx!==i){[puzzleGrid[puzzleDragIdx],puzzleGrid[i]]=[puzzleGrid[i],puzzleGrid[puzzleDragIdx]];puzzleMoves++;document.getElementById('puzzle-moves').textContent=puzzleMoves;}puzzleDragIdx=null;renderPuzzle();}});
    board.appendChild(el);
  });
  const pct=Math.round(correct/16*100);
  document.getElementById('pz-progress').style.width=pct+'%';
  document.getElementById('pz-correct-count').textContent=correct;
  if(correct===16&&!puzzleComplete){
    puzzleComplete=true;
    setTimeout(async()=>{
      const xp=Math.max(20,60-Math.floor(puzzleMoves/3));
      await addXP(xp); spawnFloater(`+${xp} XP 🧩`,'#aa44ff');
      addActivity('🧩',`${playerName} — Puzzle solved! 🎉`,xp);
      showBadgeToast('Puzzle Master 🧩'); launchConfetti();
    },350);
  }
}

/* ══════════════════════════════════════════════════════
   🃏 MEMORY
══════════════════════════════════════════════════════ */
const MEM_EMOJIS=['🎯','📚','🔥','⭐','🏆','🎮','⚡','💎'];
let memCards=[],memFlipped=[],memMatched=0,memMoves=0,memTimerVal=0,memTimerInt=null,memStarted=false;
function initMemory(){
  clearInterval(memTimerInt);memCards=[];memFlipped=[];memMatched=0;memMoves=0;memTimerVal=0;memStarted=false;
  ['mem-moves','mem-pairs','mem-timer'].forEach((id,i)=>document.getElementById(id).textContent=['0','0/8','0s'][i]);
  const pairs=[...MEM_EMOJIS,...MEM_EMOJIS].sort(()=>Math.random()-.5);
  const grid=document.getElementById('memory-grid'); grid.innerHTML='';
  pairs.forEach((emoji,i)=>{
    const card=document.createElement('div');card.className='mem-card';card.dataset.emoji=emoji;card.dataset.idx=i;
    card.innerHTML=`<div class="mem-face">?</div><div class="mem-back">${emoji}</div>`;
    card.addEventListener('click',()=>flipMemCard(card));grid.appendChild(card);memCards.push(card);
  });
}
function flipMemCard(card){
  if(card.classList.contains('flipped')||card.classList.contains('matched')||memFlipped.length>=2)return;
  if(!memStarted){memStarted=true;memTimerInt=setInterval(()=>{memTimerVal++;document.getElementById('mem-timer').textContent=memTimerVal+'s';},1000);}
  card.classList.add('flipped');memFlipped.push(card);
  if(memFlipped.length===2){
    memMoves++;document.getElementById('mem-moves').textContent=memMoves;
    if(memFlipped[0].dataset.emoji===memFlipped[1].dataset.emoji){
      memFlipped[0].classList.add('matched');memFlipped[1].classList.add('matched');
      memMatched++;document.getElementById('mem-pairs').textContent=memMatched+'/8';memFlipped=[];
      if(memMatched===8){clearInterval(memTimerInt);setTimeout(async()=>{const xp=Math.max(10,30-Math.floor(memMoves/3));addActivity('🃏',`Memory: ${memMoves} moves!`,xp);spawnFloater(`+${xp} XP 🃏`,'#aa44ff');launchConfetti();await addXP(xp);},400);}
    } else {setTimeout(()=>{memFlipped[0].classList.remove('flipped');memFlipped[1].classList.remove('flipped');memFlipped=[];},950);}
  }
}

/* ══════════════════════════════════════════════════════
   🎰 ROULETTE
══════════════════════════════════════════════════════ */
const ROULETTE_XP=[5,10,25,50,15,30,5,20];
let rouletteSpun=false;
async function spinRoulette(){
  if(rouletteSpun){addActivity('ℹ️','Roulette: 1 spin per session!');return;}
  rouletteSpun=true;
  const btn=document.getElementById('spin-btn');btn.disabled=true;btn.textContent='🌀 Spinning…';
  const idx=Math.floor(Math.random()*8), xp=ROULETTE_XP[idx];
  document.getElementById('roulette-wheel').style.transform=`rotate(${360*7+idx*45}deg)`;
  document.getElementById('roulette-center').textContent='…';
  setTimeout(async()=>{
    document.getElementById('roulette-center').textContent='+'+xp;
    spawnFloater(`+${xp} XP 🎰`,'#ffdd00');addActivity('🎰','Roulette spin!',xp);
    await addXP(xp);if(xp>=25)launchConfetti();
    btn.textContent='✅ Used!';
  },3600);
}

/* ══════════════════════════════════════════════════════
   STREAK CAL
══════════════════════════════════════════════════════ */
function buildStreakCal(){
  const cal=document.getElementById('streak-cal'); cal.innerHTML='';
  const today=new Date();
  for(let i=27;i>=0;i--){
    const d=new Date(today); d.setDate(today.getDate()-i);
    const cell=document.createElement('div');
    const active=i<state.streak, isToday=i===0;
    cell.className='streak-day'+(active?' active':'')+(isToday?' today':'');
    if(!active){const s=document.createElement('span');s.textContent=d.getDate();cell.appendChild(s);}
    cal.appendChild(cell);
  }
}

/* ══════════════════════════════════════════════════════
   LEADERBOARD / TIMER
══════════════════════════════════════════════════════ */
async function refreshLeaderboard(){
  const list=document.getElementById('leaderboard-list');
  list.style.opacity='.3';await new Promise(r=>setTimeout(r,500));list.style.opacity='1';
  addActivity('📡','Leaderboard refreshed');
}
function updateChallengeTimer(){
  const now=new Date(), midnight=new Date(now); midnight.setHours(24,0,0,0);
  const diff=Math.floor((midnight-now)/1000), h=Math.floor(diff/3600), m=Math.floor(diff%3600/60), s=diff%60;
  const el=document.getElementById('challenge-timer');
  if(el) el.textContent=`Resets in ${h}h ${m}m ${s}s`;
}
setInterval(updateChallengeTimer,1000);

/* ══════════════════════════════════════════════════════
   🎊 CONFETTI
══════════════════════════════════════════════════════ */
let confettiParts=[], confettiRunning=false;
const CONF_COLORS=['#00ff88','#00ddff','#ff8800','#ff00aa','#aa44ff','#ffdd00','#ff4444'];
function launchConfetti(){
  const canvas=document.getElementById('confetti-canvas'), ctx=canvas.getContext('2d');
  canvas.width=window.innerWidth; canvas.height=window.innerHeight; canvas.classList.add('show');
  for(let i=0;i<140;i++) confettiParts.push({x:Math.random()*canvas.width,y:Math.random()*canvas.height-canvas.height,w:5+Math.random()*10,h:9+Math.random()*14,color:CONF_COLORS[Math.floor(Math.random()*CONF_COLORS.length)],vy:3+Math.random()*5,vx:(Math.random()-.5)*4,rot:Math.random()*360,vr:(Math.random()-.5)*8});
  if(!confettiRunning){confettiRunning=true;animateConfetti(ctx,canvas);}
  setTimeout(stopConfetti,4000);
}
function animateConfetti(ctx,canvas){
  if(!confettiRunning)return;
  ctx.clearRect(0,0,canvas.width,canvas.height);
  confettiParts=confettiParts.filter(p=>p.y<canvas.height+20);
  confettiParts.forEach(p=>{p.y+=p.vy;p.x+=p.vx;p.rot+=p.vr;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot*Math.PI/180);ctx.fillStyle=p.color;ctx.shadowColor=p.color;ctx.shadowBlur=6;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();});
  requestAnimationFrame(()=>animateConfetti(ctx,canvas));
}
function stopConfetti(){confettiRunning=false;confettiParts=[];const c=document.getElementById('confetti-canvas');c.getContext('2d').clearRect(0,0,c.width,c.height);c.classList.remove('show');}

/* ══════════════════════════════════════════════════════
   INIT
══════════════════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded',()=>{
  initMemory(); renderChallenges(); buildStreakCal(); updateChallengeTimer(); initPuzzle();
  challengeProgress.c1=Math.min(state.correct,5);
  challengeProgress.c2=Math.min(state.streak,3);
  challengeProgress.c3=Math.min(state.decks,2);
  renderChallenges();
  setTimeout(()=>{const f=document.getElementById('xp-bar-fill');if(f){const w=f.style.width;f.style.width='0';setTimeout(()=>f.style.width=w,200);}},300);
  addActivity('🚀','Welcome to XP Arena 3D ULTIMATE!');
  drawSnake3D();
});
</script>
