    ctx.fillRect(x+3,y+3,size,size);
    // Main
    const bg2=ctx.createLinearGradient(x,y,x+size,y+size);
    bg2.addColorStop(0,`hsla(${hue},100%,${isHead?65:52}%,${alpha})`);
    bg2.addColorStop(1,`hsla(${hue},100%,${isHead?38:28}%,${alpha})`);
    ctx.fillStyle=bg2; ctx.fillRect(x,y,size,size);
    // Top highlight
    const th=ctx.createLinearGradient(x,y,x,y+size*.4);
    th.addColorStop(0,`hsla(${hue},100%,92%,${alpha*.55})`); th.addColorStop(1,'transparent');
    ctx.fillStyle=th; ctx.fillRect(x,y,size,size*.4);
    ctx.fillStyle=`hsla(${hue},80%,82%,${alpha*.22})`; ctx.fillRect(x,y,4,size);
    if(isHead||i%3===0){ctx.strokeStyle=`hsla(${hue},100%,80%,${alpha*.35})`;ctx.lineWidth=.8;ctx.strokeRect(x+3,y+3,size-6,size-6);}
    if(isHead){
      ctx.shadowBlur=0;
      const cx2=x+CELL/2, cy2=y+CELL/2;
      const ex1=cx2-5+dir.x*3, ey1=cy2-3+dir.y*3, ex2b=cx2+2+dir.x*3, ey2b=cy2-3+dir.y*3;
      ctx.fillStyle='#fff'; ctx.shadowColor='#ffff00'; ctx.shadowBlur=14;
      ctx.beginPath(); ctx.arc(ex1,ey1,3.5,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(ex2b,ey2b,3.5,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='#ff6600';
      ctx.beginPath(); ctx.arc(ex1+dir.x,ey1+dir.y,1.8,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(ex2b+dir.x,ey2b+dir.y,1.8,0,Math.PI*2); ctx.fill();
      ctx.fillStyle='rgba(0,255,136,.7)'; ctx.fillRect(cx2-4,cy2+3,8,2);
      ctx.strokeStyle='#00ff88'; ctx.lineWidth=1.5; ctx.shadowColor='#00ff88'; ctx.shadowBlur=8;
      ctx.beginPath(); ctx.moveTo(cx2-3,y); ctx.lineTo(cx2-5,y-8); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cx2+3,y); ctx.lineTo(cx2+5,y-8); ctx.stroke();
      ctx.fillStyle='#ff4444'; ctx.shadowColor='#ff4444'; ctx.shadowBlur=10;
      ctx.beginPath(); ctx.arc(cx2-5,y-8,2.5,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(cx2+5,y-8,2.5,0,Math.PI*2); ctx.fill();
    }
    ctx.shadowBlur=0;
  });
  // Food — 3D Apple
  const fx=food.x*CELL, fy=food.y*CELL, pulse=.8+Math.sin(snakeFrame*.15)*.2;
  ctx.shadowColor='#ff4444'; ctx.shadowBlur=22*pulse;
  const frG=ctx.createRadialGradient(fx+6,fy+6,1,fx+CELL/2,fy+CELL/2,9);
  frG.addColorStop(0,'#ff9999'); frG.addColorStop(.5,'#ff2244'); frG.addColorStop(1,'#990022');
