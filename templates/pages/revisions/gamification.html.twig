  ctx.beginPath(); ctx.moveTo(0,GY-50);
  for(let x=0;x<W+100;x+=40){const h=50+Math.sin((x+runnerBgOffset*.15)*.02)*35+Math.cos((x+runnerBgOffset*.15)*.015)*20;ctx.lineTo(x,GY-50-h);}
  ctx.lineTo(W,GY); ctx.lineTo(0,GY); ctx.closePath(); ctx.fill();
  ctx.fillStyle='rgba(10,30,10,.9)'; ctx.strokeStyle='rgba(0,255,100,.3)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.moveTo(0,GY-30);
  for(let x=0;x<W+100;x+=25){const h=25+Math.sin((x+runnerBgOffset*.3)*.035)*20+Math.cos((x+runnerBgOffset*.3)*.025)*12;ctx.lineTo(x,GY-30-h);}
  ctx.lineTo(W,GY); ctx.lineTo(0,GY); ctx.closePath(); ctx.fill(); ctx.stroke();
