          <div class="roulette-wheel" id="roulette-wheel">
            <div class="roulette-center" id="roulette-center">SPIN</div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:1rem;">
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(244,114,182,.12);color:#f472b6;font-size:.7rem;font-weight:800;">+5</div>
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(99,102,241,.12);color:#818cf8;font-size:.7rem;font-weight:800;">+10</div>
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(251,191,36,.12);color:#fbbf24;font-size:.7rem;font-weight:800;">+25</div>
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(52,211,153,.12);color:#34d399;font-size:.7rem;font-weight:800;">+50</div>
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(167,139,250,.12);color:#a78bfa;font-size:.7rem;font-weight:800;">+15</div>
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(251,146,60,.12);color:#fb923c;font-size:.7rem;font-weight:800;">+30</div>
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(244,114,182,.12);color:#f472b6;font-size:.7rem;font-weight:800;">+5</div>
          <div style="text-align:center;padding:.25rem;border-radius:8px;background:rgba(251,191,36,.12);color:#fbbf24;font-size:.7rem;font-weight:800;">⭐</div>
        </div>
        <button id="spin-btn" onclick="spinRoulette()" class="btn btn-primary w-full justify-center">🎰 Spin!</button>
      </div>
    </div>

    {# Streak Calendar #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-sm">🔥</div>
          Streak Calendar
        </h3>
        <span id="streak-count" class="text-sm font-extrabold text-warning-500">{{ gamification.streak }} days</span>
      </div>
      <div class="p-5">
        <div class="flex justify-between text-xs text-secondary-400 dark:text-secondary-500 font-medium mb-3">
          <span>Last 28 days</span>
          <span class="text-warning-500">Best: {{ gamification.streak }} 🔥</span>
        </div>
        <div id="streak-cal"></div>
        <div class="flex gap-3 mt-3 text-xs text-secondary-400 dark:text-secondary-500 flex-wrap">
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-orange-100 dark:bg-orange-900/30 rounded inline-block border border-orange-200 dark:border-orange-800"></span>Inactive</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 bg-orange-400 rounded inline-block"></span>Active</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 border-2 border-primary-500 rounded inline-block"></span>Today</span>
        </div>
        <div class="mt-4 bg-warning-50 dark:bg-warning-900/20 rounded-xl p-3 border border-warning-200 dark:border-warning-800">
          <p class="text-xs font-bold text-warning-600 dark:text-warning-400 mb-2">🔥 Streak Milestones</p>
          <div class="flex flex-col gap-1.5">
            <div class="flex justify-between text-xs">
              <span class="text-secondary-500 dark:text-secondary-400">7 days</span>
              <span class="{{ gamification.streak >= 7 ? 'text-success-500 font-bold' : 'text-secondary-400 dark:text-secondary-500' }}">
                {{ gamification.streak >= 7 ? '✅ Done' : '🔒 ' ~ gamification.streak ~ '/7' }}
              </span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="text-secondary-500 dark:text-secondary-400">30 days</span>
              <span class="text-secondary-400 dark:text-secondary-500">🔒 {{ gamification.streak }}/30</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {# Live Activity #}
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-success-100 dark:bg-success-900/30 flex items-center justify-center text-sm">📡</div>
          Live Activity
        </h3>
        <span class="flex items-center gap-1.5 text-xs text-success-500 dark:text-success-400 font-bold">
          <span class="live-dot w-1.5 h-1.5 bg-success-500 dark:bg-success-400 rounded-full inline-block"></span>
          LIVE
        </span>
      </div>
      <div class="p-4">
        <div class="activity-feed flex flex-col gap-2" id="activity-feed">
          <div class="act-item flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-secondary-50 dark:bg-secondary-800 border border-secondary-200 dark:border-secondary-700">
            <span class="text-base">🚀</span>
            <span class="text-sm text-secondary-600 dark:text-secondary-300 flex-1">Session started</span>
            <span class="text-xs text-secondary-400 dark:text-secondary-500">now</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# All Badges #}
  <div class="card overflow-hidden">
    <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
      <h3 class="font-semibold text-secondary-900 dark:text-white flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center text-sm">🏆</div>
        All Badges
      </h3>
      <span class="text-xs text-secondary-400 dark:text-secondary-500 bg-secondary-100 dark:bg-secondary-800 border border-secondary-200 dark:border-secondary-700 px-2.5 py-1 rounded-full font-semibold">
        {{ gamification.badges|length }} / 6 earned
      </span>
    </div>
    <div class="p-5">
      {% set allBadges = [
        {name:'Master Deck',         icon:'🎖',  desc:'Complete 1 deck at 100%'},
        {name:'Streak 7 jours',      icon:'🔥',  desc:'Study 7 days in a row'},
        {name:'100 Bonnes Réponses', icon:'💯',  desc:'Give 100 correct answers'},
        {name:'500 Bonnes Réponses', icon:'🚀',  desc:'Give 500 correct answers'},
        {name:'Niveau 5',            icon:'⭐',  desc:'Reach level 5'},
        {name:'Niveau 10',           icon:'🌟',  desc:'Reach level 10'},
      ] %}
      {% set earnedNames = gamification.badges|map(b => b.name) %}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        {% for badge in allBadges %}
          {% set isEarned = badge.name in earnedNames %}
          <div class="card-lift rounded-2xl border-2 p-4 transition-all
            {{ isEarned
              ? 'bg-warning-50 dark:bg-warning-900/20 border-warning-300 dark:border-warning-700'
              : 'bg-secondary-50 dark:bg-secondary-800/60 border-secondary-200 dark:border-secondary-700 opacity-60' }}">
            <div class="text-3xl mb-2">{{ isEarned ? badge.icon : '🔒' }}</div>
            <div class="text-sm font-bold text-secondary-800 dark:text-secondary-200 mb-1">{{ badge.name }}</div>
            <div class="text-xs text-secondary-400 dark:text-secondary-500 leading-relaxed mb-2">{{ badge.desc }}</div>
            <span class="inline-block text-xs font-bold px-2 py-0.5 rounded-full
              {{ isEarned
                ? 'bg-success-100 dark:bg-success-900/30 text-success-600 dark:text-success-400'
                : 'bg-secondary-100 dark:bg-secondary-700 text-secondary-400 dark:text-secondary-500' }}">
              {{ isEarned ? '✅ Earned' : '🔒 Locked' }}
