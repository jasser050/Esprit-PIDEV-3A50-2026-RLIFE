</div>

{# Hidden data #}
<div id="gami-data"
  data-points="{{ gamification.points }}"
  data-level="{{ gamification.level }}"
  data-streak="{{ gamification.streak }}"
  data-progress="{{ progressPercent }}"
  data-correct="{{ gamification.totalCorrectAnswers }}"
  data-decks="{{ gamification.totalDecksCompleted }}">
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// STATE
const DATA = document.getElementById('gami-data').dataset;
let state = { points:parseInt(DATA.points), level:parseInt(DATA.level), streak:parseInt(DATA.streak), correct:parseInt(DATA.correct), decks:parseInt(DATA.decks) };
let cooldowns = { correct:0, daily:0 };
let challengeProgress = { c1:0, c2:0, c3:0, c4:0 };

// UI UPDATE
function updateUI(d) {
  const oldLevel = state.level;
  if (d.points!==undefined) state.points=d.points;
  if (d.level!==undefined)  state.level=d.level;
  if (d.streak!==undefined) state.streak=d.streak;
  animateCount('xp-display',state.points); animateCount('s-xp',state.points);
  animateCount('s-lvl',state.level); animateCount('s-streak',state.streak);
  document.getElementById('cur-level').textContent=state.level;
  document.getElementById('cur-streak').textContent=state.streak;
  document.getElementById('lv-cur').textContent=state.level;
  document.getElementById('lv-next').textContent=state.level+1;
  document.getElementById('streak-count').textContent=state.streak+' days';
  const pct=state.points%100;
  document.getElementById('xp-bar-fill').style.width=pct+'%';
  document.getElementById('xp-prog-txt').textContent=pct+'% → Lv'+(state.level+1);
  if(state.level>oldLevel) setTimeout(()=>showLevelUp(state.level),600);
  if(d.badges) document.getElementById('cur-badges').textContent=d.badges.length;
}

function animateCount(id,target) {
  const el=document.getElementById(id); if(!el) return;
  const start=parseInt(el.textContent.replace(/\D/g,''))||0, diff=target-start;
  if(!diff){el.textContent=target;return;}
  let step=0; const t=setInterval(()=>{ step++; el.textContent=Math.round(start+diff*(step/20)); if(step>=20){el.textContent=target;clearInterval(t);} },30);
}

// FLOATER
function spawnFloater(text,color='#8b5cf6') {
  const el=document.createElement('div'); el.className='xp-floater'; el.textContent=text;
  el.style.cssText=`left:${35+Math.random()*30}%;top:${25+Math.random()*30}%;color:${color};`;
  document.body.appendChild(el); setTimeout(()=>el.remove(),1500);
}

// ACTIVITY FEED
function addActivity(icon,text,xp) {
  const feed=document.getElementById('activity-feed');
  const item=document.createElement('div');
  item.className='act-item flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-secondary-50 dark:bg-secondary-800 border border-secondary-200 dark:border-secondary-700';
  item.innerHTML=`<span class="text-base flex-shrink-0">${icon}</span><span class="text-sm text-secondary-600 dark:text-secondary-300 flex-1">${text}</span>${xp?`<span class="text-xs font-extrabold text-primary-600 dark:text-primary-400 whitespace-nowrap">+${xp} XP</span>`:''}<span class="text-xs text-secondary-400 dark:text-secondary-500">now</span>`;
  feed.insertBefore(item,feed.firstChild);
  if(feed.children.length>8) feed.removeChild(feed.lastChild);
}

// LEVEL UP / BADGE TOAST
function showLevelUp(level) { document.getElementById('lu-num').textContent=level; document.getElementById('levelup-overlay').classList.add('show'); launchConfetti(); }
function closeLevelUp() { document.getElementById('levelup-overlay').classList.remove('show'); stopConfetti(); }
function showBadgeToast(name) {
  const area=document.getElementById('badge-toast-area'), t=document.createElement('div');
  t.className='badge-toast card flex items-center gap-3 px-4 py-3 max-w-xs border-l-4 border-warning-400';
  t.innerHTML=`<span class="text-2xl">🏅</span><div><div class="text-xs font-bold text-warning-500 uppercase tracking-wide">New Badge!</div><div class="text-sm font-bold text-secondary-900 dark:text-white">${name}</div></div>`;
  area.appendChild(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(40px)';t.style.transition='all .4s';},4000);
  setTimeout(()=>t.remove(),4500);
}

// COOLDOWNS
function setCooldown(k,s){cooldowns[k]=Date.now()+s*1000;}
function checkCooldown(k){return cooldowns[k]?Date.now()<cooldowns[k]:false;}
function updateCooldownUI(){
  const cc=document.getElementById('cd-correct'),cd=document.getElementById('cd-daily');
  if(checkCooldown('correct')){const r=Math.ceil((cooldowns.correct-Date.now())/1000);cc.textContent=r+'s';cc.className='font-bold text-xs text-danger-500';}
  else{cc.textContent='READY';cc.className='font-bold text-xs text-success-500';}
  if(checkCooldown('daily')){cd.textContent='DONE TODAY';cd.className='font-bold text-xs text-warning-500';}
  else{cd.textContent='READY';cd.className='font-bold text-xs text-success-500';}
}
setInterval(updateCooldownUI,500);

// CHALLENGES
const CHALLENGES=[
  {id:'c1',icon:'🎯',name:'Answer Machine',desc:'Get 5 correct answers',target:5,reward:25},
  {id:'c2',icon:'🔥',name:'On Fire',desc:'Maintain 3-day streak',target:3,reward:30},
  {id:'c3',icon:'📚',name:'Deck Destroyer',desc:'Complete 2 decks',target:2,reward:50},
  {id:'c4',icon:'⚡',name:'Speed Demon',desc:'Score 7+ in Speed Quiz',target:7,reward:40},
];
function renderChallenges() {
  const list=document.getElementById('challenge-list'); list.innerHTML='';
  CHALLENGES.forEach(ch=>{
    const prog=challengeProgress[ch.id]||0,done=prog>=ch.target,pct=Math.min(100,Math.round(prog/ch.target*100));
    list.innerHTML+=`<div class="flex items-center gap-3 p-3 rounded-xl border transition-all ${done?'bg-success-50 dark:bg-success-900/20 border-success-200 dark:border-success-800':'bg-secondary-50 dark:bg-secondary-800 border-secondary-200 dark:border-secondary-700'}">
      <span class="text-xl flex-shrink-0">${ch.icon}</span>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-bold ${done?'line-through text-secondary-400 dark:text-secondary-500':'text-secondary-800 dark:text-secondary-200'}">${ch.name}</div>
        <div class="text-xs text-secondary-400 dark:text-secondary-500 mt-0.5">${ch.desc} (${Math.min(prog,ch.target)}/${ch.target})</div>
        <div class="mt-1.5 h-1.5 bg-secondary-200 dark:bg-secondary-700 rounded-full overflow-hidden">
          <div class="ch-prog-fill" style="width:${pct}%;background:#8b5cf6;"></div>
        </div>
      </div>
      ${done?'<span class="text-lg">✅</span>':`<span class="text-xs font-extrabold text-warning-500 whitespace-nowrap">+${ch.reward} XP</span>`}
    </div>`;
  });
}
function progressChallenge(id,amount=1) {
  const ch=CHALLENGES.find(c=>c.id===id);
  if(!ch||(challengeProgress[id]||0)>=ch.target) return;
  challengeProgress[id]=Math.min(ch.target,(challengeProgress[id]||0)+amount);
  if(challengeProgress[id]>=ch.target){addActivity('🏆',`Challenge: ${ch.name}!`,ch.reward);spawnFloater(`CHALLENGE! +${ch.reward} XP`,'#fbbf24');showBadgeToast(`Challenge: ${ch.name}`);launchConfetti();callAPI('/gamification/correct-answer',{});}
  renderChallenges();
}

// API
async function callAPI(url,body={}) {
  try{const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify(body)});if(!r.ok)throw new Error();return await r.json();}catch(e){return null;}
}

// EARN ACTIONS
async function earnCorrectAnswer() {
  if(checkCooldown('correct')) return; setCooldown('correct',3);
  const btn=document.getElementById('btn-correct'); btn.disabled=true;
  const d=await callAPI('/gamification/correct-answer');
  if(d?.success){spawnFloater('+10 XP 🎯','#22c55e');addActivity('🎯','Correct answer!',10);updateUI(d);d.newBadges?.forEach(b=>showBadgeToast(b));}
  else{state.points+=10;spawnFloater('+10 XP 🎯','#22c55e');addActivity('🎯','Correct answer! (demo)',10);updateUI({points:state.points,level:Math.floor(state.points/100)+1});}
  progressChallenge('c1'); state.correct++; document.getElementById('s-correct').textContent=state.correct;
  setTimeout(()=>{btn.disabled=false;},3000);
}
async function earnDeckCompleted() {
  const btn=document.getElementById('btn-deck'); btn.disabled=true;
  const d=await callAPI('/gamification/deck-completed/0');
  if(d?.success){spawnFloater('+50 XP 📚','#8b5cf6');addActivity('📚','Deck completed!',50);updateUI(d);d.newBadges?.forEach(b=>showBadgeToast(b));}
  else{state.points+=50;spawnFloater('+50 XP 📚','#8b5cf6');addActivity('📚','Deck completed! (demo)',50);updateUI({points:state.points,level:Math.floor(state.points/100)+1});}
  state.decks++;document.getElementById('s-decks').textContent=state.decks;progressChallenge('c3');launchConfetti();
  setTimeout(()=>{btn.disabled=false;},3000);
}
async function earnDailyRevision() {
  if(checkCooldown('daily')){addActivity('ℹ️','Daily revision already claimed today!');return;} setCooldown('daily',86400);
  const btn=document.getElementById('btn-daily'); btn.disabled=true;
  const d=await callAPI('/gamification/daily-revision');
  if(d?.success){spawnFloater('+15 XP 📅','#fbbf24');addActivity('📅','Daily revision bonus!',15);updateUI(d);}
  else{state.points+=15;spawnFloater('+15 XP 📅','#fbbf24');addActivity('📅','Daily revision! (demo)',15);updateUI({points:state.points,level:Math.floor(state.points/100)+1});}
  setTimeout(()=>{btn.disabled=false;},2000);
}
async function doStreak10() {
  const btn=document.getElementById('btn-streak'); btn.disabled=true;
  for(let i=0;i<10;i++){const d=await callAPI('/gamification/correct-answer');if(d?.success)updateUI(d);else{state.points+=10;updateUI({points:state.points,level:Math.floor(state.points/100)+1});}await new Promise(r=>setTimeout(r,100));}
  spawnFloater('+100 XP 🔥','#fb923c');addActivity('🔥','10-answer streak bonus!',100);launchConfetti();
  btn.disabled=false;
}

// MEMORY GAME
const MEM_EMOJIS=['🎯','📚','🔥','⭐','🏆','🎮','⚡','💎'];
let memCards=[],memFlipped=[],memMatched=0,memMoves=0,memTimerVal=0,memTimerInt=null,memStarted=false;
function initMemory() {
  clearInterval(memTimerInt);memCards=[];memFlipped=[];memMatched=0;memMoves=0;memTimerVal=0;memStarted=false;
  ['mem-moves','mem-pairs','mem-timer'].forEach((id,i)=>document.getElementById(id).textContent=['0','0/8','0s'][i]);
  const pairs=[...MEM_EMOJIS,...MEM_EMOJIS].sort(()=>Math.random()-.5);
  const grid=document.getElementById('memory-grid'); grid.innerHTML='';
  pairs.forEach((emoji,i)=>{
    const card=document.createElement('div'); card.className='mem-card'; card.dataset.emoji=emoji; card.dataset.idx=i;
    card.innerHTML=`<div class="mem-face">?</div><div class="mem-back">${emoji}</div>`;
    card.addEventListener('click',()=>flipMemCard(card)); grid.appendChild(card); memCards.push(card);
  });
}
function flipMemCard(card) {
  if(card.classList.contains('flipped')||card.classList.contains('matched')||memFlipped.length>=2) return;
  if(!memStarted){memStarted=true;memTimerInt=setInterval(()=>{memTimerVal++;document.getElementById('mem-timer').textContent=memTimerVal+'s';},1000);}
  card.classList.add('flipped'); memFlipped.push(card);
  if(memFlipped.length===2){
    memMoves++; document.getElementById('mem-moves').textContent=memMoves;
    if(memFlipped[0].dataset.emoji===memFlipped[1].dataset.emoji){
      memFlipped[0].classList.add('matched');memFlipped[1].classList.add('matched');
      memMatched++;document.getElementById('mem-pairs').textContent=memMatched+'/8';memFlipped=[];
      if(memMatched===8){clearInterval(memTimerInt);setTimeout(async()=>{
        const xp=Math.max(10,30-Math.floor(memMoves/3));addActivity('🃏',`Memory won in ${memMoves} moves!`,xp);spawnFloater(`+${xp} XP 🃏`,'#a78bfa');launchConfetti();
        for(let i=0;i<Math.ceil(xp/10);i++){await callAPI('/gamification/correct-answer');state.points+=10;}updateUI({points:state.points,level:Math.floor(state.points/100)+1});
      },400);}
    } else { setTimeout(()=>{memFlipped[0].classList.remove('flipped');memFlipped[1].classList.remove('flipped');memFlipped=[];},900); }
  }
}

// SPEED QUIZ
const QUIZ_QUESTIONS=[
  {q:'What is the capital of France?',opts:['Berlin','Paris','Madrid','Rome'],ans:1},
  {q:'What is 7 × 8?',opts:['54','56','58','64'],ans:1},
  {q:'Who painted the Mona Lisa?',opts:['Picasso','Rembrandt','da Vinci','Monet'],ans:2},
  {q:'Closest planet to the Sun?',opts:['Venus','Earth','Mercury','Mars'],ans:2},
  {q:'H₂O is the formula for...?',opts:['Hydrogen','Oxygen','Water','Salt'],ans:2},
  {q:'How many continents?',opts:['5','6','7','8'],ans:2},
  {q:'WW2 ended in?',opts:['1943','1944','1945','1946'],ans:2},
  {q:'Speed of light ≈ ?',opts:['300 km/s','300,000 km/s','30,000 km/s','3,000 km/s'],ans:1},
  {q:'Largest ocean?',opts:['Atlantic','Indian','Arctic','Pacific'],ans:3},
  {q:'Sides of a hexagon?',opts:['5','6','7','8'],ans:1},
];
let qzIdx=0,qzScore=0,qzCorrect=0,qzStreak=0,qzTimerInt=null,qzTime=10;
function startQuiz(){qzIdx=0;qzScore=0;qzCorrect=0;qzStreak=0;loadQuizQ();}
function loadQuizQ(){
  if(qzIdx>=QUIZ_QUESTIONS.length){endQuiz();return;}
  clearInterval(qzTimerInt);qzTime=10;
  const q=QUIZ_QUESTIONS[qzIdx];
  document.getElementById('qz-question').textContent=q.q;
  document.getElementById('qz-num').textContent=qzIdx+1;
  document.getElementById('qz-time').textContent=qzTime;
  document.getElementById('qz-timer-bar').style.width='100%';
  const opts=document.getElementById('qz-opts');opts.innerHTML='';
  q.opts.forEach((opt,i)=>{
    const btn=document.createElement('button');
    btn.className='quiz-opt p-2.5 rounded-xl bg-secondary-50 dark:bg-secondary-800 border-2 border-secondary-200 dark:border-secondary-700 text-sm font-semibold text-secondary-700 dark:text-secondary-300 cursor-pointer';
    btn.textContent=opt;btn.onclick=()=>answerQuiz(i,q.ans);opts.appendChild(btn);
  });
  qzTimerInt=setInterval(()=>{qzTime--;document.getElementById('qz-time').textContent=qzTime;document.getElementById('qz-timer-bar').style.width=(qzTime/10*100)+'%';if(qzTime<=0){clearInterval(qzTimerInt);timeoutQuiz(q.ans);}},1000);
}
function answerQuiz(chosen,correct){
  clearInterval(qzTimerInt);
  document.querySelectorAll('.quiz-opt').forEach((o,i)=>{o.disabled=true;if(i===correct)o.classList.add('correct');else if(i===chosen&&chosen!==correct)o.classList.add('wrong');});
  if(chosen===correct){qzCorrect++;qzStreak++;const pts=10+qzStreak*2+qzTime;qzScore+=pts;['qz-correct','qz-streak','qz-score-top'].forEach((id,i)=>document.getElementById(id).textContent=[qzCorrect,qzStreak,qzScore+' pts'][i]);spawnFloater(`+${pts}pts ⚡`,'#8b5cf6');progressChallenge('c4');}
  else{qzStreak=0;document.getElementById('qz-streak').textContent=0;}
  qzIdx++;setTimeout(loadQuizQ,1000);
}
function timeoutQuiz(correct){document.querySelectorAll('.quiz-opt').forEach((o,i)=>{o.disabled=true;if(i===correct)o.classList.add('correct');});qzStreak=0;qzIdx++;setTimeout(loadQuizQ,1200);}
async function endQuiz(){
  const xpEarned=Math.ceil(qzScore/10);
  document.getElementById('qz-question').innerHTML=`<div class="text-center"><div class="text-2xl mb-1">🏁</div><div class="font-bold text-primary-600 dark:text-primary-400">${qzCorrect}/10 correct</div><div class="text-xs text-secondary-400 dark:text-secondary-500 mt-1">${qzScore} pts → ~${xpEarned} XP</div></div>`;
  document.getElementById('qz-opts').innerHTML=`<button onclick="startQuiz()" class="col-span-2 btn btn-primary justify-center w-full py-2.5">🔄 Play Again</button>`;
  document.getElementById('qz-timer-bar').style.width='0%';
  addActivity('⚡',`Speed Quiz: ${qzCorrect}/10 correct`,xpEarned);spawnFloater(`+${xpEarned} XP ⚡`,'#8b5cf6');
  for(let i=0;i<Math.min(xpEarned,10);i++){await callAPI('/gamification/correct-answer');state.points+=10;await new Promise(r=>setTimeout(r,80));}
  updateUI({points:state.points,level:Math.floor(state.points/100)+1});if(qzCorrect>=7)launchConfetti();
}

// ROULETTE
const ROULETTE_XP=[5,10,25,50,15,30,5,10];
let rouletteSpun=false;
async function spinRoulette(){
  if(rouletteSpun){addActivity('ℹ️','Roulette: 1 spin per session!');return;} rouletteSpun=true;
  const btn=document.getElementById('spin-btn');btn.disabled=true;btn.textContent='🌀 Spinning…';
  const sectorIdx=Math.floor(Math.random()*8),xp=ROULETTE_XP[sectorIdx];
  document.getElementById('roulette-wheel').style.transform=`rotate(${360*5+(sectorIdx*45)}deg)`;
  document.getElementById('roulette-center').textContent='…';
  setTimeout(async()=>{
    document.getElementById('roulette-center').textContent='+'+xp;
    spawnFloater(`+${xp} XP 🎰`,'#fbbf24');addActivity('🎰','Roulette win!',xp);
    for(let i=0;i<Math.ceil(xp/10);i++){await callAPI('/gamification/correct-answer');state.points+=10;await new Promise(r=>setTimeout(r,100));}
    updateUI({points:state.points,level:Math.floor(state.points/100)+1});if(xp>=25)launchConfetti();
    btn.textContent='✅ Used today!';
  },3200);
}

// STREAK CALENDAR
function buildStreakCal(){
  const cal=document.getElementById('streak-cal');cal.innerHTML='';
  const today=new Date();
  for(let i=27;i>=0;i--){
    const d=new Date(today);d.setDate(today.getDate()-i);
    const cell=document.createElement('div');
    const isActive = i < state.streak;
    const isToday  = i === 0;
    cell.className='streak-day'+(isActive?' active':'')+(isToday?' today':'');
    // Put day number in a span so we can hide it easily when active
    if(!isActive){
      const span=document.createElement('span');
      span.textContent=d.getDate();
      cell.appendChild(span);
    }
    cal.appendChild(cell);
  }
}

// LEADERBOARD REFRESH
async function refreshLeaderboard(){
  const list=document.getElementById('leaderboard-list');
  list.style.opacity='.4';await new Promise(r=>setTimeout(r,400));list.style.opacity='1';
  addActivity('📡','Leaderboard refreshed');
}

// CHALLENGE TIMER
function updateChallengeTimer(){
  const now=new Date(),midnight=new Date(now);midnight.setHours(24,0,0,0);
  const diff=Math.floor((midnight-now)/1000),h=Math.floor(diff/3600),m=Math.floor(diff%3600/60),s=diff%60;
  const el=document.getElementById('challenge-timer');if(el)el.textContent=`Resets in ${h}h ${m}m ${s}s`;
}
setInterval(updateChallengeTimer,1000);

// CONFETTI
let confettiParts=[],confettiRunning=false;
const COLORS=['#8b5cf6','#22c55e','#f59e0b','#ec4899','#3b82f6','#fb923c'];
function launchConfetti(){
  const canvas=document.getElementById('confetti-canvas'),ctx=canvas.getContext('2d');
  canvas.width=window.innerWidth;canvas.height=window.innerHeight;canvas.classList.add('show');
  for(let i=0;i<100;i++)confettiParts.push({x:Math.random()*canvas.width,y:Math.random()*canvas.height-canvas.height,w:6+Math.random()*8,h:10+Math.random()*12,color:COLORS[Math.floor(Math.random()*COLORS.length)],vy:3+Math.random()*5,vx:(Math.random()-.5)*4,rot:Math.random()*360,vr:(Math.random()-.5)*8});
  if(!confettiRunning){confettiRunning=true;animateConfetti(ctx,canvas);}
  setTimeout(stopConfetti,3500);
}
function animateConfetti(ctx,canvas){
  if(!confettiRunning)return;ctx.clearRect(0,0,canvas.width,canvas.height);
  confettiParts=confettiParts.filter(p=>p.y<canvas.height+20);
  confettiParts.forEach(p=>{p.y+=p.vy;p.x+=p.vx;p.rot+=p.vr;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot*Math.PI/180);ctx.fillStyle=p.color;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();});
  requestAnimationFrame(()=>animateConfetti(ctx,canvas));
}
function stopConfetti(){
  confettiRunning=false;confettiParts=[];
  const c=document.getElementById('confetti-canvas');c.getContext('2d').clearRect(0,0,c.width,c.height);c.classList.remove('show');
}

// INIT
document.addEventListener('DOMContentLoaded',()=>{
  initMemory();renderChallenges();buildStreakCal();updateChallengeTimer();
  challengeProgress.c1=Math.min(state.correct,5);
  challengeProgress.c2=Math.min(state.streak,3);
  challengeProgress.c3=Math.min(state.decks,2);
  renderChallenges();
  setTimeout(()=>{const f=document.getElementById('xp-bar-fill');if(f){const w=f.style.width;f.style.width='0';setTimeout(()=>f.style.width=w,200);}},300);
  addActivity('🚀','Welcome to XP Arena!');
});
</script>
