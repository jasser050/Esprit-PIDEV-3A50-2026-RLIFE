    ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2); ctx.fill();
  });
  ctx.globalAlpha=1;
  // Snake
  snake.forEach((s,i)=>{
    const x=s.x*CELL, y=s.y*CELL, isHead=i===0;
    const alpha=isHead?1:Math.max(.22,1-i*.04);
    const hue=isHead?155:160+i*2, size=isHead?CELL-1:CELL-2;
    ctx.shadowColor='rgba(0,255,136,.55)'; ctx.shadowBlur=isHead?22:10;
    // Shadow
