        <div style="margin-top:1rem;padding:.7rem;background:rgba(255,107,0,0.07);border-radius:10px;border:1px solid rgba(255,107,0,0.2);">
          <div style="font-size:.75rem;font-weight:700;color:var(--neon-orange);margin-bottom:.3rem;">🔥 Streak Milestones</div>
          <div style="display:flex;flex-direction:column;gap:.2rem;">
            <div style="display:flex;justify-content:space-between;font-size:.7rem;">
              <span style="color:rgba(255,255,255,0.6);">7 days</span>
              <span style="color:{{ gamification.streak >= 7 ? '#39ff14' : 'var(--text-dim)' }};">{{ gamification.streak >= 7 ? '✅ Done' : '🔒 ' ~ gamification.streak ~ '/7' }}</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:.7rem;">
              <span style="color:rgba(255,255,255,0.6);">30 days</span>
              <span style="color:var(--text-dim);">🔒 {{ gamification.streak }}/30</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {# LIVE ACTIVITY FEED #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">📡 LIVE ACTIVITY</span>
        <span style="display:flex;align-items:center;gap:.4rem;font-size:.65rem;color:var(--neon-green);">
          <span style="width:6px;height:6px;background:var(--neon-green);border-radius:50%;animation:pulse 1s infinite;display:inline-block;"></span>
          LIVE
        </span>
      </div>
      <div class="panel-body" style="padding:.75rem;">
        <div class="activity-feed" id="activity-feed">
          <div class="act-item">
            <span class="act-icon">🚀</span>
            <span class="act-text">Session started</span>
            <span class="act-time">now</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ── ROW 4: ALL BADGES ── #}
  <div class="panel" style="margin-bottom:1.25rem;">
    <div class="panel-header">
      <span class="panel-title">🏆 ALL BADGES</span>
      <span style="font-size:.7rem;color:var(--text-dim);">{{ gamification.badges|length }} / 6 earned</span>
    </div>
    <div class="panel-body">
      {% set allBadges = [
        {name:'Master Deck',          icon:'🎖',  desc:'Complete 1 deck at 100%'},
        {name:'Streak 7 jours',       icon:'🔥',  desc:'Study 7 days in a row'},
        {name:'100 Bonnes Réponses',  icon:'💯',  desc:'Give 100 correct answers'},
        {name:'500 Bonnes Réponses',  icon:'🚀',  desc:'Give 500 correct answers'},
        {name:'Niveau 5',             icon:'⭐',  desc:'Reach level 5'},
        {name:'Niveau 10',            icon:'🌟',  desc:'Reach level 10'},
      ] %}
      {% set earnedNames = gamification.badges|map(b => b.name) %}
      <div class="all-badges-grid" id="badges-grid">
        {% for badge in allBadges %}
          {% set isEarned = badge.name in earnedNames %}
          <div class="badge-full-card {{ isEarned ? 'earned-b' : 'locked-b' }}">
            <div class="bf-icon">{{ isEarned ? badge.icon : '🔒' }}</div>
            <div class="bf-name">{{ badge.name }}</div>
            <div class="bf-desc">{{ badge.desc }}</div>
            <div class="bf-status {{ isEarned ? 'e' : 'l' }}">
              {{ isEarned ? '✅ EARNED' : '🔒 LOCKED' }}
