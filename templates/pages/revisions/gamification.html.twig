  ctx.fillStyle='#44dd22'; ctx.beginPath(); ctx.ellipse(fx+CELL/2+5,fy+CELL/2-11,5,3,.6,0,Math.PI*2); ctx.fill();
  ctx.shadowBlur=0;
  // HUD
  if(playerName){ctx.fillStyle='rgba(0,255,136,.7)';ctx.font='bold 12px "Courier New"';ctx.textAlign='left';ctx.shadowColor='#00ff88';ctx.shadowBlur=8;ctx.fillText('🤖 '+playerName.toUpperCase(),8,16);ctx.shadowBlur=0;}
}
document.addEventListener('keydown',e=>{
  if(!snakeRunning) return;
  const map={ArrowUp:{x:0,y:-1},ArrowDown:{x:0,y:1},ArrowLeft:{x:-1,y:0},ArrowRight:{x:1,y:0},w:{x:0,y:-1},s:{x:0,y:1},a:{x:-1,y:0},d:{x:1,y:0}};
  const nd=map[e.key]; if(nd&&!(nd.x===-dir.x&&nd.y===-dir.y)){dir=nd;e.preventDefault();}
});

/* ══════════════════════════════════════════════════════
   🏃 RUNNER 3D — ALIEN PLANET
