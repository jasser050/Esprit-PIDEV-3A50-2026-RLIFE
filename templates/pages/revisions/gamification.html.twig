{% extends 'base.html.twig' %}
{% block title %}⚡ XP Arena — Gamification{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --font-game: 'Orbitron', sans-serif;
  --font-ui:   'Inter', sans-serif;
  --em:   #00ff88;
  --em2:  #00ddff;
  --amb:  #ff8800;
  --ros:  #ff00aa;
  --pur:  #aa44ff;
}
*, *::before, *::after { box-sizing: border-box; }

body, .arena-wrap, button, input, span, div, p, h1, h2, h3, h4,
#game-modal, #levelup-overlay, #player-name-screen, .badge-toast, .xp-floater {
  font-family: var(--font-ui) !important;
}

.game-title, #game-modal h2, .game-icon-label, .game-hud-label {
  font-family: var(--font-game) !important;
}

/* === XP BAR === */
.xp-bar-fill {
  transition: width 1.4s cubic-bezier(.4,0,.2,1);
  background: linear-gradient(90deg, #00ff88, #00ddff, #ff8800);
  background-size: 200% 100%;
  animation: barShimmer 3s linear infinite;
}
@keyframes barShimmer { 0%{background-position:0%} 100%{background-position:200%} }
.card-lift { transition: transform .18s, box-shadow .18s; }
.card-lift:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,255,136,.12); }

/* === GAME MODAL === */
#game-modal {
  display:none; position:fixed; inset:0; z-index:9995;
  background: rgba(2,4,20,.97);
  backdrop-filter: blur(24px);
  align-items: center; justify-content: center; padding: 12px;
}
#game-modal.show { display:flex; }

.game-modal-box {
  background: linear-gradient(135deg, #050d1a, #080818, #050d1a);
  border: 1.5px solid rgba(0,255,136,.22);
  border-radius: 24px;
  padding: 1.5rem 1.8rem;
  width: min(100vw - 24px, 1160px);
  max-height: calc(100vh - 24px);
  overflow-y: auto;
  box-shadow: 0 0 0 1px rgba(0,255,136,.05), 0 60px 100px rgba(0,0,0,.9), 0 0 80px rgba(0,255,136,.05);
  animation: modalIn .28s cubic-bezier(.36,.07,.19,.97);
  scrollbar-width: thin; scrollbar-color: #00ff88 transparent;
}
@keyframes modalIn { from{transform:scale(.9) translateY(20px);opacity:0} to{transform:scale(1) translateY(0);opacity:1} }

.gtab {
  cursor:pointer; padding:.42rem 1rem; border-radius:10px;
  font-size:.72rem; font-weight:700; color:#475569;
  transition:all .18s; border:1.5px solid transparent; letter-spacing:.04em;
  font-family: var(--font-game) !important;
}
.gtab.active { color:#00ff88; border-color:#00ff88; background:rgba(0,255,136,.1); box-shadow:0 0 16px rgba(0,255,136,.2); }
.gtab:hover:not(.active) { color:#94a3b8; border-color:rgba(0,255,136,.2); }

.score-bar {
  display:flex; align-items:center; justify-content:space-between;
  background:rgba(0,255,136,.04); border:1px solid rgba(0,255,136,.12);
  border-radius:14px; padding:.55rem 1.2rem; margin-bottom:1rem;
}

/* === PLAYER NAME SCREEN === */
#player-name-screen {
  display:none; flex-direction:column; align-items:center;
  justify-content:center; gap:1.4rem; padding:2.5rem 1rem; text-align:center;
}
#player-name-screen.show { display:flex; }

.name-input {
  width:100%; max-width:360px; padding:.82rem 1.2rem;
  background:rgba(0,255,136,.06); border:2px solid rgba(0,255,136,.3);
  border-radius:14px; color:#fff; font-size:1.1rem; font-weight:700;
  outline:none; transition:border-color .2s, box-shadow .2s; text-align:center;
  font-family: var(--font-game) !important;
}
.name-input:focus { border-color:#00ff88; box-shadow:0 0 0 4px rgba(0,255,136,.15); }
.name-input::placeholder { color:#334155; font-weight:400; font-family: var(--font-ui) !important; }

.player-name-badge {
  display:inline-flex; align-items:center; gap:.4rem;
  background:rgba(0,255,136,.1); border:1px solid rgba(0,255,136,.3);
  border-radius:99px; padding:.22rem .72rem; font-size:.72rem; font-weight:700; color:#00ff88;
  font-family: var(--font-game) !important;
}

/* === CANVASES === */
#snake-canvas  { border-radius:16px; display:block; margin:0 auto; max-width:100%; image-rendering:pixelated; }
#runner-canvas { border-radius:16px; display:block; margin:0 auto; max-width:100%; }

/* === ARCHER === */
#archer-arena {
  position:relative; width:100%; height:380px;
  background:#020815;
  border:1px solid rgba(0,255,136,.18); border-radius:16px; overflow:hidden; cursor:crosshair;
}
.archer-target {
  position:absolute; border-radius:50%; cursor:crosshair;
  transition: opacity .3s;
}

/* === CARD BATTLE — UPGRADED === */
.battle-arena { display:grid; grid-template-columns:1fr 132px 1fr; gap:1.3rem; align-items:start; }
.battle-hand  { display:flex; gap:.5rem; flex-wrap:wrap; justify-content:center; min-height:190px; align-items:flex-end; }

.bcard {
  width:96px; height:148px; border-radius:16px; cursor:pointer;
  transform-style:preserve-3d; transition:transform .32s, box-shadow .22s;
  border:1.5px solid rgba(255,255,255,.1);
  background:linear-gradient(160deg,#0e1830,#080a1a);
  display:flex; flex-direction:column; align-items:center; justify-content:space-between;
  padding:.5rem .32rem;
  box-shadow:0 8px 28px rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.07);
  position:relative; overflow:hidden;
}
.bcard::before { content:''; position:absolute; inset:0; opacity:0; background:linear-gradient(135deg,rgba(255,255,255,.08),transparent); transition:opacity .2s; }
.bcard:hover { transform:translateY(-20px) rotateY(10deg) scale(1.08); }
.bcard:hover::before { opacity:1; }
.bcard.played-card { animation:cardFly .6s ease forwards; }
@keyframes cardFly { 0%{transform:translateY(0) scale(1);opacity:1} 40%{transform:translateY(-100px) scale(1.4) rotateY(20deg)} 100%{transform:translateY(0) scale(.3);opacity:0;pointer-events:none} }
.bcard-icon  { font-size:2.2rem; filter:drop-shadow(0 0 8px currentColor); }
.bcard-name  { font-size:.5rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; text-align:center; font-family:var(--font-game)!important; }
.bcard-power { font-size:1.2rem; font-weight:900; font-family:var(--font-game)!important; }
.bcard-type  { font-size:.44rem; font-weight:600; text-transform:uppercase; letter-spacing:.1em; color:#475569; }
.bcard-bar   { width:100%; height:3px; border-radius:99px; }

.hp-track { height:10px; background:#0d1520; border-radius:99px; border:1px solid rgba(255,255,255,.06); overflow:hidden; margin-bottom:.5rem; }
.hp-fill  { height:100%; border-radius:99px; transition:width .6s; }
.hp-fill.player-hp { background:linear-gradient(90deg,#00ff88,#00ddaa); }
.hp-fill.ai-hp     { background:linear-gradient(90deg,#ff00aa,#ff8800); }
.battle-mid { display:flex; flex-direction:column; align-items:center; gap:.55rem; text-align:center; }
.vs-badge   { font-size:2rem; font-weight:900; color:#1e293b; letter-spacing:.08em; font-family:var(--font-game)!important; }
#battle-result { font-size:.9rem; font-weight:700; min-height:1.4rem; }
#battle-log  { font-size:.6rem; color:#475569; max-height:100px; overflow-y:auto; text-align:left; padding:.45rem; background:rgba(255,255,255,.02); border-radius:8px; width:120px; line-height:1.65; }
.ai-card-back { background:linear-gradient(160deg,#1f0520,#0a0018) !important; border-color:rgba(255,0,170,.3) !important; }

/* === PUZZLE === */
#puzzle-board { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; padding:10px; background:rgba(0,255,136,.02); border:1px solid rgba(0,255,136,.12); border-radius:16px; }
.pz-piece { aspect-ratio:1; border-radius:10px; cursor:grab; font-size:1.6rem; display:flex; align-items:center; justify-content:center; border:2px solid rgba(255,255,255,.07); background:linear-gradient(135deg,rgba(0,255,136,.08),rgba(0,200,255,.05)); transition:all .2s; user-select:none; position:relative; box-shadow:0 4px 12px rgba(0,0,0,.4); }
.pz-piece:hover    { border-color:#00ff88; transform:scale(1.1) translateY(-3px); box-shadow:0 0 20px rgba(0,255,136,.4); }
.pz-piece.pz-correct { border-color:#00ff88 !important; background:rgba(0,255,136,.15) !important; cursor:default; box-shadow:0 0 16px rgba(0,255,136,.35); }
.pz-piece.pz-drag-over { border-color:#ff8800 !important; background:rgba(255,136,0,.1) !important; transform:scale(1.1); }
.pz-piece.pz-dragging { opacity:.3; transform:scale(.92); cursor:grabbing; }
.pz-piece .piece-num { position:absolute; top:2px; right:4px; font-size:.42rem; color:#334155; }
.puzzle-layout { display:grid; grid-template-columns:200px 1fr; gap:1.4rem; align-items:start; }
.pz-reference { background:rgba(255,255,255,.02); border:1px solid rgba(255,255,255,.07); border-radius:14px; padding:.85rem; }
#pz-preview-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:3px; margin-top:.5rem; }
.pz-ref-piece { aspect-ratio:1; border-radius:5px; font-size:.82rem; display:flex; align-items:center; justify-content:center; background:rgba(0,255,136,.05); border:1px solid rgba(0,255,136,.1); }
.pz-progress-bar  { height:6px; background:#0d1520; border-radius:99px; margin-top:.7rem; overflow:hidden; }
.pz-progress-fill { height:100%; background:linear-gradient(90deg,#00ff88,#00ddff); border-radius:99px; transition:width .45s; }

/* === XP FLOATER === */
.xp-floater {
  position:fixed; font-size:1.1rem; font-weight:900; pointer-events:none;
  z-index:9999; animation:floatUp 2.2s ease-out forwards; letter-spacing:.04em;
  text-shadow:0 0 12px currentColor; font-family:var(--font-game)!important;
}
@keyframes floatUp { 0%{opacity:1;transform:translateY(0) scale(1)} 40%{opacity:1;transform:translateY(-60px) scale(1.3)} 100%{opacity:0;transform:translateY(-140px) scale(0.8)} }

/* === LEVEL UP === */
#levelup-overlay { display:none; position:fixed; inset:0; z-index:9998; background:rgba(0,0,0,.88); align-items:center; justify-content:center; backdrop-filter:blur(12px); }
#levelup-overlay.show { display:flex; }
.levelup-box { animation:bounceIn .5s cubic-bezier(.36,.07,.19,.97); }
@keyframes bounceIn { 0%{transform:scale(.4) rotate(-10deg);opacity:0} 60%{transform:scale(1.12)} 100%{transform:scale(1);opacity:1} }

/* === BADGE TOAST === */
#badge-toast-area { position:fixed; top:1.5rem; right:1.5rem; z-index:9990; display:flex; flex-direction:column; gap:.5rem; }
.badge-toast { animation:toastIn .4s ease forwards; }
@keyframes toastIn { from{transform:translateX(90px) scale(.9);opacity:0} to{transform:translateX(0) scale(1);opacity:1} }

/* === MEMORY === */
#memory-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
.mem-card { width:100%; padding-top:100%; border-radius:10px; cursor:pointer; position:relative; transform-style:preserve-3d; transition:transform .4s; }
.mem-card.flipped,.mem-card.matched { transform:rotateY(180deg); }
.mem-card.matched .mem-back { background:#021c0a !important; border-color:#00ff88 !important; }
.mem-face,.mem-back { position:absolute; inset:0; border-radius:10px; display:flex; align-items:center; justify-content:center; backface-visibility:hidden; }
.mem-face { background:#0d1a2a; border:2px solid #1e3040; color:#334155; font-size:.85rem; font-weight:700; }
.mem-back { background:#021c0a; border:2px solid #00ff88; font-size:1.3rem; transform:rotateY(180deg); }

/* === ROULETTE === */
.roulette-wheel {
  width:165px; height:165px; margin:0 auto; border-radius:50%;
  background:conic-gradient(#00ff88 0deg 45deg,#ff8800 45deg 90deg,#ff00aa 90deg 135deg,#00ddff 135deg 180deg,#aa44ff 180deg 225deg,#ff4444 225deg 270deg,#ffdd00 270deg 315deg,#00aa66 315deg 360deg);
  border:5px solid #0a1020; box-shadow:0 0 50px rgba(0,255,136,.4), 0 0 100px rgba(0,255,136,.15), inset 0 0 20px rgba(0,0,0,.5);
  transition:transform 3.4s cubic-bezier(.17,.67,.12,.99); position:relative;
}
.roulette-center { position:absolute; inset:22%; border-radius:50%; background:#080f1a; border:3px solid #1a2a3a; display:flex; align-items:center; justify-content:center; font-size:.72rem; font-weight:900; color:#00ff88; font-family:var(--font-game)!important; }

/* === STREAK === */
#streak-cal { display:grid !important; grid-template-columns:repeat(7,1fr) !important; gap:4px; }
.streak-day { height:24px; border-radius:5px; background:#0d1520; border:1px solid #1a2a3a; display:flex; align-items:center; justify-content:center; font-size:.5rem; color:#334155; position:relative; overflow:hidden; }
.streak-day.active { background:rgba(255,136,0,.12); border-color:#ff8800; }
.streak-day.active::after { content:'🔥'; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:.64rem; }
.streak-day.today { border:2px solid #00ff88; }

/* === ACTIVITY === */
.activity-feed { max-height:220px; overflow-y:auto; }
.act-item { animation:actSlide .3s ease-out; }
@keyframes actSlide { from{opacity:0;transform:translateX(-14px)} to{opacity:1;transform:translateX(0)} }
@keyframes livePulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(1.6)} }
.live-dot { animation:livePulse 1.3s infinite; }

/* === EARN BTNS === */
.xp-earn-btn { display:flex; flex-direction:column; align-items:center; gap:.35rem; padding:.85rem; border-radius:14px; border:1.5px solid transparent; cursor:pointer; text-align:center; transition:all .2s; background:transparent; }
.xp-earn-btn:hover { transform:translateY(-3px); }
.xp-earn-btn:disabled { opacity:.35; cursor:not-allowed; transform:none; }

/* === GAME LAUNCH BTNS === */
.game-launch-btn {
  display:flex; flex-direction:column; align-items:center; gap:.45rem; padding:1.3rem .8rem;
  border-radius:20px; cursor:pointer; transition:all .25s;
  border:1.5px solid rgba(255,255,255,.07); background:rgba(255,255,255,.02);
  position:relative; overflow:hidden;
}
.game-launch-btn::before { content:''; position:absolute; inset:0; background:linear-gradient(135deg,rgba(0,255,136,.14),transparent); opacity:0; transition:opacity .28s; }
.game-launch-btn::after { content:''; position:absolute; bottom:0; left:0; right:0; height:2px; background:linear-gradient(90deg,transparent,rgba(0,255,136,.6),transparent); transform:scaleX(0); transition:transform .3s; }
.game-launch-btn:hover { transform:translateY(-6px) scale(1.04); border-color:#00ff88; box-shadow:0 12px 40px rgba(0,255,136,.15); }
.game-launch-btn:hover::before { opacity:1; }
.game-launch-btn:hover::after { transform:scaleX(1); }
.game-icon { font-size:2.6rem; filter:drop-shadow(0 0 12px rgba(0,255,136,.5)); transition:transform .2s; }
.game-launch-btn:hover .game-icon { transform:scale(1.15) rotate(-5deg); }

/* === AI COACH === */
.ai-coach-bubble { background:linear-gradient(135deg,rgba(0,255,136,.08),rgba(0,200,255,.04)); border:1px solid rgba(0,255,136,.18); border-radius:14px; padding:1rem; animation:coachPop .35s ease; }
@keyframes coachPop { from{transform:scale(.95);opacity:0} to{transform:scale(1);opacity:1} }
.ai-typing { display:inline-flex; gap:4px; align-items:center; }
.ai-typing span { width:7px; height:7px; border-radius:50%; background:#00ff88; animation:dot 1.2s infinite; }
.ai-typing span:nth-child(2){animation-delay:.2s} .ai-typing span:nth-child(3){animation-delay:.4s}
@keyframes dot { 0%,80%,100%{transform:scale(.7);opacity:.4} 40%{transform:scale(1.3);opacity:1} }

.ch-prog-fill { height:100%; border-radius:99px; transition:width 1s ease; }
#confetti-canvas { position:fixed; inset:0; z-index:9997; pointer-events:none; display:none; }
#confetti-canvas.show { display:block; }
.stat-card-em:hover { box-shadow:0 0 24px rgba(0,255,136,.15); }
</style>
{% endblock %}

{% block body %}
<canvas id="confetti-canvas"></canvas>

{# ── LEVEL UP ── #}
<div id="levelup-overlay">
  <div class="levelup-box" style="background:linear-gradient(135deg,#050d1a,#0a0520);border:2px solid #00ff88;border-radius:24px;padding:3rem;text-align:center;max-width:340px;width:90%;box-shadow:0 0 100px rgba(0,255,136,.35);">
    <div style="font-size:4.5rem;margin-bottom:1rem;">🚀</div>
    <p style="font-size:.65rem;color:#00ff88;letter-spacing:4px;font-weight:700;margin-bottom:.4rem;text-transform:uppercase;font-family:var(--font-game);">LEVEL UP!</p>
    <div id="lu-num" style="font-size:5.5rem;font-weight:900;color:#00ff88;text-shadow:0 0 40px #00ff88,0 0 80px rgba(0,255,136,.4);line-height:1;font-family:var(--font-game);">2</div>
    <p style="color:#94a3b8;font-size:.9rem;margin:1rem 0 1.5rem;">New level unlocked — keep pushing! 🔥</p>
    <button onclick="closeLevelUp()" class="btn btn-primary w-full justify-center" style="font-weight:800;font-family:var(--font-game);">⚡ CONTINUE</button>
  </div>
</div>

{# ── GAME MODAL ── #}
<div id="game-modal">
  <div class="game-modal-box">

    {# Header #}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.1rem;flex-wrap:wrap;gap:.6rem;">
      <div style="display:flex;align-items:center;gap:.8rem;flex-wrap:wrap;">
        <h2 style="font-size:1.05rem;font-weight:900;color:#00ff88;font-family:var(--font-game)!important;letter-spacing:.05em;">🎮 GAME ARENA</h2>
        <div id="active-player-badge" class="player-name-badge" style="display:none;">
          <span>🤖</span><span id="active-player-name-display">Player</span>
        </div>
      </div>
      <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
        <button class="gtab active" onclick="requestSwitchGame('snake')"  id="tab-snake">🐍 SNAKE</button>
        <button class="gtab"        onclick="requestSwitchGame('runner')" id="tab-runner">🏃 RUNNER</button>
        <button class="gtab"        onclick="requestSwitchGame('archer')" id="tab-archer">🎯 ARCHER</button>
        <button class="gtab"        onclick="requestSwitchGame('battle')" id="tab-battle">⚔️ BATTLE</button>
        <button class="gtab"        onclick="requestSwitchGame('puzzle')" id="tab-puzzle">🧩 PUZZLE</button>
      </div>
      <button onclick="closeGameModal()" style="color:#475569;font-size:1.3rem;background:none;border:none;cursor:pointer;padding:.2rem .5rem;border-radius:8px;line-height:1;transition:color .18s;" onmouseenter="this.style.color='#00ff88'" onmouseleave="this.style.color='#475569'">✕</button>
    </div>

    {# Score bar #}
    <div class="score-bar">
      <span style="font-size:.66rem;font-weight:700;color:#475569;letter-spacing:.08em;text-transform:uppercase;font-family:var(--font-game)!important;">SCORE</span>
      <span id="game-score-display" style="font-size:1.4rem;font-weight:900;color:#00ff88;font-family:var(--font-game)!important;text-shadow:0 0 20px rgba(0,255,136,.6);">0</span>
      <span style="font-size:.78rem;font-weight:800;color:#ff8800;font-family:var(--font-game)!important;" id="game-xp-earned">+0 XP</span>
    </div>

    {# ── PLAYER NAME SCREEN ── #}
    <div id="player-name-screen">
      <div style="font-size:4rem;line-height:1;filter:drop-shadow(0 0 20px rgba(0,255,136,.5));" id="pns-icon">🐍</div>
      <div>
        <h3 id="pns-title" style="font-size:1.5rem;font-weight:900;color:#fff;text-align:center;margin-bottom:.3rem;font-family:var(--font-game)!important;letter-spacing:.06em;">SNAKE AI</h3>
        <p  id="pns-desc" style="font-size:.83rem;color:#64748b;text-align:center;">3D Cyberpunk world · Eat 🍎 to score!</p>
      </div>
      <div style="width:100%;max-width:380px;">
        <label style="display:block;font-size:.7rem;font-weight:700;color:#94a3b8;margin-bottom:.45rem;text-transform:uppercase;letter-spacing:.1em;font-family:var(--font-game)!important;">PLAYER NAME</label>
        <input id="player-name-input" class="name-input" type="text" placeholder="Enter your name…" maxlength="20" autocomplete="off">
        <p style="font-size:.66rem;color:#334155;margin-top:.35rem;text-align:center;">Appears on leaderboard & in-game HUD</p>
      </div>
      <div style="display:flex;gap:.7rem;flex-wrap:wrap;justify-content:center;">
        <button id="pns-play-btn" onclick="startCurrentGame()" class="btn btn-primary" style="font-size:.88rem;font-weight:800;padding:.7rem 2.4rem;font-family:var(--font-game)!important;letter-spacing:.05em;">▶ PLAY NOW</button>
        <button onclick="closeGameModal()" class="btn btn-secondary" style="font-size:.82rem;">Cancel</button>
      </div>
      <div id="pns-xp-preview" style="background:rgba(0,255,136,.07);border:1px solid rgba(0,255,136,.2);border-radius:10px;padding:.5rem 1.2rem;font-size:.72rem;font-weight:800;color:#00ff88;font-family:var(--font-game)!important;">🏆 XP: varies by score</div>
    </div>

    {# ── SNAKE ── #}
    <div id="game-snake" class="game-section" style="display:none;">
      <canvas id="snake-canvas" width="1060" height="420" style="background:#020617;border:1px solid rgba(0,255,136,.15);border-radius:16px;display:block;margin:0 auto;max-width:100%;"></canvas>
      <div style="display:flex;gap:.7rem;justify-content:center;margin-top:.85rem;align-items:center;flex-wrap:wrap;">
        <button onclick="stopSnake()" class="btn btn-secondary" style="font-size:.74rem;">■ STOP</button>
        <div style="display:flex;gap:1.2rem;align-items:center;font-size:.78rem;font-weight:700;color:#94a3b8;font-family:var(--font-game)!important;">
          <span>SCORE: <span id="snake-score" style="color:#00ff88;">0</span></span>
          <span>SPD: <span id="snake-speed" style="color:#ff8800;">1.0×</span></span>
          <span>BEST: <span id="snake-best" style="color:#00ddff;">0</span></span>
        </div>
        <p style="font-size:.66rem;color:#475569;">Arrow keys / WASD · Neon cyberpunk world 🤖</p>
      </div>
    </div>

    {# ── RUNNER ── #}
    <div id="game-runner" class="game-section" style="display:none;">
      <canvas id="runner-canvas" width="1060" height="300" style="background:#0a0520;border:1px solid rgba(0,255,136,.15);border-radius:16px;display:block;margin:0 auto;max-width:100%;"></canvas>
      <div style="display:flex;gap:.7rem;justify-content:center;margin-top:.85rem;align-items:center;flex-wrap:wrap;">
        <button onclick="stopRunner()" class="btn btn-secondary" style="font-size:.74rem;">■ STOP</button>
        <div style="display:flex;gap:1.2rem;align-items:center;font-size:.78rem;font-weight:700;color:#94a3b8;font-family:var(--font-game)!important;">
          <span>DIST: <span id="runner-score" style="color:#00ff88;">0</span>m</span>
          <span>BEST: <span id="runner-best" style="color:#ff8800;">0</span>m</span>
        </div>
        <p style="font-size:.66rem;color:#475569;">SPACE / Click to jump · Double-jump! · Alien planet 🌍</p>
      </div>
    </div>

    {# ── ARCHER ── #}
    <div id="game-archer" class="game-section" style="display:none;">
      <div id="archer-arena"></div>
      <div style="display:flex;gap:.7rem;justify-content:center;margin-top:.85rem;flex-wrap:wrap;align-items:center;">
        <button onclick="stopArcher()" class="btn btn-secondary" style="font-size:.74rem;">■ STOP</button>
        <div style="display:flex;gap:1.2rem;align-items:center;font-size:.78rem;font-weight:700;color:#94a3b8;font-family:var(--font-game)!important;">
          <span>HITS:  <span id="archer-hits"  style="color:#ff00aa;">0</span></span>
          <span>COMBO: <span id="archer-combo" style="color:#ff8800;">×1</span></span>
          <span>TIME:  <span id="archer-time"  style="color:#00ff88;">30</span>s</span>
        </div>
        <p style="font-size:.66rem;color:#475569;">Click crystal gems before they vanish! 💎</p>
      </div>
    </div>

    {# ── BATTLE ── #}
    <div id="game-battle" class="game-section" style="display:none;">
      <div style="text-align:center;margin-bottom:1rem;">
        <p style="color:#94a3b8;font-size:.8rem;">🤖 <span style="color:#ff8800;font-weight:800;">Strategic AI Boss</span> — Select a card · Higher Power wins the round!</p>
      </div>
      <div class="battle-arena">
        <div>
          <p id="battle-player-label" style="font-size:.64rem;font-weight:800;text-align:center;margin-bottom:.5rem;letter-spacing:.12em;text-transform:uppercase;color:#00ff88;font-family:var(--font-game)!important;">— YOU —</p>
          <div class="hp-track"><div id="player-hp-fill" class="hp-fill player-hp" style="width:100%;"></div></div>
          <div style="text-align:center;margin-bottom:.5rem;font-size:.66rem;font-weight:700;color:#64748b;font-family:var(--font-game)!important;">HP: <span id="player-hp-num" style="color:#00ff88;">100</span></div>
          <div class="battle-hand" id="player-cards"></div>
        </div>
        <div class="battle-mid">
          <div id="battle-result" style="font-size:.88rem;font-weight:800;font-family:var(--font-game)!important;"></div>
          <div class="vs-badge">VS</div>
          <div id="battle-log"></div>
          <button onclick="initBattle()" id="battle-btn" class="btn" style="background:#ff8800;border-color:#ff8800;color:#000;font-size:.68rem;font-weight:800;margin-top:.3rem;font-family:var(--font-game)!important;">⚔️ NEW GAME</button>
        </div>
        <div>
          <p style="font-size:.64rem;font-weight:800;text-align:center;margin-bottom:.5rem;letter-spacing:.12em;text-transform:uppercase;color:#ff00aa;font-family:var(--font-game)!important;">— AI BOSS —</p>
          <div class="hp-track"><div id="ai-hp-fill" class="hp-fill ai-hp" style="width:100%;"></div></div>
          <div style="text-align:center;margin-bottom:.5rem;font-size:.66rem;font-weight:700;color:#64748b;font-family:var(--font-game)!important;">HP: <span id="ai-hp-num" style="color:#ff00aa;">100</span></div>
          <div class="battle-hand" id="ai-cards"></div>
        </div>
      </div>
    </div>

    {# ── PUZZLE ── #}
    <div id="game-puzzle" class="game-section" style="display:none;">
      <div style="text-align:center;margin-bottom:1rem;">
        <p style="color:#94a3b8;font-size:.8rem;">🧩 <span style="color:#aa44ff;font-weight:800;">AI Puzzle</span> — Drag & drop pieces to reconstruct the pattern!</p>
      </div>
      <div class="puzzle-layout">
        <div class="pz-reference">
          <p style="font-size:.64rem;font-weight:800;color:#475569;letter-spacing:.12em;text-align:center;text-transform:uppercase;font-family:var(--font-game)!important;">REFERENCE</p>
          <div id="pz-preview-grid"></div>
          <div class="pz-progress-bar"><div class="pz-progress-fill" id="pz-progress" style="width:0%;"></div></div>
          <p style="font-size:.62rem;color:#475569;text-align:center;margin-top:.4rem;"><span id="pz-correct-count">0</span>/16 correct</p>
        </div>
        <div>
          <div id="puzzle-board"></div>
          <div style="display:flex;gap:.6rem;justify-content:center;margin-top:.8rem;align-items:center;flex-wrap:wrap;">
            <button onclick="initPuzzle()" class="btn" style="background:#aa44ff;border-color:#aa44ff;font-size:.68rem;font-weight:800;font-family:var(--font-game)!important;">🔀 SHUFFLE</button>
            <span style="font-size:.74rem;font-weight:700;color:#94a3b8;font-family:var(--font-game)!important;">MOVES: <span id="puzzle-moves" style="color:#aa44ff;">0</span></span>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<div id="badge-toast-area"></div>

{# ══════════════ PAGE BODY ══════════════ #}
<div class="arena-wrap space-y-5 animate-fade-in">

  {# Header #}
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div>
      <h1 style="font-size:1.45rem;font-weight:900;font-family:var(--font-game)!important;letter-spacing:.04em;" class="text-secondary-900 dark:text-white">
        ⚡ XP <span style="color:#00ff88;">ARENA</span> <span style="font-size:.55rem;color:#475569;font-weight:500;">3D ULTIMATE</span>
      </h1>
      <p class="text-secondary-500 dark:text-secondary-400 mt-1 text-sm font-medium">Gamification dashboard · AI-Powered · 3D Worlds</p>
    </div>
    <a href="{{ path('app_revisions') }}" class="btn btn-secondary">← Back</a>
  </div>

  {# Hero #}
  <div class="card overflow-hidden">
    <div class="p-5">
      <div class="flex items-center justify-between flex-wrap gap-5">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-3xl flex-shrink-0" style="background:linear-gradient(135deg,rgba(0,255,136,.2),rgba(0,200,255,.1));border:1px solid rgba(0,255,136,.3);">🎓</div>
          <div>
            <h2 class="text-xl font-bold text-secondary-900 dark:text-white" style="font-family:var(--font-game)!important;">
              LEVEL <span id="cur-level" style="color:#00ff88;">{{ gamification.level }}</span>
            </h2>
            <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-0.5 font-medium">
              🔥 <span id="cur-streak" class="font-bold text-warning-500">{{ gamification.streak }}</span> day streak &nbsp;·&nbsp;
              🏆 Rank <span class="font-bold" style="color:#00ff88;">#<span id="cur-rank">{{ userRank }}</span></span> &nbsp;·&nbsp;
              🎖 <span id="cur-badges" class="font-bold text-warning-500">{{ gamification.badges|length }}</span> badges
            </p>
          </div>
        </div>
        <div class="min-w-64 flex-1 max-w-sm">
          <div class="flex items-baseline gap-1.5 justify-end mb-2">
            <span id="xp-display" style="font-size:2.4rem;font-weight:900;color:#00ff88;font-family:var(--font-game)!important;text-shadow:0 0 30px rgba(0,255,136,.5);">{{ gamification.points }}</span>
            <span class="text-secondary-400 font-bold text-sm" style="font-family:var(--font-game)!important;">XP</span>
          </div>
          <div class="flex justify-between text-xs text-secondary-500 font-bold mb-1.5">
            <span style="font-family:var(--font-game)!important;">LV<span id="lv-cur">{{ gamification.level }}</span></span>
            <span id="xp-prog-txt" style="font-family:var(--font-game)!important;">{{ gamification.levelProgress }}% → LV{{ gamification.level + 1 }}</span>
          </div>
          <div class="h-3 bg-secondary-100 dark:bg-secondary-700 rounded-full overflow-hidden">
            <div class="xp-bar-fill h-full rounded-full" id="xp-bar-fill" style="width:{{ progressPercent }}%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# AI Coach #}
  <div class="card overflow-hidden">
    <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
      <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center text-sm" style="background:rgba(0,255,136,.14);">🤖</div>
        AI Coach
      </h3>
      <button onclick="getAICoach()" class="btn btn-primary" style="font-size:.72rem;padding:.38rem .88rem;font-weight:700;">🔮 Ask AI</button>
    </div>
    <div class="p-4"><div id="ai-coach-content" class="ai-coach-bubble"><p style="color:#94a3b8;font-size:.84rem;">👋 Your AI coach is ready. Click <strong style="color:#00ff88;">Ask AI</strong> for a personalized performance analysis!</p></div></div>
  </div>

  {# Stats #}
  <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
    {% for stat in [
      {id:'s-xp',      val:gamification.points,              label:'Total XP',  icon:'💎', color:'#00ff88'},
      {id:'s-lvl',     val:gamification.level,               label:'Level',     icon:'⭐', color:'#ff8800'},
      {id:'s-streak',  val:gamification.streak,              label:'Streak',    icon:'🔥', color:'#ff8800'},
      {id:'s-rank',    val:userRank,                         label:'Rank',      icon:'🏆', color:'#ff00aa', prefix:'#'},
      {id:'s-decks',   val:gamification.totalDecksCompleted, label:'Decks',     icon:'📚', color:'#00ddff'},
      {id:'s-correct', val:gamification.totalCorrectAnswers, label:'Correct',   icon:'✅', color:'#00ff88'},
    ] %}
    <div class="card p-4 card-lift text-center stat-card-em">
      <div style="font-size:1.5rem;margin-bottom:.4rem;">{{ stat.icon }}</div>
      <div id="{{ stat.id }}" style="font-size:1.35rem;font-weight:900;color:{{ stat.color }};font-family:var(--font-game)!important;">{{ stat.prefix ?? '' }}{{ stat.val }}</div>
      <div style="font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;font-family:var(--font-game)!important;" class="text-secondary-400 mt-0.5">{{ stat.label }}</div>
    </div>
    {% endfor %}
  </div>

  {# Game Launch Zone #}
  <div class="card overflow-hidden">
    <div class="p-4 border-b border-secondary-200 dark:border-secondary-800">
      <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2" style="font-family:var(--font-game)!important;font-size:.85rem;letter-spacing:.04em;">
        🎮 GAME ARENA <span class="text-xs text-secondary-400 font-medium" style="font-family:var(--font-ui)!important;">· 3D Worlds · Real Characters · Earn XP!</span>
      </h3>
    </div>
    <div class="p-4">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
        <button class="game-launch-btn" onclick="openGame('snake')">
          <span class="game-icon">🐍</span>
          <span style="font-size:.66rem;font-weight:800;color:#00ff88;font-family:var(--font-game)!important;">SNAKE 3D</span>
          <span style="font-size:.6rem;color:#475569;">Cyberpunk city</span>
          <span style="font-size:.6rem;font-weight:800;color:#00ddff;">Robot snake 🤖</span>
        </button>
        <button class="game-launch-btn" onclick="openGame('runner')">
          <span class="game-icon">🏃</span>
          <span style="font-size:.66rem;font-weight:800;color:#00ddff;font-family:var(--font-game)!important;">RUNNER 3D</span>
          <span style="font-size:.6rem;color:#475569;">Alien planet</span>
          <span style="font-size:.6rem;font-weight:800;color:#00ff88;">Neon hero 🤖</span>
        </button>
        <button class="game-launch-btn" onclick="openGame('archer')">
          <span class="game-icon">🎯</span>
          <span style="font-size:.66rem;font-weight:800;color:#ff00aa;font-family:var(--font-game)!important;">ARCHER 3D</span>
          <span style="font-size:.6rem;color:#475569;">Crystal realm</span>
          <span style="font-size:.6rem;font-weight:800;color:#aa44ff;">Gem targets 💎</span>
        </button>
        <button class="game-launch-btn" onclick="openGame('battle')">
          <span class="game-icon">⚔️</span>
          <span style="font-size:.66rem;font-weight:800;color:#ff8800;font-family:var(--font-game)!important;">CARD BATTLE</span>
          <span style="font-size:.6rem;color:#475569;">Beat AI boss</span>
          <span style="font-size:.6rem;font-weight:800;color:#00ff88;">+200 XP win</span>
        </button>
        <button class="game-launch-btn" onclick="openGame('puzzle')">
          <span class="game-icon">🧩</span>
          <span style="font-size:.66rem;font-weight:800;color:#aa44ff;font-family:var(--font-game)!important;">PUZZLE AI</span>
          <span style="font-size:.6rem;color:#475569;">Drag & build</span>
          <span style="font-size:.6rem;font-weight:800;color:#00ff88;">+50 XP + Badge</span>
        </button>
      </div>
    </div>
  </div>

  {# Earn XP + Challenges #}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800">
        <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>⚡</span> Earn XP</h3>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-2 gap-3">
          <button id="btn-correct" onclick="earnCorrectAnswer()" class="xp-earn-btn bg-success-50 dark:bg-success-900/20 border-success-200 dark:border-success-800 hover:border-success-400">
            <span class="text-2xl">🎯</span><span class="text-sm font-bold text-secondary-800 dark:text-white">Correct Answer</span>
            <span class="text-xs font-extrabold text-success-600 bg-success-100 px-2.5 py-0.5 rounded-full">+10 XP</span>
          </button>
          <button id="btn-deck" onclick="earnDeckCompleted()" class="xp-earn-btn bg-primary-50 dark:bg-primary-900/20 border-primary-200 dark:border-primary-800 hover:border-primary-400">
            <span class="text-2xl">📚</span><span class="text-sm font-bold text-secondary-800 dark:text-white">Complete Deck</span>
            <span class="text-xs font-extrabold text-primary-600 bg-primary-100 px-2.5 py-0.5 rounded-full">+50 XP</span>
          </button>
          <button id="btn-daily" onclick="earnDailyRevision()" class="xp-earn-btn bg-warning-50 dark:bg-warning-900/20 border-warning-200 dark:border-warning-800 hover:border-warning-400">
            <span class="text-2xl">📅</span><span class="text-sm font-bold text-secondary-800 dark:text-white">Daily Revision</span>
            <span class="text-xs font-extrabold text-warning-600 bg-warning-100 px-2.5 py-0.5 rounded-full">+15 XP</span>
          </button>
          <button id="btn-streak" onclick="doStreak10()" class="xp-earn-btn bg-orange-50 dark:bg-orange-900/20 border-orange-200 dark:border-orange-800 hover:border-orange-400">
            <span class="text-2xl">🔥</span><span class="text-sm font-bold text-secondary-800 dark:text-white">Streak Bonus</span>
            <span class="text-xs font-extrabold text-orange-600 bg-orange-100 px-2.5 py-0.5 rounded-full">+100 XP</span>
          </button>
        </div>
        <div class="mt-3 bg-secondary-50 dark:bg-secondary-800 rounded-xl p-3 border border-secondary-200 dark:border-secondary-700">
          <p style="font-size:.66rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;" class="text-secondary-400 mb-2">⏱️ Cooldowns</p>
          <div class="flex justify-between text-sm"><span class="text-secondary-600 dark:text-secondary-400 font-medium">Correct Answer</span><span id="cd-correct" class="font-bold text-xs text-success-500">READY</span></div>
          <div class="flex justify-between text-sm mt-1"><span class="text-secondary-600 dark:text-secondary-400 font-medium">Daily Revision</span><span id="cd-daily" class="font-bold text-xs text-success-500">READY</span></div>
        </div>
      </div>
    </div>
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>🎯</span> Daily Challenges</h3>
        <span id="challenge-timer" class="text-xs text-secondary-400 font-medium">Resets at midnight</span>
      </div>
      <div class="p-4"><div id="challenge-list" class="flex flex-col gap-3"></div></div>
    </div>
  </div>

  {# Memory + Roulette + Leaderboard #}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>🃏</span> Memory Game</h3>
        <button onclick="initMemory()" class="btn btn-secondary" style="padding:.3rem .7rem;font-size:.7rem;">↺</button>
      </div>
      <div class="p-4">
        <div class="grid grid-cols-3 gap-2 mb-3">
          <div class="bg-secondary-50 dark:bg-secondary-800 rounded-xl p-2 text-center border border-secondary-200 dark:border-secondary-700">
            <div id="mem-moves" style="font-size:1.2rem;font-weight:900;color:#00ff88;font-family:var(--font-game)!important;">0</div>
            <div style="font-size:.6rem;font-weight:700;font-family:var(--font-game)!important;" class="text-secondary-400">MOVES</div>
          </div>
          <div class="bg-secondary-50 dark:bg-secondary-800 rounded-xl p-2 text-center border border-secondary-200 dark:border-secondary-700">
            <div id="mem-pairs" style="font-size:1.2rem;font-weight:900;color:#00ddff;font-family:var(--font-game)!important;">0/8</div>
            <div style="font-size:.6rem;font-weight:700;font-family:var(--font-game)!important;" class="text-secondary-400">PAIRS</div>
          </div>
          <div class="bg-secondary-50 dark:bg-secondary-800 rounded-xl p-2 text-center border border-secondary-200 dark:border-secondary-700">
            <div id="mem-timer" style="font-size:1.2rem;font-weight:900;color:#ff8800;font-family:var(--font-game)!important;">0s</div>
            <div style="font-size:.6rem;font-weight:700;font-family:var(--font-game)!important;" class="text-secondary-400">TIME</div>
          </div>
        </div>
        <div id="memory-grid"></div>
        <p class="text-xs text-secondary-400 text-center mt-2 font-medium">Complete → <strong class="text-warning-500">+30 XP</strong></p>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>🎰</span> XP Roulette</h3>
        <span class="text-xs text-secondary-400 font-medium bg-secondary-100 dark:bg-secondary-800 px-2 py-0.5 rounded-full border border-secondary-200 dark:border-secondary-700">1× per session</span>
      </div>
      <div class="p-5 text-center">
        <div class="relative inline-block mb-4 mt-2">
          <div style="font-size:1.1rem;position:absolute;top:-26px;left:50%;transform:translateX(-50%);">⬇️</div>
          <div class="roulette-wheel" id="roulette-wheel"><div class="roulette-center" id="roulette-center">SPIN</div></div>
        </div>
        <button id="spin-btn" onclick="spinRoulette()" class="btn btn-primary w-full justify-center" style="font-weight:800;font-family:var(--font-game)!important;">🎰 SPIN TO WIN!</button>
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>🥇</span> Leaderboard</h3>
        <button onclick="refreshLeaderboard()" class="btn btn-secondary" style="padding:.3rem .7rem;font-size:.7rem;">↺</button>
      </div>
      <div class="p-3">
        <div id="leaderboard-list" class="flex flex-col gap-1">
          {% for item in leaderboard %}{% set rank=loop.index %}
          <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-secondary-50 dark:hover:bg-secondary-800 {{ item.user==app.user?'bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800':'' }}">
            <div class="w-7 text-center font-bold text-sm" style="font-family:var(--font-game)!important;">{{ rank==1?'🥇':(rank==2?'🥈':(rank==3?'🥉':rank)) }}</div>
            <div class="w-8 h-8 rounded-lg flex items-center justify-center text-white font-bold text-xs" style="background:linear-gradient(135deg,#00ff88,#ff8800)">{{ item.user.email|slice(0,1)|upper }}</div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-bold truncate text-secondary-800 dark:text-secondary-200">{{ item.user.email|slice(0,14) }}{% if item.user==app.user %} (you){% endif %}</div>
              <div class="text-xs text-secondary-400 font-medium">Lv{{ item.level }}</div>
            </div>
            <div class="text-sm font-bold" style="color:#00ff88;font-family:var(--font-game)!important;">{{ item.points }}</div>
          </div>{% else %}
          <div class="text-center py-6 text-secondary-400 text-sm font-medium">Be first! 🚀</div>{% endfor %}
        </div>
      </div>
    </div>
  </div>

  {# Streak + Activity #}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>🔥</span> Streak Calendar</h3>
        <span id="streak-count" class="text-sm font-bold text-warning-500">{{ gamification.streak }} days</span>
      </div>
      <div class="p-4">
        <div id="streak-cal" class="mb-3"></div>
        <div class="bg-warning-50 dark:bg-warning-900/20 rounded-xl p-3 border border-warning-200 dark:border-warning-800">
          <p style="font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;" class="text-warning-600 mb-2">🔥 Milestones</p>
          <div class="flex justify-between text-xs font-medium"><span class="text-secondary-500">7 days</span><span class="{{ gamification.streak>=7?'text-success-500 font-bold':'text-secondary-400' }}">{{ gamification.streak>=7?'✅ Done':'🔒 '~gamification.streak~'/7' }}</span></div>
          <div class="flex justify-between text-xs font-medium mt-1"><span class="text-secondary-500">30 days</span><span class="text-secondary-400">🔒 {{ gamification.streak }}/30</span></div>
        </div>
      </div>
    </div>
    <div class="card overflow-hidden">
      <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
        <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>📡</span> Live Activity</h3>
        <span class="flex items-center gap-1.5 text-xs text-success-500 font-bold"><span class="live-dot w-1.5 h-1.5 bg-success-500 rounded-full inline-block"></span>LIVE</span>
      </div>
      <div class="p-4"><div class="activity-feed flex flex-col gap-2" id="activity-feed">
        <div class="act-item flex items-center gap-2.5 px-3 py-2 rounded-xl bg-secondary-50 dark:bg-secondary-800 border border-secondary-200 dark:border-secondary-700"><span>🚀</span><span class="text-sm text-secondary-600 dark:text-secondary-300 flex-1 font-medium">Session started</span><span class="text-xs text-secondary-400">now</span></div>
      </div></div>
    </div>
  </div>

  {# Badges #}
  <div class="card overflow-hidden">
    <div class="p-4 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
      <h3 class="font-bold text-secondary-900 dark:text-white flex items-center gap-2"><span>🏆</span> All Badges</h3>
      <span style="font-size:.68rem;font-weight:700;font-family:var(--font-game)!important;" class="text-secondary-400 bg-secondary-100 dark:bg-secondary-800 border border-secondary-200 dark:border-secondary-700 px-2.5 py-1 rounded-full">{{ gamification.badges|length }} / 7</span>
    </div>
    <div class="p-4">
      {% set allBadges=[
        {name:'Master Deck',          icon:'🎖',desc:'Complete 1 deck at 100%'},
        {name:'Streak 7 Days',        icon:'🔥',desc:'Study 7 days in a row'},
        {name:'100 Correct Answers',  icon:'💯',desc:'Give 100 correct answers'},
        {name:'500 Correct Answers',  icon:'🚀',desc:'Give 500 correct answers'},
        {name:'Level 5',              icon:'⭐',desc:'Reach level 5'},
        {name:'Level 10',             icon:'🌟',desc:'Reach level 10'},
        {name:'Puzzle Master',        icon:'🧩',desc:'Complete the AI puzzle'},
      ]%}{% set earnedNames=gamification.badges|map(b=>b.name) %}
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
        {% for badge in allBadges %}{% set isEarned=badge.name in earnedNames %}
        <div class="card-lift rounded-2xl border-2 p-3 text-center {{ isEarned?'bg-warning-50 dark:bg-warning-900/20 border-warning-300 dark:border-warning-700':'bg-secondary-50 dark:bg-secondary-800 border-secondary-200 dark:border-secondary-700 opacity-60' }}">
          <div class="text-2xl mb-1">{{ isEarned?badge.icon:'🔒' }}</div>
          <div class="text-xs font-bold text-secondary-800 dark:text-secondary-200 mb-1">{{ badge.name }}</div>
          <div class="text-xs text-secondary-400 mb-2 font-medium">{{ badge.desc }}</div>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full {{ isEarned?'bg-success-100 text-success-600':'bg-secondary-100 dark:bg-secondary-700 text-secondary-400' }}">{{ isEarned?'✅ Earned':'🔒 Locked' }}</span>
        </div>{% endfor %}
      </div>
    </div>
  </div>

</div>

<div id="gami-data"
  data-points="{{ gamification.points }}"
  data-level="{{ gamification.level }}"
  data-streak="{{ gamification.streak }}"
  data-progress="{{ progressPercent }}"
  data-correct="{{ gamification.totalCorrectAnswers }}"
  data-decks="{{ gamification.totalDecksCompleted }}">
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
'use strict';
const DATA = document.getElementById('gami-data').dataset;
let state = { points:+DATA.points, level:+DATA.level, streak:+DATA.streak, correct:+DATA.correct, decks:+DATA.decks };
let cooldowns = { correct:0, daily:0 };
let challengeProgress = { c1:0, c2:0, c3:0, c4:0 };
let gameScore = 0, gameXPEarned = 0;
let playerName = '', pendingGame = null, currentGame = null;

const GAME_META = {
  snake:  { icon:'🐍', title:'SNAKE 3D',     desc:'Cyberpunk neon city · Robot snake eats apples · Arrow keys or WASD', xp:'Points ÷ 2 XP' },
  runner: { icon:'🏃', title:'RUNNER 3D',    desc:'Alien planet adventure · Robot hero vs monsters · SPACE or Click to jump!', xp:'Distance ÷ 5 XP' },
  archer: { icon:'🎯', title:'ARCHER 3D',    desc:'Crystal magical realm · Shoot glowing gems before they vanish! Build combos!', xp:'Hits × 4 XP' },
  battle: { icon:'⚔️', title:'CARD BATTLE',  desc:'Strategic card game · Play your card · Higher Power wins! Beat the AI Boss!', xp:'+200 XP on victory' },
  puzzle: { icon:'🧩', title:'PUZZLE AI',    desc:'Drag & drop to reconstruct the emoji pattern. Fewer moves = more XP!', xp:'Up to +60 XP' },
};

/* ── AI COACH ── */
const OPENROUTER_KEY = 'YOUR_OPENROUTER_KEY_HERE';
async function askAI(prompt) {
  try {
    const r = await fetch('https://openrouter.ai/api/v1/chat/completions',{method:'POST',headers:{'Authorization':`Bearer ${OPENROUTER_KEY}`,'Content-Type':'application/json','HTTP-Referer':window.location.origin},body:JSON.stringify({model:'mistralai/mistral-7b-instruct:free',messages:[{role:'user',content:prompt}],max_tokens:200,temperature:.8})});
    const d = await r.json(); return d.choices?.[0]?.message?.content || null;
  } catch(e){ return null; }
}
async function getAICoach() {
  const box = document.getElementById('ai-coach-content');
  box.innerHTML = `<div style="display:flex;align-items:center;gap:.6rem;"><div class="ai-typing"><span></span><span></span><span></span></div><span style="color:#94a3b8;font-size:.84rem;">Analyzing your profile…</span></div>`;
  const prompt = `You are an enthusiastic AI study coach. The student has: ${state.points} XP, level ${state.level}, ${state.streak} day streak, ${state.correct} correct answers, ${state.decks} decks completed. Give a SHORT analysis (3 sentences max): 1) a personalized compliment, 2) one improvement tip, 3) a motivating challenge. Respond in English with emojis!`;
  const r = await askAI(prompt);
  box.innerHTML = r
    ? `<div style="display:flex;gap:.8rem;align-items:flex-start;"><span style="font-size:1.4rem;flex-shrink:0;">🤖</span><p style="color:#e2e8f0;font-size:.86rem;line-height:1.7;">${r}</p></div>`
    : `<p style="color:#94a3b8;font-size:.84rem;">⚠️ Set up your OpenRouter API key to enable AI Coach!</p>`;
  if(r) addActivity('🤖','AI Coach analyzed your stats!');
}

/* ── UI HELPERS ── */
function updateUI(d) {
  const oldLevel = state.level;
  if(d.points!==undefined) state.points = d.points;
  if(d.level!==undefined)  state.level  = d.level;
  if(d.streak!==undefined) state.streak = d.streak;
  ['xp-display','s-xp'].forEach(id=>animateCount(id,state.points));
  animateCount('s-lvl',state.level); animateCount('s-streak',state.streak);
  ['cur-level','lv-cur'].forEach(id=>document.getElementById(id).textContent=state.level);
  document.getElementById('cur-streak').textContent=state.streak;
  document.getElementById('streak-count').textContent=state.streak+' days';
  const pct=state.points%100;
  document.getElementById('xp-bar-fill').style.width=pct+'%';
  document.getElementById('xp-prog-txt').textContent=pct+'% → LV'+(state.level+1);
  if(state.level>oldLevel) setTimeout(()=>showLevelUp(state.level),600);
}
function animateCount(id,target){
  const el=document.getElementById(id); if(!el)return;
  const start=parseInt(el.textContent.replace(/\D/g,''))||0, diff=target-start;
  if(!diff){el.textContent=target;return;}
  let step=0;
  const t=setInterval(()=>{step++;el.textContent=Math.round(start+diff*(step/20));if(step>=20){el.textContent=target;clearInterval(t);}},30);
}
function spawnFloater(text,color='#00ff88'){
  const el=document.createElement('div'); el.className='xp-floater'; el.textContent=text;
  el.style.cssText=`left:${25+Math.random()*50}%;top:${20+Math.random()*35}%;color:${color};`;
  document.body.appendChild(el); setTimeout(()=>el.remove(),2200);
}
function addActivity(icon,text,xp){
  const feed=document.getElementById('activity-feed');
  const item=document.createElement('div');
  item.className='act-item flex items-center gap-2.5 px-3 py-2 rounded-xl bg-secondary-50 dark:bg-secondary-800 border border-secondary-200 dark:border-secondary-700';
  item.innerHTML=`<span class="text-base flex-shrink-0">${icon}</span><span class="text-sm text-secondary-600 dark:text-secondary-300 flex-1 font-medium">${text}</span>${xp?`<span class="text-xs font-bold" style="color:#00ff88;">+${xp} XP</span>`:''}<span class="text-xs text-secondary-400">now</span>`;
  feed.insertBefore(item,feed.firstChild);
  if(feed.children.length>8) feed.removeChild(feed.lastChild);
}
function showLevelUp(lvl){ document.getElementById('lu-num').textContent=lvl; document.getElementById('levelup-overlay').classList.add('show'); launchConfetti(); }
function closeLevelUp()  { document.getElementById('levelup-overlay').classList.remove('show'); stopConfetti(); }
function showBadgeToast(name){
  const area=document.getElementById('badge-toast-area'), t=document.createElement('div');
  t.className='badge-toast card flex items-center gap-3 px-4 py-3 max-w-xs border-l-4 border-warning-400';
  t.innerHTML=`<span class="text-2xl">🏅</span><div><div style="font-size:.64rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-family:var(--font-game)!important;" class="text-warning-500">NEW BADGE!</div><div class="text-sm font-bold text-secondary-900 dark:text-white">${name}</div></div>`;
  area.appendChild(t);
  setTimeout(()=>{t.style.opacity='0';t.style.transform='translateX(50px)';t.style.transition='all .4s';},4000);
  setTimeout(()=>t.remove(),4500);
}

/* ── COOLDOWNS ── */
function setCooldown(k,s){ cooldowns[k]=Date.now()+s*1000; }
function checkCooldown(k){ return cooldowns[k]?Date.now()<cooldowns[k]:false; }
function updateCooldownUI(){
  const cc=document.getElementById('cd-correct'),cd=document.getElementById('cd-daily');
  if(checkCooldown('correct')){const r=Math.ceil((cooldowns.correct-Date.now())/1000);cc.textContent=r+'s';cc.className='font-bold text-xs text-danger-500';}
  else{cc.textContent='READY';cc.className='font-bold text-xs text-success-500';}
  if(checkCooldown('daily')){cd.textContent='Done today';cd.className='font-bold text-xs text-warning-500';}
  else{cd.textContent='READY';cd.className='font-bold text-xs text-success-500';}
}
setInterval(updateCooldownUI,500);

/* ── CHALLENGES ── */
const CHALLENGES=[
  {id:'c1',icon:'🎯',name:'Answer Machine',desc:'Get 5 correct answers',target:5,reward:25},
  {id:'c2',icon:'🔥',name:'On Fire',       desc:'Maintain 3-day streak', target:3,reward:30},
  {id:'c3',icon:'📚',name:'Deck Destroyer',desc:'Complete 2 decks',      target:2,reward:50},
  {id:'c4',icon:'🎮',name:'Gamer Mode',    desc:'Play 3 mini-games',     target:3,reward:60},
];
function renderChallenges(){
  const list=document.getElementById('challenge-list'); list.innerHTML='';
  CHALLENGES.forEach(ch=>{
    const prog=challengeProgress[ch.id]||0, done=prog>=ch.target, pct=Math.min(100,Math.round(prog/ch.target*100));
    list.innerHTML+=`<div class="flex items-center gap-3 p-3 rounded-xl border ${done?'bg-success-50 dark:bg-success-900/20 border-success-200 dark:border-success-800':'bg-secondary-50 dark:bg-secondary-800 border-secondary-200 dark:border-secondary-700'}">
      <span class="text-xl">${ch.icon}</span>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-bold ${done?'line-through text-secondary-400':'text-secondary-800 dark:text-secondary-200'}">${ch.name}</div>
        <div class="text-xs text-secondary-400 mt-0.5 font-medium">${ch.desc} (${Math.min(prog,ch.target)}/${ch.target})</div>
        <div class="mt-1.5 h-1.5 bg-secondary-200 dark:bg-secondary-700 rounded-full overflow-hidden"><div class="ch-prog-fill" style="width:${pct}%;background:#00ff88;"></div></div>
      </div>
      ${done?'<span class="text-lg">✅</span>':`<span class="text-xs font-bold text-warning-500">+${ch.reward} XP</span>`}
    </div>`;
  });
}
function progressChallenge(id,amount=1){
  const ch=CHALLENGES.find(c=>c.id===id);
  if(!ch||(challengeProgress[id]||0)>=ch.target) return;
  challengeProgress[id]=Math.min(ch.target,(challengeProgress[id]||0)+amount);
  if(challengeProgress[id]>=ch.target){
    addActivity('🏆',`Challenge: ${ch.name}!`,ch.reward);
    spawnFloater(`CHALLENGE! +${ch.reward} XP`,'#ff8800');
    showBadgeToast(`Challenge: ${ch.name}`);
    launchConfetti();
    callAPI('/gamification/correct-answer',{});
  }
  renderChallenges();
}

/* ── API ── */
async function callAPI(url,body={}){
  try{const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify(body)});if(!r.ok)throw new Error();return await r.json();}catch(e){return null;}
}
async function addXP(amount){
  const calls=Math.ceil(amount/10);
  for(let i=0;i<calls;i++){
    const d=await callAPI('/gamification/correct-answer');
    if(d?.success) updateUI(d);
    else{state.points+=10;updateUI({points:state.points,level:Math.floor(state.points/100)+1});}
    await new Promise(r=>setTimeout(r,80));
  }
  gameXPEarned+=amount;
  document.getElementById('game-xp-earned').textContent='+'+gameXPEarned+' XP';
}

/* ── EARN ACTIONS ── */
async function earnCorrectAnswer(){
  if(checkCooldown('correct'))return; setCooldown('correct',3);
  const btn=document.getElementById('btn-correct'); btn.disabled=true;
  const d=await callAPI('/gamification/correct-answer');
  if(d?.success){spawnFloater('+10 XP 🎯','#00ff88');addActivity('🎯','Correct answer!',10);updateUI(d);d.newBadges?.forEach(b=>showBadgeToast(b));}
  else{state.points+=10;spawnFloater('+10 XP 🎯','#00ff88');addActivity('🎯','Correct answer!',10);updateUI({points:state.points,level:Math.floor(state.points/100)+1});}
  progressChallenge('c1'); state.correct++; document.getElementById('s-correct').textContent=state.correct;
  setTimeout(()=>btn.disabled=false,3000);
}
async function earnDeckCompleted(){
  const btn=document.getElementById('btn-deck'); btn.disabled=true;
  const d=await callAPI('/gamification/deck-completed/0');
  if(d?.success){spawnFloater('+50 XP 📚','#00ddff');addActivity('📚','Deck completed!',50);updateUI(d);d.newBadges?.forEach(b=>showBadgeToast(b));}
  else{state.points+=50;spawnFloater('+50 XP 📚','#00ddff');addActivity('📚','Deck completed!',50);updateUI({points:state.points,level:Math.floor(state.points/100)+1});}
  state.decks++; document.getElementById('s-decks').textContent=state.decks; progressChallenge('c3'); launchConfetti();
  setTimeout(()=>btn.disabled=false,3000);
}
async function earnDailyRevision(){
  if(checkCooldown('daily')){addActivity('ℹ️','Daily already claimed!');return;} setCooldown('daily',86400);
  const d=await callAPI('/gamification/daily-revision');
  if(d?.success){spawnFloater('+15 XP 📅','#ff8800');addActivity('📅','Daily revision!',15);updateUI(d);}
  else{state.points+=15;spawnFloater('+15 XP 📅','#ff8800');addActivity('📅','Daily revision!',15);updateUI({points:state.points,level:Math.floor(state.points/100)+1});}
}
async function doStreak10(){
  for(let i=0;i<10;i++){const d=await callAPI('/gamification/correct-answer');if(d?.success)updateUI(d);else{state.points+=10;updateUI({points:state.points,level:Math.floor(state.points/100)+1});}await new Promise(r=>setTimeout(r,100));}
  spawnFloater('+100 XP 🔥','#ff4400'); addActivity('🔥','Streak bonus!',100); launchConfetti();
}

/* ── GAME MODAL + PLAYER NAME FLOW ── */
function openGame(game) {
  pendingGame=game;
  document.getElementById('game-modal').classList.add('show');
  document.body.style.overflow='hidden';
  gameScore=0; gameXPEarned=0;
  document.getElementById('game-score-display').textContent='0';
  document.getElementById('game-xp-earned').textContent='+0 XP';
  showNameScreen(game);
  progressChallenge('c4');
}
function showNameScreen(game) {
  const meta=GAME_META[game];
  document.querySelectorAll('.game-section').forEach(s=>s.style.display='none');
  document.querySelectorAll('.gtab').forEach(t=>t.classList.remove('active'));
  const tab=document.getElementById('tab-'+game); if(tab) tab.classList.add('active');
  document.getElementById('pns-icon').textContent=meta.icon;
  document.getElementById('pns-title').textContent=meta.title;
  document.getElementById('pns-desc').textContent=meta.desc;
  document.getElementById('pns-xp-preview').textContent='🏆 XP: '+meta.xp;
  document.getElementById('player-name-screen').classList.add('show');
  const inp=document.getElementById('player-name-input');
  if(playerName) inp.value=playerName;
  setTimeout(()=>inp.focus(),80);
}
function startCurrentGame() {
  const inp=document.getElementById('player-name-input'), name=inp.value.trim();
  if(!name){inp.style.borderColor='#ef4444';inp.placeholder='Please enter your name!';inp.focus();setTimeout(()=>{inp.style.borderColor='';inp.placeholder='Enter your name…';},1800);return;}
  playerName=name;
  document.getElementById('active-player-name-display').textContent=playerName;
  document.getElementById('active-player-badge').style.display='inline-flex';
  document.getElementById('player-name-screen').classList.remove('show');
  launchGame(pendingGame);
}
document.getElementById('player-name-input').addEventListener('keydown',e=>{if(e.key==='Enter') startCurrentGame();});
function requestSwitchGame(game) {
  stopSnake(); stopRunner(); stopArcher();
  if(!playerName){showNameScreen(game);pendingGame=game;return;}
  pendingGame=game;
  document.getElementById('player-name-screen').classList.remove('show');
  launchGame(game);
}
function launchGame(game) {
  document.querySelectorAll('.game-section').forEach(s=>s.style.display='none');
  document.querySelectorAll('.gtab').forEach(t=>t.classList.remove('active'));
  document.getElementById('game-'+game).style.display='block';
  const tab=document.getElementById('tab-'+game); if(tab) tab.classList.add('active');
  currentGame=game;
  if(game==='snake')  startSnake();
  if(game==='runner') startRunner();
  if(game==='archer') startArcher();
  if(game==='battle') initBattle();
  if(game==='puzzle') initPuzzle();
}
function closeGameModal(){
  document.getElementById('game-modal').classList.remove('show');
  document.getElementById('player-name-screen').classList.remove('show');
  document.body.style.overflow='';
  stopSnake(); stopRunner(); stopArcher();
}

/* ══════════════════════════════════════════════════════
   🐍 SNAKE 3D — CYBERPUNK ROBOT SNAKE
══════════════════════════════════════════════════════ */
let snakeInterval=null, snake=[], dir={x:1,y:0}, food={x:10,y:7}, snakeRunning=false, snakeBest=0;
let snakeParticles=[], snakeFrame=0;
const CELL=20, COLS=53, ROWS=21;

function startSnake(){
  snake=[{x:6,y:10},{x:5,y:10},{x:4,y:10}]; dir={x:1,y:0}; gameScore=0; snakeRunning=true;
  snakeParticles=[]; snakeFrame=0;
  placeFood();
  const speed=Math.max(55,145-state.level*8);
  document.getElementById('snake-speed').textContent=(Math.round((145-speed)/90*10)/10+1).toFixed(1)+'×';
  clearInterval(snakeInterval); snakeInterval=setInterval(snakeTick,speed);
}
function stopSnake(){ clearInterval(snakeInterval); snakeRunning=false; drawSnake3D(); }
function placeFood(){ food={x:Math.floor(Math.random()*COLS),y:Math.floor(Math.random()*ROWS)}; }

function snakeTick(){
  snakeFrame++;
  const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};
  if(head.x<0||head.x>=COLS||head.y<0||head.y>=ROWS||snake.some(s=>s.x===head.x&&s.y===head.y)){
    if(gameScore>snakeBest){snakeBest=gameScore;document.getElementById('snake-best').textContent=snakeBest;}
    for(let i=0;i<30;i++) snakeParticles.push({x:snake[0].x*CELL+10,y:snake[0].y*CELL+10,vx:(Math.random()-.5)*12,vy:(Math.random()-.5)*12,life:40,color:`hsl(${Math.random()*60},100%,60%)`,size:3+Math.random()*5});
    stopSnake();
    const xp=Math.max(5,Math.floor(gameScore/2));
    addXP(xp); spawnFloater(`+${xp} XP 🤖`,'#00ff88');
    addActivity('🤖',`${playerName} — Snake 3D: ${gameScore} pts!`,xp);
    if(gameScore>=50) launchConfetti();
    return;
  }
  snake.unshift(head);
  if(head.x===food.x&&head.y===food.y){
    gameScore+=10;
    document.getElementById('snake-score').textContent=gameScore;
    document.getElementById('game-score-display').textContent=gameScore;
    for(let i=0;i<15;i++) snakeParticles.push({x:food.x*CELL+10,y:food.y*CELL+10,vx:(Math.random()-.5)*8,vy:(Math.random()-.5)*8,life:25,color:`hsl(${80+Math.random()*80},100%,65%)`,size:2+Math.random()*4});
    spawnFloater('+10 🍎','#00ff88'); placeFood();
    const ns=Math.max(55,145-state.level*8-gameScore/2);
    clearInterval(snakeInterval); snakeInterval=setInterval(snakeTick,ns);
  } else { snake.pop(); }
  if(snakeFrame%3===0){
    const tail=snake[snake.length-1];
    snakeParticles.push({x:tail.x*CELL+10,y:tail.y*CELL+10,vx:(Math.random()-.5)*1.5,vy:-.5-Math.random(),life:18,color:'rgba(0,255,136,0.35)',size:3});
  }
  drawSnake3D();
}

function drawSnake3D(){
  const canvas=document.getElementById('snake-canvas'), ctx=canvas.getContext('2d');
  const W=canvas.width, H=canvas.height;
  ctx.clearRect(0,0,W,H);
  // Sky
  const skyGrd=ctx.createLinearGradient(0,0,0,H);
  skyGrd.addColorStop(0,'#050010'); skyGrd.addColorStop(.4,'#0a0030'); skyGrd.addColorStop(1,'#0d0020');
  ctx.fillStyle=skyGrd; ctx.fillRect(0,0,W,H);
  // Nebulas
  const t=snakeFrame*.01;
  [[W*.15,H*.3,160,280],[W*.5,H*.2,200,200],[W*.82,H*.4,140,320]].forEach(([cx,cy,r,hue])=>{
