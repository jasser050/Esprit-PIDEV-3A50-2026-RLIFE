{% extends 'base.html.twig' %}
{% block title %}⚡ XP Arena — Gamification{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;600;700;900&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════════════
   ROOT VARIABLES
═══════════════════════════════════════════════ */
:root {
  --neon-cyan:   #00f5ff;
  --neon-pink:   #ff006e;
  --neon-green:  #39ff14;
  --neon-yellow: #ffea00;
  --neon-purple: #bf00ff;
  --neon-orange: #ff6b00;
  --dark-bg:     #050510;
  --dark-card:   #0a0a1f;
  --dark-border: rgba(0,245,255,0.15);
  --text-dim:    rgba(255,255,255,0.5);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Exo 2', sans-serif;
  background: var(--dark-bg);
  color: white;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Animated grid background */
body::before {
  content: '';
  position: fixed; inset: 0; z-index: 0;
  background-image:
    linear-gradient(rgba(0,245,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,255,0.03) 1px, transparent 1px);
  background-size: 50px 50px;
  animation: gridMove 20s linear infinite;
}
@keyframes gridMove { 0%{background-position:0 0} 100%{background-position:50px 50px} }

/* Scanlines */
body::after {
  content: '';
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.08) 2px, rgba(0,0,0,0.08) 4px);
}

.arena-wrap {
  position: relative; z-index: 1;
  max-width: 1300px; margin: 0 auto;
  padding: 1.5rem 1rem 4rem;
}

/* ═══════════════════════════════════════════════
   TOP NAV
═══════════════════════════════════════════════ */
.top-nav {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;
}
.nav-logo {
  font-family: 'Orbitron', monospace;
  font-size: 1.1rem; font-weight: 900;
  color: var(--neon-cyan);
  text-shadow: 0 0 20px var(--neon-cyan);
  text-decoration: none;
}
.nav-logo span { color: var(--neon-pink); }
.back-link {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .5rem 1rem;
  background: rgba(0,245,255,0.05);
  border: 1px solid var(--dark-border);
  border-radius: 8px;
  color: var(--text-dim);
  text-decoration: none;
  font-size: .8rem; font-weight: 600;
  transition: all .2s;
}
.back-link:hover { border-color: var(--neon-cyan); color: var(--neon-cyan); }

/* ═══════════════════════════════════════════════
   HERO BANNER
═══════════════════════════════════════════════ */
.hero-banner {
  position: relative;
  background: linear-gradient(135deg, rgba(0,245,255,0.05) 0%, rgba(191,0,255,0.05) 50%, rgba(255,0,110,0.05) 100%);
  border: 1px solid var(--dark-border);
  border-radius: 24px;
  padding: 2rem 2.5rem;
  margin-bottom: 1.5rem;
  overflow: hidden;
}
.hero-banner::before {
  content: '';
  position: absolute; top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: conic-gradient(from 0deg, transparent 0%, rgba(0,245,255,0.03) 20%, transparent 40%);
  animation: rotateBg 8s linear infinite;
}
@keyframes rotateBg { 100%{transform:rotate(360deg)} }

.hero-inner {
  position: relative; z-index: 1;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1.5rem;
}
.hero-left { display: flex; align-items: center; gap: 1.5rem; }

.avatar-circle {
  width: 80px; height: 80px; border-radius: 50%;
  background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
  display: flex; align-items: center; justify-content: center;
  font-size: 2rem;
  box-shadow: 0 0 30px rgba(0,245,255,0.4), 0 0 60px rgba(191,0,255,0.2);
  flex-shrink: 0;
  animation: avatarPulse 3s ease-in-out infinite;
}
@keyframes avatarPulse {
  0%,100%{box-shadow:0 0 30px rgba(0,245,255,0.4),0 0 60px rgba(191,0,255,0.2)}
  50%{box-shadow:0 0 50px rgba(0,245,255,0.7),0 0 100px rgba(191,0,255,0.4)}
}

.hero-name {
  font-family: 'Orbitron', monospace;
  font-size: 1.6rem; font-weight: 900;
  background: linear-gradient(90deg, var(--neon-cyan), var(--neon-pink));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.hero-sub { color: var(--text-dim); font-size: .85rem; margin-top: .3rem; }
.hero-badges-row { display: flex; gap: .5rem; margin-top: .6rem; flex-wrap: wrap; }
.hero-badge-pill {
  padding: .2rem .7rem; border-radius: 99px; font-size: .7rem; font-weight: 700;
  background: rgba(255,234,0,0.1); border: 1px solid rgba(255,234,0,0.3); color: var(--neon-yellow);
}

/* XP Bar hero */
.hero-xp-panel { min-width: 280px; }
.xp-pts-display {
  font-family: 'Orbitron', monospace;
  font-size: 2.5rem; font-weight: 900;
  color: var(--neon-cyan);
  text-shadow: 0 0 20px var(--neon-cyan);
  text-align: right;
}
.xp-pts-display small { font-size: 1rem; color: var(--text-dim); }
.xp-bar-wrap { margin-top: .6rem; }
.xp-bar-labels { display: flex; justify-content: space-between; font-size: .7rem; color: var(--text-dim); margin-bottom: .4rem; }
.xp-bar-track {
  height: 14px; border-radius: 99px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(0,245,255,0.1);
  overflow: hidden; position: relative;
}
.xp-bar-fill {
  height: 100%; border-radius: 99px;
  background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple), var(--neon-pink));
  box-shadow: 0 0 12px rgba(0,245,255,0.6);
  transition: width 1.5s cubic-bezier(.4,0,.2,1);
  position: relative;
}
.xp-bar-fill::after {
  content: '';
  position: absolute; top: 0; right: 0; bottom: 0; width: 20px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4));
  animation: shimmer 1.5s ease-in-out infinite;
}
@keyframes shimmer { 0%,100%{opacity:0} 50%{opacity:1} }

/* ═══════════════════════════════════════════════
   STAT CARDS ROW
═══════════════════════════════════════════════ */
.stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 1rem; margin-bottom: 1.5rem;
}
.stat-card {
  background: var(--dark-card);
  border: 1px solid var(--dark-border);
  border-radius: 16px;
  padding: 1.2rem 1rem;
  text-align: center;
  position: relative; overflow: hidden;
  transition: all .3s; cursor: default;
}
.stat-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
}
.stat-c1::before { background: linear-gradient(90deg, var(--neon-cyan), transparent); }
.stat-c2::before { background: linear-gradient(90deg, var(--neon-pink), transparent); }
.stat-c3::before { background: linear-gradient(90deg, var(--neon-green), transparent); }
.stat-c4::before { background: linear-gradient(90deg, var(--neon-yellow), transparent); }
.stat-c5::before { background: linear-gradient(90deg, var(--neon-purple), transparent); }
.stat-c6::before { background: linear-gradient(90deg, var(--neon-orange), transparent); }

.stat-card:hover { transform: translateY(-4px); border-color: rgba(0,245,255,0.3); }
.stat-icon { font-size: 1.8rem; margin-bottom: .4rem; }
.stat-val {
  font-family: 'Orbitron', monospace;
  font-size: 1.8rem; font-weight: 900; color: white;
  line-height: 1;
}
.stat-lbl { font-size: .65rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase; letter-spacing: .1em; margin-top: .3rem; }

/* ═══════════════════════════════════════════════
   MAIN GRID
═══════════════════════════════════════════════ */
.main-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: 1.25rem;
}
.main-grid.triple { grid-template-columns: 1fr 1fr 1fr; }
@media(max-width:900px){ .main-grid{grid-template-columns:1fr;} .main-grid.triple{grid-template-columns:1fr;} }
@media(min-width:900px) and (max-width:1100px){ .main-grid.triple{grid-template-columns:1fr 1fr;} }

.panel {
  background: var(--dark-card);
  border: 1px solid var(--dark-border);
  border-radius: 20px;
  overflow: hidden;
}
.panel-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 1.4rem;
  border-bottom: 1px solid var(--dark-border);
}
.panel-title {
  font-family: 'Orbitron', monospace;
  font-size: .85rem; font-weight: 700;
  color: var(--neon-cyan);
  letter-spacing: .05em;
}
.panel-body { padding: 1.25rem; }

/* ═══════════════════════════════════════════════
   XP ACTIONS — EARN BUTTONS
═══════════════════════════════════════════════ */
.xp-actions-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: .75rem;
}
.xp-btn {
  position: relative;
  padding: 1rem;
  border: none; border-radius: 14px;
  cursor: pointer;
  font-family: 'Exo 2', sans-serif;
  font-weight: 700; font-size: .82rem;
  color: white;
  transition: all .2s;
  overflow: hidden;
  display: flex; flex-direction: column; align-items: center; gap: .3rem;
  text-align: center;
}
.xp-btn::before {
  content: '';
  position: absolute; inset: 0;
  background: rgba(255,255,255,0);
  transition: background .2s;
}
.xp-btn:hover::before { background: rgba(255,255,255,0.08); }
.xp-btn:active { transform: scale(0.96); }
.xp-btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }

.xp-btn-icon { font-size: 1.8rem; }
.xp-btn-label { font-size: .75rem; color: rgba(255,255,255,0.8); }
.xp-btn-reward {
  font-family: 'Orbitron', monospace;
  font-size: .85rem; font-weight: 900;
  color: var(--neon-yellow);
  text-shadow: 0 0 10px var(--neon-yellow);
}

.btn-correct  { background: linear-gradient(135deg, #0d4f0d, #1a7a1a); border: 1px solid rgba(57,255,20,0.3); }
.btn-deck     { background: linear-gradient(135deg, #4f0d2e, #7a1a4d); border: 1px solid rgba(255,0,110,0.3); }
.btn-daily    { background: linear-gradient(135deg, #2a2a00, #4a4a00); border: 1px solid rgba(255,234,0,0.3); }
.btn-streak   { background: linear-gradient(135deg, #2a0a00, #5a1a00); border: 1px solid rgba(255,107,0,0.3); }

/* ═══════════════════════════════════════════════
   DAILY CHALLENGES
═══════════════════════════════════════════════ */
.challenge-list { display: flex; flex-direction: column; gap: .75rem; }
.challenge-item {
  display: flex; align-items: center; gap: .9rem;
  padding: .9rem 1rem;
  border-radius: 12px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  transition: all .2s; cursor: default;
}
.challenge-item.done { border-color: rgba(57,255,20,0.2); background: rgba(57,255,20,0.03); }
.challenge-item.done .ch-name { text-decoration: line-through; color: var(--text-dim); }
.ch-icon { font-size: 1.4rem; flex-shrink: 0; }
.ch-info { flex: 1; }
.ch-name { font-size: .82rem; font-weight: 700; color: white; }
.ch-desc { font-size: .7rem; color: var(--text-dim); margin-top: .1rem; }
.ch-prog-wrap { margin-top: .4rem; }
.ch-prog-track { height: 4px; background: rgba(255,255,255,0.07); border-radius: 99px; overflow: hidden; }
.ch-prog-fill { height: 100%; border-radius: 99px; transition: width 1s ease; }
.ch-reward {
  font-family: 'Orbitron', monospace;
  font-size: .75rem; font-weight: 900;
  color: var(--neon-yellow); white-space: nowrap;
}
.ch-done-icon { font-size: 1.2rem; }

/* ═══════════════════════════════════════════════
   LEADERBOARD
═══════════════════════════════════════════════ */
.leader-list { display: flex; flex-direction: column; gap: .5rem; }
.leader-row {
  display: flex; align-items: center; gap: .8rem;
  padding: .75rem .9rem;
  border-radius: 12px;
  border: 1px solid transparent;
  transition: all .2s;
}
.leader-row.is-me { background: rgba(0,245,255,0.05); border-color: rgba(0,245,255,0.2); }
.leader-row:hover { background: rgba(255,255,255,0.03); }
.lr-rank {
  font-family: 'Orbitron', monospace;
  font-size: .9rem; font-weight: 900;
  width: 28px; text-align: center; flex-shrink: 0;
}
.r1{color:#ffd700;text-shadow:0 0 10px #ffd700}
.r2{color:#c0c0c0}
.r3{color:#cd7f32}
.lr-av {
  width: 32px; height: 32px; border-radius: 8px;
  background: linear-gradient(135deg, var(--neon-purple), var(--neon-cyan));
  display: flex; align-items: center; justify-content: center;
  font-size: .9rem; font-weight: 800; color: white;
  flex-shrink: 0;
}
.lr-name { flex: 1; font-size: .8rem; font-weight: 700; color: rgba(255,255,255,0.85); }
.lr-lvl { font-size: .65rem; color: var(--text-dim); }
.lr-pts {
  font-family: 'Orbitron', monospace;
  font-size: .78rem; font-weight: 900; color: var(--neon-cyan);
}

/* ═══════════════════════════════════════════════
   MINI GAME — MEMORY
═══════════════════════════════════════════════ */
.memory-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: .5rem;
}
.mem-card {
  aspect-ratio: 1;
  border-radius: 10px;
  cursor: pointer;
  position: relative;
  transform-style: preserve-3d;
  transition: transform .4s;
}
.mem-card.flipped { transform: rotateY(180deg); }
.mem-card.matched { transform: rotateY(180deg); }
.mem-card.matched .mem-back { background: rgba(57,255,20,0.15); border-color: rgba(57,255,20,0.4); }
.mem-face, .mem-back {
  position: absolute; inset: 0;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem;
  backface-visibility: hidden;
}
.mem-face {
  background: linear-gradient(135deg, rgba(0,245,255,0.1), rgba(191,0,255,0.1));
  border: 1px solid rgba(0,245,255,0.2);
  font-size: 1.1rem; color: rgba(0,245,255,0.4);
}
.mem-back {
  background: linear-gradient(135deg, rgba(0,245,255,0.08), rgba(191,0,255,0.08));
  border: 1px solid rgba(191,0,255,0.3);
  transform: rotateY(180deg);
}
.mem-stats-row { display: flex; gap: 1rem; margin-bottom: 1rem; }
.mem-stat-pill {
  flex: 1; text-align: center; padding: .5rem;
  background: rgba(255,255,255,0.03); border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.06);
}
.mem-stat-val { font-family: 'Orbitron', monospace; font-size: 1rem; font-weight: 900; color: var(--neon-cyan); }
.mem-stat-lbl { font-size: .6rem; color: var(--text-dim); text-transform: uppercase; }

/* ═══════════════════════════════════════════════
   MINI GAME — SPEED QUIZ
═══════════════════════════════════════════════ */
.quiz-question {
  font-size: 1rem; font-weight: 700; color: white;
  text-align: center; margin-bottom: 1.2rem;
  min-height: 60px; display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,0.03); border-radius: 12px;
  padding: 1rem; border: 1px solid rgba(255,255,255,0.06);
}
.quiz-opts { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; margin-bottom: 1rem; }
.quiz-opt {
  padding: .75rem; border-radius: 10px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.85); font-size: .82rem; font-weight: 600;
  cursor: pointer; transition: all .2s; text-align: center;
  font-family: 'Exo 2', sans-serif;
}
.quiz-opt:hover:not(:disabled) { background: rgba(0,245,255,0.08); border-color: var(--neon-cyan); color: var(--neon-cyan); }
.quiz-opt.correct { background: rgba(57,255,20,0.1); border-color: var(--neon-green); color: var(--neon-green); }
.quiz-opt.wrong   { background: rgba(255,0,110,0.1);  border-color: var(--neon-pink);  color: var(--neon-pink);  }
.quiz-opt:disabled { cursor: default; }
.quiz-timer-bar { height: 6px; border-radius: 99px; background: rgba(255,255,255,0.07); overflow: hidden; margin-bottom: .8rem; }
.quiz-timer-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--neon-green), var(--neon-yellow), var(--neon-pink)); transition: width .1s linear; }
.quiz-score-row { display: flex; justify-content: space-between; font-size: .75rem; color: var(--text-dim); font-family: 'Orbitron', monospace; }

/* ═══════════════════════════════════════════════
   BADGES PANEL
═══════════════════════════════════════════════ */
.badges-showcase { display: flex; flex-wrap: wrap; gap: .6rem; }
.badge-chip {
  display: flex; align-items: center; gap: .4rem;
  padding: .45rem .9rem; border-radius: 99px;
  font-size: .75rem; font-weight: 700;
  transition: all .2s;
}
.badge-chip.earned {
  background: rgba(251,191,36,0.12);
  border: 1px solid rgba(251,191,36,0.4);
  color: #fde68a;
  box-shadow: 0 0 12px rgba(251,191,36,0.15);
}
.badge-chip.locked {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.25);
}
.badge-chip.earned:hover { box-shadow: 0 0 20px rgba(251,191,36,0.3); transform: scale(1.05); }

/* All badges grid */
.all-badges-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
  gap: .8rem;
}
.badge-full-card {
  padding: 1rem;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,0.08);
  transition: all .2s;
  position: relative; overflow: hidden;
}
.badge-full-card.earned-b {
  background: linear-gradient(135deg, rgba(251,191,36,0.08), rgba(245,158,11,0.04));
  border-color: rgba(251,191,36,0.3);
}
.badge-full-card.locked-b {
  background: rgba(255,255,255,0.02);
  opacity: 0.6;
}
.badge-full-card:hover { transform: translateY(-3px); }
.badge-full-card .bf-icon { font-size: 1.8rem; margin-bottom: .5rem; }
.badge-full-card .bf-name { font-size: .8rem; font-weight: 800; color: white; margin-bottom: .25rem; }
.badge-full-card .bf-desc { font-size: .68rem; color: var(--text-dim); line-height: 1.4; }
.badge-full-card .bf-status {
  font-size: .65rem; font-weight: 700;
  margin-top: .5rem; text-transform: uppercase; letter-spacing: .06em;
}
.bf-status.e { color: #fbbf24; }
.bf-status.l { color: rgba(255,255,255,0.2); }

/* ═══════════════════════════════════════════════
   XP FLOATERS & PARTICLES
═══════════════════════════════════════════════ */
.xp-floater {
  position: fixed;
  font-family: 'Orbitron', monospace;
  font-size: 1.4rem; font-weight: 900;
  color: var(--neon-cyan);
  text-shadow: 0 0 20px var(--neon-cyan);
  pointer-events: none; z-index: 9999;
  animation: floatUp 1.5s ease-out forwards;
}
@keyframes floatUp {
  0%   { opacity: 1; transform: translateY(0) scale(1); }
  100% { opacity: 0; transform: translateY(-120px) scale(1.4); }
}

/* ═══════════════════════════════════════════════
   LEVEL UP OVERLAY
═══════════════════════════════════════════════ */
#levelup-overlay {
  display: none;
  position: fixed; inset: 0; z-index: 9998;
  background: rgba(0,0,0,0.85);
  align-items: center; justify-content: center;
  backdrop-filter: blur(8px);
}
#levelup-overlay.show { display: flex; }
.levelup-box {
  text-align: center; padding: 3rem;
  background: var(--dark-card);
  border: 2px solid var(--neon-cyan);
  border-radius: 28px;
  box-shadow: 0 0 80px rgba(0,245,255,0.3), 0 0 160px rgba(191,0,255,0.2);
  animation: levelupBounce .5s cubic-bezier(.36,.07,.19,.97);
  max-width: 400px; width: 90%;
}
@keyframes levelupBounce {
  0%{transform:scale(0.5) rotate(-5deg);opacity:0}
  60%{transform:scale(1.1) rotate(1deg)}
  100%{transform:scale(1) rotate(0);opacity:1}
}
.levelup-emoji { font-size: 4rem; animation: emojiSpin 1s ease-out; display: block; margin-bottom: 1rem; }
@keyframes emojiSpin { 0%{transform:rotate(-30deg) scale(0)} 100%{transform:rotate(0) scale(1)} }
.levelup-title {
  font-family: 'Orbitron', monospace;
  font-size: 1rem; color: var(--text-dim); margin-bottom: .4rem; text-transform: uppercase; letter-spacing: .1em;
}
.levelup-num {
  font-family: 'Orbitron', monospace;
  font-size: 4rem; font-weight: 900;
  background: linear-gradient(90deg, var(--neon-cyan), var(--neon-pink));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  line-height: 1;
}
.levelup-sub { color: var(--text-dim); font-size: .9rem; margin: 1rem 0; }
.levelup-close {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .75rem 2rem; border-radius: 12px;
  background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
  border: none; color: var(--dark-bg); font-family: 'Exo 2', sans-serif;
  font-weight: 800; font-size: .9rem; cursor: pointer;
  box-shadow: 0 0 20px rgba(0,245,255,0.3);
}

/* ═══════════════════════════════════════════════
   BADGE TOAST
═══════════════════════════════════════════════ */
#badge-toast-area { position: fixed; top: 1.5rem; right: 1.5rem; z-index: 9990; display: flex; flex-direction: column; gap: .7rem; }
.badge-toast {
  display: flex; align-items: center; gap: .8rem;
  padding: 1rem 1.4rem;
  background: var(--dark-card);
  border: 1px solid rgba(251,191,36,0.5);
  border-radius: 14px;
  box-shadow: 0 0 30px rgba(251,191,36,0.2);
  animation: toastIn .4s cubic-bezier(.36,.07,.19,.97) forwards;
  max-width: 320px;
}
@keyframes toastIn { 0%{transform:translateX(100px);opacity:0} 100%{transform:translateX(0);opacity:1} }
.bt-icon { font-size: 1.8rem; }
.bt-title { font-size: .7rem; font-weight: 700; color: var(--neon-yellow); text-transform: uppercase; letter-spacing: .1em; }
.bt-name  { font-size: .9rem; font-weight: 800; color: white; }

/* ═══════════════════════════════════════════════
   ACTIVITY FEED
═══════════════════════════════════════════════ */
.activity-feed { display: flex; flex-direction: column; gap: .6rem; max-height: 280px; overflow-y: auto; }
.activity-feed::-webkit-scrollbar { width: 4px; }
.activity-feed::-webkit-scrollbar-track { background: transparent; }
.activity-feed::-webkit-scrollbar-thumb { background: rgba(0,245,255,0.2); border-radius: 99px; }
.act-item {
  display: flex; align-items: center; gap: .7rem;
  padding: .6rem .8rem;
  border-radius: 10px;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.04);
  animation: actSlide .3s ease-out;
}
@keyframes actSlide { 0%{opacity:0;transform:translateX(-20px)} 100%{opacity:1;transform:translateX(0)} }
.act-icon { font-size: 1rem; flex-shrink: 0; }
.act-text { font-size: .78rem; color: rgba(255,255,255,0.75); flex: 1; }
.act-xp {
  font-family: 'Orbitron', monospace;
  font-size: .7rem; font-weight: 900; color: var(--neon-cyan);
  white-space: nowrap;
}
.act-time { font-size: .65rem; color: var(--text-dim); }

/* ═══════════════════════════════════════════════
   STREAK CALENDAR
═══════════════════════════════════════════════ */
.streak-cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.streak-day {
  aspect-ratio: 1; border-radius: 6px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  display: flex; align-items: center; justify-content: center;
  font-size: .6rem; color: var(--text-dim);
  position: relative;
}
.streak-day.active {
  background: rgba(255,107,0,0.2);
  border-color: rgba(255,107,0,0.4);
}
.streak-day.active::after {
  content: '🔥';
  position: absolute; font-size: .7rem;
}
.streak-day.today {
  border-color: var(--neon-cyan);
  box-shadow: 0 0 8px rgba(0,245,255,0.3);
}

/* ═══════════════════════════════════════════════
   XP ROULETTE
═══════════════════════════════════════════════ */
.roulette-wheel {
  width: 180px; height: 180px; margin: 0 auto;
  border-radius: 50%;
  background: conic-gradient(
    var(--neon-pink)   0deg 45deg,
    var(--neon-cyan)   45deg 90deg,
    var(--neon-yellow) 90deg 135deg,
    var(--neon-green)  135deg 180deg,
    var(--neon-purple) 180deg 225deg,
    var(--neon-orange) 225deg 270deg,
    var(--neon-pink)   270deg 315deg,
    var(--neon-cyan)   315deg 360deg
  );
  border: 4px solid rgba(255,255,255,0.2);
  box-shadow: 0 0 30px rgba(0,245,255,0.2);
  transition: transform 3s cubic-bezier(.17,.67,.12,.99);
  position: relative;
}
.roulette-wheel::after {
  content: '⬆️';
  position: absolute; top: -20px; left: 50%; transform: translateX(-50%);
  font-size: 1.2rem;
}
.roulette-center {
  position: absolute; inset: 20%; border-radius: 50%;
  background: var(--dark-card);
  border: 3px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Orbitron', monospace;
  font-size: .7rem; font-weight: 900; color: var(--neon-cyan);
}
.roulette-labels {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: .4rem; margin-top: 1rem;
}
.rl-chip {
  text-align: center; padding: .3rem;
  border-radius: 8px; font-size: .65rem; font-weight: 800;
  font-family: 'Orbitron', monospace;
}

/* ═══════════════════════════════════════════════
   BUTTONS GENERIC
═══════════════════════════════════════════════ */
.neon-btn {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .6rem 1.2rem; border-radius: 10px; border: none;
  font-family: 'Exo 2', sans-serif; font-size: .82rem; font-weight: 700;
  cursor: pointer; transition: all .2s; text-decoration: none;
}
.neon-btn:hover { transform: translateY(-2px); }
.neon-btn:active { transform: scale(0.97); }
.neon-btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }

.nb-cyan   { background: rgba(0,245,255,0.1); border: 1px solid rgba(0,245,255,0.4); color: var(--neon-cyan); }
.nb-cyan:hover { background: rgba(0,245,255,0.18); box-shadow: 0 0 16px rgba(0,245,255,0.25); }
.nb-pink   { background: rgba(255,0,110,0.1); border: 1px solid rgba(255,0,110,0.4); color: var(--neon-pink); }
.nb-green  { background: rgba(57,255,20,0.1); border: 1px solid rgba(57,255,20,0.4); color: var(--neon-green); }
.nb-yellow { background: rgba(255,234,0,0.1); border: 1px solid rgba(255,234,0,0.4); color: var(--neon-yellow); }
.nb-solid  { background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple)); color: #000; font-weight: 800; box-shadow: 0 0 20px rgba(0,245,255,0.3); }

/* ═══════════════════════════════════════════════
   CONFETTI CANVAS
═══════════════════════════════════════════════ */
#confetti-canvas {
  position: fixed; inset: 0; z-index: 9997;
  pointer-events: none;
  display: none;
}
#confetti-canvas.show { display: block; }

/* ═══════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════ */
@media(max-width:600px) {
  .hero-inner { flex-direction: column; }
  .hero-xp-panel { min-width: unset; width: 100%; }
  .xp-pts-display { text-align: left; }
  .stats-row { grid-template-columns: repeat(3, 1fr); }
}

/* ═══════════════════════════════════════════════
   UTILITY
═══════════════════════════════════════════════ */
.full-width { grid-column: 1 / -1; }
.text-center { text-align: center; }
.mt-1 { margin-top: .5rem; }
.mt-2 { margin-top: 1rem; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.gap-1 { gap: .5rem; }
.gap-2 { gap: 1rem; }
.neon-text { color: var(--neon-cyan); text-shadow: 0 0 10px var(--neon-cyan); }
.section-label {
  font-size: .65rem; text-transform: uppercase; letter-spacing: .12em;
  color: var(--text-dim); font-weight: 700; margin-bottom: .8rem;
}
</style>
{% endblock %}

{% block body %}
<canvas id="confetti-canvas"></canvas>
<div id="levelup-overlay">
  <div class="levelup-box">
    <span class="levelup-emoji">🚀</span>
    <div class="levelup-title">LEVEL UP!</div>
    <div class="levelup-num" id="lu-num">2</div>
    <div class="levelup-sub">You reached a new level! Keep going! 🔥</div>
    <button class="levelup-close" onclick="closeLevelUp()">⚡ CONTINUE</button>
  </div>
</div>
<div id="badge-toast-area"></div>

<div class="arena-wrap">

  {# ── TOP NAV ── #}
  <div class="top-nav">
    <div class="nav-logo">⚡ XP <span>ARENA</span></div>
    <a href="{{ path('app_revisions') }}" class="back-link">← Back to Revisions</a>
  </div>

  {# ── HERO BANNER ── #}
  <div class="hero-banner">
    <div class="hero-inner">
      <div class="hero-left">
        <div class="avatar-circle">🎓</div>
        <div>
          <div class="hero-name" id="hero-name">Level <span id="cur-level">{{ gamification.level }}</span> — Your Arena</div>
          <div class="hero-sub">
            🔥 <span id="cur-streak">{{ gamification.streak }}</span> day streak &nbsp;·&nbsp;
            🏆 Rank #<span id="cur-rank">{{ userRank }}</span> &nbsp;·&nbsp;
            🎖 <span id="cur-badges">{{ gamification.badges|length }}</span> badge{{ gamification.badges|length != 1 ? 's' : '' }}
          </div>
          {% if gamification.badges|length > 0 %}
          <div class="hero-badges-row">
            {% for badge in gamification.badges|slice(0,3) %}
            <span class="hero-badge-pill">{{ badge.name }}</span>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
      <div class="hero-xp-panel">
        <div class="xp-pts-display" id="xp-display">{{ gamification.points }} <small>XP</small></div>
        <div class="xp-bar-wrap">
          <div class="xp-bar-labels">
            <span>Lv <span id="lv-cur">{{ gamification.level }}</span></span>
            <span id="xp-prog-txt">{{ gamification.levelProgress }}% → Lv<span id="lv-next">{{ gamification.level + 1 }}</span></span>
          </div>
          <div class="xp-bar-track">
            <div class="xp-bar-fill" id="xp-bar-fill" style="width:{{ progressPercent }}%"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ── STAT CARDS ── #}
  <div class="stats-row">
    <div class="stat-card stat-c1">
      <div class="stat-icon">💎</div>
      <div class="stat-val" id="s-xp">{{ gamification.points }}</div>
      <div class="stat-lbl">Total XP</div>
    </div>
    <div class="stat-card stat-c2">
      <div class="stat-icon">⭐</div>
      <div class="stat-val" id="s-lvl">{{ gamification.level }}</div>
      <div class="stat-lbl">Level</div>
    </div>
    <div class="stat-card stat-c3">
      <div class="stat-icon">🔥</div>
      <div class="stat-val" id="s-streak">{{ gamification.streak }}</div>
      <div class="stat-lbl">Day Streak</div>
    </div>
    <div class="stat-card stat-c4">
      <div class="stat-icon">🏆</div>
      <div class="stat-val">#<span id="s-rank">{{ userRank }}</span></div>
      <div class="stat-lbl">Rank</div>
    </div>
    <div class="stat-card stat-c5">
      <div class="stat-icon">📚</div>
      <div class="stat-val" id="s-decks">{{ gamification.totalDecksCompleted }}</div>
      <div class="stat-lbl">Decks Done</div>
    </div>
    <div class="stat-card stat-c6">
      <div class="stat-icon">✅</div>
      <div class="stat-val" id="s-correct">{{ gamification.totalCorrectAnswers }}</div>
      <div class="stat-lbl">Correct Ans.</div>
    </div>
  </div>

  {# ── ROW 1: XP ACTIONS + DAILY CHALLENGES ── #}
  <div class="main-grid" style="margin-bottom:1.25rem;">

    {# XP EARN BUTTONS #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">⚡ EARN XP</span>
        <span style="font-size:.7rem;color:var(--text-dim);">Click to gain points!</span>
      </div>
      <div class="panel-body">
        <div class="xp-actions-grid">
          <button class="xp-btn btn-correct" id="btn-correct" onclick="earnCorrectAnswer()">
            <span class="xp-btn-icon">🎯</span>
            <span style="font-size:.8rem;font-weight:800;">Correct Answer</span>
            <span class="xp-btn-label">Simulate a right answer</span>
            <span class="xp-btn-reward">+10 XP</span>
          </button>
          <button class="xp-btn btn-deck" id="btn-deck" onclick="earnDeckCompleted()">
            <span class="xp-btn-icon">📚</span>
            <span style="font-size:.8rem;font-weight:800;">Complete Deck</span>
            <span class="xp-btn-label">Finish a study deck</span>
            <span class="xp-btn-reward">+50 XP</span>
          </button>
          <button class="xp-btn btn-daily" id="btn-daily" onclick="earnDailyRevision()">
            <span class="xp-btn-icon">📅</span>
            <span style="font-size:.8rem;font-weight:800;">Daily Revision</span>
            <span class="xp-btn-label">1x per day bonus</span>
            <span class="xp-btn-reward">+15 XP</span>
          </button>
          <button class="xp-btn btn-streak" id="btn-streak" onclick="doStreak10()">
            <span class="xp-btn-icon">🔥</span>
            <span style="font-size:.8rem;font-weight:800;">Streak Bonus</span>
            <span class="xp-btn-label">10 correct in a row</span>
            <span class="xp-btn-reward">+100 XP</span>
          </button>
        </div>

        {# Cooldown indicator #}
        <div style="margin-top:1rem;padding:.7rem;background:rgba(255,255,255,0.02);border-radius:10px;border:1px solid rgba(255,255,255,0.05);">
          <div style="font-size:.7rem;color:var(--text-dim);margin-bottom:.4rem;font-weight:600;">⏱️ COOLDOWNS</div>
          <div style="display:flex;flex-direction:column;gap:.3rem;" id="cooldown-list">
            <div style="display:flex;justify-content:space-between;font-size:.72rem;">
              <span style="color:rgba(255,255,255,0.6);">Correct Answer</span>
              <span style="color:var(--neon-green);font-family:'Orbitron',monospace;" id="cd-correct">READY</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:.72rem;">
              <span style="color:rgba(255,255,255,0.6);">Daily Revision</span>
              <span id="cd-daily" style="font-family:'Orbitron',monospace;color:var(--neon-green);">READY</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {# DAILY CHALLENGES #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">🎯 DAILY CHALLENGES</span>
        <span style="font-size:.7rem;color:var(--text-dim);" id="challenge-timer">Resets at midnight</span>
      </div>
      <div class="panel-body">
        <div class="challenge-list" id="challenge-list">
          <!-- injected by JS -->
        </div>
      </div>
    </div>
  </div>

  {# ── ROW 2: MEMORY GAME + SPEED QUIZ + LEADERBOARD ── #}
  <div class="main-grid triple" style="margin-bottom:1.25rem;">

    {# MEMORY GAME #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">🃏 MEMORY GAME</span>
        <button class="neon-btn nb-cyan" style="padding:.3rem .8rem;font-size:.7rem;" onclick="initMemory()">↺ Reset</button>
      </div>
      <div class="panel-body">
        <div class="mem-stats-row">
          <div class="mem-stat-pill">
            <div class="mem-stat-val" id="mem-moves">0</div>
            <div class="mem-stat-lbl">Moves</div>
          </div>
          <div class="mem-stat-pill">
            <div class="mem-stat-val" id="mem-pairs">0/8</div>
            <div class="mem-stat-lbl">Pairs</div>
          </div>
          <div class="mem-stat-pill">
            <div class="mem-stat-val" id="mem-timer">0s</div>
            <div class="mem-stat-lbl">Time</div>
          </div>
        </div>
        <div class="memory-grid" id="memory-grid"></div>
        <div style="font-size:.72rem;color:var(--text-dim);margin-top:.7rem;text-align:center;">
          🏆 Complete to earn <strong style="color:var(--neon-yellow);">+30 XP</strong>
        </div>
      </div>
    </div>

    {# SPEED QUIZ #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">⚡ SPEED QUIZ</span>
        <div style="display:flex;gap:.4rem;align-items:center;">
          <span style="font-size:.7rem;color:var(--text-dim);">Q <span id="qz-num">1</span>/10</span>
          <span style="font-family:'Orbitron',monospace;font-size:.7rem;color:var(--neon-cyan);" id="qz-score-top">0pts</span>
        </div>
      </div>
      <div class="panel-body">
        <div class="quiz-timer-bar">
          <div class="quiz-timer-fill" id="qz-timer-bar" style="width:100%"></div>
        </div>
        <div class="quiz-question" id="qz-question">Press START to play!</div>
        <div class="quiz-opts" id="qz-opts">
          <button class="quiz-opt" onclick="startQuiz()" style="grid-column:1/-1;padding:1.2rem;font-size:1rem;">🚀 START QUIZ</button>
        </div>
        <div class="quiz-score-row">
          <span>⏱ <span id="qz-time">10</span>s</span>
          <span>✅ <span id="qz-correct">0</span> correct</span>
          <span>🔥 Streak <span id="qz-streak">0</span></span>
        </div>
      </div>
    </div>

    {# LEADERBOARD #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">🥇 LEADERBOARD</span>
        <button class="neon-btn nb-cyan" style="padding:.3rem .8rem;font-size:.7rem;" onclick="refreshLeaderboard()">↺</button>
      </div>
      <div class="panel-body" style="padding:.75rem;">
        <div class="leader-list" id="leaderboard-list">
          {% for item in leaderboard %}
          {% set rank = loop.index %}
          <div class="leader-row {{ item.user == app.user ? 'is-me' : '' }}">
            <div class="leader-rank {{ rank == 1 ? 'r1' : (rank == 2 ? 'r2' : (rank == 3 ? 'r3' : '')) }}">
              {{ rank == 1 ? '🥇' : (rank == 2 ? '🥈' : (rank == 3 ? '🥉' : rank)) }}
            </div>
            <div class="lr-av">{{ item.user.email|slice(0,1)|upper }}</div>
            <div>
              <div class="lr-name">
                {{ item.user.email|slice(0, 18) }}{% if item.user.email|length > 18 %}…{% endif %}
                {% if item.user == app.user %}<span style="color:var(--neon-cyan);font-size:.65rem;"> (you)</span>{% endif %}
              </div>
              <div class="lr-lvl">Level {{ item.level }}</div>
            </div>
            <div class="lr-pts">{{ item.points }}</div>
          </div>
          {% else %}
          <div style="text-align:center;padding:2rem;color:var(--text-dim);font-size:.85rem;">
            Be the first! Earn XP now 🚀
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  {# ── ROW 3: XP ROULETTE + STREAK CALENDAR + ACTIVITY ── #}
  <div class="main-grid triple" style="margin-bottom:1.25rem;">

    {# XP ROULETTE #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">🎰 XP ROULETTE</span>
        <span style="font-size:.65rem;color:var(--text-dim);">1x / day</span>
      </div>
      <div class="panel-body text-center">
        <div style="position:relative;display:inline-block;margin-bottom:1rem;">
          <div class="roulette-wheel" id="roulette-wheel">
            <div class="roulette-center" id="roulette-center">SPIN</div>
          </div>
        </div>
        <div class="roulette-labels">
          <div class="rl-chip" style="background:rgba(255,0,110,0.15);color:var(--neon-pink);">+5</div>
          <div class="rl-chip" style="background:rgba(0,245,255,0.15);color:var(--neon-cyan);">+10</div>
          <div class="rl-chip" style="background:rgba(255,234,0,0.15);color:var(--neon-yellow);">+25</div>
          <div class="rl-chip" style="background:rgba(57,255,20,0.15);color:var(--neon-green);">+50</div>
          <div class="rl-chip" style="background:rgba(191,0,255,0.15);color:var(--neon-purple);">+15</div>
          <div class="rl-chip" style="background:rgba(255,107,0,0.15);color:var(--neon-orange);">+30</div>
          <div class="rl-chip" style="background:rgba(255,0,110,0.15);color:var(--neon-pink);">+5</div>
          <div class="rl-chip" style="background:rgba(255,234,0,0.15);color:var(--neon-yellow);">⭐</div>
        </div>
        <button class="neon-btn nb-solid mt-2" id="spin-btn" onclick="spinRoulette()" style="width:100%;justify-content:center;margin-top:.8rem;">
          🎰 SPIN!
        </button>
      </div>
    </div>

    {# STREAK CALENDAR #}
    <div class="panel">
      <div class="panel-header">
        <span class="panel-title">🔥 STREAK CALENDAR</span>
        <span style="font-family:'Orbitron',monospace;font-size:.75rem;color:var(--neon-orange);" id="streak-count">{{ gamification.streak }} days</span>
      </div>
      <div class="panel-body">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.8rem;">
          <span style="font-size:.7rem;color:var(--text-dim);">Last 28 days</span>
          <span style="font-size:.7rem;color:var(--neon-orange);">Best: {{ gamification.streak }} 🔥</span>
        </div>
        <div class="streak-cal" id="streak-cal"></div>
        <div style="display:flex;gap:.5rem;margin-top:.8rem;font-size:.65rem;color:var(--text-dim);">
          <span style="display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;background:rgba(255,107,0,0.3);border-radius:3px;display:inline-block;"></span> Inactive</span>
          <span style="display:flex;align-items:center;gap:.3rem;"><span style="width:10px;height:10px;background:rgba(255,107,0,0.8);border-radius:3px;display:inline-block;"></span> Active</span>
