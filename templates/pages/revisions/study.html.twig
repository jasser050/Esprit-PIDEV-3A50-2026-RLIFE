const FC=[{% for fc in flashcards %}{id:{{ fc.id }},t:{{ fc.titre|default('Untitled')|json_encode|raw }},q:{{ fc.question|json_encode|raw }},a:{{ fc.reponse|json_encode|raw }}}{% if not loop.last %},{% endif %}{% endfor %}];
const CSRF='{{ csrf_token("analyse_vocal") }}';
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;

let ci=0,rec=null,isR=false,tr='',scores={},ansOn=false;
let avSpeaking=false,avTimeout=null;

/* ════════════════════════════════════════
   AVATAR ENGINE
════════════════════════════════════════ */
const AV_PHRASES = {
  idle:      ["Hello! 👋 I'm ready to help you.", "Pick a flashcard and let's start! 📚", "I'm here to accompany you. 😊"],
  ready:     ["Great! 🎉 Read the question carefully.", "Take your time. 😌 I'm with you.", "Focus! You'll succeed. 💪"],
  listening: ["I'm listening carefully… 👂", "Speak clearly, I'm transcribing! 🎤", "Let's go! Give your answer."],
  thinking:  ["Hmm, analyzing your answer… 🤔", "Let me check that… ⏳", "AI is working for you. 🤖"],
  excellent: ["PERFECT! 🏆 You master this concept!", "Exceptional! 🌟 Score 10/10!", "Bravo bravo bravo! 🎊 You're at the top!"],
  good:      ["Very good! ✅ Nice answer!", "Good answer! 👍 Keep it up!", "Well done! 🎯 Some details to refine."],
  partial:   ["Not bad! ⚠️ You got the main points, but some details are missing.", "Medium… 💭 Try to remember the keywords.", "Courage! 💛 Reread the correct answer."],
  wrong:     ["Oh! ❌ That's not quite it.", "Don't get discouraged! 💪 The next one will be the right one.", "Start over, you can do it! 📖"],
  motivate:  [
    "Each mastered flashcard is one more neuron! 🧠",
    "Champions review even when it's hard! 🥊",
    "You're closer to excellence than yesterday! 🚀",
    "Consistency beats talent. Keep going! ⭐",
    "Your brain loves spaced repetition! 🔄"
  ]
};

function rand(arr){ return arr[Math.floor(Math.random()*arr.length)]; }

function setAvatarState(state, customMsg = null) {
  const stage  = document.getElementById('av-stage');
  const status = document.getElementById('av-status');
  const bubble = document.getElementById('av-bubble');

  // Remove all states
  stage.classList.remove('speaking','listening','thinking');
  status.classList.remove('speaking','listening','thinking','correct','wrong');
  bubble.classList.remove('speaking-bubble','listening-bubble','thinking-bubble','correct-bubble','wrong-bubble');

  const configs = {
    idle:      { stage:'',         status:'',         bubble:'',                  statusTxt:'😊 Ready to help' },
    speaking:  { stage:'speaking', status:'speaking', bubble:'speaking-bubble',   statusTxt:'🔊 Speaking…' },
    listening: { stage:'listening',status:'listening',bubble:'listening-bubble',  statusTxt:'👂 Listening…' },
    thinking:  { stage:'thinking', status:'thinking', bubble:'thinking-bubble',   statusTxt:'🤔 Analyzing…' },
    correct:   { stage:'speaking', status:'correct',  bubble:'correct-bubble',    statusTxt:'🏆 Excellent!' },
    good:      { stage:'speaking', status:'correct',  bubble:'correct-bubble',    statusTxt:'✅ Well done!' },
    partial:   { stage:'speaking', status:'',         bubble:'thinking-bubble',   statusTxt:'⚠️ Partially correct' },
    wrong:     { stage:'speaking', status:'wrong',    bubble:'wrong-bubble',      statusTxt:'❌ To review' },
  };

  const cfg = configs[state] || configs.idle;
  if (cfg.stage) stage.classList.add(cfg.stage);
  if (cfg.status) status.classList.add(cfg.status);
  if (cfg.bubble) bubble.classList.add(cfg.bubble);
  status.textContent = cfg.statusTxt;

  // Show message
  const msg = customMsg || rand(AV_PHRASES[state] || AV_PHRASES.idle);
  bubble.innerHTML = msg;

  avSpeaking = (state === 'speaking' || state === 'correct' || state === 'good' || state === 'wrong' || state === 'partial');
}

/* Avatar speaks via TTS */
function avatarSpeak(text, state = 'speaking') {
  if (!window.speechSynthesis) { setAvatarState(state, text); return; }

  window.speechSynthesis.cancel();
  setAvatarState(state, text);

  const u = new SpeechSynthesisUtterance(text);
  u.lang  = 'en-US';
  u.rate  = 0.92;
  u.pitch = 1.05;

  u.onstart = () => {
    avSpeaking = true;
    document.getElementById('av-stage').classList.add('speaking');
  };

  u.onend = u.onerror = () => {
    avSpeaking = false;
    document.getElementById('av-stage').classList.remove('speaking');
    setAvatarState('idle');
  };

  window.speechSynthesis.speak(u);
}

function avatarReadQuestion() {
  const f = FC[ci]; if (!f) return;
  const q = f.q.replace(/<[^>]+>/g,'');
  avatarSpeak('Here is the question: ' + q, 'speaking');
}

function avatarReadAnswer() {
  const f = FC[ci]; if (!f) return;
  const a = f.a.replace(/<[^>]+>/g,'');
  avatarSpeak('The correct answer is: ' + a, 'speaking');
  if (!ansOn) toggleAns();
}

function avatarMotivate() {
  const msg = rand(AV_PHRASES.motivate);
  avatarSpeak(msg, 'speaking');
}

function avatarGiveFeedback(score, feedback) {
  let state, prefix;
  if (score >= 9) { state = 'correct'; prefix = ''; }
  else if (score >= 7) { state = 'good'; prefix = ''; }
  else if (score >= 5) { state = 'partial'; prefix = ''; }
  else { state = 'wrong'; prefix = ''; }

  const scoreMsg = rand(AV_PHRASES[state === 'correct' ? 'excellent' : state === 'good' ? 'good' : state === 'partial' ? 'partial' : 'wrong']);
  const fullMsg  = scoreMsg + ' ' + feedback;

  setAvatarState(state, scoreMsg + '<br><span style="font-size:.8rem;font-style:italic;opacity:.8;">' + feedback + '</span>');
  setTimeout(() => avatarSpeak(scoreMsg + ' ' + feedback, state), 300);
}

/* ════════════════════════════════════════
   CARD LOGIC
════════════════════════════════════════ */
document.addEventListener('DOMContentLoaded', () => {
  if (FC.length) load(0);
  if (!SR) {
    const mz = document.getElementById('mz');
    if (mz) mz.innerHTML = '<div style="text-align:center;padding:1.5rem;background:var(--coral-lt);border-radius:14px;color:var(--coral-dk);font-weight:700;">❌ Voice recognition not supported.<br><span style="font-weight:400;font-size:.82rem;">Use Google Chrome or Microsoft Edge.</span></div>';
  }
  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.code === 'ArrowRight') nav(1);
    if (e.code === 'ArrowLeft')  nav(-1);
    if (e.code === 'KeyA') toggleAns();
    if (e.code === 'KeyS') avatarReadQuestion();
  });
  setTimeout(() => setAvatarState('idle', rand(AV_PHRASES.idle)), 500);
});

function load(i) {
  if (!FC.length) return;
  ci = ((i % FC.length) + FC.length) % FC.length;
  const f = FC[ci];
  document.getElementById('fc-q').textContent = f.q;
  document.getElementById('fc-a-t').textContent = f.a;
  ansOn = false;
  document.getElementById('fc-a').classList.remove('on');
  document.getElementById('btn-ans').textContent = '👁️ Show answer';
  const t = FC.length, pct = t > 1 ? Math.round((ci / (t - 1)) * 100) : 100;
  document.getElementById('pb').style.width = pct + '%';
  document.getElementById('pb-l').textContent = `Flashcard ${ci+1} / ${t}`;
  document.getElementById('pb-p').textContent = pct + '%';
  document.getElementById('ncnt').textContent = `${ci+1} / ${t}`;
  closeAI(); clearT();
  setAvatarState('idle', rand(AV_PHRASES.ready));
}

function nav(d) { load(ci + d); }
function jumpTo(i) { load(i); document.querySelector('.card').scrollIntoView({behavior:'smooth'}); }
function shuffleCards() {
  for (let i = FC.length-1; i > 0; i--) { const j = Math.floor(Math.random()*(i+1)); [FC[i],FC[j]]=[FC[j],FC[i]]; }
  load(0); toast('🔀 Shuffled!','inf');
}
function toggleAns() {
  ansOn = !ansOn;
  document.getElementById('fc-a').classList.toggle('on', ansOn);
  document.getElementById('btn-ans').textContent = ansOn ? '🙈 Hide' : '👁️ Show answer';
}

/* ════════════════════════════════════════
   RECORDING
════════════════════════════════════════ */
function toggleRec() {
  if (!SR) { toast('❌ Use Chrome or Edge', 'err'); return; }
  if (isR) { try { rec.stop(); } catch(e){} setRUI(false); isR = false; return; }

  rec = new SR(); rec.lang = 'en-US'; rec.continuous = false;
  rec.interimResults = true; rec.maxAlternatives = 1;

  rec.onresult = e => {
    let it='',fi='';
    for (let r of e.results) { if(r.isFinal) fi+=r[0].transcript; else it+=r[0].transcript; }
    if (fi) tr += fi;
    const tb = document.getElementById('tb');
    tb.textContent = (tr+it).trim() || '…'; tb.classList.add('on');
    if (tr.trim()) document.getElementById('btn-ai').style.display = '';
  };

  rec.onerror = e => {
    setRUI(false); isR = false;
    const msgs = {'not-allowed':'🔒 Microphone permission denied.','no-speech':'🔇 No speech detected.','audio-capture':'❌ Microphone not found.','network':'🌐 Network error.'};
    toast(msgs[e.error]||'❌ '+e.error,'err');
    setAvatarState('idle','❌ Microphone problem. Check permissions.');
  };

  rec.onend = () => {
    setRUI(false); isR = false;
    if (tr.trim()) {
      document.getElementById('btn-ai').style.display = '';
      document.getElementById('mst').textContent = '✅ Ready to analyze';
      setAvatarState('thinking', rand(AV_PHRASES.thinking));
    } else {
      document.getElementById('mst').textContent = '⚠️ Nothing captured';
      setAvatarState('idle','🔇 I didn\'t hear anything. Try again speaking louder!');
    }
  };

  tr = ''; const tb = document.getElementById('tb'); tb.textContent = '…'; tb.classList.add('on');
  document.getElementById('btn-ai').style.display = 'none';
  document.getElementById('mz').classList.add('active');
  setAvatarState('listening', rand(AV_PHRASES.listening));

  try { rec.start(); setRUI(true); }
  catch(e) { toast('❌ '+e.message,'err'); setRUI(false); setAvatarState('idle'); }
}

function setRUI(on) {
  isR = on;
  const b = document.getElementById('mb');
  b.className = 'mic-btn '+(on?'mr':'mi'); b.textContent = on?'⏹':'🎤';
  document.getElementById('mst').textContent = on?'🔴 Recording… speak!':'Press to answer verbally';
  document.getElementById('wf').classList.toggle('live',on);
  if (!on) document.getElementById('mz').classList.remove('active');
}

function clearT() {
  tr = ''; const tb = document.getElementById('tb'); tb.textContent = ''; tb.classList.remove('on');
  document.getElementById('btn-ai').style.display = 'none';
  document.getElementById('mst').textContent = 'Press to answer verbally';
  document.getElementById('mz').classList.remove('active','analysing');
}

/* ════════════════════════════════════════
   AI ANALYSIS
════════════════════════════════════════ */
async function analyseAI() {
  const f = FC[ci]; if (!f || !tr.trim()) { toast('❌ No answer','err'); return; }

  const btn = document.getElementById('btn-ai');
  btn.disabled = true; btn.innerHTML = '<div class="sp"></div> Analyzing…';
  document.getElementById('mz').classList.add('analysing');
  setAvatarState('thinking', rand(AV_PHRASES.thinking));

  try {
    const r = await fetch('/revisions/api/analyse-vocal', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body:JSON.stringify({flashcardId:f.id, reponseEtudiant:tr.trim(), _token:CSRF})
    });
    if (!r.ok) throw new Error('HTTP '+r.status);
    const d = await r.json();
    if (d.error) throw new Error(d.error);

    showAI(d,f);
    updStats(f.id,d.score);
    setTimeout(() => avatarGiveFeedback(d.score, d.feedback), 400);

  } catch(e) {
    toast('❌ AI Error: '+e.message,'err');
    setAvatarState('idle','❌ An error occurred. Check your connection.');
  } finally {
    btn.disabled = false; btn.innerHTML = '🤖 Analyze with AI';
    document.getElementById('mz').classList.remove('analysing');
  }
}

function showAI(d,f) {
  const s = d.score??0, arc = document.getElementById('sc-arc'), circ = 207.3;
  arc.style.strokeDashoffset = circ - (s/10)*circ;
  const col = s>=8?'#20C9A0':s>=5?'#FFD93D':'#FF6B6B'; arc.style.stroke = col;
  document.getElementById('sc-n').textContent = s;
  const v = s>=9?['🏆','Excellent!','#20C9A0']:s>=7?['✅','Good answer','#38BDF8']:s>=5?['⚠️','Partial','#FFD93D']:['❌','To review','#FF6B6B'];
  const ve = document.getElementById('sc-v'); ve.textContent=v[0]+' '+v[1]; ve.style.color=v[2];
  document.getElementById('ar-emo').textContent=v[0];
  const head=document.getElementById('ar-h'); head.style.background=s>=8?'var(--teal-lt)':s>=5?'var(--lemon-lt)':'var(--coral-lt)'; head.style.color=s>=8?'var(--teal-dk)':s>=5?'#7a6000':'var(--coral-dk)';
  document.getElementById('sc-t').textContent=d.feedback||'–';
  document.getElementById('cs').textContent=tr.trim();
  document.getElementById('cc').textContent=f.a;
  const days=s>=8?5:s>=6?3:s>=4?1:0, nd=new Date(); nd.setDate(nd.getDate()+days);
  document.getElementById('nr').textContent=days===0?'Today':nd.toLocaleDateString('en-US',{weekday:'short',day:'numeric',month:'short'});
  const p=document.getElementById('ar'); p.classList.add('on'); p.style.borderColor=col; p.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function closeAI() { document.getElementById('ar').classList.remove('on'); }
function updStats(id,s) {
  scores[id]=s; const v=Object.values(scores), avg=v.reduce((a,b)=>a+b,0)/v.length;
  document.getElementById('s-avg').textContent=avg.toFixed(1);
  document.getElementById('s-master').textContent=v.filter(x=>x>=8).length;
}
function selCnt(btn,n) { document.querySelectorAll('.cnt-btn').forEach(b=>b.classList.remove('sel')); btn.classList.add('sel'); document.getElementById('cnt-in').value=n; }

function toast(msg,type='inf') {
  const a=document.getElementById('ta'),t=document.createElement('div');
  t.className='toast t'+type;
  t.innerHTML=`<span>${msg}</span><button onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:.9rem;color:inherit;margin-left:auto;">✕</button>`;
  a.appendChild(t); setTimeout(()=>t.remove(),5000);
}

