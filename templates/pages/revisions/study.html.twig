{# ─── VOCAL MODE ─── #}
<div class="card">
  <div class="ch">
    <div class="chl"><div class="cico" style="background:var(--coral-lt);">🎙️</div><div class="ct">AI Voice Mode with RLIFE Assistant</div></div>
    <button class="btn bg btn-sm" onclick="shuffleCards()">🔀 Shuffle</button>
  </div>

  {% if flashcards is not empty %}
  <div class="vocal-layout">
    <div class="avatar-panel">
      <div class="avatar-stage" id="av-stage">
        <div class="avatar-ring"></div>
        <div class="avatar-ring"></div>
        <div class="avatar-ring"></div>
        <div class="avatar-face">
          <img id="av-img"
               src="https://api.dicebear.com/7.x/adventurer/svg?seed={{ app.user.email|default('rlife-assistant') }}&backgroundColor=ffdfbf,ffd5dc,d1d4f9,c0aede,b6e3f4"
               alt="Avatar"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
          <div class="av-bg" style="display:none;">🤖</div>
        </div>
        <div class="avatar-mouth-anim">
          <div class="mouth-bar mb1"></div><div class="mouth-bar mb2"></div>
          <div class="mouth-bar mb3"></div><div class="mouth-bar mb4"></div>
          <div class="mouth-bar mb5"></div><div class="mouth-bar mb6"></div>
        </div>
      </div>
      <div class="av-name">🤖 RLIFE Assistant</div>
      <div class="av-status" id="av-status">😊 Ready to help</div>
      <div class="av-bubble" id="av-bubble">
        Hello! 👋 I'm your study assistant. Press 🔊 to hear the question, then 🎤 to answer!
      </div>
      <div class="av-actions">
        <button class="btn bc btn-sm" style="justify-content:center;" onclick="avatarReadQuestion()">🔊 Read question</button>
        <button class="btn bt btn-sm" style="justify-content:center;" onclick="avatarReadAnswer()">📖 Read answer</button>
        <button class="btn bv btn-sm" style="justify-content:center;" onclick="avatarMotivate()">💪 Motivate me!</button>
      </div>
    </div>

    <div class="vocal-right">
      <div class="pb-wrap">
        <div class="pb-track"><div class="pb-fill" id="pb" style="width:0%"></div></div>
        <div class="pb-row"><span id="pb-l">Flashcard 1 / {{ flashcards|length }}</span><span id="pb-p">0%</span></div>
      </div>
      <div class="fc-show">
        <span class="fc-badge">❓ Question</span>
        <div class="fc-text" id="fc-q">Loading…</div>
      </div>
      <div style="display:flex;justify-content:center;">
        <button class="btn bt btn-sm" onclick="toggleAns()" id="btn-ans">👁️ Show answer</button>
      </div>
      <div class="fc-ans" id="fc-a">
        <div class="fca-l">✅ Correct answer</div>
        <div class="fca-t" id="fc-a-t">–</div>
      </div>
      <div class="nav-row">
        <button class="btn bg" onclick="nav(-1)">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          Prev
        </button>
        <div class="npill" id="ncnt">1 / {{ flashcards|length }}</div>
        <button class="btn bg" onclick="nav(1)">
          Next
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
      <div class="mic-zone" id="mz">
        <div class="mic-row">
          <button class="mic-btn mi" id="mb" onclick="toggleRec()">🎤</button>
          <div>
            <div class="mic-st" id="mst">Press to answer verbally</div>
            <div class="mic-hint">Chrome / Edge required</div>
            <div class="wf" id="wf"><div class="wb"></div><div class="wb"></div><div class="wb"></div><div class="wb"></div><div class="wb"></div><div class="wb"></div><div class="wb"></div><div class="wb"></div></div>
          </div>
        </div>
        <div class="t-box" id="tb"></div>
        <div style="display:flex;gap:.55rem;flex-wrap:wrap;justify-content:center;">
          <button class="btn bg btn-sm" onclick="clearT()">🗑️ Clear</button>
          <button class="btn bt btn-sm" id="btn-ai" style="display:none;" onclick="analyseAI()">🤖 Analyze with AI</button>
        </div>
      </div>
      <div class="ai-res" id="ar">
        <div class="air-h" id="ar-h"><span id="ar-emo" style="font-size:1.3rem;">🤖</span><span>AI Analysis Result</span><button onclick="closeAI()" class="btn bg btn-xs" style="margin-left:auto;">✕</button></div>
        <div class="air-b">
          <div class="sc-row">
            <div class="sc-ci">
              <svg class="sc-svg" viewBox="0 0 80 80"><circle cx="40" cy="40" r="33" stroke="var(--border)"/><circle cx="40" cy="40" r="33" id="sc-arc" stroke="#20C9A0" stroke-dasharray="207.3" stroke-dashoffset="207.3"/></svg>
              <div class="sc-big" id="sc-n">–</div><div class="sc-sub">/10</div>
            </div>
            <div><div class="sc-v" id="sc-v">–</div><div class="sc-t" id="sc-t">–</div></div>
          </div>
          <div class="cmp-grid">
            <div class="cmp cms"><div class="cl" style="color:var(--lilac);">🎤 Your answer</div><div class="cv" id="cs">–</div></div>
            <div class="cmp cmc"><div class="cl" style="color:var(--teal-dk);">✅ Correct answer</div><div class="cv" id="cc">–</div></div>
          </div>
          <div class="nxt">📅 Next review: <strong id="nr">–</strong></div>
          <div style="display:flex;gap:.55rem;flex-wrap:wrap;">
            <button class="btn bc btn-sm" onclick="nav(1);closeAI();">➡️ Next</button>
            <button class="btn bo btn-sm" onclick="closeAI();clearT();">🔁 Retry</button>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% else %}
  <div class="empty"><div class="eico">🎴</div><div class="etit">No flashcards yet</div><div class="esub">Generate some with AI below!</div></div>
  {% endif %}
</div>

{# ─── AI GENERATOR ─── #}
<div class="card">
  <div class="ch"><div class="chl"><div class="cico" style="background:var(--lemon-lt);">✨</div><div class="ct">Generate Flashcards with AI</div></div></div>
  <div class="gen-body">
    <form method="post" action="{{ path('app_deck_generate_flashcards', {id: deck.id}) }}">
      <div class="cnt-row">
        <span class="cnt-l">Count:</span>
        <div class="cnt-btns">
          {% for n in [1, 3, 5, 10] %}
          <button type="button" class="cnt-btn {% if n == 5 %}sel{% endif %}" onclick="selCnt(this,{{ n }})">{{ n }}</button>
          {% endfor %}
        </div>
        <input type="hidden" name="count" id="cnt-in" value="5">
      </div>
      <div class="gin-row">
        <input class="gin" type="text" name="theme" required placeholder="E.g. Krebs cycle, French Revolution, sorting algorithms…">
        <button type="submit" class="btn bc">✨ Generate</button>
      </div>
    </form>
    <p class="gen-tip">💡 AI generates multiple different flashcards on this theme.</p>
  </div>
</div>

{# ─── FC GRID ─── #}
<div class="card">
  <div class="ch">
    <div class="chl"><div class="cico" style="background:var(--teal-lt);">🗂️</div><div class="ct">All Flashcards</div></div>
    <a href="{{ path('app_flashcard_new', {deck_id: deck.id}) }}" class="btn bt btn-sm">+ Add</a>
  </div>
  {% if flashcards is empty %}
  <div class="empty"><div class="eico">🃏</div><div class="etit">No flashcards yet</div><div class="esub">Use the AI generator or create manually.</div><a href="{{ path('app_flashcard_new', {deck_id: deck.id}) }}" class="btn bc" style="margin-top:.5rem;">Create my first flashcard</a></div>
  {% else %}
  <div class="fcg">
    {% for flashcard in flashcards %}
    <div class="fcc">
      <div class="fcc-bar"></div>
      {% if flashcard.image %}<div class="fcc-img"><img src="{{ asset('uploads/flashcards/' ~ flashcard.image) }}" alt="{{ flashcard.titre }}"></div>{% endif %}
      <div class="fcc-bd">
        {% if flashcard.titre %}<div class="fcc-title">{{ flashcard.titre }}</div>{% endif %}
        <div class="fdiff">{% for i in 1..5 %}<span class="fds {% if i <= (flashcard.niveauDifficulte|default(0)) %}on{% endif %}">★</span>{% endfor %}</div>
        <div class="fl">Question</div><div class="fv">{{ flashcard.question }}</div>
        <div class="fl">Answer</div><div class="fv">{{ flashcard.reponse }}</div>
        <div class="fp-t"><div class="fp-f" style="width:{{ (flashcard.niveauDifficulte|default(0))*20 }}%"></div></div>
        <div class="fp-l">{{ (flashcard.niveauDifficulte|default(0))*20 }}% mastered</div>
        <div class="fcc-acts">
          <button class="fsb" onclick="jumpTo({{ loop.index0 }})" title="Study">🎙️</button>
          <a href="{{ path('app_flashcard_edit', {id: flashcard.id}) }}" class="btn bo btn-sm" style="flex:1;justify-content:center;">✏️</a>
          <form method="post" action="{{ path('app_flashcard_delete', {id: flashcard.id}) }}" onsubmit="return confirm('Delete?');" class="delb">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flashcard.id) }}">
            <button type="submit">🗑️</button>
          </form>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>

</div></div>
<div class="ta" id="ta"></div>

{# ══════════════════════════════════════════════
   🤖 CHATBOT FLOATING BUTTON + WINDOW
══════════════════════════════════════════════ #}
<button id="chatbot-fab" onclick="toggleChatbot()" aria-label="Chat with AI about this deck" title="AI Tutor – chat about this deck (Alt+C)">
  🤖
  <span id="fab-badge" class="fab-badge">0</span>
</button>

<div id="chatbot-window" role="dialog" aria-label="Deck AI Chatbot">
  <div id="cw-header">
    <div class="cw-av">
      <img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed" alt="AI Bot" onerror="this.style.display='none'">
    </div>
    <div class="cw-info">
      <div class="cw-name"><span class="cw-online"></span>RLIFE AI Tutor</div>
      <div class="cw-sub">Expert on: <strong>{{ deck.titre }}</strong></div>
    </div>
    <button class="cw-close" onclick="toggleChatbot()">✕</button>
  </div>
  <div id="cw-context">
    📚 {{ deck.matiere }} &nbsp;·&nbsp; 🎯 Level {{ deck.niveau }} &nbsp;·&nbsp; 🃏 {{ flashcards|length }} cards loaded
  </div>
  <div id="cw-msgs">
    <div class="msg-row">
      <div class="msg-av">
        <img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed" alt="AI">
      </div>
      <div>
        <div class="msg-bubble ai">
          👋 Salut ! Je suis ton tuteur IA pour <strong>{{ deck.titre }}</strong>.<br>
          J'ai lu les <strong>{{ flashcards|length }} flashcards</strong> du deck et je suis prêt !<br><br>
          Tu peux me demander de :
          <ul>
            <li>Expliquer n'importe quel concept</li>
            <li>Te faire passer un quiz 🎯</li>
            <li>Créer des astuces mémo 🧠</li>
            <li>Résumer les idées clés</li>
          </ul>
          Par quoi on commence ?
        </div>
        <div class="msg-time">maintenant</div>
      </div>
    </div>
  </div>
  <div id="cw-suggestions">
    <button class="sug-btn" onclick="cwSuggest('Quiz-moi sur les cartes les plus difficiles')">🎯 Quiz</button>
    <button class="sug-btn" onclick="cwSuggest('Résume les concepts clés de ce deck')">📋 Résumé</button>
    <button class="sug-btn" onclick="cwSuggest('Donne-moi des astuces mnémotechniques')">🧠 Mémo</button>
    <button class="sug-btn" onclick="cwSuggest('Sur quoi dois-je me concentrer en priorité ?')">🔥 Priorités</button>
  </div>
  <div id="cw-footer">
    <textarea id="cw-input"
      placeholder="Pose une question sur {{ deck.titre }}…"
      rows="1"
      onkeydown="cwKey(event)"
      oninput="cwGrow(this)"></textarea>
    <button id="cw-send" onclick="cwSend()" aria-label="Envoyer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"/>
        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
    </button>
  </div>
</div>

{# ══════════════════════════════════════════════
   🌍 TRANSLATION MODAL
══════════════════════════════════════════════ #}
<div id="translation-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:var(--overlay);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:var(--card);border-radius:24px;max-width:600px;width:90%;max-height:80vh;overflow-y:auto;padding:2rem;position:relative;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
    <button onclick="closeTranslationModal()" style="position:absolute;top:1.5rem;right:1.5rem;background:var(--coral-lt);color:var(--coral);border:none;width:40px;height:40px;border-radius:50%;font-size:1.5rem;cursor:pointer;display:flex;align-items:center;justify-content:center;">✕</button>
    <div style="margin-bottom:2rem;">
      <h2 style="font-family:'Poppins',sans-serif;font-size:1.8rem;font-weight:800;color:var(--ink);margin-bottom:.5rem;">🌍 Translate Flashcard</h2>
      <p style="color:var(--muted);font-size:.9rem;">Automatically generate translations in multiple languages</p>
    </div>
    <div style="background:linear-gradient(135deg,var(--teal-lt),var(--sky-lt));padding:1.2rem;border-radius:12px;margin-bottom:1.5rem;border-left:4px solid var(--teal);">
      <div style="font-weight:700;color:var(--teal-dk);margin-bottom:.5rem;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;">Current Flashcard</div>
      <div id="fc-title-display" style="font-size:1.1rem;font-weight:700;color:var(--ink);"></div>
      <div id="fc-question-display" style="font-size:.85rem;color:var(--ink-2);margin-top:.3rem;"></div>
    </div>
    <div style="margin-bottom:1.5rem;">
      <label style="display:block;font-weight:700;margin-bottom:1rem;color:var(--ink);font-size:.95rem;">🎯 Select target languages:</label>
      <div id="lang-select-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;"></div>
      <div style="margin-top:.75rem;text-align:center;">
        <button onclick="selectAllLanguages()" style="background:none;border:none;color:var(--teal);font-size:.8rem;font-weight:700;cursor:pointer;text-decoration:underline;">Select all</button>
        <span style="color:var(--muted);margin:0 .5rem;">|</span>
        <button onclick="deselectAllLanguages()" style="background:none;border:none;color:var(--coral);font-size:.8rem;font-weight:700;cursor:pointer;text-decoration:underline;">Deselect all</button>
      </div>
    </div>
    <div style="display:flex;gap:.75rem;justify-content:flex-end;">
      <button onclick="closeTranslationModal()" class="btn bo">Cancel</button>
      <button onclick="performTranslation()" id="translate-action-btn" class="btn bv">🚀 Translate</button>
    </div>
    <div id="translation-result" style="margin-top:1.5rem;display:none;border-top:2px solid var(--bg);padding-top:1.5rem;"></div>
  </div>
</div>

{# ══════════════════════════════════════════════
   🤖 ANALYZE CARDS MODAL
══════════════════════════════════════════════ #}
<div id="analyze-modal" style="display:none;position:fixed;inset:0;z-index:9999;background:var(--overlay);backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:1rem;">
  <div style="background:var(--card);border-radius:24px;max-width:720px;width:100%;max-height:90vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 24px 80px rgba(0,0,0,0.35);">
    <!-- Header -->
    <div style="padding:1.4rem 1.75rem;border-bottom:2px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,var(--lilac-lt),var(--card));flex-shrink:0;">
      <div style="display:flex;align-items:center;gap:.75rem">
        <div style="width:42px;height:42px;border-radius:12px;background:var(--lilac);display:flex;align-items:center;justify-content:center;font-size:1.3rem;box-shadow:0 4px 14px rgba(167,139,250,.4);">🤖</div>
        <div>
          <div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:1rem;color:var(--ink)">Analyse IA des cartes</div>
          <div style="font-size:.75rem;color:var(--muted);font-weight:600">Détection automatique des problèmes de formulation</div>
        </div>
      </div>
      <button onclick="closeAnalyze()" style="background:none;border:none;cursor:pointer;font-size:1.4rem;color:var(--muted);padding:.3rem;border-radius:8px;line-height:1;">✕</button>
    </div>
    <!-- Body -->
    <div id="analyze-body" style="padding:1.5rem 1.75rem;overflow-y:auto;flex:1">
      <div id="analyze-loading" style="text-align:center;padding:3rem 1rem">
        <div style="font-size:2.5rem;margin-bottom:1rem;animation:spin 1.2s linear infinite;display:inline-block">⚙️</div>
        <div style="font-family:'Poppins',sans-serif;font-weight:700;color:var(--ink);font-size:1rem">Analyse en cours...</div>
        <div style="color:var(--muted);font-size:.82rem;margin-top:.4rem">L'IA examine toutes vos flashcards</div>
      </div>
      <div id="analyze-results" style="display:none"></div>
    </div>
  </div>
</div>

{# ══════════════════════════════════════════════
   JAVASCRIPT
══════════════════════════════════════════════ #}
<script>
// Theme management
function toggleTheme() {
  document.body.classList.toggle('dark-mode');
  const themeToggle = document.getElementById('themeToggle');
  const isDark = document.body.classList.contains('dark-mode');
  themeToggle.textContent = isDark ? '☀️' : '🌓';
  localStorage.setItem('theme', isDark ? 'dark' : 'light');
}

// Initialize theme from localStorage or system preference
(function initTheme() {
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark') {
    document.body.classList.add('dark-mode');
    document.getElementById('themeToggle').textContent = '☀️';
  } else if (savedTheme === 'light') {
    document.body.classList.remove('dark-mode');
    document.getElementById('themeToggle').textContent = '🌓';
  } else {
    // Check system preference
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.body.classList.add('dark-mode');
      document.getElementById('themeToggle').textContent = '☀️';
    }
  }
})();

const DECK_ID = {{ deck.id }};
const FC=[{% for fc in flashcards %}{id:{{ fc.id }},t:{{ fc.titre|default('Untitled')|json_encode|raw }},q:{{ fc.question|json_encode|raw }},a:{{ fc.reponse|json_encode|raw }}}{% if not loop.last %},{% endif %}{% endfor %}];
const CSRF='{{ csrf_token("analyse_vocal") }}';
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;

let ci=0,rec=null,isR=false,tr='',scores={},ansOn=false;
let avSpeaking=false;

/* ════ AVATAR ════ */
const AV_PHRASES={
  idle:["Hello! 👋 I'm ready to help you.","Pick a flashcard and let's start! 📚","I'm here to accompany you. 😊"],
  ready:["Great! 🎉 Read the question carefully.","Take your time. 😌 I'm with you.","Focus! You'll succeed. 💪"],
  listening:["I'm listening carefully… 👂","Speak clearly, I'm transcribing! 🎤","Let's go! Give your answer."],
  thinking:["Hmm, analyzing your answer… 🤔","Let me check that… ⏳","AI is working for you. 🤖"],
  excellent:["PERFECT! 🏆 You master this concept!","Exceptional! 🌟 Score 10/10!","Bravo bravo bravo! 🎊 You're at the top!"],
  good:["Very good! ✅ Nice answer!","Good answer! 👍 Keep it up!","Well done! 🎯 Some details to refine."],
  partial:["Not bad! ⚠️ You got the main points, but some details are missing.","Medium… 💭 Try to remember the keywords.","Courage! 💛 Reread the correct answer."],
  wrong:["Oh! ❌ That's not quite it.","Don't get discouraged! 💪 The next one will be the right one.","Start over, you can do it! 📖"],
  motivate:["Each mastered flashcard is one more neuron! 🧠","Champions review even when it's hard! 🥊","You're closer to excellence than yesterday! 🚀","Consistency beats talent. Keep going! ⭐","Your brain loves spaced repetition! 🔄"]
};
const rand=arr=>arr[Math.floor(Math.random()*arr.length)];

function setAvatarState(state,customMsg=null){
  const stage=document.getElementById('av-stage'),status=document.getElementById('av-status'),bubble=document.getElementById('av-bubble');
  stage.classList.remove('speaking','listening','thinking');
  status.classList.remove('speaking','listening','thinking','correct','wrong');
  bubble.classList.remove('speaking-bubble','listening-bubble','thinking-bubble','correct-bubble','wrong-bubble');
  const cfg={
    idle:{stage:'',status:'',bubble:'',statusTxt:'😊 Ready to help'},
    speaking:{stage:'speaking',status:'speaking',bubble:'speaking-bubble',statusTxt:'🔊 Speaking…'},
    listening:{stage:'listening',status:'listening',bubble:'listening-bubble',statusTxt:'👂 Listening…'},
    thinking:{stage:'thinking',status:'thinking',bubble:'thinking-bubble',statusTxt:'🤔 Analyzing…'},
    correct:{stage:'speaking',status:'correct',bubble:'correct-bubble',statusTxt:'🏆 Excellent!'},
    good:{stage:'speaking',status:'correct',bubble:'correct-bubble',statusTxt:'✅ Well done!'},
    partial:{stage:'speaking',status:'',bubble:'thinking-bubble',statusTxt:'⚠️ Partially correct'},
    wrong:{stage:'speaking',status:'wrong',bubble:'wrong-bubble',statusTxt:'❌ To review'}
  };
  const c=cfg[state]||cfg.idle;
  if(c.stage)stage.classList.add(c.stage);
  if(c.status)status.classList.add(c.status);
  if(c.bubble)bubble.classList.add(c.bubble);
  status.textContent=c.statusTxt;
  bubble.innerHTML=customMsg||rand(AV_PHRASES[state]||AV_PHRASES.idle);
  avSpeaking=(c.stage==='speaking');
}

function avatarSpeak(text,state='speaking'){
  if(!window.speechSynthesis){setAvatarState(state,text);return;}
  window.speechSynthesis.cancel();
  setAvatarState(state,text);
  const u=new SpeechSynthesisUtterance(text);
  u.lang='en-US';u.rate=0.92;u.pitch=1.05;
  u.onend=u.onerror=()=>{avSpeaking=false;document.getElementById('av-stage').classList.remove('speaking');setAvatarState('idle');};
  window.speechSynthesis.speak(u);
}
function avatarReadQuestion(){const f=FC[ci];if(!f)return;avatarSpeak('Here is the question: '+f.q.replace(/<[^>]+>/g,''));}
function avatarReadAnswer(){const f=FC[ci];if(!f)return;avatarSpeak('The correct answer is: '+f.a.replace(/<[^>]+>/g,''));if(!ansOn)toggleAns();}
function avatarMotivate(){avatarSpeak(rand(AV_PHRASES.motivate));}
function avatarGiveFeedback(score,feedback){
  const state=score>=9?'correct':score>=7?'good':score>=5?'partial':'wrong';
  const ph=score>=9?'excellent':state==='good'?'good':state==='partial'?'partial':'wrong';
  const scoreMsg=rand(AV_PHRASES[ph]);
  setAvatarState(state,scoreMsg+'<br><span style="font-size:.8rem;font-style:italic;opacity:.8;">'+feedback+'</span>');
  setTimeout(()=>avatarSpeak(scoreMsg+' '+feedback,state),300);
}

/* ════ CARDS ════ */
document.addEventListener('DOMContentLoaded',()=>{
  if(FC.length)load(0);
  if(!SR){const mz=document.getElementById('mz');if(mz)mz.innerHTML='<div style="text-align:center;padding:1.5rem;background:var(--coral-lt);border-radius:14px;color:var(--coral-dk);font-weight:700;">❌ Voice recognition not supported.<br><span style="font-weight:400;font-size:.82rem;">Use Google Chrome or Microsoft Edge.</span></div>';}
  document.addEventListener('keydown',e=>{
    if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA')return;
    if(e.code==='ArrowRight')nav(1);
    if(e.code==='ArrowLeft')nav(-1);
    if(e.code==='KeyA')toggleAns();
    if(e.code==='KeyS')avatarReadQuestion();
    if(e.altKey&&e.key==='c'){e.preventDefault();toggleChatbot();}
  });
  setTimeout(()=>setAvatarState('idle',rand(AV_PHRASES.idle)),500);
});

function load(i){
  if(!FC.length)return;
  ci=((i%FC.length)+FC.length)%FC.length;
  const f=FC[ci];
  document.getElementById('fc-q').textContent=f.q;
  document.getElementById('fc-a-t').textContent=f.a;
  ansOn=false;
  document.getElementById('fc-a').classList.remove('on');
  document.getElementById('btn-ans').textContent='👁️ Show answer';
  const t=FC.length,pct=t>1?Math.round((ci/(t-1))*100):100;
  document.getElementById('pb').style.width=pct+'%';
  document.getElementById('pb-l').textContent=`Flashcard ${ci+1} / ${t}`;
  document.getElementById('pb-p').textContent=pct+'%';
  document.getElementById('ncnt').textContent=`${ci+1} / ${t}`;
  closeAI();clearT();
  setAvatarState('idle',rand(AV_PHRASES.ready));
}
function nav(d){load(ci+d);}
function jumpTo(i){load(i);document.querySelector('.card').scrollIntoView({behavior:'smooth'});}
function shuffleCards(){for(let i=FC.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[FC[i],FC[j]]=[FC[j],FC[i]];}load(0);toast('🔀 Shuffled!','inf');}
function toggleAns(){ansOn=!ansOn;document.getElementById('fc-a').classList.toggle('on',ansOn);document.getElementById('btn-ans').textContent=ansOn?'🙈 Hide':'👁️ Show answer';}

/* ════ RECORDING ════ */
function toggleRec(){
  if(!SR){toast('❌ Use Chrome or Edge','err');return;}
  if(isR){try{rec.stop();}catch(e){}setRUI(false);isR=false;return;}
  rec=new SR();rec.lang='en-US';rec.continuous=false;rec.interimResults=true;rec.maxAlternatives=1;
  rec.onresult=e=>{let it='',fi='';for(let r of e.results){if(r.isFinal)fi+=r[0].transcript;else it+=r[0].transcript;}if(fi)tr+=fi;const tb=document.getElementById('tb');tb.textContent=(tr+it).trim()||'…';tb.classList.add('on');if(tr.trim())document.getElementById('btn-ai').style.display='';};
  rec.onerror=e=>{setRUI(false);isR=false;const msgs={'not-allowed':'🔒 Microphone permission denied.','no-speech':'🔇 No speech detected.','audio-capture':'❌ Microphone not found.'};toast(msgs[e.error]||'❌ '+e.error,'err');setAvatarState('idle','❌ Microphone problem.');};
  rec.onend=()=>{setRUI(false);isR=false;if(tr.trim()){document.getElementById('btn-ai').style.display='';document.getElementById('mst').textContent='✅ Ready to analyze';setAvatarState('thinking',rand(AV_PHRASES.thinking));}else{document.getElementById('mst').textContent='⚠️ Nothing captured';setAvatarState('idle','🔇 I didn\'t hear anything. Try again!');}};
  tr='';const tb=document.getElementById('tb');tb.textContent='…';tb.classList.add('on');
  document.getElementById('btn-ai').style.display='none';
  document.getElementById('mz').classList.add('active');
  setAvatarState('listening',rand(AV_PHRASES.listening));
  try{rec.start();setRUI(true);}catch(e){toast('❌ '+e.message,'err');setRUI(false);setAvatarState('idle');}
}
function setRUI(on){isR=on;const b=document.getElementById('mb');b.className='mic-btn '+(on?'mr':'mi');b.textContent=on?'⏹':'🎤';document.getElementById('mst').textContent=on?'🔴 Recording… speak!':'Press to answer verbally';document.getElementById('wf').classList.toggle('live',on);if(!on)document.getElementById('mz').classList.remove('active');}
function clearT(){tr='';const tb=document.getElementById('tb');tb.textContent='';tb.classList.remove('on');document.getElementById('btn-ai').style.display='none';document.getElementById('mst').textContent='Press to answer verbally';document.getElementById('mz').classList.remove('active','analysing');}

/* ════ AI ANALYSIS (VOCAL) ════ */
async function analyseAI(){
  const f=FC[ci];if(!f||!tr.trim()){toast('❌ No answer','err');return;}
  const btn=document.getElementById('btn-ai');btn.disabled=true;btn.innerHTML='<div class="sp"></div> Analyzing…';
  document.getElementById('mz').classList.add('analysing');
  setAvatarState('thinking',rand(AV_PHRASES.thinking));
  try{
    const r=await fetch('/revisions/api/analyse-vocal',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({flashcardId:f.id,reponseEtudiant:tr.trim(),_token:CSRF})});
    if(!r.ok)throw new Error('HTTP '+r.status);
    const d=await r.json();if(d.error)throw new Error(d.error);
    showAI(d,f);updStats(f.id,d.score);setTimeout(()=>avatarGiveFeedback(d.score,d.feedback),400);
  }catch(e){toast('❌ AI Error: '+e.message,'err');setAvatarState('idle','❌ An error occurred.');}
  finally{btn.disabled=false;btn.innerHTML='🤖 Analyze with AI';document.getElementById('mz').classList.remove('analysing');}
}

function showAI(d,f){
  const s=d.score??0,arc=document.getElementById('sc-arc'),circ=207.3;
  arc.style.strokeDashoffset=circ-(s/10)*circ;
  const col=s>=8?'#20C9A0':s>=5?'#FFD93D':'#FF6B6B';arc.style.stroke=col;
  document.getElementById('sc-n').textContent=s;
  const v=s>=9?['🏆','Excellent!','#20C9A0']:s>=7?['✅','Good answer','#38BDF8']:s>=5?['⚠️','Partial','#FFD93D']:['❌','To review','#FF6B6B'];
  const ve=document.getElementById('sc-v');ve.textContent=v[0]+' '+v[1];ve.style.color=v[2];
  document.getElementById('ar-emo').textContent=v[0];
  const head=document.getElementById('ar-h');head.style.background=s>=8?'var(--teal-lt)':s>=5?'var(--lemon-lt)':'var(--coral-lt)';head.style.color=s>=8?'var(--teal-dk)':s>=5?'#7a6000':'var(--coral-dk)';
  document.getElementById('sc-t').textContent=d.feedback||'–';
  document.getElementById('cs').textContent=tr.trim();
  document.getElementById('cc').textContent=f.a;
  const days=s>=8?5:s>=6?3:s>=4?1:0,nd=new Date();nd.setDate(nd.getDate()+days);
  document.getElementById('nr').textContent=days===0?'Today':nd.toLocaleDateString('en-US',{weekday:'short',day:'numeric',month:'short'});
  const p=document.getElementById('ar');p.classList.add('on');p.style.borderColor=col;p.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function closeAI(){document.getElementById('ar').classList.remove('on');}
function updStats(id,s){scores[id]=s;const v=Object.values(scores),avg=v.reduce((a,b)=>a+b,0)/v.length;document.getElementById('s-avg').textContent=avg.toFixed(1);document.getElementById('s-master').textContent=v.filter(x=>x>=8).length;}
function selCnt(btn,n){document.querySelectorAll('.cnt-btn').forEach(b=>b.classList.remove('sel'));btn.classList.add('sel');document.getElementById('cnt-in').value=n;}

function toast(msg,type='inf'){
  const a=document.getElementById('ta'),t=document.createElement('div');
  t.className='toast t'+type;
  t.innerHTML=`<span>${msg}</span><button onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:.9rem;color:inherit;margin-left:auto;">✕</button>`;
  a.appendChild(t);setTimeout(()=>t.remove(),5000);
}
{% for msg in app.flashes('success') %}toast({{ msg|json_encode|raw }},'ok');{% endfor %}
{% for msg in app.flashes('error') %}toast({{ msg|json_encode|raw }},'err');{% endfor %}
{% for msg in app.flashes('warning') %}toast({{ msg|json_encode|raw }},'inf');{% endfor %}

/* ════ TRANSLATION ════ */
let currentTranslatingFlashcard=null,availableLanguages={};
function openTranslationModal(){if(!FC||!FC[ci]){toast('❌ No flashcard selected','err');return;}currentTranslatingFlashcard=FC[ci];document.getElementById('fc-title-display').textContent=FC[ci].t||'Untitled';document.getElementById('fc-question-display').textContent=FC[ci].q||'';document.getElementById('translation-modal').style.display='flex';document.getElementById('translation-result').style.display='none';loadLanguagesForModal();}
function closeTranslationModal(){document.getElementById('translation-modal').style.display='none';currentTranslatingFlashcard=null;}
async function loadLanguagesForModal(){try{const r=await fetch('/api/translation/languages');if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();if(!d.success)throw new Error(d.error||'Unknown error');availableLanguages=d.languages;const grid=document.getElementById('lang-select-grid');grid.innerHTML='';for(const[code,info]of Object.entries(d.languages)){if(code==='fr')continue;grid.insertAdjacentHTML('beforeend',`<label style="display:flex;align-items:center;gap:.6rem;padding:.75rem 1rem;border:2px solid var(--border);border-radius:10px;cursor:pointer;transition:all .2s;background:var(--card);"><input type="checkbox" value="${code}" class="translation-lang-checkbox" style="width:18px;height:18px;cursor:pointer;accent-color:var(--lilac);"><span style="font-size:1.4rem;">${info.flag}</span><span style="font-size:.85rem;font-weight:700;color:var(--ink);">${info.name}</span></label>`);}grid.querySelectorAll('label').forEach(label=>{label.addEventListener('mouseenter',function(){this.style.borderColor='var(--lilac)';this.style.background='var(--lilac-lt)';});label.addEventListener('mouseleave',function(){if(!this.querySelector('input').checked){this.style.borderColor='var(--border)';this.style.background='var(--card)';}});label.querySelector('input').addEventListener('change',function(){if(this.checked){label.style.borderColor='var(--lilac)';label.style.background='var(--lilac)';label.style.color='white';label.querySelectorAll('span').forEach(s=>s.style.color='white');}else{label.style.borderColor='var(--border)';label.style.background='var(--card)';label.style.color='var(--ink)';label.querySelectorAll('span').forEach(s=>s.style.color='var(--ink)');}});});}catch(e){toast('❌ Cannot load languages: '+e.message,'err');}}
function selectAllLanguages(){document.querySelectorAll('.translation-lang-checkbox').forEach(cb=>{cb.checked=true;cb.dispatchEvent(new Event('change'));});}
function deselectAllLanguages(){document.querySelectorAll('.translation-lang-checkbox').forEach(cb=>{cb.checked=false;cb.dispatchEvent(new Event('change'));});}
async function performTranslation(){if(!currentTranslatingFlashcard){toast('❌ No flashcard selected','err');return;}const sel=Array.from(document.querySelectorAll('.translation-lang-checkbox:checked')).map(cb=>cb.value);if(!sel.length){toast('⚠️ Select at least one language','inf');return;}const btn=document.getElementById('translate-action-btn');const orig=btn.innerHTML;btn.disabled=true;btn.innerHTML='<div class="sp"></div> Translating...';setAvatarState('thinking','I\'m translating your flashcard into '+sel.length+' language(s)...');try{const r=await fetch(`/api/translation/flashcard/${currentTranslatingFlashcard.id}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({languages:sel,save:true,source_lang:'fr'})});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();if(d.success){toast(`✅ Translation successful for ${sel.length} language(s)!`,'ok');displayTranslationResults(d.translations);setAvatarState('idle','✨ Translations saved!');}else throw new Error(d.error||'Unknown error');}catch(e){toast('❌ Error: '+e.message,'err');setAvatarState('idle','❌ An error occurred.');}finally{btn.disabled=false;btn.innerHTML=orig;}}
function displayTranslationResults(trans){const c=document.getElementById('translation-result');c.style.display='block';c.innerHTML='<h3 style="font-family:Poppins,sans-serif;font-weight:800;color:var(--ink);margin-bottom:1rem;font-size:1.2rem;">✨ Generated Translations</h3>';for(const[lang,result]of Object.entries(trans)){if(!result.success){c.insertAdjacentHTML('beforeend',`<div style="background:var(--coral-lt);color:var(--coral-dk);padding:1rem;border-radius:8px;margin-bottom:.75rem;border-left:4px solid var(--coral);">❌ Error for ${availableLanguages[lang]?.name||lang}: ${result.error||'Unknown error'}</div>`);continue;}const t=result.translation,info=result.language_info;c.insertAdjacentHTML('beforeend',`<div style="background:var(--teal-lt);padding:1.2rem;border-radius:12px;margin-bottom:.75rem;border-left:4px solid var(--teal);"><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;"><div style="font-weight:700;display:flex;align-items:center;gap:.5rem;color:var(--teal-dk);"><span style="font-size:1.5rem;">${info.flag}</span><span>${info.name}</span></div><span style="font-size:.7rem;font-weight:800;background:var(--teal);color:white;padding:.3rem .6rem;border-radius:6px;">Level ${result.difficulty}/5</span></div><div style="font-size:.85rem;color:var(--ink);"><p><strong style="color:var(--teal-dk);">📌</strong> ${escHTr(t.titre)}</p><p style="margin-top:.3rem;"><strong style="color:var(--teal-dk);">❓</strong> ${escHTr(t.question)}</p><p style="margin-top:.3rem;"><strong style="color:var(--teal-dk);">✅</strong> ${escHTr(t.reponse)}</p></div></div>`);}}
function escHTr(text){if(!text)return'';const d=document.createElement('div');d.textContent=text;return d.innerHTML;}

/* ════════════════════════════════════════════
   🤖 ANALYZE CARDS — DÉTECTION IA
════════════════════════════════════════════ */
const ANALYZE_URL = `/revisions/deck/{{ deck.id }}/analyze`;

window.analyzeCards = async function() {
  const modal = document.getElementById('analyze-modal');
  const loading = document.getElementById('analyze-loading');
  const results = document.getElementById('analyze-results');

  modal.style.display = 'flex';
  loading.style.display = 'block';
  results.style.display = 'none';
  results.innerHTML = '';

  try {
    const res = await fetch(ANALYZE_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const data = await res.json();

    loading.style.display = 'none';
    results.style.display = 'block';

    if (data.error) {
      results.innerHTML = `<div style="text-align:center;padding:2rem;color:var(--coral);font-weight:700;">❌ ${data.error}</div>`;
      return;
    }

    const { total, problemes, score_global, cartes } = data;
    const score = score_global ?? 10;

    // ── Score global ──
    const scoreColor = score >= 8 ? 'var(--teal)' : score >= 5 ? 'var(--lemon)' : 'var(--coral)';
    const scoreEmoji = score >= 8 ? '🏆' : score >= 5 ? '⚠️' : '🚨';
    const scoreLabel = score >= 8 ? 'Excellent !' : score >= 5 ? 'À améliorer' : 'Critique';

    results.innerHTML = `
      <div style="display:flex;gap:1rem;margin-bottom:1.25rem;flex-wrap:wrap;">
        <!-- Score global -->
        <div style="flex:1;min-width:180px;text-align:center;padding:1.25rem;border-radius:16px;background:${scoreColor}15;border:2px solid ${scoreColor}44;">
          <div style="font-size:2.2rem;font-weight:900;color:${scoreColor};font-family:'Poppins',sans-serif;line-height:1">${score}<span style="font-size:1rem;opacity:.6">/10</span></div>
          <div style="font-size:.78rem;font-weight:800;color:${scoreColor};margin-top:.3rem">${scoreEmoji} Score qualité</div>
          <div style="font-size:.72rem;color:var(--muted);margin-top:.2rem">${scoreLabel}</div>
        </div>
        <!-- Résumé -->
        <div style="flex:2;min-width:200px;text-align:center;padding:1.25rem;border-radius:16px;background:${problemes === 0 ? 'var(--teal)' : problemes <= 2 ? 'var(--lemon)' : 'var(--coral)'}15;border:2px solid ${problemes === 0 ? 'var(--teal)' : problemes <= 2 ? 'var(--lemon)' : 'var(--coral)'}44;display:flex;flex-direction:column;justify-content:center;">
          <div style="font-size:1.8rem;margin-bottom:.3rem">${problemes === 0 ? '🎉' : problemes <= 2 ? '⚠️' : '🚨'}</div>
          <div style="font-family:'Poppins',sans-serif;font-weight:800;font-size:1rem;color:var(--ink)">
            ${problemes === 0 ? 'Toutes les cartes sont parfaites !' : `${problemes} carte${problemes > 1 ? 's' : ''} à améliorer sur ${total}`}
          </div>
          <div style="font-size:.75rem;color:var(--muted);margin-top:.25rem">${total} carte${total > 1 ? 's' : ''} analysée${total > 1 ? 's' : ''}</div>
        </div>
      </div>
    `;

    // ── Cartes problématiques ──
    if (cartes && cartes.length > 0) {
      cartes.forEach(carte => {
        const sev = carte.severite || 'faible';
        const icons = { grave: '🚨', moyen: '⚠️', faible: '💡' };
        const labels = { grave: 'Grave', moyen: 'Moyen', faible: 'Faible' };
        const bgColors = { grave: 'var(--coral-lt)', moyen: 'var(--lemon-lt)', faible: 'var(--teal-lt)' };
        const bdColors = { grave: 'var(--coral)', moyen: 'var(--lemon)', faible: 'var(--teal)' };
        const problemesList = (carte.problemes || []).map(p => `<li style="margin-bottom:.2rem">• ${p}</li>`).join('');

        const cardId = `card-${carte.id}`;

        results.innerHTML += `
          <div id="${cardId}" style="border-radius:16px;padding:1.1rem 1.25rem;margin-bottom:1rem;border:2px solid ${bdColors[sev]};background:${bgColors[sev]};">

            <!-- Titre + badge -->
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.5rem;margin-bottom:.75rem">
              <div style="font-family:'Poppins',sans-serif;font-weight:700;font-size:.95rem;color:var(--ink)">
                ${icons[sev]} ${carte.titre || 'Carte #' + carte.id}
              </div>
              <span class="prob-badge badge-${sev}">${labels[sev]}</span>
            </div>

            <!-- Problèmes détectés -->
            <ul style="list-style:none;padding:0;margin:0 0 .85rem 0;font-size:.8rem;color:var(--ink-2)">${problemesList}</ul>

            <!-- Comparaison Avant / Après -->
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-bottom:.85rem;">
              <div style="background:rgba(0,0,0,0.05);border-radius:10px;padding:.75rem;border:1.5px solid rgba(0,0,0,.08);">
                <div style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.4rem">📋 Original</div>
                <div style="font-size:.75rem;color:var(--ink-2);line-height:1.5;margin-bottom:.3rem"><strong style="color:var(--ink)">Q :</strong> ${escA(carte.question_originale || '—')}</div>
                <div style="font-size:.75rem;color:var(--ink-2);line-height:1.5"><strong style="color:var(--ink)">R :</strong> ${escA(carte.reponse_originale || '—')}</div>
              </div>
              <div style="background:${sev === 'grave' ? 'var(--coral-lt)' : sev === 'moyen' ? 'var(--lemon-lt)' : 'var(--teal-lt)'};border-radius:10px;padding:.75rem;border:1.5px solid ${bdColors[sev]};">
                <div style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:${bdColors[sev]};margin-bottom:.4rem">✨ Version corrigée</div>
                <div style="font-size:.75rem;color:var(--ink-2);line-height:1.5;margin-bottom:.3rem"><strong style="color:var(--ink)">Q :</strong> ${escA(carte.question_corrigee || '—')}</div>
                <div style="font-size:.75rem;color:var(--ink-2);line-height:1.5"><strong style="color:var(--ink)">R :</strong> ${escA(carte.reponse_corrigee || '—')}</div>
              </div>
            </div>

            <!-- Suggestion -->
            <div style="margin-bottom:.85rem;padding:.65rem .85rem;border-radius:10px;background:rgba(0,0,0,0.03);font-size:.78rem;color:var(--ink);border-left:3px solid var(--lilac);">
              💡 <strong>Suggestion :</strong> ${escA(carte.suggestion || '—')}
            </div>

            <!-- Bouton corriger -->
            <button
              id="btn-correct-${carte.id}"
              onclick="correctCard(${carte.id}, ${JSON.stringify(carte.question_corrigee).replace(/</g,'\\u003c')}, ${JSON.stringify(carte.reponse_corrigee).replace(/</g,'\\u003c')})"
              style="width:100%;padding:.7rem;border-radius:10px;border:none;background:linear-gradient(135deg,var(--lilac),#7C3AED);color:#fff;font-weight:800;font-size:.82rem;cursor:pointer;font-family:'Nunito',sans-serif;display:flex;align-items:center;justify-content:center;gap:.5rem;transition:all .18s;box-shadow:0 4px 14px rgba(167,139,250,.35);">
              ✨ Corriger automatiquement
            </button>
          </div>
        `;
      });
    }

  } catch(e) {
    loading.style.display = 'none';
    results.style.display = 'block';
    results.innerHTML = `<div style="text-align:center;padding:2rem;color:var(--coral);font-weight:700;">❌ Erreur de connexion</div>`;
  }
};

function escA(text) {
  const d = document.createElement('div');
  d.textContent = text;
  return d.innerHTML;
}

window.correctCard = async function(id, questionCorrigee, reponseCorrigee) {
  const btn = document.getElementById(`btn-correct-${id}`);
  if (!btn) return;
  const orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<div class="sp"></div> Correction en cours…';

  try {
    const res = await fetch(`/revisions/flashcard/${id}/correct`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ question_corrigee: questionCorrigee, reponse_corrigee: reponseCorrigee })
    });
    const data = await res.json();

    if (data.success) {
      const card = document.getElementById(`card-${id}`);
      if (card) {
        card.style.transition = 'all .4s';
        card.style.opacity = '0';
        card.style.transform = 'translateY(-8px)';
        setTimeout(() => {
          card.innerHTML = `
            <div style="display:flex;align-items:center;gap:.75rem;padding:.5rem 0;">
              <div style="width:36px;height:36px;border-radius:50%;background:var(--teal-lt);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;">✅</div>
              <div>
                <div style="font-weight:800;color:var(--teal-dk);font-size:.88rem">Carte corrigée avec succès !</div>
                <div style="font-size:.75rem;color:var(--muted);margin-top:.1rem">La carte a été mise à jour en base de données.</div>
              </div>
            </div>
          `;
          card.style.background = 'var(--teal-lt)';
          card.style.borderColor = 'var(--teal)';
          card.style.opacity = '1';
          card.style.transform = 'none';
        }, 350);
      }
      toast('✅ Carte corrigée !', 'ok');
    } else {
      throw new Error(data.error || 'Erreur inconnue');
    }
  } catch(e) {
    btn.disabled = false;
    btn.innerHTML = orig;
    toast('❌ Erreur : ' + e.message, 'err');
  }
};

window.closeAnalyze = function() {
  document.getElementById('analyze-modal').style.display = 'none';
};

document.getElementById('analyze-modal').addEventListener('click', function(e) {
  if (e.target === this) closeAnalyze();
});

/* ════════════════════════════════════════════
   🤖 CHATBOT ENGINE — UNIQUE ENGINE
════════════════════════════════════════════ */
(function(){
  const API  = `/revisions/deck/${DECK_ID}/chat`;
  let open   = false;
  let busy   = false;
  let hist   = [];
  let unread = 0;

  const win   = document.getElementById('chatbot-window');
  const msgs  = document.getElementById('cw-msgs');
  const inp   = document.getElementById('cw-input');
  const send  = document.getElementById('cw-send');
  const badge = document.getElementById('fab-badge');

  window.toggleChatbot = function(){
    open = !open;
    win.classList.toggle('open', open);
    if(open){
      unread = 0; badge.classList.remove('show');
      setTimeout(()=>{ inp.focus(); scrollBot(); }, 350);
    }
  };

  window.cwGrow = function(el){
    el.style.height='auto';
    el.style.height=Math.min(el.scrollHeight,120)+'px';
  };
  window.cwKey = function(e){
    if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); cwSend(); }
  };
  window.cwSuggest = function(text){ inp.value=text; cwGrow(inp); cwSend(); };

  function scrollBot(){
    msgs.scrollTo({top:msgs.scrollHeight,behavior:'smooth'});
  }

  function md(text){
    return text
      .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
      .replace(/\*(.+?)\*/g,'<em>$1</em>')
      .replace(/`([^`]+)`/g,'<code>$1</code>')
      .replace(/^[-•] (.+)$/gm,'<li>$1</li>')
      .replace(/(<li>[\s\S]+?<\/li>)/g,'<ul>$1</ul>')
      .replace(/\n\n/g,'<br><br>')
      .replace(/\n/g,'<br>');
  }

  function esc(t){ const d=document.createElement('div');d.textContent=t;return d.innerHTML; }

  function addBubble(role,content){
    const isAI = role==='assistant';
    const now  = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
    const row  = document.createElement('div');
    row.className = 'msg-row '+(isAI?'':'user');
    row.style.cssText='opacity:0;transform:translateY(8px)';

    const av = document.createElement('div');
    av.className = isAI ? 'msg-av' : 'msg-av user-av';
    av.innerHTML = isAI
      ? '<img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed" alt="AI">'
      : '👤';

    const wrap = document.createElement('div');
    const bub  = document.createElement('div');
    bub.className = 'msg-bubble '+(isAI?'ai':'user');
    bub.innerHTML = isAI ? md(content) : esc(content).replace(/\n/g,'<br>');

    const time = document.createElement('div');
    time.className='msg-time'; time.textContent=now;

    wrap.append(bub,time); row.append(av,wrap);
    msgs.appendChild(row);

    requestAnimationFrame(()=>{
      row.style.transition='opacity .25s,transform .25s';
      row.style.opacity='1'; row.style.transform='none';
    });
    scrollBot();
  }

  function showTyping(){
    const row=document.createElement('div');
    row.id='cw-typing'; row.className='msg-row';
    const av=document.createElement('div');av.className='msg-av';
    av.innerHTML='<img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed" alt="AI">';
    const ind=document.createElement('div');ind.className='typing-ind';
    ind.innerHTML='<div class="t-dot"></div><div class="t-dot"></div><div class="t-dot"></div>';
    row.append(av,ind); msgs.appendChild(row); scrollBot();
  }
  function hideTyping(){ document.getElementById('cw-typing')?.remove(); }

  window.cwSend = async function(){
    const text = inp.value.trim();
    if(!text||busy) return;
    inp.value=''; inp.style.height='auto';
    busy=true; send.disabled=true;

    addBubble('user',text);
    hist.push({role:'user',content:text});
    showTyping();

    try{
      const res = await fetch(API,{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({message:text, history:hist.slice(0,-1)})
      });
      const d = await res.json();
      hideTyping();

      if(d.error){ addBubble('assistant','❌ '+d.error); return; }

      const reply = d.reply||'…';
      addBubble('assistant',reply);
      hist.push({role:'assistant',content:reply});

      if(!open){
        unread++;
        badge.textContent = unread>9?'9+':unread;
        badge.classList.add('show');
      }
    }catch(err){
      hideTyping();
      addBubble('assistant','❌ Connection error. Please try again.');
    }finally{
      busy=false; send.disabled=false; inp.focus();
    }
  };

})();
</script>
