// ═══════════════════════════════════════════
//  🌍 TRANSLATION SYSTEM
// ═══════════════════════════════════════════

let currentTranslatingFlashcard = null;
let availableLanguages = {};

function openTranslationModal() {
  if (!FC || !FC[ci]) {
    toast('❌ No flashcard selected', 'err');
    return;
  }
  
  currentTranslatingFlashcard = FC[ci];
  const title = FC[ci].t || 'Untitled';
  const question = FC[ci].q || '';
  document.getElementById('fc-title-display').textContent = title;
  document.getElementById('fc-question-display').textContent = question;
  document.getElementById('translation-modal').style.display = 'flex';
  document.getElementById('translation-result').style.display = 'none';
  
  loadLanguagesForModal();
}

function closeTranslationModal() {
  document.getElementById('translation-modal').style.display = 'none';
  currentTranslatingFlashcard = null;
}

async function loadLanguagesForModal() {
  try {
    const response = await fetch('/api/translation/languages');
    
    if (!response.ok) {
      throw new Error('HTTP ' + response.status);
    }
    
    const data = await response.json();
    
    if (!data.success) {
      throw new Error(data.error || 'Unknown error');
    }
    
    availableLanguages = data.languages;
    const grid = document.getElementById('lang-select-grid');
    grid.innerHTML = '';
    
    for (const [code, info] of Object.entries(data.languages)) {
      if (code === 'fr') continue;
      
      const html = `
        <label style="display:flex; align-items:center; gap:0.6rem; padding:0.75rem 1rem; border:2px solid var(--border); border-radius:10px; cursor:pointer; transition:all 0.2s; background:white;">
          <input type="checkbox" value="${code}" class="translation-lang-checkbox" style="width:18px; height:18px; cursor:pointer; accent-color:var(--lilac);">
          <span style="font-size:1.4rem;">${info.flag}</span>
          <span style="font-size:0.85rem; font-weight:700; color:var(--ink);">${info.name}</span>
        </label>
      `;
      grid.insertAdjacentHTML('beforeend', html);
    }
    
    grid.querySelectorAll('label').forEach(label => {
      label.addEventListener('mouseenter', function() {
        this.style.borderColor = 'var(--lilac)';
        this.style.background = 'var(--lilac-lt)';
      });
      label.addEventListener('mouseleave', function() {
        if (!this.querySelector('input').checked) {
          this.style.borderColor = 'var(--border)';
          this.style.background = 'white';
        }
      });
      
      label.querySelector('input').addEventListener('change', function() {
        if (this.checked) {
          label.style.borderColor = 'var(--lilac)';
          label.style.background = 'var(--lilac)';
          label.style.color = 'white';
          label.querySelectorAll('span').forEach(s => s.style.color = 'white');
        } else {
          label.style.borderColor = 'var(--border)';
          label.style.background = 'white';
          label.style.color = 'var(--ink)';
          label.querySelectorAll('span').forEach(s => s.style.color = 'var(--ink)');
        }
      });
    });
    
  } catch (error) {
    console.error('Error loading languages:', error);
    toast('❌ Cannot load languages: ' + error.message, 'err');
  }
}

function selectAllLanguages() {
  document.querySelectorAll('.translation-lang-checkbox').forEach(cb => {
    cb.checked = true;
    cb.dispatchEvent(new Event('change'));
  });
}

function deselectAllLanguages() {
  document.querySelectorAll('.translation-lang-checkbox').forEach(cb => {
    cb.checked = false;
    cb.dispatchEvent(new Event('change'));
  });
}

async function performTranslation() {
  if (!currentTranslatingFlashcard) {
    toast('❌ No flashcard selected', 'err');
    return;
  }
  
  const selectedLangs = Array.from(document.querySelectorAll('.translation-lang-checkbox:checked'))
    .map(cb => cb.value);
  
  if (selectedLangs.length === 0) {
    toast('⚠️ Select at least one language', 'inf');
    return;
  }
  
  const btn = document.getElementById('translate-action-btn');
  const originalHTML = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<div class="sp"></div> Translating...';
  
  setAvatarState('thinking', 'I\'m translating your flashcard into ' + selectedLangs.length + ' language(s)...');
  
  try {
    const response = await fetch(`/api/translation/flashcard/${currentTranslatingFlashcard.id}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        languages: selectedLangs,
        save: true,
        source_lang: 'fr'
      })
    });
    
    if (!response.ok) {
      throw new Error('HTTP ' + response.status);
    }
    
    const data = await response.json();
    
    if (data.success) {
      const langCount = selectedLangs.length;
      toast(`✅ Translation successful for ${langCount} language${langCount > 1 ? 's' : ''}!`, 'ok');
      displayTranslationResults(data.translations);
      setAvatarState('idle', rand([
        '✨ Translations generated successfully!',
        '🎉 Your flashcards are now multilingual!',
        '🌍 Translations saved!'
      ]));
    } else {
      throw new Error(data.error || 'Unknown error');
    }
  } catch (error) {
    console.error('Translation error:', error);
    toast('❌ Error: ' + error.message, 'err');
    setAvatarState('idle', '❌ An error occurred during translation.');
  } finally {
    btn.disabled = false;
    btn.innerHTML = originalHTML;
  }
}

function displayTranslationResults(translations) {
  const container = document.getElementById('translation-result');
  container.style.display = 'block';
  container.innerHTML = `
    <h3 style="font-family:'Poppins',sans-serif; font-weight:800; color:var(--ink); margin-bottom:1rem; font-size:1.2rem;">
      ✨ Generated Translations
    </h3>
  `;
  
  let successCount = 0;
  
  for (const [lang, result] of Object.entries(translations)) {
    if (!result.success) {
      container.insertAdjacentHTML('beforeend', `
        <div style="background:var(--coral-lt); color:var(--coral-dk); padding:1rem; border-radius:8px; margin-bottom:0.75rem; border-left:4px solid var(--coral);">
          ❌ Error for ${availableLanguages[lang]?.name || lang}: ${result.error || 'Unknown error'}
        </div>
      `);
      continue;
    }
    
    successCount++;
    const trans = result.translation;
    const info = result.language_info;
    
    const html = `
      <div style="background:var(--teal-lt); padding:1.2rem; border-radius:12px; margin-bottom:0.75rem; border-left:4px solid var(--teal); transition:all 0.2s;" onmouseenter="this.style.boxShadow='0 4px 12px rgba(32,201,160,0.2)'" onmouseleave="this.style.boxShadow='none'">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.75rem;">
          <div style="font-weight:700; display:flex; align-items:center; gap:0.5rem; color:var(--teal-dk);">
            <span style="font-size:1.5rem;">${info.flag}</span>
            <span style="font-size:1rem;">${info.name}</span>
          </div>
          <span style="font-size:0.7rem; font-weight:800; background:var(--teal); color:white; padding:0.3rem 0.6rem; border-radius:6px;">
            Level ${result.difficulty}/5
          </span>
        </div>
        <div style="font-size:0.85rem; color:var(--ink);">
          <div style="margin-bottom:0.4rem;">
            <strong style="color:var(--teal-dk);">📌 Title:</strong> 
            <span>${escapeHtmlTranslation(trans.titre)}</span>
          </div>
          <div style="margin-bottom:0.4rem;">
            <strong style="color:var(--teal-dk);">❓ Question:</strong> 
            <span>${escapeHtmlTranslation(trans.question)}</span>
          </div>
          <div>
            <strong style="color:var(--teal-dk);">✅ Answer:</strong> 
            <span>${escapeHtmlTranslation(trans.reponse)}</span>
          </div>
        </div>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', html);
  }
  
  if (successCount > 0) {
    container.insertAdjacentHTML('beforeend', `
      <div style="text-align:center; margin-top:1.5rem; padding-top:1rem; border-top:2px solid var(--border);">
        <span style="font-size:0.9rem; color:var(--muted);">✅ ${successCount} translation(s) saved</span>
      </div>
    `);
  }
  
  setTimeout(() => {
    container.scrollIntoView({ 
      behavior: 'smooth', 
      block: 'nearest' 
    });
  }, 300);
}

function escapeHtmlTranslation(text) {
  if (!text) return '';
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

</script>

{# ═══════════════════════════════════════════
   🌍 TRANSLATION MODAL
══════════════════════════════════════════ #}
<div id="translation-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(30,27,58,0.7); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:white; border-radius:24px; max-width:600px; width:90%; max-height:80vh; overflow-y:auto; padding:2rem; position:relative; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
    
    <button onclick="closeTranslationModal()" style="position:absolute; top:1.5rem; right:1.5rem; background:var(--coral-lt); color:var(--coral); border:none; width:40px; height:40px; border-radius:50%; font-size:1.5rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:all 0.2s;">
      ✕
    </button>
    
    <div style="margin-bottom:2rem;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:1.8rem; font-weight:800; color:var(--ink); margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem;">
        🌍 Translate Flashcard
      </h2>
      <p style="color:var(--muted); font-size:0.9rem;">Automatically generate translations in multiple languages</p>
    </div>
    
    <div id="current-flashcard-info" style="background:linear-gradient(135deg, var(--teal-lt) 0%, var(--sky-lt) 100%); padding:1.2rem; border-radius:12px; margin-bottom:1.5rem; border-left:4px solid var(--teal);">
      <div style="font-weight:700; color:var(--teal-dk); margin-bottom:0.5rem; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.05em;">Current Flashcard</div>
      <div id="fc-title-display" style="font-size:1.1rem; font-weight:700; color:var(--ink);"></div>
      <div id="fc-question-display" style="font-size:0.85rem; color:var(--ink-2); margin-top:0.3rem;"></div>
    </div>
    
    <div style="margin-bottom:1.5rem;">
      <label style="display:block; font-weight:700; margin-bottom:1rem; color:var(--ink); font-size:0.95rem;">
        🎯 Select target languages:
      </label>
      <div id="lang-select-grid" style="display:grid; grid-template-columns:repeat(2, 1fr); gap:0.75rem;">
      </div>
      <div style="margin-top:0.75rem; text-align:center;">
        <button onclick="selectAllLanguages()" style="background:none; border:none; color:var(--teal); font-size:0.8rem; font-weight:700; cursor:pointer; text-decoration:underline;">
          Select all
        </button>
        <span style="color:var(--muted); margin:0 0.5rem;">|</span>
        <button onclick="deselectAllLanguages()" style="background:none; border:none; color:var(--coral); font-size:0.8rem; font-weight:700; cursor:pointer; text-decoration:underline;">
          Deselect all
        </button>
      </div>
    </div>
    
    <div style="display:flex; gap:0.75rem; justify-content:flex-end;">
      <button onclick="closeTranslationModal()" class="btn bo">Cancel</button>
      <button onclick="performTranslation()" id="translate-action-btn" class="btn bv">
        🚀 Translate
      </button>
    </div>
    
    <div id="translation-result" style="margin-top:1.5rem; display:none; border-top:2px solid var(--bg); padding-top:1.5rem;">
    </div>
  </div>
</div>

