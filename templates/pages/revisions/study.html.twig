{% extends 'base.html.twig' %}
{% block title %}📚 {{ deck.titre }} – RLIFE{% endblock %}

{% block body %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@600;700;800&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<style>
:root {
  /* Light mode (default) */
  --coral:    #FF6B6B; --coral-lt: #FFF0F0; --coral-dk: #D93636;
  --teal:     #20C9A0; --teal-lt:  #E3FAF4; --teal-dk:  #0EA37E;
  --lemon:    #FFD93D; --lemon-lt: #FFFBE6;
  --lilac:    #A78BFA; --lilac-lt: #F0EBFF;
  --sky:      #38BDF8; --sky-lt:   #E8F6FF;
  --ink:      #1E1B3A; --ink-2:    #4A4768;
  --muted:    #9095B0; --border:   #EBEEf8;
  --bg:       #F7F9FF; --card:     #FFFFFF;
  --sh:       0 2px 16px rgba(30,27,58,.07);
  --sh-lg:    0 8px 40px rgba(30,27,58,.13);
  --r:16px;  --r-xl:24px;
  --overlay: rgba(0,0,0,0.5);
}

/* Dark mode class - appliquée manuellement ou via préférence système */
body.dark-mode,
.dark-mode {
  --coral:    #FF8585; --coral-lt: #4A2A2A; --coral-dk: #FF6B6B;
  --teal:     #4FD1B0; --teal-lt:  #1E4A3E; --teal-dk:  #4FD1B0;
  --lemon:    #FFE270; --lemon-lt: #4A401A;
  --lilac:    #B89FFF; --lilac-lt: #312A4A;
  --sky:      #60C5FF; --sky-lt:   #1E3A4A;
  --ink:      #E5E7EB; --ink-2:    #B0B3C5;
  --muted:    #9095B0; --border:   #404050;
  --bg:       #1A1A2E; --card:     #24243A;
  --sh:       0 2px 16px rgba(0,0,0,.3);
  --sh-lg:    0 8px 40px rgba(0,0,0,.5);
  --overlay: rgba(0,0,0,0.8);
}

/* Styles de base */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);min-height:100vh;transition:background-color 0.3s, color 0.3s;}

.pg{padding:2rem 1rem 5rem}
.pg-in{max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:1.75rem}

/* ─── HERO ─── */
.hero{border-radius:var(--r-xl);overflow:hidden;background:var(--card);box-shadow:var(--sh-lg)}
.hero-img{height:240px;position:relative;overflow:hidden}
.hero-img img{width:100%;height:100%;object-fit:cover}
.hero-placeholder{height:240px;display:flex;align-items:center;justify-content:center;font-size:5rem;background:linear-gradient(135deg,#FF6B6B 0%,#FFD93D 35%,#20C9A0 70%,#A78BFA 100%)}
.hero-body{padding:1.6rem 2rem 1.5rem}
.hero-tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.85rem}
.tag{display:inline-flex;align-items:center;padding:.3rem .8rem;border-radius:99px;font-size:.74rem;font-weight:800}
.tc{background:var(--coral-lt);color:var(--coral-dk)}
.tt{background:var(--teal-lt);color:var(--teal-dk)}
.tl{background:var(--lemon-lt);color:#7a6000}
.dark-mode .tl{color:var(--lemon);}
.hero-title{font-family:'Poppins',sans-serif;font-size:1.8rem;font-weight:800;color:var(--ink);line-height:1.2;margin-bottom:.5rem}
.hero-desc{font-size:.875rem;color:var(--muted);line-height:1.6;margin-bottom:1rem}
.hero-btns{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}
.stats{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--border)}
.stat{padding:1rem 1.5rem;display:flex;align-items:center;gap:.8rem;background:var(--card)}
.stat+.stat{border-left:1px solid var(--border)}
.sico{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0}
.sc{background:var(--coral-lt)}.st{background:var(--teal-lt)}.sl{background:var(--lemon-lt)}
.sn{font-family:'Poppins',sans-serif;font-size:1.45rem;font-weight:800;color:var(--ink);line-height:1}
.ss{font-size:.68rem;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:.06em;margin-top:.18rem}

/* ─── CARD ─── */
.card{background:var(--card);border-radius:var(--r-xl);box-shadow:var(--sh);overflow:hidden}
.ch{display:flex;align-items:center;justify-content:space-between;padding:1.1rem 1.5rem;border-bottom:2px solid var(--bg)}
.chl{display:flex;align-items:center;gap:.65rem}
.cico{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.ct{font-family:'Poppins',sans-serif;font-size:1rem;font-weight:700;color:var(--ink)}

/* ─── BUTTONS ─── */
.btn{display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.15rem;border-radius:10px;font-family:'Nunito',sans-serif;font-size:.84rem;font-weight:800;cursor:pointer;border:none;transition:all .18s;text-decoration:none;white-space:nowrap}
.btn:hover{transform:translateY(-1px)}
.btn-sm{padding:.4rem .85rem;font-size:.76rem}
.btn-xs{padding:.28rem .65rem;font-size:.7rem}
.bc{background:var(--coral);color:#fff;box-shadow:0 4px 14px rgba(255,107,107,.3)}
.bc:hover{background:var(--coral-dk)}
.bt{background:var(--teal);color:#fff;box-shadow:0 4px 14px rgba(32,201,160,.3)}
.bt:hover{background:var(--teal-dk)}
.bl{background:var(--lemon);color:var(--ink)}
.bv{background:var(--lilac);color:#fff;box-shadow:0 4px 14px rgba(167,139,250,.3)}
.bv:hover{background:#7c5ce4}
.bk{background:var(--sky);color:#fff}
.bo{background:var(--card);color:var(--ink-2);border:2px solid var(--border)}
.bo:hover{border-color:var(--coral);color:var(--coral)}
.bg{background:var(--bg);color:var(--ink-2);border:none}
.bg:hover{background:var(--border)}

/* Theme toggle button */
.theme-toggle {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 10000;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--card);
  border: 2px solid var(--border);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  box-shadow: var(--sh-lg);
  transition: all 0.3s;
}
.theme-toggle:hover {
  transform: scale(1.1);
}

/* ══════════════════════════════════════════════
   🤖 VOCAL AVATAR
══════════════════════════════════════════════ */
.vocal-layout{display:grid;grid-template-columns:280px 1fr;gap:1.5rem;padding:1.75rem}
.avatar-panel{display:flex;flex-direction:column;align-items:center;gap:1.1rem;position:relative}
.avatar-stage{width:200px;height:200px;border-radius:50%;position:relative;flex-shrink:0}
.avatar-ring{position:absolute;inset:-10px;border-radius:50%;border:2px solid rgba(255,107,107,.2);animation:ring-idle 3s ease-in-out infinite}
.avatar-ring:nth-child(2){inset:-20px;border-color:rgba(255,107,107,.1);animation-delay:.5s}
.avatar-ring:nth-child(3){inset:-32px;border-color:rgba(255,107,107,.06);animation-delay:1s}
@keyframes ring-idle{0%,100%{transform:scale(1);opacity:.6}50%{transform:scale(1.04);opacity:1}}
.avatar-stage.speaking .avatar-ring{animation:ring-speak .6s ease-in-out infinite}
.avatar-stage.speaking .avatar-ring:nth-child(2){animation-delay:.15s}
.avatar-stage.speaking .avatar-ring:nth-child(3){animation-delay:.3s}
@keyframes ring-speak{0%,100%{transform:scale(1);border-color:rgba(32,201,160,.4)}50%{transform:scale(1.08);border-color:rgba(32,201,160,.9)}}
.avatar-stage.listening .avatar-ring{animation:ring-listen .8s ease-in-out infinite}
.avatar-stage.listening .avatar-ring:nth-child(2){animation-delay:.2s}
.avatar-stage.listening .avatar-ring:nth-child(3){animation-delay:.4s}
@keyframes ring-listen{0%,100%{transform:scale(1);border-color:rgba(255,107,107,.3)}50%{transform:scale(1.06);border-color:rgba(255,107,107,.8)}}
.avatar-stage.thinking .avatar-ring{animation:ring-think 1.2s ease-in-out infinite}
@keyframes ring-think{0%,100%{transform:scale(1);border-color:rgba(255,217,61,.3)}50%{transform:scale(1.05);border-color:rgba(255,217,61,.8)}}
.avatar-face{width:200px;height:200px;border-radius:50%;overflow:hidden;position:relative;z-index:2;box-shadow:0 8px 32px rgba(30,27,58,.18);transition:transform .3s ease;border:4px solid var(--card)}
.avatar-stage.speaking .avatar-face{animation:face-speak .4s ease-in-out infinite alternate}
@keyframes face-speak{0%{transform:scale(1) translateY(0)}100%{transform:scale(1.02) translateY(-2px)}}
.avatar-stage.thinking .avatar-face{animation:face-think 1s ease-in-out infinite alternate}
@keyframes face-think{0%{transform:rotate(-2deg)}100%{transform:rotate(2deg)}}
.avatar-face img{width:100%;height:100%;object-fit:cover}
.avatar-face .av-bg{width:100%;height:100%;background:linear-gradient(135deg,#FFE8E8 0%,#E8F4FF 50%,#E8FFF6 100%);display:flex;align-items:center;justify-content:center;font-size:5rem}
.avatar-mouth-anim{position:absolute;bottom:38px;left:50%;transform:translateX(-50%);width:36px;height:16px;z-index:3;pointer-events:none;opacity:0;transition:opacity .2s}
.avatar-stage.speaking .avatar-mouth-anim{opacity:1}
.mouth-bar{position:absolute;bottom:0;border-radius:99px;background:rgba(255,255,255,.7);animation:mba .25s ease-in-out infinite alternate}
.mb1{width:4px;left:2px;height:8px;animation-delay:.00s}
.mb2{width:4px;left:8px;height:14px;animation-delay:.05s}
.mb3{width:4px;left:14px;height:10px;animation-delay:.10s}
.mb4{width:4px;left:20px;height:16px;animation-delay:.15s}
.mb5{width:4px;left:26px;height:8px;animation-delay:.10s}
.mb6{width:4px;left:32px;height:12px;animation-delay:.05s}
@keyframes mba{0%{transform:scaleY(.3)}100%{transform:scaleY(1)}}
.av-name{font-family:'Poppins',sans-serif;font-size:1rem;font-weight:800;color:var(--ink);text-align:center}
.av-status{font-size:.8rem;font-weight:700;text-align:center;padding:.35rem 1rem;border-radius:99px;transition:all .35s;background:var(--bg);color:var(--muted)}
.av-status.speaking{background:var(--teal-lt);color:var(--teal-dk);animation:st-pulse .8s infinite}
.av-status.listening{background:var(--coral-lt);color:var(--coral-dk);animation:st-pulse .8s infinite}
.av-status.thinking{background:var(--lemon-lt);color:#7a6000;animation:st-pulse 1.2s infinite}
.dark-mode .av-status.thinking{color:var(--lemon);}
.av-status.correct{background:var(--teal-lt);color:var(--teal-dk)}
.av-status.wrong{background:var(--coral-lt);color:var(--coral-dk)}
@keyframes st-pulse{0%,100%{opacity:1}50%{opacity:.6}}
.av-bubble{width:100%;background:var(--card);border-radius:16px;border:2px solid var(--border);padding:.9rem 1rem;font-size:.82rem;color:var(--ink-2);line-height:1.55;min-height:60px;position:relative;box-shadow:var(--sh);transition:all .3s}
.av-bubble::before{content:'';position:absolute;top:-10px;left:50%;transform:translateX(-50%);border:5px solid transparent;border-bottom-color:var(--border)}
.av-bubble::after{content:'';position:absolute;top:-7px;left:50%;transform:translateX(-50%);border:4px solid transparent;border-bottom-color:var(--card)}
.av-bubble.speaking-bubble{border-color:rgba(32,201,160,.4);background:var(--teal-lt)}
.av-bubble.listening-bubble{border-color:rgba(255,107,107,.4);background:var(--coral-lt)}
.av-bubble.thinking-bubble{border-color:rgba(255,217,61,.5);background:var(--lemon-lt)}
.av-bubble.correct-bubble{border-color:rgba(32,201,160,.5);background:var(--teal-lt)}
.av-bubble.wrong-bubble{border-color:rgba(255,107,107,.4);background:var(--coral-lt)}
.typing-dots{display:inline-flex;gap:3px;align-items:center}
.td{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:td-b .9s ease-in-out infinite}
.td:nth-child(1){animation-delay:.0s}.td:nth-child(2){animation-delay:.2s}.td:nth-child(3){animation-delay:.4s}
@keyframes td-b{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-5px);opacity:1}}
.av-actions{display:flex;flex-direction:column;gap:.45rem;width:100%}
.vocal-right{display:flex;flex-direction:column;gap:1.25rem}
.pb-wrap{width:100%}
.pb-track{height:10px;background:var(--bg);border-radius:99px;overflow:hidden}
.pb-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--coral),var(--lemon),var(--teal));transition:width .5s ease}
.pb-row{display:flex;justify-content:space-between;margin-top:.35rem;font-size:.75rem;color:var(--muted);font-weight:700}
.fc-show{border-radius:18px;background:linear-gradient(135deg,var(--card),var(--bg));border:2px solid var(--border);padding:2rem 1.75rem 1.5rem;min-height:170px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:.75rem;position:relative;box-shadow:0 3px 16px rgba(0,0,0,.07)}
.fc-badge{position:absolute;top:.85rem;left:50%;transform:translateX(-50%);padding:.25rem .85rem;border-radius:99px;font-size:.67rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;background:var(--coral-lt);color:var(--coral-dk);white-space:nowrap}
.fc-text{font-size:1.1rem;font-weight:700;color:var(--ink);line-height:1.55;margin-top:1.2rem}
.fc-ans{border-radius:14px;background:var(--teal-lt);border:2px solid rgba(32,201,160,.25);padding:1.1rem 1.35rem;display:none}
.fc-ans.on{display:block}
.fca-l{font-size:.67rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--teal-dk);margin-bottom:.35rem}
.fca-t{font-size:.88rem;color:var(--ink-2);line-height:1.55}
.nav-row{display:flex;align-items:center;gap:.65rem;flex-wrap:wrap}
.npill{font-family:'Poppins',sans-serif;font-weight:700;font-size:.88rem;color:var(--muted);background:var(--bg);border-radius:8px;padding:.42rem .95rem}
.mic-zone{background:var(--bg);border-radius:16px;padding:1.25rem;display:flex;flex-direction:column;gap:1rem;align-items:center;border:2px dashed var(--border);transition:all .3s}
.mic-zone.active{border-color:var(--coral);border-style:solid;background:var(--coral-lt)}
.mic-zone.analysing{border-color:var(--teal);border-style:solid;background:var(--teal-lt)}
.mic-row{display:flex;align-items:center;gap:1.15rem}
.mic-btn{width:80px;height:80px;border-radius:50%;border:none;cursor:pointer;font-size:1.75rem;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
.mi{background:linear-gradient(135deg,var(--coral),#FF8E53);color:#fff;box-shadow:0 6px 22px rgba(255,107,107,.4)}
.mi:hover{transform:scale(1.07) translateY(-2px)}
.mr{background:linear-gradient(135deg,#FF3B3B,var(--coral));color:#fff;animation:mp 1s infinite}
@keyframes mp{0%{box-shadow:0 0 0 0 rgba(255,59,59,.5)}70%{box-shadow:0 0 0 18px rgba(255,59,59,0)}100%{box-shadow:0 0 0 0 rgba(255,59,59,0)}}
.mic-st{font-size:.88rem;font-weight:700;color:var(--ink-2)}
.mic-hint{font-size:.73rem;color:var(--muted)}
.wf{display:flex;align-items:center;gap:3px;height:30px;margin-top:.2rem}
.wb{width:5px;border-radius:99px;background:linear-gradient(180deg,var(--coral),var(--lemon));animation:wba .8s ease-in-out infinite;opacity:0;transition:opacity .2s}
.wb:nth-child(1){height:9px;animation-delay:.00s}.wb:nth-child(2){height:17px;animation-delay:.08s}
.wb:nth-child(3){height:27px;animation-delay:.16s}.wb:nth-child(4){height:22px;animation-delay:.24s}
.wb:nth-child(5){height:31px;animation-delay:.32s}.wb:nth-child(6){height:22px;animation-delay:.24s}
.wb:nth-child(7){height:15px;animation-delay:.16s}.wb:nth-child(8){height:9px;animation-delay:.08s}
@keyframes wba{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}
.wf.live .wb{opacity:1}
.t-box{width:100%;background:var(--card);border:2px solid var(--border);border-radius:11px;padding:.85rem 1.1rem;font-size:.87rem;color:var(--ink-2);font-style:italic;line-height:1.55;display:none;min-height:48px}
.t-box.on{display:block}
.ai-res{border-radius:18px;overflow:hidden;box-shadow:var(--sh-lg);display:none;border:2px solid transparent}
.ai-res.on{display:block}
.air-h{display:flex;align-items:center;gap:.85rem;padding:1rem 1.35rem;font-family:'Poppins',sans-serif;font-weight:700;font-size:.92rem}
.air-b{padding:1.35rem;display:flex;flex-direction:column;gap:1rem;background:var(--card)}
.sc-row{display:flex;align-items:center;gap:1.25rem}
.sc-ci{width:80px;height:80px;border-radius:50%;flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative}
.sc-svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
.sc-svg circle{fill:none;stroke-width:6;stroke-linecap:round}
.sc-big{font-family:'Poppins',sans-serif;font-size:1.65rem;font-weight:800;line-height:1}
.sc-sub{font-size:.6rem;font-weight:700;color:var(--muted)}
.sc-v{font-family:'Poppins',sans-serif;font-size:1rem;font-weight:700;margin-bottom:.3rem}
.sc-t{font-size:.84rem;color:var(--ink-2);line-height:1.5}
.cmp-grid{display:grid;grid-template-columns:1fr 1fr;gap:.65rem}
.cmp{border-radius:11px;padding:.85rem 1rem}
.cms{background:var(--lilac-lt);border:1.5px solid rgba(167,139,250,.2)}
.cmc{background:var(--teal-lt);border:1.5px solid rgba(32,201,160,.2)}
.cl{font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:.3rem}
.cv{font-size:.81rem;color:var(--ink-2);line-height:1.5}
.nxt{display:flex;align-items:center;gap:.65rem;padding:.7rem 1rem;border-radius:9px;background:var(--lemon-lt);font-size:.81rem;font-weight:700;color:var(--ink-2)}
.dark-mode .nxt{color:var(--ink);}
.gen-body{padding:1.35rem 1.6rem}
.cnt-row{display:flex;align-items:center;gap:.85rem;margin-bottom:.9rem;flex-wrap:wrap}
.cnt-l{font-size:.83rem;font-weight:800;color:var(--ink-2)}
.cnt-btns{display:flex;gap:.35rem}
.cnt-btn{width:36px;height:36px;border-radius:8px;border:2px solid var(--border);background:var(--bg);font-family:'Poppins',sans-serif;font-weight:800;font-size:.84rem;cursor:pointer;transition:all .18s;color:var(--ink-2)}
.cnt-btn:hover{border-color:var(--coral);color:var(--coral)}
.cnt-btn.sel{background:var(--coral);color:#fff;border-color:var(--coral);box-shadow:0 3px 12px rgba(255,107,107,.28)}
.gin-row{display:flex;gap:.7rem}
.gin{flex:1;padding:.8rem 1.05rem;border:2px solid var(--border);border-radius:11px;font-family:'Nunito',sans-serif;font-size:.88rem;color:var(--ink);background:var(--bg);outline:none;transition:all .2s}
.gin:focus{border-color:var(--coral);background:var(--card);box-shadow:0 0 0 3px rgba(255,107,107,.1)}
.gin::placeholder{color:var(--muted)}
.gen-tip{font-size:.75rem;color:var(--muted);margin-top:.6rem}
.fcg{padding:1.4rem;display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:1rem}
.fcc{border-radius:17px;background:var(--card);border:2px solid var(--border);overflow:hidden;transition:all .2s;display:flex;flex-direction:column}
.fcc:hover{transform:translateY(-4px);box-shadow:var(--sh-lg);border-color:var(--lilac)}
.fcc-bar{height:5px}
.fcc:nth-child(4n+1) .fcc-bar{background:linear-gradient(90deg,var(--coral),#FF8E53)}
.fcc:nth-child(4n+2) .fcc-bar{background:linear-gradient(90deg,var(--teal),var(--sky))}
.fcc:nth-child(4n+3) .fcc-bar{background:linear-gradient(90deg,var(--lemon),#FFB347)}
.fcc:nth-child(4n+4) .fcc-bar{background:linear-gradient(90deg,var(--lilac),#C4B5FD)}
.fcc-img{height:140px;overflow:hidden;flex-shrink:0}
.fcc-img img{width:100%;height:100%;object-fit:cover}
.fcc-bd{padding:1.1rem;display:flex;flex-direction:column;flex:1}
.fcc-title{font-family:'Poppins',sans-serif;font-size:.9rem;font-weight:700;color:var(--ink);margin-bottom:.65rem}
.fl{font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:.2rem}
.fv{font-size:.8rem;color:var(--ink-2);line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:.7rem}
.fdiff{display:flex;gap:2px;margin-bottom:.6rem}
.fds{font-size:.7rem;color:var(--border)}.fds.on{color:var(--lemon)}
.fp-t{height:4px;background:var(--bg);border-radius:99px;overflow:hidden;margin-bottom:.15rem}
.fp-f{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--teal),var(--sky))}
.fp-l{font-size:.65rem;color:var(--muted);font-weight:700;text-align:right;margin-bottom:.7rem}
.fcc-acts{display:flex;gap:.45rem;margin-top:auto}
.fsb{width:32px;height:32px;border-radius:8px;border:2px solid var(--coral-lt);background:var(--coral-lt);color:var(--coral-dk);font-size:.88rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .18s;flex-shrink:0}
.fsb:hover{background:var(--coral);color:#fff;border-color:var(--coral)}
.delb{flex:1}.delb button{width:100%;padding:.4rem;border-radius:9px;border:none;background:var(--coral-lt);color:var(--coral-dk);font-weight:800;font-family:'Nunito',sans-serif;font-size:.76rem;cursor:pointer;transition:all .18s}
.delb button:hover{background:var(--coral);color:#fff}
.empty{display:flex;flex-direction:column;align-items:center;padding:3rem 1.5rem;gap:.75rem;text-align:center}
.eico{font-size:3rem}.etit{font-family:'Poppins',sans-serif;font-size:1.1rem;font-weight:700;color:var(--ink)}
.esub{font-size:.84rem;color:var(--muted)}
.ta{position:fixed;bottom:1.75rem;right:1.5rem;z-index:9999;display:flex;flex-direction:column;gap:.5rem}
.toast{display:flex;align-items:center;gap:.7rem;padding:.8rem 1.15rem;border-radius:13px;font-size:.83rem;font-weight:700;box-shadow:var(--sh-lg);max-width:340px;animation:tp .35s cubic-bezier(.34,1.56,.64,1)}
.tok{background:var(--teal-lt);color:var(--teal-dk);border:1.5px solid rgba(32,201,160,.25)}
.terr{background:var(--coral-lt);color:var(--coral-dk);border:1.5px solid rgba(255,107,107,.25)}
.tinf{background:var(--lilac-lt);color:var(--lilac);border:1.5px solid rgba(167,139,250,.25)}
@keyframes tp{from{opacity:0;transform:translateX(36px) scale(.88)}to{opacity:1;transform:none}}
.sp{width:16px;height:16px;border:2.5px solid rgba(0,0,0,.1);border-top-color:currentColor;border-radius:50%;animation:spin .65s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}

@media(max-width:900px){.vocal-layout{grid-template-columns:1fr;padding:1.25rem}.avatar-panel{flex-direction:row;align-items:flex-start}.avatar-stage{width:120px;height:120px}.avatar-face{width:120px;height:120px}.av-bubble::before,.av-bubble::after{display:none}.av-actions{flex-direction:row;flex-wrap:wrap}}
@media(max-width:600px){.stats{grid-template-columns:1fr}.stat+.stat{border-left:none;border-top:1px solid var(--border)}.cmp-grid{grid-template-columns:1fr}.gin-row{flex-direction:column}}

/* ══════════════════════════════════════════════
   🤖 CHATBOT STYLES
══════════════════════════════════════════════ */
#chatbot-fab {
  position: fixed; bottom: 2rem; right: 2rem; z-index: 9990;
  width: 62px; height: 62px; border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #EC4899);
  box-shadow: 0 8px 28px rgba(124,58,237,.45);
  border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.65rem;
  transition: transform .2s, box-shadow .2s;
}
#chatbot-fab:hover { transform: scale(1.1) translateY(-2px); box-shadow: 0 12px 36px rgba(124,58,237,.55); }
.fab-badge {
  position: absolute; top: -4px; right: -4px;
  width: 20px; height: 20px; border-radius: 50%;
  background: #EF4444; border: 2px solid #fff;
  font-size: .63rem; font-weight: 800; color: #fff;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transform: scale(0);
  transition: all .25s cubic-bezier(.34,1.56,.64,1);
}
.fab-badge.show { opacity: 1; transform: scale(1); }

#chatbot-window {
  position: fixed; bottom: 6.5rem; right: 2rem; z-index: 9991;
  width: min(420px, calc(100vw - 2rem));
  height: min(580px, calc(100vh - 9rem));
  background: var(--card); border-radius: 24px; overflow: hidden;
  display: flex; flex-direction: column;
  box-shadow: 0 24px 80px rgba(0,0,0,.18), 0 0 0 1px rgba(124,58,237,.12);
  transform-origin: bottom right;
  transition: transform .3s cubic-bezier(.34,1.56,.64,1), opacity .25s;
  transform: scale(0); opacity: 0; pointer-events: none;
}
#chatbot-window.open { transform: scale(1); opacity: 1; pointer-events: all; }

#cw-header {
  padding: 1rem 1.25rem .85rem;
  background: linear-gradient(135deg,#7C3AED 0%,#EC4899 100%);
  display: flex; align-items: center; gap: .75rem; flex-shrink: 0;
}
.cw-av { width:40px;height:40px;border-radius:50%;overflow:hidden;border:2px solid rgba(255,255,255,.35);flex-shrink:0;background:rgba(255,255,255,.2) }
.cw-av img { width:100%;height:100%;object-fit:cover }
.cw-info { flex: 1 }
.cw-name { font-weight:800;font-size:.88rem;color:#fff;line-height:1.2 }
.cw-sub  { font-size:.72rem;color:rgba(255,255,255,.75) }
.cw-online { width:8px;height:8px;border-radius:50%;background:#4ADE80;border:1.5px solid #fff;margin-right:.35rem;display:inline-block;animation:blink 2s infinite }
@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}
.cw-close { width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.2);border:none;cursor:pointer;color:#fff;font-size:1rem;font-weight:700;display:flex;align-items:center;justify-content:center;transition:background .15s }
.cw-close:hover { background:rgba(255,255,255,.35) }

#cw-context { padding:.5rem 1rem;background:#F5F3FF;border-bottom:1px solid #E9D5FF;font-size:.72rem;font-weight:700;color:#6D28D9;display:flex;align-items:center;gap:.4rem;flex-shrink:0 }

#cw-msgs { flex:1;overflow-y:auto;padding:1rem;display:flex;flex-direction:column;gap:.75rem;scroll-behavior:smooth;background:var(--bg) }
#cw-msgs::-webkit-scrollbar { width:4px }
#cw-msgs::-webkit-scrollbar-thumb { background:#DDD6FE;border-radius:99px }

.msg-row { display:flex;gap:.5rem;align-items:flex-end }
.msg-row.user { flex-direction:row-reverse }
.msg-av { width:28px;height:28px;border-radius:50%;overflow:hidden;flex-shrink:0;border:1.5px solid #E9D5FF;background:#F5F3FF }
.msg-av img { width:100%;height:100%;object-fit:cover }
.msg-av.user-av { background:linear-gradient(135deg,var(--coral),#FF8E53);border-color:transparent;display:flex;align-items:center;justify-content:center;font-size:.85rem;color:#fff; }
.msg-bubble { max-width:80%;padding:.65rem .9rem;border-radius:18px;font-size:.82rem;line-height:1.55;word-break:break-word }
.msg-bubble.ai { background:var(--lilac-lt);color:var(--ink);border-bottom-left-radius:4px }
.msg-bubble.user { background:linear-gradient(135deg,#7C3AED,#EC4899);color:#fff;border-bottom-right-radius:4px }
.msg-bubble strong { font-weight:700 }
.msg-bubble em { font-style:italic }
.msg-bubble ul { padding-left:1.2em;margin:.35em 0 }
.msg-bubble li { margin:.15em 0 }
.msg-bubble code { background:rgba(0,0,0,.08);border-radius:4px;padding:.1em .35em;font-size:.85em;font-family:monospace }
.msg-bubble.user code { background:rgba(255,255,255,.2) }
.msg-time { font-size:.65rem;color:#9CA3AF;margin-top:.15rem;text-align:right }
.msg-row.user .msg-time { text-align:left }

.typing-ind { display:flex;align-items:center;gap:.25rem;padding:.55rem .85rem;background:var(--lilac-lt);border-radius:18px;border-bottom-left-radius:4px;width:fit-content }
.t-dot { width:6px;height:6px;border-radius:50%;background:#7C3AED;animation:tda .9s ease-in-out infinite }
.t-dot:nth-child(2){animation-delay:.2s}.t-dot:nth-child(3){animation-delay:.4s}
@keyframes tda{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-5px);opacity:1}}

#cw-suggestions { padding:.6rem .85rem;display:flex;gap:.4rem;flex-wrap:wrap;border-top:1px solid var(--border);flex-shrink:0 }
.sug-btn { font-size:.7rem;font-weight:700;padding:.3rem .75rem;border-radius:99px;border:1.5px solid var(--lilac);background:var(--lilac-lt);color:var(--lilac);cursor:pointer;transition:all .15s;white-space:nowrap }
.sug-btn:hover { background:#7C3AED;color:#fff;border-color:transparent }

#cw-footer { padding:.75rem;border-top:1px solid var(--border);display:flex;gap:.5rem;align-items:flex-end;background:var(--card);flex-shrink:0 }
#cw-input { flex:1;resize:none;border:2px solid var(--border);border-radius:14px;padding:.65rem .9rem;font-size:.83rem;line-height:1.45;color:var(--ink);background:var(--bg);outline:none;min-height:42px;max-height:120px;font-family:'Nunito',sans-serif;transition:border-color .2s;overflow-y:auto }
#cw-input:focus { border-color:#7C3AED;background:var(--card) }
#cw-input::placeholder { color:#9CA3AF }
#cw-send { width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#7C3AED,#EC4899);border:none;cursor:pointer;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .15s,box-shadow .15s;box-shadow:0 4px 12px rgba(124,58,237,.3) }
#cw-send:hover:not(:disabled) { transform:scale(1.08) translateY(-1px);box-shadow:0 6px 18px rgba(124,58,237,.4) }
#cw-send:disabled { opacity:.5;cursor:default }

@media(max-width:480px){
  #chatbot-window { width:calc(100vw - 1rem);right:.5rem;bottom:5.5rem }
  #chatbot-fab { right:1rem;bottom:1.5rem }
}

/* ══════════════════════════════════════════════
   🔍 ANALYZE CARDS MODAL STYLES
══════════════════════════════════════════════ */
.prob-card{
    border-radius:14px; padding:1.1rem 1.25rem; margin-bottom:.85rem;
    border:2px solid transparent; position:relative;
}
.prob-grave{ background:var(--coral-lt); border-color:var(--coral); }
.prob-moyen{ background:var(--lemon-lt); border-color:var(--lemon); }
.prob-faible{ background:var(--teal-lt); border-color:var(--teal); }
.prob-badge{
    display:inline-block; padding:.2rem .7rem; border-radius:99px;
    font-size:.68rem; font-weight:800; text-transform:uppercase;
    letter-spacing:.08em; margin-bottom:.5rem;
}
.badge-grave{ background:var(--coral); color:#fff; }
.badge-moyen{ background:var(--lemon); color:#1E1B3A; }
.dark-mode .badge-moyen{ color:var(--ink); }
.badge-faible{ background:var(--teal); color:#fff; }

/* ══════════════════════════════════════════════
   ✨ AI PREMIUM BUTTONS + 3D ROBOT
══════════════════════════════════════════════ */
.hero-btns{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}

/* ROBOT BANNER */
.robot-hero-wrap{display:flex;align-items:center;gap:1rem;padding:.75rem 1.25rem;background:linear-gradient(135deg,rgba(124,58,237,.06),rgba(236,72,153,.04));border-radius:16px;border:1.5px solid rgba(124,58,237,.12);margin-bottom:.85rem}
.dark-mode .robot-hero-wrap{background:linear-gradient(135deg,rgba(124,58,237,.2),rgba(236,72,153,.15));border-color:rgba(124,58,237,.3);}
.robot-scene-sm{width:64px;height:64px;perspective:400px;cursor:pointer;flex-shrink:0}
.robot-3d-sm{width:100%;height:100%;position:relative;transform-style:preserve-3d;animation:r-float 3s ease-in-out infinite}
@keyframes r-float{0%,100%{transform:translateY(0) rotateY(-10deg) rotateX(4deg)}50%{transform:translateY(-6px) rotateY(10deg) rotateX(-2deg)}}
.robot-scene-sm:hover .robot-3d-sm{animation:r-spin 1s ease-in-out infinite}
@keyframes r-spin{0%{transform:rotateY(-25deg) translateY(-2px)}50%{transform:rotateY(25deg) translateY(-8px)}100%{transform:rotateY(-25deg) translateY(-2px)}}
.robot-svg-sm{width:64px;height:64px;filter:drop-shadow(0 0 12px rgba(139,92,246,.65)) drop-shadow(0 0 24px rgba(59,130,246,.25))}
.robot-ring-sm{position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);width:44px;height:8px;background:radial-gradient(ellipse,rgba(139,92,246,.45) 0%,transparent 70%);border-radius:50%;animation:r-ring 3s ease-in-out infinite}
@keyframes r-ring{0%,100%{opacity:.5;transform:translateX(-50%) scaleX(1)}50%{opacity:1;transform:translateX(-50%) scaleX(1.15)}}
.robot-hero-title{font-family:'Syne',sans-serif;font-size:.9rem;font-weight:800;background:linear-gradient(135deg,#7c3aed,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:.15rem}
.robot-hero-sub{font-size:.72rem;color:var(--muted);font-weight:600}
.robot-status-dot{width:7px;height:7px;border-radius:50%;background:#4ade80;box-shadow:0 0 8px #4ade80;animation:s-blink 2s infinite;display:inline-block;margin-right:.35rem}
@keyframes s-blink{0%,100%{opacity:1}50%{opacity:.35}}

/* TRANSLATE AI BUTTON */
.btn-translate-ai{position:relative;display:inline-flex;align-items:center;gap:.6rem;padding:.6rem 1.3rem .6rem .85rem;border:none;border-radius:100px;cursor:pointer;font-family:'Syne',sans-serif;font-size:.82rem;font-weight:700;letter-spacing:.02em;color:#fff;background:transparent;overflow:hidden;transition:transform .2s,box-shadow .2s;outline:none;text-decoration:none}
.btn-translate-ai::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,#0ea5e9 0%,#6366f1 50%,#8b5cf6 100%);border-radius:inherit;z-index:0}
.btn-translate-ai::after{content:'';position:absolute;inset:1px;background:linear-gradient(135deg,#0c4a6e 0%,#312e81 100%);border-radius:inherit;z-index:0;opacity:.82;transition:opacity .3s}
.btn-translate-ai:hover::after{opacity:.55}
.btn-translate-ai:hover{transform:translateY(-2px) scale(1.04);box-shadow:0 8px 28px rgba(99,102,241,.5),0 0 0 1px rgba(99,102,241,.3)}
.btn-translate-ai:active{transform:scale(.97)}
.btn-translate-ai .btn-inner{position:relative;z-index:1;display:flex;align-items:center;gap:.55rem}
.btn-translate-ai .t-icon{width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:.95rem;transition:transform .3s}
.btn-translate-ai:hover .t-icon{transform:rotate(15deg) scale(1.1)}
.btn-translate-ai .t-shimmer{position:absolute;top:-50%;left:-60%;width:45%;height:200%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.18),transparent);transform:skewX(-20deg);z-index:2;transition:left .55s;pointer-events:none}
.btn-translate-ai:hover .t-shimmer{left:140%}

/* ANALYZE AI BUTTON */
.btn-analyze-ai{position:relative;display:inline-flex;align-items:center;gap:.6rem;padding:.6rem 1.3rem .6rem .8rem;border:none;border-radius:100px;cursor:pointer;font-family:'Syne',sans-serif;font-size:.82rem;font-weight:700;letter-spacing:.02em;color:#fff;overflow:hidden;transition:transform .2s,box-shadow .2s;outline:none;background:transparent}
.btn-analyze-ai::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,#7c3aed 0%,#a855f7 45%,#ec4899 100%);border-radius:inherit;z-index:0}
.btn-analyze-ai::after{content:'';position:absolute;inset:1px;border-radius:inherit;background:linear-gradient(135deg,#4c1d95 0%,#6d28d9 60%,#9d174d 100%);z-index:0;opacity:.72;transition:opacity .3s}
.btn-analyze-ai:hover::after{opacity:.42}
.btn-analyze-ai:hover{transform:translateY(-2px) scale(1.04);box-shadow:0 8px 28px rgba(168,85,247,.55),0 0 0 1px rgba(168,85,247,.35),0 0 50px rgba(168,85,247,.18)}
.btn-analyze-ai:active{transform:scale(.97)}
.btn-analyze-ai .btn-inner{position:relative;z-index:1;display:flex;align-items:center;gap:.55rem}
.btn-analyze-ai .a-icon{width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.22);display:flex;align-items:center;justify-content:center;font-size:1rem;position:relative;overflow:hidden;transition:transform .3s}
.btn-analyze-ai:hover .a-icon{transform:rotate(-12deg) scale(1.15)}
.btn-analyze-ai .a-icon::after{content:'';position:absolute;top:-100%;left:0;width:100%;height:40%;background:linear-gradient(transparent,rgba(167,139,250,.45),transparent);animation:ai-scan 2s linear infinite}
@keyframes ai-scan{to{top:200%}}
.btn-analyze-ai .a-pulse{position:absolute;inset:-2px;border-radius:100px;border:2px solid rgba(168,85,247,.65);animation:a-pulse-ring 2s ease-out infinite;pointer-events:none;z-index:3}
.btn-analyze-ai .a-pulse:nth-child(2){animation-delay:.75s}
@keyframes a-pulse-ring{0%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.18)}}
.btn-analyze-ai .a-dot{position:absolute;width:3px;height:3px;border-radius:50%;background:#e879f9;z-index:2;pointer-events:none;animation:a-dot-float 3s ease-in-out infinite}
.btn-analyze-ai .a-dot:nth-child(3){top:25%;right:22%;animation-delay:0s}
.btn-analyze-ai .a-dot:nth-child(4){top:60%;right:14%;animation-delay:.55s;width:2px;height:2px;background:#a78bfa}
.btn-analyze-ai .a-dot:nth-child(5){top:38%;right:32%;animation-delay:1.1s;width:2px;height:2px;background:#67e8f9}
@keyframes a-dot-float{0%,100%{transform:translateY(0) scale(1);opacity:.8}50%{transform:translateY(-4px) scale(1.3);opacity:1}}
.btn-analyze-ai .a-shimmer{position:absolute;top:-50%;left:-60%;width:45%;height:200%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent);transform:skewX(-20deg);z-index:2;transition:left .5s;pointer-events:none}
.btn-analyze-ai:hover .a-shimmer{left:140%}
.btn-analyze-ai .a-badge{position:absolute;top:-6px;right:-6px;background:linear-gradient(135deg,#f59e0b,#ef4444);color:#fff;font-size:.5rem;font-weight:800;letter-spacing:.06em;padding:.12rem .38rem;border-radius:99px;z-index:10;box-shadow:0 2px 8px rgba(239,68,68,.5);font-family:'Syne',sans-serif;animation:badge-in .5s cubic-bezier(.34,1.56,.64,1) both}
@keyframes badge-in{from{transform:scale(0) rotate(-20deg);opacity:0}to{transform:scale(1) rotate(0);opacity:1}}

</style>

