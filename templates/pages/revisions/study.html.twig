      <button onclick="openTranslationModal()" class="btn-translate-ai">
        <span class="t-shimmer"></span>
        <span class="btn-inner">
          <span class="t-icon">🌍</span>
          Translate
        </span>
      </button>

      {# ── ANALYZE AI BUTTON ── #}
      <button onclick="analyzeCards()" class="btn-analyze-ai">
        <span class="a-pulse"></span>
        <span class="a-pulse"></span>
        <span class="a-shimmer"></span>
        <span class="a-dot"></span>
        <span class="a-dot"></span>
        <span class="a-dot"></span>
