{% extends 'base.html.twig' %}
{% block title %}Study {{ deck.titre }} - RLIFE{% endblock %}
{% block body %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-gray-900 dark:to-gray-950 py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-6">
        {# Section Deck #}
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden">
          
            {# Titre "Deck" en haut #}
            <div class="bg-white dark:bg-gray-800 px-6 py-4 border-b border-slate-200 dark:border-gray-700">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Deck</h1>
                </div>
            </div>

            {# Image du deck #}
            <div class="relative h-72 md:h-96 overflow-hidden">
                {% if deck.image %}
                    <img src="{{ asset('uploads/decks/' ~ deck.image) }}"
                         alt="{{ deck.titre }}"
                         class="w-full h-full object-cover">
                {% else %}
                    <div class="w-full h-full bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800"></div>
                {% endif %}
            </div>

            {# Infos sous l'image #}
            <div class="p-6 md:p-8 bg-white dark:bg-gray-800">
                <h2 class="text-3xl md:text-4xl font-bold text-secondary-900 dark:text-white mb-4">
                    {{ deck.titre }}
                </h2>

                <div class="flex flex-wrap items-center gap-3 mb-6">
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-primary-100 text-primary-800 dark:bg-primary-900/30 dark:text-primary-300">
                        {{ deck.matiere }}
                    </span>
                    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-accent-100 text-accent-800 dark:bg-accent-900/30 dark:text-accent-300">
                        Niveau {{ deck.niveau }}
                    </span>
                  
                    <a href="{{ path('app_revisions') }}"
                       class="inline-flex items-center gap-2 px-4 py-2 bg-secondary-100 hover:bg-secondary-200 dark:bg-secondary-800 dark:hover:bg-secondary-700 text-secondary-700 dark:text-secondary-200 rounded-lg transition font-medium text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to decks
                    </a>

                    {% if deck.pdf %}
                    <a href="{{ asset('uploads/decks/' ~ deck.pdf) }}"
                       target="_blank"
                       class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition font-medium text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        View / Download PDF
                    </a>
                    {% endif %}
                </div>

                {% if deck.description %}
                <p class="text-sm text-secondary-500 dark:text-secondary-400 leading-relaxed">
                    {{ deck.description }}
                </p>
                {% endif %}
            </div>

            {# Statistiques #}
            <div class="p-6 bg-secondary-50 dark:bg-gray-900/50 border-t border-secondary-200 dark:border-gray-700">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    {# Total Flashcards #}
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow border border-secondary-200 dark:border-gray-700">
                        <div class="flex items-start justify-between">
                            <div class="w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                            </div>
                        </div>
                        <div class="mt-4">
                            <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ flashcards|length }}</p>
                            <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-1">Total Flashcards</p>
                        </div>
                    </div>

                    {# Mastered #}
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow border border-secondary-200 dark:border-gray-700">
                        <div class="flex items-start justify-between">
                            <div class="w-11 h-11 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-success-600 dark:text-success-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-success-100 text-success-800 dark:bg-success-900/30 dark:text-success-300">
                                0%
                            </span>
                        </div>
                        <div class="mt-4">
                            <p class="text-3xl font-bold text-secondary-900 dark:text-white">0</p>
                            <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-1">Mastered</p>
                        </div>
                    </div>

                    {# To Review #}
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow border border-secondary-200 dark:border-gray-700">
                        <div class="flex items-start justify-between">
                            <div class="w-11 h-11 rounded-xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-warning-600 dark:text-warning-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-warning-100 text-warning-800 dark:bg-warning-900/30 dark:text-warning-300">
                                Pending
                            </span>
                        </div>
                        <div class="mt-4">
                            <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ flashcards|length }}</p>
                            <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-1">To Review</p>
                        </div>
                    </div>
                </div>
            </div>

            {# ──────────────────────────────────────────────── #}
            {# NOUVEAU : Génération IA Gemini #}
            {# ──────────────────────────────────────────────── #}
            <div class="p-6 bg-gradient-to-r from-primary-50/50 to-accent-50/50 dark:from-primary-950/30 dark:to-accent-950/30 border-t border-secondary-200 dark:border-gray-700">
                <div class="max-w-3xl mx-auto">
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                        <div>
                            <h3 class="text-xl font-bold text-secondary-900 dark:text-white flex items-center gap-3 mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                </svg>
                                Générer des flashcards avec l'IA
                            </h3>
                            <p class="text-sm text-secondary-600 dark:text-secondary-400">
                                Décrivez un thème, un chapitre ou un sujet et l'IA créera automatiquement des cartes d'apprentissage.
                            </p>
                        </div>

                        <form method="post" action="{{ path('app_deck_generate_flashcards', {id: deck.idDeck}) }}" class="w-full md:w-auto flex flex-col sm:flex-row gap-3">
                            <input 
                                type="text" 
                                name="theme" 
                                placeholder="Ex : Photosynthèse, Révolution tunisienne, Fractions, TCP/IP..." 
                                required 
                                class="flex-1 px-5 py-3 bg-white dark:bg-gray-800 border border-secondary-300 dark:border-gray-600 rounded-xl text-secondary-900 dark:text-white placeholder-secondary-500 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent min-w-[280px]"
                            >
                            <button 
                                type="submit"
                                class="px-6 py-3 bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white font-semibold rounded-xl transition shadow-md flex items-center justify-center gap-2 whitespace-nowrap"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                                Générer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            {# Fin du bloc IA #}

            {# Section Flashcards #}
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden mt-6">
                <div class="p-6 border-b border-secondary-200 dark:border-gray-700">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <h2 class="text-2xl font-bold text-secondary-900 dark:text-white flex items-center gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                            Flashcards
                        </h2>
                        <a href="{{ path('app_flashcard_new', {deck_id: deck.idDeck}) }}"
                           class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg transition shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            Add Flashcard
                        </a>
                    </div>
                </div>

                <div class="p-6 bg-secondary-50 dark:bg-gray-900/50">
                    {% if flashcards is empty %}
                    <div class="text-center py-20">
                        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-secondary-100 dark:bg-secondary-800 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-secondary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold text-secondary-900 dark:text-white mb-2">No flashcards yet</h3>
                        <p class="text-secondary-500 dark:text-secondary-400 mb-8">Add your first flashcard to start studying</p>
                        <a href="{{ path('app_flashcard_new', {deck_id: deck.idDeck}) }}"
                           class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg transition shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            Create first flashcard
                        </a>
                    </div>
                    {% else %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        {% for flashcard in flashcards %}
                        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-secondary-100 dark:border-gray-700">
                            {% if flashcard.image %}
                            <div class="h-48 overflow-hidden">
                                <img src="{{ asset('uploads/flashcards/' ~ flashcard.image) }}"
                                     alt="{{ flashcard.titre|default('Flashcard') }}"
                                     class="w-full h-full object-cover">
                            </div>
                            {% endif %}

                            <div class="p-6">
                                {% if flashcard.titre %}
                                <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-3">
                                    {{ flashcard.titre }}
                                </h3>
                                {% endif %}

                                <div class="mb-4">
                                    <p class="text-xs font-medium text-secondary-600 dark:text-secondary-400 mb-2">Question</p>
                                    <p class="text-sm text-secondary-600 dark:text-secondary-300 line-clamp-3">
                                        {{ flashcard.question }}
                                    </p>
                                </div>

                                <div class="mb-4">
                                    <p class="text-xs font-medium text-secondary-600 dark:text-secondary-400 mb-2">Réponse</p>
                                    <p class="text-sm text-secondary-600 dark:text-secondary-300 line-clamp-3">
                                        {{ flashcard.reponse }}
                                    </p>
                                </div>

                                <div class="flex items-center gap-3 mb-4 text-sm">
                                    <span class="inline-flex items-center gap-1.5 text-secondary-500 dark:text-secondary-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                        </svg>
                                        <span class="font-medium">Q & A</span>
                                    </span>
                                    {% if flashcard.etat != 'active' %}
                                    <span class="inline-flex items-center gap-1.5 text-secondary-500 dark:text-secondary-400">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        <span class="font-medium">{{ flashcard.etat|capitalize }}</span>
                                    </span>
                                    {% endif %}
                                </div>

                                <div class="mb-4">
                                    <div class="flex items-center justify-between text-xs mb-1.5">
                                        <span class="font-medium text-secondary-500 dark:text-secondary-400">Progress</span>
                                        <span class="font-bold text-secondary-900 dark:text-white">
                                            {{ (flashcard.niveauDifficulte|default(0) * 20) }}%
                                        </span>
                                    </div>
                                    <div class="w-full h-2 bg-secondary-100 dark:bg-gray-700 rounded-full overflow-hidden">
                                        <div class="h-full rounded-full transition-all bg-gradient-to-r from-primary-400 to-primary-600" style="width: {{ (flashcard.niveauDifficulte|default(0) * 20) }}%"></div>
                                    </div>
                                </div>

                                <div class="flex gap-2 pt-2">
                                    <a href="{{ path('app_flashcard_edit', {id: flashcard.id}) }}"
                                       class="flex-1 text-center py-2.5 rounded-lg font-semibold text-sm transition-all bg-primary-50 hover:bg-primary-100 dark:bg-primary-900/20 dark:text-primary-300 dark:hover:bg-primary-900/30">
                                        Edit
                                    </a>
                                    <form method="post" action="{{ path('app_flashcard_delete', {id: flashcard.id}) }}"
                                          onsubmit="return confirm('Delete this flashcard?');" class="flex-1">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flashcard.id) }}">
                                        <button type="submit" class="w-full py-2.5 bg-secondary-100 hover:bg-secondary-200 text-secondary-700 dark:bg-gray-700 dark:hover:bg-gray-600 dark:text-secondary-200 rounded-lg font-semibold text-sm transition-all">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}