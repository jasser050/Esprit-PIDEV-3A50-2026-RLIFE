    <div class="stat"><div class="sico st">⭐</div><div><div class="sn" id="s-master">0</div><div class="ss">Mastered</div></div></div>
    <div class="stat"><div class="sico sl">🎯</div><div><div class="sn" id="s-avg">–</div><div class="ss">Avg. Score</div></div></div>
