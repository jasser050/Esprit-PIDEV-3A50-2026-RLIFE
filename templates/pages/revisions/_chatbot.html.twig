{# ═══════════════════════════════════════════════════════════════
   🤖 DECK CHATBOT — _chatbot.html.twig
   Include this in study.html.twig with:
   {{ include('pages/revisions/_chatbot.html.twig') }}
═══════════════════════════════════════════════════════════════ #}

<style>
/* ─── Chatbot floating button ─── */
#chatbot-fab {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 9990;
  width: 60px; height: 60px;
  border-radius: 50%;
  background: linear-gradient(135deg,#7C3AED,#EC4899);
  box-shadow: 0 8px 28px rgba(124,58,237,.45);
  border: none;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.6rem;
  transition: transform .2s, box-shadow .2s;
}
#chatbot-fab:hover { transform: scale(1.1) translateY(-2px); box-shadow: 0 12px 36px rgba(124,58,237,.55); }
#chatbot-fab .fab-badge {
  position: absolute; top: -4px; right: -4px;
  width: 20px; height: 20px; border-radius: 50%;
  background: #EF4444;
  border: 2px solid #fff;
  font-size: .65rem; font-weight: 800; color: #fff;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transform: scale(0);
  transition: all .25s cubic-bezier(.34,1.56,.64,1);
}
#chatbot-fab .fab-badge.show { opacity:1; transform:scale(1); }

/* ─── Chat window ─── */
#chatbot-window {
  position: fixed;
  bottom: 6.5rem;
  right: 2rem;
  z-index: 9991;
  width: min(420px, calc(100vw - 2rem));
  height: min(580px, calc(100vh - 9rem));
  background: #fff;
  border-radius: 24px;
  overflow: hidden;
  display: flex; flex-direction: column;
  box-shadow: 0 24px 80px rgba(0,0,0,.18), 0 0 0 1px rgba(124,58,237,.12);
  transform-origin: bottom right;
  transition: transform .3s cubic-bezier(.34,1.56,.64,1), opacity .25s;
  transform: scale(0); opacity: 0; pointer-events: none;
}
.dark #chatbot-window { background: #1E1B3A; box-shadow: 0 24px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(124,58,237,.2); }
#chatbot-window.open { transform: scale(1); opacity: 1; pointer-events: all; }

/* Header */
#cw-header {
  padding: 1rem 1.25rem .85rem;
  background: linear-gradient(135deg,#7C3AED 0%,#EC4899 100%);
  display: flex; align-items: center; gap: .75rem; flex-shrink: 0;
}
.cw-av {
  width: 40px; height: 40px; border-radius: 50%; overflow: hidden;
  border: 2px solid rgba(255,255,255,.35); flex-shrink: 0;
  background: rgba(255,255,255,.2);
}
.cw-av img { width: 100%; height: 100%; object-fit: cover; }
.cw-info { flex: 1; }
.cw-name { font-weight: 800; font-size: .88rem; color: #fff; line-height: 1.2; }
.cw-sub  { font-size: .72rem; color: rgba(255,255,255,.75); }
.cw-online { width: 8px; height: 8px; border-radius: 50%; background: #4ADE80; border: 1.5px solid #fff; margin-right: .35rem; display: inline-block; animation: blink 2s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.4} }
.cw-close {
  width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,.2);
  border: none; cursor: pointer; color: #fff; font-size: 1rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center; transition: background .15s;
}
.cw-close:hover { background: rgba(255,255,255,.35); }

/* Deck context pill */
#cw-context {
  padding: .5rem 1rem;
  background: #F5F3FF;
  border-bottom: 1px solid #E9D5FF;
  font-size: .72rem; font-weight: 700; color: #6D28D9;
  display: flex; align-items: center; gap: .4rem;
  flex-shrink: 0;
}
.dark #cw-context { background: rgba(124,58,237,.15); border-color: rgba(124,58,237,.25); color: #C4B5FD; }

/* Messages area */
#cw-msgs {
  flex: 1; overflow-y: auto; padding: 1rem;
  display: flex; flex-direction: column; gap: .75rem;
  scroll-behavior: smooth;
}
#cw-msgs::-webkit-scrollbar { width: 4px; }
#cw-msgs::-webkit-scrollbar-track { background: transparent; }
#cw-msgs::-webkit-scrollbar-thumb { background: #DDD6FE; border-radius: 99px; }

/* Bubble */
.msg-row { display: flex; gap: .5rem; align-items: flex-end; }
.msg-row.user { flex-direction: row-reverse; }

.msg-av {
  width: 28px; height: 28px; border-radius: 50%; overflow: hidden;
  flex-shrink: 0; border: 1.5px solid #E9D5FF;
  background: #F5F3FF;
}
.msg-av img { width: 100%; height: 100%; object-fit: cover; }
.msg-av.user-av { background: linear-gradient(135deg,#FF6B6B,#FF8E53); border-color: transparent; display: flex; align-items: center; justify-content: center; font-size: .85rem; }

.msg-bubble {
  max-width: 80%;
  padding: .65rem .9rem;
  border-radius: 18px;
  font-size: .82rem;
  line-height: 1.55;
  word-break: break-word;
}
.msg-bubble.ai {
  background: #F5F3FF;
  color: #1F2937;
  border-bottom-left-radius: 4px;
}
.dark .msg-bubble.ai { background: rgba(124,58,237,.15); color: #E5E7EB; }
.msg-bubble.user {
  background: linear-gradient(135deg,#7C3AED,#EC4899);
  color: #fff;
  border-bottom-right-radius: 4px;
}

/* Markdown inside bubbles */
.msg-bubble strong { font-weight: 700; }
.msg-bubble em { font-style: italic; }
.msg-bubble ul { padding-left: 1.2em; margin: .35em 0; }
.msg-bubble li { margin: .15em 0; }
.msg-bubble code { background: rgba(0,0,0,.08); border-radius: 4px; padding: .1em .35em; font-size: .85em; font-family: monospace; }
.dark .msg-bubble.ai code { background: rgba(255,255,255,.1); }
.msg-bubble.user code { background: rgba(255,255,255,.2); }
.msg-bubble p + p { margin-top: .4em; }

/* Timestamp */
.msg-time { font-size: .65rem; color: #9CA3AF; margin-top: .15rem; text-align: right; }
.msg-row.user .msg-time { text-align: left; }

/* Typing indicator */
.typing-ind { display: flex; align-items: center; gap: .25rem; padding: .55rem .85rem; background: #F5F3FF; border-radius: 18px; border-bottom-left-radius: 4px; width: fit-content; }
.dark .typing-ind { background: rgba(124,58,237,.15); }
.td { width: 6px; height: 6px; border-radius: 50%; background: #7C3AED; animation: tda .9s ease-in-out infinite; }
.td:nth-child(2){animation-delay:.2s}.td:nth-child(3){animation-delay:.4s}
@keyframes tda { 0%,60%,100%{transform:translateY(0);opacity:.4} 30%{transform:translateY(-5px);opacity:1} }

/* Suggestions / quick prompts */
#cw-suggestions {
  padding: .6rem .85rem;
  display: flex; gap: .4rem; flex-wrap: wrap;
  border-top: 1px solid #F3F4F6;
  flex-shrink: 0;
}
.dark #cw-suggestions { border-color: rgba(255,255,255,.06); }
.sug-btn {
  font-size: .7rem; font-weight: 700; padding: .3rem .75rem;
  border-radius: 99px; border: 1.5px solid #DDD6FE;
  background: #F5F3FF; color: #6D28D9; cursor: pointer;
  transition: all .15s; white-space: nowrap;
}
.sug-btn:hover { background: #7C3AED; color: #fff; border-color: transparent; }
.dark .sug-btn { background: rgba(124,58,237,.15); border-color: rgba(124,58,237,.3); color: #C4B5FD; }
.dark .sug-btn:hover { background: #7C3AED; color: #fff; }

/* Input zone */
#cw-footer {
  padding: .75rem;
  border-top: 1px solid #F3F4F6;
  display: flex; gap: .5rem; align-items: flex-end;
  background: #fff;
  flex-shrink: 0;
}
.dark #cw-footer { background: #1E1B3A; border-color: rgba(255,255,255,.06); }
#cw-input {
  flex: 1;
  resize: none;
  border: 2px solid #E9D5FF;
  border-radius: 14px;
  padding: .65rem .9rem;
  font-size: .83rem;
  line-height: 1.45;
  color: #1F2937;
  background: #FAFAFA;
  outline: none;
  min-height: 42px; max-height: 120px;
  font-family: inherit;
  transition: border-color .2s;
  overflow-y: auto;
}
.dark #cw-input { background: rgba(255,255,255,.06); color: #F3F4F6; border-color: rgba(124,58,237,.3); }
#cw-input:focus { border-color: #7C3AED; background: #fff; }
.dark #cw-input:focus { background: rgba(255,255,255,.08); }
#cw-input::placeholder { color: #9CA3AF; }

#cw-send {
  width: 42px; height: 42px; border-radius: 50%;
  background: linear-gradient(135deg,#7C3AED,#EC4899);
  border: none; cursor: pointer; color: #fff;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: transform .15s, box-shadow .15s;
  box-shadow: 0 4px 12px rgba(124,58,237,.3);
}
#cw-send:hover:not(:disabled) { transform: scale(1.08) translateY(-1px); box-shadow: 0 6px 18px rgba(124,58,237,.4); }
#cw-send:disabled { opacity: .5; cursor: default; }

/* Scroll to bottom btn */
#scroll-btn {
  position: absolute; bottom: 9rem; right: 1rem;
  width: 32px; height: 32px; border-radius: 50%;
  background: #7C3AED; color: #fff; border: none; cursor: pointer;
  display: none; align-items: center; justify-content: center;
  font-size: .85rem; box-shadow: 0 4px 12px rgba(124,58,237,.35);
  z-index: 9999;
}
#scroll-btn.show { display: flex; }

/* Empty state */
.chat-empty {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; padding: 1.5rem; gap: .75rem;
  color: #9CA3AF;
}
.chat-empty .ce-icon { font-size: 2.5rem; }
.chat-empty .ce-title { font-weight: 700; font-size: .9rem; color: #4B5563; }
.dark .chat-empty .ce-title { color: #D1D5DB; }
.chat-empty .ce-sub { font-size: .78rem; }

/* Responsive */
@media (max-width: 480px) {
  #chatbot-window { width: calc(100vw - 1rem); right: .5rem; bottom: 5.5rem; }
  #chatbot-fab    { right: 1rem; bottom: 1.5rem; }
}
</style>

{# ─── FAB button ─── #}
<button id="chatbot-fab" onclick="toggleChatbot()" aria-label="Open deck chatbot" title="Chat with AI about this deck">
  🤖
  <span id="fab-badge" class="fab-badge">!</span>
</button>

{# ─── Chat window ─── #}
<div id="chatbot-window" role="dialog" aria-label="Deck AI Chatbot">

  {# Header #}
  <div id="cw-header">
    <div class="cw-av">
      <img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed,ec4899"
           alt="AI" onerror="this.style.display='none'">
    </div>
    <div class="cw-info">
      <div class="cw-name">
        <span class="cw-online"></span>RLIFE AI Tutor
      </div>
      <div class="cw-sub">Expert on: <strong>{{ deck.titre }}</strong></div>
    </div>
    <button class="cw-close" onclick="toggleChatbot()">✕</button>
  </div>

  {# Context pill #}
  <div id="cw-context">
    📚 <span>{{ deck.matiere }}</span>
    &nbsp;·&nbsp;
    🎯 <span>Level {{ deck.niveau }}</span>
    &nbsp;·&nbsp;
    🃏 <span>{{ flashcards|length }} cards loaded</span>
  </div>

  {# Messages #}
  <div id="cw-msgs">
    {# Initial AI message #}
    <div class="msg-row" id="welcome-msg">
      <div class="msg-av">
        <img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed,ec4899" alt="AI">
      </div>
      <div>
        <div class="msg-bubble ai">
          👋 Hi! I'm your AI tutor for <strong>{{ deck.titre }}</strong>.<br>
          I've read all <strong>{{ flashcards|length }} flashcards</strong> and I'm ready to help you!<br><br>
          You can ask me to:
          <ul>
            <li>Explain any concept from the deck</li>
            <li>Quiz you on the content 🎯</li>
            <li>Give you memory tricks 🧠</li>
            <li>Summarise key ideas</li>
          </ul>
          What would you like to work on?
        </div>
        <div class="msg-time">Just now</div>
      </div>
    </div>
  </div>

  {# Scroll to bottom #}
  <button id="scroll-btn" onclick="scrollToBottom()" title="Scroll to bottom">↓</button>

  {# Quick suggestions #}
  <div id="cw-suggestions">
    <button class="sug-btn" onclick="sendSuggestion('Quiz me on the hardest cards')">🎯 Quiz me</button>
    <button class="sug-btn" onclick="sendSuggestion('Summarise the key concepts of this deck')">📋 Summary</button>
    <button class="sug-btn" onclick="sendSuggestion('Give me memory tricks for this subject')">🧠 Memory tricks</button>
    <button class="sug-btn" onclick="sendSuggestion('What should I focus on the most?')">🔥 Focus areas</button>
  </div>

  {# Input #}
  <div id="cw-footer">
    <textarea
      id="cw-input"
      placeholder="Ask anything about {{ deck.titre }}…"
      rows="1"
      onkeydown="handleKey(event)"
      oninput="autoGrow(this)"></textarea>
    <button id="cw-send" onclick="sendMessage()" aria-label="Send">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"/>
        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
    </button>
  </div>
</div>

<script>
(function() {
  /* ── State ── */
  const DECK_ID   = {{ deck.id }};
  const API_URL   = `/revisions/deck/${DECK_ID}/chat`;
  let chatOpen    = false;
  let isLoading   = false;
  let history     = [];
  let unread      = 0;

  const win     = document.getElementById('chatbot-window');
  const msgs    = document.getElementById('cw-msgs');
  const input   = document.getElementById('cw-input');
  const sendBtn = document.getElementById('cw-send');
  const badge   = document.getElementById('fab-badge');
  const scrollBtn = document.getElementById('scroll-btn');

  /* ── Toggle window ── */
  window.toggleChatbot = function() {
    chatOpen = !chatOpen;
    win.classList.toggle('open', chatOpen);
    if (chatOpen) {
      unread = 0;
      badge.classList.remove('show');
      setTimeout(() => { input.focus(); scrollToBottom(); }, 350);
    }
  };

  /* ── Auto-grow textarea ── */
  window.autoGrow = function(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 120) + 'px';
  };

  /* ── Handle Enter (send) vs Shift+Enter (newline) ── */
  window.handleKey = function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  };

  /* ── Quick suggestion ── */
  window.sendSuggestion = function(text) {
    input.value = text;
    autoGrow(input);
    sendMessage();
  };

  /* ── Scroll ── */
  window.scrollToBottom = function(smooth = true) {
    msgs.scrollTo({ top: msgs.scrollHeight, behavior: smooth ? 'smooth' : 'instant' });
  };

  msgs.addEventListener('scroll', () => {
    const atBottom = msgs.scrollHeight - msgs.scrollTop - msgs.clientHeight < 60;
    scrollBtn.classList.toggle('show', !atBottom);
  });

  /* ── Render simple markdown ── */
  function renderMarkdown(text) {
    return text
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/^### (.+)$/gm, '<strong>$1</strong>')
      .replace(/^## (.+)$/gm, '<strong>$1</strong>')
      .replace(/^- (.+)$/gm, '<li>$1</li>')
      .replace(/(<li>[\s\S]+?<\/li>)/g, '<ul>$1</ul>')
      .replace(/\n\n/g, '<br><br>')
      .replace(/\n/g, '<br>');
  }

  /* ── Append a message bubble ── */
  function appendMsg(role, content, animate = true) {
    const isAI = role === 'assistant';
    const now = new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});

    const row = document.createElement('div');
    row.className = 'msg-row ' + (isAI ? '' : 'user');
    if (animate) { row.style.opacity = '0'; row.style.transform = 'translateY(8px)'; }

    const av = document.createElement('div');
    av.className = isAI ? 'msg-av' : 'msg-av user-av';
    if (isAI) {
      av.innerHTML = '<img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed,ec4899" alt="AI">';
    } else {
      av.textContent = '👤';
    }

    const wrap = document.createElement('div');
    const bubble = document.createElement('div');
    bubble.className = 'msg-bubble ' + (isAI ? 'ai' : 'user');
    bubble.innerHTML = isAI ? renderMarkdown(content) : escHtml(content).replace(/\n/g,'<br>');

    const time = document.createElement('div');
    time.className = 'msg-time';
    time.textContent = now;

    wrap.append(bubble, time);
    row.append(av, wrap);
    msgs.appendChild(row);

    if (animate) {
      requestAnimationFrame(() => {
        row.style.transition = 'opacity .25s, transform .25s';
        row.style.opacity = '1';
        row.style.transform = 'none';
      });
    }

    scrollToBottom();
    return bubble;
  }

  /* ── Typing indicator ── */
  function showTyping() {
    const row = document.createElement('div');
    row.id = 'typing-row';
    row.className = 'msg-row';
    const av = document.createElement('div');
    av.className = 'msg-av';
    av.innerHTML = '<img src="https://api.dicebear.com/7.x/bottts/svg?seed=rlife-ai&backgroundColor=7c3aed,ec4899" alt="AI">';
    const ind = document.createElement('div');
    ind.className = 'typing-ind';
    ind.innerHTML = '<div class="td"></div><div class="td"></div><div class="td"></div>';
    row.append(av, ind);
    msgs.appendChild(row);
    scrollToBottom();
  }

  function hideTyping() {
    document.getElementById('typing-row')?.remove();
  }

  /* ── Send message ── */
  window.sendMessage = async function() {
    const text = input.value.trim();
    if (!text || isLoading) return;

    input.value = '';
    input.style.height = 'auto';
    isLoading = true;
    sendBtn.disabled = true;

    // Append user bubble
    appendMsg('user', text);
    history.push({ role: 'user', content: text });

    // Show typing
    showTyping();

    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history: history.slice(0, -1) }),
      });

      const data = await res.json();
      hideTyping();

      if (data.error) {
        appendMsg('assistant', '❌ ' + data.error);
        return;
      }

      const reply = data.reply || 'No response.';
      appendMsg('assistant', reply);
      history.push({ role: 'assistant', content: reply });

      // Notify if window is closed
      if (!chatOpen) {
        unread++;
        badge.textContent = unread > 9 ? '9+' : unread;
        badge.classList.add('show');
      }

    } catch (err) {
      hideTyping();
      appendMsg('assistant', '❌ Connection error. Please try again.');
      console.error('Chatbot error:', err);
    } finally {
      isLoading = false;
      sendBtn.disabled = false;
      input.focus();
    }
  };

  function escHtml(t) {
    const d = document.createElement('div');
    d.textContent = t;
    return d.innerHTML;
  }

  /* ── Keyboard shortcut: Alt+C to toggle ── */
  document.addEventListener('keydown', e => {
    if (e.altKey && e.key === 'c') toggleChatbot();
  });

})();
</script>
