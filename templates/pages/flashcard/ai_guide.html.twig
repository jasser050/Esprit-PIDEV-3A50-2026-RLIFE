{% extends 'base.html.twig' %}

{% block title %}Flashcard Guide — Create the Perfect Card{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  theme: {
    extend: {
      fontFamily: { inter: ['Inter', 'sans-serif'] },
      colors: {
        emerald: { 400:'#34d399', 500:'#10b981', 600:'#059669' },
        amber:   { 400:'#fbbf24', 500:'#f59e0b', 600:'#d97706' },
      }
    }
  }
}
</script>
<style>
* { font-family: 'Inter', sans-serif; box-sizing: border-box; color: black; }

/* ─── FLIP CARD ─── */
.flip-scene {
  perspective: 1200px;
  cursor: pointer;
}
.flip-card {
  position: relative;
  width: 100%;
  transition: transform 0.7s cubic-bezier(0.4, 0.2, 0.2, 1);
  transform-style: preserve-3d;
}
.flip-scene.flipped .flip-card {
  transform: rotateY(180deg);
}
.flip-face {
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}
.flip-back {
  position: absolute;
  inset: 0;
  transform: rotateY(180deg);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* ─── SHIMMER ─── */
@keyframes shimmer {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}
.shimmer-text {
  background: linear-gradient(90deg, #10b981, #fbbf24, #10b981);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 3s linear infinite;
}

/* ─── PULSE RING ─── */
@keyframes pulse-ring {
  0%   { transform: scale(1);   opacity: 0.6; }
  100% { transform: scale(1.5); opacity: 0;   }
}
.pulse-ring::before {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 9999px;
  border: 2px solid #10b981;
  animation: pulse-ring 1.5s ease-out infinite;
}

/* ─── FLOAT ─── */
@keyframes float {
  0%, 100% { transform: translateY(0px);  }
  50%       { transform: translateY(-6px); }
}
.float { animation: float 3s ease-in-out infinite; }

/* ─── SLIDE IN ─── */
@keyframes slideInUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0);    }
}
.slide-in { animation: slideInUp 0.5s ease both; }

/* ─── TAB ACTIVE ─── */
.model-tab.active {
  background: linear-gradient(135deg, #10b981, #059669);
  color: white !important;
  box-shadow: 0 4px 15px rgba(16,185,129,0.35);
}

/* ─── QUALITY BAR ANIMATE ─── */
.q-bar-fill {
  height: 100%;
  border-radius: 9999px;
  width: 0;
  transition: width 1s cubic-bezier(0.4,0,0.2,1);
}

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-thumb { background: #10b981; border-radius: 9999px; }

/* ─── HINT BOUNCE ─── */
@keyframes bounce-x {
  0%, 100% { transform: translateX(0); }
  50%       { transform: translateX(4px); }
}
.bounce-hint { animation: bounce-x 1.2s ease-in-out infinite; }

/* ─── GRADIENT BORDER ─── */
.gradient-border {
  position: relative;
  border-radius: 1.25rem;
  padding: 1px;
  background: linear-gradient(135deg, #10b981, #fbbf24, #ec4899);
}
.gradient-border-inner {
  background: white;
  border-radius: calc(1.25rem - 1px);
}

/* ─── GLOWING BTN ─── */
.btn-glow {
  box-shadow: 0 0 20px rgba(16,185,129,0.4);
  transition: box-shadow 0.3s, transform 0.2s;
}
.btn-glow:hover {
  box-shadow: 0 0 35px rgba(16,185,129,0.65);
  transform: translateY(-2px);
}

/* ─── TYPING DOTS ─── */
@keyframes dot-bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40%            { transform: scale(1.1); opacity: 1;   }
}
.dot-1 { animation: dot-bounce 1.2s infinite; }
.dot-2 { animation: dot-bounce 1.2s 0.2s infinite; }
.dot-3 { animation: dot-bounce 1.2s 0.4s infinite; }

/* ─── STEP CONNECTOR ─── */
.step-line::after {
  content: '';
  position: absolute;
  left: 50%; top: 48px;
  width: 2px; height: calc(100% + 24px);
  background: linear-gradient(180deg, #10b981, transparent);
  transform: translateX(-50%);
}

/* Override white text on dark/colored backgrounds */
.flip-face *,
.flip-back *,
.bg-gradient-to-r.from-emerald-500 *,
.bg-gradient-to-br.from-emerald-500 *,
.bg-gradient-to-br.from-gray-900 *,
.bg-gradient-to-br.from-gray-900 p,
.bg-gradient-to-br.from-gray-900 span,
.bg-gradient-to-br.from-gray-900 div,
.bg-gradient-to-r.from-gray-900 *,
[class*="bg-gradient-to"][class*="from-gray-9"] *,
[class*="bg-gradient-to"][class*="from-emerald"] *,
[class*="bg-gradient-to"][class*="from-blue-6"] *,
[class*="bg-gradient-to"][class*="from-amber-5"] *,
[class*="bg-gradient-to"][class*="from-rose-6"] *,
[class*="bg-gradient-to"][class*="from-teal-6"] *,
[class*="bg-gradient-to"][class*="from-violet-6"] *,
[class*="bg-gradient-to"][class*="from-indigo"] * {
  color: inherit;
}
</style>
{% endblock %}

