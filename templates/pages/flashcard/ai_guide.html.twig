    <div class="bg-gradient-to-r from-gray-900 to-gray-800 rounded-3xl p-8 text-center relative overflow-hidden">
      <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, #10b981 1px, transparent 0); background-size: 32px 32px;"></div>
      <p class="text-gray-400 text-xs font-700 uppercase tracking-widest mb-4">The formula for a perfect flashcard</p>
      <div class="flex flex-wrap justify-center items-center gap-3 text-base font-700">
        <span class="bg-emerald-500/20 text-emerald-400 px-4 py-2 rounded-xl border border-emerald-500/30">1 concept</span>
        <span class="text-gray-600 text-xl">+</span>
        <span class="bg-amber-500/20 text-amber-400 px-4 py-2 rounded-xl border border-amber-500/30">precise question</span>
        <span class="text-gray-600 text-xl">+</span>
        <span class="bg-blue-500/20 text-blue-400 px-4 py-2 rounded-xl border border-blue-500/30">memorable answer</span>
        <span class="text-gray-600 text-xl">+</span>
        <span class="bg-pink-500/20 text-pink-400 px-4 py-2 rounded-xl border border-pink-500/30">concrete example</span>
      </div>
    </div>

    <!-- ████ SECTION 3 — QUALITY ████ -->
    <section id="quality">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 text-emerald-600 text-xs font-700 uppercase tracking-widest mb-3">
          <div class="w-8 h-px bg-emerald-400"></div>Quality Rules<div class="w-8 h-px bg-emerald-400"></div>
        </div>
        <h2 class="text-3xl font-800 text-gray-900 mb-3">The 8 rules of a perfect flashcard</h2>
        <p class="text-gray-500 max-w-xl mx-auto">Based on cognitive science research and the SRS method.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {%- set rules = [
          {n:'1',color:'emerald',icon:'🎯',t:'1 concept per card',d:'1 card = 1 idea. If you want to write "and also…", make a 2nd card.'},
          {n:'2',color:'blue',icon:'❓',t:'Precise and direct question',d:'Avoid "Explain chapter 3". Prefer "What is the par value of a share?"'},
          {n:'3',color:'teal',icon:'✍️',t:'Short and memorable answer',d:'Max 2–3 sentences. If the answer is 10 lines long, split into multiple cards.'},
          {n:'4',color:'amber',icon:'🧠',t:'Use your own words',d:'Rephrase rather than copy-paste. The brain retains what it has processed.'},
          {n:'5',color:'orange',icon:'💡',t:'Add a concrete example',d:'Examples anchor abstract concepts. Put them in the description.'},
          {n:'6',color:'violet',icon:'🏷️',t:'Descriptive and unique title',d:'The title must let you find the card again. "Definition 1" = bad title.'},
          {n:'7',color:'sky',icon:'⭐',t:'Honest difficulty level',d:'1 = instant answer. 5 = really have to think. Be honest with yourself.'},
          {n:'8',color:'rose',icon:'✅',t:'Can you actually answer it?',d:'Before saving, cover the answer and try to respond. If you get stuck, rewrite.'},
        ] -%}
        {% for r in rules %}
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200 group">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-xl bg-{{ r.color }}-100 flex items-center justify-center text-{{ r.color }}-600 font-800 text-sm">{{ r.n }}</div>
            <span class="text-xl">{{ r.icon }}</span>
          </div>
          <h4 class="font-700 text-gray-900 text-sm mb-2">{{ r.t }}</h4>
          <p class="text-xs text-gray-500 leading-relaxed">{{ r.d }}</p>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- ████ SECTION 4 — EXAMPLES ████ -->
    <section id="examples">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 text-emerald-600 text-xs font-700 uppercase tracking-widest mb-3">
          <div class="w-8 h-px bg-emerald-400"></div>Real Examples<div class="w-8 h-px bg-emerald-400"></div>
        </div>
        <h2 class="text-3xl font-800 text-gray-900 mb-3">Good vs Bad — See the difference</h2>
        <p class="text-gray-500 max-w-xl mx-auto">Examples drawn from the most common mistakes.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-rose-50 border border-rose-200 rounded-3xl p-6">
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-xl bg-rose-100 flex items-center justify-center text-rose-500 font-800 text-sm">✗</div>
            <span class="font-800 text-rose-700 text-sm uppercase tracking-wide">Bad Practices</span>
          </div>
          <div class="space-y-3">
            <div class="bg-white rounded-2xl p-4 border border-rose-100">
              <p class="text-sm text-gray-700 mb-1">❌ <strong>Question:</strong> "Tell me about DNA"</p>
              <p class="text-xs text-rose-400">→ Too vague, unpredictable answer</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-rose-100">
              <p class="text-sm text-gray-700 mb-1">❌ <strong>Answer:</strong> [15-line paragraph copy-pasted from notes]</p>
              <p class="text-xs text-rose-400">→ Not memorable, too dense</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-rose-100">
              <p class="text-sm text-gray-700 mb-1">❌ <strong>Title:</strong> "Card 1"</p>
              <p class="text-xs text-rose-400">→ Impossible to find in the deck</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-rose-100">
              <p class="text-sm text-gray-700 mb-1">❌ <strong>Multi-concept:</strong> "Describe mitosis AND meiosis AND their differences"</p>
              <p class="text-xs text-rose-400">→ 3 cards in one = cognitive overload</p>
            </div>
          </div>
        </div>
        <div class="bg-emerald-50 border border-emerald-200 rounded-3xl p-6">
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-600 font-800 text-sm">✓</div>
            <span class="font-800 text-emerald-700 text-sm uppercase tracking-wide">Good Practices</span>
          </div>
          <div class="space-y-3">
            <div class="bg-white rounded-2xl p-4 border border-emerald-100">
              <p class="text-sm text-gray-700 mb-1">✅ <strong>Question:</strong> "What is DNA and what is its role?"</p>
              <p class="text-xs text-emerald-500">→ Targeted, testable, clear</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-emerald-100">
              <p class="text-sm text-gray-700 mb-1">✅ <strong>Answer:</strong> "DNA is a double helix molecule containing genetic instructions."</p>
              <p class="text-xs text-emerald-500">→ 1–2 sentences, memorable</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-emerald-100">
              <p class="text-sm text-gray-700 mb-1">✅ <strong>Title:</strong> "DNA — Definition and role"</p>
              <p class="text-xs text-emerald-500">→ Clear, findable, descriptive</p>
            </div>
            <div class="bg-white rounded-2xl p-4 border border-emerald-100">
              <p class="text-sm text-gray-700 mb-1">✅ <strong>1 concept:</strong> "What is the difference between mitosis and meiosis?" (dedicated card)</p>
              <p class="text-xs text-emerald-500">→ Focused, effective, reviewable</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ████ SECTION 5 — DIFFICULTY ████ -->
    <section id="difficulty">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 text-emerald-600 text-xs font-700 uppercase tracking-widest mb-3">
          <div class="w-8 h-px bg-emerald-400"></div>Difficulty Levels<div class="w-8 h-px bg-emerald-400"></div>
        </div>
        <h2 class="text-3xl font-800 text-gray-900 mb-3">Choosing the right level</h2>
        <p class="text-gray-500 max-w-xl mx-auto">The level influences the review frequency in the SRS system. Be precise!</p>
      </div>
      <div class="space-y-3">
        {%- set levels = [
          {stars:'⭐',n:1,label:'Easy',color:'emerald',desc:'Memorized — you answer instantly without effort.',eg:'Ex: "What is the capital of France?" → Paris'},
          {stars:'⭐⭐',n:2,label:'Simple',color:'teal',desc:'You need 2–3 seconds but you know the answer.',eg:'Ex: Water formula → H₂O with 2 H, 1 O'},
          {stars:'⭐⭐⭐',n:3,label:'Medium',color:'amber',desc:'Concept to understand, not just memorize. Requires thinking.',eg:'Ex: Explain the principle of conservation of energy'},
          {stars:'⭐⭐⭐⭐',n:4,label:'Hard',color:'orange',desc:'Complex topic — you hesitate or often make mistakes.',eg:'Ex: Prove Gödel\'s theorem or analyze O(n log n) complexity'},
          {stars:'⭐⭐⭐⭐⭐',n:5,label:'Expert',color:'rose',desc:'Advanced concept requiring multiple intensive review sessions.',eg:'Ex: Prove the residue theorem or multi-step integration by parts'},
        ] -%}
        {% for l in levels %}
        <div class="bg-white border border-gray-100 rounded-2xl px-5 py-4 shadow-sm hover:shadow-md hover:border-{{ l.color }}-200 transition-all duration-200 flex items-center gap-4 flex-wrap">
          <div class="text-lg min-w-24">{{ l.stars }}</div>
          <div class="w-20">
            <span class="text-xs font-700 text-{{ l.color }}-600 bg-{{ l.color }}-50 px-2.5 py-1 rounded-full">Lvl. {{ l.n }}</span>
          </div>
          <div class="flex-1 min-w-48">
            <p class="font-700 text-gray-900 text-sm mb-0.5">{{ l.label }}</p>
            <p class="text-gray-500 text-xs">{{ l.desc }}</p>
          </div>
          <div class="text-xs text-gray-400 italic">{{ l.eg }}</div>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- ████ SECTION 6 — TIPS ████ -->
    <section id="tips">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 text-emerald-600 text-xs font-700 uppercase tracking-widest mb-3">
          <div class="w-8 h-px bg-emerald-400"></div>Expert Tips<div class="w-8 h-px bg-emerald-400"></div>
        </div>
        <h2 class="text-3xl font-800 text-gray-900 mb-3">10 learning tips</h2>
        <p class="text-gray-500 max-w-xl mx-auto">Drawn from neuroscience research and the habits of top students.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {%- set tips = [
          {e:'🔁',t:'Spaced repetition',d:'Review at D+1, D+3, D+7, D+14. Scientifically proven.'},
          {e:'🔊',t:'Say the answer out loud',d:'Before flipping. Auditory memory reinforces visual memory.'},
          {e:'✍️',t:'Write before looking',d:'Writing the answer on paper activates deep memorization.'},
          {e:'🌙',t:'Review before sleeping',d:'Sleep consolidates memories. It really works!'},
          {e:'📱',t:'Create right after class',d:'80% of information is forgotten within 24h without review.'},
          {e:'🏷️',t:'Use the description field',d:'For classic traps, common mistakes, and exceptions.'},
          {e:'🖼️',t:'Add an image',d:'The brain retains 60% better with a visual support.'},
          {e:'📚',t:'Group by topic',d:'Separate decks by subject. Avoid catch-all decks.'},
          {e:'❓',t:'10 seconds max',d:'If you can\'t answer in 10s, the card is too difficult.'},
          {e:'🎯',t:'Quality > Quantity',d:'50 good cards > 200 sloppy cards. Always.'},
        ] -%}
        {% for tip in tips %}
        <div class="bg-white border border-gray-100 rounded-2xl p-5 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200">
          <div class="text-2xl mb-3">{{ tip.e }}</div>
          <h4 class="font-700 text-gray-900 text-sm mb-2">{{ tip.t }}</h4>
          <p class="text-xs text-gray-500 leading-relaxed">{{ tip.d }}</p>
        </div>
        {% endfor %}
      </div>
    </section>

    <!-- ████ FOOTER CTA ████ -->
    <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-3xl p-10 text-center relative overflow-hidden shadow-2xl">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
      <div class="relative">
        <div class="text-5xl mb-5 float">🚀</div>
        <h2 class="text-3xl font-800 text-white mb-3">Ready to create your perfect flashcard?</h2>
        <p class="text-emerald-100 mb-8 max-w-md mx-auto">You have all the tools — templates, tips, and AI analysis. Go for it!</p>
        <a href="{{ path('app_flashcard_new', {deck_id: deckId}) }}"
          class="inline-flex items-center gap-3 bg-white text-emerald-700 font-800 px-8 py-4 rounded-2xl shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-200 text-base">
          ✨ Create my flashcard now
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>

  </div><!-- end container -->
</div><!-- end page -->
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
/* ── MODEL TABS ── */
function showModel(name, btn) {
  document.querySelectorAll('.model-panel').forEach(p => p.classList.add('hidden'));
  document.querySelectorAll('.model-tab').forEach(b => b.classList.remove('active'));
  const panel = document.getElementById('panel-' + name);
  panel.classList.remove('hidden');
  panel.style.animation = 'none';
  requestAnimationFrame(() => { panel.style.animation = ''; });
  btn.classList.add('active');
  animateQBars(panel);
}

/* ── QUALITY BARS ── */
function animateQBars(panel) {
  panel.querySelectorAll('.q-bar-fill').forEach(el => {
    el.style.width = '0';
    requestAnimationFrame(() => {
      setTimeout(() => { el.style.width = el.dataset.width + '%'; }, 120);
    });
  });
}

/* ── COPY TEMPLATES ── */
const templates = {
  definition: `TITLE: [Term] — Definition\n\nQUESTION:\nWhat is [term / concept]?\n\nANSWER:\n[Term] is [definition in 1-2 sentences].\n\nDESCRIPTION (optional):\nExample: [concrete example]\nCommon mistake: [trap to avoid]`,
  process:    `TITLE: [Process] — Steps\n\nQUESTION:\nWhat are the [N] steps of [process] in order?\n\nANSWER:\n1. [Step 1] — [short description]\n2. [Step 2] — [short description]\n3. [Step 3] — [short description]\n\nDESCRIPTION (optional):\nMnemonic: [memory aid]`,
  compare:    `TITLE: [A] vs [B] — Comparison\n\nQUESTION:\nWhat is the difference between [A] and [B]?\n\nANSWER:\n[A]:\n→ [characteristic 1]\n→ [characteristic 2]\n\n[B]:\n→ [characteristic 1]\n→ [characteristic 2]\n\nCommon point: [similarity]`,
  cause:      `TITLE: [Event] — Causes & Effects\n\nQUESTION:\nWhy did [event / phenomenon] occur?\n\nANSWER:\nMain causes:\n① [Cause 1]\n② [Cause 2]\n③ [Cause 3]\n\nEffect(s): [result / consequence]`,
  formula:    `TITLE: [Formula name]\n\nQUESTION:\nWhat is the formula for [quantity] and what do its variables represent?\n\nANSWER:\n[Formula]\n\nWhere:\n→ [variable 1] = [meaning] (unit)\n→ [variable 2] = [meaning] (unit)\n\nNumerical example: [calculation with real numbers]`,
  qcm:        `TITLE: [Subject] — MCQ\n\nQUESTION:\n[Direct question on the subject?]\n\nA) [Option A]\nB) [Option B]\nC) [CORRECT ANSWER]\nD) [Option D]\n\nANSWER:\nCorrect: C) [Correct answer]\n\nWhy the others are wrong:\n→ A) [Explanation]\n→ B) [Explanation]\n→ D) [Explanation]`
};

function copyTemplate(type) {
  const btn = document.getElementById('copy-' + type) || event.target;
  navigator.clipboard.writeText(templates[type]).then(() => {
    const orig = btn.innerHTML;
    btn.innerHTML = '✅ Copied!';
    btn.classList.add('bg-emerald-50', 'border-emerald-400', 'text-emerald-600');
    setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('bg-emerald-50','border-emerald-400','text-emerald-600'); }, 2000);
  }).catch(() => alert('Template copied!'));
}

/* ── AI FUNCTIONS ── */
function setLoading(btnId, label) {
  const btn = document.getElementById(btnId);
  btn.disabled = true;
  btn.innerHTML = `<span class="flex items-center gap-2"><span class="dot-1 w-2 h-2 rounded-full bg-white inline-block"></span><span class="dot-2 w-2 h-2 rounded-full bg-white inline-block"></span><span class="dot-3 w-2 h-2 rounded-full bg-white inline-block"></span> ${label}</span>`;
  return btn;
}
function resetBtn(btn, label) { btn.disabled = false; btn.innerHTML = label; }

function showResult(html) {
  const el = document.getElementById('ai-result');
  el.classList.remove('hidden');
  document.getElementById('ai-result-inner').innerHTML = html;
}

async function doAnalyze() {
  const q = document.getElementById('ai-q').value.trim();
  const r = document.getElementById('ai-r').value.trim();
  if (!q && !r) { showResult('<p class="text-amber-600 font-600">⚠️ Enter a question or answer to analyze.</p>'); return; }

  const btn = setLoading('btn-analyze', 'Analyzing…');
  showResult('<div class="flex items-center gap-3 text-gray-500"><span class="dot-1 w-2 h-2 bg-emerald-400 rounded-full inline-block"></span><span class="dot-2 w-2 h-2 bg-emerald-400 rounded-full inline-block"></span><span class="dot-3 w-2 h-2 bg-emerald-400 rounded-full inline-block"></span> AI is analyzing your card…</div>');

  const prompt = `You are an expert in pedagogy and memorization techniques (SRS, spaced repetition, cognitive load). Analyze this flashcard:\n\nQUESTION: ${q || "(not provided)"}\nANSWER: ${r || "(not provided)"}\n\nProvide a structured analysis in 4 parts:\n1. 🎯 QUALITY SCORE (out of 10) with a 1-sentence justification\n2. ✅ STRENGTHS (2-3 positive points)\n3. ⚠️ AREAS FOR IMPROVEMENT (2-3 concrete suggestions)\n4. 💡 IMPROVED VERSION (suggest a rewritten question AND answer)\n\nBe direct, concise, and constructive. Reply in English.`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1000, messages: [{ role: 'user', content: prompt }] })
    });
    const data = await res.json();
    const text = data.content?.map(c => c.text || '').join('\n') || '';
    showResult(text ? `<pre class="whitespace-pre-wrap font-inter text-sm leading-relaxed text-gray-700">${escHtml(text)}</pre>` : '<p class="text-rose-500">❌ No response received.</p>');
  } catch(e) { showResult(localAnalysis(q, r)); }
  resetBtn(btn, '🔍 Analyze with AI');
}

async function doGenerate() {
  const q = document.getElementById('ai-q').value.trim();
  if (!q) { showResult('<p class="text-amber-600 font-600">⚠️ Paste a text or concept in the "Question" field to generate.</p>'); return; }

  const btn = setLoading('btn-generate', 'Generating…');
  showResult('<div class="flex items-center gap-3 text-gray-500"><span class="dot-1 w-2 h-2 bg-amber-400 rounded-full inline-block"></span><span class="dot-2 w-2 h-2 bg-amber-400 rounded-full inline-block"></span><span class="dot-3 w-2 h-2 bg-amber-400 rounded-full inline-block"></span> Generating your flashcard…</div>');

  const prompt = `From the following text, generate 2–3 pedagogically optimized flashcards:\n\nTEXT: ${q}\n\nFor each flashcard:\n- TITLE: [descriptive title]\n- QUESTION: [precise and testable question]\n- ANSWER: [short answer, 1–3 sentences max]\n- LEVEL: [1-5]\n- TEMPLATE: [Definition/Process/Comparison/Cause-Effect/Formula]\n\nReply in English.`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 1000, messages: [{ role: 'user', content: prompt }] })
    });
    const data = await res.json();
    const text = data.content?.map(c => c.text || '').join('\n') || '';
    showResult(text ? `<pre class="whitespace-pre-wrap font-inter text-sm leading-relaxed text-gray-700">${escHtml(text)}</pre>` : '<p class="text-rose-500">❌ Generation failed.</p>');
  } catch(e) { showResult('<p class="text-rose-500">❌ Connection error. Check your API key.</p>'); }
  resetBtn(btn, '✨ Generate a flashcard');
}

function doClear() {
  document.getElementById('ai-q').value = '';
  document.getElementById('ai-r').value = '';
  document.getElementById('ai-result').classList.add('hidden');
}

function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function localAnalysis(q, r) {
  let score = 7, goods = [], issues = [];
  if(q) {
    if(q.length < 15) { issues.push('⚠️ Question too short — add more context'); score -= 1; }
    else goods.push('✅ Correct question length');
    if(!q.includes('?')) { issues.push('⚠️ No question mark'); score -= 0.5; }
    else goods.push('✅ Question is well-phrased');
  }
  if(r) {
    if(r.length > 500) { issues.push('⚠️ Answer too long — max 3-4 sentences'); score -= 1; }
    else goods.push('✅ Correct answer length');
    if(r.length < 20) { issues.push('⚠️ Answer too short'); score -= 1; }
  } else { issues.push('⚠️ Missing answer — essential!'); score -= 2; }
  score = Math.max(1, Math.min(10, score));
  return `<div class="space-y-3">
    <div class="flex items-center gap-2"><span class="text-2xl font-800 text-emerald-600">${score.toFixed(1)}/10</span><span class="text-gray-500 text-sm">Quality score</span></div>
    <div><p class="text-xs font-700 text-emerald-700 uppercase tracking-wide mb-1">✅ Strengths</p><p class="text-sm text-gray-600">${goods.join('<br>') || '• Card under construction'}</p></div>
    <div><p class="text-xs font-700 text-amber-700 uppercase tracking-wide mb-1">⚠️ To improve</p><p class="text-sm text-gray-600">${issues.join('<br>') || '• No issues detected 🎉'}</p></div>
    <p class="text-xs text-gray-400 italic">💡 Configure your API key in the Symfony controller for a complete analysis.</p>
  </div>`;
}

/* ── INIT ── */
document.addEventListener('DOMContentLoaded', () => {
  animateQBars(document.getElementById('panel-definition'));
});
</script>
{% endblock %}
