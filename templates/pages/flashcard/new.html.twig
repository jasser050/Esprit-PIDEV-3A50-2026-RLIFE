{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau deck - RLIFE{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-slate-950 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
        <!-- Header avec retour -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-10">
            <div>
                <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
                    Créer un nouveau deck
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-400">
                    Organise tes flashcards et commence à réviser efficacement
                </p>
            </div>
            <a href="{{ path('app_revisions') }}"
               class="inline-flex items-center px-6 py-3 bg-slate-200 dark:bg-slate-700 
                      hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 
                      font-medium rounded-lg transition shadow-md text-sm">
                <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
                Retour à la liste
            </a>
        </div>

        <!-- Formulaire -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
            <div class="p-6 sm:p-10">
                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

                <!-- Titre -->
                <div>
                    {{ form_label(form.titre, null, {
                        'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}
                    }) }}
                    {{ form_widget(form.titre, {
                        'attr': {
                            'class': 'w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 
                                     dark:bg-slate-800 dark:text-white focus:border-indigo-500 focus:ring-2 
                                     focus:ring-indigo-200 outline-none transition-all duration-200 text-base',
                            'placeholder': 'Ex : Vocabulaire anglais C1 - Série Friends'
                        }
                    }) }}
                    {{ form_errors(form.titre, {'attr': {'class': 'text-red-600 dark:text-red-400 text-sm mt-1'}}) }}
                </div>

                <!-- Matière -->
                <div>
                    {{ form_label(form.matiere, null, {
                        'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}
                    }) }}
                    {{ form_widget(form.matiere, {
                        'attr': {
                            'class': 'w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 
                                     dark:bg-slate-800 dark:text-white focus:border-indigo-500 focus:ring-2 
                                     focus:ring-indigo-200 outline-none transition-all duration-200 text-base',
                            'placeholder': 'Ex : Anglais, Biologie, Mathématiques, Droit...'
                        }
                    }) }}
                    {{ form_errors(form.matiere) }}
                </div>

                <!-- Niveau -->
                <div>
                    {{ form_label(form.niveau, null, {
                        'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}
                    }) }}
                    {{ form_widget(form.niveau, {
                        'attr': {
                            'class': 'w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 
                                     dark:bg-slate-800 dark:text-white focus:border-indigo-500 focus:ring-2 
                                     focus:ring-indigo-200 outline-none transition-all duration-200 text-base',
                            'placeholder': 'Ex : Terminale, Licence 2, B2, Avancé...'
                        }
                    }) }}
                    {{ form_errors(form.niveau) }}
                </div>

                <!-- Description -->
                <div>
                    {{ form_label(form.description, null, {
                        'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}
                    }) }}
                    {{ form_widget(form.description, {
                        'attr': {
                            'rows': 5,
                            'class': 'w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 
                                     dark:bg-slate-800 dark:text-white focus:border-indigo-500 focus:ring-2 
                                     focus:ring-indigo-200 outline-none transition-all duration-200 resize-y min-h-[140px] text-base',
                            'placeholder': 'Décris le contenu du deck, les objectifs, les chapitres couverts...'
                        }
                    }) }}
                    {{ form_errors(form.description) }}
                </div>

                <!-- Image de couverture -->
                <div class="space-y-2">
                    {{ form_label(form.imageFile, 'Image de couverture (optionnel)', {
                        'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300'}
                    }) }}
                    {{ form_widget(form.imageFile, {
                        'attr': {
                            'class': 'w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 
                                     dark:bg-slate-800 dark:text-white file:mr-4 file:py-2 file:px-5 
                                     file:rounded-lg file:border-0 file:text-sm file:font-medium 
                                     file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 
                                     dark:file:bg-indigo-950/30 dark:file:text-indigo-300 transition cursor-pointer'
                        }
                    }) }}
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        PNG, JPG, WebP – recommandé 16:9 ou carré – max 5 Mo
                    </p>
                    {{ form_errors(form.imageFile) }}
                </div>

                <!-- PDF (optionnel) -->
                <div class="space-y-2">
                    {{ form_label(form.pdfFile, 'Fichier PDF (optionnel – cours ou résumé)', {
                        'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300'}
                    }) }}
                    {{ form_widget(form.pdfFile, {
                        'attr': {
                            'class': 'w-full px-4 py-3 rounded-lg border border-slate-300 dark:border-slate-600 
                                     dark:bg-slate-800 dark:text-white file:mr-4 file:py-2 file:px-5 
                                     file:rounded-lg file:border-0 file:text-sm file:font-medium 
                                     file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 
                                     dark:file:bg-indigo-950/30 dark:file:text-indigo-300 transition cursor-pointer'
                        }
                    }) }}
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Max 10 Mo
                    </p>
                    {{ form_errors(form.pdfFile) }}
                </div>

                <!-- Boutons d'action -->
                <div class="flex flex-col sm:flex-row gap-4 pt-8 border-t border-slate-200 dark:border-slate-700">
                    <a href="{{ path('app_revisions') }}"
                       class="flex-1 sm:flex-none px-6 py-3 bg-slate-200 dark:bg-slate-700 
                              hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 
                              font-medium rounded-lg transition text-center">
                        Annuler
                    </a>
                    <button type="submit"
                            class="flex-1 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 
                                  text-white font-medium rounded-lg transition shadow-md flex items-center justify-center gap-2">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                        Créer le deck
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}