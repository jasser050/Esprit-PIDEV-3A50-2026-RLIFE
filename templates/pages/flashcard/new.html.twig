{% extends 'base.html.twig' %}

{% block title %}Ajouter une Flashcard - {{ deck.titre }} - RLIFE{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Style épuré - uniquement pour l'affichage */
    .error-message {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        font-weight: 500;
        display: block;
    }
    
    .error-message:empty {
        display: none;
    }
    
    .help-text {
        color: #64748b;
        font-size: 0.75rem;
        margin-top: 0.375rem;
        display: block;
    }
    
    label.required::after {
        content: " *";
        color: #ef4444;
        font-weight: bold;
    }
    
    .btn-cancel {
        padding: 0.875rem 1.75rem;
        background: #e5e7eb;
        color: #374151;
        font-weight: 500;
        border-radius: 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .btn-save {
        padding: 0.875rem 2rem;
        background: linear-gradient(to right, #4f46e5, #7c3aed);
        color: white;
        font-weight: 600;
        border-radius: 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .file-preview {
        margin-top: 0.75rem;
        padding: 0.75rem;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        font-size: 0.875rem;
    }
    
    .dark .file-preview {
        background: #1f2937;
        border-color: #374151;
    }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 dark:bg-gray-950 py-10 px-4 sm:px-6 lg:px-8 text-gray-900 dark:text-gray-100">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl border border-gray-200 dark:border-gray-700 overflow-hidden">

            <!-- Header -->
            <div class="bg-gradient-to-r from-indigo-600 to-indigo-800 px-8 py-10 text-white">
                <h1 class="text-3xl font-bold mb-2">Créer une nouvelle Flashcard</h1>
                <p class="text-indigo-100/90 text-lg">
                    Deck : <strong class="text-white">{{ deck.titre }}</strong>
                    <span class="opacity-80">({{ deck.matiere }} • {{ deck.niveau }})</span>
                </p>
            </div>

            <!-- Form Body -->
            <div class="p-8 lg:p-10">
                {# 
                    ✅ CORRECTION : activation de 'novalidate' pour désactiver la validation HTML5
                    ✅ La validation est UNIQUEMENT côté serveur avec Symfony Validator
                #}
                {{ form_start(form, {'attr': {'class': 'space-y-7', 'novalidate': 'novalidate'}}) }}

                <!-- Titre -->
                <div class="space-y-2">
                    {{ form_label(form.titre, 'Titre de la flashcard', {
                        'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300 required'}
                    }) }}
                    
                    {{ form_widget(form.titre, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition shadow-sm',
                            'placeholder': 'Ex : Définition du système nerveux, Théorème de Pythagore...'
                        }
                    }) }}
                    
                    <p class="help-text">📌 Obligatoire – Min 3 caractères – Ne doit pas commencer par un chiffre – Max 255 caractères</p>
                    
                    {# ✅ CORRECTION : utilisation de form_errors() comme dans le workshop #}
                    {{ form_errors(form.titre, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Question -->
                <div class="space-y-2">
                    {{ form_label(form.question, 'Question', {
                        'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300 required'}
                    }) }}
                    
                    {{ form_widget(form.question, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition shadow-sm min-h-[130px]',
                            'placeholder': 'Quelle est la capitale de la France ? Expliquez le théorème de Pythagore...'
                        }
                    }) }}
                    
                    <p class="help-text">📌 Obligatoire – Min 5 caractères – Max 2000 caractères</p>
                    
                    {{ form_errors(form.question, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Réponse -->
                <div class="space-y-2">
                    {{ form_label(form.reponse, 'Réponse', {
                        'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300 required'}
                    }) }}
                    
                    {{ form_widget(form.reponse, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition shadow-sm min-h-[160px]',
                            'placeholder': 'Paris\n\nDans un triangle rectangle, le carré de l\'hypoténuse est égal à la somme des carrés des deux autres côtés...'
                        }
                    }) }}
                    
                    <p class="help-text">📌 Obligatoire – Min 1 caractère – Max 2000 caractères</p>
                    
                    {{ form_errors(form.reponse, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Description (optionnel) -->
                <div class="space-y-2">
                    {{ form_label(form.description, 'Notes / Explications supplémentaires (optionnel)', {
                        'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300'}
                    }) }}
                    
                    {{ form_widget(form.description, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition shadow-sm min-h-[110px]',
                            'placeholder': 'Contexte supplémentaire, exemples, pièges classiques, démonstration...'
                        }
                    }) }}
                    
                    <p class="help-text">💡 Optionnel – Max 2000 caractères</p>
                    
                    {{ form_errors(form.description, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Niveau de difficulté + État -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        {{ form_label(form.niveauDifficulte, 'Niveau de difficulté', {
                            'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300 required'}
                        }) }}
                        
                        {{ form_widget(form.niveauDifficulte, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition shadow-sm'
                            }
                        }) }}
                        
                        <p class="help-text">📌 Obligatoire – Entre 1 (facile) et 5 (difficile)</p>
                        
                        {{ form_errors(form.niveauDifficulte, {'attr': {'class': 'error-message'}}) }}
                    </div>

                    <div class="space-y-2">
                        {{ form_label(form.etat, 'État de la carte', {
                            'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300 required'}
                        }) }}
                        
                        {{ form_widget(form.etat, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition shadow-sm'
                            }
                        }) }}
                        
                        <p class="help-text">📌 Obligatoire – Statut de la flashcard</p>
                        
                        {{ form_errors(form.etat, {'attr': {'class': 'error-message'}}) }}
                    </div>
                </div>

                <!-- Fichiers -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                    <div class="space-y-2">
                        {{ form_label(form.imageFile, 'Image (optionnel)', {
                            'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300'}
                        }) }}
                        
                        {{ form_widget(form.imageFile, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 file:mr-4 file:py-2 file:px-5 file:rounded file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 dark:file:bg-gray-700 dark:file:text-indigo-300 shadow-sm',
                                'accept': 'image/jpeg,image/png,image/webp,image/gif'
                            }
                        }) }}
                        
                        <p class="help-text">💡 Optionnel – Max 5 Mo – JPG, PNG, WEBP, GIF</p>
                        
                        {# ✅ CORRECTION : affichage du nom du fichier uniquement pour l'UX #}
                        <div id="imagePreview" class="file-preview" style="display: none;">
                            <strong>Fichier sélectionné :</strong> <span id="imageName"></span>
                        </div>
                        
                        {{ form_errors(form.imageFile, {'attr': {'class': 'error-message'}}) }}
                    </div>

                    <div class="space-y-2">
                        {{ form_label(form.pdfFile, 'Document PDF (optionnel)', {
                            'label_attr': {'class': 'block text-base font-medium text-gray-700 dark:text-gray-300'}
                        }) }}
                        
                        {{ form_widget(form.pdfFile, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 file:mr-4 file:py-2 file:px-5 file:rounded file:border-0 file:text-sm file:font-medium file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 dark:file:bg-gray-700 dark:file:text-purple-300 shadow-sm',
                                'accept': 'application/pdf'
                            }
                        }) }}
                        
                        <p class="help-text">💡 Optionnel – Max 10 Mo – PDF uniquement</p>
                        
                        <div id="pdfPreview" class="file-preview" style="display: none;">
                            <strong>Fichier sélectionné :</strong> <span id="pdfName"></span>
                        </div>
                        
                        {{ form_errors(form.pdfFile, {'attr': {'class': 'error-message'}}) }}
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="flex flex-col sm:flex-row gap-4 justify-end mt-10 pt-8 border-t border-gray-200 dark:border-gray-700">
                    <a href="{{ path('app_revisions_deck_study', {id: deck.idDeck}) }}"
                       class="btn-cancel">
                        <i data-lucide="arrow-left" class="w-5 h-5"></i>
                        Annuler
                    </a>

                    <button type="submit" class="btn-save">
                        <i data-lucide="save" class="w-5 h-5"></i>
                        Enregistrer la flashcard
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // ✅ CORRECTION : Uniquement pour l'aperçu des fichiers, PAS pour la validation
    // La validation est 100% côté serveur via Symfony Validator
    
    // Aperçu image
    const imageFile = document.getElementById('flashcard_imageFile');
    if (imageFile) {
        imageFile.addEventListener('change', function(e) {
            const preview = document.getElementById('imagePreview');
            const name = document.getElementById('imageName');

            if (this.files.length > 0) {
                name.textContent = this.files[0].name;
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }
        });
    }

    // Aperçu PDF
    const pdfFile = document.getElementById('flashcard_pdfFile');
    if (pdfFile) {
        pdfFile.addEventListener('change', function(e) {
            const preview = document.getElementById('pdfPreview');
            const name = document.getElementById('pdfName');

            if (this.files.length > 0) {
                name.textContent = this.files[0].name;
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }
        });
    }
});
</script>
{% endblock %}