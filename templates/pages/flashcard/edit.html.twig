{% extends 'base.html.twig' %}

{% block title %}Edit Flashcard - RLIFE{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Force dark mode backgrounds */
    .dark .bg-white {
        background-color: #1e293b !important;
    }
    
    .dark .bg-slate-50 {
        background-color: #0f172a !important;
    }
    
    .dark input,
    .dark textarea,
    .dark select {
        background-color: #1e293b !important;
        color: #f1f5f9 !important;
        border-color: #475569 !important;
    }
    
    .dark label {
        color: #cbd5e1 !important;
    }
    
    /* Validation visuelle en temps réel */
    input:invalid:not(:placeholder-shown):not(:focus),
    textarea:invalid:not(:placeholder-shown):not(:focus),
    select:invalid:not(:focus) {
        border-color: #ef4444 !important;
        background-color: #fef2f2 !important;
    }

    input:valid:not(:placeholder-shown):not(:focus),
    textarea:valid:not(:placeholder-shown):not(:focus),
    select:valid:not(:focus) {
        border-color: #10b981 !important;
        background-color: #f0fdf4 !important;
    }

    .dark input:invalid:not(:placeholder-shown):not(:focus),
    .dark textarea:invalid:not(:placeholder-shown):not(:focus),
    .dark select:invalid:not(:focus) {
        background-color: #7f1d1d !important;
    }

    .dark input:valid:not(:placeholder-shown):not(:focus),
    .dark textarea:valid:not(:placeholder-shown):not(:focus),
    .dark select:valid:not(:focus) {
        background-color: #064e3b !important;
    }

    .field-error {
        animation: shake 0.3s ease-in-out;
    }

    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
    }

    .error-message {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        font-weight: 500;
        display: block;
    }

    .help-text {
        color: #64748b;
        font-size: 0.75rem;
        margin-top: 0.375rem;
        display: block;
    }

    .dark .help-text {
        color: #94a3b8;
    }

    label.required::after {
        content: " *";
        color: #ef4444;
        font-weight: bold;
        font-size: 1.1em;
    }

    .char-counter {
        font-size: 0.75rem;
        color: #94a3b8;
        text-align: right;
        margin-top: 0.25rem;
    }

    .dark .char-counter {
        color: #cbd5e1;
    }

    .char-counter.warning {
        color: #f59e0b;
        font-weight: 600;
    }

    .char-counter.danger {
        color: #ef4444;
        font-weight: 700;
    }

    .file-preview {
        margin-top: 0.75rem;
        padding: 0.75rem;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        font-size: 0.875rem;
    }

    .dark .file-preview {
        background: #1f2937;
        border-color: #374151;
    }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-slate-950 py-8 px-4 sm:px-6 lg:px-8 text-slate-900 dark:text-white">
    <div class="max-w-4xl mx-auto">
        
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center gap-4 mb-6">
                <a href="{{ path('app_revisions_deck_study', {id: deck.id}) }}"
                   class="inline-flex items-center px-4 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition">
                    <i data-lucide="arrow-left" class="w-5 h-5 mr-2"></i>
                    Back to deck
                </a>
            </div>
            
            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-2">
                <i data-lucide="edit-3" class="w-10 h-10 inline-block mr-3 text-indigo-600"></i>
                Edit Flashcard
            </h1>
            
            <p class="text-lg text-slate-600 dark:text-slate-400">
                Deck: <span class="font-semibold text-indigo-600 dark:text-indigo-400">{{ deck.titre }}</span>
            </p>
        </div>

        <!-- Form Card -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
            <div class="p-6 lg:p-10 bg-white dark:bg-slate-800">
                {{ form_start(form, {'attr': {'class': 'space-y-7', 'id': 'flashcardForm', 'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
                
                <!-- Title -->
                <div class="space-y-2">
                    {{ form_label(form.titre, 'Flashcard Title', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                    }) }}
                    {{ form_widget(form.titre, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition shadow-sm',
                            'placeholder': 'e.g., Definition of Pythagoras theorem, European Capitals...',
                            'required': 'required',
                            'minlength': '3',
                            'maxlength': '255',
                            'data-field': 'titre'
                        }
                    }) }}
                    <p class="help-text">📌 Required – Min 3 characters – Max 255 characters</p>
                    <div class="char-counter" data-counter="titre">
                        <span class="current">{{ form.titre.vars.value|length }}</span> / 255 characters
                    </div>
                    {% if form.titre.vars.errors|length > 0 %}
                        <div class="error-message">
                            {% for error in form.titre.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="error-message" id="error-titre"></div>
                </div>

                <!-- Question -->
                <div class="space-y-2">
                    {{ form_label(form.question, 'Question / Front', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                    }) }}
                    {{ form_widget(form.question, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition shadow-sm min-h-[130px]',
                            'placeholder': 'Ask your question here...',
                            'required': 'required',
                            'minlength': '5',
                            'maxlength': '2000',
                            'data-field': 'question'
                        }
                    }) }}
                    <p class="help-text">📌 Required – Min 5 characters – Max 2000 characters</p>
                    <div class="char-counter" data-counter="question">
                        <span class="current">{{ form.question.vars.value|length }}</span> / 2000 characters
                    </div>
                    {% if form.question.vars.errors|length > 0 %}
                        <div class="error-message">
                            {% for error in form.question.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="error-message" id="error-question"></div>
                </div>

                <!-- Answer -->
                <div class="space-y-2">
                    {{ form_label(form.reponse, 'Answer / Back', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                    }) }}
                    {{ form_widget(form.reponse, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition shadow-sm min-h-[160px]',
                            'placeholder': 'Write the complete answer here...',
                            'required': 'required',
                            'minlength': '1',
                            'maxlength': '2000',
                            'data-field': 'reponse'
                        }
                    }) }}
                    <p class="help-text">📌 Required – Min 1 character – Max 2000 characters</p>
                    <div class="char-counter" data-counter="reponse">
                        <span class="current">{{ form.reponse.vars.value|length }}</span> / 2000 characters
                    </div>
                    {% if form.reponse.vars.errors|length > 0 %}
                        <div class="error-message">
                            {% for error in form.reponse.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="error-message" id="error-reponse"></div>
                </div>

                <!-- Description -->
                <div class="space-y-2">
                    {{ form_label(form.description, 'Description / Notes (optional)', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300'}
                    }) }}
                    {{ form_widget(form.description, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition shadow-sm min-h-[110px]',
                            'placeholder': 'Additional context, examples, common mistakes...',
                            'maxlength': '2000',
                            'data-field': 'description'
                        }
                    }) }}
                    <p class="help-text">💡 Optional – Max 2000 characters</p>
                    <div class="char-counter" data-counter="description">
                        <span class="current">{{ form.description.vars.value|length }}</span> / 2000 characters
                    </div>
                    {% if form.description.vars.errors|length > 0 %}
                        <div class="error-message">
                            {% for error in form.description.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                    <div class="error-message" id="error-description"></div>
                </div>

                <!-- Difficulty Level + Status (Side by Side) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Difficulty Level -->
                    <div class="space-y-2">
                        {{ form_label(form.niveauDifficulte, 'Difficulty Level', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                        }) }}
                        {{ form_widget(form.niveauDifficulte, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition shadow-sm',
                                'required': 'required',
                                'data-field': 'niveauDifficulte'
                            }
                        }) }}
                        <p class="help-text">📌 Required – Between 1 (easy) and 5 (hard)</p>
                        {% if form.niveauDifficulte.vars.errors|length > 0 %}
                            <div class="error-message">
                                {% for error in form.niveauDifficulte.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="error-message" id="error-niveauDifficulte"></div>
                    </div>

                    <!-- Status -->
                    <div class="space-y-2">
                        {{ form_label(form.etat, 'Status', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                        }) }}
                        {{ form_widget(form.etat, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition shadow-sm',
                                'required': 'required',
                                'data-field': 'etat'
                            }
                        }) }}
                        <p class="help-text">📌 Required – Flashcard status</p>
                        {% if form.etat.vars.errors|length > 0 %}
                            <div class="error-message">
                                {% for error in form.etat.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="error-message" id="error-etat"></div>
                    </div>
                </div>

                <!-- File Uploads -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                    <!-- Image -->
                    <div class="space-y-2">
                        {{ form_label(form.imageFile, 'Image (optional)', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300'}
                        }) }}
                        
                        <!-- Current Image Preview -->
                        {% if flashcard.image %}
                            <div class="mb-4">
                                <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Current image:</p>
                                <div class="relative w-full h-48 rounded-lg overflow-hidden border border-slate-300 dark:border-slate-600">
                                    <img src="{{ asset('uploads/flashcards/' ~ flashcard.image) }}" 
                                         alt="Current image" 
                                         class="w-full h-full object-cover">
                                </div>
                            </div>
                        {% endif %}
                        
                        {{ form_widget(form.imageFile, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-5 file:rounded file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 dark:file:bg-slate-700 dark:file:text-indigo-300 shadow-sm',
                                'accept': 'image/jpeg,image/png,image/webp,image/gif',
                                'data-field': 'imageFile'
                            }
                        }) }}
                        <p class="help-text">💡 Optional – Max 5 MB – JPG, PNG, WEBP, GIF</p>
                        <div id="imagePreview" class="file-preview mt-3 p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg" style="display: none;">
                            <strong>Selected file:</strong> <span id="imageName"></span>
                            <br><small>Size: <span id="imageSize"></span></small>
                        </div>
                        {% if form.imageFile.vars.errors|length > 0 %}
                            <div class="error-message">
                                {% for error in form.imageFile.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="error-message" id="error-imageFile"></div>
                    </div>

                    <!-- PDF -->
                    <div class="space-y-2">
                        {{ form_label(form.pdfFile, 'PDF Document (optional)', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300'}
                        }) }}
                        
                        <!-- Current PDF Link -->
                        {% if flashcard.pdf %}
                            <div class="mb-4">
                                <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Current PDF:</p>
                                <a href="{{ asset('uploads/flashcards/' ~ flashcard.pdf) }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 rounded-lg transition">
                                    <i data-lucide="file-text" class="w-5 h-5 mr-2"></i>
                                    View PDF
                                </a>
                            </div>
                        {% endif %}
                        
                        {{ form_widget(form.pdfFile, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-5 file:rounded file:border-0 file:text-sm file:font-medium file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 dark:file:bg-slate-700 dark:file:text-purple-300 shadow-sm',
                                'accept': 'application/pdf',
                                'data-field': 'pdfFile'
                            }
                        }) }}
                        <p class="help-text">💡 Optional – Max 10 MB – PDF only</p>
                        <div id="pdfPreview" class="file-preview mt-3 p-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg" style="display: none;">
                            <strong>Selected file:</strong> <span id="pdfName"></span>
                            <br><small>Size: <span id="pdfSize"></span></small>
                        </div>
                        {% if form.pdfFile.vars.errors|length > 0 %}
                            <div class="error-message">
                                {% for error in form.pdfFile.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <div class="error-message" id="error-pdfFile"></div>
                    </div>
                </div>

                <!-- Action Buttons (at the bottom of the form) -->
                <div class="flex flex-col sm:flex-row gap-4 justify-end mt-10 pt-8 border-t border-slate-200 dark:border-slate-700">
                    <a href="{{ path('app_revisions_deck_study', {id: deck.id}) }}"
                       class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition shadow-sm">
                        <i data-lucide="x" class="w-5 h-5 mr-2"></i>
                        Cancel
                    </a>

                    <button type="submit" id="submitBtn"
                            class="inline-flex items-center justify-center px-10 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition shadow-md">
                        <i data-lucide="save" class="w-5 h-5 mr-2"></i>
                        Save Changes
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <!-- Danger Zone -->
        <div class="mt-8">
            <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-2xl p-6">
                <h3 class="text-xl font-bold text-red-800 dark:text-red-300 mb-4 flex items-center">
                    <i data-lucide="alert-triangle" class="w-6 h-6 mr-2"></i>
                    Danger Zone
                </h3>
                
                <p class="text-red-700 dark:text-red-400 mb-6">
                    This action is irreversible. All data associated with this flashcard will be permanently deleted.
                </p>
                
                <form method="post" action="{{ path('app_flashcard_delete', {id: flashcard.id}) }}"
                      onsubmit="return confirm('Are you absolutely sure you want to delete this flashcard? This action cannot be undone.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flashcard.id) }}">
                    <button type="submit"
                            class="inline-flex items-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition">
                        <i data-lucide="trash-2" class="w-5 h-5 mr-2"></i>
                        Delete this flashcard permanently
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('flashcardForm');
    const submitBtn = document.getElementById('submitBtn');

    // Character counter fields
    const fields = {
        titre: {
            element: document.querySelector('[data-field="titre"]'),
            maxLength: 255
        },
        question: {
            element: document.querySelector('[data-field="question"]'),
            maxLength: 2000
        },
        reponse: {
            element: document.querySelector('[data-field="reponse"]'),
            maxLength: 2000
        },
        description: {
            element: document.querySelector('[data-field="description"]'),
            maxLength: 2000
        }
    };

    // Update character counter
    function updateCharCounter(fieldName) {
        const field = fields[fieldName];
        if (!field || !field.element) return;

        const counter = document.querySelector(`[data-counter="${fieldName}"] .current`);
        const counterContainer = document.querySelector(`[data-counter="${fieldName}"]`);
        
        if (counter) {
            const length = field.element.value.length;
            counter.textContent = length;

            if (field.maxLength) {
                const percent = (length / field.maxLength) * 100;
                counterContainer.classList.remove('warning', 'danger');
                
                if (percent >= 90) {
                    counterContainer.classList.add('danger');
                } else if (percent >= 75) {
                    counterContainer.classList.add('warning');
                }
            }
        }
    }

    // Initialize and attach event listeners
    for (const fieldName in fields) {
        const field = fields[fieldName];
        if (!field.element) continue;

        field.element.addEventListener('input', function() {
            updateCharCounter(fieldName);
        });

        // Initialize counter
        updateCharCounter(fieldName);
    }

    // Image file preview
    const imageFile = document.querySelector('[data-field="imageFile"]');
    if (imageFile) {
        imageFile.addEventListener('change', function(e) {
            const preview = document.getElementById('imagePreview');
            const name = document.getElementById('imageName');
            const size = document.getElementById('imageSize');

            if (this.files.length > 0) {
                const file = this.files[0];
                name.textContent = file.name;
                size.textContent = (file.size / 1024).toFixed(2) + ' KB';
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }
        });
    }

    // PDF file preview
    const pdfFile = document.querySelector('[data-field="pdfFile"]');
    if (pdfFile) {
        pdfFile.addEventListener('change', function(e) {
            const preview = document.getElementById('pdfPreview');
            const name = document.getElementById('pdfName');
            const size = document.getElementById('pdfSize');

            if (this.files.length > 0) {
                const file = this.files[0];
                name.textContent = file.name;
                size.textContent = (file.size / 1024).toFixed(2) + ' KB';
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }
        });
    }

    // Form submission
    form.addEventListener('submit', function(e) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i data-lucide="loader" class="w-5 h-5 mr-2 animate-spin"></i> Saving...';
    });
});
</script>
{% endblock %}