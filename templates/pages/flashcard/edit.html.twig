{% extends 'base.html.twig' %}

{% block title %}Modifier la Flashcard - RLIFE{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-slate-950 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        
        <!-- En-tête -->
        <div class="mb-8">
            <div class="flex items-center gap-4 mb-6">
                <a href="{{ path('app_revisions_deck_study', {id: deck.idDeck}) }}"
                   class="inline-flex items-center px-4 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition">
                    <i data-lucide="arrow-left" class="w-5 h-5 mr-2"></i>
                    Retour au deck
                </a>
            </div>
            
            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-2">
                <i data-lucide="edit-3" class="w-10 h-10 inline-block mr-3 text-indigo-600"></i>
                Modifier la Flashcard
            </h1>
            
            <p class="text-lg text-slate-600 dark:text-slate-400">
                Deck : <span class="font-semibold text-indigo-600 dark:text-indigo-400">{{ deck.titre }}</span>
            </p>
        </div>

        <!-- Carte de formulaire -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
            <div class="p-6 lg:p-10">
                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}
                
                <!-- Titre -->
                <div>
                    {{ form_label(form.titre, 'Titre (optionnel)', {
                        'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                    }) }}
                    {{ form_widget(form.titre, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-slate-50 dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:focus:ring-indigo-400 dark:focus:border-indigo-400 text-slate-900 dark:text-white',
                            'placeholder': 'Ex: Définition du théorème de Pythagore'
                        }
                    }) }}
                    {{ form_help(form.titre, {
                        'help': 'Un titre court pour identifier rapidement la flashcard'
                    }) }}
                </div>

                <!-- Question -->
                <div>
                    {{ form_label(form.question, 'Question', {
                        'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                    }) }}
                    {{ form_widget(form.question, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-slate-50 dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:focus:ring-indigo-400 dark:focus:border-indigo-400 text-slate-900 dark:text-white',
                            'rows': 4,
                            'placeholder': 'Posez votre question ici...'
                        }
                    }) }}
                </div>

                <!-- Réponse -->
                <div>
                    {{ form_label(form.reponse, 'Réponse', {
                        'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                    }) }}
                    {{ form_widget(form.reponse, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-slate-50 dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:focus:ring-indigo-400 dark:focus:border-indigo-400 text-slate-900 dark:text-white',
                            'rows': 4,
                            'placeholder': 'Écrivez la réponse ici...'
                        }
                    }) }}
                </div>

                <!-- Description -->
                <div>
                    {{ form_label(form.description, 'Description (optionnelle)', {
                        'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                    }) }}
                    {{ form_widget(form.description, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-slate-50 dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 dark:focus:ring-indigo-400 dark:focus:border-indigo-400 text-slate-900 dark:text-white',
                            'rows': 3,
                            'placeholder': 'Explications supplémentaires, contexte, exemples...'
                        }
                    }) }}
                </div>

                <!-- Niveau de difficulté -->
                <div>
                    {{ form_label(form.niveauDifficulte, 'Niveau de difficulté', {
                        'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                    }) }}
                    <div class="flex items-center space-x-6">
                        {% for i in 1..5 %}
                            <label class="flex items-center cursor-pointer">
                                <input type="radio" name="{{ form.niveauDifficulte.vars.full_name }}" value="{{ i }}"
                                       class="hidden peer"
                                       {% if form.niveauDifficulte.vars.value == i %}checked{% endif %}>
                                <div class="w-12 h-12 flex items-center justify-center rounded-xl border-2 border-slate-300 dark:border-slate-600 peer-checked:border-indigo-500 peer-checked:bg-indigo-100 dark:peer-checked:bg-indigo-900/30 transition">
                                    <span class="text-xl font-bold peer-checked:text-indigo-600 dark:peer-checked:text-indigo-400">
                                        {{ i }}
                                    </span>
                                </div>
                                <span class="ml-2 text-sm text-slate-600 dark:text-slate-400">
                                    {% if i == 1 %}Très facile
                                    {% elseif i == 2 %}Facile
                                    {% elseif i == 3 %}Moyen
                                    {% elseif i == 4 %}Difficile
                                    {% else %}Très difficile{% endif %}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                    {{ form_help(form.niveauDifficulte, {
                        'help': 'Évaluez la difficulté de cette flashcard'
                    }) }}
                </div>

                <!-- État -->
                <div>
                    {{ form_label(form.etat, 'État', {
                        'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                    }) }}
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        {% for choice in form.etat.vars.choices %}
                            <label class="flex items-center p-4 border-2 border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer hover:border-indigo-300 dark:hover:border-indigo-700 transition has-[:checked]:border-indigo-500 dark:has-[:checked]:border-indigo-400 has-[:checked]:bg-indigo-50 dark:has-[:checked]:bg-indigo-900/20">
                                <input type="radio" name="{{ form.etat.vars.full_name }}" value="{{ choice.value }}"
                                       class="hidden peer"
                                       {% if form.etat.vars.value == choice.value %}checked{% endif %}>
                                <div class="w-6 h-6 rounded-full border-2 border-slate-400 dark:border-slate-500 peer-checked:border-indigo-500 peer-checked:bg-indigo-500 mr-3"></div>
                                <div>
                                    <span class="font-medium text-slate-900 dark:text-white">
                                        {{ choice.label }}
                                    </span>
                                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                                        {% if choice.value == 'active' %}Flashcard visible et active
                                        {% elseif choice.value == 'inactive' %}Flashcard masquée
                                        {% else %}Flashcard archivée{% endif %}
                                    </p>
                                </div>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <!-- Uploads -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Image -->
                    <div>
                        {{ form_label(form.imageFile, 'Image (optionnelle)', {
                            'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                        }) }}
                        
                        <!-- Aperçu de l'image actuelle -->
                        {% if flashcard.image %}
                            <div class="mb-4">
                                <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Image actuelle :</p>
                                <div class="relative w-full h-48 rounded-lg overflow-hidden border border-slate-300 dark:border-slate-600">
                                    <img src="{{ asset('uploads/flashcards/' ~ flashcard.image) }}" 
                                         alt="Image actuelle" 
                                         class="w-full h-full object-cover">
                                </div>
                            </div>
                        {% endif %}
                        
                        {{ form_widget(form.imageFile, {
                            'attr': {
                                'class': 'block w-full text-sm text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 dark:file:bg-indigo-900/30 file:text-indigo-700 dark:file:text-indigo-300 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900/40'
                            }
                        }) }}
                        {{ form_help(form.imageFile, {
                            'help': 'Formats acceptés : JPG, PNG, GIF. Taille max : 2MB'
                        }) }}
                    </div>

                    <!-- PDF -->
                    <div>
                        {{ form_label(form.pdfFile, 'PDF (optionnel)', {
                            'label_attr': {'class': 'block text-lg font-medium text-slate-900 dark:text-white mb-3'}
                        }) }}
                        
                        <!-- Lien vers le PDF actuel -->
                        {% if flashcard.pdf %}
                            <div class="mb-4">
                                <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">PDF actuel :</p>
                                <a href="{{ asset('uploads/flashcards/' ~ flashcard.pdf) }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 rounded-lg transition">
                                    <i data-lucide="file-text" class="w-5 h-5 mr-2"></i>
                                    Voir le PDF
                                </a>
                            </div>
                        {% endif %}
                        
                        {{ form_widget(form.pdfFile, {
                            'attr': {
                                'class': 'block w-full text-sm text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 dark:file:bg-indigo-900/30 file:text-indigo-700 dark:file:text-indigo-300 hover:file:bg-indigo-100 dark:hover:file:bg-indigo-900/40'
                            }
                        }) }}
                        {{ form_help(form.pdfFile, {
                            'help': 'Format accepté : PDF. Taille max : 5MB'
                        }) }}
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="flex flex-col sm:flex-row gap-4 pt-8 border-t border-slate-200 dark:border-slate-700">
                    <button type="submit"
                            class="inline-flex items-center justify-center px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-lg rounded-xl transition shadow-lg flex-1">
                        <i data-lucide="save" class="w-6 h-6 mr-3"></i>
                        Enregistrer les modifications
                    </button>
                    
                    <a href="{{ path('app_revisions_deck_study', {id: deck.idDeck}) }}"
                       class="inline-flex items-center justify-center px-8 py-4 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-bold text-lg rounded-xl transition">
                        <i data-lucide="x" class="w-6 h-6 mr-3"></i>
                        Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <!-- Section dangereuse -->
        <div class="mt-8">
            <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-2xl p-6">
                <h3 class="text-xl font-bold text-red-800 dark:text-red-300 mb-4 flex items-center">
                    <i data-lucide="alert-triangle" class="w-6 h-6 mr-2"></i>
                    Zone de danger
                </h3>
                
                <p class="text-red-700 dark:text-red-400 mb-6">
                    Cette action est irréversible. Toutes les données associées à cette flashcard seront définitivement supprimées.
                </p>
                
                <form method="post" action="{{ path('app_flashcard_delete', {id: flashcard.id}) }}"
                      onsubmit="return confirm('Êtes-vous absolument sûr de vouloir supprimer cette flashcard ? Cette action est irréversible.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flashcard.id) }}">
                    <button type="submit"
                            class="inline-flex items-center px-6 py-3 bg-red-600 hover:bg-red-700 text-white font-medium rounded-xl transition">
                        <i data-lucide="trash-2" class="w-5 h-5 mr-2"></i>
                        Supprimer définitivement cette flashcard
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Script pour le niveau de difficulté
    document.addEventListener('DOMContentLoaded', function() {
        const difficultyRadios = document.querySelectorAll('input[name="flashcard[niveauDifficulte]"]');
        
        difficultyRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                // Mettre à jour visuellement la sélection
                difficultyRadios.forEach(r => {
                    const container = r.closest('label');
                    if (r.checked) {
                        container.classList.add('ring-2', 'ring-indigo-500');
                    } else {
                        container.classList.remove('ring-2', 'ring-indigo-500');
                    }
                });
            });
        });
        
        // Initialiser l'état visuel
        difficultyRadios.forEach(radio => {
            if (radio.checked) {
                const container = radio.closest('label');
                container.classList.add('ring-2', 'ring-indigo-500');
            }
        });
        
        // Script pour la confirmation de suppression
        const deleteForm = document.querySelector('form[action*="delete"]');
        if (deleteForm) {
            deleteForm.addEventListener('submit', function(e) {
                if (!confirm('Êtes-vous ABSOLUMENT sûr de vouloir supprimer cette flashcard ? Cette action est irréversible et toutes les données associées seront perdues.')) {
                    e.preventDefault();
                }
            });
        }
    });
</script>
{% endblock %}