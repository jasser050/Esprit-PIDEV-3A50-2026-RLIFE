{% extends 'base.html.twig' %}

{% block title %}Edit Flashcard - RLIFE{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Style UNIQUEMENT pour l'affichage des erreurs Symfony */
    .error-message {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        font-weight: 500;
        display: block;
        background-color: #fee2e2;
        padding: 0.5rem;
        border-radius: 0.375rem;
        border-left: 4px solid #ef4444;
    }
    
    .error-message:empty {
        display: none;
    }
    
    .help-text {
        color: #64748b;
        font-size: 0.75rem;
        margin-top: 0.375rem;
        display: block;
    }
    
    label.required::after {
        content: " *";
        color: #ef4444;
        font-weight: bold;
    }
    
    /* Boutons simples */
    .btn-back {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 1rem;
        background: #e2e8f0;
        color: #1e293b;
        font-weight: 500;
        border-radius: 0.5rem;
        text-decoration: none;
    }
    
    .dark .btn-back {
        background: #334155;
        color: #e2e8f0;
    }
    
    .btn-save {
        padding: 0.875rem 2rem;
        background: linear-gradient(to right, #4f46e5, #7c3aed);
        color: white;
        font-weight: 600;
        border-radius: 0.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        cursor: pointer;
    }
    
    .btn-delete {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        background: #dc2626;
        color: white;
        font-weight: 500;
        border-radius: 0.5rem;
        border: none;
        cursor: pointer;
    }
    
    /* Danger zone */
    .danger-zone {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 1rem;
        padding: 1.5rem;
    }
    
    .dark .danger-zone {
        background: #7f1d1d20;
        border-color: #7f1d1d;
    }
    
    /* Image preview */
    .current-image {
        margin-bottom: 1rem;
    }
    
    .current-image img {
        width: 100%;
        height: 12rem;
        object-fit: cover;
        border-radius: 0.5rem;
        border: 1px solid #e2e8f0;
    }
    
    .dark .current-image img {
        border-color: #334155;
    }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 dark:bg-slate-950 py-8 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        
        <!-- Header -->
        <div class="mb-8">
            <div class="flex items-center gap-4 mb-6">
                <a href="{{ path('app_revisions_deck_study', {id: deck.idDeck}) }}" class="btn-back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
                    </svg>
                    Back to deck
                </a>
            </div>
            
            <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-2">
                Edit Flashcard
            </h1>
            
            <p class="text-lg text-slate-600 dark:text-slate-400">
                Deck: <span class="font-semibold text-indigo-600 dark:text-indigo-400">{{ deck.titre }}</span>
            </p>
        </div>

        <!-- Form Card -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
            <div class="p-6 lg:p-10">
                
                {# DÉSACTIVATION TOTALE de la validation HTML5 #}
                {{ form_start(form, {'attr': {'class': 'space-y-7', 'novalidate': 'novalidate'}}) }}
                
                <!-- Titre -->
                <div class="space-y-2">
                    {{ form_label(form.titre, 'Flashcard Title', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                    }) }}
                    
                    {{ form_widget(form.titre, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition',
                            'placeholder': 'e.g., Definition of Pythagoras theorem, European Capitals...'
                        }
                    }) }}
                    
                    <p class="help-text">📌 Required – Min 3 characters – Max 255 characters</p>
                    
                    {{ form_errors(form.titre, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Question -->
                <div class="space-y-2">
                    {{ form_label(form.question, 'Question / Front', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                    }) }}
                    
                    {{ form_widget(form.question, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition min-h-[130px]',
                            'placeholder': 'Ask your question here...'
                        }
                    }) }}
                    
                    <p class="help-text">📌 Required – Min 5 characters – Max 2000 characters</p>
                    
                    {{ form_errors(form.question, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Réponse -->
                <div class="space-y-2">
                    {{ form_label(form.reponse, 'Answer / Back', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                    }) }}
                    
                    {{ form_widget(form.reponse, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-green-500 focus:border-green-500 outline-none transition min-h-[160px]',
                            'placeholder': 'Write the complete answer here...'
                        }
                    }) }}
                    
                    <p class="help-text">📌 Required – Min 1 character – Max 2000 characters</p>
                    
                    {{ form_errors(form.reponse, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Description (optionnel) -->
                <div class="space-y-2">
                    {{ form_label(form.description, 'Description / Notes (optional)', {
                        'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300'}
                    }) }}
                    
                    {{ form_widget(form.description, {
                        'attr': {
                            'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition min-h-[110px]',
                            'placeholder': 'Additional context, examples, common mistakes...'
                        }
                    }) }}
                    
                    <p class="help-text">💡 Optional – Max 2000 characters</p>
                    
                    {{ form_errors(form.description, {'attr': {'class': 'error-message'}}) }}
                </div>

                <!-- Niveau de difficulté + État -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        {{ form_label(form.niveauDifficulte, 'Difficulty Level', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                        }) }}
                        
                        {{ form_widget(form.niveauDifficulte, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition'
                            }
                        }) }}
                        
                        <p class="help-text">📌 Required – Between 1 (easy) and 5 (hard)</p>
                        
                        {{ form_errors(form.niveauDifficulte, {'attr': {'class': 'error-message'}}) }}
                    </div>

                    <div class="space-y-2">
                        {{ form_label(form.etat, 'Status', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300 required'}
                        }) }}
                        
                        {{ form_widget(form.etat, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition'
                            }
                        }) }}
                        
                        <p class="help-text">📌 Required – Flashcard status</p>
                        
                        {{ form_errors(form.etat, {'attr': {'class': 'error-message'}}) }}
                    </div>
                </div>

                <!-- Fichiers -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                    <!-- Image -->
                    <div class="space-y-2">
                        {{ form_label(form.imageFile, 'Image (optional)', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300'}
                        }) }}
                        
                        {% if flashcard.image %}
                            <div class="current-image">
                                <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Current image:</p>
                                <img src="{{ asset('uploads/flashcards/images/' ~ flashcard.image) }}" alt="Current image">
                            </div>
                        {% endif %}
                        
                        {{ form_widget(form.imageFile, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-5 file:rounded file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 dark:file:bg-slate-700 dark:file:text-indigo-300',
                                'accept': 'image/jpeg,image/png,image/webp,image/gif'
                            }
                        }) }}
                        
                        <p class="help-text">💡 Optional – Max 5 MB – JPG, PNG, WEBP, GIF</p>
                        <p class="help-text">Select a new image to replace the current one.</p>
                        
                        {{ form_errors(form.imageFile, {'attr': {'class': 'error-message'}}) }}
                    </div>

                    <!-- PDF -->
                    <div class="space-y-2">
                        {{ form_label(form.pdfFile, 'PDF Document (optional)', {
                            'label_attr': {'class': 'block text-base font-medium text-slate-700 dark:text-slate-300'}
                        }) }}
                        
                        {% if flashcard.pdf %}
                            <div class="mb-4">
                                <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Current PDF:</p>
                                <a href="{{ asset('uploads/flashcards/pdfs/' ~ flashcard.pdf) }}" 
                                   target="_blank"
                                   class="inline-flex items-center px-4 py-2 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 rounded-lg transition no-underline">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                    </svg>
                                    View PDF
                                </a>
                            </div>
                        {% endif %}
                        
                        {{ form_widget(form.pdfFile, {
                            'attr': {
                                'class': 'w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-800 text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-5 file:rounded file:border-0 file:text-sm file:font-medium file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 dark:file:bg-slate-700 dark:file:text-purple-300',
                                'accept': 'application/pdf'
                            }
                        }) }}
                        
                        <p class="help-text">💡 Optional – Max 10 MB – PDF only</p>
                        <p class="help-text">Select a new PDF to replace the current one.</p>
                        
                        {{ form_errors(form.pdfFile, {'attr': {'class': 'error-message'}}) }}
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="flex flex-col sm:flex-row gap-4 justify-end mt-10 pt-8 border-t border-slate-200 dark:border-slate-700">
                    <a href="{{ path('app_revisions_deck_study', {id: deck.idDeck}) }}"
                       class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 font-medium rounded-lg transition no-underline">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                        </svg>
                        Cancel
                    </a>

                    <button type="submit" class="btn-save">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                            <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                        </svg>
                        Save Changes
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

        <!-- Danger Zone -->
        <div class="mt-8 danger-zone">
            <h3 class="text-xl font-bold text-red-800 dark:text-red-300 mb-4 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>
                </svg>
                Danger Zone
            </h3>
            
            <p class="text-red-700 dark:text-red-400 mb-6">
                This action is irreversible. All data associated with this flashcard will be permanently deleted.
            </p>
            
            <form method="post" action="{{ path('app_flashcard_delete', {id: flashcard.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flashcard.id) }}">
                <button type="submit" class="btn-delete" onclick="return confirm('Are you absolutely sure you want to delete this flashcard? This action cannot be undone.');">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                        <path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 4V3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v1"/>
                    </svg>
                    Delete this flashcard permanently
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{# AUCUN BLOCK JAVASCRIPT - Validation 100% serveur #}
{% block javascripts %}
{{ parent() }}
{# RIEN DU TOUT - Pas de Lucide, pas de JS, pas de validation #}
{% endblock %}