// ══════════════════════════════════════════════════════
// Fix emoji flags (render as images for cross-browser)
// ══════════════════════════════════════════════════════
function flagToImg(flag, size = 28) {
    // Convert flag emoji to twemoji-style image via CDN
    const cp = [...flag].map(c => c.codePointAt(0).toString(16)).join('-');
    return `<img src="https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/${cp}.svg"
        style="width:${size}px;height:${size}px;vertical-align:middle;display:inline-block"
        onerror="this.parentNode.textContent='${flag}'" alt="${flag}">`;
}

// Re-render flags in current dest card
function fixFlags() {
    const flagEl = document.getElementById('currentFlag');
    if (flagEl && flagEl.textContent && flagEl.textContent !== '🧭' && flagEl.textContent !== '✈️') {
        const raw = flagEl.textContent.trim();
        flagEl.innerHTML = `<span style="font-size:3rem;font-family:system-ui,serif">${raw}</span>`;
    }
}
setTimeout(fixFlags, 100);

// ══════════════════════════════════════════════════════
// 🎵 Ambient Travel Sound — Web Audio API
// Generates looping ambient travel/airport atmosphere
// ══════════════════════════════════════════════════════
let audioCtx = null;
let masterGain = null;
let isPlaying = false;
let nodes = [];

function createAmbientTravel() {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    masterGain = audioCtx.createGain();
    masterGain.gain.setValueAtTime(0, audioCtx.currentTime);
    masterGain.connect(audioCtx.destination);

    // 1. Soft wind / air noise (white noise filtered)
    function makeWind() {
        const bufferSize = audioCtx.sampleRate * 4;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;

        const source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = 400;
        filter.Q.value = 0.3;

        const gain = audioCtx.createGain();
        gain.gain.value = 0.06;

        source.connect(filter);
        filter.connect(gain);
        gain.connect(masterGain);
        source.start();
        nodes.push(source);
    }

    // 2. Deep hum (airplane engine feel)
    function makeHum(freq, vol) {
        const osc = audioCtx.createOscillator();
        osc.type = 'sine';
        osc.frequency.value = freq;

        const gain = audioCtx.createGain();
        gain.gain.value = vol;

        // Slight LFO modulation for movement feel
        const lfo = audioCtx.createOscillator();
        lfo.frequency.value = 0.08;
        const lfoGain = audioCtx.createGain();
        lfoGain.gain.value = freq * 0.01;
        lfo.connect(lfoGain);
        lfoGain.connect(osc.frequency);
        lfo.start();

        osc.connect(gain);
        gain.connect(masterGain);
        osc.start();
        nodes.push(osc, lfo);
    }

    // 3. Gentle chime / bell tones (departure bell feel)
    function scheduleChimes() {
        const chimeFreqs = [523, 659, 784, 1047, 880, 698, 587];
        let time = audioCtx.currentTime + 2;

        function playChime() {
            const freq = chimeFreqs[Math.floor(Math.random() * chimeFreqs.length)];
            const osc = audioCtx.createOscillator();
            osc.type = 'sine';
            osc.frequency.value = freq;

            const env = audioCtx.createGain();
            env.gain.setValueAtTime(0, time);
            env.gain.linearRampToValueAtTime(0.04, time + 0.02);
            env.gain.exponentialRampToValueAtTime(0.001, time + 2.5);

            osc.connect(env);
            env.connect(masterGain);
            osc.start(time);
            osc.stop(time + 2.5);

            time += 2 + Math.random() * 6;
            if (isPlaying) setTimeout(playChime, (time - audioCtx.currentTime) * 500);
        }
        playChime();
    }

    // 4. Low rumble (aircraft/travel atmosphere)
    function makeRumble() {
        const bufferSize = audioCtx.sampleRate * 2;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * 0.3;

        const source = audioCtx.createBufferSource();
        source.buffer = buffer;
        source.loop = true;

        const filter = audioCtx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 80;

        const gain = audioCtx.createGain();
        gain.gain.value = 0.15;

        source.connect(filter);
        filter.connect(gain);
        gain.connect(masterGain);
        source.start();
        nodes.push(source);
    }

    makeWind();
    makeHum(55, 0.04);
    makeHum(110, 0.025);
    makeHum(82, 0.02);
    makeRumble();
    scheduleChimes();

    // Fade in
    masterGain.gain.linearRampToValueAtTime(0.7, audioCtx.currentTime + 2);
}

function stopAmbient() {
    if (!audioCtx) return;
    masterGain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 1.5);
    setTimeout(() => {
        nodes.forEach(n => { try { n.stop(); } catch(e) {} });
        nodes = [];
        audioCtx.close();
        audioCtx = null;
    }, 1600);
}

// Sound control button
const soundBtn = document.getElementById('soundToggle');
const soundLabel = document.getElementById('soundLabel');

soundBtn.addEventListener('click', () => {
    if (!isPlaying) {
        isPlaying = true;
        createAmbientTravel();
        soundBtn.classList.add('active');
        soundLabel.textContent = 'Music On';
        soundBtn.querySelector('.sound-icon').textContent = '🔊';
    } else {
        isPlaying = false;
        stopAmbient();
        soundBtn.classList.remove('active');
        soundLabel.textContent = 'Music Off';
        soundBtn.querySelector('.sound-icon').textContent = '🔇';
    }
});

// Volume slider
document.getElementById('volumeSlider').addEventListener('input', (e) => {
    if (masterGain) {
        masterGain.gain.setValueAtTime(e.target.value / 100 * 0.7, audioCtx.currentTime);
    }
});
</script>
