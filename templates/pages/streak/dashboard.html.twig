// ══════════════════════════════════════════════════════
// Get current streak from Twig
// ══════════════════════════════════════════════════════
const currentStreak = {{ globalStats.high_score.current }};

// ══════════════════════════════════════════════════════
// Compute unlocked destinations
// ══════════════════════════════════════════════════════
function getStatus(dest) {
    if (currentStreak >= dest.streak) return 'done';
    // Current = the first locked one after all done
    const prevDone = DESTINATIONS.filter(d => currentStreak >= d.streak);
    const nextLocked = DESTINATIONS.find(d => currentStreak < d.streak);
    if (nextLocked && nextLocked.id === dest.id) return 'current';
    return 'locked';
}

const unlockedCount = DESTINATIONS.filter(d => currentStreak >= d.streak).length;
const currentDest = DESTINATIONS.find(d => currentStreak < d.streak) || DESTINATIONS[DESTINATIONS.length - 1];
const nextDest = DESTINATIONS.find(d => d.streak > currentStreak);

// ══════════════════════════════════════════════════════
// Update passport stat
// ══════════════════════════════════════════════════════
document.getElementById('citiesCount').textContent = unlockedCount;

// ══════════════════════════════════════════════════════
// Update current destination card
// ══════════════════════════════════════════════════════
function updateCurrentCard() {
    const lastUnlocked = DESTINATIONS.filter(d => currentStreak >= d.streak).pop();
    const target = lastUnlocked || DESTINATIONS[0];

    if (currentStreak === 0) {
        document.getElementById('currentFlag').textContent = '🧭';
        document.getElementById('currentCity').textContent = 'Start Your Journey';
        document.getElementById('currentCountry').textContent = 'No destination yet';
        document.getElementById('currentFact').textContent = 'Score ≥75% on your first evaluation to unlock Paris!';
        document.getElementById('currentStamp').textContent = '?';
        document.getElementById('destProgress').style.width = '0%';
        document.getElementById('progressPct').textContent = '0%';
        document.getElementById('progressLabel').textContent = 'Score ≥75% to unlock Paris 🇫🇷';
        return;
    }

    document.getElementById('currentFlag').textContent = target.flag;
    document.getElementById('currentCity').textContent = target.city;
    document.getElementById('currentCountry').innerHTML = target.country + ' · ' + target.culture
        + `<span style="display:block;margin-top:3px;font-size:11px;color:#c9a84c;letter-spacing:0.05em">✈️ ${target.iata} · ${target.airport}</span>`;
    document.getElementById('currentFact').textContent = target.fact;
    document.getElementById('currentStamp').textContent = target.stamp;

    if (nextDest) {
        const needed = nextDest.streak;
        const prev = target.streak;
        const pct = Math.round(((currentStreak - prev) / (needed - prev)) * 100);
        document.getElementById('destProgress').style.width = Math.max(0, pct) + '%';
        document.getElementById('progressPct').textContent = pct + '%';
        document.getElementById('progressLabel').textContent = `${needed - currentStreak} more to unlock ${nextDest.city} ${nextDest.flag}`;
    } else {
        document.getElementById('destProgress').style.width = '100%';
        document.getElementById('progressPct').textContent = '100%';
        document.getElementById('progressLabel').textContent = '🏆 All destinations unlocked!';
    }
}
updateCurrentCard();

// ══════════════════════════════════════════════════════
// Build path visual (itinerary)
// ══════════════════════════════════════════════════════
function buildPath() {
    const container = document.getElementById('pathVisual');
    container.innerHTML = '';

    DESTINATIONS.forEach((dest, i) => {
        const status = getStatus(dest);
        const step = document.createElement('div');
        step.className = 'path-step';
        step.innerHTML = `
            <div class="path-dot ${status}">${status === 'done' ? '✓' : status === 'current' ? dest.flag : i + 1}</div>
            <div class="path-content">
                <div class="path-name" style="color:${status === 'done' ? '#4ade80' : status === 'current' ? '#c9a84c' : '#94a3b8'}">
                    ${dest.flag} ${dest.city}
                </div>
                <div class="path-req">${dest.streak} streak${dest.streak > 1 ? 's' : ''} required</div>
                <div style="font-size:10px;color:rgba(201,168,76,0.6);margin-top:1px">✈️ ${dest.iata} — ${dest.airport}</div>
                ${status === 'done' ? '<div style="font-size:11px;color:#4ade80;margin-top:2px">Visited ✓</div>' : ''}
            </div>
        `;
        step.style.animationDelay = (i * 0.04) + 's';
        step.classList.add('fade-in');
        container.appendChild(step);
    });
}
buildPath();

// ══════════════════════════════════════════════════════
// Next teaser
// ══════════════════════════════════════════════════════
if (nextDest) {
    document.getElementById('nextTeaser').style.display = 'flex';
    document.getElementById('nextCity').textContent = `${nextDest.flag} ${nextDest.city}, ${nextDest.country}`;
    document.getElementById('nextHint').textContent = `${nextDest.streak - currentStreak} more high score${nextDest.streak - currentStreak > 1 ? 's' : ''} needed`;
}

// ══════════════════════════════════════════════════════
// City pins on map
// ══════════════════════════════════════════════════════
function buildPins() {
    const container = document.getElementById('cityPins');
    const tooltip = document.getElementById('mapTooltip');
    const mapWrap = document.querySelector('.svg-map-wrap');
    container.innerHTML = '';

    DESTINATIONS.forEach(dest => {
        const status = getStatus(dest);

        const pin = document.createElement('div');
        pin.className = `dest-pin ${status}`;
        pin.style.left = dest.pin.x;
        pin.style.top = dest.pin.y;
        pin.innerHTML = `
            <div class="dest-pin-inner"></div>
            <span class="dest-pin-emoji">${status !== 'locked' ? dest.flag : '🔒'}</span>
        `;

        pin.addEventListener('mouseenter', (e) => {
            const rect = mapWrap.getBoundingClientRect();
            const pinRect = pin.getBoundingClientRect();
            const x = pinRect.left - rect.left + 20;
            const y = pinRect.top - rect.top - 10;

            document.getElementById('ttFlag').textContent = dest.flag;
            document.getElementById('ttCity').textContent = dest.city;
            document.getElementById('ttCountry').textContent = dest.country + ' · ' + dest.culture;
            document.getElementById('ttAirport').innerHTML = status !== 'locked'
                ? `✈️ <span style="font-weight:600">${dest.iata}</span> · ${dest.airport}`
                : `✈️ <span style="opacity:0.4">Airport locked</span>`;
            document.getElementById('ttReq').textContent = status === 'done'
                ? '✅ Visited!'
                : status === 'current'
                ? `🎯 ${dest.streak - currentStreak} more needed`
                : `🔒 Requires ${dest.streak} streak`;
            document.getElementById('ttFact').textContent = status !== 'locked' ? dest.fact : '???';

            const tt = document.getElementById('mapTooltip');
            tt.style.left = Math.min(x, mapWrap.clientWidth - 260) + 'px';
            tt.style.top = Math.max(y - 160, 10) + 'px';
            tt.classList.add('visible');
        });

        pin.addEventListener('mouseleave', () => {
            document.getElementById('mapTooltip').classList.remove('visible');
        });

        container.appendChild(pin);
    });
}
buildPins();

// ══════════════════════════════════════════════════════
// ✈️ Step-by-step plane animation between unlocked cities
// ══════════════════════════════════════════════════════
(function initPlane() {
    const plane     = document.getElementById('planeDot');
    const label     = document.getElementById('flightLabel');
    const pathEl    = document.getElementById('flightPath');
    const mapWrap   = document.querySelector('.svg-map-wrap');

    // Only animate over unlocked + current destinations
    const route = DESTINATIONS.filter(d => getStatus(d) !== 'locked');
    if (route.length < 2) {
        // Only one city unlocked — just park plane there
        if (route.length === 1) {
            plane.style.left  = route[0].pin.x;
            plane.style.top   = route[0].pin.y;
            plane.style.opacity = '0.9';
        }
        return;
    }

    let step = 0; // index in route we're flying TO

    // Convert "44%" style to a number
    function pct(str) { return parseFloat(str); }

    // Compute angle between two points to rotate plane emoji
    function getAngle(from, to) {
        const dx = pct(to.pin.x) - pct(from.pin.x);
        const dy = pct(to.pin.y) - pct(from.pin.y);
        return Math.atan2(dy, dx) * 180 / Math.PI;
    }

    // Build the SVG dashed path through all route points
    function drawRoutePath() {
        if (!pathEl) return;
        const pts = route.map(d => `${pct(d.pin.x)},${pct(d.pin.y)}`);
        // Use smooth curves
        let d = `M ${pts[0]}`;
        for (let i = 1; i < pts.length; i++) {
            const prev = route[i-1], cur = route[i];
            const mx = (pct(prev.pin.x) + pct(cur.pin.x)) / 2;
            const my = (pct(prev.pin.y) + pct(cur.pin.y)) / 2 - 8; // arc up slightly
            d += ` Q ${mx},${my} ${pct(cur.pin.x)},${pct(cur.pin.y)}`;
        }
        pathEl.setAttribute('d', d);
    }
    drawRoutePath();

    // Place plane at first city
    plane.style.left    = route[0].pin.x;
    plane.style.top     = route[0].pin.y;
    plane.style.opacity = '0.95';
    plane.style.transition = 'none';

    function flyToNext() {
        step = (step + 1) % route.length;
        const dest = route[step];
        const from = route[(step - 1 + route.length) % route.length];

        const angle = getAngle(from, dest);
        // Flip emoji direction based on going left or right
        const scaleX = (pct(dest.pin.x) >= pct(from.pin.x)) ? 1 : -1;

        // Re-enable smooth transition
        plane.style.transition = 'left 2.8s cubic-bezier(0.45,0,0.55,1), top 2.8s cubic-bezier(0.45,0,0.55,1), opacity 0.5s, transform 0.3s';
        plane.style.transform  = `translate(-50%,-50%) scaleX(${scaleX})`;
        plane.style.left       = dest.pin.x;
        plane.style.top        = dest.pin.y;

        // Show label mid-flight (1.4s into the 2.8s trip)
        setTimeout(() => {
            label.style.left = dest.pin.x;
            label.style.top  = dest.pin.y;
            label.innerHTML  = `${dest.flag} <strong>${dest.city}</strong> · <span style="opacity:.7">${dest.iata}</span>`;
            label.classList.add('visible');
            setTimeout(() => label.classList.remove('visible'), 1800);
        }, 1200);

        // After arriving, wait 1.5s then fly to next
        setTimeout(flyToNext, 4800); // 2.8s flight + 2s pause
    }

    // Start flying after 1 second
    setTimeout(flyToNext, 1000);
})();

// ══════════════════════════════════════════════════════
// Animate bars
