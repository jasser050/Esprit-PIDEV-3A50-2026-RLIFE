const currentStreak = {{ globalStats.high_score.current }};

function getStatus(dest) {
    if (currentStreak >= dest.streak) return 'done';
    const nextLocked = DESTINATIONS.find(d => currentStreak < d.streak);
    if (nextLocked && nextLocked.id === dest.id) return 'current';
    return 'locked';
}

const unlockedCount = DESTINATIONS.filter(d => currentStreak >= d.streak).length;
const nextDest = DESTINATIONS.find(d => d.streak > currentStreak);

document.getElementById('citiesCount').textContent = unlockedCount;

// ── Current destination card ──
function updateCurrentCard() {
    const lastUnlocked = DESTINATIONS.filter(d => currentStreak >= d.streak).pop();
    const target = lastUnlocked || DESTINATIONS[0];

    if (currentStreak === 0) {
        document.getElementById('currentFlag').textContent = '🧭';
        document.getElementById('currentCity').textContent = 'Start Your Journey';
        document.getElementById('currentCountry').textContent = 'No destination yet';
        document.getElementById('currentFact').textContent = 'Score ≥75% on your first evaluation to unlock Paris!';
        document.getElementById('currentStamp').textContent = '?';
        document.getElementById('destProgress').style.width = '0%';
        document.getElementById('progressPct').textContent = '0%';
        document.getElementById('progressLabel').textContent = 'Score ≥75% to unlock Paris 🇫🇷';
        return;
    }

    document.getElementById('currentFlag').textContent = target.flag;
    document.getElementById('currentCity').textContent = target.city;
    document.getElementById('currentCountry').innerHTML =
        target.country + ' · ' + target.culture +
        `<span style="display:block;margin-top:3px;font-size:11px;color:var(--wt-gold);letter-spacing:0.05em">✈️ ${target.iata} · ${target.airport}</span>`;
    document.getElementById('currentFact').textContent = target.fact;
    document.getElementById('currentStamp').textContent = target.stamp;

    if (nextDest) {
        const needed = nextDest.streak;
        const prev = target.streak;
        const pct = Math.max(0, Math.round(((currentStreak - prev) / (needed - prev)) * 100));
        document.getElementById('destProgress').style.width = pct + '%';
        document.getElementById('progressPct').textContent = pct + '%';
        document.getElementById('progressLabel').textContent = `${needed - currentStreak} more to unlock ${nextDest.city} ${nextDest.flag}`;
    } else {
        document.getElementById('destProgress').style.width = '100%';
        document.getElementById('progressPct').textContent = '100%';
        document.getElementById('progressLabel').textContent = '🏆 All destinations unlocked!';
    }
}
updateCurrentCard();

// ── Build itinerary path ──
function buildPath() {
    const container = document.getElementById('pathVisual');
    container.innerHTML = '';
    DESTINATIONS.forEach((dest, i) => {
        const status = getStatus(dest);
        const colors = { done: 'var(--wt-green)', current: 'var(--wt-gold)', locked: 'var(--wt-text-secondary)' };
        const step = document.createElement('div');
        step.className = 'path-step fade-in';
        step.style.animationDelay = (i * 0.04) + 's';
        step.innerHTML = `
            <div class="path-dot ${status}">${status === 'done' ? '✓' : status === 'current' ? dest.flag : i + 1}</div>
            <div class="path-content">
                <div class="path-name" style="color:${colors[status]}">${dest.flag} ${dest.city}</div>
                <div class="path-req">${dest.streak} streak${dest.streak > 1 ? 's' : ''} required</div>
                <div style="font-size:10px;color:var(--wt-gold);opacity:0.7;margin-top:1px">✈️ ${dest.iata} — ${dest.airport}</div>
                ${status === 'done' ? '<div style="font-size:11px;color:var(--wt-green);margin-top:2px">Visited ✓</div>' : ''}
            </div>
        `;
        container.appendChild(step);
    });
}
buildPath();

// ── Next teaser ──
if (nextDest) {
    document.getElementById('nextTeaser').style.display = 'flex';
    document.getElementById('nextCity').textContent = `${nextDest.flag} ${nextDest.city}, ${nextDest.country}`;
    document.getElementById('nextHint').textContent = `${nextDest.streak - currentStreak} more high score${nextDest.streak - currentStreak > 1 ? 's' : ''} needed`;
}

// ── City pins on map ──
function buildPins() {
    const container = document.getElementById('cityPins');
    const mapWrap = document.querySelector('.svg-map-wrap');
    container.innerHTML = '';
    DESTINATIONS.forEach(dest => {
        const status = getStatus(dest);
        const pin = document.createElement('div');
        pin.className = `dest-pin ${status === 'done' ? 'unlocked' : status}`;
        pin.style.left = dest.pin.x;
        pin.style.top = dest.pin.y;
        pin.innerHTML = `
            <div class="dest-pin-inner"></div>
            <span class="dest-pin-emoji">${status !== 'locked' ? dest.flag : '🔒'}</span>
        `;
        pin.addEventListener('mouseenter', () => {
            const rect = mapWrap.getBoundingClientRect();
            const pinRect = pin.getBoundingClientRect();
            const x = pinRect.left - rect.left + 20;
            const y = pinRect.top - rect.top - 10;
            document.getElementById('ttFlag').textContent = dest.flag;
            document.getElementById('ttCity').textContent = dest.city;
            document.getElementById('ttCountry').textContent = dest.country + ' · ' + dest.culture;
            document.getElementById('ttAirport').innerHTML = status !== 'locked'
                ? `✈️ <span style="font-weight:600">${dest.iata}</span> · ${dest.airport}`
                : `✈️ <span style="opacity:0.4">Airport locked</span>`;
            document.getElementById('ttReq').textContent = status === 'done'
                ? '✅ Visited!' : status === 'current'
                ? `🎯 ${dest.streak - currentStreak} more needed`
                : `🔒 Requires ${dest.streak} streak`;
            document.getElementById('ttFact').textContent = status !== 'locked' ? dest.fact : '???';
            const clickHint = document.getElementById('ttClickHint');
            clickHint.style.display = status !== 'locked' ? 'flex' : 'none';
            const tt = document.getElementById('mapTooltip');
            tt.style.left = Math.min(x, mapWrap.clientWidth - 260) + 'px';
            tt.style.top = Math.max(y - 160, 10) + 'px';
            tt.classList.add('visible');
        });
        pin.addEventListener('mouseleave', () => {
            document.getElementById('mapTooltip').classList.remove('visible');
        });

        // Click → Google search about the city/country
        pin.addEventListener('click', () => {
            if (status === 'locked') {
                // Locked: show a fun "you need more streaks" shake
                pin.style.animation = 'shake 0.4s ease';
                setTimeout(() => pin.style.animation = '', 500);
                return;
            }
            const query = encodeURIComponent(`${dest.city} ${dest.country} travel guide`);
            window.open(`https://www.google.com/search?q=${query}`, '_blank', 'noopener');
        });

        // Show pointer cursor for unlocked/current
        if (status !== 'locked') {
            pin.style.cursor = 'pointer';
        } else {
            pin.style.cursor = 'not-allowed';
        }

        container.appendChild(pin);
    });
}
buildPins();

// ── Plane animation ──
(function initPlane() {
    const plane = document.getElementById('planeDot');
    const label = document.getElementById('flightLabel');
    const pathEl = document.getElementById('flightPath');
    const mapWrap = document.querySelector('.svg-map-wrap');
    const route = DESTINATIONS.filter(d => getStatus(d) !== 'locked');
    if (route.length < 2) {
        if (route.length === 1) { plane.style.left = route[0].pin.x; plane.style.top = route[0].pin.y; plane.style.opacity = '0.9'; }
        return;
    }
    let step = 0;
    function pct(str) { return parseFloat(str); }

    function drawRoutePath() {
        if (!pathEl) return;
        let d = `M ${pct(route[0].pin.x)},${pct(route[0].pin.y)}`;
        for (let i = 1; i < route.length; i++) {
            const prev = route[i-1], cur = route[i];
            const mx = (pct(prev.pin.x) + pct(cur.pin.x)) / 2;
            const my = (pct(prev.pin.y) + pct(cur.pin.y)) / 2 - 8;
            d += ` Q ${mx},${my} ${pct(cur.pin.x)},${pct(cur.pin.y)}`;
        }
        pathEl.setAttribute('d', d);
    }
    drawRoutePath();

    plane.style.left = route[0].pin.x;
    plane.style.top = route[0].pin.y;
    plane.style.opacity = '0.95';
    plane.style.transition = 'none';

    function flyToNext() {
        step = (step + 1) % route.length;
        const dest = route[step];
        const from = route[(step - 1 + route.length) % route.length];
        const scaleX = (pct(dest.pin.x) >= pct(from.pin.x)) ? 1 : -1;
        plane.style.transition = 'left 2.8s cubic-bezier(0.45,0,0.55,1), top 2.8s cubic-bezier(0.45,0,0.55,1), opacity 0.5s, transform 0.3s';
        plane.style.transform = `translate(-50%,-50%) scaleX(${scaleX})`;
        plane.style.left = dest.pin.x;
        plane.style.top = dest.pin.y;
        setTimeout(() => {
            label.style.left = dest.pin.x;
            label.style.top = dest.pin.y;
            label.innerHTML = `${dest.flag} <strong>${dest.city}</strong> · <span style="opacity:.7">${dest.iata}</span>`;
            label.classList.add('visible');
            setTimeout(() => label.classList.remove('visible'), 1800);
        }, 1200);
        setTimeout(flyToNext, 4800);
    }
    setTimeout(flyToNext, 1000);
})();

// ── Animate bars ──
setTimeout(() => {
    document.querySelectorAll('.subject-bar-fill[data-w]').forEach(b => { b.style.width = b.dataset.w + '%'; });
    const fill = document.getElementById('destProgress');
    if (fill && fill.style.width) {
        const w = fill.style.width;
        fill.style.width = '0%';
        setTimeout(() => { fill.style.width = w; }, 100);
    }
}, 400);

// ── Sync map ocean color with theme ──
function syncMapTheme() {
    const ocean = document.getElementById('mapOcean');
    if (!ocean) return;
    const isDark = document.documentElement.dataset.theme === 'dark'
        || document.body.classList.contains('dark')
        || document.documentElement.classList.contains('dark')
        || !document.documentElement.dataset.theme; // default dark
    const isLight = document.documentElement.dataset.theme === 'light'
        || document.body.classList.contains('theme-light')
        || document.documentElement.classList.contains('theme-light');

    ocean.style.fill = isLight ? '#cfe3f5' : '#0d2137';

    document.querySelectorAll('.country-path').forEach(p => {
        p.style.fill = '';
    });
}
syncMapTheme();

// Watch for theme changes (mutation observer on html/body class or data-theme)
const themeObserver = new MutationObserver(syncMapTheme);
themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });
themeObserver.observe(document.body, { attributes: true, attributeFilter: ['data-theme', 'class'] });

if (typeof lucide !== 'undefined') lucide.createIcons();

// ── Ambient Travel Sound ──
let audioCtx = null, masterGain = null, isPlaying = false, nodes = [];

function createAmbientTravel() {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    masterGain = audioCtx.createGain();
    masterGain.gain.setValueAtTime(0, audioCtx.currentTime);
    masterGain.connect(audioCtx.destination);

    function makeWind() {
        const bufferSize = audioCtx.sampleRate * 4;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
        const source = audioCtx.createBufferSource();
        source.buffer = buffer; source.loop = true;
        const filter = audioCtx.createBiquadFilter();
        filter.type = 'bandpass'; filter.frequency.value = 400; filter.Q.value = 0.3;
        const gain = audioCtx.createGain(); gain.gain.value = 0.06;
        source.connect(filter); filter.connect(gain); gain.connect(masterGain);
        source.start(); nodes.push(source);
    }
    function makeHum(freq, vol) {
        const osc = audioCtx.createOscillator(); osc.type = 'sine'; osc.frequency.value = freq;
        const gain = audioCtx.createGain(); gain.gain.value = vol;
        const lfo = audioCtx.createOscillator(); lfo.frequency.value = 0.08;
        const lfoGain = audioCtx.createGain(); lfoGain.gain.value = freq * 0.01;
        lfo.connect(lfoGain); lfoGain.connect(osc.frequency); lfo.start();
        osc.connect(gain); gain.connect(masterGain); osc.start();
        nodes.push(osc, lfo);
    }
    function scheduleChimes() {
        const chimeFreqs = [523, 659, 784, 1047, 880, 698, 587];
        let time = audioCtx.currentTime + 2;
        function playChime() {
            const freq = chimeFreqs[Math.floor(Math.random() * chimeFreqs.length)];
            const osc = audioCtx.createOscillator(); osc.type = 'sine'; osc.frequency.value = freq;
            const env = audioCtx.createGain();
            env.gain.setValueAtTime(0, time);
            env.gain.linearRampToValueAtTime(0.04, time + 0.02);
            env.gain.exponentialRampToValueAtTime(0.001, time + 2.5);
            osc.connect(env); env.connect(masterGain);
            osc.start(time); osc.stop(time + 2.5);
            time += 2 + Math.random() * 6;
            if (isPlaying) setTimeout(playChime, (time - audioCtx.currentTime) * 500);
        }
        playChime();
    }
    function makeRumble() {
        const bufferSize = audioCtx.sampleRate * 2;
        const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * 0.3;
        const source = audioCtx.createBufferSource(); source.buffer = buffer; source.loop = true;
        const filter = audioCtx.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 80;
        const gain = audioCtx.createGain(); gain.gain.value = 0.15;
        source.connect(filter); filter.connect(gain); gain.connect(masterGain);
        source.start(); nodes.push(source);
    }
    makeWind(); makeHum(55, 0.04); makeHum(110, 0.025); makeHum(82, 0.02); makeRumble(); scheduleChimes();
    masterGain.gain.linearRampToValueAtTime(0.7, audioCtx.currentTime + 2);
}

function stopAmbient() {
    if (!audioCtx) return;
    masterGain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + 1.5);
    setTimeout(() => {
        nodes.forEach(n => { try { n.stop(); } catch(e) {} });
        nodes = []; audioCtx.close(); audioCtx = null;
    }, 1600);
}

const soundBtn = document.getElementById('soundToggle');
const soundLabel = document.getElementById('soundLabel');
soundBtn.addEventListener('click', () => {
    if (!isPlaying) {
        isPlaying = true; createAmbientTravel();
        soundBtn.classList.add('active');
        soundLabel.textContent = 'Music On';
        soundBtn.querySelector('.sound-icon').textContent = '🔊';
    } else {
        isPlaying = false; stopAmbient();
        soundBtn.classList.remove('active');
        soundLabel.textContent = 'Music Off';
        soundBtn.querySelector('.sound-icon').textContent = '🔇';
    }
});
document.getElementById('volumeSlider').addEventListener('input', (e) => {
    if (masterGain) masterGain.gain.setValueAtTime(e.target.value / 100 * 0.7, audioCtx.currentTime);
});
