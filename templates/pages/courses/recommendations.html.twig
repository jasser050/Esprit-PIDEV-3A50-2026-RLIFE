{% extends 'base.html.twig' %}

{% block title %}Cours recommandés - Evaluation #{{ evaluation.idEval }}{% endblock %}

{% block body %}
<div class="space-y-6">
    {# Breadcrumbs #}
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Courses', href: path('app_courses') },
            { label: 'Evaluation #' ~ evaluation.idEval, href: path('app_courses_show', {id: evaluation.idEval}) },
            { label: 'Recommandations' }
        ]
    } %}

    {# En-tête #}
    <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">
            🎓 Cours recommandés
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
            Basés sur les matières de votre évaluation #{{ evaluation.idEval }}
        </p>
        <p class="text-sm text-gray-500 mt-2">
            {{ totalResults }} cours trouvés sur {{ recommendations|length }} matière(s)
        </p>
    </div>

    {# Résultats par matière #}
    {% if recommendations is not empty %}
        {% for recommendation in recommendations %}
            <div class="card p-6">
                {# En-tête de la matière #}
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-3">
                        <span class="px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-full">
                            {{ recommendation.code }}
                        </span>
                        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                            📚 {{ recommendation.matiere }}
                        </h2>
                    </div>
                    <span class="text-sm text-gray-500">
                        {{ recommendation.courses|length }} cours disponibles
                    </span>
                </div>

                {# Liste des cours #}
                <div class="space-y-4">
                    {% for course in recommendation.courses %}
                        <a href="{{ course.link }}" 
                           target="_blank"
                           class="block p-5 bg-gradient-to-r from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-700 hover:from-indigo-50 hover:to-purple-50 dark:hover:from-indigo-900/20 dark:hover:to-purple-900/20 rounded-xl transition-all duration-200 border border-gray-200 dark:border-gray-600 hover:border-indigo-300 dark:hover:border-indigo-600 hover:shadow-lg">
                            
                            <div class="flex items-start gap-4">
                                {# Favicon ou icône #}
                                {% if course.image %}
                                    <img src="{{ course.image }}" 
                                         alt="{{ course.displayLink }}"
                                         class="w-16 h-16 rounded-lg object-cover flex-shrink-0">
                                {% else %}
                                    <div class="w-16 h-16 bg-indigo-100 dark:bg-indigo-900 rounded-lg flex items-center justify-center flex-shrink-0">
                                        <svg class="w-8 h-8 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                                        </svg>
                                    </div>
                                {% endif %}

                                {# Contenu #}
                                <div class="flex-1 min-w-0">
                                    <h3 class="font-bold text-lg text-indigo-600 dark:text-indigo-400 mb-2 hover:text-indigo-700 dark:hover:text-indigo-300 line-clamp-2">
                                        {{ course.title }}
                                    </h3>
                                    <p class="text-sm text-gray-600 dark:text-gray-300 mb-3 line-clamp-2">
                                        {{ course.snippet }}
                                    </p>
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex items-center text-xs text-gray-500 dark:text-gray-400">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                                      d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                                            </svg>
                                            {{ course.displayLink }}
                                        </span>
                                        <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    {% else %}
        {# Aucun résultat #}
        <div class="card p-12 text-center">
            <svg class="w-24 h-24 mx-auto text-gray-300 dark:text-gray-600 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                      d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">
                Aucun cours trouvé
            </h3>
            <p class="text-gray-500 dark:text-gray-400">
                Impossible de trouver des recommandations pour cette évaluation.
            </p>
        </div>
    {% endif %}

    {# Bouton retour #}
    <div class="flex justify-center">
        <a href="{{ path('app_courses_show', {id: evaluation.idEval}) }}" 
           class="inline-flex items-center px-6 py-3 bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg transition-colors duration-200">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Retour à l'évaluation
        </a>
    </div>
</div>
{% endblock %}