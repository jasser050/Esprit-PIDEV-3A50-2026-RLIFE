{% extends 'base.html.twig' %}

{% block title %}IQ Test - Start{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
    <div class="max-w-4xl mx-auto px-4 py-16">
        
        {# Main Card #}
        <div class="bg-white/10 backdrop-blur-lg rounded-3xl border border-white/20 p-8 md:p-12 shadow-2xl">
            
            {# Header #}
            <div class="text-center mb-12">
                <div class="inline-block mb-6">
                    <div class="text-8xl mb-4 animate-bounce">🧠</div>
                </div>
                <h1 class="text-5xl md:text-6xl font-bold text-white mb-4">
                    IQ Test
                </h1>
                <p class="text-xl text-purple-200 max-w-2xl mx-auto">
                    Evaluate your cognitive intelligence and discover your score.
                    Take your time, but try to answer quickly and accurately.
                </p>
            </div>

            {# Features Grid #}
            <div class="grid md:grid-cols-3 gap-6 mb-12">
                <div class="bg-white/5 backdrop-blur rounded-2xl p-6 border border-white/10 text-center hover:bg-white/10 transition-all">
                    <div class="text-5xl mb-4">📝</div>
                    <h3 class="font-bold text-white text-lg mb-2">15 Questions</h3>
                    <p class="text-sm text-purple-200">
                        Various subjects from Tunisian Baccalaureate curriculum
                    </p>
                </div>

                <div class="bg-white/5 backdrop-blur rounded-2xl p-6 border border-white/10 text-center hover:bg-white/10 transition-all">
                    <div class="text-5xl mb-4">⏱️</div>
                    <h3 class="font-bold text-white text-lg mb-2">No Time Limit</h3>
                    <p class="text-sm text-purple-200">
                        Take your time, but faster answers give bonus points
                    </p>
                </div>

                <div class="bg-white/5 backdrop-blur rounded-2xl p-6 border border-white/10 text-center hover:bg-white/10 transition-all">
                    <div class="text-5xl mb-4">🎯</div>
                    <h3 class="font-bold text-white text-lg mb-2">Instant Results</h3>
                    <p class="text-sm text-purple-200">
                        Get your IQ score and detailed analysis immediately
                    </p>
                </div>
            </div>

            {# Start Button #}
            <div class="text-center mb-8">
                <a href="{{ path('iq_test_index') }}"
                   class="inline-flex items-center gap-3 px-12 py-5 text-xl font-bold text-white bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 rounded-2xl shadow-2xl hover:shadow-purple-500/50 transform hover:scale-105 transition-all duration-300">
                    <span>Start Test Now</span>
                    <i data-lucide="arrow-right" class="w-6 h-6"></i>
                </a>
            </div>

            {# Tips Section #}
            <div class="bg-blue-900/30 backdrop-blur border border-blue-500/30 rounded-2xl p-6">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
                            <i data-lucide="lightbulb" class="w-6 h-6 text-blue-300"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-blue-200 mb-3">💡 Tips for Success</h3>
                        <ul class="space-y-2 text-sm text-blue-100">
                            <li class="flex items-start gap-2">
                                <span class="text-blue-400 mt-1">✓</span>
                                <span>Read each question carefully before answering</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-blue-400 mt-1">✓</span>
                                <span>Don't spend too much time on one question</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-blue-400 mt-1">✓</span>
                                <span>Try to answer all questions for a complete score</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-blue-400 mt-1">✓</span>
                                <span>Find a quiet environment and stay focused</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-blue-400 mt-1">✓</span>
                                <span>Trust your first instinct when unsure</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            {# Back Link #}
            <div class="text-center mt-8">
                <a href="{{ path('app_courses') }}" 
                   class="inline-flex items-center gap-2 text-purple-200 hover:text-white transition-colors">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    <span>Back to Courses</span>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate-fade-in {
    animation: fadeIn 0.7s ease-out;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('IQ Test Start Page Loaded');
    
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
        console.log('Lucide icons initialized');
    }
});
</script>
{% endblock %}
