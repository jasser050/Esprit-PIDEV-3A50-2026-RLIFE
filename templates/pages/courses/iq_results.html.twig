{% extends 'base.html.twig' %}

{% block title %}Résultats Test IQ{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-6 animate-fade-in">

    {# ================= HERO SCORE ================= #}
    <div class="card overflow-hidden bg-gradient-to-br from-purple-600 via-indigo-600 to-blue-600 text-white relative">
        <div class="absolute inset-0 bg-black opacity-10"></div>

        <div class="relative p-10 md:p-16 text-center">

            <div class="inline-flex items-center gap-2 px-6 py-2 bg-white/20 rounded-full mb-6 animate-bounce">
                <span class="font-semibold">✔ Test terminé</span>
            </div>

            {# SCORE IQ #}
            <div class="relative inline-block mb-6">
                <div class="w-48 h-48 mx-auto bg-white/20 rounded-full flex items-center justify-center shadow-2xl border-4 border-white/30">
                    <div class="text-center">
                        <div class="text-7xl font-bold">{{ result.iq_score }}</div>
                        <div class="text-sm uppercase tracking-wider opacity-90">Score IQ</div>
                    </div>
                </div>
            </div>

            <h1 class="text-4xl font-bold mb-3">{{ result.level }}</h1>

            {# ================= TIMER FINAL ================= #}
            <div class="mt-6 flex justify-center">
                <div class="px-8 py-4 bg-white/20 backdrop-blur-sm rounded-2xl border border-white/30 shadow-lg">
                    <div class="text-sm uppercase tracking-wider opacity-80 mb-1">
                        ⏱️ Temps total
                    </div>
                    <div id="finalTimer"
                         class="text-3xl font-bold text-white"
                         data-seconds="{{ result.time_spent }}">
                        0:00
                    </div>
                </div>
            </div>

            {# STATS #}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-10">
                <div class="bg-white/10 rounded-2xl p-6">
                    <div class="text-4xl font-bold">{{ result.correct_answers }}</div>
                    <div class="text-sm opacity-90">Bonnes réponses</div>
                </div>

                <div class="bg-white/10 rounded-2xl p-6">
                    <div class="text-4xl font-bold">{{ result.percentage }}%</div>
                    <div class="text-sm opacity-90">Réussite</div>
                </div>

                <div class="bg-white/10 rounded-2xl p-6">
                    <div class="text-4xl font-bold">{{ (result.time_spent / 60)|round(1) }}</div>
                    <div class="text-sm opacity-90">Minutes</div>
                </div>

                <div class="bg-white/10 rounded-2xl p-6">
                    <div class="text-4xl font-bold">{{ result.average_time_per_question|round }}</div>
                    <div class="text-sm opacity-90">Sec / question</div>
                </div>
            </div>

        </div>
    </div>

    {# ================= ANALYSE ================= #}
    <div class="card p-8">
        <h2 class="text-2xl font-bold mb-6">🔍 Analyse détaillée</h2>

        {% for detail in detailedResults %}
            <div class="p-5 rounded-xl border-2 mb-4
                {% if detail.is_correct %}
                    border-green-300 bg-green-50
                {% else %}
                    border-red-300 bg-red-50
                {% endif %}
            ">
                <p class="font-semibold mb-2">{{ loop.index }}. {{ detail.question }}</p>

                <p class="text-sm">
                    <strong>Votre réponse :</strong>
                    {{ detail.user_answer ?? 'Non répondu' }}
                </p>

                {% if not detail.is_correct %}
                    <p class="text-sm mt-1">
                        <strong>Bonne réponse :</strong>
                        {{ detail.correct_answer }}
                    </p>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {# ================= ACTIONS ================= #}
    <div class="flex flex-wrap gap-4">
        <a href="{{ path('iq_test_start') }}" class="btn btn-primary">
            🔁 Refaire le test
        </a>

        <a href="{{ path('app_courses') }}" class="btn btn-secondary">
            ← Retour aux cours
        </a>

        <button onclick="window.print()" class="btn btn-secondary">
            🖨️ Imprimer
        </button>
    </div>
</div>

{# ================= STYLES ================= #}
<style>
@media print {
    .btn { display: none !important; }
}
</style>

{# ================= JAVASCRIPT ================= #}
<script>
document.addEventListener('DOMContentLoaded', () => {

    /* ================= TIMER FINAL ================= */
    const timer = document.getElementById('finalTimer');
    if (!timer) return;

    const totalSeconds = parseInt(timer.dataset.seconds);
    let current = 0;

    const interval = setInterval(() => {
        current++;

        const minutes = Math.floor(current / 60);
        const seconds = current % 60;

        timer.textContent =
            minutes + ':' + String(seconds).padStart(2, '0');

        if (current >= totalSeconds) {
            clearInterval(interval);
        }
    }, 30); // animation fluide
});
</script>
{% endblock %}
