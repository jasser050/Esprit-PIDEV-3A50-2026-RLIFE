{% extends 'base.html.twig' %}

{% block title %}IQ Test Results{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-8 p-4 animate-fade-in">

    {# ================= HERO SCORE ================= #}
    <div class="relative overflow-hidden rounded-3xl shadow-2xl">
        {# Animated background #}
        <div class="absolute inset-0 bg-gradient-to-br from-purple-600 via-indigo-600 to-blue-600"></div>
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-20"></div>
        
        <div class="relative p-10 md:p-16 text-center text-white">
            {# Completion badge #}
            <div class="inline-flex items-center gap-2 px-6 py-3 bg-white/20 backdrop-blur-sm rounded-full mb-8 animate-bounce shadow-lg border border-white/30">
                <i data-lucide="check-circle" class="w-5 h-5"></i>
                <span class="font-semibold">Test Completed Successfully!</span>
            </div>

            {# SCORE IQ with animation #}
            <div class="relative inline-block mb-8">
                <div class="absolute inset-0 bg-white/10 rounded-full blur-2xl animate-pulse"></div>
                <div class="relative w-52 h-52 mx-auto bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center shadow-2xl border-4 border-white/40 transform hover:scale-105 transition-transform duration-300">
                    <div class="text-center">
                        <div class="text-8xl font-black mb-2 animate-number" id="iqScoreDisplay">0</div>
                        <div class="text-sm uppercase tracking-widest opacity-90 font-semibold">IQ Score</div>
                    </div>
                </div>
            </div>

            <h1 class="text-5xl font-black mb-3 drop-shadow-lg">{{ result.level }}</h1>
            <p class="text-lg opacity-90 max-w-2xl mx-auto">{{ result.description ?? 'Excellent performance!' }}</p>

            {# ================= TIMER FINAL ================= #}
            <div class="mt-8 flex justify-center">
                <div class="px-10 py-5 bg-white/20 backdrop-blur-md rounded-2xl border-2 border-white/40 shadow-2xl">
                    <div class="flex items-center gap-3 mb-2">
                        <i data-lucide="clock" class="w-5 h-5"></i>
                        <div class="text-sm uppercase tracking-wider font-semibold">
                            Total Time
                        </div>
                    </div>
                    <div id="finalTimer"
                         class="text-4xl font-black text-white"
                         data-seconds="{{ result.time_spent }}">
                        0:00
                    </div>
                </div>
            </div>

            {# STATS #}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mt-10">
                <div class="bg-white/15 backdrop-blur-sm rounded-2xl p-6 border border-white/20 hover:bg-white/25 transition-all duration-300 transform hover:scale-105 hover:shadow-xl">
                    <div class="flex items-center justify-center mb-2">
                        <i data-lucide="check-circle-2" class="w-10 h-10 mb-2"></i>
                    </div>
                    <div class="text-5xl font-black mb-2">{{ result.correct_answers }}</div>
                    <div class="text-sm uppercase tracking-wide font-semibold opacity-90">Correct Answers</div>
                </div>

                <div class="bg-white/15 backdrop-blur-sm rounded-2xl p-6 border border-white/20 hover:bg-white/25 transition-all duration-300 transform hover:scale-105 hover:shadow-xl">
                    <div class="flex items-center justify-center mb-2">
                        <i data-lucide="target" class="w-10 h-10 mb-2"></i>
                    </div>
                    <div class="text-5xl font-black mb-2">{{ result.percentage }}%</div>
                    <div class="text-sm uppercase tracking-wide font-semibold opacity-90">Accuracy</div>
                </div>

                <div class="bg-white/15 backdrop-blur-sm rounded-2xl p-6 border border-white/20 hover:bg-white/25 transition-all duration-300 transform hover:scale-105 hover:shadow-xl">
                    <div class="flex items-center justify-center mb-2">
                        <i data-lucide="timer" class="w-10 h-10 mb-2"></i>
                    </div>
                    <div class="text-5xl font-black mb-2">{{ (result.time_spent / 60)|round(1) }}</div>
                    <div class="text-sm uppercase tracking-wide font-semibold opacity-90">Minutes</div>
                </div>

                <div class="bg-white/15 backdrop-blur-sm rounded-2xl p-6 border border-white/20 hover:bg-white/25 transition-all duration-300 transform hover:scale-105 hover:shadow-xl">
                    <div class="flex items-center justify-center mb-2">
                        <i data-lucide="gauge" class="w-10 h-10 mb-2"></i>
                    </div>
                    <div class="text-5xl font-black mb-2">{{ result.average_time_per_question|round }}</div>
                    <div class="text-sm uppercase tracking-wide font-semibold opacity-90">Sec / Question</div>
                </div>
            </div>

        </div>
    </div>

    {# ================= ANALYSE ================= #}
    <div class="card p-8 shadow-xl">
        <div class="flex items-center gap-3 mb-8">
            <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center">
                <i data-lucide="list-checks" class="w-6 h-6 text-white"></i>
            </div>
            <h2 class="text-3xl font-bold text-secondary-900 dark:text-white">Detailed Analysis</h2>
        </div>

        <div class="space-y-4">
        {% for detail in detailedResults %}
            <div class="group p-6 rounded-2xl border-2 transition-all duration-300 hover:shadow-lg
                {% if detail.is_correct %}
                    border-green-300 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 dark:border-green-700 hover:border-green-400
                {% else %}
                    border-red-300 bg-gradient-to-br from-red-50 to-rose-50 dark:from-red-900/20 dark:to-rose-900/20 dark:border-red-700 hover:border-red-400
                {% endif %}
            ">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center font-bold text-lg
                        {% if detail.is_correct %}
                            bg-green-600 text-white
                        {% else %}
                            bg-red-600 text-white
                        {% endif %}
                    ">
                        {{ loop.index }}
                    </div>
                    
                    <div class="flex-1">
                        <div class="flex items-start justify-between gap-4 mb-3">
                            <p class="font-semibold text-lg text-secondary-900 dark:text-white">{{ detail.question }}</p>
                            {% if detail.is_correct %}
                                <i data-lucide="check-circle" class="w-6 h-6 text-green-600 dark:text-green-400 flex-shrink-0"></i>
                            {% else %}
                                <i data-lucide="x-circle" class="w-6 h-6 text-red-600 dark:text-red-400 flex-shrink-0"></i>
                            {% endif %}
                        </div>

                        <div class="space-y-2">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-semibold
                                    {% if detail.is_correct %}
                                        bg-green-200 text-green-900 dark:bg-green-800 dark:text-green-100
                                    {% else %}
                                        bg-red-200 text-red-900 dark:bg-red-800 dark:text-red-100
                                    {% endif %}
                                ">
                                    <i data-lucide="user" class="w-4 h-4 mr-1"></i>
                                    Your answer:
                                </span>
                                <span class="font-medium text-secondary-800 dark:text-secondary-200">
                                    {{ detail.user_answer ?? '❌ Not answered' }}
                                </span>
                            </div>

                            {% if not detail.is_correct %}
                                <div class="flex items-center gap-2">
                                    <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-semibold bg-blue-200 text-blue-900 dark:bg-blue-800 dark:text-blue-100">
                                        <i data-lucide="lightbulb" class="w-4 h-4 mr-1"></i>
                                        Correct answer:
                                    </span>
                                    <span class="font-bold text-blue-700 dark:text-blue-300">
                                        {{ detail.correct_answer }}
                                    </span>
                                </div>
                            {% endif %}
                        </div>

                        <div class="flex items-center gap-2 mt-3">
                            <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-secondary-200 text-secondary-700 dark:bg-secondary-700 dark:text-secondary-300">
                                <i data-lucide="folder" class="w-3 h-3 mr-1"></i>
                                {{ detail.category }}
                            </span>
                            <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium
                                {% if detail.difficulty == 'easy' %}
                                    bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300
                                {% elseif detail.difficulty == 'medium' %}
                                    bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300
                                {% else %}
                                    bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300
                                {% endif %}
                            ">
                                <i data-lucide="zap" class="w-3 h-3 mr-1"></i>
                                {{ detail.difficulty|capitalize }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>

    {# ================= ACTIONS ================= #}
    <div class="card p-6 bg-gradient-to-r from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 border-2 border-purple-200 dark:border-purple-800 shadow-xl">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div>
                <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-1">What's next?</h3>
                <p class="text-sm text-secondary-600 dark:text-secondary-400">Challenge yourself again or explore more courses</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a href="{{ path('iq_test_start') }}" class="btn btn-primary shadow-lg hover:shadow-xl transform hover:scale-105 transition-all">
                    <i data-lucide="repeat" class="w-5 h-5 mr-2"></i>
                    Retake Test
                </a>

                <a href="{{ path('app_courses') }}" class="btn btn-secondary shadow-lg hover:shadow-xl transform hover:scale-105 transition-all">
                    <i data-lucide="arrow-left" class="w-5 h-5 mr-2"></i>
                    Back to Courses
                </a>

                <button onclick="window.print()" class="btn btn-ghost shadow-lg hover:shadow-xl transform hover:scale-105 transition-all">
                    <i data-lucide="printer" class="w-5 h-5 mr-2"></i>
                    Print
                </button>
            </div>
        </div>
    </div>
</div>

{# ================= STYLES ================= #}
<style>
@media print {
    .btn { display: none !important; }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

@keyframes pulse-slow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.animate-number {
    animation: pulse-slow 2s ease-in-out;
}
</style>

{# ================= JAVASCRIPT ================= #}
<script>
document.addEventListener('DOMContentLoaded', () => {

    /* ================= ANIMATE IQ SCORE ================= */
    const iqScoreDisplay = document.getElementById('iqScoreDisplay');
    if (iqScoreDisplay) {
        const targetScore = {{ result.iq_score }};
        let currentScore = 0;
        const duration = 2000; // 2 seconds
        const steps = 60;
        const increment = targetScore / steps;
        const stepDuration = duration / steps;

        const scoreInterval = setInterval(() => {
            currentScore += increment;
            if (currentScore >= targetScore) {
                currentScore = targetScore;
                clearInterval(scoreInterval);
                iqScoreDisplay.style.animation = 'none';
            }
            iqScoreDisplay.textContent = Math.round(currentScore);
        }, stepDuration);
    }

    /* ================= TIMER FINAL ================= */
    const timer = document.getElementById('finalTimer');
    if (timer) {
        const totalSeconds = parseInt(timer.dataset.seconds);
        let current = 0;

        const interval = setInterval(() => {
            current++;

            const minutes = Math.floor(current / 60);
            const seconds = current % 60;

            timer.textContent =
                minutes + ':' + String(seconds).padStart(2, '0');

            if (current >= totalSeconds) {
                clearInterval(interval);
            }
        }, 30); // smooth animation
    }

    /* ================= INITIALIZE LUCIDE ICONS ================= */
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
});
</script>
{% endblock %}
