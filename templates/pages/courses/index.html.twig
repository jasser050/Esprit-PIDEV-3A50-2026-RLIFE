{% extends 'base.html.twig' %}

{% block title %}Courses{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Courses & Resources</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Manage your courses and study materials</p>
        </div>
        <div class="flex items-center gap-3 flex-wrap">

            <!-- Search -->
            <div class="relative">
                <i data-lucide="search"
                   class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-secondary-400 dark:text-secondary-500"></i>

                <input type="search"
                       id="searchInput"
                       placeholder="Search courses..."
                       class="input pl-9 w-64 bg-white dark:bg-secondary-900">
            </div>

            <!-- Sort buttons -->
            <div class="flex gap-2">
                <button id="sortAsc" class="btn btn-secondary">A → Z</button>
                <button id="sortDesc" class="btn btn-secondary">Z → A</button>
            </div>

            <!-- Add -->
            <a href="{{ path('app_courses_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i> Add Course
            </a>
        </div>
    </div>

    <!-- Stats Row -->
<div class="grid grid-cols-2 lg:grid-cols-7 gap-4">

    <!-- Active Courses -->
    <div class="card p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
            <i data-lucide="book-open" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ courses|length }}</p>
            <p class="text-sm text-secondary-500 dark:text-secondary-400">Active Courses</p>
        </div>
    </div>

    

    

    <!-- Avg. Progress -->
    <div class="card p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
            <i data-lucide="trophy" class="w-5 h-5 text-warning-600 dark:text-warning-400"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ avg_progress|default(0) }}%</p>
            <p class="text-sm text-secondary-500 dark:text-secondary-400">Avg. Progress</p>
        </div>
    </div>

    <!-- Successful Courses -->
    <div class="card p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
            <i data-lucide="check-circle" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stat_success|default(0) }}</p>
            <p class="text-sm text-secondary-500 dark:text-secondary-400">Successful Courses</p>
        </div>
    </div>

    <!-- Failed Courses -->
    <div class="card p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center">
            <i data-lucide="x-circle" class="w-5 h-5 text-danger-600 dark:text-danger-400"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stat_fail|default(0) }}</p>
            <p class="text-sm text-secondary-500 dark:text-secondary-400">Failed Courses</p>
        </div>
    </div>

    <!-- Total Unique Subjects -->
    <div class="card p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
            <i data-lucide="layers" class="w-5 h-5 text-accent-600 dark:text-accent-400"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ total_matieres|default(0) }}</p>
            <p class="text-sm text-secondary-500 dark:text-secondary-400">Unique Subjects</p>
        </div>
    </div>

</div>


    <!-- Course Filters -->
    <div class="flex flex-wrap items-center gap-2 mt-4">
        <button class="badge badge-primary badge-pill px-4 py-1.5 cursor-pointer">All Courses</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Fall 2024</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Spring 2025</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Computer Science</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Mathematics</button>
    </div>

    <!-- Courses Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mt-4 courses-container">
        {% for course in courses %}
            <div class="card card-hover overflow-hidden group relative course-card" 
                 data-name="{{ course.nomMatiere|default('Unnamed Course')|lower }}">

                <!-- Edit / Delete Buttons -->
                <div class="absolute top-3 right-3 flex gap-2 opacity-0 group-hover:opacity-100 transition z-10">
                    <a href="{{ path('app_courses_edit', { id: course.idEval }) }}" class="btn btn-sm btn-secondary">✏️</a>

                    <form method="post" action="{{ path('app_courses_delete', { id: course.idEval }) }}" 
                          onsubmit="return confirm('Are you sure you want to delete this course?');" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.idEval) }}">
                        <button type="submit" class="btn btn-sm btn-danger">🗑</button>
                    </form>
                </div>

                <!-- Course Card -->
                <a href="{{ path('app_courses_show', {id: course.idEval}) }}" class="block">
                    <div class="p-5">
                        <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-2">{{ course.nomMatiere|default('Unnamed Course') }}</h3>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-4 flex items-center gap-1.5">
                            <i data-lucide="user" class="w-3 h-3"></i> {{ course.instructor|default('Unknown') }}
                        </p>

                        <div class="flex items-center gap-3 text-sm mb-2">
                            <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-secondary-100 dark:bg-secondary-800 text-secondary-600 dark:text-secondary-400">
                                <i data-lucide="file-text" class="w-3 h-3"></i> {{ course.notes_count|default(0) }} notes
                            </span>
                            <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-secondary-100 dark:bg-secondary-800 text-secondary-600 dark:text-secondary-400">
                                <i data-lucide="clipboard-check" class="w-3 h-3"></i> {{ course.assignments_count|default(0) }} tasks
                            </span>
                        </div>

                        <div class="space-y-2">
                            <div class="flex items-center justify-between text-sm">
                                <span class="text-secondary-500 dark:text-secondary-400">Progress</span>
                                <span class="font-semibold text-secondary-900 dark:text-white">{{ course.progress|default(0) }}%</span>
                            </div>
                            <div class="progress-bar h-2 bg-secondary-200 dark:bg-secondary-700 rounded-full">
                                <div class="progress-bar-fill bg-gradient-to-r from-{{ course.color|default('blue') }}-500 to-{{ course.color|default('blue') }}-400 h-2 rounded-full" 
                                     style="width: {{ course.progress|default(0) }}%"></div>
                            </div>
                        </div>

                        <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-2 flex items-center gap-1.5">
                            <i data-lucide="clock" class="w-3 h-3"></i> {{ course.schedule|default('No schedule') }}
                        </p>
                    </div>
                </a>
            </div>
        {% else %}
            <div class="col-span-full">
                <div class="card text-center py-16">
                    <i data-lucide="book-x" class="w-16 h-16 mx-auto mb-4 text-secondary-400"></i>
                    <p class="text-lg font-semibold">No courses yet</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-4">Add your first course to start tracking your academic progress</p>
                    <a href="{{ path('app_courses_new') }}" class="btn btn-primary inline-flex items-center gap-2">
                        <i data-lucide="plus" class="w-5 h-5"></i> Add Your First Course
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<!-- JAVASCRIPT -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const container = document.querySelector('.courses-container');

    // 🔍 SEARCH
    searchInput.addEventListener('input', function () {
        const value = searchInput.value.toLowerCase();
        const cards = Array.from(container.querySelectorAll('.course-card'));

        cards.forEach(card => {
            const shouldShow = card.dataset.name.includes(value);
            card.style.display = shouldShow ? '' : 'none';
        });
    });

    // 🔤 SORT A → Z
    document.getElementById('sortAsc').addEventListener('click', () => sortCourses(true));

    // 🔤 SORT Z → A
    document.getElementById('sortDesc').addEventListener('click', () => sortCourses(false));

    function sortCourses(ascending) {
        const cards = Array.from(container.querySelectorAll('.course-card'));

        cards.sort((a, b) => {
            const nameA = a.dataset.name.trim();
            const nameB = b.dataset.name.trim();

            return ascending
                ? nameA.localeCompare(nameB)
                : nameB.localeCompare(nameA);
        });

        cards.forEach(card => container.appendChild(card));
    }

    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
});
</script>


{% endblock %}