            </div>
            <div class="hidden lg:block flex-shrink-0">
                <div class="w-64 h-40 rounded-2xl bg-white/10 backdrop-blur-sm border-2 border-white/20 p-3 shadow-2xl flex flex-col justify-between">
                    <div class="flex items-center gap-2 mb-1">
                        <div class="w-6 h-6 rounded-full bg-white/25 flex items-center justify-center text-xs font-bold">Q7</div>
                        <div class="flex-1 h-2 bg-white/25 rounded"></div>
                        <div class="text-xs text-white/60 font-mono">7/15</div>
                    </div>
                    <div class="space-y-1 mb-1">
                        <div class="h-2 bg-white/20 rounded w-full"></div>
                        <div class="h-2 bg-white/15 rounded w-3/4"></div>
                    </div>
                    <div class="space-y-1.5">
                        <div class="h-6 bg-white/15 rounded-lg flex items-center px-2 gap-2"><div class="w-3 h-3 rounded-full border border-white/40 flex-shrink-0"></div><div class="h-2 bg-white/20 rounded flex-1"></div></div>
                        <div class="iq-selected h-6 bg-white/40 rounded-lg flex items-center px-2 gap-2 border border-white/60"><div class="w-3 h-3 rounded-full bg-white flex-shrink-0"></div><div class="h-2 bg-white/70 rounded flex-1"></div></div>
                        <div class="h-6 bg-white/15 rounded-lg flex items-center px-2 gap-2"><div class="w-3 h-3 rounded-full border border-white/40 flex-shrink-0"></div><div class="h-2 bg-white/20 rounded" style="width:65%"></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Course Filters ── #}
    <div class="flex flex-wrap items-center gap-2 mt-4">
        <button class="badge badge-primary badge-pill px-4 py-1.5 cursor-pointer">All Courses</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Fall 2024</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Spring 2025</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Computer Science</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Mathematics</button>
    </div>

    {# ── Courses Grid ── #}
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 mt-4 courses-container">
        {% for course in courses %}

        {% set n    = course.notes_count|default(0) %}
        {% set prog = course.progress|default(0) %}

        {% if prog >= 75 %}
            {% set gradColor = 'from-green-500 to-emerald-400' %}
            {% set progLabel = 'Excellent 🚀' %}
            {% set progText  = 'text-green-600 dark:text-green-400' %}
        {% elseif prog >= 50 %}
            {% set gradColor = 'from-blue-500 to-cyan-400' %}
            {% set progLabel = 'En bonne voie ✔️' %}
            {% set progText  = 'text-blue-600 dark:text-blue-400' %}
        {% elseif prog >= 25 %}
            {% set gradColor = 'from-yellow-500 to-orange-400' %}
            {% set progLabel = 'Attention ⚠️' %}
            {% set progText  = 'text-yellow-600 dark:text-yellow-400' %}
        {% else %}
            {% set gradColor = 'from-red-500 to-rose-400' %}
            {% set progLabel = 'Danger ❗' %}
            {% set progText  = 'text-red-600 dark:text-red-400' %}
        {% endif %}

        <div class="card card-hover overflow-hidden group relative course-card"
             data-name="{{ course.nomMatiere|default('Unnamed Course')|lower }}"
             data-priority="{{ course.prioriteE|default('')|lower }}"
             data-date="{{ course.dateEvaluation ? course.dateEvaluation|date('Y-m-d') : '9999-12-31' }}">

            <div class="absolute top-3 right-3 flex gap-2 opacity-0 group-hover:opacity-100 transition z-10">
                <a href="{{ path('app_courses_edit', { id: course.idEval }) }}" class="btn btn-sm btn-secondary">✏️</a>
                <a href="{{ path('app_evaluation_delete', { id: course.idEval }) }}" class="btn btn-sm btn-danger">🗑️</a>
            </div>

            <a href="{{ path('app_courses_show', {id: course.idEval}) }}" class="block">
                <div class="p-5">
                    <div class="mb-3">
                        {% if course.prioriteE is defined and course.prioriteE %}
                            {% set p = course.prioriteE|lower %}
                            {% if p == 'urgent' %}
                                <span class="priority-badge priority-urgent"><span class="priority-icon">🚨</span><span class="priority-text">URGENT</span><span class="priority-pulse"></span></span>
                            {% elseif p == 'high' %}
                                <span class="priority-badge priority-high"><span class="priority-icon">🔥</span><span class="priority-text">HIGH</span></span>
                            {% elseif p == 'medium' %}
                                <span class="priority-badge priority-medium"><span class="priority-icon">⚡</span><span class="priority-text">MEDIUM</span></span>
                            {% else %}
                                <span class="priority-badge priority-low"><span class="priority-icon">🌿</span><span class="priority-text">LOW</span></span>
                            {% endif %}
                        {% else %}
                            <span class="priority-badge priority-none"><span class="priority-text">— none</span></span>
                        {% endif %}
                    </div>

                    <h3 class="text-lg font-bold text-secondary-900 dark:text-white mb-1 truncate">{{ course.nomMatiere|default('Unnamed Course') }}</h3>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-3 flex items-center gap-1.5">
                        <i data-lucide="user" class="w-3 h-3"></i>{{ app.user.username|default(app.user.email|default('Unknown')) }}
                    </p>

                    <div class="mb-3">
                        {% if n == 0 %}
                            <span class="note-badge border border-dashed border-secondary-300 dark:border-secondary-600 text-secondary-400 dark:text-secondary-500 italic">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6M5 21h14a2 2 0 002-2V7l-5-5H5a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                Aucune note
                            </span>
                        {% elseif n <= 2 %}
                            <span class="note-badge bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 border border-orange-200 dark:border-orange-700">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536M9 13l6-6 3 3-6 6H9v-3z"/></svg>
                                {{ n }} note{% if n > 1 %}s{% endif %}<span class="opacity-60">· peu documenté</span>
                            </span>
                        {% elseif n <= 5 %}
                            <span class="note-badge bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-700">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-3-3v6M5 21h14a2 2 0 002-2V7l-5-5H5a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                {{ n }} notes<span class="opacity-60">· en cours</span>
                            </span>
                        {% else %}
                            <span class="note-badge bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 border border-green-200 dark:border-green-700">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M5 21h14a2 2 0 002-2V7l-5-5H5a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                {{ n }} notes<span class="opacity-60">· bien documenté ✓</span>
                            </span>
                        {% endif %}
                    </div>

                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-secondary-500 dark:text-secondary-400 flex items-center gap-1">
                                <i data-lucide="trending-up" class="w-3 h-3"></i> Progress
                            </span>
                            <span class="font-bold {{ progText }}">{{ prog }}% <span class="font-normal text-xs opacity-70">— {{ progLabel }}</span></span>
                        </div>
                        <div class="h-2.5 bg-secondary-200 dark:bg-secondary-700 rounded-full overflow-hidden">
                            <div class="progress-bar-fill bg-gradient-to-r {{ gradColor }} h-2.5 rounded-full"
                                 style="--target-width: {{ prog }}%; width: {{ prog }}%"></div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between mt-3">
                        <p class="text-sm text-secondary-500 dark:text-secondary-400 flex items-center gap-1.5">
                            <i data-lucide="clock" class="w-3 h-3"></i> {{ course.schedule|default('No schedule') }}
                        </p>
                        {% if course.dateEvaluation %}
                        <span class="inline-flex items-center gap-1 text-xs text-secondary-500 dark:text-secondary-400">
                            <i data-lucide="calendar" class="w-3 h-3"></i> {{ course.dateEvaluation|date('d/m/Y') }}
                        </span>
                        {% endif %}
                    </div>
                </div>
            </a>
        </div>

        {% else %}
        <div class="col-span-full">
            <div class="card text-center py-16">
                <i data-lucide="book-x" class="w-16 h-16 mx-auto mb-4 text-secondary-400"></i>
                <p class="text-lg font-semibold">No courses yet</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-4">Add your first course to start tracking your academic progress</p>
                <a href="{{ path('app_courses_new') }}" class="btn btn-primary inline-flex items-center gap-2">
                    <i data-lucide="plus" class="w-5 h-5"></i> Add Your First Course
                </a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const container   = document.querySelector('.courses-container');
    const PRIORITY_ORDER = { urgent: 0, high: 1, medium: 2, low: 3 };

    function getPriorityRank(card) {
        const p = (card.dataset.priority || '').toLowerCase().trim();
        return PRIORITY_ORDER.hasOwnProperty(p) ? PRIORITY_ORDER[p] : 99;
    }

    function sortByPriorityAndDate() {
        const cards = Array.from(container.querySelectorAll('.course-card'));
        cards.sort((a, b) => {
            const pDiff = getPriorityRank(a) - getPriorityRank(b);
            if (pDiff !== 0) return pDiff;
            return (a.dataset.date || '').localeCompare(b.dataset.date || '');
        });
        cards.forEach(card => container.appendChild(card));
    }
    sortByPriorityAndDate();

    searchInput.addEventListener('input', function () {
        const value = searchInput.value.toLowerCase();
        Array.from(container.querySelectorAll('.course-card')).forEach(card => {
            card.style.display = card.dataset.name.includes(value) ? '' : 'none';
        });
    });

    document.getElementById('sortAsc').addEventListener('click', () => {
        const cards = Array.from(container.querySelectorAll('.course-card'));
        cards.sort((a, b) => a.dataset.name.trim().localeCompare(b.dataset.name.trim()));
        cards.forEach(card => container.appendChild(card));
    });

    document.getElementById('sortDesc').addEventListener('click', () => {
        const cards = Array.from(container.querySelectorAll('.course-card'));
        cards.sort((a, b) => b.dataset.name.trim().localeCompare(a.dataset.name.trim()));
        cards.forEach(card => container.appendChild(card));
    });

    if (typeof lucide !== 'undefined') lucide.createIcons();
});
</script>

{% endblock %}
