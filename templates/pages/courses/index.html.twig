{% extends 'base.html.twig' %}

{% block title %}Courses{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Courses & Resources</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Manage your courses and study materials</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="relative">
                <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-secondary-400 dark:text-secondary-500"></i>
                <input type="search" placeholder="Search courses..." class="input pl-9 w-64 bg-white dark:bg-secondary-900">
            </div>
            <button class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Add Course
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <i data-lucide="book-open" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ courses|length }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Active Courses</p>
            </div>
        </div>
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                <i data-lucide="file-text" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ total_notes|default(47) }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Notes</p>
            </div>
        </div>
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                <i data-lucide="link" class="w-5 h-5 text-accent-600 dark:text-accent-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ total_resources|default(23) }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Resources</p>
            </div>
        </div>
        <div class="card p-4 flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                <i data-lucide="trophy" class="w-5 h-5 text-warning-600 dark:text-warning-400"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ avg_progress|default(68) }}%</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400">Avg. Progress</p>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap items-center gap-2">
        <button class="badge badge-primary badge-pill px-4 py-1.5 cursor-pointer">All Courses</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Fall 2024</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Spring 2025</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Computer Science</button>
        <button class="badge badge-secondary badge-pill px-4 py-1.5 cursor-pointer hover:bg-secondary-300 dark:hover:bg-secondary-700 transition-colors">Mathematics</button>
    </div>

    <!-- Course Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {% for course in courses %}
        <a href="{{ path('app_courses_show', {id: course.id}) }}" class="card card-hover overflow-hidden group">
            <!-- Course Color Header -->
            <div class="h-2 bg-gradient-to-r from-{{ course.color }}-500 to-{{ course.color }}-400"></div>

            <div class="p-5">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 rounded-xl bg-{{ course.color }}-100 dark:bg-{{ course.color }}-900/30 flex items-center justify-center group-hover:scale-110 transition-transform">
                        <i data-lucide="book-open" class="w-6 h-6 text-{{ course.color }}-600 dark:text-{{ course.color }}-400"></i>
                    </div>
                    <span class="badge badge-{{ course.color }} badge-pill">{{ course.code }}</span>
                </div>

                <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{{ course.name }}</h3>
                <p class="text-sm text-secondary-500 dark:text-secondary-400 mb-4 flex items-center gap-1.5">
                    <i data-lucide="user" class="w-3 h-3"></i>
                    {{ course.instructor }}
                </p>

                <div class="flex items-center gap-4 text-sm text-secondary-500 dark:text-secondary-400 mb-4">
                    <span class="flex items-center gap-1.5">
                        <i data-lucide="clock" class="w-3 h-3"></i>
                        {{ course.schedule }}
                    </span>
                </div>

                <div class="flex items-center gap-3 text-sm mb-5">
                    <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-secondary-100 dark:bg-secondary-800 text-secondary-600 dark:text-secondary-400">
                        <i data-lucide="file-text" class="w-3 h-3"></i>
                        {{ course.notes_count }} notes
                    </span>
                    <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-secondary-100 dark:bg-secondary-800 text-secondary-600 dark:text-secondary-400">
                        <i data-lucide="clipboard-check" class="w-3 h-3"></i>
                        {{ course.assignments_count }} tasks
                    </span>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-secondary-500 dark:text-secondary-400">Progress</span>
                        <span class="font-semibold text-secondary-900 dark:text-white">{{ course.progress }}%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-bar-fill bg-gradient-to-r from-{{ course.color }}-500 to-{{ course.color }}-400" style="width: {{ course.progress }}%"></div>
                    </div>
                </div>
            </div>
        </a>
        {% else %}
        <div class="col-span-full">
            <div class="card">
                <div class="empty-state py-16">
                    <i data-lucide="book-x" class="w-16 h-16 empty-state-icon"></i>
                    <p class="empty-state-title">No courses yet</p>
                    <p class="empty-state-description">Add your first course to start tracking your academic progress</p>
                    <button class="btn btn-primary mt-4">
                        <i data-lucide="plus" class="w-5 h-5"></i>
                        Add Your First Course
                    </button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
