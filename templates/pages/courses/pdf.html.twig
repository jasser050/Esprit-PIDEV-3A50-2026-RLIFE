<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
        }
        h1, h2 {
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th, td {
            border: 1px solid #000;
            padding: 6px;
        }
        th {
            background-color: #f2f2f2;
        }
    </style>
</head>
<body>

<h1>Relevé d'Évaluation</h1>

<p><strong>Date :</strong> {{ course.dateEvaluation|date('d/m/Y') }}</p>
<p><strong>Durée :</strong> {{ course.dureeEvaluation }} minutes</p>

<hr>

<h2>Résultats</h2>
<table>
    <tr>
        <th>Score</th>
        <th>Note maximale</th>
        <th>Pourcentage</th>
    </tr>
    <tr>
        <td>{{ course.scoreEval }}</td>
        <td>{{ course.noteMaximaleEval }}</td>
        <td>{{ percentage }} %</td>
    </tr>
</table>

<h2>Matières associées</h2>
<table>
    <tr>
        <th>Matière</th>
        <th>Section</th>
    </tr>
    {% for evalMat in course.evalMats %}
        <tr>
            <td>{{ evalMat.matiere.nomMatiere }}</td>
            <td>{{ evalMat.matiere.sectionMatiere|default('N/A') }}</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="2">Aucune matière associée</td>
        </tr>
    {% endfor %}
</table>

</body>
</html>
