{% extends 'base.html.twig' %}

{% block title %}IQ Test - In Progress{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto space-y-6 animate-fade-in">
    
    {# Header with breadcrumbs #}
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-secondary-900 dark:text-white">🧠 IQ Test</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Evaluate your cognitive intelligence</p>
        </div>
        <a href="{{ path('app_courses') }}" 
           class="btn btn-secondary">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
            Back
        </a>
    </div>

    {# Timer and progress #}
    <div class="card p-6 bg-gradient-to-r from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 border-2 border-purple-200 dark:border-purple-800">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            {# Timer #}
            <div class="flex items-center gap-4">
                <div class="w-16 h-16 bg-gradient-to-br from-purple-600 to-indigo-600 text-white rounded-2xl flex items-center justify-center font-bold text-xl shadow-lg" id="timer">
                    0:00
                </div>
                <div>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Time Elapsed</p>
                    <p class="font-semibold text-secondary-900 dark:text-white text-lg">
                        Question <span id="currentQuestion">0</span> / {{ totalQuestions }}
                    </p>
                </div>
            </div>
            
            {# Progress #}
            <div class="flex-1 max-w-md">
                <div class="flex items-center justify-between mb-2">
                    <p class="text-sm font-semibold text-secondary-700 dark:text-secondary-300">Progress</p>
                    <p class="font-bold text-xl text-purple-600 dark:text-purple-400">
                        <span id="progress">0</span>%
                    </p>
                </div>
                <div class="w-full bg-secondary-200 dark:bg-secondary-700 rounded-full h-3 shadow-inner">
                    <div id="progressBar" 
                         class="bg-gradient-to-r from-purple-600 to-indigo-600 h-3 rounded-full transition-all duration-500 ease-out shadow-lg" 
                         style="width: 0%">
                    </div>
                </div>
            </div>

            {# Quick stats #}
            <div class="flex gap-4">
                <div class="text-center px-4 py-2 bg-white dark:bg-secondary-800 rounded-xl shadow">
                    <p class="text-2xl font-bold text-green-600 dark:text-green-400" id="answeredCount">0</p>
                    <p class="text-xs text-secondary-500 dark:text-secondary-400">Answered</p>
                </div>
            </div>
        </div>
    </div>

    {# Contextual help #}
    <div class="card p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
        <div class="flex items-start gap-3">
            <i data-lucide="info" class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5"></i>
            <div class="text-sm">
                <p class="font-semibold text-blue-900 dark:text-blue-200 mb-1">💡 Tip</p>
                <p class="text-blue-800 dark:text-blue-300">
                    Take your time to read each question. Speed matters, but accuracy is more important. 
                    Choose the best answer among the proposed options.
                </p>
            </div>
        </div>
    </div>

    {# Test form #}
    <form method="post" action="{{ path('iq_test_submit') }}" id="iqTestForm">
        <div class="space-y-5">
            {% for question in questions %}
                <div class="card card-hover p-6 question-card transition-all duration-300" 
                     data-question="{{ loop.index }}"
                     style="animation: slideInUp 0.5s ease-out {{ loop.index * 0.05 }}s backwards;">
                    
                    {# Question header #}
                    <div class="flex items-start gap-4 mb-5">
                        <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-purple-500 to-indigo-600 text-white rounded-xl flex items-center justify-center font-bold text-lg shadow-lg">
                            {{ loop.index }}
                        </div>
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-3">
                                {{ question.question }}
                            </h3>
                            <div class="flex items-center gap-2">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold
                                    {% if question.difficulty == 'easy' %}
                                        bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200
                                    {% elseif question.difficulty == 'medium' %}
                                        bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200
                                    {% else %}
                                        bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200
                                    {% endif %}
                                ">
                                    <i data-lucide="zap" class="w-3 h-3 mr-1"></i>
                                    {{ question.difficulty|capitalize }}
                                </span>
                                
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">
                                    <i data-lucide="tag" class="w-3 h-3 mr-1"></i>
                                    {{ question.category }}
                                </span>
                            </div>
                        </div>
                    </div>

                    {# Answer options #}
                    <div class="space-y-3 ml-0 md:ml-16">
                        {% for option in question.options %}
                            <label class="flex items-center p-4 rounded-xl border-2 border-secondary-200 dark:border-secondary-700 hover:border-purple-500 dark:hover:border-purple-500 cursor-pointer transition-all duration-200 group hover:shadow-md hover:scale-[1.02] bg-white dark:bg-secondary-800">
                                <input type="radio" 
                                       name="answers[{{ question.id }}]" 
                                       value="{{ option }}" 
                                       class="w-5 h-5 text-purple-600 focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 dark:focus:ring-offset-secondary-900"
                                       data-question="{{ question.id }}"
                                       required>
                                <span class="ml-4 text-base text-secondary-900 dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 font-medium">
                                    {{ option }}
                                </span>
                                <i data-lucide="check-circle" class="w-5 h-5 ml-auto text-transparent group-hover:text-purple-500 transition-colors"></i>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Submit button #}
        <div class="card p-6 mt-8 bg-gradient-to-r from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 border-2 border-purple-200 dark:border-purple-800 sticky bottom-4 shadow-xl">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div>
                    <p class="font-semibold text-secondary-900 dark:text-white text-lg mb-1">
                        🎯 Ready to submit your test?
                    </p>
                    <p class="text-sm text-secondary-600 dark:text-secondary-400">
                        <span id="unansweredWarning" class="text-orange-600 dark:text-orange-400 font-semibold hidden">
                            ⚠️ <span id="unansweredCount">0</span> question(s) remaining
                        </span>
                        <span id="allAnsweredMessage" class="text-green-600 dark:text-green-400 font-semibold hidden">
                            ✓ All questions answered!
                        </span>
                    </p>
                </div>
                
                <button type="submit" 
                        id="submitButton"
                        class="btn btn-primary px-10 py-4 text-lg font-bold bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed disabled:transform-none">
                    <i data-lucide="send" class="w-5 h-5 mr-2"></i>
                    Finish Test
                </button>
            </div>
        </div>
    </form>
</div>

{# Custom styles #}
<style>
@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.question-card:has(input[type="radio"]:checked) {
    border-color: rgb(147 51 234);
    background: linear-gradient(to right, rgb(249 250 251), rgb(243 244 246));
}

.dark .question-card:has(input[type="radio"]:checked) {
    border-color: rgb(147 51 234);
    background: linear-gradient(to right, rgb(31 41 55), rgb(17 24 39));
}

input[type="radio"]:checked + span + i {
    color: rgb(147 51 234) !important;
}
</style>

{# JavaScript #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Timer
    let startTime = Date.now();
    const timerElement = document.getElementById('timer');
    
    setInterval(() => {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        const minutes = Math.floor(elapsed / 60);
        const seconds = elapsed % 60;
        timerElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }, 1000);

    // Progress and validation
    const form = document.getElementById('iqTestForm');
    const totalQuestions = {{ totalQuestions }};
    const progressElement = document.getElementById('progress');
    const progressBar = document.getElementById('progressBar');
    const currentQuestionElement = document.getElementById('currentQuestion');
    const answeredCountElement = document.getElementById('answeredCount');
    const submitButton = document.getElementById('submitButton');
    const unansweredWarning = document.getElementById('unansweredWarning');
    const allAnsweredMessage = document.getElementById('allAnsweredMessage');
    const unansweredCountElement = document.getElementById('unansweredCount');

    function updateProgress() {
        // Count answered questions
        const answered = new Set();
        form.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
            answered.add(radio.getAttribute('data-question'));
        });
        
        const answeredCount = answered.size;
        const progress = Math.round((answeredCount / totalQuestions) * 100);
        const unanswered = totalQuestions - answeredCount;
        
        // Update UI
        progressElement.textContent = progress;
        progressBar.style.width = progress + '%';
        currentQuestionElement.textContent = answeredCount;
        answeredCountElement.textContent = answeredCount;
        unansweredCountElement.textContent = unanswered;
        
        // Show/hide messages
        if (answeredCount === totalQuestions) {
            unansweredWarning.classList.add('hidden');
            allAnsweredMessage.classList.remove('hidden');
            submitButton.disabled = false;
        } else {
            unansweredWarning.classList.remove('hidden');
            allAnsweredMessage.classList.add('hidden');
        }
    }

    // Listen for answer changes
    form.querySelectorAll('input[type="radio"]').forEach(radio => {
        radio.addEventListener('change', updateProgress);
    });

    // Validation before submission
    form.addEventListener('submit', function(e) {
        const answered = new Set();
        form.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
            answered.add(radio.getAttribute('data-question'));
        });
        
        if (answered.size < totalQuestions) {
            e.preventDefault();
            const unanswered = totalQuestions - answered.size;
            if (!confirm(`Warning! ${unanswered} question(s) remaining. Do you really want to submit the test?`)) {
                return false;
            } else {
                // Allow submission
                form.submit();
            }
        }
    });

    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
});
</script>
{% endblock %}
