{% extends 'base.html.twig' %}

{% block title %}Evaluation #{{ course.idEval }}{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Courses', href: path('app_courses') },
            { label: 'Evaluation #' ~ course.idEval }
        ]
    } %}

    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Evaluation Information</h2>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <p class="text-sm text-light-muted dark:text-dark-muted">Score</p>
                <p class="font-medium">{{ course.scoreEval }} / {{ course.noteMaximaleEval }}</p>
            </div>
            <div>
                <p class="text-sm text-light-muted dark:text-dark-muted">Percentage</p>
                <p class="font-medium">{{ percentage|number_format(2) }}%</p>
            </div>
            <div>
                <p class="text-sm text-light-muted dark:text-dark-muted">Date</p>
                <p class="font-medium">{{ course.dateEvaluation|date('M j, Y') }}</p>
            </div>
            <div>
                <p class="text-sm text-light-muted dark:text-dark-muted">Duration</p>
                <p class="font-medium">{{ course.dureeEvaluation }} minutes</p>
            </div>
            <div>
                <p class="text-sm text-light-muted dark:text-dark-muted">Priority</p>
                <p class="font-medium">{{ course.prioriteE|default('N/A') }}</p>
            </div>

            <div class="mt-4">
        <a href="{{ path('app_courses_pdf', { id: course.idEval }) }}"
           class="px-4 py-2 bg-indigo-600 text-white rounded-lg">
            📄 Exporter en PDF
        </a>
    </div>
        </div>
    </div>

    <!-- Matières associées -->
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Matières / Sections</h2>
        <div class="space-y-3">
            {% for evalMat in course.evalMats %}
                <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                    <p class="font-medium">{{ evalMat.matiere.nomMatiere }}</p>
                    <p class="text-sm text-light-muted dark:text-dark-muted">
                        Section: {{ evalMat.matiere.section|default('N/A') }}
                    </p>
                </div>
            {% else %}
                <p class="text-light-muted dark:text-dark-muted">Aucune matière associée</p>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
