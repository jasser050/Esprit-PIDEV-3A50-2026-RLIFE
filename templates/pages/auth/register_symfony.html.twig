{% extends 'layouts/public.html.twig' %}

{% block title %}Create your account{% endblock %}

{% block body %}
<div class="min-h-screen flex" data-controller="theme wizard" data-wizard-total-value="2">
    <!-- Left Panel - Form -->
    <div class="flex-1 flex flex-col justify-center px-4 sm:px-6 lg:px-8 xl:px-12 bg-white dark:bg-slate-900 pt-16 lg:pt-0">
        <div class="w-full max-w-[480px] mx-auto">
            <!-- Logo and back link -->
            <div class="mb-8">
                <a href="{{ path('app_landing') }}" class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors mb-8">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to home
                </a>

                <a href="{{ path('app_landing') }}" class="flex items-center gap-2.5 mb-2">
                    <img src="{{ asset('image/logo0.png') }}" alt="RLIFE Logo" class="w-14 h-14 object-cover">
                    <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">RLIFE</span>
                </a>
            </div>

            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    Create your account
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-300">
                    Start organising your semester in minutes
                </p>
            </div>
            
            <!-- Flash Messages -->
            {% for message in app.flashes('error') %}
            <div class="p-4 mb-4 bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-xl animate-fade-in">
                <div class="flex items-start gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-danger-800 dark:text-danger-200">Error</p>
                        <p class="text-sm text-danger-600 dark:text-danger-300 mt-0.5">{{ message }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
            
            {% for message in app.flashes('success') %}
            <div class="p-4 mb-4 bg-success-50 dark:bg-success-900/20 border border-success-200 dark:border-success-800 rounded-xl animate-fade-in">
                <div class="flex items-start gap-3">
                    <i data-lucide="check-circle" class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-success-800 dark:text-success-200">Success</p>
                        <p class="text-sm text-success-600 dark:text-success-300 mt-0.5">{{ message }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}

            <!-- Step Indicator -->
            <div class="flex items-center gap-4 mb-8">
                <div class="flex items-center gap-3" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-primary-600 border-primary-600 text-white flex items-center justify-center text-sm font-semibold transition-colors">
                        1
                    </div>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Account</span>
                    <div class="step-line w-8 h-0.5 bg-slate-200 dark:bg-slate-700 transition-colors"></div>
                </div>
                <div class="flex items-center gap-3" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600 text-slate-500 flex items-center justify-center text-sm font-semibold transition-colors">
                        2
                    </div>
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Preferences</span>
                </div>
            </div>

            <!-- Registration Form -->
            {{ form_start(registrationForm, {'attr': {'data-turbo': 'false'}}) }}
                <!-- Step 1: Account Details -->
                <div data-wizard-target="step" class="space-y-5">
                    <!-- First Name & Last Name -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            {{ form_label(registrationForm.firstName, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                            {{ form_widget(registrationForm.firstName, {'attr': {'class': registrationForm.firstName.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
                            {% if registrationForm.firstName.vars.errors|length > 0 %}
                                <ul class="form-error-list">
                                    {% for error in registrationForm.firstName.vars.errors %}
                                        <li>{{ error.message }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                        <div>
                            {{ form_label(registrationForm.lastName, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                            {{ form_widget(registrationForm.lastName, {'attr': {'class': registrationForm.lastName.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
                            {% if registrationForm.lastName.vars.errors|length > 0 %}
                                <ul class="form-error-list">
                                    {% for error in registrationForm.lastName.vars.errors %}
                                        <li>{{ error.message }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Username -->
                    <div>
                        {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                        {{ form_widget(registrationForm.username, {'attr': {'class': registrationForm.username.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
                        {% if registrationForm.username.vars.errors|length > 0 %}
                            <ul class="form-error-list">
                                {% for error in registrationForm.username.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>

                    <!-- Email -->
                    <div>
                        {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': registrationForm.email.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
                        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Use your .edu email for free access</p>
                        {% if registrationForm.email.vars.errors|length > 0 %}
                            <ul class="form-error-list">
                                {% for error in registrationForm.email.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>

                    <!-- Password -->
                    <div>
                        {{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': registrationForm.plainPassword.first.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
                        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Min 8 characters, must include uppercase, lowercase and number</p>
                        {% if registrationForm.plainPassword.first.vars.errors|length > 0 %}
                            <ul class="form-error-list">
                                {% for error in registrationForm.plainPassword.first.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        {{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5'}}) }}
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': registrationForm.plainPassword.second.vars.errors|length > 0 ? 'is-invalid' : ''}}) }}
                        {% if registrationForm.plainPassword.second.vars.errors|length > 0 %}
                            <ul class="form-error-list">
                                {% for error in registrationForm.plainPassword.second.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if registrationForm.plainPassword.vars.errors|length > 0 %}
                            <ul class="form-error-list">
                                {% for error in registrationForm.plainPassword.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>

                    <!-- Terms -->
                    <div>
                        <div class="flex items-start gap-3">
                            {{ form_widget(registrationForm.agreeTerms) }}
                            {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'text-sm text-slate-600 dark:text-slate-300'}}) }}
                        </div>
                        {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
                            <ul class="form-error-list">
                                {% for error in registrationForm.agreeTerms.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>

                <!-- Step 2: Preferences -->
                <div data-wizard-target="step" class="hidden space-y-6">
                    <!-- Gender -->
                    <div>
                        {{ form_label(registrationForm.gender, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3'}}) }}
                        <div class="grid grid-cols-2 gap-3">
                            {% for child in registrationForm.gender %}
                                <label class="relative cursor-pointer">
                                    {{ form_widget(child, {'attr': {'class': 'peer sr-only'}}) }}
                                    <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                        <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                        <span class="text-sm font-medium text-slate-700 dark:text-slate-300">{{ child.vars.label }}</span>
                                    </div>
                                </label>
                            {% endfor %}
                        </div>
                        {% if registrationForm.gender.vars.errors|length > 0 %}
                            <ul class="form-error-list">
                                {% for error in registrationForm.gender.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>

                    <!-- Study Level -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                            What's your study level?
                        </label>
                        <div class="grid grid-cols-3 gap-3">
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="beginner" class="peer sr-only" checked>
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="sprout" class="w-6 h-6 mx-auto mb-2 text-slate-400 peer-checked:text-primary-600"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Beginner</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="intermediate" class="peer sr-only">
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="trending-up" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Intermediate</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="advanced" class="peer sr-only">
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="rocket" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Advanced</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Weekly Goal -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                            Weekly study goal: <span id="goal-display" class="text-primary-600 dark:text-primary-400">5 hours</span>
                        </label>
                        <input
                            type="range"
                            name="weekly_goal"
                            min="1"
                            max="10"
                            value="5"
                            class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-full appearance-none cursor-pointer accent-primary-600"
                            oninput="document.getElementById('goal-display').textContent = this.value + ' hours'"
                        >
                        <div class="flex justify-between text-xs text-slate-400 dark:text-slate-500 mt-1">
                            <span>1h</span>
                            <span>10h</span>
                        </div>
                    </div>

                    <!-- Interests -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                            What are you interested in?
                        </label>
                        <div class="flex flex-wrap gap-2">
                            {% set interests = ['Web Dev', 'Data Science', 'Design', 'Business', 'Languages', 'Math', 'Science', 'Arts', 'Engineering'] %}
                            {% for interest in interests %}
                            <label class="cursor-pointer">
                                <input type="checkbox" name="interests[]" value="{{ interest|lower|replace({' ': '_'}) }}" class="peer sr-only">
                                <span class="inline-flex px-4 py-2 text-sm font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-full border-2 border-transparent peer-checked:bg-primary-100 dark:peer-checked:bg-primary-900/30 peer-checked:text-primary-700 dark:peer-checked:text-primary-300 peer-checked:border-primary-300 dark:peer-checked:border-primary-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                                    {{ interest }}
                                </span>
                            </label>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Notifications preference -->
                    <div class="p-4 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
                        <div class="flex items-start gap-3">
                            <input
                                type="checkbox"
                                id="notifications"
                                name="notifications"
                                checked
                                class="mt-1 w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-primary-600 focus:ring-primary-500 bg-white dark:bg-slate-700"
                            >
                            <div>
                                <label for="notifications" class="text-sm font-medium text-slate-700 dark:text-slate-300">
                                    Enable gentle reminders
                                </label>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                    We'll send you helpful study reminders and deadline notifications
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="flex items-center justify-between mt-8 pt-6 border-t border-slate-200 dark:border-slate-700">
                    <button
                        type="button"
                        data-wizard-target="prevBtn"
                        data-action="click->wizard#prev"
                        class="hidden px-5 py-2.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
                    >
                        <i data-lucide="arrow-left" class="w-4 h-4 inline mr-1"></i>
                        Back
                    </button>

                    <div class="flex-1"></div>

                    <button
                        type="button"
                        data-wizard-target="nextBtn"
                        data-action="click->wizard#next"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all hover:-translate-y-0.5"
                    >
                        Continue
                        <i data-lucide="arrow-right" class="w-5 h-5"></i>
                    </button>

                    <button
                        type="submit"
                        data-wizard-target="submitBtn"
                        class="hidden inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all hover:-translate-y-0.5"
                    >
                        Create account
                        <i data-lucide="check" class="w-5 h-5"></i>
                    </button>
                </div>
            {{ form_end(registrationForm) }}

            <!-- Sign in link -->
            <p class="mt-8 text-center text-sm text-slate-600 dark:text-slate-400">
                Already have an account?
                <a href="{{ path('app_login') }}" class="font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
                    Sign in
                </a>
            </p>
        </div>
    </div>

    <!-- Right Panel - Brand (same as before) -->
    <div class="hidden lg:flex lg:w-[45%] xl:w-1/2 relative bg-gradient-to-br from-primary-600 via-primary-700 to-primary-900 dark:from-slate-800 dark:via-slate-900 dark:to-slate-950">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:24px_24px]"></div>

        <div class="relative z-10 flex flex-col justify-center px-12 xl:px-16">
            <button
                type="button"
                data-action="click->theme#toggle"
                class="absolute top-6 right-6 p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white transition-colors"
            >
                <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
            </button>

            <div class="max-w-md">
                <h2 class="text-3xl xl:text-4xl font-semibold text-white leading-tight mb-6">
                    Join thousands of students
                </h2>

                <div class="space-y-6 mb-10">
                    <!-- Stats -->
                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-4 bg-white/10 backdrop-blur-sm rounded-xl">
                            <p class="text-3xl font-bold text-white">50K+</p>
                            <p class="text-sm text-white/70 mt-1">Active students</p>
                        </div>
                        <div class="p-4 bg-white/10 backdrop-blur-sm rounded-xl">
                            <p class="text-3xl font-bold text-white">4.9</p>
                            <p class="text-sm text-white/70 mt-1">Average rating</p>
                        </div>
                    </div>

                    <div class="p-4 bg-white/10 backdrop-blur-sm rounded-xl">
                        <div class="flex items-center gap-4">
                            <div class="flex -space-x-2">
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 border-2 border-white/20 flex items-center justify-center text-white text-xs font-semibold">A</div>
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-secondary-400 to-secondary-600 border-2 border-white/20 flex items-center justify-center text-white text-xs font-semibold">B</div>
                                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-accent-400 to-accent-600 border-2 border-white/20 flex items-center justify-center text-white text-xs font-semibold">C</div>
                                <div class="w-8 h-8 rounded-full bg-white/20 border-2 border-white/20 flex items-center justify-center text-white text-xs font-semibold">+</div>
                            </div>
                            <p class="text-sm text-white/90">127 students signed up this week</p>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    <span class="px-3 py-1.5 text-xs font-medium text-white/80 bg-white/10 rounded-full">Free for .edu emails</span>
                    <span class="px-3 py-1.5 text-xs font-medium text-white/80 bg-white/10 rounded-full">No credit card</span>
                    <span class="px-3 py-1.5 text-xs font-medium text-white/80 bg-white/10 rounded-full">Cancel anytime</span>
                </div>
            </div>

            <div class="absolute bottom-12 right-12 w-32 h-32 bg-white/5 rounded-full blur-2xl"></div>
            <div class="absolute top-24 right-24 w-20 h-20 bg-secondary-500/20 rounded-full blur-xl"></div>
        </div>
    </div>

    <!-- Mobile header -->
    <div class="lg:hidden fixed top-0 left-0 right-0 z-10 bg-gradient-to-r from-primary-600 to-primary-700 dark:from-slate-800 dark:to-slate-900 px-4 py-3">
        <div class="flex items-center justify-between">
            <a href="{{ path('app_landing') }}" class="flex items-center gap-2">
                <img src="{{ asset('image/logo.jpg') }}" alt="RLIFE Logo" class="w-8 h-8 rounded-lg object-cover">
                <span class="font-semibold text-white">RLIFE</span>
            </a>
            <button
                type="button"
                data-action="click->theme#toggle"
                class="p-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition-colors"
            >
                <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
            </button>
        </div>
    </div>
</div>

<style>
/* Error styling for form fields */
.form-error-message,
ul.form-error-list {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #dc2626;
    font-weight: 500;
    list-style: none;
    padding: 0;
}

.dark .form-error-message,
.dark ul.form-error-list {
    color: #fca5a5;
}

ul.form-error-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: #fef2f2;
    border-left: 3px solid #dc2626;
    border-radius: 0.375rem;
    margin-top: 0.5rem;
}

.dark ul.form-error-list li {
    background: #7f1d1d;
    border-left-color: #ef4444;
}

ul.form-error-list li::before {
    content: "⚠";
    font-size: 1rem;
    flex-shrink: 0;
}

/* Input field error state */
.form-control.is-invalid,
input.is-invalid,
textarea.is-invalid,
select.is-invalid {
    border-color: #dc2626 !important;
    background-color: #fef2f2 !important;
}

.dark .form-control.is-invalid,
.dark input.is-invalid,
.dark textarea.is-invalid,
.dark select.is-invalid {
    border-color: #ef4444 !important;
    background-color: #7f1d1d !important;
}

/* Success state (valid input) */
input.is-valid,
textarea.is-valid,
select.is-valid {
    border-color: #16a34a !important;
}

.dark input.is-valid,
.dark textarea.is-valid,
.dark select.is-valid {
    border-color: #22c55e !important;
}
</style>
{% endblock %}
