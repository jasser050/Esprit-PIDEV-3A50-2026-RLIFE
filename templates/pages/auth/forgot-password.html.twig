{% extends 'layouts/public.html.twig' %}

{% block title %}Forgot password{% endblock %}

{% block styles %}
{{ parent() }}
<style>
    spline-viewer {
        width: 100% !important;
        height: 100% !important;
        background: transparent !important;
    }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen flex dark" data-controller="theme">
    <!-- Left Panel -->
    <div class="flex-1 flex flex-col justify-center px-4 sm:px-6 lg:px-8 xl:px-12 bg-slate-900">
        <div class="w-full max-w-[440px] mx-auto">

            <!-- Back link + logo -->
            <div class="mb-8">
                <a href="{{ path('app_login') }}" class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors mb-8">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to sign in
                </a>
                <a href="{{ path('app_landing') }}" class="flex items-center gap-2.5 mb-2">
                    <img src="{{ asset('image/logo0.png') }}" alt="RLIFE Logo" class="w-14 h-14 object-cover">
                    <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">RLIFE</span>
                </a>
            </div>

            <!-- Header -->
            <div class="mb-8">
                <div class="w-14 h-14 rounded-2xl bg-primary-500/15 border border-primary-500/30 flex items-center justify-center mb-5">
                    <i data-lucide="key-round" class="w-7 h-7 text-primary-400"></i>
                </div>
                <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    Forgot your password?
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-300">
                    Enter your email address and we'll send you a link to reset your password.
                </p>
            </div>

            <!-- Flash messages -->
            {% for message in app.flashes('success') %}
            <div class="p-4 bg-success-50 dark:bg-success-900/20 border border-success-200 dark:border-success-800 rounded-xl mb-6">
                <div class="flex items-start gap-3">
                    <i data-lucide="check-circle" class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5"></i>
                    <p class="text-sm text-success-700 dark:text-success-300">{{ message }}</p>
                </div>
            </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
            <div class="p-4 bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-xl mb-6">
                <div class="flex items-start gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                    <p class="text-sm text-danger-700 dark:text-danger-300">{{ message }}</p>
                </div>
            </div>
            {% endfor %}

            <!-- Form -->
            <form method="POST" action="{{ path('app_forgot_password') }}" class="space-y-5">
                <div>
                    <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Email address
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        placeholder="you@example.com"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>

                <button
                    type="submit"
                    class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all hover:-translate-y-0.5"
                >
                    Send reset link
                    <i data-lucide="send" class="w-5 h-5"></i>
                </button>
            </form>

            <p class="mt-8 text-center text-sm text-slate-600 dark:text-slate-400">
                Remembered it?
                <a href="{{ path('app_login') }}" class="font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
                    Sign in
                </a>
            </p>
        </div>
    </div>

    <!-- Right Panel - Spline 3D -->
    <div class="hidden lg:flex lg:w-[45%] xl:w-1/2 relative overflow-hidden">
        <spline-viewer
            url="https://prod.spline.design/WgPMxQsSYOM7gzlt/scene.splinecode"
            class="absolute inset-0 w-full h-full"
            loading="lazy"
        ></spline-viewer>

        <div class="absolute inset-y-0 left-0 w-28 bg-gradient-to-r from-slate-900 to-transparent pointer-events-none z-10"></div>

        <!-- Top band -->
        <div class="absolute top-0 inset-x-0 z-20 px-10 pt-10 pb-32
                    bg-gradient-to-b from-black/75 via-black/40 to-transparent
                    pointer-events-none">
            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full mb-6
                        bg-gradient-to-r from-yellow-400/20 to-amber-500/15
                        backdrop-blur-sm border border-yellow-400/35
                        shadow-[0_0_20px_rgba(234,179,8,0.15)]">
                <i data-lucide="shield-check" class="w-4 h-4 text-yellow-400 flex-shrink-0"></i>
                <span class="text-xs font-bold text-yellow-200 tracking-wide">Secure password reset</span>
                <span class="text-yellow-400 text-sm leading-none">✦</span>
            </div>

            <h2 class="text-4xl xl:text-5xl 2xl:text-6xl font-black text-white leading-[1.1] tracking-tight
                       drop-shadow-[0_4px_24px_rgba(0,0,0,0.5)]">
                Don't<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-300 via-purple-300 to-pink-400">worry.</span><br>
                <span class="text-white/90">We've</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-300 to-primary-300"> got you.</span>
            </h2>

            <p class="mt-5 text-sm xl:text-base text-white/55 max-w-[280px] leading-relaxed">
                A reset link expires in
                <span class="text-primary-300 font-semibold">1 hour</span>
                — check your inbox and spam folder.
            </p>
        </div>

        <!-- Stat cards -->
        <div class="absolute right-6 top-1/2 -translate-y-1/2 z-20 pointer-events-none flex flex-col gap-3">
            <div class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl min-w-[165px]
                        bg-gradient-to-r from-primary-500/15 to-primary-900/8
                        backdrop-blur-md border border-primary-400/30
                        shadow-[0_0_24px_rgba(99,102,241,0.12)]">
                <div class="w-11 h-11 rounded-xl flex-shrink-0 flex items-center justify-center
                            bg-gradient-to-br from-primary-400/35 to-primary-600/35
                            border border-primary-400/30">
                    <i data-lucide="lock" class="w-5 h-5 text-primary-300"></i>
                </div>
                <div>
                    <p class="text-2xl font-black text-white leading-none">256-bit</p>
                    <p class="text-[10px] font-semibold text-primary-200/60 mt-0.5 tracking-widest uppercase">Encryption</p>
                </div>
            </div>

            <div class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl
                        bg-gradient-to-r from-emerald-500/15 to-teal-500/8
                        backdrop-blur-md border border-emerald-400/30
                        shadow-[0_0_24px_rgba(52,211,153,0.12)]">
                <div class="w-11 h-11 rounded-xl flex-shrink-0 flex items-center justify-center
                            bg-gradient-to-br from-emerald-400/35 to-teal-500/35
                            border border-emerald-400/30">
                    <i data-lucide="shield" class="w-5 h-5 text-emerald-300"></i>
                </div>
                <div>
                    <p class="text-2xl font-black leading-none text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-teal-300">Safe</p>
                    <p class="text-[10px] font-semibold text-emerald-200/60 mt-0.5 tracking-widest uppercase">Token reset</p>
                </div>
            </div>

            <div class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl
                        bg-gradient-to-r from-purple-500/15 to-pink-500/8
                        backdrop-blur-md border border-purple-400/30
                        shadow-[0_0_24px_rgba(168,85,247,0.12)]">
                <div class="w-11 h-11 rounded-xl flex-shrink-0 flex items-center justify-center
                            bg-gradient-to-br from-purple-400/35 to-pink-500/35
                            border border-purple-400/30">
                    <i data-lucide="clock" class="w-5 h-5 text-purple-300"></i>
                </div>
                <div>
                    <p class="text-2xl font-black leading-none text-transparent bg-clip-text bg-gradient-to-r from-purple-300 to-pink-300">1 hr</p>
                    <p class="text-[10px] font-semibold text-purple-200/60 mt-0.5 tracking-widest uppercase">Link expiry</p>
                </div>
            </div>
        </div>

        <!-- Bottom band -->
        <div class="absolute bottom-0 inset-x-0 z-20 px-10 pb-10 pt-32
                    bg-gradient-to-t from-black/75 via-black/40 to-transparent
                    pointer-events-none">
            <p class="text-sm text-white/40 max-w-xs leading-relaxed">
                Your account data is safe. The reset link is single-use and expires automatically.
            </p>
        </div>

        <!-- Theme toggle -->
        <div class="absolute top-6 right-6 z-30">
            <button type="button" data-action="click->theme#toggle"
                    class="p-2.5 rounded-xl bg-black/25 hover:bg-black/40 backdrop-blur-sm text-white/70 hover:text-white transition-all border border-white/10"
                    aria-label="Toggle theme">
                <i data-lucide="moon" class="w-4 h-4 dark:hidden"></i>
                <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.57/build/spline-viewer.js"></script>
{% endblock %}
