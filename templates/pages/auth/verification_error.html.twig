{% extends 'layouts/public.html.twig' %}

{% block title %}Verification Error - RLIFE{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8" data-controller="theme">
    <!-- Background effects -->
    <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-radial from-warning-100/40 via-transparent to-transparent dark:from-warning-900/20"></div>
    </div>

    <div class="max-w-md w-full">
        <!-- Error Card -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-2xl shadow-slate-900/10 dark:shadow-black/30 p-8 sm:p-10 relative overflow-hidden">
            <!-- Decorative elements -->
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-gradient-to-br from-warning-400 to-danger-600 rounded-full opacity-10 blur-2xl"></div>
            <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-gradient-to-br from-warning-400 to-warning-600 rounded-full opacity-10 blur-2xl"></div>

            <!-- Content -->
            <div class="relative z-10">
                <!-- Error Icon -->
                <div class="flex justify-center mb-6">
                    {% if error_type == 'expired' %}
                        <div class="w-20 h-20 bg-gradient-to-br from-warning-400 to-warning-600 rounded-full flex items-center justify-center">
                            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    {% else %}
                        <div class="w-20 h-20 bg-gradient-to-br from-danger-400 to-danger-600 rounded-full flex items-center justify-center">
                            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                            </svg>
                        </div>
                    {% endif %}
                </div>

                <!-- Title -->
                {% if error_type == 'expired' %}
                    <h1 class="text-3xl font-bold text-center text-slate-900 dark:text-white mb-3">
                        Link Expired
                    </h1>
                    <p class="text-center text-slate-600 dark:text-slate-300 mb-8">
                        This verification link has expired for security reasons.
                    </p>
                {% else %}
                    <h1 class="text-3xl font-bold text-center text-slate-900 dark:text-white mb-3">
                        Verification Failed
                    </h1>
                    <p class="text-center text-slate-600 dark:text-slate-300 mb-8">
                        We couldn't verify your email address with this link.
                    </p>
                {% endif %}

                <!-- Info Box -->
                {% if email_resent is defined and email_resent %}
                    <div class="bg-gradient-to-br from-success-50 to-success-100 dark:from-success-900/20 dark:to-success-800/20 border border-success-200 dark:border-success-800 rounded-2xl p-6 mb-8">
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-success-600 dark:text-success-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                            <div>
                                <p class="font-semibold text-success-900 dark:text-success-100 mb-2">
                                    New Link Sent! 📧
                                </p>
                                <p class="text-sm text-success-800 dark:text-success-200">
                                    We've sent you a fresh verification link to your email. Please check your inbox and spam folder.
                                </p>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-700 dark:to-slate-700 rounded-2xl p-6 mb-8">
                        <p class="text-sm font-semibold text-slate-900 dark:text-white mb-3">
                            💡 What can I do?
                        </p>
                        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
                            <li class="flex items-start gap-2">
                                <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                </svg>
                                <span>Request a new verification link below</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                </svg>
                                <span>Check your spam or junk folder</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <svg class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                                </svg>
                                <span>Contact support if the problem persists</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Resend Form -->
                    <form action="{{ path('app_resend_verification') }}" method="POST" class="mb-6">
                        <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Enter your email address
                        </label>
                        <input type="email" 
                               id="email" 
                               name="email" 
                               required
                               placeholder="your@email.com"
                               class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all mb-4">
                        
                        <button type="submit" 
                                class="w-full px-6 py-4 bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-primary-500/50 transition-all hover:-translate-y-0.5">
                            <span class="flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path>
                                </svg>
                                Send New Verification Link
                            </span>
                        </button>
                    </form>
                {% endif %}

                <!-- Divider -->
                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-200 dark:border-slate-600"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-4 bg-white dark:bg-slate-800 text-slate-500 dark:text-slate-400">or</span>
                    </div>
                </div>

                <!-- Back to Login -->
                <a href="{{ path('app_login') }}" class="block w-full text-center px-6 py-3 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-semibold rounded-xl transition-all">
                    <span class="flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back to Login
                    </span>
                </a>

                <!-- Help -->
                <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-6">
                    Need assistance?
                    <a href="#" class="text-primary-600 dark:text-primary-400 hover:underline font-medium">
                        Contact Support
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
