<script>
    // Robot Flames Animation Control
    (function() {
        const flamesContainer = document.getElementById('robot-flames');
        
        function startFlames() {
            if (flamesContainer) {
                flamesContainer.classList.remove('leaving');
            }
        }
        
        function stopFlames() {
            if (flamesContainer) {
                flamesContainer.classList.add('leaving');
                setTimeout(function() {
                    if (flamesContainer) {
                        flamesContainer.style.display = 'none';
                    }
                }, 500);
            }
        }
        
        // Start flames on page load
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', startFlames);
        } else {
            startFlames();
        }
        
        // Start flames on Turbo navigation
        document.addEventListener('turbo:load', startFlames);
        
        // Stop flames when leaving
        window.addEventListener('beforeunload', stopFlames);
        window.addEventListener('pagehide', stopFlames);
        document.addEventListener('turbo:before-cache', stopFlames);
    })();
</script>
