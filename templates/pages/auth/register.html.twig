{% extends 'layouts/public.html.twig' %}

{% block title %}Create your account{% endblock %}

{% block styles %}
{{ parent() }}
<style>
    spline-viewer {
        width: 100% !important;
        height: 100% !important;
        background: transparent !important;
    }
    
    .spline-viewer {
        z-index: 1 !important;
    }
    
    /* Custom scrollbar for avatar grid */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(203, 213, 225, 0.2);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(99, 102, 241, 0.5);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(99, 102, 241, 0.7);
    }
    
    /* Avatar selection animations */
    .avatar-card {
        cursor: pointer !important;
        position: relative;
        z-index: 10;
    }
    
    .avatar-canvas-container {
        pointer-events: none !important;
    }
    
    /* Selected state - checkmark */
    .avatar-card.selected .avatar-check {
        opacity: 1 !important;
        display: flex !important;
    }
    
    /* Selected state - border and glow */
    .avatar-card.selected > div.relative {
        border-color: rgb(99, 102, 241) !important;
        border-width: 3px !important;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.3), 0 10px 40px rgba(99, 102, 241, 0.4) !important;
        transform: scale(1.02) !important;
    }
    
    /* Jump animation */
    @keyframes avatarJump {
        0%, 100% { 
            transform: translateY(0) scale(1); 
        }
        30% { 
            transform: translateY(-28px) scale(1.1); 
        }
        50% { 
            transform: translateY(-10px) scale(1.05); 
        }
        70% { 
            transform: translateY(-18px) scale(1.08); 
        }
    }
    
    .avatar-card.avatar-jump {
        animation: avatarJump 0.7s cubic-bezier(0.68, -0.55, 0.265, 1.55) !important;
    }

    /* ===== ROBOT EYE FLAMES ===== */
    .robot-flames-container {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 25;
        overflow: hidden;
    }

    .eye-flame-wrapper {
        position: absolute;
        width: 80px;
        height: 100px;
        transform: translate(-50%, -50%);
    }

    .eye-flame {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .flame-core {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 20px;
        height: 30px;
        background: linear-gradient(to top, #2563EB, #60A5FA, #BFDBFE);
        border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
        filter: blur(3px);
        animation: flameFlicker 0.8s ease-in-out infinite;
    }

    .flame-main {
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 35px;
        height: 50px;
        background: linear-gradient(to top, #1E3A8A 0%, #2563EB 30%, #3B82F6 60%, #60A5FA 100%);
        border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
        filter: blur(6px);
        animation: flameFlicker 1s ease-in-out infinite alternate;
    }

    .flame-outer {
        position: absolute;
        bottom: -5px;
        left: 50%;
        transform: translateX(-50%);
        width: 50px;
        height: 65px;
        background: linear-gradient(to top, transparent 0%, #2563EB 30%, #3B82F6 50%, #60A5FA 70%, transparent 100%);
        border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
        filter: blur(12px);
        animation: flameFlicker 1.2s ease-in-out infinite alternate;
    }

    .flame-glow {
        position: absolute;
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 70px;
        height: 80px;
        background: radial-gradient(ellipse at center bottom, rgba(96, 165, 250, 0.4) 0%, transparent 70%);
        filter: blur(20px);
        animation: glowPulse 2s ease-in-out infinite;
    }

    @keyframes flameFlicker {
        0%, 100% {
            transform: translateX(-50%) translateY(0) scaleY(1) scaleX(1) rotate(-3deg);
            opacity: 0.9;
        }
        25% {
            transform: translateX(-50%) translateY(-3px) scaleY(1.1) scaleX(0.95) rotate(2deg);
            opacity: 1;
        }
        50% {
            transform: translateX(-50%) translateY(-6px) scaleY(0.95) scaleX(1.05) rotate(-2deg);
            opacity: 0.85;
        }
        75% {
            transform: translateX(-50%) translateY(-4px) scaleY(1.05) scaleX(0.98) rotate(3deg);
            opacity: 0.95;
        }
    }

    @keyframes glowPulse {
        0%, 100% {
            opacity: 0.6;
            transform: translateX(-50%) scale(1);
        }
        50% {
            opacity: 1;
            transform: translateX(-50%) scale(1.15);
        }
    }

    /* Eye positions - centered initially */
    .eye-left {
        top: var(--eye-top, 35%);
        left: var(--eye-left-pos, 45%);
    }

    .eye-right {
        top: var(--eye-top, 35%);
        left: var(--eye-right-pos, 55%);
    }

    /* Hide flames when leaving page */
    .robot-flames-container.leaving .eye-flame-wrapper {
        animation: flamesExit 0.5s ease-in forwards;
    }

    @keyframes flamesExit {
        to {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0);
        }
    }

    /* ===== FORM FIELD ANIMATIONS ===== */
    .form-field-animated {
        opacity: 0;
        transform: translateX(-80px);
    }

    .form-field-animated.animated {
        animation: slideInFromLeft 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }

    @keyframes slideInFromLeft {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .form-field-animated {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .form-field-animated:hover {
        transform: scale(1.02);
    }

    .form-field-animated:focus-within {
        transform: scale(1.03);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15), 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }
</style>
{% endblock %}

{% block page_scripts %}
<!-- Spline 3D Viewer -->
<script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.57/build/spline-viewer.js"></script>
<!-- face-api.js for Face ID -->
<script src="/js/face-api.min.js"></script>
<!-- Avatar Selector -->
{{ encore_entry_script_tags('avatar-selector') }}
{% endblock %}

{% block body %}
<div class="min-h-screen flex" data-controller="theme wizard password" data-wizard-total-value="4">
    <!-- Left Panel - Form -->
    <div class="flex-1 flex flex-col justify-center px-4 sm:px-6 lg:px-8 xl:px-12 bg-slate-50 dark:bg-slate-900 pt-16 lg:pt-0">
        <div class="w-full max-w-[480px] mx-auto">
            <!-- Logo and back link -->
            <div class="mb-8">
                <a href="{{ path('app_landing') }}" class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors mb-8">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to home
                </a>

                <a href="{{ path('app_landing') }}" class="flex items-center gap-2.5 mb-2">
                    <img src="{{ asset('image/logo0.png') }}" alt="RLIFE Logo" class="w-14 h-14 object-cover">
                    <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">RLIFE</span>
                </a>
            </div>

            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    Create your account
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-300">
                    Start organising your semester in minutes
                </p>
            </div>
            
            <!-- Flash Messages -->
            {% for message in app.flashes('error') %}
            <div class="p-4 mb-4 bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-xl animate-fade-in">
                <div class="flex items-start gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-danger-800 dark:text-danger-200">Error</p>
                        <p class="text-sm text-danger-600 dark:text-danger-300 mt-0.5">{{ message }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
            
            {% for message in app.flashes('success') %}
            <div class="p-4 mb-4 bg-success-50 dark:bg-success-900/20 border border-success-200 dark:border-success-800 rounded-xl animate-fade-in">
                <div class="flex items-start gap-3">
                    <i data-lucide="check-circle" class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-success-800 dark:text-success-200">Success</p>
                        <p class="text-sm text-success-600 dark:text-success-300 mt-0.5">{{ message }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}

            <!-- Step Indicator -->
            <div class="flex items-center gap-3 mb-8">
                <div class="flex items-center gap-2" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-primary-600 border-primary-600 text-white flex items-center justify-center text-sm font-semibold transition-colors">
                        1
                    </div>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300 whitespace-nowrap leading-none">Account</span>
                </div>
                <div class="step-line w-8 h-0.5 bg-slate-200 dark:bg-slate-700 transition-colors flex-shrink-0"></div>
                
                <div class="flex items-center gap-2" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600 text-slate-500 flex items-center justify-center text-sm font-semibold transition-colors">
                        2
                    </div>
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400 whitespace-nowrap leading-none">Preferences</span>
                </div>
                <div class="step-line w-8 h-0.5 bg-slate-200 dark:bg-slate-700 transition-colors flex-shrink-0"></div>
                
                <div class="flex items-center gap-2" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600 text-slate-500 flex items-center justify-center text-sm font-semibold transition-colors">
                        3
                    </div>
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400 whitespace-nowrap leading-none">Avatar</span>
                </div>
                <div class="step-line w-8 h-0.5 bg-slate-200 dark:bg-slate-700 transition-colors flex-shrink-0"></div>
                
                <div class="flex items-center gap-2" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600 text-slate-500 flex items-center justify-center text-sm font-semibold transition-colors">
                        4
                    </div>
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400 whitespace-nowrap leading-none">Face ID</span>
                </div>
            </div>

            <!-- Registration Form -->
            <form action="{{ path('app_register') }}" method="POST" data-turbo="false">
                <!-- Step 1: Account Details -->
                <div data-wizard-target="step" class="space-y-5">
                    <!-- First Name -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="first_name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                First name
                            </label>
                            <input
                                type="text"
                                id="first_name"
                                name="first_name"
                                required
                                autocomplete="given-name"
                                placeholder="John"
                                class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                            >
                        </div>
                        <div>
                            <label for="last_name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                Last name
                            </label>
                            <input
                                type="text"
                                id="last_name"
                                name="last_name"
                                required
                                autocomplete="family-name"
                                placeholder="Doe"
                                class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                            >
                        </div>
                    </div>

                    <!-- Username -->
                    <div>
                        <label for="username" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Username
                        </label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            required
                            autocomplete="username"
                            placeholder="johndoe"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Email address
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            autocomplete="email"
                            placeholder="you@university.edu"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Use your .edu email for free access</p>
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Password
                        </label>
                        <div class="relative">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                required
                                autocomplete="new-password"
                                placeholder="Create a strong password"
                                data-password-target="input"
                                class="block w-full px-4 py-3 pr-12 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                            >
                            <button
                                type="button"
                                data-password-target="toggle"
                                data-action="click->password#toggleVisibility"
                                class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors"
                            >
                                <i data-lucide="eye" class="w-5 h-5 icon-show"></i>
                                <i data-lucide="eye-off" class="w-5 h-5 icon-hide hidden"></i>
                            </button>
                        </div>

                        <!-- Password strength meter -->
                        <div class="mt-3">
                            <div class="h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                                <div class="h-full w-0 transition-all duration-300" data-password-target="strength"></div>
                            </div>
                            <div class="mt-2 grid grid-cols-2 gap-2 text-xs" data-password-target="requirements">
                                <span class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500" data-requirement="length">
                                    <i data-lucide="circle" class="w-3 h-3 req-icon"></i>
                                    8+ characters
                                </span>
                                <span class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500" data-requirement="lowercase">
                                    <i data-lucide="circle" class="w-3 h-3 req-icon"></i>
                                    Lowercase letter
                                </span>
                                <span class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500" data-requirement="uppercase">
                                    <i data-lucide="circle" class="w-3 h-3 req-icon"></i>
                                    Uppercase letter
                                </span>
                                <span class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500" data-requirement="number">
                                    <i data-lucide="circle" class="w-3 h-3 req-icon"></i>
                                    Number
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label for="confirm_password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Confirm password
                        </label>
                        <input
                            type="password"
                            id="confirm_password"
                            name="confirm_password"
                            required
                            autocomplete="new-password"
                            placeholder="Confirm your password"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                    </div>

                    <!-- Terms -->
                    <div class="flex items-start gap-3">
                        <input
                            type="checkbox"
                            id="terms"
                            name="terms"
                            required
                            class="mt-1 w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-primary-600 focus:ring-primary-500 bg-slate-50 dark:bg-slate-800"
                        >
                        <label for="terms" class="text-sm text-slate-600 dark:text-slate-300">
                            I agree to the <a href="#" class="font-medium text-primary-600 dark:text-primary-400 hover:underline">Terms of Service</a> and <a href="#" class="font-medium text-primary-600 dark:text-primary-400 hover:underline">Privacy Policy</a>
                        </label>
                    </div>
                </div>

                <!-- Step 2: Preferences -->
                <div data-wizard-target="step" class="hidden space-y-6">
                    <!-- Gender -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">Gender</label>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="relative cursor-pointer">
                                <input type="radio" name="gender" value="male" class="peer sr-only" checked required>
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Male</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="gender" value="female" class="peer sr-only" required>
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Female</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Study Level -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">What's your study level?</label>
                        <div class="grid grid-cols-3 gap-3">
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="beginner" class="peer sr-only" checked>
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="sprout" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Beginner</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="intermediate" class="peer sr-only">
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="trending-up" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Intermediate</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="advanced" class="peer sr-only">
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="rocket" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Advanced</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Weekly Goal -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                            Weekly study goal: <span id="goal-display" class="text-primary-600 dark:text-primary-400">5 hours</span>
                        </label>
                        <input type="range" name="weekly_goal" min="1" max="10" value="5"
                            class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-full appearance-none cursor-pointer accent-primary-600"
                            oninput="document.getElementById('goal-display').textContent = this.value + ' hours'">
                        <div class="flex justify-between text-xs text-slate-400 dark:text-slate-500 mt-1">
                            <span>1h</span><span>10h</span>
                        </div>
                    </div>

                    <!-- Interests -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">What are you interested in?</label>
                        <div class="flex flex-wrap gap-2">
                            {% set interests = ['Web Dev', 'Data Science', 'Design', 'Business', 'Languages', 'Math', 'Science', 'Arts', 'Engineering'] %}
                            {% for interest in interests %}
                            <label class="cursor-pointer">
                                <input type="checkbox" name="interests[]" value="{{ interest|lower|replace({' ': '_'}) }}" class="peer sr-only">
