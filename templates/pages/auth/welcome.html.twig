{% extends 'layouts/public.html.twig' %}

{% block title %}Welcome to RLIFE{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-slate-50 to-white dark:from-slate-900 dark:to-slate-950" data-controller="theme">
    <div class="w-full max-w-2xl text-center">
        <!-- Success icon -->
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary-100 dark:bg-primary-900/30 mb-8 animate-bounce-in">
            <i data-lucide="check-circle" class="w-10 h-10 text-primary-600 dark:text-primary-400"></i>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-slate-900 dark:text-white mb-4">
            Welcome to <span class="bg-gradient-to-r from-primary-600 to-primary-400 bg-clip-text text-transparent">RLIFE!</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 mb-12 max-w-xl mx-auto">
            Your account has been created successfully. Let's get you started on your journey to organised academic success.
        </p>

        <!-- Action cards -->
        <div class="grid sm:grid-cols-2 gap-4 mb-8">
            <a href="{{ path('app_dashboard') }}" 
               class="group p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-xl transition-all hover:-translate-y-1 text-left">
                <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i data-lucide="layout-dashboard" class="w-6 h-6 text-primary-600 dark:text-primary-400"></i>
                </div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Go to Dashboard</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    Start exploring your personal study hub
                </p>
            </a>

            <a href="{{ path('app_revisions') }}"
               class="group p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-secondary-300 dark:hover:border-secondary-700 hover:shadow-xl transition-all hover:-translate-y-1 text-left">
                <div class="w-12 h-12 rounded-xl bg-secondary-100 dark:bg-secondary-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i data-lucide="layers" class="w-6 h-6 text-secondary-600 dark:text-secondary-400"></i>
                </div>
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">Create Flashcards</h3>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    Build your first revision deck
                </p>
            </a>
        </div>

        <!-- Quick tip -->
        <div class="p-4 bg-primary-50 dark:bg-primary-900/20 rounded-xl border border-primary-100 dark:border-primary-800 max-w-md mx-auto">
            <div class="flex items-start gap-3 text-left">
                <i data-lucide="lightbulb" class="w-5 h-5 text-primary-500 flex-shrink-0 mt-0.5"></i>
                <div>
                    <p class="text-sm font-medium text-primary-800 dark:text-primary-200">Pro tip</p>
                    <p class="text-sm text-primary-600 dark:text-primary-300 mt-0.5">
                        Start by adding your courses and upcoming assignments. RLIFE will help you stay on track!
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes bounce-in {
    0% { opacity: 0; transform: scale(0.3); }
    50% { transform: scale(1.05); }
    70% { transform: scale(0.9); }
    100% { opacity: 1; transform: scale(1); }
}
.animate-bounce-in {
    animation: bounce-in 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}
</style>
{% endblock %}
