{% extends 'layouts/public.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
<div class="min-h-screen flex" data-controller="theme password">
    <!-- Left Panel - Form -->
    <div class="flex-1 flex flex-col justify-center px-4 sm:px-6 lg:px-8 xl:px-12 bg-white dark:bg-slate-900">
        <div class="w-full max-w-[440px] mx-auto">
            <!-- Logo and back link -->
            <div class="mb-8">
                <a href="{{ path('app_landing') }}" class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors mb-8">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to home
                </a>

                <a href="{{ path('app_landing') }}" class="flex items-center gap-2.5 mb-2">
                    <div class="w-14 h-14 relative">
                        <!-- Light Mode Logo -->
                        <img src="{{ asset('image/logo0.png') }}" 
                             alt="RLIFE Logo" 
                             class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ease-in-out dark:opacity-0">
                        <!-- Dark Mode Logo -->
                        <img src="{{ asset('image/logo1.png') }}" 
                             alt="RLIFE Logo" 
                             class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 ease-in-out opacity-0 dark:opacity-100">
                    </div>
                    <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">RLIFE</span>
                </a>
            </div>

            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    Welcome back
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-300">
                    Sign in to continue to your dashboard
                </p>
            </div>

            <!-- Flash Messages -->
            <div class="min-h-[60px] mb-2">
                {% for message in app.flashes('success') %}
                <div class="p-4 bg-success-50 dark:bg-success-900/20 border border-success-200 dark:border-success-800 rounded-xl animate-fade-in mb-2">
                    <div class="flex items-start gap-3">
                        <i data-lucide="check-circle" class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <p class="font-medium text-success-800 dark:text-success-200">Success</p>
                            <p class="text-sm text-success-600 dark:text-success-300 mt-0.5">{{ message }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
                
                {% for message in app.flashes('error') %}
                <div class="p-4 bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-xl animate-fade-in mb-2">
                    <div class="flex items-start gap-3">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <p class="font-medium text-danger-800 dark:text-danger-200">Error</p>
                            <p class="text-sm text-danger-600 dark:text-danger-300 mt-0.5">{{ message }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
                
                {% if error %}
                <div class="p-4 bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-xl animate-fade-in">
                    <div class="flex items-start gap-3">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <p class="font-medium text-danger-800 dark:text-danger-200">Unable to sign in</p>
                            <p class="text-sm text-danger-600 dark:text-danger-300 mt-0.5">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Login Form -->
            <form action="{{ path('app_login') }}" method="POST" class="space-y-5">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                
                <!-- Email -->
                <div>
                    <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Email address
                    </label>
                    <div class="relative">
                        <input
                            type="email"
                            id="email"
                            name="_username"
                            value="{{ last_username|default('') }}"
                            required
                            autocomplete="email"
                            placeholder="you@university.edu"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                    </div>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="password" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
                            Password
                        </label>
                        <a href="#" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
                            Forgot password?
                        </a>
                    </div>
                    <div class="relative" data-password-target="container">
                        <input
                            type="password"
                            id="password"
                            name="_password"
                            required
                            autocomplete="current-password"
                            placeholder="Enter your password"
                            data-password-target="input"
                            class="block w-full px-4 py-3 pr-12 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                        <button
                            type="button"
                            data-password-target="toggle"
                            data-action="click->password#toggleVisibility"
                            class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors"
                            aria-label="Toggle password visibility"
                        >
                            <i data-lucide="eye" class="w-5 h-5 icon-show"></i>
                            <i data-lucide="eye-off" class="w-5 h-5 icon-hide hidden"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember me -->
                <div class="flex items-center gap-3">
                    <input
                        type="checkbox"
                        id="remember"
                        name="remember"
                        class="w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-primary-600 focus:ring-primary-500 bg-slate-50 dark:bg-slate-800"
                    >
                    <label for="remember" class="text-sm text-slate-600 dark:text-slate-300">
                        Remember me for 30 days
                    </label>
                </div>

                <!-- Submit -->
                <button
                    type="submit"
                    class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
                >
                    Sign in
                    <i data-lucide="arrow-right" class="w-5 h-5"></i>
                </button>
            </form>

            <!-- Divider -->
            <div class="relative my-8">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200 dark:border-slate-700"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-4 bg-white dark:bg-slate-900 text-slate-500 dark:text-slate-400">or continue with</span>
                </div>
            </div>

            <!-- Social Login -->
            <button
                type="button"
                class="w-full flex items-center justify-center gap-3 px-6 py-3.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-medium rounded-xl transition-colors"
            >
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                Continue with Google
            </button>

            <!-- Sign up link -->
            <p class="mt-8 text-center text-sm text-slate-600 dark:text-slate-400">
                New to RLIFE?
                <a href="{{ path('app_register') }}" class="font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
                    Create an account
                </a>
            </p>
        </div>
    </div>

    <!-- Right Panel - Brand -->
    <div class="hidden lg:flex lg:w-[45%] xl:w-1/2 relative bg-gradient-to-br from-primary-600 via-primary-700 to-primary-900 dark:from-slate-800 dark:via-slate-900 dark:to-slate-950">
        <!-- Pattern overlay -->
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:24px_24px]"></div>

        <div class="relative z-10 flex flex-col justify-center px-12 xl:px-16">
            <!-- Theme toggle -->
            <button
                type="button"
                data-action="click->theme#toggle"
                class="absolute top-6 right-6 p-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white transition-colors"
                aria-label="Toggle theme"
            >
                <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
            </button>

            <!-- Content -->
            <div class="max-w-md">
                <h2 class="text-3xl xl:text-4xl font-semibold text-white leading-tight mb-6">
                    Study smarter, not harder
                </h2>

                <!-- Benefits list -->
                <ul class="space-y-4 mb-10">
                    <li class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i data-lucide="check" class="w-4 h-4 text-white"></i>
                        </div>
                        <span class="text-white/90">Track all your courses, assignments, and deadlines in one place</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i data-lucide="check" class="w-4 h-4 text-white"></i>
                        </div>
                        <span class="text-white/90">Boost retention with smart flashcards and spaced repetition</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i data-lucide="check" class="w-4 h-4 text-white"></i>
                        </div>
                        <span class="text-white/90">Stay balanced with wellbeing check-ins and stress tracking</span>
                    </li>
                </ul>

                <!-- Testimonial card -->
                <div class="p-6 bg-white/10 backdrop-blur-sm rounded-2xl border border-white/20">
                    <div class="flex gap-1 mb-3">
                        {% for i in 1..5 %}
                        <i data-lucide="star" class="w-4 h-4 fill-warning-400 text-warning-400"></i>
                        {% endfor %}
                    </div>
                    <p class="text-white/90 mb-4 leading-relaxed">
                        "RLIFE helped me go from feeling overwhelmed to actually enjoying my studies. The wellbeing features are a game-changer."
                    </p>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-secondary-400 to-secondary-600 flex items-center justify-center text-white font-semibold text-sm">
                            AR
                        </div>
                        <div>
                            <p class="font-semibold text-white text-sm">Alex Rodriguez</p>
                            <p class="text-sm text-white/60">Psychology, UCLA</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Decorative elements -->
            <div class="absolute bottom-12 right-12 w-32 h-32 bg-white/5 rounded-full blur-2xl"></div>
            <div class="absolute top-24 right-24 w-20 h-20 bg-secondary-500/20 rounded-full blur-xl"></div>
        </div>
    </div>

    <!-- Mobile brand header (shown only on small screens) -->
    <div class="lg:hidden fixed top-0 left-0 right-0 z-10 bg-gradient-to-r from-primary-600 to-primary-700 dark:from-slate-800 dark:to-slate-900 px-4 py-3">
        <div class="flex items-center justify-between">
            <a href="{{ path('app_landing') }}" class="flex items-center gap-2">
                <img src="{{ asset('image/logo.jpg') }}" alt="RLIFE Logo" class="w-8 h-8 rounded-lg object-cover">
                <span class="font-semibold text-white">RLIFE</span>
            </a>
            <button
                type="button"
                data-action="click->theme#toggle"
                class="p-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition-colors"
            >
                <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
            </button>
        </div>
    </div>
</div>
{% endblock %}
