{% extends 'layouts/public.html.twig' %}

{% block title %}Email Verified - RLIFE{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8" data-controller="theme">
    <!-- Background effects -->
    <div class="absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:32px_32px]"></div>
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-radial from-success-100/40 via-transparent to-transparent dark:from-success-900/20"></div>
    </div>

    <div class="max-w-md w-full">
        <!-- Success Card -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-2xl shadow-slate-900/10 dark:shadow-black/30 p-8 sm:p-10 relative overflow-hidden">
            <!-- Decorative elements -->
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-gradient-to-br from-success-400 to-success-600 rounded-full opacity-10 blur-2xl"></div>
            <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-gradient-to-br from-primary-400 to-primary-600 rounded-full opacity-10 blur-2xl"></div>

            <!-- Content -->
            <div class="relative z-10">
                <!-- Success Icon -->
                <div class="flex justify-center mb-6">
                    <div class="w-20 h-20 bg-gradient-to-br from-success-400 to-success-600 rounded-full flex items-center justify-center animate-bounce-slow">
                        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                </div>

                <!-- Celebration emojis -->
                <div class="text-center text-6xl mb-6 animate-bounce">
                    🎉
                </div>

                <!-- Title -->
                <h1 class="text-3xl font-bold text-center text-slate-900 dark:text-white mb-3">
                    Email Verified!
                </h1>

                <!-- Subtitle -->
                <p class="text-center text-slate-600 dark:text-slate-300 mb-8">
                    Welcome to RLIFE, <strong>{{ user.firstName }}</strong>! Your account is now active and ready to use.
                </p>

                <!-- Features list -->
                <div class="bg-gradient-to-br from-primary-50 to-success-50 dark:from-slate-700 dark:to-slate-700 rounded-2xl p-6 mb-8">
                    <p class="text-sm font-semibold text-slate-900 dark:text-white mb-4">
                        ✨ What's next?
                    </p>
                    <ul class="space-y-3 text-sm text-slate-600 dark:text-slate-300">
                        <li class="flex items-start gap-2">
                            <svg class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Set up your courses and semester schedule</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <svg class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Track your assignments and deadlines</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <svg class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Create flashcards with spaced repetition</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <svg class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>Monitor your wellbeing and stress levels</span>
                        </li>
                    </ul>
                </div>

                <!-- CTA Button -->
                <a href="{{ path('app_login') }}" class="block w-full text-center px-6 py-4 bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-primary-500/50 transition-all hover:-translate-y-0.5">
                    <span class="flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                        </svg>
                        Log In to Your Account
                    </span>
                </a>

                <!-- Additional help -->
                <p class="text-center text-sm text-slate-500 dark:text-slate-400 mt-6">
                    Need help getting started?
                    <a href="#" class="text-primary-600 dark:text-primary-400 hover:underline font-medium">
                        View Quick Start Guide
                    </a>
                </p>
            </div>
        </div>

        <!-- Footer note -->
        <p class="text-center text-sm text-slate-600 dark:text-slate-400 mt-6">
            A welcome email has been sent to <strong>{{ user.email }}</strong>
        </p>
    </div>
</div>

<style>
@keyframes bounce-slow {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
}

.animate-bounce-slow {
    animation: bounce-slow 2s ease-in-out infinite;
}
</style>
{% endblock %}
