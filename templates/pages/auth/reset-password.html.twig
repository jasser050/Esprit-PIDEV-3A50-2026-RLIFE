{% extends 'layouts/public.html.twig' %}

{% block title %}Set new password{% endblock %}

{% block styles %}
{{ parent() }}
<style>
    spline-viewer {
        width: 100% !important;
        height: 100% !important;
        background: transparent !important;
    }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen flex dark" data-controller="theme password">
    <!-- Left Panel -->
    <div class="flex-1 flex flex-col justify-center px-4 sm:px-6 lg:px-8 xl:px-12 bg-slate-900">
        <div class="w-full max-w-[440px] mx-auto">

            <!-- Logo -->
            <div class="mb-8">
                <a href="{{ path('app_landing') }}" class="flex items-center gap-2.5 mb-2">
                    <img src="{{ asset('image/logo0.png') }}" alt="RLIFE Logo" class="w-14 h-14 object-cover">
                    <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">RLIFE</span>
                </a>
            </div>

            <!-- Header -->
            <div class="mb-8">
                <div class="w-14 h-14 rounded-2xl bg-primary-500/15 border border-primary-500/30 flex items-center justify-center mb-5">
                    <i data-lucide="lock-keyhole" class="w-7 h-7 text-primary-400"></i>
                </div>
                <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    Set a new password
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-300">
                    Choose a strong password you haven't used before.
                </p>
            </div>

            <!-- Flash messages -->
            {% for message in app.flashes('error') %}
            <div class="p-4 bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-xl mb-6">
                <div class="flex items-start gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                    <p class="text-sm text-danger-700 dark:text-danger-300">{{ message }}</p>
                </div>
            </div>
            {% endfor %}

            <!-- Form -->
            <form method="POST" action="{{ path('app_reset_password', {token: token}) }}" class="space-y-5">

                <!-- New password -->
                <div>
                    <label for="password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        New password
                    </label>
                    <div class="relative" data-password-target="container">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            minlength="8"
                            placeholder="At least 8 characters"
                            data-password-target="input"
                            class="block w-full px-4 py-3 pr-12 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                        <button type="button"
                                data-password-target="toggle"
                                data-action="click->password#toggleVisibility"
                                class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors"
                                aria-label="Toggle password visibility">
                            <i data-lucide="eye" class="w-5 h-5 icon-show"></i>
                            <i data-lucide="eye-off" class="w-5 h-5 icon-hide hidden"></i>
                        </button>
                    </div>
                </div>

                <!-- Confirm password -->
                <div>
                    <label for="confirm_password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                        Confirm password
                    </label>
                    <input
                        type="password"
                        id="confirm_password"
                        name="confirm_password"
                        required
                        minlength="8"
                        placeholder="Repeat your new password"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>

                <!-- Password strength hint -->
                <p class="text-xs text-slate-500 dark:text-slate-400">
                    Use at least 8 characters with a mix of letters and numbers.
                </p>

                <button
                    type="submit"
                    class="w-full flex items-center justify-center gap-2 px-6 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl shadow-lg shadow-primary-500/25 hover:shadow-primary-500/40 transition-all hover:-translate-y-0.5"
                >
                    Reset password
                    <i data-lucide="check" class="w-5 h-5"></i>
                </button>
            </form>

            <p class="mt-8 text-center text-sm text-slate-600 dark:text-slate-400">
                <a href="{{ path('app_login') }}" class="font-semibold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
                    Back to sign in
                </a>
            </p>
        </div>
    </div>

    <!-- Right Panel - Spline 3D -->
    <div class="hidden lg:flex lg:w-[45%] xl:w-1/2 relative overflow-hidden">
        <spline-viewer
            url="https://prod.spline.design/WgPMxQsSYOM7gzlt/scene.splinecode"
            class="absolute inset-0 w-full h-full"
            loading="lazy"
        ></spline-viewer>

        <div class="absolute inset-y-0 left-0 w-28 bg-gradient-to-r from-slate-900 to-transparent pointer-events-none z-10"></div>

        <!-- Top band -->
        <div class="absolute top-0 inset-x-0 z-20 px-10 pt-10 pb-32
                    bg-gradient-to-b from-black/75 via-black/40 to-transparent
                    pointer-events-none">
            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full mb-6
                        bg-gradient-to-r from-emerald-400/20 to-teal-500/15
                        backdrop-blur-sm border border-emerald-400/35
                        shadow-[0_0_20px_rgba(52,211,153,0.15)]">
                <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400 flex-shrink-0"></i>
                <span class="text-xs font-bold text-emerald-200 tracking-wide">Almost there — you've got this</span>
                <span class="text-emerald-400 text-sm leading-none">✦</span>
            </div>

            <h2 class="text-4xl xl:text-5xl 2xl:text-6xl font-black text-white leading-[1.1] tracking-tight
                       drop-shadow-[0_4px_24px_rgba(0,0,0,0.5)]">
                New<br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-300 via-purple-300 to-pink-400">password.</span><br>
                <span class="text-white/90">Fresh</span>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-300 to-primary-300"> start.</span>
            </h2>

            <p class="mt-5 text-sm xl:text-base text-white/55 max-w-[280px] leading-relaxed">
                Pick a strong password and
                <span class="text-primary-300 font-semibold">get back</span>
                to studying in seconds.
            </p>
        </div>

        <!-- Stat cards -->
        <div class="absolute right-6 top-1/2 -translate-y-1/2 z-20 pointer-events-none flex flex-col gap-3">
            <div class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl min-w-[165px]
                        bg-gradient-to-r from-emerald-500/15 to-teal-500/8
                        backdrop-blur-md border border-emerald-400/30
                        shadow-[0_0_24px_rgba(52,211,153,0.12)]">
                <div class="w-11 h-11 rounded-xl flex-shrink-0 flex items-center justify-center
                            bg-gradient-to-br from-emerald-400/35 to-teal-500/35 border border-emerald-400/30">
                    <i data-lucide="check-circle" class="w-5 h-5 text-emerald-300"></i>
                </div>
                <div>
                    <p class="text-2xl font-black leading-none text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-teal-300">Single</p>
                    <p class="text-[10px] font-semibold text-emerald-200/60 mt-0.5 tracking-widest uppercase">Use link</p>
                </div>
            </div>

            <div class="flex items-center gap-3.5 px-4 py-3.5 rounded-2xl
                        bg-gradient-to-r from-primary-500/15 to-primary-900/8
                        backdrop-blur-md border border-primary-400/30
                        shadow-[0_0_24px_rgba(99,102,241,0.12)]">
                <div class="w-11 h-11 rounded-xl flex-shrink-0 flex items-center justify-center
                            bg-gradient-to-br from-primary-400/35 to-primary-600/35 border border-primary-400/30">
                    <i data-lucide="key-round" class="w-5 h-5 text-primary-300"></i>
                </div>
                <div>
                    <p class="text-2xl font-black text-white leading-none">Bcrypt</p>
                    <p class="text-[10px] font-semibold text-primary-200/60 mt-0.5 tracking-widest uppercase">Hashed</p>
                </div>
            </div>
        </div>

        <!-- Theme toggle -->
        <div class="absolute top-6 right-6 z-30">
            <button type="button" data-action="click->theme#toggle"
                    class="p-2.5 rounded-xl bg-black/25 hover:bg-black/40 backdrop-blur-sm text-white/70 hover:text-white transition-all border border-white/10"
                    aria-label="Toggle theme">
                <i data-lucide="moon" class="w-4 h-4 dark:hidden"></i>
                <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.57/build/spline-viewer.js"></script>
{% endblock %}
