{% extends 'base.html.twig' %}

{% block title %}Edit: {{ assignment.title }}{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Assignments', href: path('app_assignments') },
            { label: assignment.title, href: path('app_assignments_show', { id: assignment.id }) },
            { label: 'Edit' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Edit Assignment',
        subtitle: 'Update assignment details'
    } %}

    <form action="{{ path('app_assignments_edit', { id: assignment.id }) }}" method="POST" class="card p-6">
        <div class="space-y-6">
            <!-- Title -->
            {% include 'components/input.html.twig' with {
                name: 'title',
                label: 'Assignment Title',
                value: assignment.title,
                placeholder: 'e.g., Binary Tree Implementation',
                required: true
            } %}

            <!-- Course Selection -->
            {% include 'components/select.html.twig' with {
                name: 'course_id',
                label: 'Course',
                value: assignment.course_id,
                required: true,
                options: courses|map(c => { value: c.id, label: c.name ~ ' (' ~ c.code ~ ')' })
            } %}

            <!-- Due Date -->
            {% include 'components/input.html.twig' with {
                name: 'due_date',
                label: 'Due Date',
                type: 'date',
                value: assignment.due_date|date('Y-m-d'),
                required: true
            } %}

            <!-- Priority -->
            {% include 'components/select.html.twig' with {
                name: 'priority',
                label: 'Priority',
                value: assignment.priority,
                options: [
                    { value: 'high', label: 'High Priority' },
                    { value: 'medium', label: 'Medium Priority' },
                    { value: 'low', label: 'Low Priority' }
                ]
            } %}

            <!-- Status -->
            {% include 'components/select.html.twig' with {
                name: 'status',
                label: 'Status',
                value: assignment.status,
                options: [
