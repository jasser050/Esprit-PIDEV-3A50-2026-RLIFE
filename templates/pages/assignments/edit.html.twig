{% extends 'base.html.twig' %}

{% block title %}Modifier {{ assignment.titre }}{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Tâches', url: path('app_assignments') },
            { label: assignment.titre, url: path('app_assignments_show', { id: assignment.id }) },
            { label: 'Modifier' }
        ]
    } %}

    {{ form_start(form, {'attr': {'class': 'max-w-2xl'}}) }}
        <div class="card p-6 space-y-6">
            <div>
                {{ form_label(form.titre) }}
                {{ form_widget(form.titre, {'attr': {'class': 'input w-full'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            <div>
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'textarea w-full'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.dateDebut) }}
                    {{ form_widget(form.dateDebut, {'attr': {'class': 'input w-full'}}) }}
                    {{ form_errors(form.dateDebut) }}
                </div>
                <div>
                    {{ form_label(form.dateFin) }}
                    {{ form_widget(form.dateFin, {'attr': {'class': 'input w-full'}}) }}
                    {{ form_errors(form.dateFin) }}
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.priorite) }}
                    {{ form_widget(form.priorite, {'attr': {'class': 'select w-full'}}) }}
                    {{ form_errors(form.priorite) }}
                </div>
                <div>
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'select w-full'}}) }}
                    {{ form_errors(form.statut) }}
                </div>
            </div>

            <div>
                {{ form_label(form.project) }}
                {{ form_widget(form.project, {'attr': {'class': 'select w-full'}}) }}
                {{ form_errors(form.project) }}
            </div>
        </div>

        <div class="flex items-center justify-between mt-6">
            <button type="button" class="btn btn-danger btn-ghost" data-controller="modal" data-action="click->modal#open" data-modal-target-value="delete-modal">
                Supprimer la Tâche
            </button>
            <div class="flex gap-3">
                <a href="{{ path('app_assignments_show', { id: assignment.id }) }}" class="btn btn-ghost">Annuler</a>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </div>
    {{ form_end(form) }}
</div>

<!-- Modal suppression -->
{% include 'components/modal.html.twig' with {
    id: 'delete-modal',
    title: 'Supprimer la Tâche',
    content: 'Êtes-vous sûr de vouloir supprimer <strong>' ~ assignment.titre ~ '</strong> ? Cette action est irréversible.'
} %}
{% endblock %}