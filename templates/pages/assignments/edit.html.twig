{# templates/assignment/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Edit: {{ assignment.titre }}{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-secondary-600 dark:text-secondary-400">
            <li><a href="{{ path('app_assignments') }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">Tasks</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li><a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">{{ assignment.titre }}</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li class="text-secondary-900 dark:text-white">Edit</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Edit Task</h1>
        <p class="text-secondary-500 dark:text-secondary-400 mt-1">Update the task details</p>
    </div>

    <!-- Form -->
    {{ form_start(form, {'attr': {'class': 'card p-6', 'data-turbo': 'false'}}) }}
        <div class="space-y-6">
            <!-- Titre -->
            <div>
                {{ form_label(form.titre, 'Task Title', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'input w-full'}}) }}
                {% if form.titre.vars.errors|length %}
                    <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                        {{ form_errors(form.titre) }}
                    </div>
                {% endif %}
            </div>

            <!-- Projet -->
            <div>
                {{ form_label(form.project, 'Associated Project', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.project, {'attr': {'class': 'select w-full'}}) }}
                {% if form.project.vars.errors|length %}
                    <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                        {{ form_errors(form.project) }}
                    </div>
                {% endif %}
            </div>

            <!-- Date de début et Date de fin -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.dateDebut, 'Start Date', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.dateDebut, {'attr': {'class': 'input w-full', 'type': 'date'}}) }}
                    {% if form.dateDebut.vars.errors|length %}
                        <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                            {{ form_errors(form.dateDebut) }}
                        </div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(form.dateFin, 'Due Date', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.dateFin, {'attr': {'class': 'input w-full', 'type': 'date'}}) }}
                    {% if form.dateFin.vars.errors|length %}
                        <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                            {{ form_errors(form.dateFin) }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Priorité et Statut -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.priorite, 'Priority', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.priorite, {'attr': {'class': 'select w-full'}}) }}
                    {% if form.priorite.vars.errors|length %}
                        <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                            {{ form_errors(form.priorite) }}
                        </div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(form.statut, 'Status', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'select w-full'}}) }}
                    {% if form.statut.vars.errors|length %}
                        <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                            {{ form_errors(form.statut) }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Description -->
            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'textarea w-full', 'rows': '4'}}) }}
                {% if form.description.vars.errors|length %}
                    <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                        {{ form_errors(form.description) }}
                    </div>
                {% endif %}
            </div>

            {% if assignment.updatedAt %}
                <div class="alert alert-info">
                    <i data-lucide="info" class="w-4 h-4"></i>
                    Last modified: {{ assignment.updatedAt|date('d/m/Y à H:i') }}
                </div>
            {% endif %}

            <!-- Actions -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-700">
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                    Delete
                </button>
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_assignments_show', { id: assignment.id }) }}" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i data-lucide="check" class="w-5 h-5"></i>
                        Save
                    </button>
                </div>
            </div>
        </div>
    {{ form_end(form) }}
</div>

<!-- Delete Confirmation Modal -->
<div class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" id="delete-modal">
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-2xl max-w-sm w-full p-6 border border-slate-200 dark:border-slate-800 z-10">
        <div class="flex items-center justify-center w-12 h-12 mx-auto bg-danger-100 dark:bg-danger-900/30 rounded-full mb-4">
            <i data-lucide="alert-triangle" class="w-6 h-6 text-danger-600 dark:text-danger-400"></i>
        </div>
        <h3 class="text-lg font-semibold text-secondary-900 dark:text-white text-center mb-2">Delete Task?</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 text-center mb-6">
            Are you sure you want to delete <strong>{{ assignment.titre }}</strong>? This action cannot be undone.
        </p>
        <div class="flex flex-col-reverse sm:flex-row gap-3">
            <button type="button" class="btn btn-secondary flex-1" onclick="closeModal()">Cancel</button>
            <form action="{{ path('app_assignments_delete', { id: assignment.id }) }}" method="POST" class="flex-1" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
                <button type="submit" class="btn btn-danger w-full">Delete</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  // Define functions in global scope immediately
  window.confirmDelete = function() {
    console.log('Delete button clicked');
    const modal = document.getElementById('delete-modal');
    console.log('Modal element:', modal);
    
    if (modal) {
      modal.classList.remove('hidden');
      console.log('Modal classList after remove hidden:', modal.classList.value);
      console.log('Modal display style:', window.getComputedStyle(modal).display);
      
      // Reinitialize icons in the modal
      setTimeout(() => {
        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
          console.log('Icons reinitialized');
        }
      }, 10);
    } else {
      console.error('❌ Modal not found!');
    }
  };
  
  window.closeModal = function() {
    console.log('Closing modal');
    const modal = document.getElementById('delete-modal');
    if (modal) {
      modal.classList.add('hidden');
      console.log('Modal hidden');
    }
  };
  
  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    console.log('✅ Edit page initialized');
    
    // Initialize icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    
    // Close modal with ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        window.closeModal();
      }
    });
  });
</script>
{% endblock %}