        if (typeof lucide !== 'undefined') {
          lucide.createIcons();
          console.log('✅ Icons reinitialized');
        }
      }, 10);
    } else {
      console.error('❌ Modal not found!');
    }
  }
  
  // Function to close modal
  function closeDeleteModal() {
    console.log('🔒 Closing modal');
    const modal = document.getElementById('delete-modal');
    if (modal) {
      modal.classList.add('hidden');
      console.log('✅ Modal closed');
    }
  }
  
  // Initialize when DOM is ready
  function initDeleteModal() {
    console.log('🔧 Initializing delete modal...');
    
    // Get elements
    const deleteBtn = document.getElementById('delete-btn');
    const cancelBtn = document.getElementById('cancel-btn');
    const modalBackdrop = document.getElementById('modal-backdrop');
    
    console.log('Delete button:', deleteBtn);
    console.log('Cancel button:', cancelBtn);
    console.log('Backdrop:', modalBackdrop);
    
    // Attach event listeners
    if (deleteBtn) {
      deleteBtn.addEventListener('click', function(e) {
        e.preventDefault();
        console.log('🖱️ Delete button click event fired');
        showDeleteModal();
      });
      console.log('✅ Delete button listener attached');
    } else {
      console.error('❌ Delete button not found!');
    }
    
    if (cancelBtn) {
      cancelBtn.addEventListener('click', closeDeleteModal);
      console.log('✅ Cancel button listener attached');
    }
    
    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', closeDeleteModal);
      console.log('✅ Backdrop listener attached');
    }
    
    // ESC key to close
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeDeleteModal();
      }
    });
    console.log('✅ ESC key listener attached');
    
    // Initialize icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
      console.log('✅ Icons initialized');
    }
    
    console.log('✅ Delete modal fully initialized');
  }
  
  // Run initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDeleteModal);
  } else {
    initDeleteModal();
  }
})();
</script>
