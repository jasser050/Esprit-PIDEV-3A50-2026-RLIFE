{% extends 'base.html.twig' %}

{% block title %}New Assignment{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Assignments', href: path('app_assignments') },
            { label: 'New Assignment' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'New Assignment',
        subtitle: 'Add a new assignment to track'
    } %}

    <form action="{{ path('app_assignments_new') }}" method="POST" class="card p-6">
        <div class="space-y-6">
            <!-- Title -->
            {% include 'components/input.html.twig' with {
                name: 'title',
                label: 'Assignment Title',
                placeholder: 'e.g., Binary Tree Implementation',
                required: true
            } %}

            <!-- Course Selection -->
            {% include 'components/select.html.twig' with {
                name: 'course_id',
                label: 'Course',
                value: preselected_course_id|default(''),
                required: true,
                options: courses|map(c => { value: c.id, label: c.name ~ ' (' ~ c.code ~ ')' })
            } %}

            <!-- Due Date -->
            {% include 'components/input.html.twig' with {
                name: 'due_date',
                label: 'Due Date',
                type: 'date',
                required: true
            } %}

            <!-- Priority -->
            {% include 'components/select.html.twig' with {
                name: 'priority',
                label: 'Priority',
                options: [
                    { value: 'high', label: 'High Priority' },
                    { value: 'medium', label: 'Medium Priority' },
                    { value: 'low', label: 'Low Priority' }
                ]
            } %}

            <!-- Description -->
            {% include 'components/textarea.html.twig' with {
                name: 'description',
                label: 'Description',
                placeholder: 'Describe the assignment requirements...',
                rows: 4
            } %}

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-light-border dark:border-dark-border">
                <a href="{{ path('app_assignments') }}" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Create Assignment
                </button>
            </div>
        </div>
    </form>
</div>
{% endblock %}
