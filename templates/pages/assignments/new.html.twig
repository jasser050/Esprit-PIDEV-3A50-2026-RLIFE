{# templates/assignment/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}New Task{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-secondary-600 dark:text-secondary-400">
            <li><a href="{{ path('app_assignments') }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">Tasks</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li class="text-secondary-900 dark:text-white">New task</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">New Task</h1>
        <p class="text-secondary-500 dark:text-secondary-400 mt-1">Add a new task to track</p>
    </div>

    <!-- Form -->
    {{ form_start(form, {'attr': {'class': 'card p-6'}}) }}
        <div class="space-y-6">
            <!-- Title -->
            <div>
                {{ form_label(form.titre, 'Task Title', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'input w-full', 'placeholder': 'e.g., Write final report'}}) }}
                {% if form.titre.vars.errors|length > 0 %}
                    <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                        {% for error in form.titre.vars.errors %}
                            <p>{{ error.message }}</p>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <!-- Description -->
            <div>
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'textarea w-full', 'rows': '4', 'placeholder': 'Provide a detailed description of the task...'}}) }}
            </div>

            <!-- Project -->
            <div>
                {{ form_label(form.project, 'Project', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.project, {'attr': {'class': 'input w-full'}}) }}
            </div>

            <!-- Dates -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.dateDebut, 'Start Date', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.dateDebut, {'attr': {'class': 'input w-full'}}) }}
                </div>
                <div>
                    {{ form_label(form.dateFin, 'Due Date', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.dateFin, {'attr': {'class': 'input w-full'}}) }}
                </div>
            </div>

            <!-- Priority & Status -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.priorite, 'Priority', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.priorite, {'attr': {'class': 'input w-full'}}) }}
                </div>
                <div>
                    {{ form_label(form.statut, 'Status', {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'input w-full'}}) }}
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-slate-200 dark:border-slate-700">
                <a href="{{ path('app_assignments') }}" class="btn btn-secondary inline-flex items-center justify-center gap-2 w-full sm:w-auto order-2 sm:order-1">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                    Back to List
                </a>
                <button type="submit" class="btn btn-primary inline-flex items-center justify-center gap-2 w-full sm:w-auto order-1 sm:order-2">
                    <i data-lucide="save" class="w-5 h-5"></i>
                    Create Task
                </button>
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
