<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ assignment.titre }}</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            color: #333;
            line-height: 1.6;
        }
        .header {
            background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
            color: white;
            padding: 25px;
            margin: -20px -20px 30px -20px;
        }
        .header h1 {
            margin: 0 0 10px 0;
            font-size: 26px;
        }
        .header .meta {
            font-size: 11px;
            opacity: 0.9;
        }
        
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: bold;
            margin-left: 10px;
        }
        .badge-primary { background-color: #4f46e5; color: white; }
        .badge-success { background-color: #22c55e; color: white; }
        .badge-warning { background-color: #f59e0b; color: white; }
        .badge-danger { background-color: #ef4444; color: white; }
        
        .priority-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
            margin-left: 10px;
        }
        .priority-haute {
            background-color: #fee2e2;
            color: #b91c1c;
            border: 2px solid #ef4444;
        }
        .priority-moyenne {
            background-color: #fef3c7;
            color: #92400e;
            border: 2px solid #f59e0b;
        }
        .priority-basse {
            background-color: #dbeafe;
            color: #1e40af;
            border: 2px solid #3b82f6;
        }
        
        .stats-grid {
            display: table;
            width: 100%;
            margin-bottom: 25px;
            border-collapse: collapse;
        }
        .stat-box {
            display: table-cell;
            width: 25%;
            text-align: center;
            padding: 20px;
            background: #f8f9fa;
            border: 1px solid #e5e7eb;
        }
        .stat-box .icon {
            font-size: 30px;
            margin-bottom: 10px;
        }
        .stat-box .value {
            font-size: 22px;
            font-weight: bold;
            color: #4f46e5;
            display: block;
            margin-bottom: 5px;
        }
        .stat-box .label {
            color: #666;
            font-size: 10px;
        }
        
        .section {
            margin-bottom: 25px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 5px;
            padding: 20px;
        }
        .section-title {
            font-size: 16px;
            font-weight: bold;
            color: #4f46e5;
            margin: 0 0 15px 0;
            padding-bottom: 10px;
            border-bottom: 2px solid #4f46e5;
        }
        .info-row {
            margin-bottom: 15px;
            padding: 10px 0;
            border-bottom: 1px solid #f3f4f6;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            color: #666;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 3px;
        }
        .info-value {
            font-size: 13px;
            font-weight: bold;
        }
        
        .progress-bar {
            background-color: #e5e7eb;
            height: 8px;
            border-radius: 4px;
            overflow: hidden;
            margin: 15px 0;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #4f46e5 0%, #3730a3 100%);
            transition: width 0.3s ease-in-out;
        }
        .progress-text {
            text-align: right;
            font-size: 11px;
            color: #666;
        }
        
        .alert {
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 15px;
            font-size: 12px;
            line-height: 1.5;
        }
        .alert-success {
            background-color: #f0fdf4;
            color: #15803d;
            border-left: 4px solid #22c55e;
        }
        .alert-danger {
            background-color: #fef2f2;
            color: #b91c1c;
            border-left: 4px solid #ef4444;
        }
        .alert-warning {
            background-color: #fefce8;
            color: #854d0e;
            border-left: 4px solid #f59e0b;
        }
        .alert-info {
            background-color: #eff6ff;
            color: #1e40af;
            border-left: 4px solid #3b82f6;
        }
        
        .timeline {
            position: relative;
            padding-left: 30px;
        }
        .timeline:before {
            content: '';
            position: absolute;
            left: 8px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #e5e7eb;
        }
        .timeline-item {
            position: relative;
            margin-bottom: 25px;
        }
        .timeline-marker {
            position: absolute;
            left: -22px;
            top: 5px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #4f46e5;
            border: 3px solid white;
        }
        .timeline-marker.success {
            background: #22c55e;
        }
        .timeline-marker.warning {
            background: #f59e0b;
        }
        .timeline-marker.danger {
            background: #ef4444;
        }
        .timeline-content .title {
            font-weight: bold;
            font-size: 13px;
            margin-bottom: 3px;
        }
        .timeline-content .date {
            color: #666;
            font-size: 11px;
        }
        
        .footer {
            text-align: center;
            font-size: 10px;
            color: #666;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #e5e7eb;
        }
    </style>
</head>
<body>
    {# Header #}
    <div class="header">
        <h1>{{ assignment.titre }}</h1>
        <div class="meta">
            Priorité : 
            {% if assignment.priorite == 'Haute' %}
                <span class="priority-badge priority-haute">Haute</span>
            {% elseif assignment.priorite == 'Moyenne' %}
                <span class="priority-badge priority-moyenne">Moyenne</span>
            {% else %}
                <span class="priority-badge priority-basse">Basse</span>
            {% endif %}
            
            {% if assignment.statut == 'En cours' %}
                <span class="badge badge-primary">{{ assignment.statut }}</span>
            {% elseif assignment.statut == 'Terminé' %}
                <span class="badge badge-success">{{ assignment.statut }}</span>
            {% else %}
                <span class="badge badge-warning">{{ assignment.statut }}</span>
            {% endif %}
        </div>
    </div>

    {# Description #}
    <div class="section">
        <h2 class="section-title">📝 Description</h2>
        <p>{{ assignment.description|nl2br }}</p>
    </div>

    {# Progress #}
    <div class="section">
        <h2 class="section-title">📊 Progression</h2>
        <div class="progress-bar">
            <div class="progress-fill" style="width: {{ assignmentStats.pourcentageTemps|default(0) }}%"></div>
        </div>
        <p class="progress-text">{{ assignmentStats.pourcentageTemps|default(0) }}% du temps écoulé</p>
    </div>

    {# Stats #}
    <div class="stats-grid">
        <div class="stat-box">
            <div class="icon">📅</div>
            <span class="value">{{ assignmentStats.dureeTotale|default('—') }}</span>
            <div class="label">Jours total</div>
        </div>
        <div class="stat-box">
            <div class="icon">⏳</div>
            <span class="value">{{ assignmentStats.tempsEcoule|default('—') }}</span>
            <div class="label">Jours écoulés</div>
        </div>
        <div class="stat-box">
            <div class="icon">⏰</div>
            <span class="value">{{ assignmentStats.joursRestants|default('—') }}</span>
            <div class="label">Jours restants</div>
        </div>
    </div>

    {# Détails #}
    <div class="section">
        <h2 class="section-title">🔍 Détails</h2>
        <div class="info-row">
            <div class="info-label">Date de début</div>
            <div class="info-value">{{ assignment.dateDebut|date('d/m/Y') }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Date de fin</div>
            <div class="info-value">{{ assignment.dateFin|date('d/m/Y') }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Créé le</div>
            <div class="info-value">{{ assignment.createdAt|date('d/m/Y H:i') }}</div>
        </div>
        {% if assignment.updatedAt %}
            <div class="info-row">
                <div class="info-label">Modifié le</div>
                <div class="info-value">{{ assignment.updatedAt|date('d/m/Y H:i') }}</div>
            </div>
        {% endif %}
    </div>

    {# Projet associé #}
    <div class="section">
        <h2 class="section-title">📁 Projet Associé</h2>
        <div class="info-row">
            <div class="info-label">Titre</div>
            <div class="info-value">{{ assignment.project.titre }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Description</div>
            <div class="info-value">{{ assignment.project.description }}</div>
        </div>
        <div class="info-row">
            <div class="info-label">Statut</div>
            <div class="info-value">
                {% if assignment.project.statut == 'En cours' %}
                    <span class="badge badge-primary">{{ assignment.project.statut }}</span>
                {% elseif assignment.project.statut == 'Terminé' %}
                    <span class="badge badge-success">{{ assignment.project.statut }}</span>
                {% else %}
                    <span class="badge badge-warning">{{ assignment.project.statut }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    {# Timeline #}
    <div class="section">
        <h2 class="section-title">⏱️ Timeline</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-marker"></div>
                <div class="timeline-content">
                    <div class="title">Début de la tâche</div>
                    <div class="date">{{ assignment.dateDebut|date('d/m/Y à H:i') }}</div>
                </div>
            </div>
            
            <div class="timeline-item">
                <div class="timeline-marker {% if 'now'|date('U') < assignment.dateFin|date('U') %}warning{% else %}danger{% endif %}"></div>
                <div class="timeline-content">
                    <div class="title">Aujourd'hui</div>
                    <div class="date">{{ 'now'|date('d/m/Y à H:i') }}</div>
                </div>
            </div>
            
            <div class="timeline-item">
                <div class="timeline-marker {% if 'now'|date('U') > assignment.dateFin|date('U') %}danger{% elseif assignment.statut == 'Terminé' %}success{% else %}{% endif %}"></div>
                <div class="timeline-content">
                    <div class="title">Échéance</div>
                    <div class="date">{{ assignment.dateFin|date('d/m/Y à H:i') }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Recommandations – sans date_diff #}
    <div class="section">
        <h2 class="section-title">💡 Recommandations</h2>
        
        {# Calcul manuel de la différence en jours #}
        {% set diff_seconds = assignment.dateFin|date('U') - 'now'|date('U') %}
        {% set remaining_days = (diff_seconds / 86400)|round(0, 'floor') %}
        {% set is_overdue = remaining_days < 0 %}
        {% set progress = assignmentStats.pourcentageTemps|default(0) %}
        
        {% if assignment.statut == 'Terminé' %}
            <div class="alert alert-success">
                ✓ <strong>Bravo !</strong> Cette tâche a été complétée avec succès.
            </div>
        {% elseif is_overdue %}
            <div class="alert alert-danger">
                🚨 <strong>Action urgente requise :</strong> Cette tâche est en retard de {{ remaining_days|abs }} jour(s).
            </div>
        {% elseif progress >= 75 %}
            <div class="alert alert-warning">
                ⏰ <strong>Attention au délai :</strong> Il ne reste que {{ remaining_days }} jour(s) pour terminer cette tâche.
            </div>
        {% else %}
            <div class="alert alert-info">
                ℹ️ <strong>Tout va bien :</strong> Vous êtes dans les temps. Continuez sur cette lancée !
            </div>
        {% endif %}
        
        {% if assignment.priorite == 'Haute' %}
            <div class="alert alert-warning" style="margin-top: 10px;">
                ⚠️ <strong>Priorité haute :</strong> Cette tâche nécessite une attention particulière et doit être traitée en priorité.
            </div>
        {% endif %}
    </div>

    <div class="footer">
        Document généré le {{ generatedAt|date('d/m/Y à H:i') }}<br>
        © {{ 'now'|date('Y') }} - Système de Gestion de Tâches
    </div>
</body>
</html>