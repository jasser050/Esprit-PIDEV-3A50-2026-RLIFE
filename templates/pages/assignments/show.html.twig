{# templates/assignment/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ assignment.titre }}{% endblock %}

{% block body %}
<div class="space-y-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-secondary-600 dark:text-secondary-400">
            <li><a href="{{ path('app_assignments') }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">Tâches</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li class="text-secondary-900 dark:text-white">{{ assignment.titre }}</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <h1 class="text-2xl font-bold">{{ assignment.titre }}</h1>
                <span class="badge badge-{{ assignment.priorite == 'Haute' ? 'danger' : (assignment.priorite == 'Moyenne' ? 'warning' : 'info') }}">
                    {{ assignment.priorite }} priorité
                </span>
                <span class="badge badge-{{ assignment.statut == 'Terminé' ? 'success' : (assignment.statut == 'En cours' ? 'primary' : 'warning') }}">
                    {{ assignment.statut }}
                </span>
            </div>
            <p class="text-light-muted dark:text-dark-muted">
                Projet : {{ assignment.project.titre }}
            </p>
        </div>
        <a href="{{ path('app_assignments_edit', { id: assignment.id }) }}" class="btn btn-secondary">
            <i data-lucide="edit-2" class="w-5 h-5"></i>
            Modifier
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <!-- Description -->
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Description</h2>
                {% if assignment.description %}
                    <p class="text-secondary-600 dark:text-secondary-400 whitespace-pre-wrap">{{ assignment.description|nl2br }}</p>
                {% else %}
                    <p class="text-secondary-500 italic">Aucune description</p>
                {% endif %}
            </div>

            <!-- Commentaires en temps réel -->
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-6">
                    Commentaires ({{ comments|length }})
                </h2>

                <!-- Formulaire nouveau commentaire -->
                {{ form_start(commentForm, {'attr': {'class': 'mb-8'}}) }}
                    <div class="space-y-4">
                        {{ form_widget(commentForm.content, {'attr': {'class': 'textarea w-full', 'rows': 4, 'placeholder': 'Ajouter un commentaire...'}}) }}
                        {{ form_errors(commentForm.content) }}
                        <div class="flex justify-end">
                            <button type="submit" class="btn btn-primary">
                                <i data-lucide="send" class="w-5 h-5 mr-2"></i>
                                Publier
                            </button>
                        </div>
                    </div>
                {{ form_end(commentForm) }}

                <!-- Liste des commentaires -->
                <div id="comments-list" class="space-y-4">
                    {% for comment in comments %}
                        <div id="comment-{{ comment.id }}" class="flex gap-4 p-4 bg-slate-50 dark:bg-slate-800/40 rounded-xl">
                            <div class="flex-shrink-0">
                                <div class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                                    <span class="text-primary-600 dark:text-primary-400 font-semibold text-sm">
                                        {{ comment.user.email|slice(0,2)|upper }}
                                    </span>
                                </div>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-2">
                                    <p class="font-medium">{{ comment.user.email }}</p>
                                    <p class="text-xs text-secondary-500">{{ comment.createdAt|date('d/m/Y H:i') }}</p>
                                </div>
                                <p class="text-secondary-700 dark:text-secondary-300 whitespace-pre-wrap">{{ comment.content|nl2br }}</p>
                                {% if comment.user == app.user %}
                                    <form method="post" action="{{ path('app_collaboration_delete_comment', {'id': comment.id}) }}" class="inline mt-3">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-comment' ~ comment.id) }}">
                                        <button type="submit" class="text-sm text-danger-600 hover:text-danger-800">
                                            <i data-lucide="trash-2" class="w-4 h-4 mr-1"></i> Supprimer
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p class="text-center text-secondary-500 py-8">Aucun commentaire. Soyez le premier à commenter !</p>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Détails</h2>
                <dl class="space-y-4 text-sm">
                    <div>
                        <dt class="text-light-muted dark:text-dark-muted">Date de début</dt>
                        <dd class="font-medium">{{ assignment.dateDebut ? assignment.dateDebut|date('d/m/Y') : 'Non définie' }}</dd>
                    </div>
                    <div>
                        <dt class="text-light-muted dark:text-dark-muted">Date de fin</dt>
                        <dd class="font-medium">{{ assignment.dateFin ? assignment.dateFin|date('d/m/Y') : 'Non définie' }}</dd>
                    </div>
                    <div>
                        <dt class="text-light-muted dark:text-dark-muted">Créé le</dt>
                        <dd class="font-medium">{{ assignment.createdAt|date('d/m/Y à H:i') }}</dd>
                    </div>
                    {% if assignment.updatedAt %}
                        <div>
                            <dt class="text-light-muted dark:text-dark-muted">Modifié le</dt>
                            <dd class="font-medium">{{ assignment.updatedAt|date('d/m/Y à H:i') }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>

            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Actions Rapides</h2>
                <div class="space-y-3">
                    <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" class="w-full btn btn-secondary justify-start">
                        <i data-lucide="edit-2" class="w-5 h-5 mr-2"></i>
                        Modifier
                    </a>
                    <a href="{{ path('app_assignments_export_single_pdf', {'id': assignment.id}) }}" class="w-full btn btn-secondary justify-start">
                        <i data-lucide="file-down" class="w-5 h-5 mr-2"></i>
                        Télécharger PDF
                    </a>
                    <hr class="my-4 border-light-border dark:border-dark-border">
                    <a href="{{ path('app_assignments') }}" class="w-full btn btn-ghost justify-start">
                        <i data-lucide="arrow-left" class="w-5 h-5 mr-2"></i>
                        Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pusher pour commentaires en temps réel -->
<script src="https://js.pusher.com/8.4/pusher.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const pusher = new Pusher('{{ pusher_app_key }}', {
            cluster: '{{ pusher_app_cluster }}',
            forceTLS: true
        });

        const channel = pusher.subscribe('comments-channel-{{ assignment.id }}');

        channel.bind('new-comment', function(data) {
            const list = document.getElementById('comments-list');
            const div = document.createElement('div');
            div.id = 'comment-' + data.comment_id;
            div.className = 'flex gap-4 p-4 bg-slate-50 dark:bg-slate-800/40 rounded-xl';
            div.innerHTML = `
                <div class="flex-shrink-0">
                    <div class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                        <span class="text-primary-600 dark:text-primary-400 font-semibold text-sm">
                            ${data.author.slice(0,2).toUpperCase()}
                        </span>
                    </div>
                </div>
                <div class="flex-1">
                    <div class="flex items-center justify-between mb-2">
                        <p class="font-medium">${data.author}</p>
                        <p class="text-xs text-secondary-500">${data.created_at}</p>
                    </div>
                    <p class="text-secondary-700 dark:text-secondary-300 whitespace-pre-wrap">${data.content.replace(/\\n/g, '<br>')}</p>
                </div>
            `;
            list.prepend(div);
        });

        channel.bind('comment-deleted', function(data) {
            const comment = document.getElementById('comment-' + data.comment_id);
            if (comment) comment.remove();
        });
    });
</script>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
    lucide.createIcons();
</script>
{% endblock %}