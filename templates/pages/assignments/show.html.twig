{# templates/assignment/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ assignment.titre }}{% endblock %}

{% block body %}
<div class="space-y-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-secondary-600 dark:text-secondary-400">
            <li><a href="{{ path('app_assignments') }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">Tasks</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li class="text-secondary-900 dark:text-white">{{ assignment.titre }}</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <h1 class="text-2xl font-bold">{{ assignment.titre }}</h1>
                <span class="badge badge-{{ assignment.priorite == 'Haute' ? 'danger' : (assignment.priorite == 'Moyenne' ? 'warning' : 'info') }}">
                    {% if assignment.priorite == 'Haute' %}High
                    {% elseif assignment.priorite == 'Moyenne' %}Medium
                    {% else %}Low{% endif %}
                    priority
                </span>
                <span class="badge badge-{{ assignment.statut == 'Terminé' ? 'success' : (assignment.statut == 'En cours' ? 'primary' : 'warning') }}">
                    {% if assignment.statut == 'En cours' %}In Progress
                    {% elseif assignment.statut == 'Terminé' %}Completed
                    {% elseif assignment.statut == 'À faire' %}To Do
                    {% else %}{{ assignment.statut }}{% endif %}
                </span>
            </div>
            <p class="text-light-muted dark:text-dark-muted">
                {{ assignment.project.titre }}
            </p>
        </div>
        <a href="{{ path('app_assignments_edit', { id: assignment.id }) }}" class="btn btn-secondary">
            <i data-lucide="edit-2" class="w-5 h-5"></i>
            Edit
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <!-- Description -->
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Description</h2>
                <p class="text-light-muted dark:text-dark-muted leading-relaxed">{{ assignment.description|nl2br }}</p>
            </div>

            <!-- Progress -->
            <div class="card p-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-semibold">Progress</h2>
                    <span class="text-sm font-medium text-secondary-500 dark:text-secondary-400">{{ assignmentStats.pourcentageTemps }}%</span>
                </div>
                <div class="h-3 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-primary-500 to-primary-600 rounded-full transition-all duration-500" style="width: {{ assignmentStats.pourcentageTemps }}%"></div>
                </div>
                <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-2">
                    {% if assignmentStats.joursRestants > 0 %}
                        {{ assignmentStats.joursRestants }} day(s) remaining
                    {% elseif assignmentStats.joursRestants == 0 %}
                        Due today
                    {% else %}
                        Overdue by {{ assignmentStats.joursRestants|abs }} day(s)
                    {% endif %}
                </p>
            </div>

            <!-- Timeline -->
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Timeline</h2>
                <div class="space-y-4">
                    <div class="flex gap-4">
                        <div class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full bg-success/10 flex items-center justify-center">
                                <i data-lucide="play" class="w-5 h-5 text-success"></i>
                            </div>
                            <div class="w-0.5 h-full bg-slate-200 dark:bg-slate-700 mt-2"></div>
                        </div>
                        <div class="pt-2">
                            <p class="text-sm font-medium">Started</p>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400">{{ assignment.dateDebut|date('d/m/Y') }}</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="flex flex-col items-center">
                            <div class="w-10 h-10 rounded-full {% if assignment.statut == 'Terminé' %}bg-success/10{% else %}bg-slate-100 dark:bg-slate-800{% endif %} flex items-center justify-center">
                                <i data-lucide="flag" class="w-5 h-5 {% if assignment.statut == 'Terminé' %}text-success{% else %}text-slate-400{% endif %}"></i>
                            </div>
                        </div>
                        <div class="pt-2">
                            <p class="text-sm font-medium">Due Date</p>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400">{{ assignment.dateFin|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Stats -->
            <div class="card p-6">
                <h3 class="font-semibold mb-4">Details</h3>
                <dl class="space-y-3">
                    <div class="flex justify-between">
                        <dt class="text-sm text-secondary-500 dark:text-secondary-400">Total Duration (days)</dt>
                        <dd class="text-sm font-medium">{{ assignmentStats.dureeTotale }} days</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm text-secondary-500 dark:text-secondary-400">Time Elapsed (days)</dt>
                        <dd class="text-sm font-medium">{{ assignmentStats.tempsEcoule }} days</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm text-secondary-500 dark:text-secondary-400">Status</dt>
                        <dd class="text-sm font-medium">
                            {% if assignment.statut == 'En cours' %}In Progress
                            {% elseif assignment.statut == 'Terminé' %}Completed
                            {% elseif assignment.statut == 'À faire' %}To Do
                            {% else %}{{ assignment.statut }}{% endif %}
                        </dd>
                    </div>
                </dl>
            </div>

            <!-- Project Info -->
            {% if assignment.project %}
                <div class="card p-6">
                    <h3 class="font-semibold mb-4">Associated Project</h3>
                    <a href="{{ path('app_project_show', {'id': assignment.project.id}) }}" class="block p-4 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-primary-500 dark:hover:border-primary-500 transition-colors">
                        <div class="flex items-center justify-between mb-2">
                            <span class="font-medium">{{ assignment.project.titre }}</span>
                            <span class="badge badge-{{ assignment.project.statut == 'En cours' ? 'primary' : (assignment.project.statut == 'Terminé' ? 'success' : 'warning') }} badge-pill">
                                {% if assignment.project.statut == 'En cours' %}In Progress
                                {% elseif assignment.project.statut == 'Terminé' %}Completed
                                {% elseif assignment.project.statut == 'En attente' %}Pending
                                {% else %}{{ assignment.project.statut }}{% endif %}
                            </span>
                        </div>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400">
                            {{ assignment.project.dateDebut|date('d/m/Y') }} - {{ assignment.project.dateFin|date('d/m/Y') }}
                        </p>
                    </a>
                </div>
            {% endif %}

            <!-- Actions -->
            <div class="card p-6">
                <h3 class="font-semibold mb-4">Actions</h3>
                <div class="space-y-3">
                    <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" class="btn btn-secondary w-full justify-start">
                        <i data-lucide="edit" class="w-5 h-5"></i>
                        Edit Task
                    </a>
                    <a href="{{ path('app_assignments_export_single_pdf', {'id': assignment.id}) }}" class="btn btn-secondary w-full justify-start">
                        <i data-lucide="download" class="w-5 h-5"></i>
                        Export PDF
                    </a>
                    <form method="post" action="{{ path('app_assignments_delete', {'id': assignment.id}) }}" onsubmit="return confirm('Are you sure you want to delete this task?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
                        <button type="submit" class="btn btn-danger w-full justify-start">
                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                            Delete Task
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
