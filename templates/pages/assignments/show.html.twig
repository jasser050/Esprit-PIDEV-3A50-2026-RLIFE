{% extends 'base.html.twig' %}

{% block title %}{{ assignment.titre }}{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-sm">
        <ol class="flex items-center gap-2">
            <li><a href="{{ path('app_assignments') }}" class="text-primary hover:underline">Tâches</a></li>
            <li class="text-light-muted dark:text-dark-muted">/</li>
            <li class="text-light-muted dark:text-dark-muted">{{ assignment.titre }}</li>
        </ol>
    </nav>

    <!-- En-tête principal -->
    <div class="card p-6">
        <div class="flex items-start justify-between mb-6 gap-4">
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-2 flex-wrap">
                    <h1 class="text-3xl font-bold">{{ assignment.titre }}</h1>
                    <span class="badge 
                        {% if assignment.statut == 'Terminé' %}badge-success
                        {% elseif assignment.statut == 'En cours' %}badge-primary
                        {% elseif assignment.statut == 'À faire' %}badge-warning
                        {% else %}badge-danger{% endif %}">
                        {{ assignment.statut }}
                    </span>
                    <span class="badge 
                        {% if assignment.priorite == 'Haute' %}badge-danger
                        {% elseif assignment.priorite == 'Moyenne' %}badge-warning
                        {% else %}badge-success{% endif %}">
                        {{ assignment.priorite }}
                    </span>
                </div>

                <div class="text-light-muted dark:text-dark-muted">
                    Projet : 
                    <a href="{{ path('app_project_show', {id: assignment.project.id}) }}" class="text-primary hover:underline font-medium">
                        {{ assignment.project.titre }}
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-3 flex-shrink-0">
                <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" class="btn btn-ghost">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Modifier
                </a>

                <form method="post" action="{{ path('app_assignments_delete', {'id': assignment.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette tâche ?');" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
                    <button type="submit" class="btn btn-ghost text-danger">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Supprimer
                    </button>
                </form>
            </div>
        </div>

        <!-- Description -->
        <div class="mb-8">
            <h2 class="text-lg font-semibold mb-3">Description</h2>
            <div class="prose dark:prose-invert max-w-none text-light-muted dark:text-dark-muted">
                {{ assignment.description|nl2br }}
            </div>
        </div>

        <!-- Informations clés -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-light-surface dark:bg-dark-surface p-4 rounded-lg">
                <h3 class="text-sm font-medium text-light-muted dark:text-dark-muted mb-1">Date de début</h3>
                <div class="flex items-center gap-2 text-lg font-medium">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    {{ assignment.dateDebut|date('d/m/Y') }}
                </div>
            </div>

            <div class="bg-light-surface dark:bg-dark-surface p-4 rounded-lg">
                <h3 class="text-sm font-medium text-light-muted dark:text-dark-muted mb-1">Date de fin</h3>
                <div class="flex items-center gap-2 text-lg font-medium">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    {{ assignment.dateFin|date('d/m/Y') }}
                </div>
            </div>

            <div class="bg-light-surface dark:bg-dark-surface p-4 rounded-lg">
                <h3 class="text-sm font-medium text-light-muted dark:text-dark-muted mb-1">Créée le</h3>
                <div class="text-lg font-medium">
                    {{ assignment.createdAt|date('d/m/Y H:i') }}
                </div>
            </div>
        </div>

        {% if assignment.updatedAt %}
            <p class="text-sm text-light-muted dark:text-dark-muted mt-4 text-center">
                Dernière modification : {{ assignment.updatedAt|date('d/m/Y H:i') }}
            </p>
        {% endif %}
    </div>
</div>
{% endblock %}