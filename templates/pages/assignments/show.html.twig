<script>
  lucide.createIcons();
  
  // Initialize Pusher for real-time comments
  const pusher = new Pusher('{{ app.request.server.get('PUSHER_KEY')|default('262d2d5c7812c0dd8417') }}', {
    cluster: '{{ app.request.server.get('PUSHER_CLUSTER')|default('eu') }}',
    forceTLS: true
  });

  const channel = pusher.subscribe('comments-channel-{{ assignment.id }}');

  channel.bind('new-comment', function(data) {
    const commentsList = document.getElementById('comments-list');
    const newComment = document.createElement('div');
    newComment.id = 'comment-' + data.comment_id;
    newComment.className = 'p-4 bg-light-background dark:bg-dark-background rounded-lg';
    newComment.innerHTML = `
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-start gap-3 flex-1">
          <div class="w-8 h-8 rounded-full bg-secondary-500 flex items-center justify-center text-white text-sm font-medium flex-shrink-0">
            ${data.author.charAt(0).toUpperCase()}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-medium text-sm">${data.author}</span>
              <span class="text-xs text-secondary-500">${data.created_at}</span>
            </div>
            <p class="text-sm text-secondary-700 dark:text-secondary-300 whitespace-pre-wrap">${data.content}</p>
          </div>
        </div>
      </div>
    `;
    
    // Remove "no comments" message if exists
    const noCommentsMsg = commentsList.querySelector('p.text-center');
    if (noCommentsMsg) {
      noCommentsMsg.remove();
    }
    
    commentsList.insertBefore(newComment, commentsList.firstChild);
    lucide.createIcons();
  });

  channel.bind('comment-deleted', function(data) {
    const comment = document.getElementById('comment-' + data.comment_id);
    if (comment) {
      comment.remove();
    }
  });
</script>
