{% extends 'base.html.twig' %}

{% block title %}Delete Task{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-sm">
        <ol class="flex items-center gap-2">
            <li><a href="{{ path('app_assignments') }}" class="text-primary-600 dark:text-primary-400 hover:underline">Tasks</a></li>
            <li class="text-slate-400 dark:text-slate-500">/</li>
            <li><a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="text-primary-600 dark:text-primary-400 hover:underline">{{ assignment.titre }}</a></li>
            <li class="text-slate-400 dark:text-slate-500">/</li>
            <li class="text-slate-500 dark:text-slate-400">Delete</li>
        </ol>
    </nav>

    <div class="card p-8">
        <div class="flex justify-center mb-6">
            <div class="w-16 h-16 rounded-full bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center">
                <svg class="w-8 h-8 text-danger-600 dark:text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
        </div>

        <h1 class="text-2xl font-bold text-center text-slate-900 dark:text-white mb-2">Delete Task</h1>
        <p class="text-center text-slate-500 dark:text-slate-400 mb-6">
            Are you sure you want to delete this task?
        </p>

        <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-4 mb-6">
            <div class="flex items-start justify-between mb-2">
                <h3 class="font-semibold text-lg text-slate-900 dark:text-white">{{ assignment.titre }}</h3>
                <span class="badge 
                    {% if assignment.statut == 'En cours' %}badge-primary
                    {% elseif assignment.statut == 'Terminé' %}badge-success
                    {% elseif assignment.statut == 'À faire' %}badge-warning
                    {% else %}badge-danger{% endif %}">
                    {{ assignment.statut }}
                </span>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">{{ assignment.description|slice(0, 120) }}...</p>
            <div class="text-xs text-slate-500 dark:text-slate-400">
                {{ assignment.dateDebut|date('d/m/Y') }} - {{ assignment.dateFin|date('d/m/Y') }}
                • Project: {{ assignment.project.titre }}
            </div>
        </div>

        <div class="bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-lg p-4 mb-6">
            <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-danger-600 dark:text-danger-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                <div>
                    <h4 class="font-semibold text-danger-600 dark:text-danger-400 mb-1">Irreversible Action</h4>
                    <p class="text-sm text-danger-700 dark:text-danger-300">
                        Deleting this task is permanent.
                    </p>
                </div>
            </div>
        </div>

        <form method="post" action="{{ path('app_assignments_delete', {'id': assignment.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">

            <div class="flex items-center justify-center gap-3">
                <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="btn btn-ghost">
                    No, Cancel
                </a>
                <button type="submit" class="btn btn-danger">
                    Yes, Delete Permanently
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}