{% extends 'base.html.twig' %}

{% block title %}Assigned Tasks{% endblock %}

{% block body %}
<div class="space-y-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">Tasks Assigned to Me</h1>
            <p class="text-light-muted dark:text-dark-muted">Tasks that have been assigned to you by other users</p>
        </div>
        <a href="{{ path('app_assignments') }}" class="btn btn-ghost">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
            My Tasks
        </a>
    </div>

    {% if assignments|length > 0 %}
        <div class="grid gap-4">
            {% for collab in assignments %}
                {% set assignment = collab.assignment %}
                <div class="card p-6 hover:shadow-lg transition-shadow">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                <h3 class="font-semibold text-lg">{{ assignment.titre }}</h3>
                                <span class="badge badge-{{ assignment.priorite == 'Haute' ? 'danger' : (assignment.priorite == 'Moyenne' ? 'warning' : 'info') }}">
                                    {{ assignment.priorite }}
                                </span>
                                <span class="badge badge-{{ assignment.statut == 'Terminé' ? 'success' : (assignment.statut == 'En cours' ? 'primary' : 'warning') }}">
                                    {{ assignment.statut }}
                                </span>
                            </div>
                            <p class="text-light-muted dark:text-dark-muted mb-3 line-clamp-2">{{ assignment.description }}</p>
                            
                            <div class="flex flex-wrap items-center gap-4 text-sm text-secondary-600 dark:text-secondary-400">
                                <span class="flex items-center gap-1">
                                    <i data-lucide="folder" class="w-4 h-4"></i>
                                    {{ assignment.project.titre }}
                                </span>
                                <span class="flex items-center gap-1">
                                    <i data-lucide="calendar" class="w-4 h-4"></i>
                                    Due: {{ assignment.dateFin|date('d/m/Y') }}
                                </span>
                                <span class="flex items-center gap-1">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                    Assigned by: {{ collab.assignedByUser.fullName }}
                                </span>
                            </div>
                        </div>
                        
                        <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="btn btn-secondary btn-sm">
                            View
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card p-12 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-light-background dark:bg-dark-background flex items-center justify-center">
                <i data-lucide="clipboard-list" class="w-8 h-8 text-secondary-400"></i>
            </div>
            <h3 class="text-lg font-semibold mb-2">No assigned tasks</h3>
            <p class="text-light-muted dark:text-dark-muted mb-4">You don't have any tasks assigned to you yet.</p>
            <a href="{{ path('app_assignments') }}" class="btn btn-primary">
                View My Tasks
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
</script>
{% endblock %}
