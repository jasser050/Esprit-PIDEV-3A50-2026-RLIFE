{# templates/pages/assignments/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Tâches{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Header + Bouton Nouvelle Tâche -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Tâches</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Suivez et gérez vos tâches</p>
        </div>
        <a href="{{ path('app_assignments_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Nouvelle Tâche
        </a>
    </div>

    <!-- Recherche + Filtres -->
    <div class="card p-5 shadow-sm">
        <form method="get" action="{{ path('app_assignments') }}" class="flex flex-col lg:flex-row lg:items-end gap-5 flex-wrap">
            <div class="flex-1 min-w-[300px] relative">
                <label for="search" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Rechercher une tâche</label>
                <div class="relative">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-secondary-400 pointer-events-none"></i>
                    <input type="text"
                           id="search"
                           name="search"
                           value="{{ search|default('') }}"
                           placeholder="Titre, description, mot-clé..."
                           class="input w-full pl-11 pr-4 py-2.5 text-base border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
                </div>
            </div>

            <div class="flex items-center gap-2.5 flex-wrap">
                <span class="text-sm font-medium text-secondary-500 dark:text-secondary-400 whitespace-nowrap">Priorité :</span>
                <button type="submit" name="priorite" value="" class="badge {{ priorite == '' ? 'badge-primary' : 'badge-outline' }}">Toutes</button>
                <button type="submit" name="priorite" value="Haute" class="badge badge-danger {{ priorite == 'Haute' ? 'badge-primary' : 'badge-outline' }}">Haute</button>
                <button type="submit" name="priorite" value="Moyenne" class="badge badge-warning {{ priorite == 'Moyenne' ? 'badge-primary' : 'badge-outline' }}">Moyenne</button>
                <button type="submit" name="priorite" value="Basse" class="badge badge-info {{ priorite == 'Basse' ? 'badge-primary' : 'badge-outline' }}">Basse</button>
            </div>

            <div class="flex items-center gap-2.5 flex-wrap">
                <span class="text-sm font-medium text-secondary-500 dark:text-secondary-400 whitespace-nowrap">Statut :</span>
                <button type="submit" name="statut" value="" class="badge {{ statut == '' ? 'badge-primary' : 'badge-outline' }}">Tous</button>
                <button type="submit" name="statut" value="À faire" class="badge {{ statut == 'À faire' ? 'badge-primary' : 'badge-outline' }}">À faire</button>
                <button type="submit" name="statut" value="En cours" class="badge {{ statut == 'En cours' ? 'badge-primary' : 'badge-outline' }}">En cours</button>
                <button type="submit" name="statut" value="Terminé" class="badge {{ statut == 'Terminé' ? 'badge-primary' : 'badge-outline' }}">Terminé</button>
            </div>

            <button type="submit" class="btn btn-primary">Filtrer</button>
        </form>
    </div>

    <!-- Liste des tâches (tableau style backlog avec en-tête bleu) -->
    {% if assignments|length > 0 %}
        <div class="card overflow-hidden shadow-xl">
            <div class="overflow-x-auto">
                <table class="table w-full">
                    <thead class="bg-blue-600 text-white">
                        <tr>
                            <th class="py-4 px-6 text-left font-bold">Tâche</th>
                            <th class="py-4 px-6 text-left font-bold">Projet</th>
                            <th class="py-4 px-6 text-left font-bold">Priorité</th>
                            <th class="py-4 px-6 text-left font-bold">Statut</th>
                            <th class="py-4 px-6 text-left font-bold">Date fin</th>
                            <th class="py-4 px-6 text-right font-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-light-border dark:divide-dark-border">
                        {% for assignment in assignments %}
                            <tr class="hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors">
                                <td class="py-5 px-6">
                                    <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="font-semibold text-lg hover:text-primary-600">
                                        {{ assignment.titre }}
                                    </a>
                                </td>
                                <td class="py-5 px-6 text-secondary-700 dark:text-secondary-300">
                                    {{ assignment.project.titre }}
                                </td>
                                <td class="py-5 px-6">
                                    <span class="badge badge-{{ assignment.priorite == 'Haute' ? 'danger' : (assignment.priorite == 'Moyenne' ? 'warning' : 'info') }}">
                                        {{ assignment.priorite }}
                                    </span>
                                </td>
                                <td class="py-5 px-6">
                                    <span class="badge badge-{{ assignment.statut == 'Terminé' ? 'success' : (assignment.statut == 'En cours' ? 'primary' : 'warning') }}">
                                        {{ assignment.statut }}
                                    </span>
                                </td>
                                <td class="py-5 px-6 text-secondary-700 dark:text-secondary-300">
                                    {{ assignment.dateFin ? assignment.dateFin|date('d/m/Y') : '-' }}
                                </td>
                                <td class="py-5 px-6 text-right space-x-4">
                                    <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="text-primary-600 hover:text-primary-800" title="Voir">
                                        <i data-lucide="eye" class="w-6 h-6"></i>
                                    </a>
                                    <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" class="text-warning-600 hover:text-warning-800" title="Modifier">
                                        <i data-lucide="edit-2" class="w-6 h-6"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="card p-12 text-center">
            <i data-lucide="list-checks" class="w-16 h-16 text-secondary-400 mx-auto mb-4"></i>
            <h3 class="text-xl font-semibold">Aucune tâche</h3>
            <p class="text-secondary-500 mt-2">Créez votre première tâche pour commencer !</p>
        </div>
    {% endif %}

    <!-- Statistiques et graphiques -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-12">
        <!-- Stats cartes -->
        <div class="space-y-6">
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Statistiques rapides</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-primary-600">{{ stats.total|default(0) }}</div>
                        <div class="text-sm text-secondary-500">Total</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-success-600">{{ stats.termines|default(0) }}</div>
                        <div class="text-sm text-secondary-500">Terminées</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-blue-600">{{ stats.enCours|default(0) }}</div>
                        <div class="text-sm text-secondary-500">En cours</div>
                    </div>
                    <div class="text-center">
                        <div class="text-3xl font-bold text-danger-600">{{ stats.enRetard|default(0) }}</div>
                        <div class="text-sm text-secondary-500">En retard</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Graphiques -->
        <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card p-6">
                <h3 class="text-lg font-semibold mb-4">Répartition par statut</h3>
                <canvas id="statutChart" height="200"></canvas>
            </div>
            <div class="card p-6">
                <h3 class="text-lg font-semibold mb-4">Répartition par priorité</h3>
                <canvas id="prioriteChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Graphique statut
    const statutCtx = document.getElementById('statutChart');
    if (statutCtx) {
        new Chart(statutCtx, {
            type: 'doughnut',
            data: {
                labels: ['À faire', 'En cours', 'Terminé'],
                datasets: [{
                    data: [{{ stats.aFaire|default(0) }}, {{ stats.enCours|default(0) }}, {{ stats.termines|default(0) }}],
                    backgroundColor: ['#f59e0b', '#3b82f6', '#10b981']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    }

    // Graphique priorité
    const prioriteCtx = document.getElementById('prioriteChart');
    if (prioriteCtx) {
        new Chart(prioriteCtx, {
            type: 'bar',
            data: {
                labels: ['Haute', 'Moyenne', 'Basse'],
                datasets: [{
                    label: 'Nombre',
                    data: [{{ stats.haute|default(0) }}, {{ stats.moyenne|default(0) }}, {{ stats.basse|default(0) }}],
                    backgroundColor: ['#ef4444', '#f59e0b', '#3b82f6']
                }]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } },
                plugins: { legend: { display: false } }
            }
        });
    }
</script>
{% endblock %}