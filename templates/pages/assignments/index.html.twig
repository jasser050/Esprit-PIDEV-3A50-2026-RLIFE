{# templates/pages/assignments/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Tasks{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- 1. Page Header (title + New button) -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Tasks</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Track and manage your tasks</p>
        </div>
        <a href="{{ path('app_assignments_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-5 h-5"></i>
            New Task
        </a>
    </div>

    <!-- 1. Search + Filters (at top after header) -->
    <div class="card p-5 shadow-sm">
        <form method="get" action="{{ path('app_assignments') }}" class="flex flex-col lg:flex-row lg:items-end gap-5 flex-wrap">
            <!-- Search -->
            <div class="flex-1 min-w-[300px] relative">
                <label for="search" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Search task</label>
                <div class="relative">
                    <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-secondary-400 pointer-events-none"></i>
                    <input type="text"
                           id="search"
                           name="search"
                           value="{{ search|default('') }}"
                           placeholder="Search by title or description..."
                           class="input w-full pl-11 pr-4 py-2.5 text-base border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
                </div>
            </div>

            <!-- Filters -->
            <div class="flex items-center gap-2.5 flex-wrap">
                <!-- Priority -->
                <div class="flex items-center gap-2">
                    <span class="text-sm font-medium text-secondary-500 dark:text-secondary-400 whitespace-nowrap">Priority:</span>
                    <select name="priorite" class="input py-2 px-3 text-sm border-slate-300 dark:border-slate-600 rounded-lg" onchange="this.form.submit()">
                        <option value="">All</option>
                        <option value="Haute" {{ priorite == 'Haute' ? 'selected' }}>High</option>
                        <option value="Moyenne" {{ priorite == 'Moyenne' ? 'selected' }}>Medium</option>
                        <option value="Basse" {{ priorite == 'Basse' ? 'selected' }}>Low</option>
                    </select>
                </div>

                <!-- Status -->
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-medium text-secondary-500 dark:text-secondary-400 whitespace-nowrap">Status:</span>
                    <button type="submit" name="statut" value="" class="badge {{ statut == '' ? 'badge-primary' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        All
                    </button>
                    <button type="submit" name="statut" value="À faire" class="badge {{ statut == 'À faire' ? 'badge-warning' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="circle" class="w-3.5 h-3.5"></i> To Do
                    </button>
                    <button type="submit" name="statut" value="En cours" class="badge {{ statut == 'En cours' ? 'badge-primary' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="loader" class="w-3.5 h-3.5"></i> In Progress
                    </button>
                    <button type="submit" name="statut" value="Terminé" class="badge {{ statut == 'Terminé' ? 'badge-success' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i> Completed
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- 2. Task Table -->
    <div class="card overflow-hidden">
        {% if assignments|length > 0 %}
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
                        <tr class="text-left text-xs font-semibold text-secondary-500 dark:text-secondary-400 uppercase tracking-wider">
                            <th class="px-4 py-3">
                                <a href="?sort=titre&direction={{ sort == 'titre' and direction == 'ASC' ? 'DESC' : 'ASC' }}&priorite={{ priorite }}&statut={{ statut }}&search={{ search }}" class="flex items-center gap-1 hover:text-primary-600 dark:hover:text-primary-400">
                                    Task
                                    {% if sort == 'titre' %}
                                        <i data-lucide="{{ direction == 'ASC' ? 'arrow-up' : 'arrow-down' }}" class="w-3 h-3"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3 hidden md:table-cell">Project</th>
                            <th class="px-4 py-3">
                                <a href="?sort=priorite&direction={{ sort == 'priorite' and direction == 'ASC' ? 'DESC' : 'ASC' }}&priorite={{ priorite }}&statut={{ statut }}&search={{ search }}" class="flex items-center gap-1 hover:text-primary-600 dark:hover:text-primary-400">
                                    Priority
                                    {% if sort == 'priorite' %}
                                        <i data-lucide="{{ direction == 'ASC' ? 'arrow-up' : 'arrow-down' }}" class="w-3 h-3"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3 hidden lg:table-cell">
                                <a href="?sort=dateFin&direction={{ sort == 'dateFin' and direction == 'ASC' ? 'DESC' : 'ASC' }}&priorite={{ priorite }}&statut={{ statut }}&search={{ search }}" class="flex items-center gap-1 hover:text-primary-600 dark:hover:text-primary-400">
                                    Due Date
                                    {% if sort == 'dateFin' %}
                                        <i data-lucide="{{ direction == 'ASC' ? 'arrow-up' : 'arrow-down' }}" class="w-3 h-3"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3">
                                <a href="?sort=statut&direction={{ sort == 'statut' and direction == 'ASC' ? 'DESC' : 'ASC' }}&priorite={{ priorite }}&statut={{ statut }}&search={{ search }}" class="flex items-center gap-1 hover:text-primary-600 dark:hover:text-primary-400">
                                    Status
                                    {% if sort == 'statut' %}
                                        <i data-lucide="{{ direction == 'ASC' ? 'arrow-up' : 'arrow-down' }}" class="w-3 h-3"></i>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                        {% for assignment in assignments %}
                            {% set today = "now"|date("Y-m-d") %}
                            {% set due = assignment.dateFin|date("Y-m-d") %}
                            {% set isOverdue = due < today and assignment.statut != 'Terminé' %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors {{ isOverdue ? 'bg-danger-50/30 dark:bg-danger-900/10' : '' }}">
                                <td class="px-4 py-4">
                                    <div class="flex flex-col">
                                        <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="font-medium text-secondary-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                                            {{ assignment.titre }}
                                        </a>
                                        {% if isOverdue %}
                                            <span class="text-xs text-danger-600 dark:text-danger-400 flex items-center gap-1 mt-1">
                                                <i data-lucide="alert-circle" class="w-3 h-3"></i>
                                                Overdue
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-4 py-4 hidden md:table-cell">
                                    <a href="{{ path('app_project_show', {'id': assignment.project.id}) }}" class="text-sm text-secondary-600 dark:text-secondary-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                                        {{ assignment.project.titre }}
                                    </a>
                                </td>
                                <td class="px-4 py-4">
                                    <span class="badge badge-{{ assignment.priorite == 'Haute' ? 'danger' : (assignment.priorite == 'Moyenne' ? 'warning' : 'info') }}">
                                        {% if assignment.priorite == 'Haute' %}High
                                        {% elseif assignment.priorite == 'Moyenne' %}Medium
                                        {% else %}Low{% endif %}
                                    </span>
                                </td>
                                <td class="px-4 py-4 hidden lg:table-cell">
                                    <span class="text-sm {{ isOverdue ? 'text-danger-600 dark:text-danger-400 font-medium' : 'text-secondary-600 dark:text-secondary-400' }}">
                                        {{ assignment.dateFin|date('d/m/Y') }}
                                    </span>
                                </td>
                                <td class="px-4 py-4">
                                    <span class="badge badge-{{ assignment.statut == 'Terminé' ? 'success' : (assignment.statut == 'En cours' ? 'primary' : 'warning') }} badge-pill">
                                        {% if assignment.statut == 'En cours' %}In Progress
                                        {% elseif assignment.statut == 'Terminé' %}Completed
                                        {% elseif assignment.statut == 'À faire' %}To Do
                                        {% else %}{{ assignment.statut }}{% endif %}
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="btn btn-ghost btn-sm p-2">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </a>
                                        <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" class="btn btn-ghost btn-sm p-2">
                                            <i data-lucide="edit" class="w-4 h-4"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_assignments_delete', {'id': assignment.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this task?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
                                            <button type="submit" class="btn btn-ghost btn-sm p-2 text-danger-600 dark:text-danger-400 hover:bg-danger-50 dark:hover:bg-danger-900/20">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-16">
                <div class="w-20 h-20 mx-auto bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-4">
                    <i data-lucide="clipboard-list" class="w-10 h-10 text-slate-400"></i>
                </div>
                <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-2">No tasks yet</h3>
                <p class="text-secondary-500 dark:text-secondary-400 mb-6 max-w-md mx-auto">
                    Create your first task to start organizing your work and track your progress.
                </p>
                <a href="{{ path('app_assignments_new') }}" class="btn btn-primary inline-flex items-center gap-2">
                    <i data-lucide="plus" class="w-5 h-5"></i>
                    Create New Task
                </a>
            </div>
        {% endif %}
    </div>

    <!-- 3. Statistics Section -->
    {% if stats and stats.total > 0 %}
        <div class="card p-6">
            <h2 class="text-lg font-semibold text-secondary-900 dark:text-white mb-6">Statistics</h2>
            
            <!-- Stats Cards -->
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.total }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Tasks</p>
                </div>
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-warning-600 dark:text-warning-400">{{ stats.aFaire }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">To Do</p>
                </div>
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-primary-600 dark:text-primary-400">{{ stats.enCours }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">In Progress</p>
                </div>
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-success-600 dark:text-success-400">{{ stats.termines }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Completed</p>
                </div>
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-danger-600 dark:text-danger-400">{{ stats.enRetard }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Overdue</p>
                </div>
            </div>

            <!-- Export Buttons -->
            <div class="flex flex-wrap gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                <a href="{{ path('app_assignments_export_pdf') }}" class="btn btn-secondary btn-sm">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    Export PDF
                </a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
