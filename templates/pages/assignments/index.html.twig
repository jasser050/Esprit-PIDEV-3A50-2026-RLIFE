{% extends 'base.html.twig' %}

{% block title %}Mes Tâches{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold mb-2">Mes Tâches</h1>
            <p class="text-light-muted dark:text-dark-muted">Gérez vos assignments par projet</p>
        </div>
        <a href="{{ path('app_assignments_new') }}" class="btn btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Nouvelle Tâche
        </a>
    </div>

    {% if assignments|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for assignment in assignments %}
                <div class="card p-6 hover:shadow-lg transition-shadow">
                    <!-- Header -->
                    <div class="flex items-start justify-between mb-4">
                        <h3 class="text-xl font-semibold">{{ assignment.titre }}</h3>
                        <span class="badge 
                            {% if assignment.statut == 'Terminé' %}badge-success
                            {% elseif assignment.statut == 'En cours' %}badge-primary
                            {% elseif assignment.statut == 'À faire' %}badge-warning
                            {% else %}badge-danger{% endif %}">
                            {{ assignment.statut }}
                        </span>
                    </div>

                    <!-- Description -->
                    <p class="text-light-muted dark:text-dark-muted mb-4 line-clamp-3">
                        {{ assignment.description }}
                    </p>

                    <!-- Infos -->
                    <div class="space-y-2 mb-6 text-sm">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-light-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <span>Projet : <a href="{{ path('app_project_show', {id: assignment.project.id}) }}" class="text-primary hover:underline">{{ assignment.project.titre }}</a></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-light-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <span>{{ assignment.dateDebut|date('d/m/Y') }} → {{ assignment.dateFin|date('d/m/Y') }}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-medium">Priorité :</span>
                            <span class="badge 
                                {% if assignment.priorite == 'Haute' %}badge-danger
                                {% elseif assignment.priorite == 'Moyenne' %}badge-warning
                                {% else %}badge-success{% endif %}">
                                {{ assignment.priorite }}
                            </span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex gap-2">
                        <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="btn btn-sm btn-ghost flex-1">Voir</a>
                        <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" class="btn btn-sm btn-ghost">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </a>
                        <form method="post" action="{{ path('app_assignments_delete', {'id': assignment.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette tâche ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.id) }}">
                            <button type="submit" class="btn btn-sm btn-ghost text-danger">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card p-12 text-center">
            <svg class="w-16 h-16 mx-auto mb-4 text-light-muted dark:text-dark-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <h3 class="text-xl font-semibold mb-2">Aucune tâche</h3>
            <p class="text-light-muted dark:text-dark-muted mb-6">Créez votre première tâche</p>
            <a href="{{ path('app_assignments_new') }}" class="btn btn-primary">
                Nouvelle Tâche
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}