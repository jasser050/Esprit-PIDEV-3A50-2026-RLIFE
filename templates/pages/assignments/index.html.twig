{% extends 'base.html.twig' %}

{% block title %}Mes Tâches{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-white to-primary-50/30 dark:from-slate-950 dark:via-slate-900 dark:to-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        {# En-tête #}
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
                    <span class="flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 text-white">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                    </span>
                    Mes Tâches
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-400">Gérez et organisez vos tâches efficacement</p>
            </div>
            <div class="mt-4 sm:mt-0 flex flex-wrap gap-3">
                <a href="{{ path('app_assignments_new') }}" class="btn btn-primary">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Nouvelle Tâche
                </a>
                <a href="{{ path('app_assignments_export_pdf', {priorite: priorite, statut: statut, search: search}) }}" class="btn btn-secondary">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                    </svg>
                    Exporter PDF
                </a>
            </div>
        </div>

        {# Statistiques #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
            <div class="card stat-card">
                <div class="stat-card-icon bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-700">
                    <svg class="w-6 h-6 text-slate-600 dark:text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                </div>
                <div class="stat-card-value">{{ stats.total }}</div>
                <div class="stat-card-label">Total</div>
            </div>

            <div class="card stat-card">
                <div class="stat-card-icon bg-gradient-to-br from-warning-100 to-warning-200 dark:from-warning-900/30 dark:to-warning-800/30">
                    <svg class="w-6 h-6 text-warning-600 dark:text-warning-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="stat-card-value text-warning-600 dark:text-warning-400">{{ stats.aFaire }}</div>
                <div class="stat-card-label">À faire</div>
            </div>

            <div class="card stat-card">
                <div class="stat-card-icon bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/30 dark:to-primary-800/30">
                    <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div class="stat-card-value text-primary-600 dark:text-primary-400">{{ stats.enCours }}</div>
                <div class="stat-card-label">En cours</div>
            </div>

            <div class="card stat-card">
                <div class="stat-card-icon bg-gradient-to-br from-success-100 to-success-200 dark:from-success-900/30 dark:to-success-800/30">
                    <svg class="w-6 h-6 text-success-600 dark:text-success-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="stat-card-value text-success-600 dark:text-success-400">{{ stats.termines }}</div>
                <div class="stat-card-label">Terminées</div>
            </div>

            <div class="card stat-card">
                <div class="stat-card-icon bg-gradient-to-br from-danger-100 to-danger-200 dark:from-danger-900/30 dark:to-danger-800/30">
                    <svg class="w-6 h-6 text-danger-600 dark:text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="stat-card-value text-danger-600 dark:text-danger-400">{{ stats.enRetard }}</div>
                <div class="stat-card-label">En retard</div>
            </div>
        </div>

        {# Graphiques #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <div class="card p-6">
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
                    </svg>
                    Répartition par Statut
                </h3>
                <div class="relative h-64">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>

            <div class="card p-6">
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Progression (8 dernières semaines)
                </h3>
                <div class="relative h-64">
                    <canvas id="progressionChart"></canvas>
                </div>
            </div>
        </div>

        {# Filtres #}
        <div class="card p-6 mb-6">
            <form method="get" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                    <div>
                        <label for="search" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Rechercher
                        </label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>
                            <input type="text" 
                                   id="search" 
                                   name="search" 
                                   value="{{ search }}" 
                                   placeholder="Titre ou description..."
                                   class="input pl-10">
                        </div>
                    </div>

                    <div>
                        <label for="statut" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Statut
                        </label>
                        <select id="statut" name="statut" class="select">
                            <option value="">Tous les statuts</option>
                            <option value="À faire" {% if statut == 'À faire' %}selected{% endif %}>À faire</option>
                            <option value="En cours" {% if statut == 'En cours' %}selected{% endif %}>En cours</option>
                            <option value="Terminé" {% if statut == 'Terminé' %}selected{% endif %}>Terminé</option>
                            <option value="Annulé" {% if statut == 'Annulé' %}selected{% endif %}>Annulé</option>
                        </select>
                    </div>

                    <div>
                        <label for="priorite" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Priorité
                        </label>
                        <select id="priorite" name="priorite" class="select">
                            <option value="">Toutes les priorités</option>
                            <option value="Haute" {% if priorite == 'Haute' %}selected{% endif %}>Haute</option>
                            <option value="Moyenne" {% if priorite == 'Moyenne' %}selected{% endif %}>Moyenne</option>
                            <option value="Basse" {% if priorite == 'Basse' %}selected{% endif %}>Basse</option>
                        </select>
                    </div>

                    <div>
                        <label for="sort" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Trier par
                        </label>
                        <select id="sort" name="sort" class="select">
                            <option value="dateFin" {% if sort == 'dateFin' %}selected{% endif %}>Date de fin</option>
                            <option value="titre" {% if sort == 'titre' %}selected{% endif %}>Titre</option>
                            <option value="dateDebut" {% if sort == 'dateDebut' %}selected{% endif %}>Date de début</option>
                            <option value="priorite" {% if sort == 'priorite' %}selected{% endif %}>Priorité</option>
                            <option value="statut" {% if sort == 'statut' %}selected{% endif %}>Statut</option>
                            <option value="createdAt" {% if sort == 'createdAt' %}selected{% endif %}>Date de création</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                            Ordre
                        </label>
                        <div class="flex gap-2">
                            <label class="flex-1 cursor-pointer">
                                <input type="radio" name="direction" value="asc" {% if direction == 'asc' %}checked{% endif %} class="sr-only peer">
                                <div class="flex items-center justify-center h-[46px] rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-all">
                                    <svg class="w-5 h-5 text-slate-600 dark:text-slate-400 peer-checked:text-primary-600 dark:peer-checked:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                                    </svg>
                                </div>
                            </label>
                            <label class="flex-1 cursor-pointer">
                                <input type="radio" name="direction" value="desc" {% if direction == 'desc' %}checked{% endif %} class="sr-only peer">
                                <div class="flex items-center justify-center h-[46px] rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-all">
                                    <svg class="w-5 h-5 text-slate-600 dark:text-slate-400 peer-checked:text-primary-600 dark:peer-checked:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                    </svg>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-3">
                    <button type="submit" class="btn btn-primary">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                        </svg>
                        Filtrer
                    </button>
                    <a href="{{ path('app_assignments') }}" class="btn btn-outline">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Réinitialiser
                    </a>
                </div>
            </form>
        </div>

        {# Liste des tâches #}
        <div class="card">
            <div class="p-6 border-b border-slate-200 dark:border-slate-800">
                <div class="flex items-center justify-between">
                    <h2 class="text-xl font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                        <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                        </svg>
                        Liste des tâches
                    </h2>
                    <span class="badge badge-secondary">{{ assignments|length }}</span>
                </div>
            </div>

            {% if assignments|length > 0 %}
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Tâche</th>
                                <th>Projet</th>
                                <th>Priorité</th>
                                <th>Statut</th>
                                <th>Échéance</th>
                                <th>Progression</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for assignment in assignments %}
                                {% set now = date() %}
                                {% set isOverdue = assignment.dateFin < now and assignment.statut != 'Terminé' %}
                                <tr>
                                    <td>
                                        <div class="flex items-start gap-3">
                                            <div class="flex-shrink-0 mt-0.5">
                                                {% if assignment.statut == 'Terminé' %}
                                                    <div class="w-5 h-5 rounded-full bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                                                        <svg class="w-3 h-3 text-success-600 dark:text-success-400" fill="currentColor" viewBox="0 0 20 20">
                                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                                        </svg>
                                                    </div>
                                                {% else %}
                                                    <div class="w-5 h-5 rounded-full border-2 border-slate-300 dark:border-slate-600"></div>
                                                {% endif %}
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="font-semibold text-slate-900 dark:text-white mb-1">
                                                    {{ assignment.titre }}
                                                    {% if isOverdue %}
                                                        <span class="badge badge-danger ml-2">En retard</span>
                                                    {% endif %}
                                                </div>
                                                <p class="text-sm text-slate-600 dark:text-slate-400 truncate-2">
                                                    {{ assignment.description }}
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-secondary">
                                            {{ assignment.project.titre }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if assignment.priorite == 'Haute' %}
                                            <span class="badge badge-danger">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M5.293 7.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L6.707 7.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                                                </svg>
                                                {{ assignment.priorite }}
                                            </span>
                                        {% elseif assignment.priorite == 'Moyenne' %}
                                            <span class="badge badge-warning">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14"></path>
                                                </svg>
                                                {{ assignment.priorite }}
                                            </span>
                                        {% else %}
                                            <span class="badge badge-info">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M14.707 12.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 14.586V3a1 1 0 012 0v11.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                                </svg>
                                                {{ assignment.priorite }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if assignment.statut == 'En cours' %}
                                            <span class="badge badge-primary">{{ assignment.statut }}</span>
                                        {% elseif assignment.statut == 'Terminé' %}
                                            <span class="badge badge-success">{{ assignment.statut }}</span>
                                        {% elseif assignment.statut == 'À faire' %}
                                            <span class="badge badge-warning">{{ assignment.statut }}</span>
                                        {% else %}
                                            <span class="badge badge-danger">{{ assignment.statut }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="text-sm">
                                            <div class="font-medium text-slate-900 dark:text-white">
                                                {{ assignment.dateFin|date('d/m/Y') }}
                                            </div>
                                            <div class="text-slate-500 dark:text-slate-400">
                                                {{ assignment.dateFin|date('l') }}
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% set totalDays = assignment.dateFin.diff(assignment.dateDebut).days %}
                                        {% set elapsedDays = now.diff(assignment.dateDebut).days %}
                                        {% set progress = totalDays > 0 ? (elapsedDays / totalDays * 100)|round(0) : 0 %}
                                        {% set progress = progress > 100 ? 100 : (progress < 0 ? 0 : progress) %}
                                        
                                        <div class="flex items-center gap-2">
                                            <div class="flex-1 progress-bar">
                                                <div class="progress-bar-fill {% if progress >= 100 %}progress-bar-fill-success{% elseif progress >= 75 %}progress-bar-fill-warning{% else %}progress-bar-fill-primary{% endif %}" 
                                                     style="width: {{ progress }}%">
                                                </div>
                                            </div>
                                            <span class="text-xs font-medium text-slate-600 dark:text-slate-400 w-10 text-right">{{ progress }}%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="flex items-center justify-end gap-2">
                                            <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" 
                                               class="btn-icon btn-ghost"
                                               title="Voir">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                                </svg>
                                            </a>
                                            <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" 
                                               class="btn-icon btn-ghost"
                                               title="Modifier">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                </svg>
                                            </a>
                                            <button type="button" 
                                                    class="btn-icon btn-ghost text-danger-600 dark:text-danger-400"
                                                    onclick="confirmDelete({{ assignment.id }}, '{{ assignment.titre|e('js') }}')"
                                                    title="Supprimer">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="empty-state">
                    <svg class="empty-state-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <div class="empty-state-title">Aucune tâche trouvée</div>
                    <p class="empty-state-description">
                        {% if search or statut or priorite %}
                            Aucune tâche ne correspond à vos critères de recherche.
                        {% else %}
                            Commencez par créer votre première tâche.
                        {% endif %}
                    </p>
                    <div class="mt-6">
                        {% if search or statut or priorite %}
                            <a href="{{ path('app_assignments') }}" class="btn btn-secondary">
                                Voir toutes les tâches
                            </a>
                        {% else %}
                            <a href="{{ path('app_assignments_new') }}" class="btn btn-primary">
                                Créer une tâche
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{# Modal de suppression #}
<div id="deleteModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="card max-w-md w-full p-0 overflow-hidden">
        <div class="p-6 border-b border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center">
                    <svg class="w-5 h-5 text-danger-600 dark:text-danger-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Confirmer la suppression</h3>
                </div>
            </div>
        </div>
        <div class="p-6">
            <p class="text-slate-600 dark:text-slate-400 mb-2">
                Êtes-vous sûr de vouloir supprimer la tâche <strong id="assignmentTitle" class="text-slate-900 dark:text-white"></strong> ?
            </p>
            <div class="alert alert-danger">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <p class="text-sm">Cette action est irréversible.</p>
            </div>
        </div>
        <div class="p-6 bg-slate-50 dark:bg-slate-800/50 flex gap-3 justify-end">
            <button type="button" onclick="closeDeleteModal()" class="btn btn-secondary">
                Annuler
            </button>
            <form id="deleteForm" method="post" class="inline">
                <input type="hidden" name="_token" id="csrfToken">
                <button type="submit" class="btn btn-danger">
                    Supprimer
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Graphique de statuts
const statusCtx = document.getElementById('statusChart');
if (statusCtx) {
    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: {{ stats.chartData.labels|json_encode|raw }},
            datasets: [{
                data: {{ stats.chartData.data|json_encode|raw }},
                backgroundColor: {{ stats.chartData.colors|json_encode|raw }},
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 15,
                        font: { size: 12, weight: '500' }
                    }
                }
            }
        }
    });
}

// Graphique de progression
const progressionCtx = document.getElementById('progressionChart');
if (progressionCtx) {
    new Chart(progressionCtx, {
        type: 'line',
        data: {
            labels: {{ stats.progressionData.labels|json_encode|raw }},
            datasets: [{
                label: 'Tâches créées',
                data: {{ stats.progressionData.data|json_encode|raw }},
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                tension: 0.4,
                fill: true,
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1 }
                }
            }
        }
    });
}

// Modal de suppression
function confirmDelete(id, title) {
    document.getElementById('assignmentTitle').textContent = title;
    const form = document.getElementById('deleteForm');
    form.action = '{{ path('app_assignments_delete', {'id': '__ID__'}) }}'.replace('__ID__', id);
    document.getElementById('csrfToken').value = '{{ csrf_token('delete' ~ '__ID__') }}'.replace('__ID__', id);
    document.getElementById('deleteModal').classList.remove('hidden');
    document.getElementById('deleteModal').classList.add('flex');
}

function closeDeleteModal() {
    document.getElementById('deleteModal').classList.add('hidden');
    document.getElementById('deleteModal').classList.remove('flex');
}

// Fermer modal en cliquant en dehors
document.getElementById('deleteModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});
</script>
{% endblock %}
