{% extends 'base.html.twig' %}

{% block title %}Profile & Settings{% endblock %}

{% block body %}
<!-- Animated Background Pattern -->
<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full opacity-10 animate-pulse" style="background: radial-gradient(circle, #06b6d4 0%, transparent 70%); animation-duration: 5s;"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full opacity-10 animate-pulse" style="background: radial-gradient(circle, #a855f7 0%, transparent 70%); animation-duration: 6s; animation-delay: 1s;"></div>
</div>

<div class="space-y-10 max-w-7xl mx-auto px-4 py-6">
    <!-- Profile Header Card - Compact & Stunning -->
    <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-lg">
        <!-- Compact Gradient Cover with Pattern -->
        <div class="h-24 relative overflow-hidden" style="background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #a855f7 100%);">
            <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 20px 20px;"></div>
        </div>
        
        <!-- Profile Content - Horizontal Layout -->
        <div class="px-5 pb-5 -mt-14">
            <div class="flex flex-row items-center gap-6">
                <!-- Profile Picture - Clean & Perfect -->
                <div class="shrink-0">
                    <div class="relative w-20 h-20 rounded-2xl bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-bold text-xl shadow-lg overflow-hidden border-3 border-white dark:border-slate-900 hover:shadow-xl transition-all duration-300">
                        {% if app.user.profilePic %}
                            <img src="{% if app.user.profilePic starts with 'http' %}{{ app.user.profilePic }}{% else %}{{ asset('uploads/profiles/' ~ app.user.profilePic) }}{% endif %}" alt="Profile" class="w-full h-full object-cover">
                        {% else %}
                            <span>{{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}</span>
                        {% endif %}
                    </div>
                </div>
                
                <!-- Profile Info - Horizontal Flow -->
                <div class="flex-1">
                    <h1 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-0.5">
                        {{ app.user.fullName }}
                    </h1>
                    
                    <p class="text-xs text-slate-500 dark:text-slate-400 mb-2 flex items-center gap-1.5">
                        <i data-lucide="at-sign" class="w-3.5 h-3.5"></i>
                        {{ app.user.username }}
                    </p>
                    
                    <!-- Compact Badges -->
                    <div class="flex flex-wrap items-center gap-1.5">
                        {% if app.user.isAdmin() %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold text-white shadow-sm" style="background: linear-gradient(135deg, #fbbf24, #f59e0b);">
                            <i data-lucide="crown" class="w-3 h-3"></i>
                            Admin
                        </span>
                        {% endif %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold text-white shadow-sm" style="background: linear-gradient(135deg, #10b981, #059669);">
                            <i data-lucide="shield-check" class="w-3 h-3"></i>
                            Active
                        </span>
                        {% if app.user.university %}
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                            <i data-lucide="graduation-cap" class="w-3 h-3"></i>
                            {{ app.user.university }}
                        </span>
                        {% endif %}
                    </div>
                </div>
                
                <!-- Stats Cards - Horizontal Layout -->
                <div class="flex gap-3">
                    <!-- Projects Card -->
                    <a href="{{ path('app_project_index') }}" class="group">
                        <div class="relative p-3 rounded-xl border border-blue-200 dark:border-blue-800 bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 hover:shadow-lg hover:scale-105 hover:border-blue-400 dark:hover:border-blue-600 transition-all duration-300">
                            <div class="flex flex-col items-center text-center">
                                <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-1.5 group-hover:scale-110 transition-transform" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                                    <i data-lucide="folder" class="w-4 h-4 text-white"></i>
                                </div>
                                <p class="text-xl font-black mb-0" style="background: linear-gradient(135deg, #06b6d4, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                                    {{ total_projects ?? 0 }}
                                </p>
                                <p class="text-xs font-semibold text-slate-600 dark:text-slate-400">Projects</p>
                            </div>
                        </div>
                    </a>
                    
                    <!-- Courses Card -->
                    <a href="{{ path('app_courses') }}" class="group">
                        <div class="relative p-3 rounded-xl border border-purple-200 dark:border-purple-800 bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 hover:shadow-lg hover:scale-105 hover:border-purple-400 dark:hover:border-purple-600 transition-all duration-300">
                            <div class="flex flex-col items-center text-center">
                                <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-1.5 group-hover:scale-110 transition-transform" style="background: linear-gradient(135deg, #a855f7, #ec4899);">
                                    <i data-lucide="book-open" class="w-4 h-4 text-white"></i>
                                </div>
                                <p class="text-xl font-black mb-0" style="background: linear-gradient(135deg, #a855f7, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                                    {{ total_courses ?? 0 }}
                                </p>
                                <p class="text-xs font-semibold text-slate-600 dark:text-slate-400">Courses</p>
                            </div>
                        </div>
                    </a>
                    
                    <!-- Decks Card -->
                    <a href="{{ path('app_revisions') }}" class="group">
                        <div class="relative p-3 rounded-xl border border-green-200 dark:border-green-800 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 hover:shadow-lg hover:scale-105 hover:border-green-400 dark:hover:border-green-600 transition-all duration-300">
                            <div class="flex flex-col items-center text-center">
                                <div class="w-9 h-9 rounded-lg flex items-center justify-center mb-1.5 group-hover:scale-110 transition-transform" style="background: linear-gradient(135deg, #10b981, #059669);">
                                    <i data-lucide="layers" class="w-4 h-4 text-white"></i>
                                </div>
                                <p class="text-xl font-black mb-0" style="background: linear-gradient(135deg, #10b981, #059669); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                                    {{ total_decks ?? 0 }}
                                </p>
                                <p class="text-xs font-semibold text-slate-600 dark:text-slate-400">Decks</p>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
            
            <!-- Bio Section - Compact -->
            {% if app.user.bio %}
            <div class="mt-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                <div class="flex items-start gap-2">
                    <i data-lucide="quote" class="w-3.5 h-3.5 text-slate-400 flex-shrink-0 mt-0.5"></i>
                    <p class="text-xs text-slate-600 dark:text-slate-400 italic">{{ app.user.bio }}</p>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Quick Info Grid - Compact -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Email Card -->
        <div class="group p-4 rounded-xl border border-blue-200 dark:border-blue-800 bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 hover:shadow-lg hover:border-blue-400 dark:hover:border-blue-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                    <i data-lucide="mail" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Email</span>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-white truncate" title="{{ app.user.email }}">{{ app.user.email }}</p>
        </div>
        
        <!-- Phone Card -->
        <div class="group p-4 rounded-xl border border-purple-200 dark:border-purple-800 bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 hover:shadow-lg hover:border-purple-400 dark:hover:border-purple-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #a855f7, #ec4899);">
                    <i data-lucide="phone" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Phone</span>
            </div>
            <p class="text-sm font-semibold {% if app.user.phoneNumber %}text-slate-900 dark:text-white{% else %}text-slate-400 dark:text-slate-500 italic{% endif %}">
                {{ app.user.phoneNumber ?: 'Not provided' }}
            </p>
        </div>
        
        <!-- Student ID Card -->
        <div class="group p-4 rounded-xl border border-green-200 dark:border-green-800 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 hover:shadow-lg hover:border-green-400 dark:hover:border-green-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #10b981, #059669);">
                    <i data-lucide="id-card" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Student ID</span>
            </div>
            <p class="text-sm font-semibold {% if app.user.studentId %}text-slate-900 dark:text-white{% else %}text-slate-400 dark:text-slate-500 italic{% endif %}">
                {{ app.user.studentId ?: 'Not provided' }}
            </p>
        </div>
        
        <!-- Member Since Card -->
        <div class="group p-4 rounded-xl border border-amber-200 dark:border-amber-800 bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 hover:shadow-lg hover:border-amber-400 dark:hover:border-amber-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #f59e0b, #ef4444);">
                    <i data-lucide="calendar" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Member Since</span>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ app.user.createdAt|date('M d, Y') }}</p>
            {% set daysSince = date().diff(app.user.createdAt).days %}
            <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">
                {% if daysSince == 0 %}
                    Joined today!
                {% elseif daysSince == 1 %}
                    Yesterday
                {% else %}
                    {{ daysSince }} days ago
                {% endif %}
            </p>
        </div>
    </div>

    <form method="POST" action="{{ path('app_settings') }}" enctype="multipart/form-data" class="space-y-8" onsubmit="return validateSettingsForm(event)">
        <!-- Profile Section -->
        <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-3xl border-2 border-slate-200 dark:border-slate-800 hover:border-blue-300 dark:hover:border-blue-600 transition-all group shadow-lg">
            <div class="p-6 pb-5 border-b-2 border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.05), rgba(59, 130, 246, 0.05));">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                        <i data-lucide="user" class="w-7 h-7 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-black text-slate-900 dark:text-white mb-1">Profile Information</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Update your personal details</p>
                    </div>
                </div>
            </div>
            <div class="p-8">
            
            <div class="space-y-6">
                <!-- Profile Picture -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4">
                        Profile Picture
                    </label>
                    <div class="flex items-center gap-8">
                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-2xl shadow-lg overflow-hidden" id="profile-pic-preview">
                            {% if app.user.profilePic %}
                                <img src="{% if app.user.profilePic starts with 'http' %}{{ app.user.profilePic }}{% else %}{{ asset('uploads/profiles/' ~ app.user.profilePic) }}{% endif %}" alt="Profile" class="w-full h-full object-cover">
                            {% else %}
                                {{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}
                            {% endif %}
                        </div>
                        <div class="flex-1">
                            <input
                                type="file"
                                id="profile_pic"
                                name="profile_pic"
                                accept="image/jpeg,image/png,image/jpg,image/webp"
                                class="hidden"
                                onchange="previewImage(event)"
                            >
                            <label for="profile_pic" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-medium rounded-xl border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer">
                                <i data-lucide="upload" class="w-4 h-4"></i>
                                Upload Photo
                            </label>
                            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">JPG, PNG or WEBP. Max size 2MB.</p>
                        </div>
                    </div>
                </div>

                <!-- Name Fields -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="first_name" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            First Name <span class="text-danger-500">*</span>
                        </label>
                        <input
                            type="text"
                            id="first_name"
                            name="first_name"
                            value="{{ app.user.firstName }}"
                            required
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                    </div>
                    <div>
                        <label for="last_name" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            Last Name <span class="text-danger-500">*</span>
                        </label>
                        <input
                            type="text"
                            id="last_name"
                            name="last_name"
                            value="{{ app.user.lastName }}"
                            required
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                    </div>
                </div>

                <!-- Username -->
                <div>
                    <label for="username" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Username <span class="text-danger-500">*</span>
                    </label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            value="{{ app.user.username }}"
                            required
                            pattern="[a-zA-Z0-9_]{3,20}"
                            title="Username must be 3-20 characters and contain only letters, numbers, and underscores"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Email Address <span class="text-danger-500">*</span>
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ app.user.email }}"
                        required
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>

                <!-- Phone Number -->
                <div>
                    <label for="phone_number" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Phone Number
                    </label>
                        <input
                            type="tel"
                            id="phone_number"
                            name="phone_number"
                            value="{{ app.user.phoneNumber }}"
                            placeholder="+1 234 567 8900"
                            pattern="[\+]?[0-9\s\-\(\)]{8,20}"
                            title="Please enter a valid phone number"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                </div>

                <!-- Gender -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                        Gender <span class="text-danger-500">*</span>
                    </label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="relative cursor-pointer">
                            <input type="radio" name="gender" value="male" class="peer sr-only" {{ app.user.gender == 'male' ? 'checked' : '' }} required>
                            <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Male</span>
                            </div>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" name="gender" value="female" class="peer sr-only" {{ app.user.gender == 'female' ? 'checked' : '' }} required>
                            <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Female</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Bio -->
                <div>
                    <label for="bio" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Bio
                    </label>
                    <textarea
                        id="bio"
                        name="bio"
                        rows="4"
                        placeholder="Tell us a bit about yourself..."
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors resize-none"
                    >{{ app.user.bio }}</textarea>
                </div>
            </div>
            <div class="absolute top-0 right-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(59, 130, 246, 0.2), transparent); filter: blur(40px);"></div>
        </div>

        <!-- Academic Information -->
        <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-3xl border-2 border-slate-200 dark:border-slate-800 hover:border-green-300 dark:hover:border-green-600 transition-all group shadow-lg">
            <div class="p-6 pb-5 border-b-2 border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(5, 150, 105, 0.05));">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i data-lucide="graduation-cap" class="w-7 h-7 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-black text-slate-900 dark:text-white mb-1">Academic Information</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Your educational background</p>
                    </div>
                </div>
            </div>
            <div class="p-8">
            
            <div class="space-y-6">
                <!-- University -->
                <div>
                    <label for="university" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        University
                    </label>
                    <input
                        type="text"
                        id="university"
                        name="university"
                        value="{{ app.user.university }}"
                        placeholder="e.g., University of California"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>

                <!-- Student ID -->
                <div>
                    <label for="student_id" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Student ID
                    </label>
                    <input
                        type="text"
                        id="student_id"
                        name="student_id"
                        value="{{ app.user.studentId }}"
                        placeholder="e.g., STU123456"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>
            </div>
            <div class="absolute bottom-0 left-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(16, 185, 129, 0.2), transparent); filter: blur(40px);"></div>
        </div>

        <!-- Change Password Section -->
        <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-3xl border-2 border-slate-200 dark:border-slate-800 hover:border-purple-300 dark:hover:border-purple-600 transition-all group shadow-lg">
