{% extends 'base.html.twig' %}

{% block title %}Profile & Settings{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('avatar-climb') }}
{% endblock %}

{% block body %}
<!-- Avatar Container for Settings Animation -->
<div id="avatar-container" class="fixed inset-0 z-50 pointer-events-none"></div>

<!-- Animated Background Pattern -->
<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-0 left-1/4 w-96 h-96 rounded-full opacity-10 animate-pulse" style="background: radial-gradient(circle, #06b6d4 0%, transparent 70%); animation-duration: 5s;"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full opacity-10 animate-pulse" style="background: radial-gradient(circle, #a855f7 0%, transparent 70%); animation-duration: 6s; animation-delay: 1s;"></div>
</div>

<div class="space-y-10 max-w-7xl mx-auto px-4 py-6">
    <!-- Ultra Modern Profile Hero Card -->
    <div class="relative">
        <!-- Floating Particles Background -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-br from-indigo-500/30 to-purple-500/30 dark:from-indigo-600/20 dark:to-purple-600/20 rounded-full blur-3xl animate-pulse" style="animation-duration: 6s;"></div>
        <div class="absolute -bottom-24 -right-24 w-[28rem] h-[28rem] bg-gradient-to-br from-pink-500/30 to-rose-500/30 dark:from-pink-600/20 dark:to-rose-600/20 rounded-full blur-3xl animate-pulse" style="animation-duration: 7s; animation-delay: 2s;"></div>
        
        <!-- Main Card with Advanced Glassmorphism -->
        <div class="relative backdrop-blur-2xl bg-white/70 dark:bg-slate-900/70 rounded-[3rem] shadow-2xl overflow-hidden">
            <!-- Animated Gradient Border -->
            <div class="absolute inset-0 rounded-[3rem] p-[3px] bg-gradient-to-r from-indigo-500 via-purple-500 via-pink-500 to-rose-500 opacity-90"></div>
            
            <!-- Inner Content -->
            <div class="relative bg-white/95 dark:bg-slate-900/95 rounded-[2.9rem] m-[3px]">
                <!-- Header Section with Curve Design -->
                <div class="relative h-56 md:h-64 overflow-hidden">
                    <!-- Dynamic Gradient Background - More vibrant -->
                    <div class="absolute inset-0 bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-indigo-900/50 via-transparent to-transparent"></div>
                    <div class="absolute top-0 right-0 w-2/3 h-full bg-gradient-to-l from-violet-500/30 to-transparent"></div>
                    <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-pink-600/40 to-transparent"></div>
                    
                    <!-- Animated Grid Pattern -->
                    <div class="absolute inset-0 opacity-15" style="background-image: linear-gradient(rgba(255,255,255,0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.2) 1px, transparent 1px); background-size: 40px 40px;"></div>
                    
                    <!-- Floating Geometric Shapes - More colorful -->
                    <div class="absolute top-6 left-8 w-28 h-28 border-2 border-white/30 rounded-2xl rotate-12 animate-pulse" style="animation-duration: 4s;"></div>
                    <div class="absolute top-14 right-20 w-20 h-20 bg-white/15 rounded-full animate-pulse" style="animation-duration: 5s; animation-delay: 1s;"></div>
                    <div class="absolute bottom-14 left-1/4 w-14 h-14 border-2 border-white/20 rotate-45 animate-pulse" style="animation-duration: 3.5s; animation-delay: 2s;"></div>
                    <div class="absolute bottom-6 right-1/3 w-24 h-24 bg-gradient-to-br from-amber-400/40 to-pink-400/40 rounded-full blur-2xl animate-pulse" style="animation-duration: 4.5s;"></div>
                    <div class="absolute top-1/2 left-6 w-10 h-10 bg-gradient-to-br from-cyan-400/50 to-blue-400/50 rounded-lg rotate-12 animate-pulse" style="animation-duration: 3s; animation-delay: 0.5s;"></div>
                    <div class="absolute top-8 right-1/3 w-6 h-6 bg-white/40 rounded-full animate-pulse" style="animation-duration: 2.5s;"></div>
                    <div class="absolute bottom-20 left-12 w-8 h-8 border border-white/25 rotate-45 animate-pulse" style="animation-duration: 3.2s; animation-delay: 1.5s;"></div>
                    
                    <!-- Curved Wave Divider -->
                    <div class="absolute bottom-0 left-0 right-0 h-16">
                        <svg class="absolute bottom-0 w-full h-24" viewBox="0 0 1440 120" preserveAspectRatio="none">
                            <path class="fill-white dark:fill-slate-900" d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,64C960,75,1056,85,1152,80C1248,75,1344,53,1392,42.7L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"></path>
                        </svg>
                    </div>
                    
                    <!-- Status Badges -->
                    <div class="absolute top-6 left-6 flex items-center gap-3">
                        <div class="flex items-center gap-2 px-4 py-2 bg-black/30 backdrop-blur-md rounded-full border border-white/20">
                            <span class="relative flex h-2.5 w-2.5">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-400"></span>
                            </span>
                            <span class="text-white text-xs font-semibold">Online</span>
                        </div>
                    </div>
                    
                    <div class="absolute top-6 right-6 flex items-center gap-3">
                        <div class="flex items-center gap-2 px-4 py-2 bg-black/30 backdrop-blur-md rounded-full border border-white/20">
                            <i data-lucide="calendar" class="w-3.5 h-3.5 text-white"></i>
                            <span class="text-white text-xs font-semibold">{{ app.user.createdAt|date('M Y') }}</span>
                        </div>
                    </div>
                </div>
                
                <!-- Main Content Area -->
                <div class="relative px-6 md:px-10 pb-8 -mt-20">
                    <!-- Profile Section - Asymmetric Layout -->
                    <div class="flex flex-col lg:flex-row items-end gap-8">
                        <!-- Large Profile Picture with Glowing Ring -->
                        <div class="relative shrink-0 self-center lg:self-auto">
                            <!-- Multiple Glowing Rings - Matching header colors -->
                            <div class="absolute -inset-3 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 rounded-full blur-xl opacity-60 animate-pulse" style="animation-duration: 2s;"></div>
                            <div class="absolute -inset-1.5 bg-gradient-to-r from-pink-500 via-rose-500 to-purple-500 rounded-full blur-lg opacity-80 animate-pulse" style="animation-duration: 3s; animation-delay: 0.5s;"></div>
                            
                            <!-- Profile Picture -->
                            <div id="profile-pic-wrapper" class="relative w-44 h-44 md:w-52 md:h-52 rounded-full overflow-hidden ring-8 ring-white dark:ring-slate-900 shadow-2xl bg-gradient-to-br from-indigo-100 via-purple-100 to-pink-100 dark:from-indigo-900 dark:via-purple-900 dark:to-pink-900 hover:scale-105 transition-transform duration-500">
                                {% if app.user.profilePic %}
                                    <img src="{% if app.user.profilePic starts with 'http' %}{{ app.user.profilePic }}{% else %}{{ asset('uploads/profiles/' ~ app.user.profilePic) }}{% endif %}" alt="Profile" class="w-full h-full object-cover">
                                {% else %}
                                    <span id="profile-initials" class="absolute inset-0 flex items-center justify-center text-5xl md:text-6xl font-black text-slate-600 dark:text-slate-300">{{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}</span>
                                {% endif %}
                                
                                <!-- 3D Avatar Container -->
                                <div id="avatar-climb-container" 
                                     data-avatar-type="{{ app.user.avatarType ?? 'male-avatar.glb' }}" 
                                     class="absolute inset-0 z-10 pointer-events-none"
                                     style="width: 100%; height: 100%;">
                                </div>
                            </div>
                            
                            <!-- Floating Badge -->
                            <div class="absolute -bottom-2 -right-2 w-10 h-10 bg-gradient-to-r from-green-400 to-emerald-500 rounded-full flex items-center justify-center shadow-lg ring-4 ring-white dark:ring-slate-900">
                                <i data-lucide="check" class="w-5 h-5 text-white"></i>
                            </div>
                        </div>
                        
                        <!-- Info Section -->
                        <div class="flex-1 text-center lg:text-left pt-4">
                            <div class="flex flex-col lg:flex-row lg:items-center gap-3 mb-3">
                                <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
                                    {{ app.user.fullName }}
                                </h1>
                                <!-- Creative Badge Display -->
                                {% if app.user.isAdmin() %}
                                <span class="inline-flex items-center gap-1.5 px-5 py-2 rounded-2xl text-sm font-bold bg-gradient-to-r from-violet-500 via-fuchsia-500 to-cyan-500 text-white shadow-lg shadow-violet-500/30 hover:shadow-violet-500/50 transition-shadow">
                                    <i data-lucide="crown" class="w-4 h-4"></i>
                                    Administrator
                                </span>
                                {% endif %}
                            </div>
                            
                            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mb-4">
                                <div class="flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800 rounded-full">
                                    <i data-lucide="at-sign" class="w-4 h-4 text-slate-500"></i>
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">{{ app.user.username }}</span>
                                </div>
                                {% if app.user.university %}
                                <div class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-violet-100 to-cyan-100 dark:from-violet-900/50 dark:to-cyan-900/50 rounded-full">
                                    <i data-lucide="graduation-cap" class="w-4 h-4 text-violet-500"></i>
                                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">{{ app.user.university }}</span>
                                </div>
                                {% endif %}
                            </div>
                            
                            <!-- Creative Status Indicator -->
                            <div class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full shadow-md shadow-green-500/25">
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
                                </span>
                                <span class="text-white text-sm font-bold">Active Account</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Bio Section -->
                    {% if app.user.bio %}
                    <div class="mt-8 p-6 bg-gradient-to-r from-slate-50 to-slate-100 dark:from-slate-800/50 dark:to-slate-800/30 rounded-2xl border border-slate-200/50 dark:border-slate-700/50">
                        <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-center">
                            <i data-lucide="quote" class="w-5 h-5 inline text-violet-400 mr-2"></i>
                            {{ app.user.bio }}
                        </p>
                    </div>
                    {% endif %}
                    
                    <!-- Stats with Circular Progress Indicators -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                        <!-- Projects - Creative Card -->
                        <div class="group relative rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300">
                            <!-- Top Colored Section -->
                            <div class="relative h-24 bg-gradient-to-br from-indigo-500 via-purple-500 to-violet-600 overflow-hidden">
                                <div class="absolute inset-0 bg-gradient-to-t from-indigo-900/30 to-transparent"></div>
                                <!-- Decorative shapes -->
                                <div class="absolute top-2 right-2 w-12 h-12 bg-white/10 rounded-full animate-pulse" style="animation-duration: 3s;"></div>
                                <div class="absolute bottom-2 left-2 w-8 h-8 border border-white/20 rotate-45"></div>
                                <div class="absolute top-1/2 left-4 w-4 h-4 bg-white/20 rounded-full"></div>
                                <!-- Icon -->
                                <div class="absolute bottom-[-20px] left-1/2 -translate-x-1/2 w-14 h-14 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                                    <i data-lucide="folder-kanban" class="w-7 h-7 text-indigo-500"></i>
                                </div>
                            </div>
                            <!-- Bottom Content -->
                            <div class="pt-10 pb-5 px-5 bg-white dark:bg-slate-800">
                                <p class="text-4xl font-black text-slate-900 dark:text-white text-center">{{ total_projects ?? 0 }}</p>
                                <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 text-center mt-1">Projects</p>
                            </div>
                        </div>
                        
                        <!-- Courses - Creative Card -->
                        <div class="group relative rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300">
                            <!-- Top Colored Section -->
                            <div class="relative h-24 bg-gradient-to-br from-pink-500 via-rose-500 to-pink-600 overflow-hidden">
                                <div class="absolute inset-0 bg-gradient-to-t from-rose-900/30 to-transparent"></div>
                                <!-- Decorative shapes -->
                                <div class="absolute top-2 right-2 w-12 h-12 bg-white/10 rounded-full animate-pulse" style="animation-duration: 4s;"></div>
                                <div class="absolute bottom-2 left-2 w-8 h-8 border border-white/20 rotate-45"></div>
                                <div class="absolute top-1/2 left-4 w-4 h-4 bg-white/20 rounded-full"></div>
                                <!-- Icon -->
                                <div class="absolute bottom-[-20px] left-1/2 -translate-x-1/2 w-14 h-14 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                                    <i data-lucide="book-open-check" class="w-7 h-7 text-pink-500"></i>
                                </div>
                            </div>
                            <!-- Bottom Content -->
                            <div class="pt-10 pb-5 px-5 bg-white dark:bg-slate-800">
                                <p class="text-4xl font-black text-slate-900 dark:text-white text-center">{{ total_courses ?? 0 }}</p>
                                <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 text-center mt-1">Courses</p>
                            </div>
                        </div>
                        
                        <!-- Flashcard Decks - Creative Card -->
                        <div class="group relative rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300">
                            <!-- Top Colored Section -->
                            <div class="relative h-24 bg-gradient-to-br from-violet-500 via-purple-500 to-fuchsia-600 overflow-hidden">
                                <div class="absolute inset-0 bg-gradient-to-t from-purple-900/30 to-transparent"></div>
                                <!-- Decorative shapes -->
                                <div class="absolute top-2 right-2 w-12 h-12 bg-white/10 rounded-full animate-pulse" style="animation-duration: 3.5s;"></div>
                                <div class="absolute bottom-2 left-2 w-8 h-8 border border-white/20 rotate-45"></div>
                                <div class="absolute top-1/2 left-4 w-4 h-4 bg-white/20 rounded-full"></div>
                                <!-- Icon -->
                                <div class="absolute bottom-[-20px] left-1/2 -translate-x-1/2 w-14 h-14 bg-white rounded-2xl shadow-lg flex items-center justify-center">
                                    <i data-lucide="layers-3" class="w-7 h-7 text-violet-500"></i></i>
                                </div>
                            </div>
                            <!-- Bottom Content -->
                            <div class="pt-10 pb-5 px-5 bg-white dark:bg-slate-800">
                                <p class="text-4xl font-black text-slate-900 dark:text-white text-center">{{ total_decks ?? 0 }}</p>
                                <p class="text-sm font-semibold text-slate-500 dark:text-slate-400 text-center mt-1">Flashcard Decks</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Quick Info Grid - Compact -->
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Email Card -->
        <div class="group p-4 rounded-xl border border-blue-200 dark:border-blue-800 bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 hover:shadow-lg hover:border-blue-400 dark:hover:border-blue-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                    <i data-lucide="mail" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Email</span>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-white truncate" title="{{ app.user.email }}">{{ app.user.email }}</p>
        </div>
        
        <!-- Phone Card -->
        <div class="group p-4 rounded-xl border border-purple-200 dark:border-purple-800 bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 hover:shadow-lg hover:border-purple-400 dark:hover:border-purple-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #a855f7, #ec4899);">
                    <i data-lucide="phone" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Phone</span>
            </div>
            <p class="text-sm font-semibold {% if app.user.phoneNumber %}text-slate-900 dark:text-white{% else %}text-slate-400 dark:text-slate-500 italic{% endif %}">
                {{ app.user.phoneNumber ?: 'Not provided' }}
            </p>
        </div>
        
        <!-- Student ID Card -->
        <div class="group p-4 rounded-xl border border-green-200 dark:border-green-800 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 hover:shadow-lg hover:border-green-400 dark:hover:border-green-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #10b981, #059669);">
                    <i data-lucide="id-card" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Student ID</span>
            </div>
            <p class="text-sm font-semibold {% if app.user.studentId %}text-slate-900 dark:text-white{% else %}text-slate-400 dark:text-slate-500 italic{% endif %}">
                {{ app.user.studentId ?: 'Not provided' }}
            </p>
        </div>
        
        <!-- Member Since Card -->
        <div class="group p-4 rounded-xl border border-amber-200 dark:border-amber-800 bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 hover:shadow-lg hover:border-amber-400 dark:hover:border-amber-600 transition-all duration-300">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-9 h-9 rounded-lg flex items-center justify-center" style="background: linear-gradient(135deg, #f59e0b, #ef4444);">
                    <i data-lucide="calendar" class="w-4 h-4 text-white"></i>
                </div>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Member Since</span>
            </div>
            <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ app.user.createdAt|date('M d, Y') }}</p>
            {% set daysSince = date().diff(app.user.createdAt).days %}
            <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">
                {% if daysSince == 0 %}
                    Joined today!
                {% elseif daysSince == 1 %}
                    Yesterday
                {% else %}
                    {{ daysSince }} days ago
                {% endif %}
            </p>
        </div>
    </div>

    <form method="POST" action="{{ path('app_settings') }}" enctype="multipart/form-data" class="max-w-7xl mx-auto space-y-8" onsubmit="return validateSettingsForm(event)">
        <!-- Profile Section -->
        <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-3xl border-2 border-slate-200 dark:border-slate-800 hover:border-blue-300 dark:hover:border-blue-600 transition-all group shadow-lg">
            <div class="p-6 pb-5 border-b-2 border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.05), rgba(59, 130, 246, 0.05));">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-xl flex items-center justify-center shadow-lg" style="background: linear-gradient(135deg, #06b6d4, #3b82f6);">
                        <i data-lucide="user" class="w-7 h-7 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-black text-slate-900 dark:text-white mb-1">Profile Information</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Update your personal details</p>
                    </div>
                </div>
            </div>
            <div class="p-8">
            
            <div class="space-y-6">
                <!-- Profile Picture -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4">
                        Profile Picture
                    </label>
                    <div class="flex items-center gap-8">
                        <div class="w-32 h-32 rounded-2xl bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center text-white font-semibold text-2xl shadow-lg overflow-hidden" id="profile-pic-preview">
                            {% if app.user.profilePic %}
                                <img src="{% if app.user.profilePic starts with 'http' %}{{ app.user.profilePic }}{% else %}{{ asset('uploads/profiles/' ~ app.user.profilePic) }}{% endif %}" alt="Profile" class="w-full h-full object-cover">
                            {% else %}
                                {{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}
                            {% endif %}
                        </div>
                        <div class="flex-1">
                            <input
                                type="file"
                                id="profile_pic"
                                name="profile_pic"
                                accept="image/jpeg,image/png,image/jpg,image/webp"
                                class="hidden"
                                onchange="previewImage(event)"
                            >
                            <label for="profile_pic" class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-sm font-medium rounded-xl border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer">
                                <i data-lucide="upload" class="w-4 h-4"></i>
                                Upload Photo
                            </label>
                            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">JPG, PNG or WEBP. Max size 2MB.</p>
                        </div>
                    </div>
                </div>

                <!-- Name Fields -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="first_name" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            First Name <span class="text-danger-500">*</span>
                        </label>
                        <input
                            type="text"
                            id="first_name"
                            name="first_name"
                            value="{{ app.user.firstName }}"
                            required
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                    </div>
                    <div>
                        <label for="last_name" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                            Last Name <span class="text-danger-500">*</span>
                        </label>
                        <input
                            type="text"
                            id="last_name"
                            name="last_name"
                            value="{{ app.user.lastName }}"
                            required
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                    </div>
                </div>

                <!-- Username -->
                <div>
                    <label for="username" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Username <span class="text-danger-500">*</span>
                    </label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            value="{{ app.user.username }}"
                            required
                            pattern="[a-zA-Z0-9_]{3,20}"
                            title="Username must be 3-20 characters and contain only letters, numbers, and underscores"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                </div>

                <!-- Email -->
                <div>
                    <label for="email" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Email Address <span class="text-danger-500">*</span>
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="{{ app.user.email }}"
                        required
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>

                <!-- Phone Number -->
                <div>
                    <label for="phone_number" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Phone Number
                    </label>
                        <input
                            type="tel"
                            id="phone_number"
                            name="phone_number"
                            value="{{ app.user.phoneNumber }}"
                            placeholder="+1 234 567 8900"
                            pattern="[\+]?[0-9\s\-\(\)]{8,20}"
                            title="Please enter a valid phone number"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                </div>

                <!-- Gender -->
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                        Gender <span class="text-danger-500">*</span>
                    </label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="relative cursor-pointer">
                            <input type="radio" name="gender" value="male" class="peer sr-only" {{ app.user.gender == 'male' ? 'checked' : '' }} required>
                            <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Male</span>
                            </div>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" name="gender" value="female" class="peer sr-only" {{ app.user.gender == 'female' ? 'checked' : '' }} required>
                            <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Female</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Bio -->
                <div>
                    <label for="bio" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Bio
                    </label>
                    <textarea
                        id="bio"
                        name="bio"
                        rows="4"
                        placeholder="Tell us a bit about yourself..."
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors resize-none"
                    >{{ app.user.bio }}</textarea>
                </div>
            </div>
            <div class="absolute top-0 right-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(59, 130, 246, 0.2), transparent); filter: blur(40px);"></div>
        </div>

        <!-- Academic Information -->
        <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-green-300 dark:hover:border-green-600 transition-all group shadow-lg">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(5, 150, 105, 0.05));">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl flex items-center justify-center shadow-md" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i data-lucide="graduation-cap" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Academic Information</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Your educational background</p>
                    </div>
                </div>
            </div>
            <div class="p-6">
            
            <div class="space-y-5">
                <!-- University -->
                <div>
                    <label for="university" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        University
                    </label>
                    <input
                        type="text"
                        id="university"
                        name="university"
                        value="{{ app.user.university }}"
                        placeholder="e.g., University of California"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>

                <!-- Student ID -->
                <div>
                    <label for="student_id" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Student ID
                    </label>
                    <input
                        type="text"
                        id="student_id"
                        name="student_id"
                        value="{{ app.user.studentId }}"
                        placeholder="e.g., STU123456"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>
            </div>
            <div class="absolute bottom-0 left-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(16, 185, 129, 0.2), transparent); filter: blur(40px);"></div>
        </div>

        <!-- Change Password Section -->
        <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-purple-300 dark:hover:border-purple-600 transition-all group shadow-lg">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.05), rgba(236, 72, 153, 0.05));">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl flex items-center justify-center shadow-md" style="background: linear-gradient(135deg, #a855f7, #ec4899);">
                        <i data-lucide="lock" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Change Password</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Update your security credentials</p>
                    </div>
                </div>
            </div>
            <div class="p-6">
            
            <div class="space-y-5">
                <div class="p-4 bg-info-50 dark:bg-info-900/20 border border-info-200 dark:border-info-800 rounded-xl">
                    <div class="flex items-start gap-3">
                        <i data-lucide="info" class="w-5 h-5 text-info-600 dark:text-info-400 flex-shrink-0 mt-0.5"></i>
                        <p class="text-sm text-info-800 dark:text-info-200 leading-relaxed">Leave password fields empty if you don't want to change your password.</p>
                    </div>
                </div>

                <!-- Current Password -->
                <div>
                    <label for="current_password" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        Current Password
                    </label>
                    <input
                        type="password"
                        id="current_password"
                        name="current_password"
                        placeholder="Enter your current password"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>

                <!-- New Password -->
                <div>
                    <label for="new_password" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        New Password
                    </label>
                    <input
                        type="password"
                        id="new_password"
                        name="new_password"
                        placeholder="Enter your new password"
                        minlength="6"
                        title="Password must be at least 6 characters long"
                        class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                    >
                </div>
            </div>
            <div class="absolute top-0 right-0 w-32 h-32 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500" style="background: radial-gradient(circle, rgba(168, 85, 247, 0.2), transparent); filter: blur(40px);"></div>
        </div>

        <!-- Accessibility Settings Section -->
        <div class="relative overflow-hidden bg-white dark:bg-slate-900 rounded-2xl border-2 border-slate-200 dark:border-slate-800 hover:border-indigo-300 dark:hover:border-indigo-600 transition-all group shadow-lg"
             data-controller="accessibility"
             data-accessibility-font-size-value="{{ app.user.settings.fontSize|default('normal') }}"
             data-accessibility-font-family-value="{{ app.user.settings.fontFamily|default('system') }}"
             data-accessibility-accent-color-value="{{ app.user.settings.accentColor|default('#6366f1') }}"
             data-accessibility-reduce-motion-value="{{ app.user.settings.reduceMotion ? 'true' : 'false' }}"
             data-accessibility-high-contrast-value="{{ app.user.settings.highContrast ? 'true' : 'false' }}"
             data-accessibility-line-height-value="{{ app.user.settings.lineHeight|default('normal') }}"
             data-accessibility-letter-spacing-value="{{ app.user.settings.letterSpacing|default('normal') }}"
             data-accessibility-zoom-level-value="{{ app.user.settings.zoomLevel|default(100) }}"
             data-accessibility-language-value="{{ app.user.settings.language|default('en') }}"
             data-accessibility-theme-value="{{ app.user.settings.themePreference|default('auto') }}"
             data-accessibility-save-url-value="{{ path('app_settings_accessibility_save') }}">
            <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), rgba(139, 92, 246, 0.05));">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-xl flex items-center justify-center shadow-md" style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">
                        <i data-lucide="accessibility" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-900 dark:text-white">Accessibility & Personalization</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Customize your experience for better accessibility</p>
                    </div>
                </div>
            </div>
            <div class="p-6">
            
            <div class="space-y-8">
                <!-- Help Box -->
                <div class="p-5 bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-950/30 dark:to-indigo-950/30 rounded-xl border border-blue-200 dark:border-blue-800">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center shadow-md flex-shrink-0">
                            <i data-lucide="info" class="w-5 h-5 text-white"></i>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-blue-700 dark:text-blue-300 mb-2">What do these settings do?</p>
                            <ul class="text-xs text-slate-600 dark:text-slate-400 space-y-1">
                                <li><strong>Theme:</strong> Changes the entire app to light, dark, or follows your system setting</li>
                                <li><strong>Font Size:</strong> Makes all text bigger or smaller (great for visual comfort)</li>
                                <li><strong>Font Family:</strong> Changes the style of text letters</li>
                                <li><strong>Accent Color:</strong> Changes the primary color of buttons, links, and highlights</li>
                                <li><strong>Line Height:</strong> Adds more or less space between lines of text</li>
                                <li><strong>Letter Spacing:</strong> Adds more or less space between letters</li>
                                <li><strong>Zoom:</strong> Zooms the entire website in or out (100%-200%)</li>
                                <li><strong>Language:</strong> Changes website language (English, French, Spanish, Arabic)</li>
                                <li><strong>Reduce Motion:</strong> Disables animations (helpful for motion sensitivity)</li>
                                <li><strong>High Contrast:</strong> Makes text stand out more against backgrounds</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Theme Selection -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-2">
                        <i data-lucide="sun-moon" class="w-4 h-4 text-indigo-500"></i>
                        Theme Mode
                    </label>
                    <div class="grid grid-cols-3 gap-3" data-accessibility-target="themeButtons">
                        <button type="button" data-action="click->accessibility#setTheme" data-theme="light" 
                                class="p-4 rounded-xl border-2 border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 transition-all flex flex-col items-center gap-2 {{ app.user.settings.themePreference == 'light' ? 'ring-2 ring-primary-500 ring-offset-2' : '' }}">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-400 to-orange-400 flex items-center justify-center shadow-md">
                                <i data-lucide="sun" class="w-5 h-5 text-white"></i>
                            </div>
                            <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Light</span>
                        </button>
                        <button type="button" data-action="click->accessibility#setTheme" data-theme="dark"
                                class="p-4 rounded-xl border-2 border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 transition-all flex flex-col items-center gap-2 {{ app.user.settings.themePreference == 'dark' ? 'ring-2 ring-primary-500 ring-offset-2' : '' }}">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center shadow-md">
                                <i data-lucide="moon" class="w-5 h-5 text-white"></i>
                            </div>
                            <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Dark</span>
                        </button>
                        <button type="button" data-action="click->accessibility#setTheme" data-theme="auto"
                                class="p-4 rounded-xl border-2 border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 transition-all flex flex-col items-center gap-2 {{ app.user.settings.themePreference == 'auto' or not app.user.settings.themePreference ? 'ring-2 ring-primary-500 ring-offset-2' : '' }}">
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-slate-400 to-slate-600 flex items-center justify-center shadow-md">
                                <i data-lucide="monitor" class="w-5 h-5 text-white"></i>
                            </div>
                            <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Auto</span>
                        </button>
                    </div>
                </div>

                <!-- Font Size -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-2">
                        <i data-lucide="type" class="w-4 h-4 text-indigo-500"></i>
                        Font Size
                        <span data-accessibility-target="fontSizePreview" class="ml-auto text-xs px-2 py-1 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 rounded-md font-bold">{{ app.user.settings.fontSize|default('normal')|upper }}</span>
                    </label>
                    <input type="range" min="1" max="6" value="{% set fs = app.user.settings.fontSize|default('normal') %}{% if fs == 'xs' %}1{% elseif fs == 'sm' %}2{% elseif fs == 'lg' %}4{% elseif fs == 'xl' %}5{% elseif fs == '2xl' %}6{% else %}3{% endif %}"
                           data-accessibility-target="fontSizeSlider"
                           data-action="input->accessibility#changeFontSize"
                           class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-indigo-500">
                    <div class="flex justify-between text-xs text-slate-500 dark:text-slate-400 mt-2 font-medium">
                        <span>A</span>
                        <span>A</span>
                        <span class="text-base font-bold text-indigo-500">A</span>
                        <span>A</span>
                        <span>A</span>
                        <span class="text-lg">A</span>
                    </div>
                </div>

                <!-- Font Family -->
                <div>
                    <label for="font_family" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2 flex items-center gap-2">
                        <i data-lucide="text-cursor-input" class="w-4 h-4 text-indigo-500"></i>
                        Font Family
                    </label>
                    <select id="font_family" 
                            data-accessibility-target="fontFamilySelect"
                            data-action="change->accessibility#changeFontFamily"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors">
                        <option value="system" {{ app.user.settings.fontFamily == 'system' ? 'selected' : '' }}>System Default</option>
                        <option value="roboto" {{ app.user.settings.fontFamily == 'roboto' ? 'selected' : '' }}>Roboto</option>
                        <option value="open-sans" {{ app.user.settings.fontFamily == 'open-sans' ? 'selected' : '' }}>Open Sans</option>
                        <option value="lato" {{ app.user.settings.fontFamily == 'lato' ? 'selected' : '' }}>Lato</option>
                        <option value="montserrat" {{ app.user.settings.fontFamily == 'montserrat' ? 'selected' : '' }}>Montserrat</option>
                        <option value="arial" {{ app.user.settings.fontFamily == 'arial' ? 'selected' : '' }}>Arial</option>
                        <option value="georgia" {{ app.user.settings.fontFamily == 'georgia' ? 'selected' : '' }}>Georgia (Serif)</option>
                        <option value="opendyslexic" {{ app.user.settings.fontFamily == 'opendyslexic' ? 'selected' : '' }}>OpenDyslexic</option>
                    </select>
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">OpenDyslexic is designed for readers with dyslexia</p>
                </div>

                <!-- Accent Color -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4 flex items-center gap-2">
                        <i data-lucide="palette" class="w-4 h-4 text-indigo-500"></i>
                        Accent Color
                    </label>
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-wrap gap-3 items-center">
                            <input type="color" value="{{ app.user.settings.accentColor|default('#6366f1') }}"
                                   data-accessibility-target="accentColorInput"
                                   data-action="input->accessibility#changeAccentColor"
                                   class="w-12 h-12 rounded-full border-2 border-slate-200 dark:border-slate-700 cursor-pointer bg-transparent">
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#6366f1'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));" 
                                    class="w-9 h-9 rounded-full bg-indigo-500 hover:scale-110 transition-transform shadow-md ring-2 ring-transparent hover:ring-indigo-300" title="Indigo"></button>
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#8b5cf6'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));"
                                    class="w-9 h-9 rounded-full bg-violet-500 hover:scale-110 transition-transform shadow-md ring-2 ring-transparent hover:ring-violet-300" title="Violet"></button>
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#ec4899'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));"
                                    class="w-9 h-9 rounded-full bg-pink-500 hover:scale-110 transition-transform shadow-md ring-2 ring-transparent hover:ring-pink-300" title="Pink"></button>
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#ef4444'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));"
                                    class="w-9 h-9 rounded-full bg-red-500 hover:scale-110 transition-transform shadow-md ring-2 ring-transparent hover:ring-red-300" title="Red"></button>
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#f97316'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));"
                                    class="w-9 h-9 rounded-full bg-orange-500 hover:scale-110 transition-transform shadow-md ring-2 ring-transparent hover:ring-orange-300" title="Orange"></button>
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#f59e0b'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));"
                                    class="w-9 h-9 rounded-full bg-amber-500 hover:scale-110 transition-transform shadow-md ring-2 ring-transparent hover:ring-amber-300" title="Amber"></button>
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#10b981'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));"
                                    class="w-9 h-9 rounded-full bg-emerald-500 hover:scale-110 transition-transform shadow-md ring-2 ring-transparent hover:ring-emerald-300" title="Emerald"></button>
                            <button type="button" onclick="document.querySelector('[data-accessibility-target=accentColorInput]').value = '#06b6d4'; document.querySelector('[data-accessibility-target=accentColorInput]').dispatchEvent(new Event('input'));"
