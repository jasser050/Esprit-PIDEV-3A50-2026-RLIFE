        </div>
        
        <form method="POST" action="{{ path('app_settings_delete') }}" class="space-y-5">
            <div>
                <label for="confirm_password" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2 flex items-center gap-2">
