                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="x-circle" class="w-4 h-4 text-red-500 flex-shrink-0"></i>
                    <span>All your courses and materials</span>
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="x-circle" class="w-4 h-4 text-red-500 flex-shrink-0"></i>
                    <span>All your flashcard decks</span>
                </li>
                <li class="flex items-center gap-2">
                    <i data-lucide="x-circle" class="w-4 h-4 text-red-500 flex-shrink-0"></i>
                    <span>Your profile and account data</span>
                </li>
