{% extends 'base.html.twig' %}

{% block title %}Wellbeing{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Stress & Wellbeing</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Track your mental health and find ways to relax</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_wellbeing_quiz') }}" class="btn btn-secondary">
                <i data-lucide="clipboard-check" class="w-5 h-5"></i>
                Take Assessment
            </a>
            <a href="{{ path('app_wellbeing_tools') }}" class="btn btn-secondary">
                <i data-lucide="heart" class="w-5 h-5"></i>
                Coping Tools
            </a>
            <a href="{{ path('app_wellbeing_checkin_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Daily Check-in
            </a>
        </div>
    </div>

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-{{ avg_stress <= 4 ? 'success' : (avg_stress <= 6 ? 'warning' : 'danger') }}-100 dark:bg-{{ avg_stress <= 4 ? 'success' : (avg_stress <= 6 ? 'warning' : 'danger') }}-900/30 flex items-center justify-center">
                    {% if avg_stress <= 4 %}
                        <span class="text-2xl" aria-hidden="true">😊</span>
                    {% elseif avg_stress <= 6 %}
                        <span class="text-2xl" aria-hidden="true">😐</span>
                    {% else %}
                        <span class="text-2xl" aria-hidden="true">😟</span>
                    {% endif %}
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ avg_stress }}<span class="text-lg text-secondary-400">/10</span></p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Avg. Stress Level</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                    <span class="text-2xl" aria-hidden="true">⚡</span>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ avg_energy }}<span class="text-lg text-secondary-400">/10</span></p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Avg. Energy Level</p>
                </div>
            </div>
        </div>
        <div class="card p-5">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <span class="text-2xl" aria-hidden="true">🌙</span>
                </div>
                <div>
                    <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ avg_sleep }}<span class="text-lg text-secondary-400">h</span></p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Avg. Sleep</p>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Stress Trend Chart -->
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                        <i data-lucide="trending-up" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                    </div>
                    <h2 class="font-semibold text-secondary-900 dark:text-white">Stress Trend (Last 10 Days)</h2>
                </div>
            </div>
            <div class="p-5">
                <div class="h-48">
                    <canvas id="stressChart"></canvas>
                </div>
                <div class="flex items-center justify-center gap-6 mt-5 pt-4 border-t border-secondary-200 dark:border-secondary-800">
                    <span class="flex items-center gap-2 text-xs text-secondary-500 dark:text-secondary-400">
                        <span class="w-3 h-3 rounded bg-success-500"></span>
                        Low (1-4)
                    </span>
                    <span class="flex items-center gap-2 text-xs text-secondary-500 dark:text-secondary-400">
                        <span class="w-3 h-3 rounded bg-warning-500"></span>
                        Medium (5-6)
                    </span>
                    <span class="flex items-center gap-2 text-xs text-secondary-500 dark:text-secondary-400">
                        <span class="w-3 h-3 rounded bg-danger-500"></span>
                        High (7-10)
                    </span>
                </div>
            </div>
        </div>

        <!-- Recent Check-ins -->
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                            <i data-lucide="clipboard-list" class="w-5 h-5 text-accent-600 dark:text-accent-400"></i>
                        </div>
                        <h2 class="font-semibold text-secondary-900 dark:text-white">Recent Check-ins</h2>
                    </div>
                    <div class="flex items-center gap-3">
                        <form method="get" action="{{ path('app_wellbeing') }}" class="flex items-center gap-2">
                            <select name="sort" onchange="this.form.submit()" class="text-sm border border-secondary-300 dark:border-secondary-700 rounded-lg px-3 py-1.5 bg-white dark:bg-secondary-800 text-secondary-700 dark:text-secondary-300 focus:outline-none focus:ring-2 focus:ring-primary-500">
                                <option value="entryDate" {{ app.request.query.get('sort') == 'entryDate' or app.request.query.get('sort') is null ? 'selected' : '' }}>Date (Newest)</option>
                                <option value="entryDate_asc" {{ app.request.query.get('sort') == 'entryDate_asc' ? 'selected' : '' }}>Date (Oldest)</option>
                                <option value="stressLevel_desc" {{ app.request.query.get('sort') == 'stressLevel_desc' ? 'selected' : '' }}>Stress (High → Low)</option>
                                <option value="stressLevel" {{ app.request.query.get('sort') == 'stressLevel' ? 'selected' : '' }}>Stress (Low → High)</option>
                                <option value="energyLevel_desc" {{ app.request.query.get('sort') == 'energyLevel_desc' ? 'selected' : '' }}>Energy (High → Low)</option>
                                <option value="energyLevel" {{ app.request.query.get('sort') == 'energyLevel' ? 'selected' : '' }}>Energy (Low → High)</option>
                            </select>
                        </form>
                        <a href="{{ path('app_wellbeing_checkins') }}" class="text-sm text-primary-600 dark:text-primary-400 hover:underline font-medium">View All</a>
                    </div>
                </div>
            </div>
            <div class="p-4 space-y-2 max-h-72 overflow-y-auto">
                {% for checkin in checkins|reverse|slice(0, 5) %}
                <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center
                        {% if checkin.mood == 'great' %}bg-success-100 dark:bg-success-900/30{% endif %}
                        {% if checkin.mood == 'good' %}bg-primary-100 dark:bg-primary-900/30{% endif %}
                        {% if checkin.mood == 'okay' %}bg-warning-100 dark:bg-warning-900/30{% endif %}
                        {% if checkin.mood == 'stressed' %}bg-danger-100 dark:bg-danger-900/30{% endif %}
                        {% if checkin.mood == 'tired' %}bg-secondary-100 dark:bg-secondary-900/30{% endif %}">
                        {% if checkin.mood == 'great' %}
                            <span class="text-xl" aria-hidden="true">😊</span>
                        {% elseif checkin.mood == 'good' %}
                            <span class="text-xl" aria-hidden="true">🙂</span>
                        {% elseif checkin.mood == 'okay' %}
                            <span class="text-xl" aria-hidden="true">😐</span>
                        {% elseif checkin.mood == 'stressed' %}
                            <span class="text-xl" aria-hidden="true">😟</span>
                        {% else %}
                            <span class="text-xl" aria-hidden="true">😴</span>
                        {% endif %}
                    </div>
                    <div class="flex-1">
                        <p class="font-medium text-secondary-900 dark:text-white capitalize">{{ checkin.mood }}</p>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">{{ checkin.entryDate|date('M j, Y') }}</p>
                    </div>
                    <div class="text-right text-sm">
                        <p class="text-secondary-700 dark:text-secondary-300">Stress: <span class="font-semibold">{{ checkin.stressLevel }}/10</span></p>
                        <p class="text-secondary-500 dark:text-secondary-400">Sleep: {{ checkin.sleepHours }}h</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Coping Tools -->
    <div class="card overflow-hidden">
        <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center">
                        <i data-lucide="heart" class="w-5 h-5 text-danger-600 dark:text-danger-400"></i>
                    </div>
                    <div>
                        <h2 class="font-semibold text-secondary-900 dark:text-white">Coping Tools</h2>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">Quick exercises to help you relax</p>
                    </div>
                </div>
                <a href="{{ path('app_wellbeing_tools') }}" class="text-sm text-primary-600 dark:text-primary-400 hover:underline font-medium">View All</a>
            </div>
        </div>
        <div class="p-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for tool in tools %}
                <button class="p-4 rounded-xl border border-secondary-200 dark:border-secondary-800 hover:border-{{ tool.color }}-400 dark:hover:border-{{ tool.color }}-600 hover:shadow-soft-md transition-all text-left group">
                    <div class="flex items-start gap-3">
                        <div class="w-11 h-11 rounded-xl bg-{{ tool.color }}-100 dark:bg-{{ tool.color }}-900/30 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                            {% if tool.icon == 'wind' %}
                                <i data-lucide="wind" class="w-5 h-5 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400"></i>
                            {% elseif tool.icon == 'sparkles' %}
                                <i data-lucide="sparkles" class="w-5 h-5 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400"></i>
                            {% elseif tool.icon == 'heart' %}
                                <i data-lucide="heart" class="w-5 h-5 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400"></i>
                            {% elseif tool.icon == 'clock' %}
                                <i data-lucide="timer" class="w-5 h-5 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400"></i>
                            {% elseif tool.icon == 'book' %}
                                <i data-lucide="book-open" class="w-5 h-5 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400"></i>
                            {% else %}
                                <i data-lucide="music" class="w-5 h-5 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400"></i>
                            {% endif %}
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-medium text-secondary-900 dark:text-white group-hover:text-{{ tool.color }}-600 dark:group-hover:text-{{ tool.color }}-400 transition-colors">{{ tool.name }}</h3>
                            <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-0.5 truncate-2">{{ tool.description }}</p>
                            <p class="text-xs text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400 mt-2 flex items-center gap-1">
                                <i data-lucide="clock" class="w-3 h-3"></i>
                                {{ tool.duration }}
                            </p>
                        </div>
                    </div>
                </button>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Prepare data for Chart.js
    const checkinData = [
        {% for checkin in checkins|reverse %}
        {
            date: '{{ checkin.entryDate|date('M j') }}',
            stress: {{ checkin.stressLevel }},
            color: {% if checkin.stressLevel <= 4 %}'rgba(34, 197, 94, 0.8)'{% elseif checkin.stressLevel <= 6 %}'rgba(234, 179, 8, 0.8)'{% else %}'rgba(239, 68, 68, 0.8)'{% endif %}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const ctx = document.getElementById('stressChart').getContext('2d');
    const isDark = document.documentElement.classList.contains('dark');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: checkinData.map(d => d.date),
            datasets: [{
                label: 'Stress Level',
                data: checkinData.map(d => d.stress),
                backgroundColor: checkinData.map(d => d.color),
                borderColor: checkinData.map(d => d.color.replace('0.8', '1')),
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: {
                padding: 0
            },
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: isDark ? 'rgba(30, 41, 59, 0.95)' : 'rgba(255, 255, 255, 0.95)',
                    titleColor: isDark ? '#f1f5f9' : '#1e293b',
                    bodyColor: isDark ? '#cbd5e1' : '#475569',
                    borderColor: isDark ? 'rgba(148, 163, 184, 0.2)' : 'rgba(148, 163, 184, 0.3)',
                    borderWidth: 1,
                    padding: 12,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return 'Stress: ' + context.parsed.y + '/10';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    max: 10,
                    ticks: {
                        color: isDark ? '#94a3b8' : '#64748b',
                        stepSize: 2
                    },
                    grid: {
                        color: isDark ? 'rgba(148, 163, 184, 0.1)' : 'rgba(148, 163, 184, 0.2)',
                        drawBorder: false
                    }
                },
                x: {
                    ticks: {
                        color: isDark ? '#94a3b8' : '#64748b'
                    },
                    grid: {
                        display: false
                    }
                }
            },
            interaction: {
                intersect: false,
                mode: 'index'
            },
            animation: {
                duration: 800,
                easing: 'easeOutQuart'
            }
        }
    });
</script>
{% endblock %}
