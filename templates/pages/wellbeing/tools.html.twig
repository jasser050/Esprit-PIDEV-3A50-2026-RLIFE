    @keyframes orbIdle { 0%,100%{transform:scale(1)} 50%{transform:scale(1.03)} }
    .tentacle { position:absolute; bottom:-14px; left:50%; width:2px; background:linear-gradient(180deg, rgba(34,211,238,.5), transparent); border-radius:2px; transform-origin:top center; animation: tentacleSway 3s ease-in-out infinite; opacity:0; }
    .t1{margin-left:-16px;} .t2{margin-left:-8px;} .t3{margin-left:0px;} .t4{margin-left:8px;} .t5{margin-left:16px;}
    @keyframes tentacleSway { 0%,100%{transform:translateX(-50%) rotate(0deg)} 50%{transform:translateX(-50%) rotate(8deg)} }
    .particle { position:absolute; border-radius:50%; pointer-events:none; animation: partFloat var(--pd,5s) ease-in-out infinite; animation-delay:var(--pdl,0s); }
    @keyframes partFloat { 0%,100%{transform:translateY(0) translateX(0) scale(1);opacity:.25} 50%{transform:translateY(-18px) translateX(5px) scale(1.3);opacity:.7} }
