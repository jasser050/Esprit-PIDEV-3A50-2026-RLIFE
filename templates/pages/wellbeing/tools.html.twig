        if (yogaExerciseTitle) yogaExerciseTitle.textContent = exercise.title;
        if (yogaExerciseDesc) yogaExerciseDesc.textContent = exercise.description;
        renderYogaLocalDemo(exercise.demo, exercise.gifKey || '');
        if (yogaStepCount) yogaStepCount.textContent = `${yogaStepIndex + 1}/${yogaExercises.length}`;
        if (yogaTimer) yogaTimer.textContent = `${yogaSecondsLeft}s`;
        if (yogaStatus && !yogaCompleted) {
            yogaStatus.textContent = `Exercise ${yogaStepIndex + 1} of ${yogaExercises.length}`;
        }
    }

    function nextYogaStep(autoStart = true) {
        stopYogaTimer();
        if (yogaStepIndex >= yogaExercises.length - 1) {
            finishYogaSession();
            return;
        }
        yogaStepIndex += 1;
        yogaSecondsLeft = 20;
        renderYogaStep();
        if (autoStart) startYogaTimer();
    }

    function finishYogaSession() {
        yogaCompleted = true;
        if (yogaExerciseTitle) yogaExerciseTitle.textContent = 'Session Complete';
        if (yogaExerciseDesc) yogaExerciseDesc.textContent = 'Great job. You completed all yoga exercises.';
        if (yogaTimer) yogaTimer.textContent = '0s';
        if (yogaStepCount) yogaStepCount.textContent = `${yogaExercises.length}/${yogaExercises.length}`;
        if (yogaStatus) yogaStatus.textContent = 'Yoga Coach: all exercises completed.';
        if (yogaNextBtn) yogaNextBtn.disabled = true;

        speakAssistant('Great job. You completed all yoga exercises.');
    }

    function startYogaTimer() {
