<script>
(function () {
    const tools = {{ tools|json_encode|raw }};

    const modal = document.getElementById('tool-modal');
    const closeBtn = document.getElementById('tool-modal-close');
    const laterBtn = document.getElementById('tool-modal-later');
    const startBtn = document.getElementById('tool-modal-start');

    const titleEl = document.getElementById('tool-modal-title');
    const descEl = document.getElementById('tool-modal-desc');
    const iconWrap = document.getElementById('tool-modal-icon');

    const timerWrap = document.getElementById('tool-modal-timer');
    const timerText = document.getElementById('tool-modal-time');

    let currentTool = null;
    let interval = null;
    let remaining = 0;

    function openModal(toolKey) {
        currentTool = tools.find(t => t.key === toolKey);
        if (!currentTool) return;

        titleEl.textContent = currentTool.name;
        descEl.textContent = currentTool.description;

        // reset timer
        clearInterval(interval);
        interval = null;
        remaining = Number(currentTool.durationSeconds || 0);
        timerWrap.classList.toggle('hidden', remaining <= 0);

        // icon (simple mapping)
        const iconMap = {
            wind: 'wind',
            sparkles: 'sparkles',
            heart: 'heart',
            clock: 'timer',
            book: 'book-open',
            music: 'music'
        };
        const lucideName = iconMap[currentTool.icon] || 'heart';
        iconWrap.innerHTML = `<i data-lucide="${lucideName}" class="w-10 h-10"></i>`;

        // refresh lucide icons
        if (window.lucide) window.lucide.createIcons();

        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        clearInterval(interval);
        interval = null;
    }

    function formatTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }

    function startTimer() {
        if (!currentTool) return;

        if (!remaining || remaining <= 0) {
            // Ongoing tool
            closeModal();
            return;
        }

        timerWrap.classList.remove('hidden');
        timerText.textContent = formatTime(remaining);

        clearInterval(interval);
        interval = setInterval(() => {
            remaining -= 1;
            timerText.textContent = formatTime(Math.max(remaining, 0));

            if (remaining <= 0) {
                clearInterval(interval);
                interval = null;
                closeModal();
            }
        }, 1000);
    }

    document.querySelectorAll('[data-open-tool]').forEach(btn => {
        btn.addEventListener('click', () => openModal(btn.getAttribute('data-open-tool')));
    });

    closeBtn.addEventListener('click', closeModal);
    laterBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    startBtn.addEventListener('click', startTimer);
})();
</script>
