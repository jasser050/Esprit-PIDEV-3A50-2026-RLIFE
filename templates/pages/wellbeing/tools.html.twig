{% extends 'base.html.twig' %}

{% block title %}Coping Tools - Wellbeing{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Wellbeing', url: path('app_wellbeing') },
            { label: 'Coping Tools' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Coping Tools',
        subtitle: 'Techniques and exercises to help you manage stress and improve wellbeing'
    } %}

    <!-- Quick Actions -->
    <div class="card p-6 bg-gradient-to-r from-primary-500 to-secondary-500 text-white">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold mb-2">Feeling overwhelmed?</h2>
                <p class="text-primary-100">Try a quick breathing exercise to help you relax and refocus.</p>
            </div>
            <button class="btn bg-white text-primary-600 hover:bg-primary-50" 
                    data-controller="modal" 
                    data-action="click->modal#open"
                    data-modal-target-param="breathing-modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Start Now
            </button>
        </div>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for tool in tools %}
        <div class="card p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-4">
                <div class="w-14 h-14 bg-{{ tool.color }}-100 dark:bg-{{ tool.color }}-900/30 rounded-2xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-7 h-7 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        {% if tool.icon == 'wind' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                        {% elseif tool.icon == 'sparkles' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                        {% elseif tool.icon == 'heart' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        {% elseif tool.icon == 'clock' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        {% elseif tool.icon == 'book' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        {% else %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                        {% endif %}
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="text-lg font-semibold mb-1">{{ tool.name }}</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted mb-3">{{ tool.description }}</p>
                    <div class="flex items-center justify-between">
                        <span class="badge badge-{{ tool.color }}">{{ tool.duration }}</span>
                        <button class="btn btn-sm btn-{{ tool.color }}">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Start
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Tips Section -->
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Quick Wellbeing Tips</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">💧</div>
                <h3 class="font-medium mb-1">Stay Hydrated</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Drink at least 8 glasses of water daily</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">🚶</div>
                <h3 class="font-medium mb-1">Take Breaks</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Walk for 5 mins every hour of studying</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">😴</div>
                <h3 class="font-medium mb-1">Sleep Well</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Aim for 7-8 hours of quality sleep</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">🎯</div>
                <h3 class="font-medium mb-1">Set Boundaries</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">It's okay to say no sometimes</p>
            </div>
        </div>
    </div>

    <!-- Resources -->
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Additional Resources</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors">
                <div class="w-10 h-10 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Crisis Helpline</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">24/7 support available</p>
                </div>
            </a>
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-secondary-50 dark:hover:bg-secondary-900/20 transition-colors">
                <div class="w-10 h-10 bg-secondary-100 dark:bg-secondary-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Counseling Services</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">Campus mental health</p>
                </div>
            </a>
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-accent-50 dark:hover:bg-accent-900/20 transition-colors">
                <div class="w-10 h-10 bg-accent-100 dark:bg-accent-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Self-Help Guides</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">Articles & resources</p>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- Breathing Exercise Modal -->
<div id="breathing-modal" class="modal" data-controller="modal">
    <div class="modal-content max-w-md text-center">
        <div class="p-8">
            <div class="w-32 h-32 mx-auto mb-6 rounded-full bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <span class="text-6xl">🌬️</span>
            </div>
            <h3 class="text-xl font-bold mb-2">4-7-8 Breathing</h3>
            <p class="text-light-muted dark:text-dark-muted mb-6">
                Breathe in for 4 seconds, hold for 7 seconds, exhale for 8 seconds. Repeat 4 times.
            </p>
            <div class="space-y-4">
                <button class="btn btn-primary w-full">Start Exercise</button>
                <button class="btn btn-secondary w-full" data-action="click->modal#close">Maybe Later</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
