                <div class="particle" style="width:3px;height:3px;background:rgba(103,232,249,.8);top:35%;right:18%;--pd:5.5s;--pdl:-.9s"></div>
                <div class="particle" style="width:4px;height:4px;background:rgba(124,58,237,.5);top:60%;left:10%;--pd:3.8s;--pdl:-.4s"></div>
                <div class="particle" style="width:3px;height:3px;background:rgba(34,211,238,.7);top:45%;right:12%;--pd:6.2s;--pdl:-1.3s"></div>
                <div class="particle" style="width:5px;height:5px;background:rgba(186,230,253,.4);top:70%;right:28%;--pd:4.8s;--pdl:-.7s"></div>
                <div class="particle" style="width:2px;height:2px;background:rgba(103,232,249,.9);top:18%;left:40%;--pd:5s;--pdl:-2s"></div>

                <div class="ripple" id="rip4"></div>
                <div class="ripple" id="rip3"></div>
                <div class="ripple" id="rip2"></div>
                <div class="ripple" id="rip1"></div>

                <svg class="arc-svg" id="arc-svg" width="180" height="180" viewBox="0 0 180 180">
                    <circle id="arc-track" cx="90" cy="90" r="90"/>
                    <circle id="arc-prog"  cx="90" cy="90" r="90"/>
                </svg>

                <div class="orb-outer" id="orb-outer">
                    <div class="orb" id="breathing-orb"></div>
                    <div id="breathing-aura" class="absolute inset-0 rounded-full opacity-50"></div>
