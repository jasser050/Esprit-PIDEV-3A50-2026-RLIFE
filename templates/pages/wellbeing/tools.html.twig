{% extends 'base.html.twig' %}

{% block title %}Coping Tools{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    {# Breadcrumb + Header (si tu utilises ces components, sinon tu peux enlever) #}
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Wellbeing', url: path('app_wellbeing') },
            { label: 'Coping Tools' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Coping Tools',
        subtitle: 'Techniques and exercises to help you manage stress and improve wellbeing'
    } %}

    {# Banner #}
    <div class="rounded-2xl p-6 bg-gradient-to-r from-primary-600 to-accent-500 text-white flex items-center justify-between gap-4">
        <div>
            <h3 class="text-xl font-semibold">Feeling overwhelmed?</h3>
            <p class="text-white/90 mt-1">Try a quick breathing exercise to help you relax and refocus.</p>
        </div>
        <button
            class="btn btn-white inline-flex items-center gap-2"
            data-open-tool="breathing"
            type="button"
        >
            <i data-lucide="play" class="w-4 h-4"></i>
            Start Now
        </button>
    </div>

    {# Tools cards #}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {% for tool in tools %}
            <div class="card p-5 flex items-center justify-between gap-4">
                <div class="flex items-center gap-4 min-w-0">
                    <div class="w-12 h-12 rounded-2xl bg-{{ tool.color }}-900/30 flex items-center justify-center flex-shrink-0">
                        {% if tool.icon == 'wind' %}
                            <i data-lucide="wind" class="w-6 h-6 text-{{ tool.color }}-400"></i>
                        {% elseif tool.icon == 'sparkles' %}
                            <i data-lucide="sparkles" class="w-6 h-6 text-{{ tool.color }}-400"></i>
                        {% elseif tool.icon == 'heart' %}
                            <i data-lucide="heart" class="w-6 h-6 text-{{ tool.color }}-400"></i>
                        {% elseif tool.icon == 'clock' %}
                            <i data-lucide="timer" class="w-6 h-6 text-{{ tool.color }}-400"></i>
                        {% elseif tool.icon == 'book' %}
                            <i data-lucide="book-open" class="w-6 h-6 text-{{ tool.color }}-400"></i>
                        {% else %}
                            <i data-lucide="music" class="w-6 h-6 text-{{ tool.color }}-400"></i>
                        {% endif %}
                    </div>

                    <div class="min-w-0">
                        <h3 class="font-semibold text-white truncate">{{ tool.name }}</h3>
                        <p class="text-sm text-dark-muted mt-0.5 truncate">{{ tool.description }}</p>
                        <div class="mt-2 text-xs text-{{ tool.color }}-400 inline-flex items-center gap-1">
                            <i data-lucide="clock" class="w-3 h-3"></i>
                            {{ tool.duration }}
                        </div>
                    </div>
                </div>

                <button
                    class="btn btn-secondary inline-flex items-center gap-2"
                    type="button"
                    data-open-tool="{{ tool.key }}"
                    data-duration-seconds="{{ tool.durationSeconds }}"
                >
                    <i data-lucide="play" class="w-4 h-4"></i>
                    Start
                </button>
            </div>
        {% endfor %}
    </div>

    {# Tips #}
    <div class="card p-6">
        <h3 class="text-lg font-semibold text-white mb-4">Quick Wellbeing Tips</h3>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="p-4 rounded-2xl bg-dark-surface/60">
                <div class="text-2xl">💧</div>
                <div class="font-semibold mt-2 text-white">Stay Hydrated</div>
                <div class="text-sm text-dark-muted mt-1">Drink at least 8 glasses of water daily</div>
            </div>
            <div class="p-4 rounded-2xl bg-dark-surface/60">
                <div class="text-2xl">🚶</div>
                <div class="font-semibold mt-2 text-white">Take Breaks</div>
                <div class="text-sm text-dark-muted mt-1">Walk for 5 mins every hour of studying</div>
            </div>
            <div class="p-4 rounded-2xl bg-dark-surface/60">
                <div class="text-2xl">😴</div>
                <div class="font-semibold mt-2 text-white">Sleep Well</div>
                <div class="text-sm text-dark-muted mt-1">Aim for 7-8 hours of quality sleep</div>
            </div>
            <div class="p-4 rounded-2xl bg-dark-surface/60">
                <div class="text-2xl">🎯</div>
                <div class="font-semibold mt-2 text-white">Set Boundaries</div>
                <div class="text-sm text-dark-muted mt-1">It’s okay to say no sometimes</div>
            </div>
        </div>
    </div>

    {# Modal simple (un seul modal, contenu change selon tool) #}
    <div id="tool-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
        <div class="w-full max-w-md rounded-3xl bg-dark-card shadow-soft-xl p-6 relative">
            <button id="tool-modal-close" class="absolute top-4 right-4 btn btn-ghost" type="button">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="flex flex-col items-center text-center gap-3">
                <div id="tool-modal-icon" class="w-20 h-20 rounded-full bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="wind" class="w-10 h-10 text-primary-400"></i>
                </div>

                <h3 id="tool-modal-title" class="text-xl font-semibold text-white">Tool</h3>
                <p id="tool-modal-desc" class="text-sm text-dark-muted">Description</p>

                <div id="tool-modal-timer" class="mt-2 text-sm text-dark-muted hidden">
                    Time left: <span id="tool-modal-time">00:00</span>
                </div>

                <button id="tool-modal-start" class="btn btn-primary w-full mt-4" type="button">
                    Start Exercise
                </button>
                <button id="tool-modal-later" class="btn btn-secondary w-full" type="button">
                    Maybe Later
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const tools = {{ tools|json_encode|raw }};

    const modal = document.getElementById('tool-modal');
    const closeBtn = document.getElementById('tool-modal-close');
    const laterBtn = document.getElementById('tool-modal-later');
    const startBtn = document.getElementById('tool-modal-start');

    const titleEl = document.getElementById('tool-modal-title');
    const descEl = document.getElementById('tool-modal-desc');
    const iconWrap = document.getElementById('tool-modal-icon');

    const timerWrap = document.getElementById('tool-modal-timer');
    const timerText = document.getElementById('tool-modal-time');

    let currentTool = null;
    let interval = null;
    let remaining = 0;

    function openModal(toolKey) {
        currentTool = tools.find(t => t.key === toolKey);
        if (!currentTool) return;

        titleEl.textContent = currentTool.name;
        descEl.textContent = currentTool.description;

        // reset timer
        clearInterval(interval);
        interval = null;
        remaining = Number(currentTool.durationSeconds || 0);
        timerWrap.classList.toggle('hidden', remaining <= 0);

        // icon (simple mapping)
        const iconMap = {
            wind: 'wind',
            sparkles: 'sparkles',
            heart: 'heart',
            clock: 'timer',
            book: 'book-open',
            music: 'music'
        };
        const lucideName = iconMap[currentTool.icon] || 'heart';
        iconWrap.innerHTML = `<i data-lucide="${lucideName}" class="w-10 h-10"></i>`;

        // refresh lucide icons
        if (window.lucide) window.lucide.createIcons();

        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        clearInterval(interval);
        interval = null;
    }

    function formatTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }

    function startTimer() {
        if (!currentTool) return;

        if (!remaining || remaining <= 0) {
            // Ongoing tool
            closeModal();
            return;
        }

        timerWrap.classList.remove('hidden');
        timerText.textContent = formatTime(remaining);

        clearInterval(interval);
        interval = setInterval(() => {
            remaining -= 1;
            timerText.textContent = formatTime(Math.max(remaining, 0));

            if (remaining <= 0) {
                clearInterval(interval);
                interval = null;
                closeModal();
            }
        }, 1000);
    }

    document.querySelectorAll('[data-open-tool]').forEach(btn => {
        btn.addEventListener('click', () => openModal(btn.getAttribute('data-open-tool')));
    });

    closeBtn.addEventListener('click', closeModal);
    laterBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    startBtn.addEventListener('click', startTimer);
})();
</script>
{% endblock %}
