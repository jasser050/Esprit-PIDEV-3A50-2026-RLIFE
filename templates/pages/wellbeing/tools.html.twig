        opacity:.7;
    }
    .modal-head { text-align:center; padding: 30px 28px 0; }
    .head-eyebrow { font-size:.6rem; letter-spacing:.28em; text-transform:uppercase; color:var(--aqua); margin-bottom:10px; }
    .head-title { font-family:var(--fh); font-size:2rem; font-weight:300; color:var(--text); margin-bottom:6px; }
    .head-sub { font-family:var(--fh); font-style:italic; font-size:.88rem; color:var(--text-m); }
    .stage { position:relative; margin:22px 20px 0; height:290px; border-radius:24px; overflow:hidden; background:radial-gradient(ellipse 100% 120% at 50% 110%, #041526 0%, #030810 70%); border:1px solid rgba(34,211,238,.07); }
    .caustic { position:absolute; inset:0; pointer-events:none;
        background: radial-gradient(ellipse 70% 50% at 50% 85%, rgba(8,145,178,.06) 0%, transparent 60%),
                    radial-gradient(ellipse 40% 30% at 20% 20%, rgba(6,182,212,.04) 0%, transparent 50%),
                    radial-gradient(ellipse 30% 25% at 80% 25%, rgba(124,58,237,.03) 0%, transparent 50%); }
    .light-ray { position:absolute; left:0; right:0; height:1px; top:30%;
        background:linear-gradient(90deg, transparent 0%, rgba(34,211,238,.25) 30%, rgba(103,232,249,.4) 50%, rgba(34,211,238,.25) 70%, transparent 100%);
        animation: rayFloat 8s ease-in-out infinite; }
    @keyframes rayFloat { 0%,100% { top:25%; opacity:.6; } 50% { top:45%; opacity:.3; } }
    .ripple { position:absolute; top:50%; left:50%; transform:translate(-50%,-58%); border-radius:50%; border:1px solid rgba(34,211,238,.15); pointer-events:none; transition:width .9s ease,height .9s ease,opacity .9s ease; }
    #rip1{width:100px;height:100px;} #rip2{width:140px;height:140px;border-color:rgba(34,211,238,.09);} #rip3{width:185px;height:185px;border-color:rgba(34,211,238,.05);} #rip4{width:232px;height:232px;border-color:rgba(34,211,238,.03);}
    .arc-svg { position:absolute; top:50%; left:50%; transform:translate(-50%,-58%) rotate(-90deg); pointer-events:none; z-index:3; }
    #arc-track{fill:none;stroke:rgba(34,211,238,.07);stroke-width:2;} #arc-prog{fill:none;stroke:var(--aqua-l);stroke-width:2;stroke-linecap:round;stroke-dasharray:565;stroke-dashoffset:565;filter:drop-shadow(0 0 4px var(--aqua));}
    .orb-outer { position:absolute; top:50%; left:50%; transform:translate(-50%,-58%); width:80px; height:80px; z-index:4; }
    .orb { width:100%; height:100%; border-radius:50%;
        background: radial-gradient(circle at 38% 32%, rgba(255,255,255,.35) 0%, rgba(103,232,249,.7) 20%, rgba(8,145,178,.85) 50%, rgba(3,56,120,.95) 80%, rgba(2,28,64,1) 100%);
        box-shadow:0 0 0 1px rgba(34,211,238,.4),0 0 30px rgba(6,182,212,.5),0 0 70px rgba(6,182,212,.2),inset 0 1px 0 rgba(255,255,255,.35),inset 0 -2px 8px rgba(0,0,100,.4);
        animation: orbIdle 4s ease-in-out infinite;
