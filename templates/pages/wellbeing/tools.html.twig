{% extends 'base.html.twig' %}

{% block title %}Coping Tools - Wellbeing{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Wellbeing', url: path('app_wellbeing') },
            { label: 'Coping Tools' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Coping Tools',
        subtitle: 'Techniques and exercises to help you manage stress and improve wellbeing'
    } %}

    <div class="card p-4">
        <div class="flex flex-wrap items-center gap-3">
            <label for="quote-type-select" class="text-sm font-medium text-slate-700 dark:text-slate-200">Quote Type</label>
            <select id="quote-type-select" class="px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
                <option value="motivation">Motivation</option>
                <option value="funny">Funny</option>
                <option value="calm">Calm</option>
                <option value="focus">Focus</option>
            </select>
            <p class="text-xs text-light-muted dark:text-dark-muted">Student can choose quote style for floating quotes.</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card p-6 bg-gradient-to-r from-primary-500 to-secondary-500 text-white">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold mb-2">Feeling overwhelmed?</h2>
                <p class="text-primary-100">Try a quick breathing exercise to help you relax and refocus.</p>
            </div>
            <button id="breathing-quick-cta" class="btn bg-white text-primary-600 hover:bg-primary-50">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Go to Breathing Tool
            </button>
        </div>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for tool in tools %}
        <div class="card p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-4">
                <div class="w-14 h-14 bg-{{ tool.color }}-100 dark:bg-{{ tool.color }}-900/30 rounded-2xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-7 h-7 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        {% if tool.icon == 'wind' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                        {% elseif tool.icon == 'sparkles' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                        {% elseif tool.icon == 'heart' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        {% elseif tool.icon == 'clock' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        {% elseif tool.icon == 'book' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        {% else %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                        {% endif %}
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="text-lg font-semibold mb-1">{{ tool.name }}</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted mb-3">{{ tool.description }}</p>
                    <div class="flex items-center justify-between">
                        <span class="badge badge-{{ tool.color }}">{{ tool.duration }}</span>
                        <button
                            class="btn btn-sm btn-{{ tool.color }} tool-start-btn"
                            data-tool-key="{{ tool.key|default('') }}"
                            data-tool-name="{{ tool.name|e('html_attr') }}"
                            data-tool-duration="{{ tool.duration|e('html_attr') }}"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Start
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Tips Section -->
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Quick Wellbeing Tips</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">💧</div>
                <h3 class="font-medium mb-1">Stay Hydrated</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Drink at least 8 glasses of water daily</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">🚶</div>
                <h3 class="font-medium mb-1">Take Breaks</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Walk for 5 mins every hour of studying</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">😴</div>
                <h3 class="font-medium mb-1">Sleep Well</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Aim for 7-8 hours of quality sleep</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">🎯</div>
                <h3 class="font-medium mb-1">Set Boundaries</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">It's okay to say no sometimes</p>
            </div>
        </div>
    </div>

    <!-- Resources -->
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Additional Resources</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors">
                <div class="w-10 h-10 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Crisis Helpline</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">24/7 support available</p>
                </div>
            </a>
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-secondary-50 dark:hover:bg-secondary-900/20 transition-colors">
                <div class="w-10 h-10 bg-secondary-100 dark:bg-secondary-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Counseling Services</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">Campus mental health</p>
                </div>
            </a>
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-accent-50 dark:hover:bg-accent-900/20 transition-colors">
                <div class="w-10 h-10 bg-accent-100 dark:bg-accent-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Self-Help Guides</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">Articles & resources</p>
                </div>
            </a>
        </div>
    </div>

    <section id="journal-focus" class="hidden space-y-6">
        <div class="card p-6">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="text-xs uppercase tracking-wide text-light-muted dark:text-dark-muted">Focus Session</p>
                    <h2 class="text-2xl font-bold">Gratitude Journal</h2>
                    <p class="text-light-muted dark:text-dark-muted">Write three things you're grateful for</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="badge badge-primary">2 min</span>
                    <span class="badge badge-secondary">Ready</span>
                </div>
            </div>
        </div>

        <div class="card p-6 space-y-4">
            <h3 class="text-xl font-semibold">Gratitude Journal</h3>
            <p class="text-light-muted dark:text-dark-muted">Write what you are grateful for. You can also dictate by voice.</p>

            <textarea id="journal-input" class="w-full min-h-[160px] rounded-xl border border-slate-300 dark:border-slate-700 px-4 py-3 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500"
                      placeholder="Example: 1) I am grateful for..."></textarea>

            <div class="flex flex-wrap items-center gap-3">
                <button id="start-voice-journal" class="btn btn-secondary">
                    <span class="inline-flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 1v11m0 0a3 3 0 003-3V6a3 3 0 10-6 0v3a3 3 0 003 3zm-7 0a7 7 0 0014 0m-7 7v4m-4 0h8"/></svg>
                        Start Voice Input
                    </span>
                </button>
                <button id="stop-voice-journal" class="btn btn-danger">Stop</button>
                <label for="journal-lang" class="text-sm font-medium">Language</label>
                <select id="journal-lang" class="px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">
                    <option value="">Auto (AI detect)</option>
                    <option value="en-US">English</option>
                    <option value="fr-FR">Francais</option>
                    <option value="ar-SA">Arabic</option>
                    <option value="ar-TN">Tunisian Arabic</option>
                </select>
                <span id="journal-status" class="text-sm text-light-muted dark:text-dark-muted">Voice: idle</span>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <button id="save-journal-entry" class="btn btn-primary">Save</button>
                <button id="new-journal-entry" class="btn btn-secondary">New Journal</button>
                <button id="back-to-tools" class="btn btn-secondary">Back to Coping Tools</button>
            </div>
        </div>

        <div class="card p-6">
            <h3 class="text-xl font-semibold mb-4">Recent Journal Entries</h3>
            <div id="journal-list" class="space-y-3"></div>
        </div>
    </section>

    <section id="yoga-focus" class="hidden space-y-6">
        <div class="card p-6">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="text-xs uppercase tracking-wide text-light-muted dark:text-dark-muted">Focus Session</p>
                    <h2 class="text-2xl font-bold">Yoga Coach</h2>
                    <p class="text-light-muted dark:text-dark-muted">Follow guided yoga exercises to reduce stress.</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="badge badge-secondary">20 sec</span>
                    <span id="yoga-step-count" class="badge badge-primary">1/4</span>
                </div>
            </div>
        </div>

        <div class="card p-6 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 id="yoga-exercise-title" class="text-xl font-semibold">Child Pose</h3>
                    <p id="yoga-exercise-desc" class="text-light-muted dark:text-dark-muted">Relax your back and breathe slowly.</p>
                </div>
                <div class="text-right">
                    <p class="text-sm text-light-muted dark:text-dark-muted">Time left</p>
                    <p id="yoga-timer" class="text-2xl font-bold">20s</p>
                </div>
            </div>

            <div class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-light-bg dark:bg-dark-bg p-3">
                <div id="yoga-demo-canvas" class="w-full rounded-xl bg-gradient-to-br from-primary-100/70 to-secondary-100/70 dark:from-slate-800 dark:to-slate-700 flex items-center justify-center relative overflow-hidden" style="min-height:300px;">
                    <div id="yoga-demo-shape" class="relative w-full h-full" style="height:300px;"></div>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <button id="yoga-start-btn" class="btn btn-primary">Start Yoga</button>
                <button id="yoga-next-btn" class="btn btn-secondary">Next Exercise</button>
                <button id="yoga-back-btn" class="btn btn-secondary">Back to Coping Tools</button>
            </div>
            <p id="yoga-status" class="text-sm text-light-muted dark:text-dark-muted">Click Start Yoga to begin.</p>
        </div>
    </section>

    <section id="ai-chat-focus" class="hidden space-y-6">
        <div class="card p-6">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="text-xs uppercase tracking-wide text-light-muted dark:text-dark-muted">Focus Session</p>
                    <h2 class="text-2xl font-bold">AI Chat Coach</h2>
                    <p class="text-light-muted dark:text-dark-muted">Discuss with AI for motivation, guidance, and practical support in any language.</p>
                </div>
                <span class="badge badge-accent">24/7</span>
            </div>
        </div>

        <div class="card p-6 space-y-4">
            <div id="ai-chat-messages" class="rounded-2xl border border-slate-300 dark:border-slate-700 bg-light-bg dark:bg-dark-bg p-4 h-[380px] overflow-y-auto space-y-3">
                <div class="text-sm text-light-muted dark:text-dark-muted">AI Coach: Bonjour, je suis la pour vous aider. De quoi avez-vous besoin maintenant ?</div>
            </div>

            <div class="space-y-3">
                <textarea id="ai-chat-input" class="w-full min-h-[110px] rounded-xl border border-slate-300 dark:border-slate-700 px-4 py-3 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500" placeholder="Write your message in any language..."></textarea>
                <div class="flex flex-wrap items-center gap-3">
                    <button id="ai-chat-send-btn" class="btn btn-primary">Send</button>
                    <button id="ai-chat-clear-btn" class="btn btn-secondary">New conversation</button>
                    <button id="ai-chat-back-btn" class="btn btn-secondary">Back to Coping Tools</button>
                    <span id="ai-chat-status" class="text-sm text-light-muted dark:text-dark-muted">Ready</span>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Breathing Exercise Modal -->
<div id="breathing-modal" class="modal hidden" data-controller="modal">
    <div class="modal-content max-w-xl">
        <div class="p-8 space-y-6 bg-gradient-to-b from-[#0f1c4d] to-[#0a1438] rounded-2xl">
            <div class="text-center">
                <p class="text-xs uppercase tracking-widest text-cyan-200/80">Relax Session</p>
                <h3 class="text-2xl font-bold text-white mt-1">Assistant Respiration</h3>
                <p class="text-cyan-100/90 mt-2">Voix douce et guidage lent pour calmer le stress.</p>
            </div>

            <div class="rounded-2xl border border-cyan-300/20 bg-cyan-900/10 p-6">
                <div class="mx-auto relative w-40 h-40 flex items-center justify-center">
                    <div id="breathing-aura" class="absolute inset-0 rounded-full bg-cyan-300/20 blur-md transition-all duration-1000"></div>
                    <div id="breathing-orb" class="w-32 h-32 rounded-full bg-gradient-to-br from-cyan-300/70 to-blue-400/70 shadow-[0_0_45px_rgba(59,130,246,0.45)] transition-all duration-1000"></div>
                </div>
                <p id="breathing-phase" class="text-center text-cyan-100 font-semibold mt-4">Ready to breathe</p>
                <p class="text-center text-cyan-100/80 text-sm mt-1">Pattern: Inhale 4s, Hold 7s, Exhale 8s</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button id="breathing-voice-start" class="btn btn-primary w-full">Start Voice Assistant</button>
                <button id="breathing-voice-stop" class="btn btn-danger w-full">Stop Voice</button>
                <button id="breathing-manual-start" class="btn btn-secondary w-full">Start Visual Only</button>
                <button id="breathing-close-btn" class="btn btn-secondary w-full" data-action="click->modal#close">Close</button>
            </div>

            <p id="breathing-status" class="text-center text-sm text-cyan-100/80">Assistant status: idle</p>
        </div>
    </div>
</div>

{% include 'pages/wellbeing/_tools_script.html.twig' %}

{% endblock %}
