{% extends 'base.html.twig' %}

{% block title %}Coping Tools - Wellbeing{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Wellbeing', url: path('app_wellbeing') },
            { label: 'Coping Tools' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Coping Tools',
        subtitle: 'Techniques and exercises to help you manage stress and improve wellbeing'
    } %}

    <div class="card p-4">
        <div class="flex flex-wrap items-center gap-3">
            <label for="quote-type-select" class="text-sm font-medium text-slate-700 dark:text-slate-200">Quote Type</label>
            <select id="quote-type-select" class="px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
                <option value="motivation">Motivation</option>
                <option value="funny">Funny</option>
                <option value="calm">Calm</option>
                <option value="focus">Focus</option>
            </select>
            <label class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
                <input id="quote-enabled-toggle" type="checkbox" class="rounded border-slate-300 dark:border-slate-700">
                <span>Enable quotes</span>
            </label>
            <button id="quote-position-reset" class="btn btn-sm btn-secondary">Reset position</button>
            <p class="text-xs text-light-muted dark:text-dark-muted">Drag the quote card to any position on screen.</p>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card p-6 bg-gradient-to-r from-primary-500 to-secondary-500 text-white">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-xl font-bold mb-2">Feeling overwhelmed?</h2>
                <p class="text-primary-100">Try a quick breathing exercise to help you relax and refocus.</p>
            </div>
            <button id="breathing-quick-cta" class="btn bg-white text-primary-600 hover:bg-primary-50">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Go to Breathing Tool
            </button>
        </div>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for tool in tools %}
        <div class="card p-6 hover:shadow-lg transition-shadow">
            <div class="flex items-start gap-4">
                <div class="w-14 h-14 bg-{{ tool.color }}-100 dark:bg-{{ tool.color }}-900/30 rounded-2xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-7 h-7 text-{{ tool.color }}-600 dark:text-{{ tool.color }}-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        {% if tool.icon == 'wind' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                        {% elseif tool.icon == 'sparkles' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                        {% elseif tool.icon == 'heart' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        {% elseif tool.icon == 'clock' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        {% elseif tool.icon == 'book' %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        {% else %}
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
                        {% endif %}
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="text-lg font-semibold mb-1">{{ tool.name }}</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted mb-3">{{ tool.description }}</p>
                    <div class="flex items-center justify-between">
                        <span class="badge badge-{{ tool.color }}">{{ tool.duration }}</span>
                        <button
                            class="btn btn-sm btn-{{ tool.color }} tool-start-btn"
                            data-tool-key="{{ tool.key|default('') }}"
                            data-tool-name="{{ tool.name|e('html_attr') }}"
                            data-tool-duration="{{ tool.duration|e('html_attr') }}"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Start
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Tips Section -->
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Quick Wellbeing Tips</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">💧</div>
                <h3 class="font-medium mb-1">Stay Hydrated</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Drink at least 8 glasses of water daily</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">🚶</div>
                <h3 class="font-medium mb-1">Take Breaks</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Walk for 5 mins every hour of studying</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">😴</div>
                <h3 class="font-medium mb-1">Sleep Well</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">Aim for 7-8 hours of quality sleep</p>
            </div>
            <div class="p-4 rounded-xl bg-light-bg dark:bg-dark-bg">
                <div class="text-2xl mb-2">🎯</div>
                <h3 class="font-medium mb-1">Set Boundaries</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted">It's okay to say no sometimes</p>
            </div>
        </div>
    </div>

    <!-- Resources -->
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Additional Resources</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors">
                <div class="w-10 h-10 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Crisis Helpline</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">24/7 support available</p>
                </div>
            </a>
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-secondary-50 dark:hover:bg-secondary-900/20 transition-colors">
                <div class="w-10 h-10 bg-secondary-100 dark:bg-secondary-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Counseling Services</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">Campus mental health</p>
                </div>
            </a>
            <a href="#" class="flex items-center gap-4 p-4 rounded-xl bg-light-bg dark:bg-dark-bg hover:bg-accent-50 dark:hover:bg-accent-900/20 transition-colors">
                <div class="w-10 h-10 bg-accent-100 dark:bg-accent-900/30 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <div>
                    <h3 class="font-medium">Self-Help Guides</h3>
                    <p class="text-sm text-light-muted dark:text-dark-muted">Articles & resources</p>
                </div>
            </a>
        </div>
    </div>

    <section id="journal-focus" class="hidden space-y-6 journal-theme">
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Merriweather:ital,wght@0,300;0,700;1,300&display=swap');
            .journal-theme {
                --bg: #060d1f;
                --bg2: #0a1428;
                --card: #0d1b35;
                --card2: #0f2040;
                --border: rgba(99,155,255,.12);
                --border2: rgba(99,155,255,.22);
                --blue: #3b82f6;
                --blue-light: #60a5fa;
                --blue-glow: #1d4ed8;
                --cyan: #06b6d4;
                --cyan-soft: #67e8f9;
                --indigo: #6366f1;
                --text: #e2eaf8;
                --text-soft: #8ba3cc;
                --text-muted: #4a6490;
                --danger: #ef4444;
                --success: #10b981;
                font-family: 'Sora', sans-serif;
            }
            .journal-theme .journal-wrap { display: flex; flex-direction: column; gap: 18px; }
            .journal-theme .session-card {
                background: linear-gradient(135deg, #0d1e3f 0%, #0a1728 50%, #0d2040 100%);
                border: 1px solid var(--border2);
                border-radius: 22px;
                padding: 24px 28px;
                display: flex; align-items: center; justify-content: space-between; gap: 16px;
                position: relative; overflow: hidden;
            }
            .journal-theme .session-card::before {
                content: '';
                position: absolute;
                top: 0; left: 40px; right: 40px; height: 1px;
                background: linear-gradient(90deg, transparent, rgba(96,165,250,.5), var(--cyan-soft), rgba(96,165,250,.5), transparent);
            }
            .journal-theme .session-card::after {
                content: '✦';
                position: absolute; right: 28px; bottom: 16px;
                font-size: 5rem; line-height: 1;
                background: linear-gradient(135deg, rgba(59,130,246,.08), rgba(6,182,212,.04));
                -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            }
            .journal-theme .session-label {
                font-size: .65rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--cyan);
                margin-bottom: 7px; display: flex; align-items: center; gap: 7px;
            }
            .journal-theme .session-label::before { content: ''; width: 20px; height: 1px; background: var(--cyan); opacity: .6; }
            .journal-theme .session-title {
                font-family: 'Merriweather', serif; font-size: 1.75rem; font-weight: 700; color: var(--text); line-height: 1.12;
            }
            .journal-theme .session-sub {
                font-size: .82rem; color: var(--text-muted); font-family: 'Merriweather', serif; font-style: italic;
            }
            .journal-theme .badge-blue {
                padding: 6px 15px; border-radius: 100px; font-size: .7rem; font-weight: 600;
                background: rgba(59,130,246,.12); border: 1px solid rgba(59,130,246,.3); color: var(--blue-light);
            }
            .journal-theme .badge-cyan {
                padding: 6px 15px; border-radius: 100px; font-size: .7rem; font-weight: 600;
                background: rgba(6,182,212,.1); border: 1px solid rgba(6,182,212,.28); color: var(--cyan-soft);
            }
            .journal-theme .journal-card {
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 32px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(99,155,255,.04);
                position: relative;
            }
            .journal-theme .card-head { padding: 22px 26px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 14px; }
            .journal-theme .head-icon {
                width: 44px; height: 44px; border-radius: 14px;
                background: linear-gradient(135deg, rgba(59,130,246,.25), rgba(6,182,212,.15));
                border: 1px solid rgba(59,130,246,.25);
                display: flex; align-items: center; justify-content: center;
                box-shadow: 0 0 20px rgba(59,130,246,.15);
            }
            .journal-theme .head-title { font-family: 'Merriweather', serif; font-size: 1.14rem; font-weight: 700; color: var(--text); }
            .journal-theme .head-desc { font-size: .78rem; color: var(--text-muted); font-style: italic; font-family: 'Merriweather', serif; }
            .journal-theme .textarea-section { padding: 20px 26px 0; }
            .journal-theme #journal-input {
                width: 100%; min-height: 170px; padding: 16px 18px;
                font-size: .92rem; font-weight: 300; color: var(--text); line-height: 1.7;
                background: rgba(255,255,255,.03); border: 1px solid var(--border); border-radius: 14px;
                outline: none; resize: vertical;
            }
            .journal-theme #journal-input:focus {
                border-color: rgba(59,130,246,.45);
                background: rgba(59,130,246,.03);
                box-shadow: 0 0 0 3px rgba(59,130,246,.08), 0 0 30px rgba(59,130,246,.06);
            }
            .journal-theme .textarea-meta { display: flex; justify-content: flex-end; padding: 6px 4px 0; }
            .journal-theme .char-count { font-size: .67rem; color: var(--text-muted); opacity: .6; }
            .journal-theme .voice-row { padding: 14px 26px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; border-bottom: 1px solid var(--border); }
            .journal-theme .vbtn { display: inline-flex; align-items: center; gap: 7px; padding: 8px 16px; border-radius: 10px; font-size: .78rem; font-weight: 500; cursor: pointer; border: none; }
            .journal-theme .vbtn-start { background: rgba(59,130,246,.12); border: 1px solid rgba(59,130,246,.25); color: var(--blue-light); }
            .journal-theme .vbtn-stop { background: rgba(239,68,68,.1); border: 1px solid rgba(239,68,68,.2); color: #fca5a5; }
            .journal-theme .lang-sep { width: 1px; height: 20px; background: var(--border); margin: 0 2px; }
            .journal-theme .lang-label { font-size: .74rem; color: var(--text-muted); font-weight: 500; }
            .journal-theme #journal-lang { padding: 7px 12px; border-radius: 10px; border: 1px solid var(--border); background: rgba(255,255,255,.04); color: var(--text-soft); font-size: .76rem; }
            .journal-theme .voice-status { margin-left: auto; display: flex; align-items: center; gap: 6px; font-size: .72rem; color: var(--text-muted); }
            .journal-theme .status-indicator { width: 7px; height: 7px; border-radius: 50%; background: var(--text-muted); }
            .journal-theme .status-indicator.active { background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
            .journal-theme .actions-row { padding: 16px 26px 22px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
            .journal-theme .abtn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; border-radius: 12px; font-size: .84rem; font-weight: 600; cursor: pointer; border: none; }
            .journal-theme .abtn-save { background: linear-gradient(135deg, var(--blue) 0%, var(--indigo) 100%); color: white; }
            .journal-theme .abtn-new { background: rgba(255,255,255,.05); color: var(--text-soft); border: 1px solid var(--border); }
            .journal-theme .abtn-back { background: transparent; color: var(--text-muted); border: 1px solid rgba(255,255,255,.06); }
            .journal-theme .entries-card { background: var(--card); border: 1px solid var(--border); border-radius: 22px; overflow: hidden; box-shadow: 0 16px 48px rgba(0,0,0,.3); }
            .journal-theme .entries-head { padding: 18px 26px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
            .journal-theme .entries-title { font-family: 'Merriweather', serif; font-size: 1.02rem; font-weight: 700; color: var(--text); }
            .journal-theme .entries-pill { margin-left: auto; font-size: .68rem; font-weight: 600; color: var(--cyan-soft); background: rgba(6,182,212,.1); border: 1px solid rgba(6,182,212,.2); padding: 3px 12px; border-radius: 100px; }
            .journal-theme .entries-list { padding: 14px 18px 18px; display: flex; flex-direction: column; gap: 10px; }
            .journal-theme .entry-item { background: rgba(255,255,255,.025); border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; }
            .journal-theme .entry-date { font-size: .68rem; color: var(--text-muted); letter-spacing: .06em; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
            .journal-theme .entry-date-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); opacity: .6; }
            .journal-theme .entry-text { font-family: 'Merriweather', serif; font-size: .95rem; font-weight: 300; font-style: italic; color: var(--text-soft); line-height: 1.6; white-space: pre-wrap; }
            .journal-theme .entry-actions { margin-top: 12px; display: flex; gap: 7px; }
            .journal-theme .ebtn { padding: 5px 14px; border-radius: 8px; font-size: .7rem; font-weight: 600; cursor: pointer; border: none; }
            .journal-theme .ebtn-edit { background: rgba(99,102,241,.1); color: #a5b4fc; border: 1px solid rgba(99,102,241,.2); }
            .journal-theme .ebtn-delete { background: rgba(239,68,68,.08); color: #fca5a5; border: 1px solid rgba(239,68,68,.15); }
            .journal-theme .entries-empty { padding: 40px 26px; text-align: center; color: var(--text-muted); }
        </style>

        <div class="journal-wrap">
            <div class="session-card">
                <div>
                    <p class="session-label">Focus Session</p>
                    <h2 class="session-title">Gratitude Journal</h2>
                    <p class="session-sub">Write three things you're grateful for</p>
                </div>
                <div class="badges">
                    <span class="badge-blue">2 min</span>
                    <span class="badge-cyan">Ready</span>
                </div>
            </div>

            <div class="journal-card">
                <div class="card-head">
                    <div class="head-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="head-title">Gratitude Journal</h3>
                        <p class="head-desc">Write what you are grateful for. You can also dictate by voice.</p>
                    </div>
                </div>

                <div class="textarea-section">
                    <textarea id="journal-input" placeholder="Example: 1) I am grateful for...&#10;2) Today I appreciate...&#10;3) Something beautiful I noticed..."></textarea>
                    <div class="textarea-meta">
                        <span class="char-count" id="char-count">0 characters</span>
                    </div>
                </div>

                <div class="voice-row">
                    <button class="vbtn vbtn-start" id="start-voice-journal">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 1v11m0 0a3 3 0 003-3V6a3 3 0 10-6 0v3a3 3 0 003 3zm-7 0a7 7 0 0014 0m-7 7v4m-4 0h8"/>
                        </svg>
                        Start Voice Input
                    </button>
                    <button class="vbtn vbtn-stop" id="stop-voice-journal">Stop</button>
                    <div class="lang-sep"></div>
                    <span class="lang-label">Language</span>
                    <select id="journal-lang">
                        <option value="">Auto (AI detect)</option>
                        <option value="en-US">English</option>
                        <option value="fr-FR">Francais</option>
                        <option value="ar-SA">Arabic</option>
                        <option value="ar-TN">Tunisian Arabic</option>
                    </select>
                    <div class="voice-status">
