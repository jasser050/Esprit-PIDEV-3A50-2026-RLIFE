                <div class="countdown" id="countdown"></div>

                <div class="phase-wrap">
                    <p class="phase-text" id="breathing-phase">Ready to breathe</p>
                    <p class="phase-pattern">Pattern: Inhale 4s · Hold 7s · Exhale 8s</p>
