            </div>

            <div class="phase-dots">
                <div class="pdot active" id="dot-i"></div>
                <div class="pdot" id="dot-h"></div>
                <div class="pdot" id="dot-e"></div>
            </div>

            <div class="btn-grid">
                <button id="breathing-voice-start" class="btn btn-voice">Start Voice Assistant</button>
                <button id="breathing-voice-stop" class="btn btn-stop">Stop Voice</button>
                <button id="breathing-manual-start" class="btn btn-visual">Start Visual Only</button>
                <button id="breathing-close-btn" class="btn btn-close" data-action="click->modal#close">Close</button>
            </div>

            <div class="status-bar">
                <span class="status-dot breathing-status-dot"></span>
                <span class="status-label" id="breathing-status">Assistant status: idle</span>
            </div>
        </div>
    </div>
</div>

<style>
            @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    /* Global typography for these interfaces */
