<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Wellbeing Report</title>
    <style>
        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            font-size: 12px;
            line-height: 1.6;
            color: #333;
        }
        .header {
            text-align: center;
            border-bottom: 3px solid #6366f1;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .header h1 {
            color: #6366f1;
            font-size: 28px;
            margin: 0;
        }
        .header p {
            color: #666;
            margin: 10px 0 0 0;
        }
        .stats-grid {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }
        .stat-box {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
            width: 30%;
        }
        .stat-value {
            font-size: 24px;
            font-weight: bold;
        }
        .stat-label {
            font-size: 10px;
            opacity: 0.9;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th {
            background: #6366f1;
            color: white;
            padding: 12px;
            text-align: left;
            font-size: 11px;
        }
        td {
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
        }
        tr:nth-child(even) {
            background: #f9fafb;
        }
        .mood-great { color: #22c55e; }
        .mood-good { color: #3b82f6; }
        .mood-okay { color: #f59e0b; }
        .mood-stressed { color: #ef4444; }
        .mood-tired { color: #6b7280; }
        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 10px;
            color: #999;
            border-top: 1px solid #e5e7eb;
            padding-top: 20px;
        }
        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: bold;
        }
        .badge-low { background: #dcfce7; color: #166534; }
        .badge-medium { background: #fef3c7; color: #92400e; }
        .badge-high { background: #fee2e2; color: #991b1b; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Mental Wellness Report</h1>
        <p>Generated on {{ exportDate|date('F j, Y') }}</p>
        {% if start_date or end_date %}
        <p style="font-size: 10px; margin-top: 5px;">
            Period: {{ start_date ? start_date|date('M j, Y') : 'All time' }} - {{ end_date ? end_date|date('M j, Y') : 'Present' }}
        </p>
        {% endif %}
    </div>

    <div class="stats-grid">
        <div class="stat-box">
            <div class="stat-value">{{ avg_stress }}</div>
            <div class="stat-label">Avg. Stress Level</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ avg_energy }}</div>
            <div class="stat-label">Avg. Energy Level</div>
        </div>
        <div class="stat-box">
            <div class="stat-value">{{ avg_sleep }}h</div>
            <div class="stat-label">Avg. Sleep</div>
        </div>
    </div>

    <h2 style="color: #6366f1; margin-bottom: 15px;">Check-in History</h2>
    
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Mood</th>
                <th>Stress</th>
                <th>Energy</th>
                <th>Sleep</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            {% for checkin in checkins %}
            <tr>
                <td>{{ checkin.entryDate|date('M j, Y H:i') }}</td>
                <td class="mood-{{ checkin.mood }}">
                    {% if checkin.mood == 'great' %}😊 Great
                    {% elseif checkin.mood == 'good' %}🙂 Good
                    {% elseif checkin.mood == 'okay' %}😐 Okay
                    {% elseif checkin.mood == 'stressed' %}😟 Stressed
                    {% else %}😴 Tired{% endif %}
                </td>
                <td>
                    <span class="badge badge-{{ checkin.stressLevel <= 4 ? 'low' : (checkin.stressLevel <= 6 ? 'medium' : 'high') }}">
                        {{ checkin.stressLevel }}/10
                    </span>
                </td>
                <td>{{ checkin.energyLevel }}/10</td>
                <td>{{ checkin.sleepHours }}h</td>
                <td>{{ checkin.note ?: '-' }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        <p>RLife Student Planning App - Wellbeing Module</p>
        <p>This report contains {{ checkins|length }} check-in entries</p>
    </div>
</body>
</html>