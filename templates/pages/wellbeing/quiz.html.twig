{% extends 'pages/base.html.twig' %}

{% block title %}Stress Quiz{% endblock %}

{% block body %}
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">Stress Quiz</h1>
        <p class="text-slate-500">Réponds à toutes les questions (0 → 4)</p>
      </div>
    </div>

    <form id="stressQuizForm" class="space-y-4">
      {% for q in questions %}
        <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/60 dark:bg-slate-900/40">
          <p class="font-semibold mb-3">{{ loop.index }}. {{ q.questionText }}</p>

          <div class="grid grid-cols-1 sm:grid-cols-5 gap-2">
            {% for v in 0..4 %}
              <label class="px-3 py-2 rounded-lg border cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800">
                <input type="radio" name="q{{ q.id }}" value="{{ v }}" required>
                <span class="ml-2">{{ v }}</span>
              </label>
            {% endfor %}
          </div>
        </div>
      {% endfor %}

      <button type="submit" class="btn btn-primary">Submit</button>
    </form>

    <div id="resultBox" class="hidden p-4 rounded-xl border"></div>
  </div>

