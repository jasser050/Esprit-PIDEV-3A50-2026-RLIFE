{% extends 'base.html.twig' %}

{% block title %}New Check-in - Wellbeing{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Wellbeing', url: path('app_wellbeing') },
            { label: 'Check-ins', url: path('app_wellbeing_checkins') },
            { label: 'New Check-in' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Daily Check-in',
        subtitle: 'How are you feeling today?'
    } %}

    <form method="POST" action="{{ path('app_wellbeing_checkin_new') }}" class="space-y-6">
        <div class="card p-6">
            <h2 class="text-lg font-semibold mb-6">Mood</h2>
            <p class="text-sm text-light-muted dark:text-dark-muted mb-4">Select the emoji that best represents how you're feeling</p>
            
            <div class="grid grid-cols-5 gap-4">
                {% set moods = [
                    { value: 'great', emoji: '😊', label: 'Great' },
                    { value: 'good', emoji: '🙂', label: 'Good' },
                    { value: 'okay', emoji: '😐', label: 'Okay' },
                    { value: 'stressed', emoji: '😟', label: 'Stressed' },
                    { value: 'tired', emoji: '😴', label: 'Tired' }
                ] %}
                
                {% for mood in moods %}
                <label class="relative cursor-pointer">
                    <input type="radio" name="mood" value="{{ mood.value }}" class="peer sr-only" {{ loop.index == 2 ? 'checked' : '' }}>
                    <div class="p-4 rounded-xl border-2 border-light-border dark:border-dark-border text-center transition-all
                                peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20
                                hover:border-primary-300 dark:hover:border-primary-700">
                        <span class="text-4xl block mb-2">{{ mood.emoji }}</span>
                        <span class="text-sm font-medium">{{ mood.label }}</span>
                    </div>
                </label>
                {% endfor %}
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Stress Level -->
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Stress Level</h2>
                <p class="text-sm text-light-muted dark:text-dark-muted mb-4">Rate your current stress (1 = very relaxed, 10 = very stressed)</p>
                
                <div class="space-y-4">
                    <input type="range" name="stress_level" min="1" max="10" value="5" 
                           class="w-full h-2 bg-light-border dark:bg-dark-border rounded-lg appearance-none cursor-pointer accent-primary-600"
                           oninput="document.getElementById('stress-value').textContent = this.value">
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-success-600 dark:text-success-400">Relaxed</span>
                        <span id="stress-value" class="text-2xl font-bold">5</span>
                        <span class="text-sm text-danger-600 dark:text-danger-400">Stressed</span>
                    </div>
                    <div class="flex justify-between text-xs text-light-muted dark:text-dark-muted">
                        {% for i in 1..10 %}
                        <span>{{ i }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Energy Level -->
            <div class="card p-6">
                <h2 class="text-lg font-semibold mb-4">Energy Level</h2>
                <p class="text-sm text-light-muted dark:text-dark-muted mb-4">Rate your energy (1 = exhausted, 10 = full of energy)</p>
                
                <div class="space-y-4">
                    <input type="range" name="energy_level" min="1" max="10" value="7" 
                           class="w-full h-2 bg-light-border dark:bg-dark-border rounded-lg appearance-none cursor-pointer accent-accent-600"
                           oninput="document.getElementById('energy-value').textContent = this.value">
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-danger-600 dark:text-danger-400">Exhausted</span>
                        <span id="energy-value" class="text-2xl font-bold">7</span>
                        <span class="text-sm text-success-600 dark:text-success-400">Energized</span>
                    </div>
                    <div class="flex justify-between text-xs text-light-muted dark:text-dark-muted">
                        {% for i in 1..10 %}
                        <span>{{ i }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Sleep Hours -->
        <div class="card p-6">
            <h2 class="text-lg font-semibold mb-4">Sleep</h2>
            <p class="text-sm text-light-muted dark:text-dark-muted mb-4">How many hours did you sleep last night?</p>
            
            <div class="grid grid-cols-8 gap-2">
                {% for hours in [4, 5, 6, 7, 8, 9, 10, '10+'] %}
                <label class="relative cursor-pointer">
                    <input type="radio" name="sleep_hours" value="{{ hours is same as('10+') ? 11 : hours }}" class="peer sr-only" {{ hours == 7 ? 'checked' : '' }}>
                    <div class="p-3 rounded-xl border-2 border-light-border dark:border-dark-border text-center transition-all
                                peer-checked:border-secondary-500 peer-checked:bg-secondary-50 dark:peer-checked:bg-secondary-900/20
                                hover:border-secondary-300 dark:hover:border-secondary-700">
                        <span class="text-lg font-bold">{{ hours }}</span>
                        <span class="text-xs block text-light-muted dark:text-dark-muted">hrs</span>
                    </div>
                </label>
                {% endfor %}
            </div>
        </div>

        <!-- Notes -->
        <div class="card p-6">
            <h2 class="text-lg font-semibold mb-4">Notes (Optional)</h2>
            {% include 'components/textarea.html.twig' with {
                name: 'notes',
                placeholder: 'How are you feeling? What\'s on your mind? Any particular reason for your current mood?',
                rows: 4
            } %}
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4">
            {% include 'components/button.html.twig' with {
                type: 'submit',
                label: 'Save Check-in',
                variant: 'primary',
                icon: 'check'
            } %}
            <a href="{{ path('app_wellbeing_checkins') }}" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
