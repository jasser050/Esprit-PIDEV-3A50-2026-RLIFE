{% extends 'base.html.twig' %}

{% block title %}Quiz Results{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-8 quiz-results-theme">
    {% set level_config = {
        'minimal': {
            'emoji': '&#128522;',
            'gradient': 'from-emerald-300 via-cyan-300 to-sky-400',
            'badge': 'from-emerald-400/30 to-cyan-400/30 text-emerald-100 border-emerald-300/40',
            'title': 'Great Job!',
            'subtitle': 'Your stress levels are well managed',
            'encouragement': 'Keep up the excellent work!'
        },
        'mild': {
            'emoji': '&#128578;',
            'gradient': 'from-cyan-300 via-blue-300 to-indigo-400',
            'badge': 'from-cyan-400/30 to-indigo-400/30 text-cyan-100 border-cyan-300/40',
            'title': 'Good Results!',
            'subtitle': 'You are doing well',
            'encouragement': 'A few small adjustments will help!'
        },
        'moderate': {
            'emoji': '&#128528;',
            'gradient': 'from-amber-300 via-orange-300 to-pink-400',
            'badge': 'from-amber-400/30 to-orange-400/30 text-amber-100 border-amber-300/40',
            'title': 'Time to Focus',
            'subtitle': 'Your stress is at a moderate level',
            'encouragement': 'Let us work on some strategies together!'
        },
        'high': {
            'emoji': '&#128560;',
            'gradient': 'from-rose-300 via-red-300 to-fuchsia-400',
            'badge': 'from-rose-400/30 to-red-400/30 text-rose-100 border-rose-300/40',
            'title': 'We are Here to Help',
            'subtitle': 'Your stress levels are elevated',
            'encouragement': 'Let us find ways to support you!'
        }
    } %}

    {% set config = level_config[quiz.stressLevel] ?? level_config.minimal %}
    {% set score_color = 'text-emerald-300' %}
    {% set score_glow = 'drop-shadow-[0_0_14px_rgba(52,211,153,0.45)]' %}
    {% set score_hex = '#6ee7b7' %}
    {% set score_shadow = '0 0 16px rgba(52, 211, 153, 0.55)' %}
    {% if quiz.stressLevel == 'high' %}
        {% set score_color = 'text-rose-300' %}
        {% set score_glow = 'drop-shadow-[0_0_14px_rgba(251,113,133,0.48)]' %}
        {% set score_hex = '#fb7185' %}
        {% set score_shadow = '0 0 16px rgba(251, 113, 133, 0.58)' %}
    {% elseif quiz.stressLevel == 'moderate' %}
        {% set score_color = 'text-amber-300' %}
        {% set score_glow = 'drop-shadow-[0_0_14px_rgba(251,191,36,0.48)]' %}
        {% set score_hex = '#fbbf24' %}
        {% set score_shadow = '0 0 16px rgba(251, 191, 36, 0.58)' %}
    {% endif %}

    <div class="text-center">
        <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/80 shadow-sm mb-4">
            <span class="text-xl">{{ config.emoji|raw }}</span>
            <span class="font-bold text-slate-800 dark:text-slate-100">{{ quiz.stressLevel|capitalize }} Stress</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white mb-2">{{ config.title }}</h1>
        <p class="text-slate-600 dark:text-slate-300 mb-3">{{ config.subtitle }}</p>
        <p class="text-sm text-slate-500 dark:text-slate-400">Assessment completed on {{ quiz.quizDate|date('F j, Y') }}</p>
    </div>

    <div class="card p-8 text-center border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-2">Your Stress Score</p>
        <div class="flex items-baseline justify-center gap-2 mb-4 relative">
            <span class="text-6xl font-black {{ score_color }} {{ score_glow }}" style="color: {{ score_hex }}; text-shadow: {{ score_shadow }};">{{ quiz.totalScore }}</span>
            <span class="text-xl text-slate-500 dark:text-slate-400">/ {{ maxScore|default(40) }}</span>
        </div>
        <div class="h-3 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden max-w-md mx-auto">
            <div class="h-full rounded-full bg-gradient-to-r from-primary-500 to-secondary-500" style="width: {{ scorePercent|default(0) }}%"></div>
        </div>
    </div>

    <div class="card p-6 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-300 flex items-center justify-center border border-primary-200 dark:border-primary-700">
                <i data-lucide="message-circle" class="w-5 h-5"></i>
            </div>
            What This Means
        </h3>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">{{ quiz.interpretation }}</p>
    </div>

    <div class="card p-6 md:p-7 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm relative overflow-hidden">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-secondary-50 dark:bg-secondary-900/30 text-secondary-600 dark:text-secondary-300 flex items-center justify-center border border-secondary-200 dark:border-secondary-700">
                <i data-lucide="shield-star" class="w-5 h-5"></i>
            </div>
            Personalized Recommendations
        </h3>

        {% if recommendations|length > 0 %}
            {% set rec_icons = ['sparkles', 'bot', 'brain', 'cpu', 'circuit-board', 'wand-2'] %}
            <div class="space-y-3">
                {% for rec in recommendations %}
                <div class="group rec-item rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 px-5 py-4 shadow-sm hover:border-primary-300 dark:hover:border-primary-600 transition-all duration-300 hover:-translate-y-1">
                    <div class="flex items-start gap-4">
                        <div class="w-11 h-11 rounded-xl rec-item-icon bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-300 flex items-center justify-center flex-shrink-0 border border-primary-200 dark:border-primary-700">
                            <i data-lucide="{{ rec_icons[loop.index0 % rec_icons|length] }}" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h4 class="font-extrabold text-slate-900 dark:text-white tracking-[0.01em]">{{ rec.title }}</h4>
                            <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">{{ rec.content }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-slate-600 dark:text-slate-300">No recommendations available yet.</p>
        {% endif %}
    </div>

    <div class="card p-6 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <div class="flex items-center justify-between gap-3 mb-3">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i data-lucide="sparkles" class="w-5 h-5"></i>
                Other AI Recommendations
            </h3>
            <button id="load-ai-suggestions"
                    class="px-4 py-2 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-semibold text-sm transition-colors">
                Show AI Suggestions
            </button>
        </div>
        <p id="ai-suggestions-message" class="text-slate-600 dark:text-slate-300 text-sm mb-3">
            Click the button to generate extra recommendations adapted to your stress result.
        </p>
        <div id="ai-suggestions-list" class="space-y-3"></div>
    </div>

    <div class="card p-6 md:p-7 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-300 flex items-center justify-center border border-rose-200 dark:border-rose-700">
                <i data-lucide="heart" class="w-5 h-5"></i>
            </div>
            Quick Actions
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <a href="{{ path('app_wellbeing_checkin_new') }}" data-turbo="false" class="group qa-card qa-daily rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 px-5 py-4 hover:border-emerald-300 dark:hover:border-emerald-600 transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl qa-icon qa-daily-icon bg-emerald-50 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-300 flex items-center justify-center border border-emerald-200 dark:border-emerald-700"><i data-lucide="calendar-plus" class="w-5 h-5"></i></div>
                    <div>
                        <p class="font-extrabold text-slate-900 dark:text-white">Daily Check-in</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300">Track your mood & stress</p>
                    </div>
                </div>
            </a>

            <a href="{{ path('app_wellbeing_quiz') }}" data-turbo="false" class="group qa-card qa-retake rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 px-5 py-4 hover:border-secondary-300 dark:hover:border-secondary-600 transition-all duration-300 hover:-translate-y-1">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl qa-icon qa-retake-icon bg-secondary-50 dark:bg-secondary-900/30 text-secondary-600 dark:text-secondary-300 flex items-center justify-center border border-secondary-200 dark:border-secondary-700"><i data-lucide="rotate-ccw" class="w-5 h-5"></i></div>
                    <div>
                        <p class="font-extrabold text-slate-900 dark:text-white">Retake Quiz</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300">Check your progress later</p>
                    </div>
                </div>
            </a>

            <a href="{{ path('app_wellbeing') }}" data-turbo="false" class="group qa-card qa-home rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 px-5 py-4 hover:border-primary-300 dark:hover:border-primary-600 transition-all duration-300 md:col-span-2 hover:-translate-y-1">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl qa-icon qa-home-icon bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-300 flex items-center justify-center border border-primary-200 dark:border-primary-700"><i data-lucide="house" class="w-5 h-5"></i></div>
                    <div>
                        <p class="font-extrabold text-slate-900 dark:text-white">Back to Wellbeing</p>
                        <p class="text-sm text-slate-600 dark:text-slate-300">View your dashboard</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="text-center pb-4">
        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/80 shadow-sm">
            <span class="text-2xl">{{ config.emoji|raw }}</span>
            <span class="text-slate-800 dark:text-slate-100 font-semibold">{{ config.encouragement }}</span>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    if (typeof window.initIcons === 'function') {
        window.initIcons();
    }
});
document.addEventListener('turbo:load', () => {
    if (typeof window.initIcons === 'function') {
        window.initIcons();
    }
});

function renderAiSuggestions(data) {
    const list = document.getElementById('ai-suggestions-list');
    const message = document.getElementById('ai-suggestions-message');
    if (!list || !message) return;

    message.textContent = data.message || 'AI suggestions generated.';
    const recs = Array.isArray(data.recommendations) ? data.recommendations : [];
    const iconPool = ['sparkles', 'bot', 'brain', 'cpu', 'circuit-board', 'wand-2'];
    list.innerHTML = recs.map((rec) => (
        `<div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-4">
            <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center border border-slate-200 dark:border-slate-600">
                    <i data-lucide="${iconPool[Math.floor(Math.random() * iconPool.length)]}" class="w-4 h-4"></i>
                </div>
                <div>
                    <p class="font-bold text-slate-900 dark:text-white">${rec.title ?? 'Suggestion'}</p>
                    <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">${rec.content ?? ''}</p>
                </div>
            </div>
        </div>`
    )).join('');
    if (typeof window.initIcons === 'function') {
        window.initIcons();
    }
}

async function fetchAiSuggestions() {
    const btn = document.getElementById('load-ai-suggestions');
    if (!btn) return;

    const original = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Loading...';

    try {
        const res = await fetch('{{ path('app_wellbeing_quiz_ai_suggestions', {id: quiz.id}) }}', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await res.json();
        if (!data.ok) throw new Error('Invalid AI response');
        renderAiSuggestions(data);
    } catch (e) {
        const message = document.getElementById('ai-suggestions-message');
        if (message) message.textContent = 'Unable to load AI suggestions now. Please try again.';
    } finally {
        btn.disabled = false;
        btn.textContent = original;
    }
}

document.addEventListener('click', (event) => {
    const target = event.target;
    if (target && target.id === 'load-ai-suggestions') {
        fetchAiSuggestions();
    }
});
</script>

<style>
.quiz-results-theme .rec-item {
    border-color: rgba(96, 165, 250, 0.55) !important;
    background: linear-gradient(135deg, rgba(30, 64, 175, 0.45), rgba(37, 99, 235, 0.42), rgba(59, 130, 246, 0.4)) !important;
}
.quiz-results-theme .rec-item:hover {
    border-color: rgba(147, 197, 253, 0.9) !important;
    box-shadow: 0 14px 42px rgba(59, 130, 246, 0.32) !important;
}
.quiz-results-theme .rec-item-icon {
    border-color: rgba(191, 219, 254, 0.7) !important;
    color: #bfdbfe !important;
}

.quiz-results-theme .qa-card {
    border-width: 1px !important;
    border-color: rgba(148, 163, 184, 0.45) !important;
}
.quiz-results-theme .qa-card:hover {
    border-color: rgba(94, 234, 212, 0.75) !important;
}
.quiz-results-theme .qa-daily {
    background: linear-gradient(135deg, rgba(6, 95, 70, 0.75), rgba(16, 185, 129, 0.5), rgba(20, 184, 166, 0.45)) !important;
}
.quiz-results-theme .qa-retake {
    background: linear-gradient(135deg, rgba(88, 28, 135, 0.75), rgba(168, 85, 247, 0.45), rgba(147, 51, 234, 0.45)) !important;
}
.quiz-results-theme .qa-home {
    background: linear-gradient(135deg, rgba(30, 64, 175, 0.7), rgba(59, 130, 246, 0.45), rgba(99, 102, 241, 0.4)) !important;
}

.quiz-results-theme .qa-daily-icon {
    background: rgba(15, 118, 110, 0.45) !important;
    border-color: rgba(110, 231, 183, 0.7) !important;
    color: #99f6e4 !important;
}
.quiz-results-theme .qa-retake-icon {
    background: rgba(124, 58, 237, 0.4) !important;
    border-color: rgba(196, 181, 253, 0.75) !important;
    color: #e9d5ff !important;
}
.quiz-results-theme .qa-home-icon {
    background: rgba(37, 99, 235, 0.4) !important;
    border-color: rgba(191, 219, 254, 0.8) !important;
    color: #e0f2fe !important;
}
</style>
{% endblock %}
