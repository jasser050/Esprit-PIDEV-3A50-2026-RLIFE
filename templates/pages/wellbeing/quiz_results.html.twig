{% extends 'base.html.twig' %}

{% block title %}Quiz Results{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-8">
    
    {% set level_config = {
        'minimal': {
            'emoji': '😊',
            'gradient': 'from-green-400 to-emerald-600',
            'bg_color': 'bg-green-100 dark:bg-green-900/30',
            'text_color': 'text-green-600',
            'illustration': '<svg class="w-24 h-24" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="100" cy="100" r="90" fill="url(#circleGrad1)"/><circle cx="70" cy="85" r="12" fill="white"/><circle cx="130" cy="85" r="12" fill="white"/><path d="M60 130 Q100 170 140 130" stroke="white" stroke-width="8" stroke-linecap="round" fill="none"/><defs><linearGradient id="circleGrad1" x1="0" y1="0" x2="200" y2="200"><stop offset="0%" stop-color="#4ade80"/><stop offset="100%" stop-color="#059669"/></linearGradient></defs></svg>',
            'title': 'Great Job!',
            'subtitle': 'Your stress levels are well managed',
            'encouragement': 'Keep up the excellent work! 🌟'
        },
        'mild': {
            'emoji': '🙂',
            'gradient': 'from-blue-400 to-indigo-600',
            'bg_color': 'bg-blue-100 dark:bg-blue-900/30',
            'text_color': 'text-blue-600',
            'illustration': '<svg class="w-24 h-24" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="100" cy="100" r="90" fill="url(#circleGrad2)"/><circle cx="70" cy="85" r="10" fill="white"/><circle cx="130" cy="85" r="10" fill="white"/><path d="M65 125 Q100 155 135 125" stroke="white" stroke-width="6" stroke-linecap="round" fill="none"/><path d="M80 75 L85 80 L95 70" stroke="white" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.5"/><defs><linearGradient id="circleGrad2" x1="0" y1="0" x2="200" y2="200"><stop offset="0%" stop-color="#60a5fa"/><stop offset="100%" stop-color="#4f46e5"/></linearGradient></defs></svg>',
            'title': 'Good Results!',
            'subtitle': 'You\'re doing well',
            'encouragement': 'A few small adjustments will help! 💪'
        },
        'moderate': {
            'emoji': '😐',
            'gradient': 'from-yellow-400 to-orange-500',
            'bg_color': 'bg-yellow-100 dark:bg-yellow-900/30',
            'text_color': 'text-yellow-600',
            'illustration': '<svg class="w-24 h-24" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="100" cy="100" r="90" fill="url(#circleGrad3)"/><circle cx="70" cy="90" r="10" fill="white"/><circle cx="130" cy="90" r="10" fill="white"/><path d="M75 135 L125 135" stroke="white" stroke-width="6" stroke-linecap="round"/><path d="M50 60 L60 70 M150 60 L140 70" stroke="white" stroke-width="4" stroke-linecap="round" opacity="0.7"/><defs><linearGradient id="circleGrad3" x1="0" y1="0" x2="200" y2="200"><stop offset="0%" stop-color="#fbbf24"/><stop offset="100%" stop-color="#f97316"/></linearGradient></defs></svg>',
            'title': 'Time to Focus',
            'subtitle': 'Your stress is at a moderate level',
            'encouragement': 'Let\'s work on some strategies together! 🌱'
        },
        'high': {
            'emoji': '😰',
            'gradient': 'from-red-400 to-rose-600',
            'bg_color': 'bg-red-100 dark:bg-red-900/30',
            'text_color': 'text-red-600',
            'illustration': '<svg class="w-24 h-24" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="100" cy="100" r="90" fill="url(#circleGrad4)"/><circle cx="65" cy="90" r="12" fill="white"/><circle cx="135" cy="90" r="12" fill="white"/><path d="M70 145 Q100 120 130 145" stroke="white" stroke-width="6" stroke-linecap="round" fill="none"/><path d="M50 55 L60 65 M150 55 L140 65" stroke="white" stroke-width="4" stroke-linecap="round"/><path d="M85 95 L115 95" stroke="white" stroke-width="3"/><circle cx="100" cy="100" r="35" stroke="white" stroke-width="2" fill="none" opacity="0.3"/><defs><linearGradient id="circleGrad4" x1="0" y1="0" x2="200" y2="200"><stop offset="0%" stop-color="#f87171"/><stop offset="100%" stop-color="#e11d48"/></linearGradient></defs></svg>',
            'title': 'We\'re Here to Help',
            'subtitle': 'Your stress levels are elevated',
            'encouragement': 'Let\'s find ways to support you! 🤝'
        }
    } %}
    
    {% set config = level_config[quiz.stressLevel] %}

    <!-- Result Header with Custom Illustration -->
    <div class="text-center">
        <div class="relative inline-block mb-6">
            <!-- Background Glow -->
            <div class="absolute inset-0 {{ config.gradient }} rounded-full blur-2xl opacity-30 transform scale-110"></div>
            <!-- Main Circle -->
            <div class="relative w-32 h-32 rounded-full {{ config.bg_color }} flex items-center justify-center shadow-xl">
                {{ config.illustration|raw }}
            </div>
            <!-- Emoji Badge -->
            <div class="absolute -bottom-1 -right-1 w-10 h-10 rounded-full bg-white dark:bg-gray-800 shadow-lg flex items-center justify-center text-2xl border-2 border-white dark:border-gray-700">
                {{ config.emoji }}
            </div>
        </div>
        
        <h1 class="text-3xl font-black text-secondary-900 dark:text-white mb-2">{{ config.title }}</h1>
        <p class="text-secondary-500 dark:text-secondary-400 mb-2">{{ config.subtitle }}</p>
        <p class="text-{{ quiz.stressLevel == 'high' ? 'red' : (quiz.stressLevel == 'moderate' ? 'yellow' : 'green') }}-500 font-medium">{{ config.encouragement }}</p>
        
        <p class="text-sm text-secondary-400 mt-4">Assessment completed on {{ quiz.quizDate|date('F j, Y') }}</p>
    </div>

    <!-- Score Card -->
    <div class="card p-8 text-center relative overflow-hidden">
        <!-- Decorative Elements -->
        <div class="absolute top-0 left-0 w-32 h-32 {{ config.gradient }} opacity-5 rounded-full -translate-x-16 -translate-y-16"></div>
        <div class="absolute bottom-0 right-0 w-24 h-24 {{ config.gradient }} opacity-5 rounded-full translate-x-12 translate-y-12"></div>
        
        <div class="relative">
            <p class="text-sm text-secondary-500 mb-2">Your Stress Score</p>
            <div class="flex items-baseline justify-center gap-2 mb-4">
                <span class="text-6xl font-black {{ config.text_color }}">{{ quiz.totalScore }}</span>
                <span class="text-xl text-secondary-400">/ 40</span>
            </div>
            
            <!-- Progress Bar -->
            <div class="h-6 bg-secondary-200 dark:bg-secondary-700 rounded-full overflow-hidden max-w-md mx-auto mb-4 relative">
                <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-xs font-semibold text-secondary-600 dark:text-secondary-300 z-10">
                        {{ ((quiz.totalScore / 40) * 100)|round }}%
                    </span>
                </div>
                <div class="h-full rounded-full transition-all duration-1000 {{ config.gradient }}" 
                     style="width: {{ (quiz.totalScore / 40) * 100 }}%"></div>
            </div>
            
            <!-- Level Badge -->
            <div class="inline-flex items-center gap-2 px-6 py-3 rounded-full {{ config.bg_color }}">
                <span class="text-2xl">{{ config.emoji }}</span>
                <span class="text-lg font-bold {{ config.text_color }}">{{ quiz.stressLevel|capitalize }} Stress</span>
            </div>
        </div>
    </div>

    <!-- Interpretation -->
    <div class="card p-8 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 {{ config.gradient }}"></div>
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                </svg>
            </div>
            What This Means
        </h3>
        <p class="text-secondary-700 dark:text-secondary-300 leading-relaxed text-lg">
            {{ quiz.interpretation }}
        </p>
    </div>

    <!-- Personalized Recommendations -->
    <div class="card p-8 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-amber-400 to-orange-500"></div>
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
            </div>
            Personalized Recommendations
        </h3>
        
        {% if recommendations|length > 0 %}
            <div class="space-y-4" id="recommendations-container">
                {% for rec in recommendations %}
                {% set rec_icons = [
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>',
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>',
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>',
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>',
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
                    '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>'
                ] %}
                <div class="group p-5 rounded-2xl bg-gradient-to-r from-white to-secondary-50 dark:from-secondary-800 dark:to-secondary-900 border border-secondary-200 dark:border-secondary-700 hover:border-amber-400 dark:hover:border-amber-500 hover:shadow-lg hover:shadow-amber-500/10 transition-all duration-300">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-100 to-yellow-100 dark:from-amber-900/50 dark:to-yellow-900/50 flex items-center justify-center text-amber-600 dark:text-amber-400 group-hover:scale-110 transition-transform duration-300">
                            {{ rec_icons[loop.index0 % 6]|raw }}
                        </div>
                        <div class="flex-1">
                            <h4 class="font-bold text-secondary-900 dark:text-white mb-2 text-lg">{{ rec.title }}</h4>
                            <p class="text-secondary-600 dark:text-secondary-400 leading-relaxed">{{ rec.content }}</p>
                        </div>
                        <div class="hidden group-hover:block">
                            <svg class="w-6 h-6 text-amber-500 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8" id="recommendations-container">
                <div class="w-20 h-20 mx-auto rounded-full bg-secondary-100 dark:bg-secondary-800 flex items-center justify-center mb-4">
                    <svg class="w-10 h-10 text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <p class="text-secondary-500 dark:text-secondary-400 mb-2">No recommendations available yet</p>
                <p class="text-sm text-secondary-400">We're working on personalized suggestions for you!</p>
            </div>
        {% endif %}
    </div>

    <!-- Quick Actions -->
    <div class="card p-8">
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-6 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-pink-100 to-rose-100 dark:from-pink-900/30 dark:to-rose-900/30 flex items-center justify-center">
                <svg class="w-5 h-5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
            </div>
            Quick Actions
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% if quiz.stressLevel == 'high' or quiz.stressLevel == 'moderate' %}
            <a href="{{ path('app_wellbeing_tools') }}" class="group p-5 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200 dark:border-blue-800 hover:border-blue-400 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-bold text-secondary-900 dark:text-white text-lg">Try Coping Tools</p>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">Breathing & meditation exercises</p>
                    </div>
                </div>
            </a>
            {% endif %}
            
            <a href="{{ path('app_wellbeing_checkin_new') }}" class="group p-5 rounded-2xl bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 border border-green-200 dark:border-green-800 hover:border-green-400 hover:shadow-lg hover:shadow-green-500/10 transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-bold text-secondary-900 dark:text-white text-lg">Daily Check-in</p>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">Track your mood & stress</p>
                    </div>
                </div>
            </a>
            
            <a href="{{ path('app_wellbeing_quiz') }}" class="group p-5 rounded-2xl bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 border border-purple-200 dark:border-purple-800 hover:border-purple-400 hover:shadow-lg hover:shadow-purple-500/10 transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500 to-pink-600 flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-bold text-secondary-900 dark:text-white text-lg">Retake Quiz</p>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">Check your progress later</p>
                    </div>
                </div>
            </a>
            
            <a href="{{ path('app_wellbeing') }}" class="group p-5 rounded-2xl bg-gradient-to-r from-gray-50 to-slate-50 dark:from-gray-800 dark:to-slate-900 border border-gray-200 dark:border-gray-700 hover:border-gray-400 hover:shadow-lg transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-gray-500 to-slate-600 flex items-center justify-center text-white shadow-lg group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                    </div>
                    <div>
                        <p class="font-bold text-secondary-900 dark:text-white text-lg">Back to Wellbeing</p>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">View your dashboard</p>
                    </div>
                </div>
            </a>
            
            {% if quiz.stressLevel == 'high' %}
            <div class="md:col-span-2 p-6 rounded-2xl bg-gradient-to-r from-red-50 to-rose-50 dark:from-red-900/20 dark:to-rose-900/20 border-2 border-red-200 dark:border-red-800">
                <div class="flex items-start gap-4">
                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-red-500 to-rose-600 flex items-center justify-center text-white shadow-lg flex-shrink-0">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-secondary-900 dark:text-white text-lg mb-2">We're Here to Support You</p>
                        <p class="text-secondary-600 dark:text-secondary-400 mb-4">
                            Your stress levels indicate you might benefit from professional support. 
                            Speaking with a counselor can provide you with effective tools and strategies.
                        </p>
                        <a href="#" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold hover:from-red-600 hover:to-rose-700 transition-all shadow-lg hover:shadow-xl">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                            Find Campus Counseling Services
                        </a>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Encouragement Footer -->
    <div class="text-center pb-8">
        <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-secondary-100 dark:bg-secondary-800">
            <span class="text-2xl">{{ config.emoji }}</span>
            <span class="text-secondary-600 dark:text-secondary-400 font-medium">{{ config.encouragement }}</span>
        </div>
    </div>
</div>
{% endblock %}
