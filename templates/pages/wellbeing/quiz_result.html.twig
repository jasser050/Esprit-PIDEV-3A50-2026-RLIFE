{% extends 'base.html.twig' %}

{% block title %}Your Stress Result{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12 max-w-3xl">
    <div class="card bg-base-100 shadow-2xl p-8 md:p-12 rounded-2xl text-center">
        <h1 class="text-4xl font-bold mb-8">Your Stress Assessment Result</h1>

        <div class="text-6xl font-extrabold mb-4">
            {{ score }} <span class="text-3xl opacity-70">/ {{ maxScore }}</span>
        </div>

        <div class="text-3xl font-bold mb-6
            {% if level == 'Low' %}text-success
            {% elseif level == 'Moderate' %}text-warning
            {% else %}text-error{% endif %}">
            {{ level }} Stress
        </div>

        <p class="text-xl mb-8">{{ message }}</p>

        <div class="bg-base-200 p-6 rounded-xl mb-10 text-left">
            <h3 class="text-xl font-semibold mb-4">Recommendation</h3>
            <p class="leading-relaxed">{{ advice }}</p>
        </div>

        <div class="flex flex-col sm:flex-row justify-center gap-6">
            <a href="{{ path('app_wellbeing_quiz') }}" class="btn btn-primary btn-lg px-10">
                Take the quiz again
            </a>
            <a href="/" class="btn btn-outline btn-lg px-10">
                Back to home
            </a>
        </div>
    </div>
</div>
{% endblock %}