{% extends 'base.html.twig' %}

{% block title %}Check-in History - Wellbeing{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Wellbeing', url: path('app_wellbeing') },
            { label: 'Check-in History' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Check-in History',
        subtitle: 'Track your mood, stress, and energy over time'
    } %}

    <!-- Stats Summary -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold text-primary-600 dark:text-primary-400">{{ checkins|length }}</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Total Check-ins</p>
        </div>
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold text-{{ avg_stress <= 4 ? 'success' : (avg_stress <= 6 ? 'warning' : 'danger') }}-600 dark:text-{{ avg_stress <= 4 ? 'success' : (avg_stress <= 6 ? 'warning' : 'danger') }}-400">{{ avg_stress }}/10</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Avg. Stress</p>
        </div>
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold text-accent-600 dark:text-accent-400">{{ avg_energy }}/10</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Avg. Energy</p>
        </div>
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold text-secondary-600 dark:text-secondary-400">{{ avg_sleep }}h</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Avg. Sleep</p>
        </div>
    </div>

    <!-- Actions Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-2">
            <a href="{{ path('app_wellbeing_export_pdf') }}" class="btn btn-secondary">
                <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                Export PDF
            </a>
        </div>
        <a href="{{ path('app_wellbeing_checkin_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
            New Check-in
        </a>
    </div>

    <!-- Check-ins List -->
    <div class="card">
        {% if checkins|length > 0 %}
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Mood</th>
                        <th>Stress Level</th>
                        <th>Energy Level</th>
                        <th>Sleep</th>
                        <th>Notes</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for checkin in checkins %}
                    <tr>
                        <td>
                            <span class="font-medium">{{ checkin.entryDate|date('M j, Y') }}</span>
                        </td>
                        <td>
                            <div class="flex items-center gap-2">
                                <span class="text-xl">
                                    {% if checkin.mood == 'great' %}&#x1F60A;
                                    {% elseif checkin.mood == 'good' %}&#x1F642;
                                    {% elseif checkin.mood == 'okay' %}&#x1F610;
                                    {% elseif checkin.mood == 'stressed' %}&#x1F61F;
                                    {% else %}&#x1F634;{% endif %}
                                </span>
                                <span class="capitalize">{{ checkin.mood }}</span>
                            </div>
                        </td>
                        <td>
                            <div class="flex items-center gap-2">
                                <div class="w-24 h-2 rounded-full bg-light-border dark:bg-dark-border overflow-hidden">
                                    <div class="h-full rounded-full bg-{{ checkin.stressLevel <= 4 ? 'success' : (checkin.stressLevel <= 6 ? 'warning' : 'danger') }}-500" 
                                         style="width: {{ checkin.stressLevel * 10 }}%"></div>
                                </div>
                                <span class="text-sm font-medium">{{ checkin.stressLevel }}/10</span>
                            </div>
                        </td>
                        <td>
                            <div class="flex items-center gap-2">
                                <div class="w-24 h-2 rounded-full bg-light-border dark:bg-dark-border overflow-hidden">
                                    <div class="h-full rounded-full bg-accent-500" 
                                         style="width: {{ checkin.energyLevel * 10 }}%"></div>
                                </div>
                                <span class="text-sm font-medium">{{ checkin.energyLevel }}/10</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-secondary">{{ checkin.sleepHours }}h</span>
                        </td>
                        <td class="max-w-xs">
                            {% if checkin.note %}
                                <span class="text-sm text-light-muted dark:text-dark-muted truncate block">{{ checkin.note }}</span>
                            {% else %}
                                <span class="text-sm text-light-muted dark:text-dark-muted italic">No notes</span>
                            {% endif %}
                        </td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="{{ path('app_wellbeing_checkin_edit', {id: checkin.id}) }}" class="btn btn-sm btn-secondary">
                                    <i data-lucide="edit" class="w-4 h-4"></i>
                                </a>
                                <form method="POST" action="{{ path('app_wellbeing_checkin_delete', {id: checkin.id}) }}" data-confirm="Are you sure you want to delete this check-in?" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('wellbeing_delete_' ~ checkin.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i data-lucide="trash" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            {% include 'components/empty_state.html.twig' with {
                icon: 'clipboard',
                title: 'No check-ins yet',
                description: 'Start tracking your wellbeing by creating your first check-in.',
                action_label: 'New Check-in',
                action_url: path('app_wellbeing_checkin_new')
            } %}
        {% endif %}
    </div>

    <!-- Mood Distribution -->
    {% if checkins|length > 0 %}
    <div class="card p-6">
        <h2 class="text-lg font-semibold mb-4">Mood Distribution</h2>
        <div class="grid grid-cols-5 gap-4">
            {% set mood_counts = { great: 0, good: 0, okay: 0, stressed: 0, tired: 0 } %}
            {% for checkin in checkins %}
                {% set mood_counts = mood_counts|merge({ (checkin.mood): mood_counts[checkin.mood] + 1 }) %}
            {% endfor %}
            
            {% for mood, count in mood_counts %}
            <div class="text-center">
                <div class="text-3xl mb-2">
                    {% if mood == 'great' %}&#x1F60A;
                    {% elseif mood == 'good' %}&#x1F642;
                    {% elseif mood == 'okay' %}&#x1F610;
                    {% elseif mood == 'stressed' %}&#x1F61F;
                    {% else %}&#x1F634;{% endif %}
                </div>
                <p class="text-2xl font-bold">{{ count }}</p>
                <p class="text-sm text-light-muted dark:text-dark-muted capitalize">{{ mood }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
