{% extends 'base.html.twig' %}

{% block title %}Check-in History - Wellbeing{% endblock %}

{% block body %}
<div class="space-y-6">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Wellbeing', url: path('app_wellbeing') },
            { label: 'Check-in History' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Check-in History',
        subtitle: 'Track your mood, stress, and energy over time',
        actions: [
            { label: 'New Check-in', url: path('app_wellbeing_checkin_new'), variant: 'primary', icon: '+' }
        ]
    } %}

    <!-- Stats Summary -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold text-primary-600 dark:text-primary-400">{{ checkins|length }}</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Total Check-ins</p>
        </div>
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold">{{ avg_stress }}/10</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Avg. Stress</p>
        </div>
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold">{{ avg_energy }}/10</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Avg. Energy</p>
        </div>
        <div class="card p-4 text-center">
            <p class="text-2xl font-bold">{{ avg_sleep }}h</p>
            <p class="text-sm text-light-muted dark:text-dark-muted">Avg. Sleep</p>
        </div>
    </div>

    <div class="card">
        {% if checkins|length > 0 %}
        <div class="overflow-x-auto">
            <table class="table">
                <thead>
                <tr>
                    <th>Date</th>
                    <th>Mood</th>
                    <th>Stress</th>
                    <th>Energy</th>
                    <th>Sleep</th>
                    <th>Notes</th>
                    <th class="text-right">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for checkin in checkins %}
                    <tr>
                        <td class="font-medium">{{ checkin.entryDateWell|date('M j, Y H:i') }}</td>

                        <td>
                            <div class="flex items-center gap-2">
                                <span class="text-xl">
                                    {% if checkin.moodWell == 'great' %}😊
                                    {% elseif checkin.moodWell == 'good' %}🙂
                                    {% elseif checkin.moodWell == 'okay' %}😐
                                    {% elseif checkin.moodWell == 'stressed' %}😟
                                    {% else %}😴{% endif %}
                                </span>
                                <span class="capitalize">{{ checkin.moodWell }}</span>
                            </div>
                        </td>

                        <td>{{ checkin.stressLevelWell }}/10</td>
                        <td>{{ checkin.energyLevelWell }}/10</td>
                        <td>{{ checkin.sleepHoursWell }}h</td>

                        <td class="max-w-xs">
                            {% if checkin.noteWell %}
                                <span class="text-sm text-light-muted dark:text-dark-muted truncate block">{{ checkin.noteWell }}</span>
                            {% else %}
                                <span class="text-sm text-light-muted dark:text-dark-muted italic">No notes</span>
                            {% endif %}
                        </td>

                        <td class="text-right whitespace-nowrap">
                            <div class="flex justify-end gap-2">
                                <a href="{{ path('app_wellbeing_checkin_edit', {id: checkin.id}) }}" class="btn btn-secondary">Edit</a>

                                <form method="POST"
                                      action="{{ path('app_wellbeing_checkin_delete', {id: checkin.id}) }}"
                                      onsubmit="return confirm('Delete this check-in?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('wellbeing_delete_' ~ checkin.id) }}">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <div class="p-6 text-center">
                <p class="text-light-muted dark:text-dark-muted">No check-ins yet.</p>
                <a href="{{ path('app_wellbeing_checkin_new') }}" class="btn btn-primary mt-4">New Check-in</a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
