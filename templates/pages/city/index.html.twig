{% extends 'base.html.twig' %}

{% block title %}🏙 EduCity — Ma Ville{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Isolation totale : ne touche PAS au layout de la template ── */
#ec-root {
  position: fixed;
  inset: 0;
  z-index: 50;
  overflow: hidden;
  font-family: 'Segoe UI', system-ui, sans-serif;
}

/* Canvas Three.js : toujours fond sombre quelle que soit la template */
#cityCanvas {
  display: block;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  cursor: grab;
  background: #070d1e; /* visible avant init Three.js */
}
#cityCanvas:active { cursor: grabbing; }

/* Labels DOM 3D */
#labelsWrap {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 10;
}
.lb3d {
  position: absolute;
  transform: translate(-50%, -100%);
  padding: 3px 9px 4px;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
  pointer-events: none;
  transition: opacity .2s;
  backdrop-filter: blur(6px);
  border: 1px solid rgba(201,168,76,.3);
  background: rgba(4,8,18,.88);
  color: #e2e8f0;
}
.lb3d.country {
  border-color: rgba(201,168,76,.6);
  color: #c9a84c;
}
.lb3d::after {
  content: '';
  position: absolute;
  left: 50%; bottom: -5px;
  transform: translateX(-50%);
  border: 5px solid transparent;
  border-top-color: rgba(201,168,76,.4);
  border-bottom: none;
}
.lb3d.building::after { border-top-color: rgba(255,255,255,.15); }

/* ── HUD TOP ── */
#ec-hud {
  position: absolute;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
  padding: 8px 16px;
  min-height: 54px;
  background: linear-gradient(180deg, rgba(4,8,20,.97) 0%, rgba(4,8,20,.78) 100%);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid rgba(201,168,76,.18);
}
.ec-brand {
  font-size: .92rem;
  font-weight: 900;
  color: #c9a84c;
  white-space: nowrap;
  font-family: Georgia, 'Times New Roman', serif;
  letter-spacing: .02em;
}
.ec-sep { width: 1px; height: 20px; background: rgba(201,168,76,.2); flex-shrink: 0; }
.ec-stat {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 8px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(201,168,76,.18);
  flex-shrink: 0;
}
.ec-stat-val { font-size: .82rem; font-weight: 800; color: #c9a84c; line-height: 1; }
.ec-stat-lbl { font-size: .56rem; color: #64748b; letter-spacing: .08em; text-transform: uppercase; margin-top: 1px; }
.ec-sp { flex: 1; }
.ec-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 12px;
  border-radius: 8px;
  border: 1px solid rgba(201,168,76,.22);
  background: rgba(201,168,76,.07);
  color: #c9a84c;
  font-size: .7rem;
  font-weight: 700;
  cursor: pointer;
  transition: all .2s;
  text-decoration: none;
  white-space: nowrap;
  font-family: inherit;
}
.ec-btn:hover { background: rgba(201,168,76,.2); }
.ec-btn.active { background: rgba(201,168,76,.25); border-color: #c9a84c; }

/* ── LEFT PANEL ── */
#ec-left {
  position: absolute;
  left: 0; top: 54px; bottom: 0;
  width: 230px;
  z-index: 90;
  background: rgba(4,8,20,.97);
  border-right: 1px solid rgba(201,168,76,.15);
  overflow-y: auto;
  transition: transform .3s ease;
}
#ec-left::-webkit-scrollbar { width: 3px; }
#ec-left::-webkit-scrollbar-thumb { background: rgba(201,168,76,.2); border-radius: 99px; }

.ps { padding: 11px 12px 10px; border-bottom: 1px solid rgba(255,255,255,.04); }
.pl { font-size: 8px; letter-spacing: .3em; text-transform: uppercase; color: #374151; margin-bottom: 8px; }

.lvl-wrap { display: flex; align-items: center; gap: 10px; margin-bottom: 9px; }
.lvl-badge {
  width: 38px; height: 38px; border-radius: 8px; flex-shrink: 0;
  background: linear-gradient(135deg, #c9a84c, #8b6914);
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; font-weight: 900; color: #0a0a0f;
  font-family: Georgia, serif;
  box-shadow: 0 4px 12px rgba(201,168,76,.28);
}
.lvl-name { font-size: .76rem; font-weight: 700; color: #e2e8f0; }
.lvl-sub  { font-size: .6rem; color: #64748b; }
.xp-bar { height: 3px; background: rgba(255,255,255,.06); border-radius: 99px; overflow: hidden; margin-top: 6px; }
.xp-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #c9a84c, #ffe066); transition: width 1.2s; }

.sk-card { border-radius: 8px; padding: 8px 10px; margin-bottom: 5px; border: 1px solid; position: relative; }
.sk-hot  { background: rgba(201,168,76,.05); border-color: rgba(201,168,76,.22); }
.sk-good { background: rgba(74,222,128,.04); border-color: rgba(74,222,128,.18); }
.sk-blue { background: rgba(96,165,250,.04); border-color: rgba(96,165,250,.18); }
.sk-num  { font-size: 1.35rem; font-weight: 900; line-height: 1; font-family: Georgia, serif; }
.sk-lbl  { font-size: .58rem; color: #64748b; letter-spacing: .08em; text-transform: uppercase; margin-top: 2px; }
.sk-icon { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); font-size: 1rem; }

.c-dot {
  width: 26px; height: 26px; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: .85rem; cursor: default;
  transition: transform .2s; border: 1px solid;
}
.c-dot:hover { transform: scale(1.3); }

.b-item {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 8px; border-radius: 7px;
  border: 1px solid rgba(74,222,128,.15);
  background: rgba(74,222,128,.03);
  margin-bottom: 4px;
}
.b-icon { width: 26px; height: 26px; border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: .82rem; flex-shrink: 0; }
.b-name  { font-size: .68rem; font-weight: 700; color: #e2e8f0; }
.b-bonus { font-size: .58rem; color: #4ade80; }

/* ── STORE PANEL ── */
#ec-store {
  position: absolute;
  right: 0; top: 54px; bottom: 0;
  width: 258px;
  z-index: 90;
  background: rgba(4,8,20,.97);
  border-left: 1px solid rgba(201,168,76,.15);
  transform: translateX(100%);
  transition: transform .3s ease;
  overflow-y: auto;
}
#ec-store::-webkit-scrollbar { width: 3px; }
#ec-store::-webkit-scrollbar-thumb { background: rgba(201,168,76,.2); border-radius: 99px; }
#ec-store.open { transform: translateX(0); }

.st-title { font-family: Georgia, serif; font-size: .9rem; font-weight: 900; color: #c9a84c; padding: 13px 14px 4px; }
.st-bal   { font-size: .68rem; color: #64748b; padding: 3px 14px 10px; border-bottom: 1px solid rgba(255,255,255,.04); }
.st-bal span { color: #c9a84c; font-weight: 700; }
.st-tabs  { display: flex; gap: 4px; padding: 8px 11px; border-bottom: 1px solid rgba(255,255,255,.04); }
.st-tab {
  flex: 1; padding: 5px; border-radius: 7px;
  border: 1px solid rgba(201,168,76,.18);
  background: transparent; color: #64748b;
  font-size: .64rem; font-weight: 700; cursor: pointer;
  text-align: center; transition: all .2s; font-family: inherit;
}
.st-tab.active { background: rgba(201,168,76,.12); border-color: rgba(201,168,76,.42); color: #c9a84c; }

.si { border-radius: 10px; padding: 10px; margin-bottom: 7px; border: 1px solid rgba(255,255,255,.06); background: rgba(255,255,255,.02); position: relative; overflow: hidden; transition: all .2s; }
.si:not(.owned):not(.locked) { cursor: pointer; }
.si:not(.owned):not(.locked):hover { border-color: rgba(201,168,76,.32); background: rgba(201,168,76,.04); transform: translateY(-1px); }
.si.locked  { opacity: .3; }
.si.owned   { border-color: rgba(74,222,128,.3); background: rgba(74,222,128,.04); cursor: default; }

.si-head  { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; }
.si-ico   { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
.si-name  { font-size: .76rem; font-weight: 700; color: #e2e8f0; }
.si-type  { font-size: .59rem; color: #64748b; text-transform: uppercase; letter-spacing: .06em; }
.si-desc  { font-size: .63rem; color: #64748b; line-height: 1.5; margin-bottom: 6px; }
.si-foot  { display: flex; align-items: center; justify-content: space-between; }
.si-price { font-size: .74rem; font-weight: 700; color: #c9a84c; }
.si-buy {
  padding: 4px 11px; border-radius: 6px;
  background: linear-gradient(135deg, #c9a84c, #ffe066);
  color: #0a0a0f; font-size: .63rem; font-weight: 800;
  border: none; cursor: pointer; font-family: inherit;
  transition: all .2s; white-space: nowrap;
}
.si-buy:hover:not(:disabled) { transform: scale(1.06); box-shadow: 0 4px 12px rgba(201,168,76,.4); }
.si-buy:disabled { opacity: .35; cursor: not-allowed; transform: none; }
.si-rarity {
  position: absolute; top: 7px; right: 7px;
  font-size: .52rem; font-weight: 800; padding: 2px 5px; border-radius: 99px; letter-spacing: .07em;
}
.r-common    { background: rgba(100,116,139,.2); color: #94a3b8; }
.r-rare      { background: rgba(59,130,246,.2);  color: #60a5fa; }
.r-epic      { background: rgba(168,85,247,.2);  color: #c084fc; }
.r-legendary { background: rgba(201,168,76,.22); color: #c9a84c; }

/* ── TOOLBAR ── */
#ec-tb {
  position: absolute;
  bottom: 14px; left: 50%; transform: translateX(-50%);
  z-index: 100;
  display: flex; gap: 5px;
  background: rgba(4,8,20,.93);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(201,168,76,.18);
  border-radius: 13px; padding: 6px 9px;
}
.tb {
  width: 38px; height: 38px; border-radius: 8px;
  border: 1px solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.04);
  display: flex; align-items: center; justify-content: center;
  font-size: .95rem; cursor: pointer; transition: all .2s;
  position: relative; text-decoration: none;
}
.tb:hover { background: rgba(201,168,76,.12); border-color: rgba(201,168,76,.32); transform: translateY(-2px); }
.tb.active { background: rgba(201,168,76,.2); border-color: #c9a84c; }
.tb-tip {
  position: absolute; bottom: 46px; left: 50%; transform: translateX(-50%);
  background: rgba(4,8,20,.96); border: 1px solid rgba(201,168,76,.2);
  border-radius: 5px; padding: 3px 8px; font-size: .58rem; white-space: nowrap;
  color: #e2e8f0; pointer-events: none; opacity: 0; transition: opacity .2s;
}
.tb:hover .tb-tip { opacity: 1; }
.tb-sep { width: 1px; background: rgba(201,168,76,.18); margin: 3px 0; }

/* ── TOAST ── */
#ec-toast {
  position: absolute; bottom: 70px; left: 50%;
  transform: translateX(-50%) translateY(8px);
  z-index: 200; padding: 7px 15px; border-radius: 10px;
  background: rgba(4,8,20,.97); border: 1px solid rgba(201,168,76,.25);
  font-size: .76rem; font-weight: 700; color: #e2e8f0;
  opacity: 0; transition: all .3s; pointer-events: none; white-space: nowrap;
}
#ec-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ── INFO POPUP ── */
#ec-popup {
  position: absolute; z-index: 150;
  background: rgba(4,8,20,.96); border: 1px solid rgba(201,168,76,.3);
  border-radius: 12px; padding: 11px 14px; min-width: 155px;
  opacity: 0; transition: opacity .22s; pointer-events: none;
  backdrop-filter: blur(12px); box-shadow: 0 8px 32px rgba(0,0,0,.7);
}
#ec-popup.show { opacity: 1; pointer-events: all; }
.pp-title { font-size: .8rem; font-weight: 700; color: #e2e8f0; margin-bottom: 2px; }
.pp-sub   { font-size: .63rem; color: #64748b; margin-bottom: 4px; }
.pp-bonus { font-size: .67rem; color: #4ade80; font-weight: 600; }
.pp-loc   { font-size: .67rem; color: #c9a84c; font-weight: 600; }

/* ── MODAL ── */
#ec-modal {
  position: absolute; inset: 0; z-index: 300;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,.8); backdrop-filter: blur(10px);
  opacity: 0; pointer-events: none; transition: opacity .3s;
}
#ec-modal.show { opacity: 1; pointer-events: all; }
.m-box {
  background: linear-gradient(145deg, #080e1c, #06091a);
  border: 1px solid rgba(201,168,76,.22); border-radius: 20px;
  padding: 26px; max-width: 360px; width: 90%; text-align: center;
  transform: scale(.92); transition: transform .3s;
  box-shadow: 0 24px 80px rgba(0,0,0,.8);
  position: relative;
}
#ec-modal.show .m-box { transform: scale(1); }
.m-flag  { font-size: 3rem; margin-bottom: 9px; }
.m-title { font-family: Georgia, serif; font-size: 1.35rem; font-weight: 900; color: #c9a84c; margin-bottom: 4px; }
.m-sub   { font-size: .76rem; color: #64748b; margin-bottom: 14px; }
.m-btn   { padding: 9px 24px; border-radius: 10px; background: linear-gradient(135deg, #c9a84c, #ffe066); color: #0a0a0f; font-size: .8rem; font-weight: 800; border: none; cursor: pointer; transition: all .2s; }
.m-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(201,168,76,.4); }
.m-close { position: absolute; top: 10px; right: 10px; width: 24px; height: 24px; border-radius: 6px; border: 1px solid rgba(201,168,76,.2); background: rgba(255,255,255,.04); display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: .72rem; color: #64748b; }

/* Coin pop */
@keyframes coinPop { 0%{transform:translate(-50%,0);opacity:1} 100%{transform:translate(-50%,-55px);opacity:0} }
.coin-pop { position: absolute; left: 50%; top: 80px; font-size: .88rem; font-weight: 800; color: #ffe066; pointer-events: none; animation: coinPop .85s ease forwards; z-index: 999; }

/* Light mode compatibility — si la template force un fond clair */
@media (prefers-color-scheme: light) {
  #ec-hud, #ec-left, #ec-store, #ec-tb, #ec-toast, #ec-popup, .m-box { /* already dark by design — keep as is */ }
}
</style>
{% endblock %}

{% block body %}
{# Inject Twig data into JS #}
<script>
var EC = {
  coins:      {{ cityData.coins }},
  level:      {{ cityData.level }},
  streak:     {{ cityData.streak.current }},
  buildings:  {{ cityData.buildings|json_encode|raw }},
  countries:  {{ cityData.countries|json_encode|raw }},
  xpPct:      {{ cityData.xp_percent }},
  stats: {
    evals:   {{ cityData.stats.total_evals }},
    elite:   {{ cityData.stats.elite }},
    success: {{ cityData.stats.success_rate }},
  },
  population:     {{ cityData.population }},
  nextLevel:      {{ cityData.next_level_coins }},
};
var ALL_COUNTRIES = {{ allCountries|json_encode|raw }};
</script>

<div id="ec-root">
  <!-- Canvas -->
  <canvas id="cityCanvas"></canvas>
  <div id="labelsWrap"></div>

  <!-- HUD -->
  <div id="ec-hud">
    <div class="ec-brand">🏙 EduCity</div>
    <div class="ec-sep"></div>
    <div class="ec-stat">
      <span>💰</span>
      <div><div class="ec-stat-val" id="hCoins">{{ cityData.coins }}</div><div class="ec-stat-lbl">Coins</div></div>
    </div>
    <div class="ec-stat">
      <span>🔥</span>
      <div><div class="ec-stat-val">{{ cityData.streak.current }}</div><div class="ec-stat-lbl">Streak</div></div>
    </div>
    <div class="ec-stat">
      <span>🏗</span>
      <div><div class="ec-stat-val" id="hBuildings">{{ cityData.buildings|length }}</div><div class="ec-stat-lbl">Bâtiments</div></div>
    </div>
    <div class="ec-stat">
      <span>🌍</span>
      <div><div class="ec-stat-val">{{ cityData.countries|length }} / 12</div><div class="ec-stat-lbl">Pays</div></div>
    </div>
    <div class="ec-stat">
      <span>👥</span>
      <div><div class="ec-stat-val">{{ cityData.population|number_format(0, '.', ' ') }}</div><div class="ec-stat-lbl">Population</div></div>
    </div>
    <div class="ec-sp"></div>
    <a href="{{ path('app_courses') }}" class="ec-btn">← Courses</a>
    <button class="ec-btn" id="storeBtn" onclick="ecToggleStore()">🛒 Store</button>
    <button class="ec-btn" id="nightBtn" onclick="ecToggleNight()">🌙 Nuit</button>
  </div>

  <!-- Left panel -->
  <div id="ec-left">
    <div class="ps">
      <div class="pl">Ma Ville</div>
      <div class="lvl-wrap">
        <div class="lvl-badge">{{ cityData.level }}</div>
        <div>
          <div class="lvl-name">Scholar City</div>
          <div class="lvl-sub">{{ cityData.stats.total_evals }} évaluations</div>
        </div>
      </div>
      <div class="xp-bar"><div class="xp-fill" style="width:{{ cityData.xp_percent }}%"></div></div>
      <div style="display:flex;justify-content:space-between;font-size:.58rem;color:#64748b;margin-top:4px">
        <span>{{ cityData.coins }} coins</span>
        <span>Niv. {{ cityData.level + 1 }} → {{ cityData.next_level_coins }}</span>
      </div>
    </div>

    <div class="ps">
      <div class="pl">Streaks</div>
      <div class="sk-card sk-hot">
        <div class="sk-num" style="color:#c9a84c">{{ cityData.streak.current }}</div>
        <div class="sk-lbl">High Score ≥75%</div>
        <div class="sk-icon">🔥</div>
      </div>
      <div class="sk-card sk-good">
        <div class="sk-num" style="color:#4ade80">{{ cityData.stats.elite }}</div>
        <div class="sk-lbl">Évals ≥90%</div>
        <div class="sk-icon">🌟</div>
      </div>
      <div class="sk-card sk-blue" style="margin-bottom:0">
        <div class="sk-num" style="color:#60a5fa">{{ cityData.stats.success_rate }}%</div>
        <div class="sk-lbl">Taux de réussite</div>
        <div class="sk-icon">📈</div>
      </div>
    </div>

    <div class="ps">
      <div class="pl">Pays débloqués</div>
      <div style="display:flex;flex-wrap:wrap;gap:5px">
        {% for country in allCountries %}
          {% set unlocked = false %}
          {% for uc in cityData.countries %}{% if uc.id == country.id %}{% set unlocked = true %}{% endif %}{% endfor %}
          <div class="c-dot"
               title="{{ country.name }} · Streak ×{{ country.streak }}"
               style="border-color:{{ unlocked ? 'rgba(201,168,76,.38)' : 'rgba(255,255,255,.07)' }};
                      background:{{ unlocked ? 'rgba(201,168,76,.1)' : 'rgba(255,255,255,.02)' }};
                      filter:{{ unlocked ? 'none' : 'grayscale(1)' }};
                      opacity:{{ unlocked ? '1' : '0.25' }}">
            {{ country.flag }}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ps" style="border-bottom:none">
      <div class="pl">Bâtiments (<span id="bldCount">{{ cityData.buildings|length }}</span>)</div>
      <div id="bldList">
        {% for b in cityData.buildings %}
          <div class="b-item">
            <div class="b-icon" style="background:rgba(59,130,246,.1)">{{ b.icon }}</div>
            <div>
              <div class="b-name">{{ b.name }}</div>
              <div class="b-bonus">{{ b.bonus }}</div>
            </div>
          </div>
        {% endfor %}
        {% if cityData.buildings|length == 0 %}
          <div style="font-size:.68rem;color:#64748b;text-align:center;padding:12px 0">
            Score ≥75% pour construire !
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Info popup (click 3D) -->
  <div id="ec-popup">
    <div class="pp-title" id="ppTitle">—</div>
    <div class="pp-sub"   id="ppSub"></div>
    <div id="ppExtra"></div>
  </div>

  <!-- Store -->
  <div id="ec-store">
    <div class="st-title">🛒 Academic Store</div>
    <div class="st-bal">Solde : <span id="stCoins">{{ cityData.coins }}</span> 💰</div>
    <div class="st-tabs">
      <button class="st-tab active" onclick="ecTab('buildings')">🏗 Bâtiments</button>
      <button class="st-tab"        onclick="ecTab('countries')">🌍 Pays</button>
    </div>
    <div style="padding:9px 11px" id="stItems"></div>
  </div>

  <!-- Toolbar -->
  <div id="ec-tb">
    <div class="tb active" id="tbView" onclick="ecMode()">👁<div class="tb-tip">Vue libre</div></div>
    <div class="tb" onclick="ecResetCam()">🎯<div class="tb-tip">Centrer ville</div></div>
    <div class="tb" onclick="ecGoPlayer()">🧑<div class="tb-tip">Mon avatar</div></div>
    <div class="tb-sep"></div>
    <div class="tb" onclick="ecToggleLeft()">📊<div class="tb-tip">Stats</div></div>
    <a class="tb" href="{{ path('app_streak_dashboard') }}">🔥<div class="tb-tip">Streaks</div></a>
    <a class="tb" href="{{ path('app_ai_coach') }}">🤖<div class="tb-tip">AI Coach</div></a>
  </div>

  <!-- Toast -->
  <div id="ec-toast"></div>

  <!-- Modal -->
  <div id="ec-modal">
    <div class="m-box">
      <div class="m-close" onclick="document.getElementById('ec-modal').classList.remove('show')">✕</div>
      <div class="m-flag"  id="mFlag">🇫🇷</div>
      <div class="m-title" id="mTitle">Pays débloqué !</div>
      <div class="m-sub"   id="mSub"></div>
      <button class="m-btn" onclick="document.getElementById('ec-modal').classList.remove('show')">🏙 Voir ma ville !</button>
    </div>
  </div>
</div><!-- /ec-root -->
