// ════════════════════════════════════════════════════
var SBLD=[
  {id:'library',    name:'Bibliothèque', icon:'📚', color:'#3b82f6', cost:200,  rarity:'common',    bonus:'+5% XP Math',      desc:'Améliore tes compétences en mathématiques.'},
  {id:'lab',        name:'Laboratoire',  icon:'🔬', color:'#10b981', cost:350,  rarity:'rare',      bonus:'+10% XP Science',  desc:'Booste tes scores en sciences.'},
  {id:'museum',     name:'Musée',         icon:'🏛', color:'#c9a84c', cost:500,  rarity:'rare',      bonus:'Quiz culture',     desc:'Débloque des quiz culturels bonus.'},
  {id:'university', name:'Université',   icon:'🎓', color:'#8b5cf6', cost:800,  rarity:'epic',      bonus:'+25% XP total',    desc:'Multiplie tous tes gains XP.'},
  {id:'stadium',    name:'Stade',         icon:'🏟', color:'#ef4444', cost:600,  rarity:'epic',      bonus:'+Streak bonus',    desc:'Double les bonus de streak.'},
  {id:'tower',      name:"Tour d'Or",    icon:'🏆', color:'#c9a84c', cost:1200, rarity:'legendary', bonus:'×2 coins/éval',    desc:'Double tes gains de coins.'},
  {id:'hospital',   name:'Hôpital',       icon:'🏥', color:'#fca5a5', cost:400,  rarity:'rare',      bonus:'Streak protect',   desc:'Protège ton streak une fois.'},
  {id:'cafe',       name:'Café',          icon:'☕', color:'#f97316', cost:150,  rarity:'common',    bonus:'+Motivation',      desc:'Boost de motivation quotidien.'},
];

var storeBought=[], storeOpen=false, storeTab='buildings';

window.ecToggleStore=function(){
  storeOpen=!storeOpen;
  document.getElementById('ec-store').classList.toggle('open',storeOpen);
  document.getElementById('storeBtn').classList.toggle('active',storeOpen);
  if(storeOpen) renderStore();
};
window.ecTab=function(tab){
  storeTab=tab;
  document.querySelectorAll('.st-tab').forEach(function(el,i){el.classList.toggle('active',['buildings','countries'][i]===tab);});
  renderStore();
};

function renderStore(){
  var el=document.getElementById('stItems'); el.innerHTML='';
  if(storeTab==='buildings'){
    SBLD.forEach(function(item){
      var owned   = storeBought.some(function(b){return b.id===item.id;});
      var canBuy  = EC.coins >= item.cost && !owned;
      var d=document.createElement('div');
      d.className='si '+(owned?'owned':canBuy?'':'locked');
      d.innerHTML=
        '<div class="si-rarity r-'+item.rarity+'">'+item.rarity.toUpperCase()+'</div>'+
        '<div class="si-head">'+
          '<div class="si-ico" style="background:'+item.color+'20;border:1px solid '+item.color+'40">'+item.icon+'</div>'+
          '<div><div class="si-name">'+item.name+'</div><div class="si-type">'+item.bonus+'</div></div>'+
        '</div>'+
        '<div class="si-desc">'+item.desc+'</div>'+
        '<div class="si-foot">'+
          '<div class="si-price">'+(owned?'<span style="color:#4ade80">✓ Construit</span>':'💰 '+item.cost.toLocaleString())+'</div>'+
          '<button class="si-buy" '+(owned||!canBuy?'disabled':'')+' onclick="ecBuy(\''+item.id+'\')">'+(owned?'Sur la map':canBuy?'Acheter ➜':'Insuffisant')+'</button>'+
        '</div>';
      el.appendChild(d);
    });
  } else {
    ALL_COUNTRIES.forEach(function(c){
      var unlocked=EC.countries.some(function(uc){return uc.id===c.id;});
      var reach=EC.streak>=c.streak;
      var d=document.createElement('div'); d.className='si '+(unlocked||reach?'':'locked');
      d.innerHTML=
        '<div class="si-head">'+
          '<div class="si-ico" style="font-size:1.3rem;background:rgba(255,255,255,.04)">'+c.flag+'</div>'+
          '<div><div class="si-name">'+c.flag+' '+c.name+'</div><div class="si-type">'+c.monument+' · Streak ×'+c.streak+'</div></div>'+
        '</div>'+
        '<div class="si-desc">'+(c.monumentName||'')+' · '+(c.city||'')+'</div>'+
        '<div class="si-foot">'+
          '<div class="si-price">'+(reach?'🔓 Débloqué':'🔒 Streak ×'+c.streak+' requis')+'</div>'+
          '<button class="si-buy" disabled>'+(unlocked?'✓ Sur la map':reach?'Auto':'🔒')+'</button>'+
        '</div>';
      el.appendChild(d);
    });
  }
}

// ── BUG FIX PRINCIPAL : achat → apparition immédiate sur la map ──
window.ecBuy=function(id){
  var item=SBLD.find(function(b){return b.id===id;});
  if(!item){ toast('❌ Bâtiment introuvable'); return; }
  if(EC.coins<item.cost){ toast('❌ Coins insuffisants !'); return; }
  if(storeBought.some(function(b){return b.id===id;})){ toast('⚠️ Déjà construit !'); return; }

  // 1. Déduire les coins
  EC.coins -= item.cost;
  storeBought.push(item);

  // 2. Màj affichage coins
  document.getElementById('hCoins').textContent   = EC.coins.toLocaleString();
  document.getElementById('stCoins').textContent  = EC.coins.toLocaleString();

  // 3. ══ CONSTRUIRE SUR LA MAP ══
  var slot   = nextSlot();                              // slot libre garanti
  var cfgKey = ID2CFG[item.id] || 'library';           // clé visuelle
  var info   = { name:item.name, icon:item.icon, bonus:item.bonus, type:'building', cfgKey:cfgKey };
  var obj    = mkBuilding(cfgKey, slot, info, 0);       // délai 0 = immédiat
  bldObjs.push(obj);                                    // enregistrer

  // 4. Màj HUD bâtiments
  document.getElementById('hBuildings').textContent = bldObjs.length;

  // 5. Màj liste panel gauche
  syncBldList();

  // 6. Caméra sur le nouveau bâtiment
  setTimeout(function(){
    cT.set(slot.x, 0, slot.z); cR=18; cV=0.55; camUpdate();
  }, 250);

  // 7. Toast + coin pop
  toast('🏗 '+item.name+' construite sur la map !');
  var pop=document.createElement('div'); pop.className='coin-pop';
  pop.textContent='-'+item.cost+' 💰';
  document.getElementById('ec-root').appendChild(pop);
  setTimeout(function(){pop.remove();},900);

  // 8. Ré-afficher le store
  renderStore();
};

function syncBldList(){
  var list=document.getElementById('bldList');
  var cnt=document.getElementById('bldCount');
  cnt.textContent=bldObjs.length;
  list.innerHTML='';
  bldObjs.forEach(function(o){
    var d=o.data;
    var el=document.createElement('div'); el.className='b-item';
    el.innerHTML='<div class="b-icon" style="background:rgba(59,130,246,.1)">'+(d.icon||'🏢')+'</div>'+
      '<div><div class="b-name">'+d.name+'</div><div class="b-bonus">'+(d.bonus||'')+'</div></div>';
    list.appendChild(el);
  });
}

