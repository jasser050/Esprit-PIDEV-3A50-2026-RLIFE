// ════════════════════════════════════════════════════
function toast(msg){
  var t=document.getElementById('ec-toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(t._t); t._t=setTimeout(function(){t.classList.remove('show');},3200);
