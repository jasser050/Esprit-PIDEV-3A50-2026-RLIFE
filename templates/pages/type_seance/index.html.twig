{% extends 'base.html.twig' %}

{% block title %}Session Types{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto animate-fade-in">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Planning', href: path('app_planning') }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Session Types',
        subtitle: 'Add / edit / delete types (Lab, Course, Remedial, ...)'
    } %}

    <div class="flex justify-end">
        <a href="{{ path('app_type_seance_new') }}" class="btn btn-primary">+ Add</a>
    </div>

    <div class="card p-6 space-y-4">
        {% if types is empty %}
            <p class="text-sm text-secondary-600 dark:text-secondary-300">No types yet.</p>
        {% else %}
            <div class="space-y-3">
                {% for t in types %}
                    <div class="flex items-center justify-between rounded-xl border border-secondary-200 dark:border-secondary-800 p-3">
                        <div>
                            <p class="font-medium text-secondary-900 dark:text-white">{{ t.name }}</p>
                            <p class="text-xs text-secondary-500">ID: {{ t.id }}</p>
                        </div>

                        <div class="flex items-center gap-2">
                            <a class="btn btn-secondary" href="{{ path('app_type_seance_edit', {id: t.id}) }}">Edit</a>

                            <form method="post"
                                  action="{{ path('app_type_seance_delete', {id: t.id}) }}"
                                  data-confirm="Delete this type?">
                                <button type="submit" class="btn btn-secondary">Delete</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-secondary-200 dark:border-secondary-800">
            <a href="{{ path('app_planning') }}" class="btn btn-secondary">Back</a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
