{% extends 'base.html.twig' %}

{% block title %}Add a type{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto animate-fade-in">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Schedule', href: path('app_planning') },
            { label: 'Types of session', href: path('app_type_seance_index') },
            { label: 'Add' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Add a type',
        subtitle: 'like: TP, Cours, Rattrapage...'
    } %}

    <form method="post" class="card p-6 space-y-6">
        {% include 'components/input.html.twig' with {
            name: 'name',
            label: 'Type',
            type: 'text',
            required: true,
            value: ''
        } %}

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-secondary-200 dark:border-secondary-800">
            <a href="{{ path('app_type_seance_index') }}" class="btn btn-secondary">Return</a>
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div>
{% endblock %}
