{% extends 'base.html.twig' %}

{% block title %}Add Type{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto animate-fade-in">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Planning', href: path('app_planning') },
            { label: 'Session Types', href: path('app_type_seance_index') },
            { label: 'Add' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Add Type',
        subtitle: 'Ex: Lab, Course, Remedial...'
    } %}

    <form method="post" class="card p-6 space-y-6">
        {% include 'components/input.html.twig' with {
            name: 'name',
            label: 'Type',
            type: 'text',
            required: true,
            value: ''
        } %}

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-secondary-200 dark:border-secondary-800">
            <a href="{{ path('app_type_seance_index') }}" class="btn btn-secondary">Back</a>
            <button type="submit" class="btn btn-primary">Add</button>
        </div>
    </form>
</div>
{% endblock %}