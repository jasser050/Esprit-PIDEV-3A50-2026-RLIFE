{% extends 'base.html.twig' %}

{% block title %}Edit Session{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto animate-fade-in">

    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Schedule', href: path('app_planning') },
            { label: 'Sessions', href: path('app_seance_index') },
            { label: 'Edit Session' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Edit Session',
        subtitle: 'Update or delete a session'
    } %}

    {# Alert global si le formulaire a des erreurs #}
    {% if form.vars.submitted and not form.vars.valid %}
        <div class="alert alert-danger animate-fade-in">
            <i data-lucide="alert-circle" class="w-5 h-5 alert-icon"></i>
            <div>
                <p class="font-medium">Please correct the errors below</p>
                <p class="text-sm mt-0.5">Some fields require your attention</p>
            </div>
        </div>
    {% endif %}

    <div class="card p-6 space-y-6">
        {# EDIT FORM #}
        {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}

            {# Titre #}
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300'}}) }}
                    <span class="text-xs text-secondary-500 dark:text-secondary-400">Required</span>
                </div>
                
                {{ form_widget(form.titre, {
                    'attr': {
                        'class': 'w-full rounded-xl border ' ~ (form.titre.vars.errors|length > 0 ? 'border-red-500 focus:ring-red-500' : 'border-secondary-200 dark:border-secondary-800 focus:ring-primary-500') ~ ' bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-secondary-900 dark:text-white focus:outline-none focus:ring-2 transition-all',
                        'placeholder': 'e.g., Introduction to PHP'
                    }
                }) }}
                
                {# Erreurs avec icône #}
                {% if form.titre.vars.errors|length > 0 %}
                    <div class="flex items-start gap-2 text-red-600 dark:text-red-400 text-sm mt-1 animate-fade-in">
                        <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                        <div>
                            {% for error in form.titre.vars.errors %}
                                <p>{{ error.message }}</p>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    {# Tips / Aide #}
                    <div class="flex items-start gap-2 text-xs text-secondary-500 dark:text-secondary-400 mt-1">
                        <i data-lucide="info" class="w-3 h-3 mt-0.5 flex-shrink-0"></i>
                        <p>3-255 characters. Letters, numbers, underscores and spaces only.</p>
                    </div>
                {% endif %}
            </div>

            {# Type de séance #}
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    {{ form_label(form.typeSeance, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300'}}) }}
                    <span class="text-xs text-secondary-500 dark:text-secondary-400">Required</span>
                </div>
                
                {{ form_widget(form.typeSeance, {
                    'attr': {
                        'class': 'w-full rounded-xl border ' ~ (form.typeSeance.vars.errors|length > 0 ? 'border-red-500 focus:ring-red-500' : 'border-secondary-200 dark:border-secondary-800 focus:ring-primary-500') ~ ' bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-secondary-900 dark:text-white focus:outline-none focus:ring-2 transition-all'
                    }
                }) }}
                
                {# Erreurs avec icône #}
                {% if form.typeSeance.vars.errors|length > 0 %}
                    <div class="flex items-start gap-2 text-red-600 dark:text-red-400 text-sm mt-1 animate-fade-in">
                        <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                        <div>
                            {% for error in form.typeSeance.vars.errors %}
                                <p>{{ error.message }}</p>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    {# Tips / Aide #}
                    <div class="flex items-start gap-2 text-xs text-secondary-500 dark:text-secondary-400 mt-1">
                        <i data-lucide="info" class="w-3 h-3 mt-0.5 flex-shrink-0"></i>
                        <p>Choose the category that best describes this session.</p>
                    </div>
                {% endif %}
            </div>

            {# Description #}
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300'}}) }}
                    <span class="text-xs text-secondary-500 dark:text-secondary-400">Required</span>
                </div>
                
                {{ form_widget(form.description, {
                    'attr': {
                        'rows': 4,
                        'class': 'w-full rounded-xl border ' ~ (form.description.vars.errors|length > 0 ? 'border-red-500 focus:ring-red-500' : 'border-secondary-200 dark:border-secondary-800 focus:ring-primary-500') ~ ' bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-secondary-900 dark:text-white focus:outline-none focus:ring-2 resize-none transition-all',
                        'placeholder': 'Describe what this session will cover...'
                    }
                }) }}
                
                {# Erreurs avec icône #}
                {% if form.description.vars.errors|length > 0 %}
                    <div class="flex items-start gap-2 text-red-600 dark:text-red-400 text-sm mt-1 animate-fade-in">
                        <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                        <div>
                            {% for error in form.description.vars.errors %}
                                <p>{{ error.message }}</p>
                            {% endfor %}
                        </div>
                    </div>
                {% else %}
                    {# Tips / Aide #}
                    <div class="flex items-start gap-2 text-xs text-secondary-500 dark:text-secondary-400 mt-1">
                        <i data-lucide="info" class="w-3 h-3 mt-0.5 flex-shrink-0"></i>
                        <p>Provide a detailed description (5-1000 characters). Include objectives, topics, and what participants will learn.</p>
                    </div>
                {% endif %}
            </div>

            {{ form_rest(form) }}

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-secondary-200 dark:border-secondary-800">
                <a href="{{ path('app_seance_index') }}" class="btn btn-secondary">
                    <i data-lucide="x" class="w-4 h-4"></i>
                    Cancel
                </a>
                <button class="btn btn-primary" type="submit">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Save Changes
                </button>
            </div>

        {{ form_end(form) }}
    </div>

    {# DELETE SECTION - Améliorée #}
    <div class="card p-0 overflow-hidden border-red-200 dark:border-red-900/40">
        <div class="bg-gradient-to-r from-red-50 to-orange-50 dark:from-red-950/20 dark:to-orange-950/20 p-6">
            <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-red-100 dark:bg-red-900/30 flex items-center justify-center flex-shrink-0 shadow-sm">
                    <i data-lucide="alert-triangle" class="w-6 h-6 text-red-600 dark:text-red-400"></i>
                </div>

                <div class="flex-1">
                    <h3 class="font-bold text-lg text-red-900 dark:text-red-100">
                        Danger Zone
                    </h3>
                    <p class="text-sm text-red-700 dark:text-red-300 mt-1">
                        Once you delete this session, there is no going back. Please be certain.
                    </p>

                    <div class="mt-4 space-y-3">
                        {# Checklist de ce qui sera supprimé #}
                        <div class="bg-white/50 dark:bg-secondary-900/50 rounded-lg p-3 space-y-2">
                            <p class="text-xs font-medium text-red-800 dark:text-red-200 mb-2">
                                ⚠️ This will permanently delete:
                            </p>
                            <ul class="text-xs text-red-700 dark:text-red-300 space-y-1">
                                <li class="flex items-center gap-2">
                                    <i data-lucide="check" class="w-3 h-3"></i>
                                    <span>Session information and description</span>
                                </li>
                                <li class="flex items-center gap-2">
                                    <i data-lucide="check" class="w-3 h-3"></i>
                                    <span>All associated planning entries</span>
                                </li>
                                <li class="flex items-center gap-2">
                                    <i data-lucide="check" class="w-3 h-3"></i>
                                    <span>Historical data and feedbacks</span>
                                </li>
                            </ul>
                        </div>

                        {# Formulaire de suppression avec confirmation améliorée #}
                        <form method="post"
                              id="deleteForm"
                              action="{{ path('app_seance_delete', {id: seance.id}) }}"
                              class="flex items-center justify-end gap-3">

                            <input type="hidden" name="_token" value="{{ csrf_token('delete_seance_' ~ seance.id) }}">

                            <button type="button" 
                                    onclick="showDeleteConfirmation()"
                                    class="btn bg-red-600 hover:bg-red-700 text-white border-red-600 hover:border-red-700">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                Delete Session
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal de confirmation de suppression #}
<div id="deleteConfirmModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white dark:bg-secondary-800 rounded-2xl shadow-2xl max-w-md w-full mx-4 p-6 animate-scale-in">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-red-100 dark:bg-red-900/30 mx-auto mb-4">
            <i data-lucide="trash-2" class="w-6 h-6 text-red-600 dark:text-red-400"></i>
        </div>

        <h3 class="text-xl font-bold text-center text-secondary-900 dark:text-white mb-2">
            Delete Session?
        </h3>
        
        <p class="text-center text-secondary-600 dark:text-secondary-300 text-sm mb-6">
            You are about to delete <strong>"{{ seance.titre }}"</strong>. This action cannot be undone.
        </p>

        <div class="bg-red-50 dark:bg-red-900/20 rounded-xl p-4 mb-6">
            <p class="text-xs text-red-700 dark:text-red-300 text-center">
                ⚠️ Type <strong>DELETE</strong> to confirm
            </p>
            <input 
                type="text" 
                id="deleteConfirmInput"
                class="mt-3 w-full rounded-lg border border-red-300 dark:border-red-800 bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-center font-mono uppercase focus:outline-none focus:ring-2 focus:ring-red-500"
                placeholder="DELETE"
                autocomplete="off"
            >
        </div>

        <div class="flex gap-3">
            <button type="button" onclick="closeDeleteConfirmation()" class="btn btn-secondary flex-1">
                Cancel
            </button>
            <button type="button" onclick="confirmDelete()" id="confirmDeleteBtn" disabled class="btn bg-red-600 hover:bg-red-700 text-white border-red-600 hover:border-red-700 flex-1 disabled:opacity-50 disabled:cursor-not-allowed">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                Delete Forever
            </button>
        </div>
    </div>
</div>

<script>
function showDeleteConfirmation() {
    const modal = document.getElementById('deleteConfirmModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.getElementById('deleteConfirmInput').focus();
    
    // Réinitialiser lucide icons dans le modal
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
}

function closeDeleteConfirmation() {
    const modal = document.getElementById('deleteConfirmModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.getElementById('deleteConfirmInput').value = '';
    document.getElementById('confirmDeleteBtn').disabled = true;
}

// Activer le bouton de confirmation uniquement si "DELETE" est tapé
document.getElementById('deleteConfirmInput')?.addEventListener('input', function(e) {
    const btn = document.getElementById('confirmDeleteBtn');
    if (e.target.value.toUpperCase() === 'DELETE') {
        btn.disabled = false;
    } else {
        btn.disabled = true;
    }
});

// Permettre de soumettre avec Enter
document.getElementById('deleteConfirmInput')?.addEventListener('keypress', function(e) {
    if (e.key === 'Enter' && this.value.toUpperCase() === 'DELETE') {
        confirmDelete();
    }
});

function confirmDelete() {
    const input = document.getElementById('deleteConfirmInput');
    if (input.value.toUpperCase() === 'DELETE') {
        document.getElementById('deleteForm').submit();
    }
}

// Fermer le modal en cliquant à l'extérieur
document.getElementById('deleteConfirmModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeDeleteConfirmation();
    }
});

// Fermer avec Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !document.getElementById('deleteConfirmModal').classList.contains('hidden')) {
        closeDeleteConfirmation();
    }
});
</script>

<style>
@keyframes fade-in {
    from {
        opacity: 0;
        transform: translateY(-4px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes scale-in {
    from {
        transform: scale(0.95);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.animate-fade-in {
    animation: fade-in 0.3s ease-out;
}

.animate-scale-in {
    animation: scale-in 0.2s ease-out;
}
</style>
{% endblock %}