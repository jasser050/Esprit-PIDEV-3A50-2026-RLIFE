{% extends 'base.html.twig' %}

{% block title %}Seances{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <div class="flex items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Seances</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">All registered seances</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="{{ path('app_planning') }}" class="btn btn-secondary">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
                Back to Planning
            </a>
            <a href="{{ path('app_seance_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Add Seance
            </a>
        </div>
    </div>

    <div class="card overflow-hidden">
        <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
            <h2 class="text-lg font-semibold text-secondary-900 dark:text-white">Registered seances</h2>
        </div>

        <div class="p-3 space-y-2">
            {% for s in seances %}
                <div class="flex items-start justify-between gap-3 p-3 rounded-xl hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors">
                    <div class="min-w-0">
                        <p class="font-medium text-sm text-secondary-900 dark:text-white truncate">
                            {{ attribute(s, 'titre') ?? ('Seance #' ~ s.id) }}
                        </p>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">
                            {{ attribute(s, 'typeSeance') ?? '—' }}
                        </p>
                    </div>

                    <a href="{{ path('app_seance_edit', {id: s.id}) }}"
                       class="btn btn-ghost btn-icon"
                       title="Edit">
                        <i data-lucide="pencil" class="w-4 h-4"></i>
                    </a>
                </div>
            {% else %}
                <div class="empty-state py-10">
                    <i data-lucide="inbox" class="w-10 h-10 text-secondary-300 dark:text-secondary-600"></i>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-2">No seances yet</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}