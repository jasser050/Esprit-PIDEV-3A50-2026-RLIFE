{% extends 'base.html.twig' %}

{% block title %}SÃ©ances{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    {# HEADER #}
    <div class="card p-5">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-white dark:bg-secondary-900 border border-secondary-200 dark:border-secondary-800 flex items-center justify-center overflow-hidden">
                    <img src="{{ asset('image/logo.jpg') }}" alt="Logo" class="w-full h-full object-contain">
                </div>

                <div>
                    <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Session Management</h1>
                    <p class="text-secondary-500 dark:text-secondary-400 mt-1">
                        Filter, sort, export (PDF) and print
                    </p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 justify-start lg:justify-end">
                <a href="{{ path('app_planning') }}" class="btn btn-secondary">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                    Schedule
                </a>

                <a href="{{ path('app_seance_new') }}" class="btn btn-primary">
                    <i data-lucide="plus" class="w-5 h-5"></i>
                    Add
                </a>

                <a class="btn btn-secondary" target="_blank"
                   href="{{ path('app_seance_print', {
                       q: q|default(''),
                       type: typeId|default(''),
                       sort: sort|default('id'),
                       dir: dir|default('desc')
                   }) }}">
                    <i data-lucide="printer" class="w-5 h-5"></i>
                    Print
                </a>

                <a class="btn btn-primary"
                   href="{{ path('app_seance_export_pdf', {
                       q: q|default(''),
                       type: typeId|default(''),
                       sort: sort|default('id'),
                       dir: dir|default('desc')
                   }) }}">
                    <i data-lucide="file-text" class="w-5 h-5"></i>
                    Export PDF
                </a>
            </div>
        </div>
    </div>

    {# STATS (clean + elegant) #}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="card p-4">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="text-xs font-semibold text-secondary-500 dark:text-secondary-400">Displayed sessions</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight text-secondary-900 dark:text-white">
                    {{ stats.total|default(0) }}
                </div>
                <div class="mt-1 text-xs text-secondary-500 dark:text-secondary-400">
                    based on current filters
                </div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-900/20 border border-primary-100 dark:border-primary-900/40 flex items-center justify-center">
                <i data-lucide="calendar" class="w-5 h-5 text-primary-600 dark:text-primary-300"></i>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="text-xs font-semibold text-secondary-500 dark:text-secondary-400">Available types</div>
                <div class="mt-1 text-2xl font-extrabold tracking-tight text-secondary-900 dark:text-white">
                    {{ stats.typesTotal|default(0) }}
                </div>
                <div class="mt-1 text-xs text-secondary-500 dark:text-secondary-400">
                    in database
                </div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-secondary-50 dark:bg-secondary-900/20 border border-secondary-100 dark:border-secondary-800 flex items-center justify-center">
                <i data-lucide="layers" class="w-5 h-5 text-secondary-700 dark:text-secondary-200"></i>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <div class="text-xs font-semibold text-secondary-500 dark:text-secondary-400">Most frequent type</div>
                <div class="mt-1 text-base font-bold text-secondary-900 dark:text-white truncate">
                    {{ stats.topTypeName|default('â€”') ?: 'â€”' }}
                </div>
                <div class="mt-1 text-xs text-secondary-500 dark:text-secondary-400">
                    {{ stats.topTypeCount|default(0) }} session(s)
                </div>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-100 dark:border-emerald-900/40 flex items-center justify-center">
                <i data-lucide="trending-up" class="w-5 h-5 text-emerald-600 dark:text-emerald-300"></i>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <div class="text-xs font-semibold text-secondary-500 dark:text-secondary-400">Distribution (Top 3)</div>

        {% set items = stats.byType|default({}) %}
        {% if items is not empty %}
            {% set maxCount = items|first %}
        {% else %}
            {% set maxCount = 0 %}
        {% endif %}

        <div class="mt-3 space-y-2">
            {% set i = 0 %}
            {% for typeName, count in items %}
                {% if i < 3 %}
                    <div class="flex items-center justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-semibold text-secondary-900 dark:text-white truncate">
                                {{ typeName }}
                            </div>

                            <div class="mt-1 h-2 rounded-full bg-secondary-100 dark:bg-secondary-800 overflow-hidden">
                                {% if maxCount > 0 %}
                                    {% set percent = (count / maxCount) * 100 %}
                                {% else %}
                                    {% set percent = 0 %}
                                {% endif %}
                                <div class="h-2 rounded-full bg-primary-500" style="width: {{ percent }}%"></div>
                            </div>
                        </div>

                        <div class="text-sm font-bold text-secondary-700 dark:text-secondary-200">
                            {{ count }}
                        </div>
                    </div>
                {% endif %}
                {% set i = i + 1 %}
            {% endfor %}
        </div>
    </div>
</div>
    {# FILTERS (compact) #}
    <div class="card p-4">
        <form id="seance-filter-form"
              method="get"
              action="{{ path('app_seance_index') }}"
              class="flex flex-col lg:flex-row lg:items-end gap-3">

            <div class="flex-1">
                <label class="text-xs font-semibold text-secondary-600 dark:text-secondary-300">Search</label>
                <input
                    type="text"
                    name="q"
                    value="{{ q|default('') }}"
                    class="input w-full mt-1 h-10"
                    placeholder="Rechercher..."
                >
            </div>

            <div class="w-full lg:w-64">
                <label class="text-xs font-semibold text-secondary-600 dark:text-secondary-300">Type</label>
                <select name="type" class="select w-full mt-1 h-10" onchange="this.form.submit()">
                    <option value="">-- Tous --</option>
                    {% for t in types|default([]) %}
                        <option value="{{ t.id }}" {{ (typeId is not empty and typeId == (t.id ~ '')) ? 'selected' : '' }}>
                            {{ t.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex gap-2">
                <button class="btn btn-primary h-10" type="submit">
                    <i data-lucide="search" class="w-5 h-5"></i>
                    Search
                </button>

                <a class="btn btn-secondary h-10" href="{{ path('app_seance_index') }}">
                    Reset
                </a>
            </div>

            <input type="hidden" name="sort" value="{{ sort|default('id') }}">
            <input type="hidden" name="dir" value="{{ dir|default('desc') }}">
        </form>

        <div class="mt-3 text-xs text-secondary-500 dark:text-secondary-400">
            <span class="font-medium text-secondary-700 dark:text-secondary-200">{{ seances|default([])|length }}</span> result(s)
            {% if q|default('') is not empty %}
                Â· search: <span class="font-medium text-secondary-700 dark:text-secondary-200">"{{ q }}"</span>
            {% endif %}
            {% if typeId is not empty %}
                Â· type selected
            {% endif %}
        </div>
    </div>

    {# TABLE #}
    <div class="card overflow-hidden">
        <div class="px-4 py-3 border-b border-secondary-200 dark:border-secondary-800 flex items-center justify-between">
            <div class="text-sm font-semibold text-secondary-800 dark:text-secondary-100">
                Sessions List
            </div>
            <div class="text-xs text-secondary-500 dark:text-secondary-400">
                Sort: {{ sort|default('id') }} Â· {{ dir|default('desc')|upper }}
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="table w-full">
                <thead>
                <tr>
                    {% set nextDirId = (sort|default('id') == 'id' and dir|default('desc') == 'asc') ? 'desc' : 'asc' %}
                    {% set nextDirTitre = (sort|default('id') == 'titre' and dir|default('desc') == 'asc') ? 'desc' : 'asc' %}
                    {% set nextDirType = (sort|default('id') == 'type' and dir|default('desc') == 'asc') ? 'desc' : 'asc' %}

                    <th class="text-left whitespace-nowrap">
                        <a href="{{ path('app_seance_index', { q: q|default(''), type: typeId|default(''), sort: 'id', dir: nextDirId }) }}"
                           class="inline-flex items-center gap-2">
                            #
                            {% if sort|default('id') == 'id' %}
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300">
                                    {{ dir|upper }}
                                </span>
                            {% endif %}
                        </a>
                    </th>

                    <th class="text-left whitespace-nowrap">
                        <a href="{{ path('app_seance_index', { q: q|default(''), type: typeId|default(''), sort: 'titre', dir: nextDirTitre }) }}"
                           class="inline-flex items-center gap-2">
                            Title
                            {% if sort|default('') == 'titre' %}
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300">
                                    {{ dir|upper }}
                                </span>
                            {% endif %}
                        </a>
                    </th>

                    <th class="text-left whitespace-nowrap">
                        <a href="{{ path('app_seance_index', { q: q|default(''), type: typeId|default(''), sort: 'type', dir: nextDirType }) }}"
                           class="inline-flex items-center gap-2">
                            Type
                            {% if sort|default('') == 'type' %}
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-secondary-100 dark:bg-secondary-900 text-secondary-600 dark:text-secondary-300">
                                    {{ dir|upper }}
                                </span>
                            {% endif %}
                        </a>
                    </th>

                    <th class="text-left">Description</th>
                    <th class="text-left whitespace-nowrap">Actions</th>
                </tr>
                </thead>

                <tbody>
                {% for s in seances|default([]) %}
                    {% set desc = attribute(s, 'description') ?? '' %}
                    <tr class="hover:bg-secondary-50 dark:hover:bg-secondary-900/40">
                        <td class="whitespace-nowrap text-secondary-500 dark:text-secondary-400">
                            {{ s.id }}
                        </td>

                        <td class="whitespace-nowrap">
                            <div class="font-semibold text-secondary-900 dark:text-white">
                                {{ attribute(s, 'titre') ?? ('SÃ©ance #' ~ s.id) }}
                            </div>
                        </td>

                        <td class="whitespace-nowrap">
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs border border-secondary-200 dark:border-secondary-800 bg-white dark:bg-secondary-900">
                                {{ attribute(s, 'typeSeance') ?? 'â€”' }}
                            </span>
                        </td>

                        <td class="min-w-[360px]">
                            {% if desc %}
                                <div class="text-sm text-secondary-700 dark:text-secondary-200">
                                    {{ desc }}
                                </div>
                            {% else %}
                                <span class="text-sm text-secondary-400">â€”</span>
                            {% endif %}
                        </td>

                        <td class="whitespace-nowrap">
                            <div class="flex items-center gap-2">
                                <a class="btn btn-ghost btn-sm"
                                   href="{{ path('app_seance_edit', {id: s.id}) }}">
                                    <i data-lucide="pencil" class="w-4 h-4"></i>
                                    Edit
                                </a>

                                <form method="post"
                                      action="{{ path('app_seance_delete', {id: s.id}) }}"
                                      class="inline"
                                      data-confirm="Supprimer cette sÃ©ance ?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_seance_' ~ s.id) }}">
                                    <button class="btn btn-ghost btn-sm text-danger-600">
                                        <i data-lucide="trash" class="w-4 h-4"></i>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="py-10 text-center">
                            <div class="text-secondary-900 dark:text-white font-semibold">Aucune sÃ©ance trouvÃ©e</div>
                            <div class="text-secondary-500 dark:text-secondary-400 text-sm mt-1">
                                Essaie de changer la recherche, le type ou le tri.
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
