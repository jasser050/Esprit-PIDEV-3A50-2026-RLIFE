{% extends 'base.html.twig' %}

{% block title %}Add session{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto animate-fade-in">

    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Schedule', href: path('app_planning') },
            { label: 'Sessions', href: path('app_seance_index') },
            { label: 'Add session' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'Add session',
        subtitle: 'Create a new session'
    } %}

    {{ form_start(form, {'attr': {'class': 'card p-6 space-y-6'}, 'novalidate': 'novalidate'}) }}

        {# Global form errors (ex: CSRF, cross-field) #}
        {{ form_errors(form) }}

        <div class="space-y-2">
            {{ form_label(form.titre) }}
            {{ form_widget(form.titre, {
                'attr': {
                    'class': 'w-full rounded-xl border border-secondary-200 dark:border-secondary-800 bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500'
                }
            }) }}
            {{ form_errors(form.titre) }}
        </div>

        <div class="space-y-2">
            {{ form_label(form.typeSeance) }}
            {{ form_widget(form.typeSeance, {
                'attr': {
                    'class': 'w-full rounded-xl border border-secondary-200 dark:border-secondary-800 bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500'
                }
            }) }}
            {{ form_errors(form.typeSeance) }}
        </div>

        <div class="space-y-2">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {
                'attr': {
                    'rows': 4,
                    'class': 'w-full rounded-xl border border-secondary-200 dark:border-secondary-800 bg-white dark:bg-secondary-900 px-3 py-2 text-sm text-secondary-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500'
                }
            }) }}
            {{ form_errors(form.description) }}
        </div>

        {# Important: renders hidden fields like CSRF if not rendered already #}
        {{ form_rest(form) }}

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-secondary-200 dark:border-secondary-800">
            <a href="{{ path('app_seance_index') }}" class="btn btn-secondary">Back</a>
            <button class="btn btn-primary" type="submit">Save</button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}