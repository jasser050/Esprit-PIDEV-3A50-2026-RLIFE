{% extends 'base.html.twig' %}

{% block title %}Voice Assistant — AI{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
    --bg: #080c14;
    --surface: #0e1520;
    --surface2: #141d2e;
    --border: rgba(255,255,255,0.06);
    --border-active: rgba(99,179,255,0.4);
    --accent: #3b82f6;
    --accent2: #06b6d4;
    --text: #e2e8f0;
    --muted: #64748b;
    --danger: #ef4444;
    --success: #10b981;
    --radius: 16px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; min-height: 100vh; }

.va-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
.va-bg::before {
    content: ''; position: absolute; inset: 0;
    background:
        radial-gradient(ellipse 80% 60% at 20% 10%, rgba(59,130,246,0.12) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 80% 80%, rgba(6,182,212,0.08) 0%, transparent 60%),
        radial-gradient(ellipse 50% 40% at 50% 50%, rgba(99,102,241,0.05) 0%, transparent 70%);
}
.grid-overlay {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
}

.va-wrap { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 28px 24px 60px; }

.va-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 40px; }
.va-logo { display: flex; align-items: center; gap: 12px; }
.va-logo-icon {
    width: 44px; height: 44px; border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; box-shadow: 0 0 24px rgba(59,130,246,0.3);
}
.va-logo h1 {
    font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 700;
    background: linear-gradient(90deg, #93c5fd, #67e8f9);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.va-logo span { font-size: 12px; color: var(--muted); display: block; }

.back-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 10px;
    background: var(--surface2); border: 1px solid var(--border);
    color: var(--muted); font-size: 14px; text-decoration: none; transition: all 0.2s;
}
.back-btn:hover { color: var(--text); border-color: var(--border-active); }

.va-grid { display: grid; grid-template-columns: 1fr 340px; gap: 20px; }
@media (max-width: 900px) { .va-grid { grid-template-columns: 1fr; } }

.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
.card-header { padding: 18px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
.card-header h2 { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 600; color: var(--text); }
.card-header .badge {
    margin-left: auto; font-size: 11px; padding: 3px 10px; border-radius: 20px;
    background: rgba(59,130,246,0.15); color: var(--accent); border: 1px solid rgba(59,130,246,0.3);
}
.card-body { padding: 22px; }

.mic-area { display: flex; flex-direction: column; align-items: center; gap: 20px; padding: 32px 0; }
.mic-ring { position: relative; width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; }
.mic-ring-outer {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1px solid rgba(59,130,246,0.2);
    animation: spin-slow 8s linear infinite;
}
.mic-ring-outer::before {
    content: ''; position: absolute; top: -2px; left: 50%; transform: translateX(-50%);
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 10px var(--accent);
}
@keyframes spin-slow { to { transform: rotate(360deg); } }

#recordButton {
    width: 90px; height: 90px; border-radius: 50%;
    background: linear-gradient(135deg, #1e3a5f, #1a4a6e);
    border: 2px solid rgba(59,130,246,0.4);
    cursor: pointer; transition: all 0.3s;
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
    box-shadow: 0 0 30px rgba(59,130,246,0.15);
}
#recordButton svg { width: 36px; height: 36px; color: #93c5fd; transition: all 0.3s; }
#recordButton:hover { transform: scale(1.05); box-shadow: 0 0 40px rgba(59,130,246,0.3); border-color: rgba(59,130,246,0.7); }
#recordButton.recording {
    background: linear-gradient(135deg, #5f1e1e, #7a2020);
    border-color: rgba(239,68,68,0.6);
    box-shadow: 0 0 40px rgba(239,68,68,0.3);
    animation: pulse-rec 1.5s ease-in-out infinite;
}
#recordButton.recording svg { color: #fca5a5; }
@keyframes pulse-rec {
    0%,100% { box-shadow: 0 0 30px rgba(239,68,68,0.2); }
    50% { box-shadow: 0 0 60px rgba(239,68,68,0.5); }
}

.status-pill {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px; border-radius: 20px;
    font-size: 13px; font-weight: 500;
    background: var(--surface2); border: 1px solid var(--border);
    color: var(--muted); transition: all 0.3s;
}
.status-pill .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); transition: all 0.3s; }
.status-pill.active { color: #fca5a5; border-color: rgba(239,68,68,0.3); }
.status-pill.active .dot { background: var(--danger); animation: blink 1s infinite; }
@keyframes blink { 0%,100% { opacity:1; } 50% { opacity:0.3; } }

.transcript-box {
    background: var(--surface2); border: 1px solid var(--border); border-radius: 12px;
    padding: 18px; min-height: 110px; font-size: 15px; line-height: 1.7;
    color: var(--text); margin-bottom: 16px; position: relative; transition: border-color 0.3s;
}
.transcript-box.active { border-color: rgba(239,68,68,0.3); }
.transcript-box .placeholder { color: var(--muted); font-style: italic; font-size: 14px; }
.interim-text { color: var(--muted); }

.action-row { display: flex; gap: 10px; flex-wrap: wrap; }
.btn {
    display: inline-flex; align-items: center; gap: 7px; padding: 10px 18px; border-radius: 10px;
    font-size: 13px; font-weight: 500; border: none; cursor: pointer; transition: all 0.2s;
    font-family: 'DM Sans', sans-serif;
}
.btn-ghost { background: var(--surface2); border: 1px solid var(--border); color: var(--muted); }
.btn-ghost:hover { color: var(--text); border-color: var(--border-active); }
.btn-primary { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: white; box-shadow: 0 4px 16px rgba(59,130,246,0.3); }
.btn-primary:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(59,130,246,0.4); }
.btn-danger { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #fca5a5; }
.btn-danger:hover { background: rgba(239,68,68,0.25); }
.btn svg { width: 15px; height: 15px; }

.ai-panel { margin-top: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: none; }
.ai-panel.visible { display: block; animation: slide-in 0.4s ease; }
@keyframes slide-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
.ai-panel-header { padding: 16px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; }
.ai-panel-header .ai-avatar {
    width: 36px; height: 36px; border-radius: 10px;
    background: linear-gradient(135deg, #1565c0, #00838f);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; box-shadow: 0 0 16px rgba(59,130,246,0.3);
}
.ai-panel-header h3 { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--text); }
.ai-panel-header p { font-size: 11px; color: var(--muted); }

.thinking { display: flex; align-items: center; gap: 8px; padding: 28px 22px; }
.dot-wave { display: flex; gap: 5px; align-items: center; }
.dot-wave span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: wave 1.2s ease-in-out infinite; }
.dot-wave span:nth-child(2) { animation-delay: 0.15s; }
.dot-wave span:nth-child(3) { animation-delay: 0.3s; }
@keyframes wave { 0%,100% { transform: translateY(0); opacity: 0.4; } 50% { transform: translateY(-6px); opacity: 1; } }
.thinking-label { font-size: 13px; color: var(--muted); }

.ai-answer { padding: 22px; font-size: 14px; line-height: 1.8; color: #cbd5e1; display: none; }
.ai-answer.visible { display: block; }
.ai-answer h3 { font-family: 'Syne', sans-serif; font-size: 15px; color: #93c5fd; margin: 14px 0 6px; }
.ai-answer h4 { font-size: 14px; color: #7dd3fc; margin: 10px 0 4px; }
.ai-answer strong { color: #e2e8f0; }
.ai-answer ul, .ai-answer ol { padding-left: 20px; margin: 8px 0; }
.ai-answer li { margin-bottom: 4px; }
.ai-answer p { margin-bottom: 10px; }
.ai-answer .ai-summary-tag {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11px; padding: 3px 10px; border-radius: 20px;
    background: rgba(59,130,246,0.1); color: #93c5fd;
    border: 1px solid rgba(59,130,246,0.2); margin-bottom: 14px;
}

.ai-error { padding: 22px; color: #fca5a5; font-size: 13px; align-items: center; gap: 8px; display: none; }
.ai-error.visible { display: flex; }

.tts-bar { padding: 12px 22px; border-top: 1px solid var(--border); align-items: center; gap: 10px; display: none; }
.tts-bar.visible { display: flex; }

.sidebar { display: flex; flex-direction: column; gap: 16px; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.stat-block { background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 14px; text-align: center; }
.stat-block .val { font-family: 'Syne', sans-serif; font-size: 26px; font-weight: 700; color: var(--text); }
.stat-block .lbl { font-size: 11px; color: var(--muted); margin-top: 2px; }

select {
    width: 100%; padding: 10px 14px; background: var(--surface2); border: 1px solid var(--border);
    border-radius: 10px; color: var(--text); font-size: 14px; font-family: 'DM Sans', sans-serif;
    outline: none; cursor: pointer; transition: border-color 0.2s;
}
select:focus { border-color: var(--border-active); }
select option { background: #1e293b; }

.history-list { display: flex; flex-direction: column; gap: 8px; max-height: 320px; overflow-y: auto; }
.history-list::-webkit-scrollbar { width: 4px; }
.history-list::-webkit-scrollbar-track { background: transparent; }
.history-list::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 4px; }

.hist-item { background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 12px; transition: border-color 0.2s; }
.hist-item:hover { border-color: var(--border-active); }
.hist-item .hist-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.hist-item .hist-date { font-size: 11px; color: var(--muted); }
.hist-item .hist-del { background: none; border: none; cursor: pointer; color: var(--muted); font-size: 13px; padding: 0; transition: color 0.2s; }
.hist-item .hist-del:hover { color: var(--danger); }
.hist-item .hist-text { font-size: 13px; color: #94a3b8; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.hist-item .hist-words { margin-top: 6px; font-size: 11px; color: var(--accent); background: rgba(59,130,246,0.08); border-radius: 20px; padding: 2px 8px; display: inline-block; }

.tip-list { display: flex; flex-direction: column; gap: 10px; }
.tip-item { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: #94a3b8; line-height: 1.5; }
.tip-num {
    width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
    background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.3);
    color: #93c5fd; font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center; font-family: 'Syne', sans-serif;
}
.label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; display: block; }
.icon-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); margin-right: 4px; display: inline-block; }
</style>
{% endblock %}

{% block body %}
<div class="va-bg"><div class="grid-overlay"></div></div>

<div class="va-wrap">

    <header class="va-header">
        <div class="va-logo">
            <div class="va-logo-icon">🎙</div>
            <div>
                <h1>VoiceAI Assistant</h1>
                <span>Powered by Gemini · Speak, Ask, Learn</span>
            </div>
        </div>
        <a href="{{ path('app_courses') }}" class="back-btn">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Courses
        </a>
    </header>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div style="margin-bottom:16px; padding:14px 18px; border-radius:10px; font-size:14px; border:1px solid;
                {% if label == 'success' %}background:rgba(16,185,129,0.1);border-color:rgba(16,185,129,0.3);color:#6ee7b7;
                {% elseif label == 'error' %}background:rgba(239,68,68,0.1);border-color:rgba(239,68,68,0.3);color:#fca5a5;
                {% else %}background:rgba(59,130,246,0.1);border-color:rgba(59,130,246,0.3);color:#93c5fd;{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="va-grid">
        <div>
            <!-- Recording Card -->
            <div class="card">
                <div class="card-header">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#93c5fd">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                    </svg>
                    <h2>Voice Input</h2>
                    <div class="badge" id="browserBadge"><span class="icon-dot"></span>Supported</div>
                </div>
                <div class="card-body">
                    <div class="mic-area">
                        <div class="mic-ring">
                            <div class="mic-ring-outer"></div>
                            <button id="recordButton" title="Click to record">
                                <svg id="micIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                                </svg>
                            </button>
                        </div>
                        <div id="statusPill" class="status-pill">
                            <div class="dot"></div>
                            <span id="statusText">Ready to record</span>
                        </div>
                        <p style="font-size:12px;color:var(--muted)">Click the microphone and speak clearly</p>
                    </div>

                    <span class="label">Transcription</span>
                    <div id="transcript" class="transcript-box">
                        <span class="placeholder">Your spoken question will appear here...</span>
                    </div>

                    <div class="action-row">
                        <button id="askAiBtn" class="btn btn-primary">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            Ask Gemini
                        </button>
                        <button id="copyBtn" class="btn btn-ghost">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            Copy
                        </button>
                        <button id="saveBtn" class="btn btn-ghost">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
                            Save
                        </button>
                        <button id="clearBtn" class="btn btn-danger" style="margin-left:auto">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            Clear
                        </button>
                    </div>
                </div>
            </div>

            <!-- AI Response Panel -->
            <div class="ai-panel" id="aiPanel">
                <div class="ai-panel-header">
                    <div class="ai-avatar">✨</div>
                    <div>
                        <h3>AI Summary & Answer</h3>
                        <p>Gemini — Google (via OpenRouter)</p>
                    </div>
                    <div style="margin-left:auto;">
    <button id="ttsBtn" class="btn btn-ghost" style="font-size:12px;display:none">🔊 Read aloud</button>
</div>
                </div>
                <div class="thinking" id="aiThinking" style="display:none">
                    <div class="dot-wave"><span></span><span></span><span></span></div>
                    <span class="thinking-label">Gemini is analyzing your question...</span>
                </div>
                <div class="ai-answer" id="aiAnswer"></div>
                <div class="ai-error" id="aiError">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span id="aiErrorMsg">An error occurred. Please try again.</span>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="sidebar">
            <div class="card">
                <div class="card-header">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#93c5fd"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                    <h2>Session Stats</h2>
                </div>
                <div class="card-body">
                    <div class="stats-grid">
                        <div class="stat-block"><div class="val" id="wordCount">0</div><div class="lbl">Words</div></div>
                        <div class="stat-block"><div class="val" id="duration">0:00</div><div class="lbl">Duration</div></div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#93c5fd"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
                    <h2>Language</h2>
                </div>
                <div class="card-body">
                    <select id="langSelect">
                        <option value="en-US">🇺🇸 English</option>
                        <option value="fr-FR">🇫🇷 Français</option>
                        <option value="ar-SA">🇸🇦 العربية</option>
                        <option value="es-ES">🇪🇸 Español</option>
                        <option value="de-DE">🇩🇪 Deutsch</option>
                    </select>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#93c5fd"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <h2>How it works</h2>
                </div>
                <div class="card-body">
                    <div class="tip-list">
                        <div class="tip-item"><div class="tip-num">1</div><span>Click the mic and ask your question aloud</span></div>
                        <div class="tip-item"><div class="tip-num">2</div><span>Click again to stop recording</span></div>
                        <div class="tip-item"><div class="tip-num">3</div><span>Press <strong style="color:var(--text)">Ask Gemini</strong> to get a smart answer</span></div>
                        <div class="tip-item"><div class="tip-num">4</div><span>Read or listen to Gemini's answer</span></div>
                        <div class="tip-item"><div class="tip-num">5</div><span>Save your question to history</span></div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color:#93c5fd"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <h2>History</h2>
                    <button onclick="clearAllHistory()" class="btn btn-danger" style="margin-left:auto;padding:5px 12px;font-size:11px">Clear all</button>
                </div>
                <div class="card-body" style="padding-top:14px">
                    <div class="history-list" id="historyList"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// ════════════════════════════════════════════════════════════════
// 🔑 COLLE TA CLÉ OPENROUTER ICI

const OPENROUTER_KEY = "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";
const AI_URL = "https://openrouter.ai/api/v1/chat/completions";
const AI_MODEL = "openrouter/free";
document.addEventListener('DOMContentLoaded', () => {
    const recordBtn   = document.getElementById('recordButton');
    const micIcon     = document.getElementById('micIcon');
    const statusPill  = document.getElementById('statusPill');
    const statusText  = document.getElementById('statusText');
    const transcript  = document.getElementById('transcript');
    const wordCount   = document.getElementById('wordCount');
    const duration    = document.getElementById('duration');
    const askAiBtn    = document.getElementById('askAiBtn');
    const copyBtn     = document.getElementById('copyBtn');
    const saveBtn     = document.getElementById('saveBtn');
    const clearBtn    = document.getElementById('clearBtn');
    const langSelect  = document.getElementById('langSelect');
    const historyList = document.getElementById('historyList');
    const aiPanel     = document.getElementById('aiPanel');
    const aiThinking  = document.getElementById('aiThinking');
    const aiAnswer    = document.getElementById('aiAnswer');
    const aiError     = document.getElementById('aiError');
    const aiErrorMsg  = document.getElementById('aiErrorMsg');
    const ttsBar      = document.getElementById('ttsBar');
    const ttsBtn      = document.getElementById('ttsBtn');

    let recognition, isRecording = false;
    let fullTranscript = '', durationInterval, startTime;
    let currentAiText = '';

    // ── Speech Recognition ──────────────────────────────────────
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        document.getElementById('browserBadge').innerHTML = '✗ Not supported';
        document.getElementById('browserBadge').style.background = 'rgba(239,68,68,0.15)';
        document.getElementById('browserBadge').style.color = '#fca5a5';
        recordBtn.disabled = true;
        return;
    }

    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'en-US';

    langSelect.addEventListener('change', () => { recognition.lang = langSelect.value; });
    recordBtn.addEventListener('click', () => isRecording ? stopRec() : startRec());

    function startRec() {
        try {
            recognition.start();
            isRecording = true;
            startTime = Date.now();
            recordBtn.classList.add('recording');
            statusPill.classList.add('active');
            statusText.textContent = 'Recording...';
            transcript.classList.add('active');
            durationInterval = setInterval(() => {
                const s = Math.floor((Date.now() - startTime) / 1000);
                duration.textContent = `${Math.floor(s/60)}:${String(s%60).padStart(2,'0')}`;
            }, 1000);
            micIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/>`;
        } catch(e) { console.error(e); }
    }

    function stopRec() {
        recognition.stop();
        isRecording = false;
        clearInterval(durationInterval);
        recordBtn.classList.remove('recording');
        statusPill.classList.remove('active');
        statusText.textContent = 'Ready to record';
        transcript.classList.remove('active');
        micIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>`;
    }

    recognition.onresult = (e) => {
        let interim = '', final = '';
        for (let i = e.resultIndex; i < e.results.length; i++) {
            const t = e.results[i][0].transcript;
            e.results[i].isFinal ? (final += t + ' ') : (interim += t);
        }
        if (final) fullTranscript += final;
        transcript.innerHTML = `<span>${fullTranscript}</span><span class="interim-text">${interim}</span>`;
        wordCount.textContent = fullTranscript.trim().split(/\s+/).filter(Boolean).length;
    };

    recognition.onerror = (e) => {
        if (e.error === 'not-allowed') alert('⚠️ Microphone access denied. Please allow it in your browser settings.');
        stopRec();
    };

    recognition.onend = () => {
        if (isRecording) { try { recognition.start(); } catch(e) { stopRec(); } }
    };

    // ── ASK GEMINI via OpenRouter ───────────────────────────────
    askAiBtn.addEventListener('click', async () => {
        const question = fullTranscript.trim();
        if (!question) { alert('Please record a question first!'); return; }

        if (OPENROUTER_KEY === "COLLE_TA_CLÉ_OPENROUTER_ICI") {
            alert('⚠️ Configure ta clé OpenRouter !\n1. Va sur https://openrouter.ai\n2. Crée un compte gratuit\n3. Keys → Create Key\n4. Remplace COLLE_TA_CLÉ_OPENROUTER_ICI dans le fichier');
            return;
        }

        aiPanel.classList.add('visible');
        aiThinking.style.display = 'flex';
        aiAnswer.classList.remove('visible');
        aiError.classList.remove('visible');
ttsBtn.style.display = 'none';
        currentAiText = '';
        askAiBtn.disabled = true;
        aiPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        const langMap = { 'fr-FR':'French','en-US':'English','ar-SA':'Arabic','es-ES':'Spanish','de-DE':'German' };
        const langName = langMap[langSelect.value] || 'English';

        try {
            const res = await fetch(AI_URL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${OPENROUTER_KEY}`,
                    'HTTP-Referer': window.location.origin,
                    'X-Title': 'RLIFE Voice Assistant'
                },
                body: JSON.stringify({
                    model: AI_MODEL,
                    messages: [{
                        role: "user",
                        content: `You are an intelligent student assistant for a learning platform called RLIFE.
The student asked this question via voice (in ${langName}): "${question}"

Respond in ${langName}. Structure your response with:
1. Start with: <div class="ai-summary-tag">📋 <strong>Summary:</strong> (1-2 sentence summary here)</div>
2. Then provide a complete educational answer using these HTML tags only: <h3>, <h4>, <p>, <ul>, <li>, <strong>

Be clear, precise and helpful for a student. Use only HTML tags, no markdown.`
                    }],
                    max_tokens: 1200,
                    temperature: 0.7
                })
            });

            const data = await res.json();

            if (data.error) {
                throw new Error(data.error.message || 'API Error');
            }

            const answer = data.choices?.[0]?.message?.content;
            if (!answer) throw new Error('Empty response from AI');

            currentAiText = answer;
            aiThinking.style.display = 'none';
            aiAnswer.innerHTML = answer;
            aiAnswer.classList.add('visible');
ttsBtn.style.display = 'inline-flex';
        } catch (err) {
            console.error('AI error:', err);
            aiThinking.style.display = 'none';
            aiErrorMsg.textContent = '❌ ' + err.message;
            aiError.classList.add('visible');
        } finally {
            askAiBtn.disabled = false;
        }
    });

    // ── TTS ─────────────────────────────────────────────────────
   ttsBtn.addEventListener('click', () => {
    if (speechSynthesis.speaking) {
        speechSynthesis.cancel();
        ttsBtn.textContent = '🔊 Read aloud';
        return;
    }

    // Lire le texte visible dans aiAnswer (pas currentAiText)
    const plain = document.getElementById('aiAnswer').innerText.trim();
    if (!plain) return;

    const utter = new SpeechSynthesisUtterance(plain);
    utter.lang = langSelect.value;
    utter.rate = 0.9;
    utter.pitch = 1;
    utter.volume = 1;

    utter.onstart = () => { ttsBtn.textContent = '⏹ Stop'; };
    utter.onend = () => { ttsBtn.textContent = '🔊 Read aloud'; };
    utter.onerror = (e) => { 
        console.error('TTS error:', e);
        ttsBtn.textContent = '🔊 Read aloud'; 
    };

    speechSynthesis.speak(utter);
});

    // ── Clear ────────────────────────────────────────────────────
    clearBtn.addEventListener('click', () => {
        fullTranscript = '';
        transcript.innerHTML = '<span class="placeholder">Your spoken question will appear here...</span>';
        wordCount.textContent = '0';
        duration.textContent = '0:00';
        aiPanel.classList.remove('visible');
        currentAiText = '';
        if (speechSynthesis.speaking) speechSynthesis.cancel();
    });

    // ── Copy ─────────────────────────────────────────────────────
    copyBtn.addEventListener('click', () => {
        if (!fullTranscript.trim()) return;
        navigator.clipboard.writeText(fullTranscript.trim()).then(() => {
            copyBtn.textContent = '✓ Copied!';
            setTimeout(() => { copyBtn.innerHTML = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:15px;height:15px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy`; }, 2000);
        });
    });

    // ── Save ─────────────────────────────────────────────────────
    saveBtn.addEventListener('click', () => {
        if (!fullTranscript.trim()) { alert('Nothing to save!'); return; }
        let hist = JSON.parse(localStorage.getItem('vaHistory') || '[]');
        hist.unshift({
            id: Date.now(),
            text: fullTranscript.trim(),
            words: fullTranscript.trim().split(/\s+/).filter(Boolean).length,
            date: new Date().toLocaleString('en-US', { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' })
        });
        if (hist.length > 50) hist = hist.slice(0, 50);
        localStorage.setItem('vaHistory', JSON.stringify(hist));
        saveBtn.textContent = '✓ Saved!';
        setTimeout(() => { saveBtn.innerHTML = `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:15px;height:15px"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg> Save`; }, 2000);
        loadHistory();
    });

    // ── History ──────────────────────────────────────────────────
    function loadHistory() {
        const hist = JSON.parse(localStorage.getItem('vaHistory') || '[]');
        if (!hist.length) {
            historyList.innerHTML = '<div style="text-align:center;padding:24px 0;font-size:13px;color:var(--muted)">No saved notes yet</div>';
            return;
        }
        historyList.innerHTML = hist.map(n => `
            <div class="hist-item">
                <div class="hist-meta">
                    <span class="hist-date">${n.date}</span>
                    <button class="hist-del" onclick="deleteNote(${n.id})">✕</button>
                </div>
                <div class="hist-text">${n.text}</div>
                <span class="hist-words">${n.words} words</span>
            </div>
        `).join('');
    }

    window.deleteNote = (id) => {
        let hist = JSON.parse(localStorage.getItem('vaHistory') || '[]');
        localStorage.setItem('vaHistory', JSON.stringify(hist.filter(n => n.id !== id)));
        loadHistory();
    };

    window.clearAllHistory = () => {
        if (confirm('Delete all saved notes?')) {
            localStorage.removeItem('vaHistory');
            loadHistory();
        }
    };

    loadHistory();
});
</script>
{% endblock %}
