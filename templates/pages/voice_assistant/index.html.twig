{% extends 'base.html.twig' %}

{% block title %}🎤 Voice Assistant{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Animated Gradient Background */
@keyframes gradient-xy {
    0%, 100% {
        background-position: 0% 50%;
        background-size: 400% 400%;
    }
    50% {
        background-position: 100% 50%;
        background-size: 400% 400%;
    }
}

.animate-gradient-xy {
    animation: gradient-xy 15s ease infinite;
    background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
}

/* Floating Bubbles */
.bubble {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    animation: float-up 20s infinite ease-in-out;
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
}

.bubble-1 {
    width: 80px;
    height: 80px;
    left: 10%;
    animation-delay: 0s;
}

.bubble-2 {
    width: 120px;
    height: 120px;
    left: 20%;
    animation-delay: 2s;
}

.bubble-3 {
    width: 60px;
    height: 60px;
    left: 35%;
    animation-delay: 4s;
}

.bubble-4 {
    width: 100px;
    height: 100px;
    left: 50%;
    animation-delay: 0s;
}

.bubble-5 {
    width: 70px;
    height: 70px;
    left: 65%;
    animation-delay: 3s;
}

.bubble-6 {
    width: 90px;
    height: 90px;
    left: 75%;
    animation-delay: 1s;
}

.bubble-7 {
    width: 110px;
    height: 110px;
    left: 85%;
    animation-delay: 5s;
}

.bubble-8 {
    width: 65px;
    height: 65px;
    left: 95%;
    animation-delay: 2.5s;
}

@keyframes float-up {
    0% {
        bottom: -150px;
        transform: translateX(0) rotate(0deg);
        opacity: 0;
    }
    10% {
        opacity: 0.5;
    }
    50% {
        transform: translateX(50px) rotate(180deg);
        opacity: 0.8;
    }
    100% {
        bottom: 100%;
        transform: translateX(-50px) rotate(360deg);
        opacity: 0;
    }
}

/* Floating Orbs */
.orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.7;
    animation: float-orb 8s infinite ease-in-out;
}

.orb-1 {
    width: 300px;
    height: 300px;
    background: rgba(139, 92, 246, 0.5);
    top: 10%;
    left: 10%;
    animation-delay: 0s;
}

.orb-2 {
    width: 250px;
    height: 250px;
    background: rgba(236, 72, 153, 0.5);
    top: 60%;
    right: 10%;
    animation-delay: 2s;
}

.orb-3 {
    width: 200px;
    height: 200px;
    background: rgba(59, 130, 246, 0.5);
    bottom: 10%;
    left: 50%;
    animation-delay: 4s;
}

@keyframes float-orb {
    0%, 100% {
        transform: translate(0, 0) scale(1);
    }
    33% {
        transform: translate(30px, -30px) scale(1.1);
    }
    66% {
        transform: translate(-30px, 30px) scale(0.9);
    }
}
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen relative overflow-hidden">
    <!-- Animated Background -->
    <div class="absolute inset-0 animate-gradient-xy"></div>
    
    <!-- Floating Orbs -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    
    <!-- Floating Bubbles -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="bubble bubble-1"></div>
        <div class="bubble bubble-2"></div>
        <div class="bubble bubble-3"></div>
        <div class="bubble bubble-4"></div>
        <div class="bubble bubble-5"></div>
        <div class="bubble bubble-6"></div>
        <div class="bubble bubble-7"></div>
        <div class="bubble bubble-8"></div>
    </div>
    
    <!-- Content wrapper -->
    <div class="relative z-10 py-12">
        <div class="container mx-auto px-4 max-w-6xl">
            
            <!-- Back Button -->
            <div class="mb-8">
                <a href="/courses" 
                   class="inline-flex items-center gap-2 px-6 py-3 bg-white/20 backdrop-blur-md text-white font-semibold rounded-xl hover:bg-white/30 transition-all duration-300 border border-white/30 shadow-lg hover:shadow-xl transform hover:scale-105">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Back to Courses
                </a>
            </div>

            <!-- Header -->
            <div class="text-center mb-12">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-white/20 backdrop-blur-md rounded-full mb-4 animate-pulse shadow-2xl">
                    <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                    </svg>
                </div>
                <h1 class="text-5xl font-bold text-white mb-2 drop-shadow-2xl">🎤 Voice Assistant</h1>
                <p class="text-white/90 text-lg drop-shadow-lg">Dictate your study notes hands-free</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <!-- Main Recording Area -->
                <div class="lg:col-span-2">
                    <div class="bg-white/10 backdrop-blur-xl rounded-3xl shadow-2xl p-8 border border-white/20">
                        
                        <!-- Status Indicator -->
                        <div id="statusIndicator" class="text-center mb-8">
                            <div class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-white/20 backdrop-blur-md border border-white/30">
                                <div id="statusDot" class="w-3 h-3 rounded-full bg-green-400 shadow-lg"></div>
                                <span id="statusText" class="font-semibold text-white">Ready to record</span>
                            </div>
                        </div>

                        <!-- Recording Button -->
                        <div class="text-center mb-8">
                            <button id="recordButton" 
                                    class="relative w-32 h-32 rounded-full bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 shadow-2xl hover:shadow-purple-500/50 transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-4 focus:ring-white/50">
                                <svg id="micIcon" class="w-16 h-16 text-white mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
                                </svg>
                                <div id="recordingRipple" class="hidden absolute inset-0 rounded-full border-4 border-red-500 animate-ping"></div>
                            </button>
                            <p class="mt-4 text-sm text-white/80">Click to start recording</p>
                        </div>

                        <!-- Transcript Display -->
                        <div class="bg-white/90 rounded-2xl p-6 min-h-[200px] shadow-xl">
                            <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                                Live Transcript
                            </h3>
                            <div id="transcript" class="text-gray-700 leading-relaxed min-h-[100px]">
                                <p class="text-gray-400 italic">Your speech will appear here...</p>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6">
                            <button id="clearButton" 
                                    class="px-4 py-3 bg-white/20 backdrop-blur-md text-white font-semibold rounded-xl hover:bg-white/30 transition-all duration-200 flex items-center justify-center gap-2 border border-white/30">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                <span class="hidden sm:inline">Clear</span>
                            </button>
                            
                            <button id="copyButton" 
                                    class="px-4 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-all duration-200 flex items-center justify-center gap-2 shadow-lg">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                                <span class="hidden sm:inline">Copy</span>
                            </button>
                            
                            <button id="googleButton" 
                                    class="px-4 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-cyan-700 transition-all duration-200 flex items-center justify-center gap-2 shadow-lg">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                </svg>
                                <span class="hidden sm:inline">Google</span>
                            </button>
                            
                            <button id="saveButton" 
                                    class="px-4 py-3 bg-gradient-to-r from-green-600 to-teal-600 text-white font-semibold rounded-xl hover:from-green-700 hover:to-teal-700 transition-all duration-200 flex items-center justify-center gap-2 shadow-lg">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                                </svg>
                                <span class="hidden sm:inline">Save</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sidebar -->
                <div class="lg:col-span-1 space-y-6">
                    
                    <!-- Quick Stats -->
                    <div class="bg-white/10 backdrop-blur-xl rounded-2xl shadow-2xl p-6 border border-white/20">
                        <h3 class="text-lg font-bold text-white mb-4">📊 Session Stats</h3>
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-white/80">Words</span>
                                <span id="wordCount" class="font-bold text-white text-xl">0</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-white/80">Duration</span>
                                <span id="duration" class="font-bold text-white text-xl">0:00</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-white/80">Status</span>
                                <span id="browserStatus" class="text-xs px-2 py-1 rounded-full bg-green-100 text-green-700">✓ Supported</span>
                            </div>
                        </div>
                    </div>

                    <!-- Language Selection -->
                    <div class="bg-white/10 backdrop-blur-xl rounded-2xl shadow-2xl p-6 border border-white/20">
                        <h3 class="text-lg font-bold text-white mb-4">🌍 Language</h3>
                        <select id="languageSelect" class="w-full px-4 py-2 bg-white/20 backdrop-blur-md border border-white/30 text-white rounded-lg focus:ring-2 focus:ring-white/50 focus:border-transparent">
                            <option value="en-US" class="text-gray-900">English (US)</option>
                            <option value="en-GB" class="text-gray-900">English (UK)</option>
                            <option value="fr-FR" class="text-gray-900">Français</option>
                            <option value="es-ES" class="text-gray-900">Español</option>
                            <option value="de-DE" class="text-gray-900">Deutsch</option>
                            <option value="ar-SA" class="text-gray-900">العربية</option>
                        </select>
                    </div>

                    <!-- Tips -->
                    <div class="bg-white/10 backdrop-blur-xl rounded-2xl shadow-2xl p-6 border border-white/20">
                        <h3 class="text-lg font-bold text-white mb-4">💡 Tips</h3>
                        <ul class="space-y-2 text-sm text-white/90">
                            <li class="flex items-start gap-2">
                                <span class="text-yellow-300">•</span>
                                <span>Speak clearly and at a moderate pace</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-yellow-300">•</span>
                                <span>Click the mic again to pause</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-yellow-300">•</span>
                                <span>Works best in quiet environments</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-yellow-300">•</span>
                                <span>Use "Google It" to search what you said</span>
                            </li>
                        </ul>
                    </div>

                    <!-- History Section -->
                    <div class="bg-white/10 backdrop-blur-xl rounded-2xl shadow-2xl p-6 border border-white/20">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                📜 History
                            </h3>
                            <button onclick="clearAllHistory()" 
                                    class="text-xs px-3 py-1 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors">
                                Clear All
                            </button>
                        </div>
                        
                        <div id="historyContainer" class="space-y-3 max-h-96 overflow-y-auto">
                            <!-- History will be loaded here by JavaScript -->
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const recordButton = document.getElementById('recordButton');
    const transcript = document.getElementById('transcript');
    const statusText = document.getElementById('statusText');
    const statusDot = document.getElementById('statusDot');
    const recordingRipple = document.getElementById('recordingRipple');
    const wordCount = document.getElementById('wordCount');
    const duration = document.getElementById('duration');
    const clearButton = document.getElementById('clearButton');
    const copyButton = document.getElementById('copyButton');
    const saveButton = document.getElementById('saveButton');
    const googleButton = document.getElementById('googleButton');
    const languageSelect = document.getElementById('languageSelect');
    const browserStatus = document.getElementById('browserStatus');
    const historyContainer = document.getElementById('historyContainer');

    let recognition;
    let isRecording = false;
    let fullTranscript = '';
    let startTime;
    let durationInterval;

    // Check browser support
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        browserStatus.textContent = '✗ Not Supported';
        browserStatus.className = 'text-xs px-2 py-1 rounded-full bg-red-100 text-red-700';
        recordButton.disabled = true;
        alert('Votre navigateur ne supporte pas la reconnaissance vocale. Utilisez Chrome, Edge, ou Safari.');
        return;
    }

    // Initialize Speech Recognition
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SpeechRecognition();
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.lang = 'en-US';

    // Language change
    languageSelect.addEventListener('change', () => {
        recognition.lang = languageSelect.value;
    });

    // Start/Stop Recording
    recordButton.addEventListener('click', () => {
        if (!isRecording) {
            startRecording();
        } else {
            stopRecording();
        }
    });

    function startRecording() {
        try {
            recognition.start();
            isRecording = true;
            startTime = Date.now();
            
            recordButton.classList.add('bg-red-600', 'hover:bg-red-700');
            recordButton.classList.remove('bg-gradient-to-r', 'from-purple-600', 'to-pink-600');
            statusText.textContent = '🔴 Recording...';
            statusDot.className = 'w-3 h-3 rounded-full bg-red-500 animate-pulse shadow-lg';
            recordingRipple.classList.remove('hidden');
            
            durationInterval = setInterval(updateDuration, 1000);
            
        } catch (error) {
            console.error('Error:', error);
            alert('Erreur lors du démarrage. Vérifiez votre microphone.');
        }
    }

    function stopRecording() {
        recognition.stop();
        isRecording = false;
        
        recordButton.classList.remove('bg-red-600', 'hover:bg-red-700');
        recordButton.classList.add('bg-gradient-to-r', 'from-purple-600', 'to-pink-600');
        statusText.textContent = 'Ready to record';
        statusDot.className = 'w-3 h-3 rounded-full bg-green-400 shadow-lg';
        recordingRipple.classList.add('hidden');
        
        clearInterval(durationInterval);
    }

    function updateDuration() {
        const elapsed = Math.floor((Date.now() - startTime) / 1000);
        const minutes = Math.floor(elapsed / 60);
        const seconds = elapsed % 60;
        duration.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }

    // Handle recognition results
    recognition.onresult = (event) => {
        let interimTranscript = '';
        let finalTranscript = '';

        for (let i = event.resultIndex; i < event.results.length; i++) {
            const transcriptPiece = event.results[i][0].transcript;
            if (event.results[i].isFinal) {
                finalTranscript += transcriptPiece + ' ';
            } else {
                interimTranscript += transcriptPiece;
            }
        }

        if (finalTranscript) {
            fullTranscript += finalTranscript;
        }

        transcript.innerHTML = fullTranscript + '<span class="text-gray-400">' + interimTranscript + '</span>';
        
        const words = fullTranscript.trim().split(/\s+/).filter(w => w.length > 0);
        wordCount.textContent = words.length;
        
        transcript.scrollTop = transcript.scrollHeight;
    };

    // Handle errors
    recognition.onerror = (event) => {
        console.error('Error:', event.error);
        
        if (event.error === 'not-allowed') {
            alert('❌ Permission refusée. Autorisez l\'accès au microphone.');
        } else if (event.error === 'no-speech') {
            statusText.textContent = '⚠️ Aucune parole détectée';
        }
        
        stopRecording();
    };

    recognition.onend = () => {
        if (isRecording) {
            try {
                recognition.start();
            } catch(e) {
                stopRecording();
            }
        }
    };

    // Clear button
    clearButton.addEventListener('click', () => {
        fullTranscript = '';
        transcript.innerHTML = '<p class="text-gray-400 italic">Your speech will appear here...</p>';
        wordCount.textContent = '0';
    });

    // Copy button
    copyButton.addEventListener('click', () => {
        if (fullTranscript.trim()) {
            navigator.clipboard.writeText(fullTranscript.trim()).then(() => {
                copyButton.textContent = '✓ Copied!';
                setTimeout(() => {
                    copyButton.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg><span class="hidden sm:inline">Copy</span>';
                }, 2000);
            });
        }
    });

    // Google Search button
    googleButton.addEventListener('click', () => {
        if (fullTranscript.trim()) {
            const searchQuery = encodeURIComponent(fullTranscript.trim());
            window.open(`https://www.google.com/search?q=${searchQuery}`, '_blank');
        } else {
            alert('Rien à rechercher ! Enregistrez d\'abord quelque chose.');
        }
    });

    // Save to History
    saveButton.addEventListener('click', () => {
        if (!fullTranscript.trim()) {
            alert('Rien à sauvegarder !');
            return;
        }

        let history = JSON.parse(localStorage.getItem('voiceHistory') || '[]');
        
        const note = {
            id: Date.now(),
            text: fullTranscript.trim(),
            wordCount: fullTranscript.trim().split(/\s+/).length,
            language: languageSelect.value,
            timestamp: new Date().toISOString(),
            date: new Date().toLocaleString('fr-FR')
        };
        
        history.unshift(note);
        
        if (history.length > 50) {
            history = history.slice(0, 50);
        }
        
        localStorage.setItem('voiceHistory', JSON.stringify(history));
        
        saveButton.textContent = '✓ Saved!';
        setTimeout(() => {
            saveButton.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg><span class="hidden sm:inline">Save</span>';
        }, 2000);
        
        loadHistory();
    });

    // Load History
    function loadHistory() {
        const history = JSON.parse(localStorage.getItem('voiceHistory') || '[]');
        
        if (history.length === 0) {
            historyContainer.innerHTML = `
                <div class="text-center py-8 text-white/60">
                    <p class="text-sm">No saved notes yet</p>
                </div>
            `;
            return;
        }
        
        historyContainer.innerHTML = history.map(note => `
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 hover:bg-white/20 transition-all duration-200 border border-white/20">
                <div class="flex items-start justify-between mb-2">
                    <p class="text-xs text-white/70">${note.date}</p>
                    <button onclick="deleteNote(${note.id})" class="text-red-300 hover:text-red-100">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
                <p class="text-sm text-white line-clamp-2 mb-2">${note.text}</p>
                <div class="flex items-center gap-2">
                    <span class="text-xs px-2 py-1 rounded-full bg-white/20 text-white">
                        ${note.wordCount} words
                    </span>
                    <button onclick="searchGoogle('${note.text.replace(/'/g, "\\'")}', event)" 
                            class="text-xs px-2 py-1 rounded-full bg-blue-500/80 text-white hover:bg-blue-600">
                        🔍
                    </button>
                    <button onclick="copyText('${note.text.replace(/'/g, "\\'")}', event)" 
                            class="text-xs px-2 py-1 rounded-full bg-green-500/80 text-white hover:bg-green-600">
                        📋
                    </button>
                </div>
            </div>
        `).join('');
    }

    // Global functions
    window.deleteNote = function(id) {
        if (confirm('Delete this note?')) {
            let history = JSON.parse(localStorage.getItem('voiceHistory') || '[]');
            history = history.filter(note => note.id !== id);
            localStorage.setItem('voiceHistory', JSON.stringify(history));
            loadHistory();
        }
    };

    window.searchGoogle = function(text, event) {
        if (event) event.stopPropagation();
        const searchQuery = encodeURIComponent(text);
        window.open(`https://www.google.com/search?q=${searchQuery}`, '_blank');
    };

    window.copyText = function(text, event) {
        if (event) event.stopPropagation();
        navigator.clipboard.writeText(text).then(() => {
            alert('✅ Copied!');
        });
    };

    window.clearAllHistory = function() {
        if (confirm('⚠️ Delete ALL notes?\n\nThis cannot be undone.')) {
            localStorage.removeItem('voiceHistory');
            loadHistory();
        }
    };

    // Load history on page load
    loadHistory();
});
</script>
{% endblock %}
