{% extends 'base.html.twig' %}

{% block title %}Edit {{ project.titre }}{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Breadcrumbs -->
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Projects', url: path('app_project_index') },
            { label: project.titre, url: path('app_project_show', { id: project.id }) },
            { label: 'Edit' }
        ]
    } %}

    <!-- Page Header -->
    {% include 'components/page_header.html.twig' with {
        title: 'Edit Project',
        subtitle: project.titre
    } %}

    <!-- Form -->
    {{ form_start(form, {'attr': {'class': 'max-w-2xl'}}) }}
        <div class="card p-6 space-y-6">
            <div>
                {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'input w-full'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'textarea w-full'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div>
                {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.dateDebut, {'attr': {'class': 'input w-full'}}) }}
                {{ form_errors(form.dateDebut) }}
            </div>

            <div>
                {{ form_label(form.dateFin, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.dateFin, {'attr': {'class': 'input w-full'}}) }}
                {{ form_errors(form.dateFin) }}
            </div>

            <div>
                {{ form_label(form.statut, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.statut, {'attr': {'class': 'select w-full'}}) }}
                {{ form_errors(form.statut) }}
            </div>
        </div>

        <div class="flex items-center justify-between mt-6">
            <button type="button" class="btn btn-danger btn-ghost" data-controller="modal" data-action="click->modal#open" data-modal-target-value="delete-modal">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
                Delete Project
            </button>
            <div class="flex items-center gap-3">
                <a href="{{ path('app_project_show', { id: project.id }) }}" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Save Changes
                </button>
            </div>
        </div>
    {{ form_end(form) }}
</div>

<!-- Delete Confirmation Modal -->
{% include 'components/modal.html.twig' with {
    id: 'delete-modal',
    title: 'Delete Project',
    content: '
        <p class="text-light-muted dark:text-dark-muted mb-6">
            Are you sure you want to delete <strong>' ~ project.titre ~ '</strong>? 
            This will also delete all associated tasks. This action cannot be undone.
        </p>
        <form method="POST" action="' ~ path('app_project_delete', { id: project.id }) ~ '">
            <div class="flex justify-end gap-3">
                <button type="button" class="btn btn-ghost" data-action="click->modal#close">Cancel</button>
                <button type="submit" class="btn btn-danger">Delete Project</button>
            </div>
        </form>
    '
} %}
{% endblock %}
