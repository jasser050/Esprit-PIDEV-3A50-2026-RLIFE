{% extends 'base.html.twig' %}

{% block title %}Modifier {{ project.titre }}{% endblock %}

{% block body %}
<div class="px-4 sm:px-6 lg:px-8 py-6 max-w-3xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex text-sm mb-8" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-slate-600 dark:text-slate-400">
            <li><a href="{{ path('app_project_index') }}" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Projets</a></li>
            <li><i class="fas fa-chevron-right text-xs"></i></li>
            <li><a href="{{ path('app_project_show', {'id': project.id}) }}" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">{{ project.titre }}</a></li>
            <li><i class="fas fa-chevron-right text-xs"></i></li>
            <li class="text-slate-900 dark:text-white">Modifier</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="mb-8">
        <h1 class="page-title"><i class="fas fa-edit me-2"></i>Modifier le Projet</h1>
        <p class="page-subtitle">Mettez à jour les informations du projet</p>
    </div>

    <!-- Form Card -->
    <div class="card mb-6">
        <div class="p-6 md:p-8">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-6'}}) }}
            
            <div>
                {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'input w-full'}}) }}
                {% if form.titre.vars.errors|length %}
                    <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                        {{ form_errors(form.titre) }}
                    </div>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'textarea w-full', 'rows': '5'}}) }}
                {% if form.description.vars.errors|length %}
                    <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                        {{ form_errors(form.description) }}
                    </div>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.dateDebut, {'attr': {'class': 'input w-full', 'type': 'date'}}) }}
                    {% if form.dateDebut.vars.errors|length %}
                        <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                            {{ form_errors(form.dateDebut) }}
                        </div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(form.dateFin, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                    {{ form_widget(form.dateFin, {'attr': {'class': 'input w-full', 'type': 'date'}}) }}
                    {% if form.dateFin.vars.errors|length %}
                        <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                            {{ form_errors(form.dateFin) }}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div>
                {{ form_label(form.statut, null, {'label_attr': {'class': 'block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2'}}) }}
                {{ form_widget(form.statut, {'attr': {'class': 'select w-full'}}) }}
                {% if form.statut.vars.errors|length %}
                    <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                        {{ form_errors(form.statut) }}
                    </div>
                {% endif %}
            </div>

            {% if project.updatedAt %}
                <div class="alert-info p-4 rounded-lg">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-info-circle text-info-600 dark:text-info-400 mt-0.5 flex-shrink-0"></i>
                        <span class="text-sm text-info-800 dark:text-info-200">Dernière modification : <strong>{{ project.updatedAt|date('d/m/Y à H:i') }}</strong></span>
                    </div>
                </div>
            {% endif %}

            <div class="border-t border-slate-200 dark:border-slate-700 pt-6 flex flex-col-reverse sm:flex-row sm:justify-between sm:items-center gap-4">
                <div class="flex flex-col-reverse sm:flex-row gap-3 sm:gap-2">
                    <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-outline text-center">
                        <i class="fas fa-arrow-left"></i>Annuler
                    </a>
                    <a href="{{ path('app_project_index') }}" class="btn btn-outline text-center">
                        <i class="fas fa-list"></i>Retour à la liste
                    </a>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i>Enregistrer les Modifications
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

    <!-- Danger Zone -->
    <div class="card border-2 border-danger-200 dark:border-danger-800 bg-danger-50 dark:bg-danger-900/10">
        <div class="p-6">
            <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                    <h3 class="font-semibold text-danger-800 dark:text-danger-200 mb-1">Supprimer ce projet</h3>
                    <p class="text-sm text-danger-700 dark:text-danger-300">Une fois supprimé, le projet ne pourra pas être récupéré.</p>
                </div>
                <button type="button" class="btn bg-danger-600 hover:bg-danger-700 text-white flex-shrink-0" data-modal="deleteModal">
                    <i class="fas fa-trash-alt"></i>Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal hidden fixed inset-0 z-50 flex items-center justify-center" id="deleteModal">
    <div class="modal-backdrop" data-dismiss="modal"></div>
    <div class="modal-content max-w-sm mx-4">
        <div class="p-6">
            <div class="flex items-center justify-center w-12 h-12 mx-auto bg-danger-100 dark:bg-danger-900/30 rounded-full mb-4">
                <i class="fas fa-exclamation-triangle text-danger-600 dark:text-danger-400"></i>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white text-center mb-2">Confirmer la suppression</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 text-center mb-2">
                Êtes-vous sûr de vouloir supprimer <strong>{{ project.titre }}</strong> ?
            </p>
            <p class="text-sm text-danger-600 dark:text-danger-400 text-center mb-6">
                <i class="fas fa-exclamation-triangle me-1"></i>Cette action est irréversible.
            </p>
            <div class="flex flex-col-reverse sm:flex-row gap-3">
                <button type="button" class="btn btn-outline" data-dismiss="modal">
                    <i class="fas fa-times"></i>Annuler
                </button>
                <form method="POST" action="{{ path('app_project_delete', {'id': project.id}) }}" style="flex: 1;">
                    <button type="submit" class="btn w-full bg-danger-600 hover:bg-danger-700 text-white">
                        <i class="fas fa-check"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const modalTriggers = document.querySelectorAll('[data-modal]');
    const modals = document.querySelectorAll('.modal');
    const modalBackdrops = document.querySelectorAll('.modal-backdrop');
    const modalDismisses = document.querySelectorAll('[data-dismiss="modal"]');

    // Open modal
    modalTriggers.forEach(trigger => {
        trigger.addEventListener('click', function() {
            const modalId = this.getAttribute('data-modal');
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('hidden');
            }
        });
    });

    // Close modal
    const closeModal = (modal) => {
        modal.classList.add('hidden');
    };

    // Backdrop click
    modalBackdrops.forEach(backdrop => {
        backdrop.addEventListener('click', function() {
            const modal = this.closest('.modal');
            if (modal) {
                closeModal(modal);
            }
        });
    });

    // Dismiss buttons
    modalDismisses.forEach(btn => {
        btn.addEventListener('click', function() {
            const modal = this.closest('.modal');
            if (modal) {
                closeModal(modal);
            }
        });
    });

    // ESC key to close
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            modals.forEach(modal => {
                if (!modal.classList.contains('hidden')) {
                    closeModal(modal);
                }
            });
        }
    });
});
</script>
{% endblock %}
