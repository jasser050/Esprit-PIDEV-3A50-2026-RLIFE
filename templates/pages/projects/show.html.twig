{# templates/project/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ project.titre }}{% endblock %}

{% block body %}
<div class="space-y-6 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-secondary-600 dark:text-secondary-400">
            <li><a href="{{ path('app_project_index') }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">Projets</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li class="text-secondary-900 dark:text-white">{{ project.titre }}</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <h1 class="text-2xl font-bold">{{ project.titre }}</h1>
                <span class="badge badge-{{ project.statut == 'En cours' ? 'primary' : (project.statut == 'Terminé' ? 'success' : (project.statut == 'En attente' ? 'warning' : 'danger')) }}">
                    {{ project.statut }}
                </span>
            </div>
            <p class="text-secondary-500 dark:text-secondary-400">{{ project.description|nl2br }}</p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <a href="{{ path('app_collaboration_share_project', {'id': project.id}) }}" class="btn btn-secondary">
                <i data-lucide="share-2" class="w-5 h-5"></i>
                Partager
            </a>
            <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-secondary">
                <i data-lucide="edit-2" class="w-5 h-5"></i>
                Modifier
            </a>
            <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                <i data-lucide="trash-2" class="w-5 h-5"></i>
                Supprimer
            </button>
        </div>
    </div>

    <!-- Stats rapides -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-primary-600">{{ project.assignments|length }}</div>
            <div class="text-sm text-secondary-500">Tâches totales</div>
        </div>
        <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-success-600">
                {{ project.assignments|filter(a => a.statut == 'Terminé')|length }}
            </div>
            <div class="text-sm text-secondary-500">Terminées</div>
        </div>
        <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-warning-600">
                {{ project.assignments|filter(a => a.statut == 'En attente')|length }}
            </div>
            <div class="text-sm text-secondary-500">En attente</div>
        </div>
        <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-primary-600">
                {{ project.assignments|filter(a => a.statut == 'En cours')|length }}
            </div>
            <div class="text-sm text-secondary-500">En cours</div>
        </div>
    </div>

    <!-- Tâches associées -->
    <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold">Tâches Associées</h2>
            <a href="{{ path('app_assignments_new') }}?project_id={{ project.id }}" class="btn btn-primary text-sm">
                <i data-lucide="plus" class="w-4 h-4"></i>
                Nouvelle Tâche
            </a>
        </div>
        {% if project.assignments|length > 0 %}
            <div class="space-y-4">
                {% for assignment in project.assignments %}
                    <div class="p-4 rounded-lg border border-slate-200 dark:border-slate-700 hover:border-primary-500 transition-colors">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <h6 class="font-semibold text-secondary-900 dark:text-white mb-1">{{ assignment.titre }}</h6>
                                <p class="text-sm text-secondary-600 dark:text-secondary-400 mb-2">{{ assignment.description }}</p>
                                <div class="text-xs text-secondary-500 dark:text-secondary-400 flex gap-4">
                                    <span><i data-lucide="calendar" class="w-3 h-3 mr-1"></i>{{ assignment.dateFin|date('d/m/Y') }}</span>
                                    <span class="badge badge-{{ assignment.statut == 'Terminé' ? 'success' : (assignment.statut == 'En cours' ? 'primary' : 'warning') }}">
                                        {{ assignment.statut }}
                                    </span>
                                </div>
                            </div>
                            <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="btn btn-ghost btn-icon-sm">
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state p-8 text-center">
                <i data-lucide="clipboard-x" class="w-12 h-12 empty-state-icon mb-4"></i>
                <p class="empty-state-title">Aucune tâche</p>
                <p class="empty-state-description">Ajoutez votre première tâche pour ce projet</p>
            </div>
        {% endif %}
    </div>

    <!-- Modal suppression -->
    <div class="modal hidden fixed inset-0 z-50 flex items-center justify-center" id="delete-modal">
        <div class="modal-backdrop" onclick="closeModal()"></div>
        <div class="card max-w-sm mx-4 relative z-10">
            <div class="p-6">
                <div class="flex items-center justify-center w-12 h-12 mx-auto bg-danger-100 dark:bg-danger-900/30 rounded-full mb-4">
                    <i data-lucide="alert-triangle" class="w-6 h-6 text-danger-600 dark:text-danger-400"></i>
                </div>
                <h3 class="text-lg font-semibold text-secondary-900 dark:text-white text-center mb-2">Supprimer le projet ?</h3>
                <p class="text-sm text-light-muted dark:text-dark-muted text-center mb-6">
                    Êtes-vous sûr de vouloir supprimer <strong>{{ project.titre }}</strong> ? Cette action ne peut pas être annulée.
                </p>
                <div class="flex flex-col-reverse sm:flex-row gap-3">
                    <button type="button" class="btn btn-secondary" onclick="closeModal()">Annuler</button>
                    <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" style="flex: 1;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                        <button type="submit" class="btn btn-danger w-full">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
  
  function confirmDelete() {
    document.getElementById('delete-modal').classList.remove('hidden');
  }
  
  function closeModal() {
    document.getElementById('delete-modal').classList.add('hidden');
  }
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
{% endblock %}