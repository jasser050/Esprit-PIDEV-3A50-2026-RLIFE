{# templates/pages/projects/show.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}{{ project.titre }}{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-sm">
        <ol class="flex items-center gap-2">
            <li><a href="{{ path('app_project_index') }}" class="text-primary hover:underline">Projets</a></li>
            <li class="text-light-muted dark:text-dark-muted">/</li>
            <li class="text-light-muted dark:text-dark-muted">{{ project.titre }}</li>
        </ol>
    </nav>

    <!-- Project Header -->
    <div class="card p-6">
        <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
                <h1 class="text-3xl font-bold mb-2">{{ project.titre }}</h1>
                <span class="badge 
                    {% if project.statut == 'En cours' %}badge-primary
                    {% elseif project.statut == 'Terminé' %}badge-success
                    {% elseif project.statut == 'En attente' %}badge-warning
                    {% else %}badge-danger{% endif %}">
                    {{ project.statut }}
                </span>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-ghost">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    Modifier
                </a>
                <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce projet ?');" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                    <button type="submit" class="btn btn-ghost text-danger">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Supprimer
                    </button>
                </form>
            </div>
        </div>

        <!-- Description -->
        <div class="mb-6">
            <h2 class="text-sm font-medium mb-2">Description</h2>
            <p class="text-light-muted dark:text-dark-muted">{{ project.description }}</p>
        </div>

        <!-- Dates -->
        <div class="grid grid-cols-2 gap-4 mb-8">
            <div>
                <h3 class="text-sm font-medium mb-1">Date de Début</h3>
                <div class="flex items-center gap-2 text-light-muted dark:text-dark-muted">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    {{ project.dateDebut|date('d/m/Y') }}
                </div>
            </div>
            <div>
                <h3 class="text-sm font-medium mb-1">Date de Fin</h3>
                <div class="flex items-center gap-2 text-light-muted dark:text-dark-muted">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    {{ project.dateFin|date('d/m/Y') }}
                </div>
            </div>
        </div>
    </div>

    <!-- Assignments Section -->
    <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold">Tâches (Assignments)</h2>
            <a href="{{ path('app_assignments_new') }}?project_id={{ project.id }}" class="btn btn-primary btn-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Nouvelle tâche
            </a>
        </div>

        {% if assignments|length > 0 %}
            <div class="space-y-4">
                {% for assignment in assignments %}
                    <div class="border border-light-border dark:border-dark-border rounded-lg p-4 hover:bg-light-hover dark:hover:bg-dark-hover transition-colors">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-1">
                                    <h3 class="font-semibold text-lg">{{ assignment.titre }}</h3>
                                    <span class="badge 
                                        {% if assignment.statut == 'Terminé' %}badge-success
                                        {% elseif assignment.statut == 'En cours' %}badge-primary
                                        {% elseif assignment.statut == 'À faire' %}badge-warning
                                        {% else %}badge-danger{% endif %}">
                                        {{ assignment.statut }}
                                    </span>
                                    <span class="badge 
                                        {% if assignment.priorite == 'Haute' %}badge-danger
                                        {% elseif assignment.priorite == 'Moyenne' %}badge-warning
                                        {% else %}badge-success{% endif %}">
                                        {{ assignment.priorite }}
                                    </span>
                                </div>

                                <p class="text-light-muted dark:text-dark-muted text-sm mb-3">
                                    {{ assignment.description|slice(0, 120) }}{% if assignment.description|length > 120 %}...{% endif %}
                                </p>

                                <div class="flex flex-wrap gap-4 text-sm text-light-muted dark:text-dark-muted">
                                    <div class="flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        <span>{{ assignment.dateDebut|date('d/m/Y') }} → {{ assignment.dateFin|date('d/m/Y') }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <a href="{{ path('app_assignments_show', {'id': assignment.id}) }}" class="btn btn-ghost btn-sm">
                                    Voir
                                </a>
                                <a href="{{ path('app_assignments_edit', {'id': assignment.id}) }}" class="btn btn-ghost btn-sm">
                                    Modifier
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-12 text-light-muted dark:text-dark-muted">
                <svg class="w-12 h-12 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <p class="text-lg mb-2">Aucune tâche pour ce projet</p>
                <a href="{{ path('app_assignments_new') }}?project_id={{ project.id }}" class="text-primary hover:underline">
                    Créer une nouvelle tâche →
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}