{# templates/project/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}New Project{% endblock %}

{% block body %}
<div class="space-y-6 max-w-3xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-secondary-600 dark:text-secondary-400">
            <li><a href="{{ path('app_project_index') }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">Projects</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li class="text-secondary-900 dark:text-white">New Project</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Create New Project</h1>
        <p class="text-secondary-500 dark:text-secondary-400 mt-1">Organize your work by creating a new project</p>
    </div>

    <!-- Form Card -->
    <div class="card p-6 md:p-8">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-6'}}) }}
        
        <div>
            {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'input w-full', 'placeholder': 'e.g., Website Development'}}) }}
            {% if form.titre.vars.errors|length > 0 %}
                <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                    {% for error in form.titre.vars.errors %}
                        <p>{{ error.message }}</p>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div>
            {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'textarea w-full', 'rows': '5', 'placeholder': 'Describe the objectives and context...'}}) }}
            {% if form.description.vars.errors|length > 0 %}
                <div class="mt-2 text-sm text-danger-600 dark:text-danger-400">
                    {% for error in form.description.vars.errors %}
                        <p>{{ error.message }}</p>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.dateDebut, {'attr': {'class': 'input w-full'}}) }}
            </div>
            <div>
                {{ form_label(form.dateFin, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
                {{ form_widget(form.dateFin, {'attr': {'class': 'input w-full'}}) }}
            </div>
        </div>

        <div>
            {{ form_label(form.statut, null, {'label_attr': {'class': 'block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2'}}) }}
            {{ form_widget(form.statut, {'attr': {'class': 'input w-full'}}) }}
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-slate-200 dark:border-slate-700">
            <a href="{{ path('app_project_index') }}" class="btn btn-secondary inline-flex items-center justify-center gap-2 w-full sm:w-auto order-2 sm:order-1">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
                Back to List
            </a>
            <button type="submit" class="btn btn-primary inline-flex items-center justify-center gap-2 w-full sm:w-auto order-1 sm:order-2">
                <i data-lucide="save" class="w-5 h-5"></i>
                Create Project
            </button>
        </div>
        
        {{ form_end(form) }}
    </div>

    <!-- Help Card -->
    <div class="card bg-info-50 dark:bg-info-900/20 p-6 border border-info-200 dark:border-info-800">
        <h3 class="font-semibold text-info-800 dark:text-info-200 mb-3">
            <i data-lucide="info" class="w-5 h-5 inline mr-2"></i>
            Tips for Creating a Project
        </h3>
        <ul class="space-y-2 text-sm text-info-700 dark:text-info-300">
            <li>• Provide a detailed description of the objectives</li>
            <li>• Make sure the end date is after the start date</li>
            <li>• Update the status as you progress</li>
        </ul>
    </div>
</div>
{% endblock %}
