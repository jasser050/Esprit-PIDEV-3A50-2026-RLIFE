{% extends 'base.html.twig' %}

{% block title %}Nouveau Projet{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-sm">
        <ol class="flex items-center gap-2">
            <li><a href="{{ path('app_project_index') }}" class="text-primary hover:underline">Projets</a></li>
            <li class="text-light-muted dark:text-dark-muted">/</li>
            <li class="text-light-muted dark:text-dark-muted">Nouveau Projet</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-3xl font-bold mb-2">Nouveau Projet</h1>
        <p class="text-light-muted dark:text-dark-muted">Créez un nouveau projet de groupe</p>
    </div>

    <!-- Form -->
    {{ form_start(form, {'attr': {'class': 'max-w-2xl'}}) }}
        <div class="card p-6 space-y-6">
            <!-- Titre -->
            <div>
                {{ form_label(form.titre, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'input w-full'}}) }}
                {{ form_errors(form.titre) }}
            </div>

            <!-- Description -->
            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'textarea w-full'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <!-- Date de Début -->
            <div>
                {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.dateDebut, {'attr': {'class': 'input w-full'}}) }}
                {{ form_errors(form.dateDebut) }}
            </div>

            <!-- Date de Fin -->
            <div>
                {{ form_label(form.dateFin, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.dateFin, {'attr': {'class': 'input w-full'}}) }}
                {{ form_errors(form.dateFin) }}
            </div>

            <!-- Statut -->
            <div>
                {{ form_label(form.statut, null, {'label_attr': {'class': 'block text-sm font-medium mb-2'}}) }}
                {{ form_widget(form.statut, {'attr': {'class': 'select w-full'}}) }}
                {{ form_errors(form.statut) }}
            </div>
        </div>

        <!-- Form Actions -->
        <div class="flex items-center justify-end gap-3 mt-6">
            <a href="{{ path('app_project_index') }}" class="btn btn-ghost">Annuler</a>
            <button type="submit" class="btn btn-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Créer le Projet
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}