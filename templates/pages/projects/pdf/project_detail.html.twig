<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ project.titre }}</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            color: #333;
            line-height: 1.6;
        }
        .header {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
            padding: 25px;
            margin: -20px -20px 30px -20px;
        }
        .header h1 {
            margin: 0 0 10px 0;
            font-size: 26px;
        }
        .header .meta {
            font-size: 11px;
            opacity: 0.9;
        }
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: bold;
            margin-left: 10px;
        }
        .badge-primary { background-color: #3b82f6; color: white; }
        .badge-success { background-color: #10b981; color: white; }
        .badge-warning { background-color: #f59e0b; color: white; }
        .badge-danger { background-color: #ef4444; color: white; }
        .badge-secondary { background-color: #6b7280; color: white; }
        
        .stats-grid {
            display: table;
            width: 100%;
            margin-bottom: 25px;
            border-collapse: collapse;
        }
        .stat-box {
            display: table-cell;
            width: 25%;
            text-align: center;
            padding: 20px;
            background: #f8f9fa;
            border: 1px solid #e5e7eb;
        }
        .stat-box .icon {
            font-size: 30px;
            margin-bottom: 10px;
        }
        .stat-box .value {
            font-size: 22px;
            font-weight: bold;
            color: #3b82f6;
            display: block;
            margin-bottom: 5px;
        }
        .stat-box .label {
            color: #666;
            font-size: 10px;
        }
        
        .section {
            margin-bottom: 25px;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 5px;
            padding: 20px;
        }
        .section-title {
            font-size: 16px;
            font-weight: bold;
            color: #3b82f6;
            margin: 0 0 15px 0;
            padding-bottom: 10px;
            border-bottom: 2px solid #3b82f6;
        }
        .info-row {
            margin-bottom: 15px;
            padding: 10px 0;
            border-bottom: 1px solid #f3f4f6;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            font-weight: bold;
            color: #666;
            font-size: 11px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        .info-value {
            font-size: 13px;
            color: #333;
        }
        
        .progress-bar {
            background: #e5e7eb;
            height: 25px;
            border-radius: 5px;
            overflow: hidden;
            position: relative;
        }
        .progress-fill {
            background: #3b82f6;
            height: 100%;
            line-height: 25px;
            color: white;
            text-align: center;
            font-weight: bold;
            font-size: 11px;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th {
            background-color: #f3f4f6;
            padding: 10px;
            text-align: left;
            font-size: 11px;
            color: #666;
            border-bottom: 2px solid #e5e7eb;
        }
        td {
            padding: 10px;
            border-bottom: 1px solid #f3f4f6;
            font-size: 11px;
        }
        
        .footer {
            margin-top: 40px;
            text-align: center;
            font-size: 10px;
            color: #666;
            border-top: 2px solid #e5e7eb;
            padding-top: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ project.titre }}</h1>
        <div class="meta">
            <strong>Créé le :</strong> {{ project.createdAt|date('d/m/Y à H:i') }}
            {% if project.updatedAt %}
                | <strong>Modifié le :</strong> {{ project.updatedAt|date('d/m/Y à H:i') }}
            {% endif %}
            
            {% if project.statut == 'En cours' %}
                <span class="badge badge-primary">{{ project.statut }}</span>
            {% elseif project.statut == 'Terminé' %}
                <span class="badge badge-success">{{ project.statut }}</span>
            {% elseif project.statut == 'En attente' %}
                <span class="badge badge-warning">{{ project.statut }}</span>
            {% elseif project.statut == 'Annulé' %}
                <span class="badge badge-danger">{{ project.statut }}</span>
            {% else %}
                <span class="badge badge-secondary">{{ project.statut }}</span>
            {% endif %}
        </div>
    </div>

    <!-- Statistiques -->
    {% set now = date() %}
    {% set totalDays = ((project.dateFin|date('U') - project.dateDebut|date('U')) / 86400)|round(0, 'floor') %}
    {% set elapsedDays = ((now|date('U') - project.dateDebut|date('U')) / 86400)|round(0, 'floor') %}
    {% set remainingDays = ((project.dateFin|date('U') - now|date('U')) / 86400)|round(0, 'floor') %}
    {% set progress = totalDays > 0 ? ((elapsedDays / totalDays * 100) > 100 ? 100 : (elapsedDays / totalDays * 100))|round(0) : 0 %}
    
    <div class="stats-grid">
        <div class="stat-box">
            <div class="icon">📅</div>
            <span class="value">{{ totalDays }}</span>
            <span class="label">Durée Totale (jours)</span>
        </div>
        <div class="stat-box">
            <div class="icon">⏳</div>
            <span class="value">{{ elapsedDays }}</span>
            <span class="label">Temps Écoulé (jours)</span>
        </div>
        <div class="stat-box">
            <div class="icon">🕐</div>
            <span class="value">{{ remainingDays >= 0 ? remainingDays : 0 }}</span>
            <span class="label">Jours Restants</span>
        </div>
        <div class="stat-box">
            <div class="icon">✅</div>
            <span class="value">{{ assignments|length }}</span>
            <span class="label">Assignments</span>
        </div>
    </div>

    <!-- Progression -->
    <div class="section">
        <h2 class="section-title">📊 Progression Temporelle</h2>
        <div class="progress-bar">
            <div class="progress-fill" style="width: {{ progress }}%;">
                {{ progress }}%
            </div>
        </div>
    </div>

    <!-- Informations -->
    <div class="section">
        <h2 class="section-title">ℹ️ Informations du Projet</h2>
        
        <div class="info-row">
            <div class="info-label">Date de Début</div>
            <div class="info-value">{{ project.dateDebut|date('d/m/Y') }}</div>
        </div>
        
        <div class="info-row">
            <div class="info-label">Date de Fin</div>
            <div class="info-value">{{ project.dateFin|date('d/m/Y') }}</div>
        </div>
        
        <div class="info-row">
            <div class="info-label">Description</div>
            <div class="info-value">{{ project.description|nl2br }}</div>
        </div>
    </div>

    <!-- Assignments -->
    {% if assignments|length > 0 %}
        <div class="section">
            <h2 class="section-title">📋 Assignments ({{ assignments|length }})</h2>
            
            <table>
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 35%;">Titre</th>
                        <th style="width: 35%;">Description</th>
                        <th style="width: 15%;">Échéance</th>
                        <th style="width: 10%;">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for assignment in assignments %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td><strong>{{ assignment.titre }}</strong></td>
                            <td>{{ assignment.description|length > 60 ? assignment.description|slice(0, 60) ~ '...' : assignment.description }}</td>
                            <td>{{ assignment.dateEcheance|date('d/m/Y') }}</td>
                            <td>
                                {% if assignment.statut == 'En cours' %}
                                    <span class="badge badge-primary">{{ assignment.statut }}</span>
                                {% elseif assignment.statut == 'Terminé' %}
                                    <span class="badge badge-success">{{ assignment.statut }}</span>
                                {% else %}
                                    <span class="badge badge-warning">{{ assignment.statut }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <div class="footer">
        Document généré le {{ generatedAt|date('d/m/Y à H:i') }}<br>
        © {{ 'now'|date('Y') }} - Système de Gestion de Projets
    </div>
</body>
</html>
