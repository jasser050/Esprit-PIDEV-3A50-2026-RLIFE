{% extends 'base.html.twig' %}

{% block title %}Projects Shared With Me{% endblock %}

{% block body %}
<div class="space-y-6 max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">Projects Shared With Me</h1>
            <p class="text-light-muted dark:text-dark-muted">Projects that have been shared with you by other users</p>
        </div>
        <a href="{{ path('app_project_index') }}" class="btn btn-ghost">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
            My Projects
        </a>
    </div>

    {% if shares|length > 0 %}
        <div class="grid gap-4">
            {% for share in shares %}
                {% set project = share.project %}
                {% if project is not null %}
                <div class="card p-6 hover:shadow-lg transition-shadow">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-2">
                                <h3 class="font-semibold text-lg">{{ project.titre }}</h3>
                                <span class="badge badge-{{ project.statut == 'En cours' ? 'primary' : (project.statut == 'Terminé' ? 'success' : (project.statut == 'En attente' ? 'warning' : 'danger')) }}">
                                    {{ project.statut }}
                                </span>
                                <span class="badge badge-{{ share.role == 'editor' ? 'warning' : 'info' }}">
                                    {{ share.role|capitalize }}
                                </span>
                            </div>
                            <p class="text-light-muted dark:text-dark-muted mb-3">{{ project.description }}</p>
                            
                            <div class="flex flex-wrap items-center gap-4 text-sm text-secondary-600 dark:text-secondary-400">
                                <span class="flex items-center gap-1">
                                    <i data-lucide="calendar" class="w-4 h-4"></i>
                                    {{ project.dateDebut|date('d/m/Y') }} → {{ project.dateFin|date('d/m/Y') }}
                                </span>
                                <span class="flex items-center gap-1">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                    Owner: {{ project.user.fullName }}
                                </span>
                                <span class="flex items-center gap-1">
                                    <i data-lucide="share-2" class="w-4 h-4"></i>
                                    Shared by: {{ share.sharedByUser.fullName }}
                                </span>
                            </div>
                        </div>
                        
                        <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-secondary btn-sm">
                            View
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        </div>
    {% else %}
        <div class="card p-12 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-light-background dark:bg-dark-background flex items-center justify-center">
                <i data-lucide="folder-x" class="w-8 h-8 text-secondary-400"></i>
            </div>
            <h3 class="text-lg font-semibold mb-2">No shared projects</h3>
            <p class="text-light-muted dark:text-dark-muted mb-4">No one has shared any projects with you yet.</p>
            <a href="{{ path('app_project_index') }}" class="btn btn-primary">
                View My Projects
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
</script>
{% endblock %}
