{# templates/project/delete.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Delete Project{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm" aria-label="breadcrumb">
        <ol class="flex items-center gap-2 text-secondary-600 dark:text-secondary-400">
            <li><a href="{{ path('app_project_index') }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">Projects</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li><a href="{{ path('app_project_show', {'id': project.id}) }}" class="hover:text-secondary-900 dark:hover:text-secondary-200 transition-colors">{{ project.titre }}</a></li>
            <li><i data-lucide="chevron-right" class="w-3 h-3"></i></li>
            <li class="text-secondary-900 dark:text-white">Delete</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 dark:text-white mb-2">Delete Project</h1>
        <p class="text-secondary-500 dark:text-secondary-400">Are you sure you want to delete this project? This action is irreversible.</p>
    </div>

    <!-- Project Details Card -->
    <div class="card p-6">
        <div class="flex items-start justify-between mb-4">
            <h3 class="text-lg font-semibold">{{ project.titre }}</h3>
            <span class="badge badge-{{ project.statut == 'En cours' ? 'primary' : (project.statut == 'Terminé' ? 'success' : (project.statut == 'En attente' ? 'warning' : 'danger')) }}">
                {% if project.statut == 'En cours' %}In Progress
                {% elseif project.statut == 'Terminé' %}Completed
                {% elseif project.statut == 'En attente' %}Pending
                {% else %}{{ project.statut }}{% endif %}
            </span>
        </div>
        <p class="text-sm text-secondary-600 dark:text-secondary-400 mb-4">{{ project.description }}</p>
        <div class="text-xs text-secondary-500 dark:text-secondary-400 flex items-center gap-2">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            {{ project.dateDebut|date('d/m/Y') }} - {{ project.dateFin|date('d/m/Y') }}
            {% if project.assignments|length > 0 %}
                • {{ project.assignments|length }} task(s)
            {% endif %}
        </div>
    </div>

    <!-- Warning Card -->
    <div class="card bg-danger-100 dark:bg-danger-900/30 p-6 text-danger-700 dark:text-danger-300">
        <div class="flex items-start gap-3 mb-4">
            <i data-lucide="alert-triangle" class="w-6 h-6 flex-shrink-0"></i>
            <div>
                <h4 class="font-semibold text-lg mb-2">Irreversible Action</h4>
                <p class="mb-2">This deletion will result in:</p>
                <ul class="list-disc list-inside space-y-1 text-sm">
                    <li>Permanent deletion of the project</li>
                    {% if project.assignments|length > 0 %}
                        <li>Deletion of {{ project.assignments|length }} associated task(s)</li>
                    {% endif %}
                    <li>Loss of all related data</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
        <div class="flex flex-col-reverse sm:flex-row justify-between gap-4">
            <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-secondary w-full sm:w-auto">
                <i data-lucide="x" class="w-5 h-5"></i>
                Cancel
            </a>
            <button type="submit" class="btn btn-danger w-full sm:w-auto">
                <i data-lucide="trash-2" class="w-5 h-5"></i>
                Delete Permanently
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://unpkg.com/lucide@latest"></script>
<script>
  lucide.createIcons();
</script>
{% endblock %}
