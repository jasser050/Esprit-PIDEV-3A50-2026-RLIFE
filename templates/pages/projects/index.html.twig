{% extends 'base.html.twig' %}

{% block title %}Projects{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Groups & Projects</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Collaborate and track project progress</p>
        </div>
        <a href="{{ path('app_projects_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-5 h-5"></i>
            New Project
        </a>
    </div>

    {% if projects|length > 0 %}
        {% for project in projects %}
        <div class="card overflow-hidden">
            <!-- Project Header -->
            <div class="h-1.5 bg-gradient-to-r from-{{ project.color }}-500 to-{{ project.color }}-400"></div>
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-3 mb-2">
                            <a href="{{ path('app_projects_show', { id: project.id }) }}" class="text-xl font-semibold text-secondary-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                                {{ project.name }}
                            </a>
                            <span class="badge badge-{{ project.color }} badge-pill">{{ project.course }}</span>
                        </div>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400 flex items-center gap-1.5">
                            <i data-lucide="calendar" class="w-3 h-3"></i>
                            Due: {{ project.due_date|date('M j, Y') }}
                        </p>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-3">
                            <div class="avatar-group">
                                {% for member in project.members|slice(0, 4) %}
                                <div class="avatar avatar-sm">{{ member|slice(0,1) }}</div>
                                {% endfor %}
                            </div>
                            <span class="text-sm text-secondary-500 dark:text-secondary-400">{{ project.members|length }} members</span>
                        </div>
                        <a href="{{ path('app_projects_show', { id: project.id }) }}" class="btn btn-secondary btn-sm">
                            View
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="px-5 py-4 bg-secondary-50 dark:bg-secondary-900/50 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between text-sm mb-2">
                    <span class="text-secondary-500 dark:text-secondary-400 flex items-center gap-1.5">
                        <i data-lucide="trending-up" class="w-3 h-3"></i>
                        Overall Progress
                    </span>
                    <span class="font-semibold text-secondary-900 dark:text-white">{{ project.progress }}%</span>
                </div>
                <div class="progress-bar h-2">
                    <div class="progress-bar-fill bg-gradient-to-r from-{{ project.color }}-500 to-{{ project.color }}-400" style="width: {{ project.progress }}%"></div>
                </div>
            </div>

            <!-- Kanban Board -->
            {% set tasks = tasks_by_project[project.id] ?? {todo: [], in_progress: [], done: []} %}
            <div class="p-5">
                <div class="kanban-board">
                    <!-- To Do -->
                    <div class="kanban-column">
                        <div class="kanban-column-header">
                            <div class="flex items-center gap-2">
                                <i data-lucide="circle" class="w-4 h-4 text-secondary-400"></i>
                                <h3 class="font-semibold text-secondary-600 dark:text-secondary-400">To Do</h3>
                            </div>
                            <span class="badge badge-secondary badge-pill">{{ tasks.todo|length }}</span>
                        </div>
                        <div class="kanban-cards">
                            {% for task in tasks.todo %}
                            <div class="kanban-card">
                                <p class="font-medium text-sm text-secondary-900 dark:text-white">{{ task.title }}</p>
                                <div class="flex items-center justify-between mt-2">
                                    <p class="text-xs text-secondary-500 dark:text-secondary-400 flex items-center gap-1">
                                        <i data-lucide="user" class="w-3 h-3"></i>
                                        {{ task.assignee }}
                                    </p>
                                    {% if task.priority is defined %}
                                    <span class="badge badge-{{ task.priority == 'high' ? 'danger' : (task.priority == 'medium' ? 'warning' : 'success') }} badge-pill text-2xs">
                                        {{ task.priority }}
                                    </span>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                            <button class="w-full p-2 rounded-lg border-2 border-dashed border-secondary-200 dark:border-secondary-700 text-secondary-400 hover:border-primary-400 hover:text-primary-500 transition-colors text-sm flex items-center justify-center gap-1.5">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                                Add task
                            </button>
                        </div>
                    </div>

                    <!-- In Progress -->
                    <div class="kanban-column">
                        <div class="kanban-column-header">
                            <div class="flex items-center gap-2">
                                <i data-lucide="loader" class="w-4 h-4 text-primary-500"></i>
                                <h3 class="font-semibold text-primary-600 dark:text-primary-400">In Progress</h3>
                            </div>
                            <span class="badge badge-primary badge-pill">{{ tasks.in_progress|length }}</span>
                        </div>
                        <div class="kanban-cards">
                            {% for task in tasks.in_progress %}
                            <div class="kanban-card border-l-4 border-l-primary-500">
                                <p class="font-medium text-sm text-secondary-900 dark:text-white">{{ task.title }}</p>
                                <div class="flex items-center justify-between mt-2">
                                    <p class="text-xs text-secondary-500 dark:text-secondary-400 flex items-center gap-1">
                                        <i data-lucide="user" class="w-3 h-3"></i>
                                        {{ task.assignee }}
                                    </p>
                                    {% if task.priority is defined %}
                                    <span class="badge badge-{{ task.priority == 'high' ? 'danger' : (task.priority == 'medium' ? 'warning' : 'success') }} badge-pill text-2xs">
                                        {{ task.priority }}
                                    </span>
                                    {% endif %}
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Done -->
                    <div class="kanban-column">
                        <div class="kanban-column-header">
                            <div class="flex items-center gap-2">
                                <i data-lucide="check-circle" class="w-4 h-4 text-success-500"></i>
                                <h3 class="font-semibold text-success-600 dark:text-success-400">Done</h3>
                            </div>
                            <span class="badge badge-success badge-pill">{{ tasks.done|length }}</span>
                        </div>
                        <div class="kanban-cards">
                            {% for task in tasks.done %}
                            <div class="kanban-card border-l-4 border-l-success-500 opacity-75">
                                <p class="font-medium text-sm text-secondary-500 dark:text-secondary-400 line-through">{{ task.title }}</p>
                                <div class="flex items-center justify-between mt-2">
                                    <p class="text-xs text-secondary-400 dark:text-secondary-500 flex items-center gap-1">
                                        <i data-lucide="user" class="w-3 h-3"></i>
                                        {{ task.assignee }}
                                    </p>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
    <!-- Empty State -->
    <div class="card">
        <div class="empty-state py-16">
            <i data-lucide="users" class="w-16 h-16 empty-state-icon"></i>
            <p class="empty-state-title">No projects yet</p>
            <p class="empty-state-description">Create a project to start collaborating with your team</p>
            <a href="{{ path('app_projects_new') }}" class="btn btn-primary mt-4">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Create First Project
            </a>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
