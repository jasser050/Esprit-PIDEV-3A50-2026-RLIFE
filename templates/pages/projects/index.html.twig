{% extends 'base.html.twig' %}

{% block title %}Mes Projets{% endblock %}

{% block body %}
<div class="px-4 sm:px-6 lg:px-8 py-6 max-w-7xl mx-auto">
    <!-- En-tête avec titre et bouton -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
        <div>
            <h1 class="page-title"><i class="fas fa-project-diagram me-2"></i>Mes Projets</h1>
            <p class="page-subtitle">Gérez et suivez tous vos projets</p>
        </div>
        <div class="flex gap-3 mt-4 sm:mt-0">
            <a href="{{ path('app_project_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i>Nouveau Projet
            </a>
            <a href="{{ path('app_project_export_pdf', {statut: statut, search: search}) }}" class="btn btn-outline">
                <i class="fas fa-file-pdf"></i>Exporter
            </a>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="card stat-card">
            <div class="stat-card-icon bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                <i class="fas fa-folder"></i>
            </div>
            <div class="stat-card-value">{{ stats.total }}</div>
            <div class="stat-card-label">Total Projets</div>
        </div>
        <div class="card stat-card">
            <div class="stat-card-icon bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
                <i class="fas fa-play-circle"></i>
            </div>
            <div class="stat-card-value text-primary-600 dark:text-primary-400">{{ stats.enCours }}</div>
            <div class="stat-card-label">En Cours</div>
        </div>
        <div class="card stat-card">
            <div class="stat-card-icon bg-success-100 dark:bg-success-900/30 text-success-600 dark:text-success-400">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-card-value text-success-600 dark:text-success-400">{{ stats.termines }}</div>
            <div class="stat-card-label">Terminés</div>
        </div>
        <div class="card stat-card">
            <div class="stat-card-icon bg-danger-100 dark:bg-danger-900/30 text-danger-600 dark:text-danger-400">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-card-value text-danger-600 dark:text-danger-400">{{ stats.enRetard }}</div>
            <div class="stat-card-label">En Retard</div>
        </div>
    </div>

    <!-- Graphiques -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="card overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800">
                <h5 class="font-semibold text-slate-900 dark:text-white"><i class="fas fa-chart-pie me-2"></i>Répartition par Statut</h5>
            </div>
            <div class="p-6">
                <div class="relative h-64">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>
        <div class="card overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800">
                <h5 class="font-semibold text-slate-900 dark:text-white"><i class="fas fa-chart-line me-2"></i>Progression (6 derniers mois)</h5>
            </div>
            <div class="p-6">
                <div class="relative h-64">
                    <canvas id="progressionChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres et recherche -->
    <div class="card mb-8">
        <div class="p-6">
            <form method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label for="search" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Rechercher</label>
                    <div class="relative">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" 
                               class="input pl-10" 
                               id="search" 
                               name="search" 
                               value="{{ search }}" 
                               placeholder="Titre ou description...">
                    </div>
                </div>
                <div>
                    <label for="statut" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Statut</label>
                    <select class="select" id="statut" name="statut">
                        <option value="">Tous les statuts</option>
                        <option value="En attente" {% if statut == 'En attente' %}selected{% endif %}>En attente</option>
                        <option value="En cours" {% if statut == 'En cours' %}selected{% endif %}>En cours</option>
                        <option value="En pause" {% if statut == 'En pause' %}selected{% endif %}>En pause</option>
                        <option value="Terminé" {% if statut == 'Terminé' %}selected{% endif %}>Terminé</option>
                        <option value="Annulé" {% if statut == 'Annulé' %}selected{% endif %}>Annulé</option>
                    </select>
                </div>
                <div>
                    <label for="sort" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Trier par</label>
                    <select class="select" id="sort" name="sort">
                        <option value="createdAt" {% if sort == 'createdAt' %}selected{% endif %}>Date de création</option>
                        <option value="titre" {% if sort == 'titre' %}selected{% endif %}>Titre</option>
                        <option value="dateDebut" {% if sort == 'dateDebut' %}selected{% endif %}>Date de début</option>
                        <option value="dateFin" {% if sort == 'dateFin' %}selected{% endif %}>Date de fin</option>
                        <option value="statut" {% if sort == 'statut' %}selected{% endif %}>Statut</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">Ordre</label>
                    <div class="flex gap-2">
                        <label class="flex items-center gap-2 cursor-pointer flex-1 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors"
                               for="asc">
                            <input type="radio" class="w-4 h-4" name="direction" id="asc" value="asc" {% if direction == 'asc' %}checked{% endif %}>
                            <i class="fas fa-sort-amount-up text-sm"></i>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer flex-1 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors"
                               for="desc">
                            <input type="radio" class="w-4 h-4" name="direction" id="desc" value="desc" {% if direction == 'desc' %}checked{% endif %}>
                            <i class="fas fa-sort-amount-down text-sm"></i>
                        </label>
                    </div>
                </div>
                <div class="md:col-span-4 flex gap-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-filter"></i>Filtrer
                    </button>
                    <a href="{{ path('app_project_index') }}" class="btn btn-outline">
                        <i class="fas fa-times"></i>Réinitialiser
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Liste des projets -->
    <div class="card overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <h5 class="font-semibold text-slate-900 dark:text-white">
                <i class="fas fa-list me-2"></i>Liste des projets
                <span class="badge badge-secondary">{{ projects|length }}</span>
            </h5>
        </div>
        <div>
            {% if projects|length > 0 %}
                <div class="table-container overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Statut</th>
                                <th>Date début</th>
                                <th>Date fin</th>
                                <th>Progression</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for project in projects %}
                                {% set now = date() %}
                                {% set isOverdue = project.dateFin < now and project.statut != 'Terminé' %}
                                <tr>
                                    <td>
                                        <div>
                                            <div class="font-semibold text-slate-900 dark:text-white">{{ project.titre }}</div>
                                            {% if isOverdue %}
                                                <span class="badge badge-danger inline-block mt-1">En retard</span>
                                            {% endif %}
                                            <div class="text-xs text-muted mt-1">{{ project.description|length > 60 ? project.description|slice(0, 60) ~ '...' : project.description }}</div>
                                        </div>
                                    </td>
                                    <td>
                                        {% if project.statut == 'En cours' %}
                                            <span class="badge badge-primary">{{ project.statut }}</span>
                                        {% elseif project.statut == 'Terminé' %}
                                            <span class="badge badge-success">{{ project.statut }}</span>
                                        {% elseif project.statut == 'En attente' %}
                                            <span class="badge badge-warning">{{ project.statut }}</span>
                                        {% elseif project.statut == 'Annulé' %}
                                            <span class="badge badge-danger">{{ project.statut }}</span>
                                        {% else %}
                                            <span class="badge badge-secondary">{{ project.statut }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ project.dateDebut|date('d/m/Y') }}</td>
                                    <td>{{ project.dateFin|date('d/m/Y') }}</td>
                                    <td>
                                        {% set totalDays = ((project.dateFin|date('U') - project.dateDebut|date('U')) / 86400)|round(0, 'floor') %}
                                        {% set elapsedDays = ((now|date('U') - project.dateDebut|date('U')) / 86400)|round(0, 'floor') %}
                                        {% set progress = totalDays > 0 ? (elapsedDays / totalDays * 100)|round(0) : 0 %}
                                        {% set progress = progress > 100 ? 100 : progress %}
                                        {% set progress = progress < 0 ? 0 : progress %}
                                        
                                        <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
                                            <div class="h-full rounded-full {% if progress >= 100 %}bg-success-500{% elseif progress >= 75 %}bg-warning-500{% else %}bg-primary-500{% endif %} transition-all duration-300"
                                                 style="width: {{ progress }}%">
                                            </div>
                                        </div>
                                        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">{{ progress }}%</div>
                                    </td>
                                    <td class="text-right">
                                        <div class="flex gap-2 justify-end items-center">
                                            <a href="{{ path('app_project_show', {'id': project.id}) }}" 
                                               class="btn btn-sm btn-ghost px-2 py-1.5 hover:bg-primary-100 dark:hover:bg-primary-900/30 text-primary-600 dark:text-primary-400" 
                                               title="Voir les détails">
                                                <i class="fas fa-eye"></i>
                                                <span class="hidden sm:inline">Voir</span>
                                            </a>
                                            <a href="{{ path('app_project_edit', {'id': project.id}) }}" 
                                               class="btn btn-sm btn-ghost px-2 py-1.5 hover:bg-warning-100 dark:hover:bg-warning-900/30 text-warning-600 dark:text-warning-400" 
                                               title="Modifier ce projet">
                                                <i class="fas fa-edit"></i>
                                                <span class="hidden sm:inline">Modifier</span>
                                            </a>
                                            <button type="button" 
                                                    class="btn btn-sm btn-ghost px-2 py-1.5 hover:bg-danger-100 dark:hover:bg-danger-900/30 text-danger-600 dark:text-danger-400" 
                                                    title="Supprimer ce projet"
                                                    onclick="confirmDelete({{ project.id }}, '{{ project.titre|e('js') }}')">
                                                <i class="fas fa-trash"></i>
                                                <span class="hidden sm:inline">Supprimer</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="empty-state p-12">
                    <div class="empty-state-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <div class="empty-state-title">Aucun projet trouvé</div>
                    <div class="empty-state-description">Commencez par créer un nouveau projet</div>
                    <div class="mt-6">
                        {% if search or statut %}
                            <a href="{{ path('app_project_index') }}" class="btn btn-outline">
                                Voir tous les projets
                            </a>
                        {% else %}
                            <a href="{{ path('app_project_new') }}" class="btn btn-primary">
                                Créer votre premier projet
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Modal de confirmation de suppression -->
<div id="deleteModal" class="modal hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="modal-backdrop"></div>
    <div class="modal-content">
        <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-200 dark:border-slate-700">
            <h5 class="font-semibold text-slate-900 dark:text-white">Confirmer la suppression</h5>
            <button type="button" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300" data-dismiss="modal">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="mb-6">
            <p class="text-slate-600 dark:text-slate-300">Êtes-vous sûr de vouloir supprimer le projet <strong id="projectTitle"></strong> ?</p>
            <p class="text-danger-600 dark:text-danger-400 text-sm mt-3"><i class="fas fa-exclamation-triangle me-2"></i>Cette action est irréversible.</p>
        </div>
        <div class="modal-footer flex gap-3">
            <button type="button" class="btn btn-ghost" data-dismiss="modal">Annuler</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Supprimer</button>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Graphique de statuts (Pie Chart)
const statusCtx = document.getElementById('statusChart');
const statusChart = new Chart(statusCtx, {
    type: 'doughnut',
    data: {
        labels: {{ stats.chartData.labels|json_encode|raw }},
        datasets: [{
            data: {{ stats.chartData.data|json_encode|raw }},
            backgroundColor: {{ stats.chartData.colors|json_encode|raw }},
            borderWidth: 2,
            borderColor: '#fff'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'bottom',
            }
        }
    }
});

// Graphique de progression (Line Chart)
const progressionCtx = document.getElementById('progressionChart');
const progressionChart = new Chart(progressionCtx, {
    type: 'line',
    data: {
        labels: {{ stats.progressionData.labels|json_encode|raw }},
        datasets: [{
            label: 'Projets créés',
            data: {{ stats.progressionData.data|json_encode|raw }},
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            tension: 0.4,
            fill: true
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                display: false
            }
        },
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    stepSize: 1
                }
            }
        }
    }
});

// Modal functionality
const deleteModal = document.getElementById('deleteModal');
const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

// Close modal when dismiss buttons are clicked
document.querySelectorAll('[data-dismiss="modal"]').forEach(btn => {
    btn.addEventListener('click', () => {
        deleteModal.classList.add('hidden');
    });
});

// Close modal when clicking outside
deleteModal.addEventListener('click', (e) => {
    if (e.target === deleteModal) {
        deleteModal.classList.add('hidden');
    }
});

// Fonction de confirmation de suppression
function confirmDelete(projectId, projectTitle) {
    document.getElementById('projectTitle').textContent = projectTitle;
    
    // Store the projectId for the confirmation button
    confirmDeleteBtn.dataset.projectId = projectId;
    
    // Show modal
    deleteModal.classList.remove('hidden');
}

// Handle the confirm delete button click
confirmDeleteBtn.addEventListener('click', function() {
    const projectId = this.dataset.projectId;
    if (!projectId) {
        console.error('Project ID not found');
        return;
    }
    
    // Create a form and submit it
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/project/' + projectId + '/delete';
    
    // Add CSRF token
    const tokenInput = document.createElement('input');
    tokenInput.type = 'hidden';
    tokenInput.name = '_token';
    tokenInput.value = '{{ csrf_token("delete") }}';
    form.appendChild(tokenInput);
    
    document.body.appendChild(form);
    form.submit();
});

</script>
{% endblock %}
