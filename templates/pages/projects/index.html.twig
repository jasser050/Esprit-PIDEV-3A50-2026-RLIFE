{% extends 'base.html.twig' %}

{% block title %}Mes Projets{% endblock %}

{% block body %}
<div class="space-y-6">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold mb-2">Mes Projets</h1>
            <p class="text-light-muted dark:text-dark-muted">Gérez vos projets de groupe</p>
        </div>
        <a href="{{ path('app_project_new') }}" class="btn btn-primary">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Nouveau Projet
        </a>
    </div>

    <!-- Projects Grid -->
    {% if projects|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for project in projects %}
                <div class="card p-6 hover:shadow-lg transition-shadow">
                    <!-- Project Header -->
                    <div class="flex items-start justify-between mb-4">
                        <h3 class="text-xl font-semibold">{{ project.titre }}</h3>
                        <span class="badge 
                            {% if project.statut == 'En cours' %}badge-primary
                            {% elseif project.statut == 'Terminé' %}badge-success
                            {% elseif project.statut == 'En attente' %}badge-warning
                            {% else %}badge-danger{% endif %}">
                            {{ project.statut }}
                        </span>
                    </div>

                    <!-- Description -->
                    <p class="text-light-muted dark:text-dark-muted mb-4 line-clamp-3">
                        {{ project.description }}
                    </p>

                    <!-- Dates -->
                    <div class="space-y-2 mb-4 text-sm">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-light-muted dark:text-dark-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <span class="text-light-muted dark:text-dark-muted">
                                {{ project.dateDebut|date('d/m/Y') }} - {{ project.dateFin|date('d/m/Y') }}
                            </span>
                        </div>
                        
                        <!-- Assignments Count -->
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-light-muted dark:text-dark-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            <span class="text-light-muted dark:text-dark-muted">
                                {{ project.assignments|length }} tâche(s)
                            </span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 pt-4 border-t border-light-border dark:border-dark-border">
                        <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-sm btn-ghost flex-1">
                            Voir
                        </a>
                        <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-sm btn-ghost">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </a>
                        <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce projet?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                            <button type="submit" class="btn btn-sm btn-ghost text-danger">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- Empty State -->
        <div class="card p-12 text-center">
            <svg class="w-16 h-16 mx-auto mb-4 text-light-muted dark:text-dark-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <h3 class="text-xl font-semibold mb-2">Aucun projet</h3>
            <p class="text-light-muted dark:text-dark-muted mb-6">Commencez par créer votre premier projet</p>
            <a href="{{ path('app_project_new') }}" class="btn btn-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Créer un Projet
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
