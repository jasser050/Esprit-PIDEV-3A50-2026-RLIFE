{# templates/pages/projects/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}My Projects{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- 1. Header + Search + Filters -->
    <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">My Projects</h1>
                <p class="text-secondary-500 dark:text-secondary-400 mt-1">Manage and track all your projects</p>
            </div>
            <a href="{{ path('app_project_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                New Project
            </a>
        </div>

        <!-- Search bar + filters -->
        <div class="card p-5">
            <form method="get" action="{{ path('app_project_index') }}" class="flex flex-col lg:flex-row lg:items-end gap-5 flex-wrap">
                <!-- Search -->
                <div class="flex-1 min-w-[300px] relative">
                    <label for="search" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Search</label>
                    <div class="relative">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-secondary-400 pointer-events                        <input type-none"></i>
="text"
                               id="search"
                               name="search"
                               value="{{ search|default('') }}"
                               placeholder="Title or description..."
                               class="input w-full pl-11 pr-4 py-2.5 text-base border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
                    </div>
                </div>

                <!-- Status Filter -->
                <div class="flex items-center gap-2.5 flex-wrap">
                    <span class="text-sm font-medium text-secondary-500 dark:text-secondary-400 whitespace-nowrap">Status:</span>
                    <button type="submit" name="statut" value="" class="badge {{ statut == '' ? 'badge-primary' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        All
                    </button>
                    <button type="submit" name="statut" value="En cours" class="badge {{ statut == 'En cours' ? 'badge-primary' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="loader" class="w-3.5 h-3.5"></i> In Progress
                    </button>
                    <button type="submit" name="statut" value="Terminé" class="badge {{ statut == 'Terminé' ? 'badge-success' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i> Completed
                    </button>
                    <button type="submit" name="statut" value="En attente" class="badge {{ statut == 'En attente' ? 'badge-warning' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending
                    </button>
                    <button type="submit" name="statut" value="Annulé" class="badge {{ statut == 'Annulé' ? 'badge-danger' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="x" class="w-3.5 h-3.5"></i> Cancelled
                    </button>
                </div>
            </form>
        </div>

        {% if search %}
            <div class="text-sm text-secondary-600 dark:text-secondary-400">
                Results for: <strong>{{ search }}</strong>
            </div>
        {% endif %}
    </div>

    <!-- 2. Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        {% for project in projects %}
            <div class="card p-6 hover:shadow-lg transition-all duration-300 hover:-translate-y-1 group">
                <div class="flex items-start justify-between mb-3">
                    <h3 class="font-semibold text-lg text-secondary-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                        <a href="{{ path('app_project_show', {'id': project.id}) }}">{{ project.titre }}</a>
                    </h3>
                    <span class="badge badge-{{ project.statut == 'En cours' ? 'primary' : (project.statut == 'Terminé' ? 'success' : (project.statut == 'En attente' ? 'warning' : 'danger')) }} badge-pill flex-shrink-0 ml-2">
                        {% if project.statut == 'En cours' %}In Progress
                        {% elseif project.statut == 'Terminé' %}Completed
                        {% elseif project.statut == 'En attente' %}Pending
                        {% elseif project.statut == 'Annulé' %}Cancelled
                        {% else %}{{ project.statut }}{% endif %}
                    </span>
                </div>

                <p class="text-secondary-600 dark:text-secondary-400 text-sm mb-4 line-clamp-2">
                    {{ project.description }}
                </p>

                <div class="flex items-center gap-4 text-xs text-secondary-500 dark:text-secondary-400 mb-4">
                    <span class="flex items-center gap-1">
                        <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                        {{ project.dateFin|date('d/m/Y') }}
                    </span>
                    <span class="flex items-center gap-1">
                        <i data-lucide="list-todo" class="w-3.5 h-3.5"></i>
                        {{ project.assignments|length }} task{{ project.assignments|length > 1 ? 's' : '' }}
                    </span>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-slate-200 dark:border-slate-700">
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-ghost btn-sm">
                            <i data-lucide="eye" class="w-4 h-4"></i>
                            View
                        </a>
                        <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-ghost btn-sm">
                            <i data-lucide="edit" class="w-4 h-4"></i>
                            Edit
                        </a>
                    </div>
                    <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" class="inline" onsubmit="return confirm('Are you sure you want to delete this project? This action is irreversible.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                        <button type="submit" class="btn btn-ghost btn-sm text-danger-600 dark:text-danger-400 hover:bg-danger-50 dark:hover:bg-danger-900/20">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </form>
                </div>
            </div>
        {% else %}
            <div class="col-span-full">
                <div class="text-center py-16">
                    <div class="w-20 h-20 mx-auto bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-4">
                        <i data-lucide="folder-plus" class="w-10 h-10 text-slate-400"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-secondary-900 dark:text-white mb-2">No projects yet</h3>
                    <p class="text-secondary-500 dark:text-secondary-400 mb-6 max-w-md mx-auto">
                        Create your first project to organize your tasks and track their progress.
                    </p>
                    <a href="{{ path('app_project_new') }}" class="btn btn-primary inline-flex items-center gap-2">
                        <i data-lucide="plus" class="w-5 h-5"></i>
                        Create My First Project
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- 3. Statistics Section -->
    {% if stats and stats.total > 0 %}
        <div class="card p-6">
            <h2 class="text-lg font-semibold text-secondary-900 dark:text-white mb-6">Statistics</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-primary-600 dark:text-primary-400">{{ stats.total }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Projects</p>
                </div>
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-primary-600 dark:text-primary-400">{{ stats.enCours }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">In Progress</p>
                </div>
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-success-600 dark:text-success-400">{{ stats.termines }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Completed</p>
                </div>
                <div class="text-center p-4 bg-slate-50 dark:bg-slate-800 rounded-xl">
                    <p class="text-3xl font-bold text-warning-600 dark:text-warning-400">{{ stats.enAttente }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Pending</p>
                </div>
            </div>

            <!-- Export Buttons -->
            <div class="flex flex-wrap gap-3 pt-4 border-t border-slate-200 dark:border-slate-700">
                <a href="{{ path('app_project_export_pdf') }}" class="btn btn-secondary btn-sm">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    Export PDF
                </a>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
