{# templates/pages/projects/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}My Projects{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .ai-panel {
        position: relative;
        overflow: hidden;
        border-radius: 1.5rem;
        border: 1px solid rgba(56, 189, 248, 0.35);
        background:
            radial-gradient(circle at 15% 12%, rgba(56, 189, 248, 0.14), transparent 40%),
            radial-gradient(circle at 85% 85%, rgba(16, 185, 129, 0.14), transparent 38%),
            linear-gradient(140deg, rgba(248, 250, 252, 0.96), rgba(236, 253, 245, 0.9));
    }
    .dark .ai-panel {
        border-color: rgba(8, 145, 178, 0.45);
        background:
            radial-gradient(circle at 15% 12%, rgba(34, 211, 238, 0.18), transparent 42%),
            radial-gradient(circle at 85% 85%, rgba(16, 185, 129, 0.16), transparent 40%),
            linear-gradient(150deg, rgba(12, 26, 42, 0.9), rgba(6, 24, 34, 0.88));
    }
    .ai-reco-card {
        border-radius: 1rem;
        border: 1px solid rgba(125, 211, 252, 0.45);
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(8px);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
    }
    .dark .ai-reco-card {
        border-color: rgba(14, 116, 144, 0.6);
        background: rgba(2, 20, 33, 0.62);
        box-shadow: 0 14px 30px rgba(2, 8, 23, 0.35);
    }
    .ai-chip {
        border-radius: 9999px;
        border: 1px solid rgba(125, 211, 252, 0.6);
        background: rgba(240, 249, 255, 0.9);
    }
    .dark .ai-chip {
        border-color: rgba(14, 116, 144, 0.7);
        background: rgba(8, 47, 73, 0.5);
    }
    .ai-focus {
        border-radius: 0.875rem;
        border: 1px solid rgba(252, 211, 77, 0.5);
        background: rgba(254, 252, 232, 0.86);
    }
    .dark .ai-focus {
        border-color: rgba(180, 83, 9, 0.6);
        background: rgba(69, 26, 3, 0.35);
    }
</style>
{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- 1. Header + Recherche + Filtres -->
    <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">My Projects</h1>
                <p class="text-secondary-500 dark:text-secondary-400 mt-1">Manage and track all your projects</p>
            </div>
            <a href="{{ path('app_project_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                New Project
            </a>
        </div>

        <div class="ai-panel">
            <div class="absolute -top-16 right-8 w-40 h-40 rounded-full bg-cyan-300/20 dark:bg-cyan-500/20 blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-16 left-12 w-40 h-40 rounded-full bg-emerald-300/20 dark:bg-emerald-500/20 blur-3xl pointer-events-none"></div>
            <div class="relative p-5 sm:p-6 space-y-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                    <div class="flex items-start gap-3">
                        <div class="w-11 h-11 rounded-2xl bg-white/90 dark:bg-slate-800 border border-cyan-200 dark:border-cyan-700 flex items-center justify-center shadow-sm">
                            <i data-lucide="swords" class="w-5 h-5 text-cyan-600 dark:text-cyan-300"></i>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300 font-semibold">AI Delivery Engine</p>
                            <h2 class="text-xl font-bold text-slate-900 dark:text-white">AI Project Challenge Mode</h2>
                            <p class="text-sm text-slate-600 dark:text-slate-300">Project-level hard challenges with bottleneck analysis and execution tactics.</p>
                        </div>
                    </div>
                <form method="post" action="{{ path('app_ai_productivity_generate') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('generate_ai_plan') }}">
                    <div class="flex gap-2">
                        <button type="submit" class="btn btn-primary shadow-sm">
                            <i data-lucide="bot" class="w-4 h-4"></i>
                            Generate Hard Plan
                        </button>
                        <a href="{{ path('app_ai_productivity_how_to_use') }}" class="btn btn-secondary shadow-sm">
                            <i data-lucide="circle-help" class="w-4 h-4"></i>
                            How To Use
                        </a>
                    </div>
                </form>
            </div>

            <div class="rounded-2xl border border-cyan-200/80 dark:border-cyan-700/60 bg-white/75 dark:bg-slate-900/40 p-4">
                <p class="text-sm font-semibold text-slate-900 dark:text-white">Quick AI flow for Projects</p>
                <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">Generate plan -> Start hard challenge -> Complete project/task updates -> Claim reward before expiry.</p>
            </div>

            {% if ai_plan.recommendations is defined and ai_plan.recommendations|length > 0 %}
                    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                        <span class="inline-flex items-center gap-1.5">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-300"></i>
                            {{ ai_plan.summary|default('Project-focused recommendations to keep delivery on track.') }}
                        </span>
                        <span class="ai-chip px-2.5 py-1 font-semibold text-slate-700 dark:text-slate-200">{{ ai_plan.source|default('fallback')|upper }}</span>
                    </div>
                    <div class="grid grid-cols-1 xl:grid-cols-2 gap-3">
                        {% set hasProjectRecommendations = false %}
                        {% for recIndex, rec in ai_plan.recommendations %}
                            {% if rec.type == 'project' %}
                                {% set hasProjectRecommendations = true %}
                                {% set challengeKey = rec.type ~ ':' ~ rec.target_id %}
                                {% set challenge = ai_challenges[challengeKey]|default(null) %}
                                <div class="ai-reco-card p-4 space-y-3">
                                    <div class="flex items-start justify-between gap-3">
                                        <div>
                                            <p class="text-sm font-semibold text-slate-900 dark:text-white">{{ rec.title }}</p>
                                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Project #{{ rec.target_id }}</p>
                                        </div>
                                        <span class="badge badge-primary badge-pill">{{ rec.reward_coins }} coins</span>
                                    </div>

                                    <div class="ai-focus px-3 py-2">
                                        <p class="text-xs font-semibold text-amber-800 dark:text-amber-300">Problem focus</p>
                                        <p class="text-xs text-amber-700 dark:text-amber-200 mt-1">{{ rec.reason|default('Critical project bottleneck detected.') }}</p>
                                    </div>

                                    <div class="grid grid-cols-2 gap-2 text-xs">
                                        <div class="rounded-lg border border-slate-200 dark:border-slate-700 px-2 py-1.5">
                                            <p class="text-slate-500 dark:text-slate-400">Estimate</p>
                                            <p class="font-semibold text-slate-900 dark:text-white">{{ rec.estimated_minutes }} min</p>
                                        </div>
                                        <div class="rounded-lg border border-slate-200 dark:border-slate-700 px-2 py-1.5">
                                            <p class="text-slate-500 dark:text-slate-400">Hard Challenge</p>
                                            <p class="font-semibold text-slate-900 dark:text-white">{{ rec.challenge_minutes }} min</p>
                                        </div>
                                    </div>

                                    {% if rec.tips is defined and rec.tips|length > 0 %}
                                        <div class="space-y-1">
                                            <p class="text-xs font-medium text-slate-700 dark:text-slate-300">Tactical tips</p>
                                            {% for tip in rec.tips|slice(0, 3) %}
                                                <p class="text-xs text-slate-600 dark:text-slate-400">• {{ tip }}</p>
                                            {% endfor %}
                                        </div>
                                    {% endif %}

                                    {% if challenge %}
                                        {% if challenge.claimed|default(false) %}
                                            <div class="inline-flex items-center gap-2 text-xs px-2.5 py-1.5 rounded-lg bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                                                <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
                                                Reward claimed
                                            </div>
                                        {% else %}
                                            <div class="flex flex-wrap items-center gap-2">
                                                <form method="post" action="{{ path('app_ai_productivity_claim') }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('claim_ai_challenge') }}">
                                                    <input type="hidden" name="type" value="{{ rec.type }}">
                                                    <input type="hidden" name="target_id" value="{{ rec.target_id }}">
                                                    <button type="submit" class="btn btn-success btn-sm">Claim Reward</button>
                                                </form>
                                                <span class="text-xs text-slate-500 dark:text-slate-400">Ends: {{ challenge.expires_at|date('H:i') }}</span>
                                            </div>
                                        {% endif %}
                                    {% else %}
                                        <form method="post" action="{{ path('app_ai_productivity_accept') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('accept_ai_recommendation') }}">
                                            <input type="hidden" name="recommendation_index" value="{{ recIndex }}">
                                            <button type="submit" class="btn btn-secondary btn-sm">Start Hard Challenge</button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}
                        {% if not hasProjectRecommendations %}
                            <div class="rounded-2xl border border-dashed border-cyan-300 dark:border-cyan-700 p-6 text-center xl:col-span-2">
                                <p class="text-sm text-slate-600 dark:text-slate-300">No project-focused items in the current plan. Regenerate to get project challenges.</p>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="rounded-2xl border border-dashed border-cyan-300 dark:border-cyan-700 p-6 text-center">
                        <p class="text-sm text-slate-600 dark:text-slate-300">No AI project recommendations yet. Generate your plan to get strict challenge targets and tips.</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Barre de recherche + filtres -->
        <div class="card p-5">
            <form method="get" action="{{ path('app_project_index') }}" class="flex flex-col lg:flex-row lg:items-end gap-5 flex-wrap">
                <!-- Recherche -->
                <div class="flex-1 min-w-[300px] relative">
                    <label for="search" class="block text-sm font-medium text-secondary-700 dark:text-secondary-300 mb-2">Search</label>
                    <div class="relative">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-secondary-400 pointer-events-none"></i>
                        <input type="text"
                               id="search"
                               name="search"
                               value="{{ search|default('') }}"
                               placeholder="Title or description..."
                               class="input w-full pl-11 pr-4 py-2.5 text-base border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-all">
                    </div>
                </div>

                <!-- Filtre Statut -->
                <div class="flex items-center gap-2.5 flex-wrap">
                    <span class="text-sm font-medium text-secondary-500 dark:text-secondary-400 whitespace-nowrap">Status:</span>
                    <button type="submit" name="statut" value="" class="badge {{ statut == '' ? 'badge-primary' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        All
                    </button>
                    <button type="submit" name="statut" value="En cours" class="badge {{ statut == 'En cours' ? 'badge-primary' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="loader" class="w-3.5 h-3.5"></i> In Progress
                    </button>
                    <button type="submit" name="statut" value="TerminÃ©" class="badge {{ statut == 'TerminÃ©' ? 'badge-success' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i> Completed
                    </button>
                    <button type="submit" name="statut" value="En attente" class="badge {{ statut == 'En attente' ? 'badge-warning' : 'badge-secondary' }} badge-pill px-4 py-1.5 cursor-pointer hover:opacity-90 transition-opacity">
                        <i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending
                    </button>
                </div>

                <!-- Actions -->
                <div class="flex items-end gap-3 flex-wrap">
                    <button type="submit" class="btn btn-primary px-5 py-2.5">
                        <i data-lucide="search" class="w-5 h-5"></i>
                        Search
                    </button>

                    {% if search or statut %}
                        <a href="{{ path('app_project_index') }}" class="btn btn-ghost text-sm text-primary-600 dark:text-primary-400 hover:underline flex items-center gap-1.5 px-4 py-2.5">
                            <i data-lucide="x" class="w-4 h-4"></i>
                            Clear
                        </a>
                    {% endif %}
                </div>
            </form>
        </div>

        <!-- Indicateur filtres actifs -->
        {% if search or statut %}
            {% set activeStatusLabel = (statut in ['En cours']) ? 'In Progress' : ((statut in ['Terminé', 'TerminÃ©', 'Termine']) ? 'Completed' : ((statut in ['En attente']) ? 'Pending' : statut)) %}
            <div class="text-sm bg-slate-50 dark:bg-slate-800/40 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                {% if search %}Results for: <strong>{{ search }}</strong>{% endif %}
                {% if statut %} â€¢ Status: <strong>{{ activeStatusLabel }}</strong>{% endif %}
            </div>
        {% endif %}
    </div>

    <!-- 2. Liste des projets -->
    {% if projects|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for project in projects %}
                <div class="card p-6 hover:shadow-md transition-all duration-200 hover:border-primary-500/50 group {{ project.user.id != app.user.id ? 'border-l-4 border-l-info' : '' }}">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-secondary-900 dark:text-white group-hover:text-primary-600 transition-colors flex items-center gap-2">
                                {{ project.titre }}
                                {% if project.user.id != app.user.id %}
                                    <span class="badge badge-info badge-pill text-xs">
                                        <i data-lucide="share-2" class="w-3 h-3"></i>
                                        Shared
                                    </span>
                                {% endif %}
                            </h3>
                            {% if project.user.id != app.user.id %}
                                <p class="text-xs text-secondary-500 mt-1">
                                    <i data-lucide="user" class="w-3 h-3 inline"></i>
                                    By {{ project.user.fullName }}
                                </p>
                            {% endif %}
                        </div>
                        {% set statusRaw = project.statut|default('') %}
                        {% set statusLabel = (statusRaw in ['En cours']) ? 'In Progress' : ((statusRaw in ['Terminé', 'TerminÃ©', 'Termine']) ? 'Completed' : ((statusRaw in ['En attente']) ? 'Pending' : statusRaw)) %}
                        <span class="badge badge-pill
                            {% if project.statut == 'En cours' %}badge-primary
                            {% elseif project.statut == 'TerminÃ©' %}badge-success
                            {% elseif project.statut == 'En attente' %}badge-warning
                            {% else %}badge-danger{% endif %}">
                            {{ statusLabel }}
                        </span>
                    </div>

                    <p class="text-sm text-secondary-600 dark:text-secondary-400 mb-4 line-clamp-3">
                        {{ project.description|default('No description') }}
                    </p>

                    <div class="text-xs text-secondary-500 dark:text-secondary-400 flex flex-wrap gap-4 mb-4">
                        <span>
                            <i data-lucide="calendar" class="w-3.5 h-3.5 mr-1"></i>
                            {{ project.dateDebut|date('d/m/Y') }} â†’ {{ project.dateFin|date('d/m/Y') }}
                        </span>
                        {% if project.assignments|length > 0 %}
                            <span>
                                <i data-lucide="list-checks" class="w-3.5 h-3.5 mr-1"></i>
                                {{ project.assignments|length }} task{{ project.assignments|length > 1 ? 's' : '' }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="flex gap-2 mt-4">
                        <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-secondary flex-1 text-sm">
                            <i data-lucide="eye" class="w-4 h-4 mr-1.5"></i>
                            View
                        </a>
                        {% if project.user.id == app.user.id %}
                            <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-ghost btn-icon-sm">
                                <i data-lucide="edit-2" class="w-4 h-4"></i>
                            </a>
                            <form method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" class="inline" data-confirm="Are you sure you want to delete this project? This action is irreversible.">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                <button type="submit" class="btn btn-ghost btn-icon-sm text-danger">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- Ã‰tat vide -->
        <div class="card p-12 text-center">
            <div class="flex flex-col items-center gap-4">
                <i data-lucide="folder-x" class="w-16 h-16 text-secondary-400 dark:text-secondary-500"></i>
                <h3 class="text-xl font-semibold text-secondary-900 dark:text-white">No projects at the moment</h3>
                <p class="text-secondary-500 dark:text-secondary-400 max-w-md">
                    Create your first project to organize your tasks and track their progress.
                </p>
                <a href="{{ path('app_project_new') }}" class="btn btn-primary mt-2">
                    <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                    Create my first project
                </a>
            </div>
        </div>
    {% endif %}

    <!-- 3. Statistiques + Graphes (tout en bas) -->
    <div class="space-y-6 mt-12">
        <!-- Cartes statistiques -->
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="card p-4 flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                    <i data-lucide="folder" class="w-5 h-5 text-slate-600 dark:text-slate-300"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stats.total|default(0) }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Total Projects</p>
                </div>
            </div>
            <div class="card p-4 flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="loader" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stats.enCours|default(0) }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">In Progress</p>
                </div>
            </div>
            <div class="card p-4 flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                    <i data-lucide="check-circle-2" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stats.termines|default(0) }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Completed</p>
                </div>
            </div>
            <div class="card p-4 flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                    <i data-lucide="clock" class="w-5 h-5 text-warning-600 dark:text-warning-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stats.enAttente|default(0) }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Pending</p>
                </div>
            </div>
            <div class="card p-4 flex items-center gap-4">
                <div class="w-11 h-11 rounded-xl bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-danger-600 dark:text-danger-400"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stats.enRetard|default(0) }}</p>
                    <p class="text-sm text-secondary-500 dark:text-secondary-400">Overdue</p>
                </div>
            </div>
        </div>

        <!-- Graphes -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Pie Chart - RÃ©partition par statut -->
            <div class="card p-6">
                <h3 class="text-lg font-semibold mb-4 text-secondary-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="pie-chart" class="w-5 h-5 text-primary-600"></i>
                    Distribution by Status
                </h3>
                <div class="h-72"
                     data-controller="chart"
                     data-chart-type-value="pie"
                     data-chart-data-value='{{ {
                        "labels": ["In Progress", "Completed", "Pending", "Overdue"],
                        "datasets": [{
                            "label": "Projects",
                            "data": [
                                stats.enCours|default(0),
                                stats.termines|default(0),
                                stats.enAttente|default(0),
                                stats.enRetard|default(0)
                            ],
                            "backgroundColor": ["#3b82f6", "#10b981", "#f59e0b", "#ef4444"],
                            "borderColor": ["#3b82f6", "#10b981", "#f59e0b", "#ef4444"]
                        }]
                     }|json_encode|e('html_attr') }}'
                     data-chart-options-value='{{ {
                        "plugins": {
                            "legend": {
                                "position": "bottom"
                            }
                        }
                     }|json_encode|e('html_attr') }}'>
                    <canvas data-chart-target="canvas"></canvas>
                </div>
            </div>

            <!-- Bar Chart - Projets crÃ©Ã©s par mois -->
            <div class="card p-6">
                <h3 class="text-lg font-semibold mb-4 text-secondary-900 dark:text-white flex items-center gap-2">
                    <i data-lucide="bar-chart-3" class="w-5 h-5 text-primary-600"></i>
                    Projects created over time
                </h3>
                {% set progressionLabels = stats.progressionData.labels|default([]) %}
                {% set progressionValues = stats.progressionData.data|default([]) %}
                <div class="h-72"
                     data-controller="chart"
                     data-chart-type-value="bar"
                     data-chart-data-value='{{ {
                        "labels": progressionLabels|length > 0 ? progressionLabels : ["No data"],
                        "datasets": [{
                            "label": "Projects created",
                            "data": progressionValues|length > 0 ? progressionValues : [0]
                        }]
                     }|json_encode|e('html_attr') }}'
                     data-chart-options-value='{{ {
                        "plugins": {
                            "legend": {
                                "display": false
                            }
                        },
                        "scales": {
                            "y": {
                                "beginAtZero": true
                            }
                        }
                     }|json_encode|e('html_attr') }}'>
                    <canvas data-chart-target="canvas"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
