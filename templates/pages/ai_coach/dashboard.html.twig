{% extends 'base.html.twig' %}

{% block title %}🤖 AI Study Coach{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">🤖 AI Study Coach</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Personalized recommendations powered by AI</p>
        </div>
        <div class="flex gap-2">
            <a href="{{ path('app_stats_dashboard') }}" class="btn btn-secondary">
                📊 Statistics
            </a>
            <a href="{{ path('app_courses') }}" class="btn btn-secondary">
                ← Back to Courses
            </a>
        </div>
    </div>
    
    <!-- Priority Level Alert -->
    {% set priorityColors = {
        'critical': 'from-red-500 to-red-700',
        'high': 'from-orange-500 to-red-600',
        'moderate': 'from-yellow-500 to-orange-500',
        'low': 'from-green-500 to-teal-500',
        'relaxed': 'from-blue-500 to-cyan-500'
    } %}
    
    {% set priorityIcons = {
        'critical': '🚨',
        'high': '⚠️',
        'moderate': '📌',
        'low': '✅',
        'relaxed': '😊'
    } %}
    
    {% set priorityMessages = {
        'critical': 'CRITICAL: Immediate action required!',
        'high': 'HIGH PRIORITY: Focus needed soon',
        'moderate': 'MODERATE: Stay consistent',
        'low': 'LOW: Maintain current pace',
        'relaxed': 'EXCELLENT: Keep up the great work!'
    } %}
    
    <div class="card overflow-hidden">
        <div class="p-6 bg-gradient-to-br {{ priorityColors[recommendations.priority_level] }} text-white">
            <div class="flex items-center gap-4">
                <div class="text-6xl">{{ priorityIcons[recommendations.priority_level] }}</div>
                <div>
                    <h3 class="text-2xl font-bold">{{ priorityMessages[recommendations.priority_level] }}</h3>
                    <p class="text-white/90 text-lg mt-2">{{ recommendations.motivational_message.main }}</p>
                    {% for msg in recommendations.motivational_message.additional %}
                    <p class="text-white/80 text-sm mt-1">{{ msg }}</p>
                    {% endfor %}
                </div>
            </div>
            <div class="mt-4 p-4 bg-white/10 rounded-lg backdrop-blur-sm">
                <p class="text-sm italic">"{{ recommendations.motivational_message.quote }}"</p>
            </div>
        </div>
    </div>
    
    <!-- At-Risk Subjects -->
    {% if recommendations.at_risk_subjects|length > 0 %}
    <div class="card p-6">
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-4 flex items-center gap-2">
            🚨 Subjects Needing Attention
            <span class="badge badge-danger">{{ recommendations.at_risk_subjects|length }}</span>
        </h3>
        
        <div class="space-y-4">
            {% for risk in recommendations.at_risk_subjects %}
            <div class="border border-secondary-200 dark:border-secondary-700 rounded-lg p-4 
                        {% if risk.urgency == 'critical' %}bg-red-50 dark:bg-red-900/20
                        {% elseif risk.urgency == 'high' %}bg-orange-50 dark:bg-orange-900/20
                        {% else %}bg-yellow-50 dark:bg-yellow-900/20{% endif %}">
                
                <div class="flex items-start justify-between mb-3">
                    <div>
                        <h4 class="text-lg font-bold text-secondary-900 dark:text-white">
                            {{ risk.matiere.nomMatiere }}
                        </h4>
                        <p class="text-sm text-secondary-600 dark:text-secondary-400">
                            Recent Average: <span class="font-semibold">{{ risk.recent_average }}%</span>
                        </p>
                    </div>
                    <div class="text-right">
                        <div class="text-3xl font-bold 
                                    {% if risk.risk_score >= 70 %}text-red-600
                                    {% elseif risk.risk_score >= 50 %}text-orange-600
                                    {% else %}text-yellow-600{% endif %}">
                            {{ risk.risk_score }}
                        </div>
                        <p class="text-xs text-secondary-500">Risk Score</p>
                    </div>
                </div>
                
                <!-- Risk Meter -->
                <div class="mb-3">
                    <div class="w-full bg-secondary-200 dark:bg-secondary-700 rounded-full h-3">
                        <div class="h-3 rounded-full transition-all duration-500
                                    {% if risk.risk_score >= 70 %}bg-red-600
                                    {% elseif risk.risk_score >= 50 %}bg-orange-500
                                    {% else %}bg-yellow-500{% endif %}"
                             style="width: {{ risk.risk_score }}%">
                        </div>
                    </div>
                </div>
                
                <!-- Trend Indicator -->
                <div class="flex items-center gap-2 mb-3 text-sm">
                    <span class="font-semibold">Trend:</span>
                    {% if risk.trend > 0 %}
                        <span class="text-green-600">📈 +{{ risk.trend|abs|round(2) }}% (Improving)</span>
                    {% elseif risk.trend < 0 %}
                        <span class="text-red-600">📉 {{ risk.trend|round(2) }}% (Declining)</span>
                    {% else %}
                        <span class="text-gray-600">➡️ Stable</span>
                    {% endif %}
                </div>
                
                <!-- AI Recommendation -->
                <div class="bg-white dark:bg-secondary-800 p-3 rounded-lg">
                    <p class="text-sm font-semibold text-secondary-900 dark:text-white mb-1">
                        🤖 AI Recommendation:
                    </p>
                    <p class="text-sm text-secondary-700 dark:text-secondary-300">
                        {{ risk.recommendation }}
                    </p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
    
    <!-- Improvement Opportunities -->
    {% if recommendations.improvement_opportunities|length > 0 %}
    <div class="card p-6">
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-4 flex items-center gap-2">
            💡 Opportunities for Growth
            <span class="badge badge-success">{{ recommendations.improvement_opportunities|length }}</span>
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for opportunity in recommendations.improvement_opportunities %}
            <div class="border border-green-200 dark:border-green-800 rounded-lg p-4 bg-green-50 dark:bg-green-900/20">
                <div class="flex items-start gap-3">
                    <div class="text-3xl">{{ opportunity.icon }}</div>
                    <div class="flex-1">
                        <h4 class="font-bold text-secondary-900 dark:text-white mb-1">
                            {{ opportunity.matiere.nomMatiere }}
                        </h4>
                        <p class="text-sm text-secondary-700 dark:text-secondary-300 mb-2">
                            {{ opportunity.message }}
                        </p>
                        <div class="bg-white dark:bg-secondary-800 p-2 rounded text-sm">
                            <strong>Action:</strong> {{ opportunity.action }}
                        </div>
                        {% if opportunity.current_average is defined %}
                        <p class="text-xs text-secondary-500 mt-2">
                            Current: {{ opportunity.current_average }}%
                        </p>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
    
    <!-- Study Schedule -->
    {% if recommendations.study_schedule|length > 0 %}
    <div class="card p-6">
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-4">
            📅 Recommended Study Schedule
        </h3>
        
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-secondary-100 dark:bg-secondary-800">
                    <tr>
                        <th class="px-4 py-3 text-left">Day</th>
                        <th class="px-4 py-3 text-left">Subject</th>
                        <th class="px-4 py-3 text-center">Duration</th>
                        <th class="px-4 py-3 text-left">Reason</th>
                    </tr>
                </thead>
                <tbody>
                    {% for session in recommendations.study_schedule %}
                    <tr class="border-b border-secondary-200 dark:border-secondary-700">
                        <td class="px-4 py-3 font-semibold">{{ session.day }}</td>
                        <td class="px-4 py-3">{{ session.matiere.nomMatiere }}</td>
                        <td class="px-4 py-3 text-center">
                            <span class="badge badge-primary">{{ session.duration_minutes }} min</span>
                        </td>
                        <td class="px-4 py-3 text-sm">{{ session.reason }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <a href="{{ path('app_ai_coach_schedule') }}" class="btn btn-primary mt-4 inline-flex items-center gap-2">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            View Full Schedule
        </a>
    </div>
    {% endif %}
    
    <!-- Learning Strategies -->
    <div class="card p-6">
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-4">
            🧠 Personalized Learning Strategies
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {% for strategy in recommendations.learning_strategies %}
            <div class="border border-secondary-200 dark:border-secondary-700 rounded-lg p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="text-4xl">{{ strategy.icon }}</div>
                    <h4 class="text-lg font-bold text-secondary-900 dark:text-white">
                        {{ strategy.title }}
                    </h4>
                </div>
                <p class="text-sm text-secondary-700 dark:text-secondary-300 mb-4">
                    {{ strategy.description }}
                </p>
                <ul class="space-y-2">
                    {% for technique in strategy.techniques %}
                    <li class="flex items-start gap-2 text-sm">
                        <span class="text-primary-600">✓</span>
                        <span>{{ technique }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
        </div>
    </div>
    
    <!-- SMART Goals -->
    <div class="card p-6">
        <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-4">
            🎯 Your SMART Goals
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {% for goal in recommendations.smart_goals %}
            <div class="border border-blue-200 dark:border-blue-800 rounded-lg p-5 bg-blue-50 dark:bg-blue-900/20">
                <div class="flex items-center justify-between mb-4">
                    <h4 class="text-lg font-bold text-secondary-900 dark:text-white">
                        {{ goal.type|title }} Goal
                    </h4>
                    <span class="badge badge-info">{{ goal.deadline }}</span>
                </div>
                
                <div class="mb-4">
                    <div class="flex justify-between text-sm mb-2">
                        <span>Current: {{ goal.current }}</span>
                        <span>Target: {{ goal.target }}</span>
                    </div>
                    <div class="w-full bg-secondary-200 dark:bg-secondary-700 rounded-full h-3">
                        <div class="bg-blue-600 h-3 rounded-full transition-all"
                             style="width: {{ (goal.current / goal.target * 100)|round }}%">
                        </div>
                    </div>
                </div>
                
                <div class="space-y-2 text-sm">
                    <p><strong>S</strong>pecific: {{ goal.specific }}</p>
                    <p><strong>M</strong>easurable: {{ goal.measurable }}</p>
                    <p><strong>A</strong>chievable: {{ goal.achievable }}</p>
                    <p><strong>R</strong>elevant: {{ goal.relevant }}</p>
                    <p><strong>T</strong>ime-bound: {{ goal.time_bound }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    });
</script>
{% endblock %}