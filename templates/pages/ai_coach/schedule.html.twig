{% extends 'base.html.twig' %}

{% block title %}📅 Study Schedule{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 py-12">
    <div class="container mx-auto px-4 max-w-7xl">
        
        <!-- Header -->
        <div class="mb-8">
            <a href="{{ path('app_ai_coach') }}" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 mb-4">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to AI Coach
            </a>
            
            <h1 class="text-4xl font-bold text-gray-900 mb-2">
                📅 Your Personalized Study Schedule
            </h1>
            <p class="text-gray-600">Optimized study plan based on your performance data</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Weekly Schedule -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-xl p-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6">📆 Weekly Schedule</h2>
                    
                    <div class="space-y-4">
                        {% for session in schedule %}
                        <div class="border-l-4 border-indigo-500 bg-gradient-to-r from-indigo-50 to-purple-50 p-6 rounded-lg hover:shadow-md transition-all duration-300">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <div class="flex items-center gap-3 mb-2">
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
                                            {{ session.day }}
                                        </span>
                                        <h3 class="text-xl font-bold text-gray-900">
                                            {{ session.matiere.nomMatiere }}
                                        </h3>
                                    </div>
                                    
                                    <div class="flex items-center gap-4 text-sm text-gray-600 mb-3">
                                        <span class="flex items-center">
                                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            {{ session.duration_minutes }} minutes
                                        </span>
                                    </div>
                                    
                                    <p class="text-gray-700 italic">
                                        {{ session.reason }}
                                    </p>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Priority Subjects Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-gradient-to-br from-red-50 to-orange-50 rounded-2xl shadow-xl p-6 border-2 border-red-200">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                        🚨 Priority Subjects
                    </h2>
                    
                    {% if at_risk|length > 0 %}
                        <div class="space-y-4">
                            {% for risk in at_risk %}
                            <div class="bg-white rounded-xl p-4 border-l-4 border-red-500">
                                <div class="flex items-start justify-between mb-2">
                                    <h3 class="font-bold text-gray-900">
                                        {{ loop.index }}. {{ risk.matiere.nomMatiere }}
                                    </h3>
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800">
                                        {{ risk.risk_score }}
                                    </span>
                                </div>
                                
                                <p class="text-sm text-gray-700 mb-2">
                                    {{ risk.recommendation }}
                                </p>
                                
                                <div class="text-xs text-gray-500">
                                    Current Average: <span class="font-semibold">{{ risk.recent_average|round(1) }}%</span>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8">
                            <div class="text-6xl mb-4">🎉</div>
                            <p class="text-gray-600 font-medium">
                                No subjects at risk!<br>Keep up the great work!
                            </p>
                        </div>
                    {% endif %}
                </div>

                <!-- Study Tips -->
                <div class="mt-6 bg-gradient-to-br from-blue-50 to-cyan-50 rounded-2xl shadow-lg p-6">
                    <h3 class="text-lg font-bold text-gray-900 mb-4">💡 Study Tips</h3>
                    <ul class="space-y-2 text-sm text-gray-700">
                        <li class="flex items-start">
                            <span class="mr-2">✓</span>
                            <span>Take 5-minute breaks every 25 minutes</span>
                        </li>
                        <li class="flex items-start">
                            <span class="mr-2">✓</span>
                            <span>Study in a distraction-free environment</span>
                        </li>
                        <li class="flex items-start">
                            <span class="mr-2">✓</span>
                            <span>Review material before bed for better retention</span>
                        </li>
                        <li class="flex items-start">
                            <span class="mr-2">✓</span>
                            <span>Practice active recall instead of passive reading</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>

        <!-- Action Buttons -->
        <div class="mt-8 flex gap-4 justify-center">
            <a href="{{ path('app_ai_coach') }}" 
               class="px-6 py-3 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition-all duration-300 shadow-lg hover:shadow-xl">
                View Full AI Report
            </a>
            <a href="{{ path('app_courses') }}" 
               class="px-6 py-3 bg-white text-indigo-600 border-2 border-indigo-600 rounded-xl hover:bg-indigo-50 transition-all duration-300">
                Back to Courses
            </a>
        </div>

    </div>
</div>
{% endblock %}
