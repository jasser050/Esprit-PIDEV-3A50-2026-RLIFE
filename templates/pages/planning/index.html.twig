// Configuration
const HOURS_START = 7;  // 7h
const HOURS_END = 21;   // 21h
const SLOT_MINS = 30;   // 30 min par créneau
const TOTAL_ROWS = ((HOURS_END - HOURS_START) * 60) / SLOT_MINS; // 28 créneaux
const DAYS = 7;
const GAME_DURATION = 120; // 2 minutes
const BASE_PTS = 100;

const DAY_NAMES = ['LUN', 'MAR', 'MER', 'JEU', 'VEN', 'SAM', 'DIM'];

// Palette de couleurs
const PALETTE = [
  '#4f46e5', '#7c3aed', '#ec4899', '#f59e0b',
  '#10b981', '#0ea5e9', '#f43f5e', '#8b5cf6'
];

let gameState = {
  score: 0, combo: 0, lives: 3, placed: 0,
  timeLeft: GAME_DURATION, timer: null,
  selectedEvent: null,
  events: [],
  grid: [],
  running: false
};

function scrapeEventsFromDOM() {
  const eventsData = {{ events_by_date|json_encode|raw }};
  
  console.log('Données brutes du calendrier:', eventsData);
  
  // Collecter tous les événements valides
  const allEvents = [];
  
  // Parcourir toutes les dates du mois
  for (const dateStr in eventsData) {
    const events = eventsData[dateStr];
    if (!events || events.length === 0) continue;
    
    // Vérifier si c'est un jour de repos
    const dayOff = events.some(e => e.title && e.title.toLowerCase() === 'day off');
    if (dayOff) continue; // Ignorer les jours de repos
    
    // Récupérer le jour de la semaine
    const date = new Date(dateStr + 'T12:00:00');
    const dayIndex = date.getDay(); // 0 = Dimanche, 1 = Lundi, ...
    const adjustedDayIndex = dayIndex === 0 ? 6 : dayIndex - 1; // 0 = Lundi, 6 = Dimanche
    
    // Pour chaque événement du jour
    events.forEach(event => {
      if (event.is_google) return; // Ignorer les événements Google
      
      // Calculer la durée en créneaux (30 min par créneau) - LIMITÉE À 4H MAX
      let duration = 2; // Par défaut 1h = 2 créneaux
      let startHour = 8;
      let startMin = 0;
      let startRow = 0;
      let startTimeStr = '08h00';
      
      if (event.start_time) {
        const timeParts = event.start_time.split(':');
        startHour = parseInt(timeParts[0]);
        startMin = parseInt(timeParts[1] || 0);
        startTimeStr = `${String(startHour).padStart(2,'0')}h${String(startMin).padStart(2,'0')}`;
      }
      
      if (event.start_time && event.end_time) {
        const start = event.start_time.split(':').map(Number);
        const end = event.end_time.split(':').map(Number);
        const startMinutes = start[0] * 60 + (start[1] || 0);
        const endMinutes = end[0] * 60 + (end[1] || 0);
        const diffMinutes = endMinutes - startMinutes;
        
        // Limiter la durée maximale à 4h (8 créneaux)
        duration = Math.min(8, Math.max(1, Math.round(diffMinutes / SLOT_MINS)));
        
        // Calculer la ligne de départ
        const minutesSinceStart = startMinutes - (HOURS_START * 60);
        startRow = Math.max(0, Math.min(TOTAL_ROWS - duration, Math.round(minutesSinceStart / SLOT_MINS)));
      } else {
        // Générer une heure aléatoire entre 8h et 18h
        startHour = 8 + Math.floor(Math.random() * 10);
        startMin = Math.random() > 0.5 ? 0 : 30;
        startTimeStr = `${String(startHour).padStart(2,'0')}h${String(startMin).padStart(2,'0')}`;
        const startMinutes = startHour * 60 + startMin;
        const minutesSinceStart = startMinutes - (HOURS_START * 60);
        startRow = Math.max(0, Math.min(TOTAL_ROWS - duration, Math.round(minutesSinceStart / SLOT_MINS)));
      }
      
      allEvents.push({
        id: 'evt_' + (allEvents.length + 1),
        name: event.title,
        dayIndex: adjustedDayIndex,
        duration: duration,
        color: PALETTE[allEvents.length % PALETTE.length],
        placed: false,
        dayOff: false,
        startHour: startHour,
        startMin: startMin,
        startRow: startRow,
        originalDate: dateStr,
        originalDay: DAY_NAMES[adjustedDayIndex],
        originalTime: startTimeStr
      });
    });
  }
  
  // Si pas d'événements, créer des événements de démonstration
  if (allEvents.length === 0) {
    const demos = [
      { name: 'Réunion équipe', days: [0,2,4], durs: [2,3,4] },
      { name: 'Code review', days: [1,3], durs: [1,2] },
      { name: 'Déjeuner', days: [0,1,2,3,4], durs: [1,2] },
      { name: 'Workshop', days: [2,4], durs: [4,6] },
      { name: 'One-on-one', days: [1,3], durs: [1,2] },
      { name: 'Sprint planning', days: [0], durs: [4] },
      { name: 'Standup', days: [0,1,2,3,4], durs: [1] },
      { name: 'Formation', days: [2,3], durs: [4,6] },
      { name: 'Call client', days: [1,4], durs: [2] },
      { name: 'Rétro', days: [4], durs: [2,3] }
    ];
    
    for (let i = 0; i < 12; i++) {
      const demo = demos[Math.floor(Math.random() * demos.length)];
      const dayIndex = demo.days[Math.floor(Math.random() * demo.days.length)];
      const duration = demo.durs[Math.floor(Math.random() * demo.durs.length)];
      
      // Générer une heure aléatoire
      const startHour = 8 + Math.floor(Math.random() * 10);
      const startMin = Math.random() > 0.5 ? 0 : 30;
      const startTimeStr = `${String(startHour).padStart(2,'0')}h${String(startMin).padStart(2,'0')}`;
      const startMinutes = startHour * 60 + startMin;
      const minutesSinceStart = startMinutes - (HOURS_START * 60);
      const startRow = Math.max(0, Math.min(TOTAL_ROWS - duration, Math.round(minutesSinceStart / SLOT_MINS)));
      
      allEvents.push({
        id: 'evt_' + i,
        name: demo.name,
        dayIndex: dayIndex,
        duration: duration,
        color: PALETTE[i % PALETTE.length],
        placed: false,
        dayOff: false,
        startHour: startHour,
        startMin: startMin,
        startRow: startRow,
        originalDay: DAY_NAMES[dayIndex],
        originalTime: startTimeStr
      });
    }
  }
  
  // MÉLANGE ALEATOIRE - randomiser l'ordre des événements à chaque partie
  const shuffled = allEvents.sort(() => Math.random() - 0.5);
  
  console.log('Événements pour le jeu (aléatoire):', shuffled.map(e => 
    `${e.name} - ${e.originalDay} ${e.originalTime} (${e.duration} créneaux)`
  ));
  
  return shuffled.slice(0, 12); // Limiter à 12 événements
}

function initTetris() {
  gameState = {
    score: 0, combo: 0, lives: 3, placed: 0,
    timeLeft: GAME_DURATION, timer: null,
    selectedEvent: null,
    events: scrapeEventsFromDOM(),
    grid: Array.from({ length: TOTAL_ROWS }, () => new Array(DAYS).fill(null)),
    running: true
  };

  try {
    const best = localStorage.getItem('tetris_best') || '0';
    document.getElementById('t-best').textContent = best;
  } catch(e) {}

  renderHUD();
  buildBoard();
  renderQueue();
  renderNextCard();
  startTimer();
}

function startTimer() {
  stopTimer();
  gameState.timer = setInterval(() => {
    gameState.timeLeft--;
    updateTimerDisplay();
    if (gameState.timeLeft <= 0) endGame('time');
    if (gameState.timeLeft <= 20) {
      document.querySelector('.hud-block.hud-timer')?.classList.add('danger');
    }
  }, 1000);
}

function stopTimer() {
  if (gameState.timer) { clearInterval(gameState.timer); gameState.timer = null; }
}

function updateTimerDisplay() {
  const m = Math.floor(gameState.timeLeft / 60);
  const s = gameState.timeLeft % 60;
  document.getElementById('t-timer').textContent =
    String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
}

function renderHUD() {
  updateTimerDisplay();
  animateHudValue('t-score', gameState.score);
  animateHudValue('t-combo', 'x' + Math.max(1, gameState.combo));
  animateHudValue('t-placed', gameState.placed);
  animateHudValue('t-lives', gameState.lives);
}

function animateHudValue(id, val) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = val;
  el.classList.remove('pop');
  void el.offsetWidth;
  el.classList.add('pop');
}

function buildBoard() {
  const board = document.getElementById('t-board');
  board.innerHTML = '';

  for (let row = 0; row < TOTAL_ROWS; row++) {
    const totalMin = HOURS_START * 60 + row * SLOT_MINS;
    const h = Math.floor(totalMin / 60);
    const m = totalMin % 60;
    const label = document.createElement('div');
    label.className = 'time-label';
    label.textContent = m === 0 ? `${h}h` : `${h}h${String(m).padStart(2,'0')}`;
    board.appendChild(label);

    for (let col = 0; col < DAYS; col++) {
      const cell = document.createElement('div');
      cell.className = 't-cell';
      cell.dataset.row = row;
      cell.dataset.col = col;
      cell.addEventListener('mouseenter', () => onCellHover(cell, row, col));
      cell.addEventListener('mouseleave', () => clearHighlight());
      cell.addEventListener('click', () => onCellClick(row, col));
      board.appendChild(cell);
    }
  }
}

function getCell(row, col) {
  return document.querySelector(`.t-cell[data-row="${row}"][data-col="${col}"]`);
}

function onCellHover(cell, row, col) {
  clearHighlight();
  if (!gameState.selectedEvent || !gameState.running) return;
  
  // Vérifier si c'est le bon jour
  if (gameState.selectedEvent.dayIndex !== col) {
    cell.classList.add('t-cell-highlight');
    cell.style.borderColor = '#ef4444';
    cell.title = `❌ Mauvais jour ! (${DAY_NAMES[col]} au lieu de ${DAY_NAMES[gameState.selectedEvent.dayIndex]})`;
    return;
  }
  
  const dur = gameState.selectedEvent.duration;
  const expectedRow = gameState.selectedEvent.startRow;
  
  // Vérifier l'heure
  if (row !== expectedRow) {
    cell.classList.add('t-cell-highlight');
    cell.style.borderColor = '#ef4444';
    cell.title = `❌ Mauvaise heure ! Attendue: ${gameState.selectedEvent.originalTime}`;
    return;
  }
  
  for (let r = row; r < row + dur && r < TOTAL_ROWS; r++) {
    const c = getCell(r, col);
    if (c) {
      c.classList.add('t-cell-highlight');
      c.style.borderColor = '#fbbf24';
      c.title = `✅ Bon emplacement pour ${gameState.selectedEvent.name}`;
    }
  }
}

function clearHighlight() {
  document.querySelectorAll('.t-cell-highlight').forEach(c => {
    c.classList.remove('t-cell-highlight');
    c.style.borderColor = '';
  });
}

function onCellClick(row, col) {
  if (!gameState.selectedEvent || !gameState.running) return;
  
  // Vérifier le jour
  if (gameState.selectedEvent.dayIndex !== col) {
    showConflict(`❌ Mauvais jour ! (${DAY_NAMES[col]} au lieu de ${DAY_NAMES[gameState.selectedEvent.dayIndex]})`);
    loseLife();
    return;
  }
  
  // Vérifier l'heure
  if (row !== gameState.selectedEvent.startRow) {
    showConflict(`❌ Mauvaise heure ! Attendue: ${gameState.selectedEvent.originalTime}`);
    loseLife();
    return;
  }
  
  placeEvent(gameState.selectedEvent, row, col);
}

function placeEvent(evt, row, col) {
  const dur = evt.duration;

  // Vérifier les limites
  if (row + dur > TOTAL_ROWS) {
    showConflict('⛔ Hors des limites !');
    loseLife();
    return;
  }

  // Vérifier les chevauchements
  for (let r = row; r < row + dur; r++) {
    if (gameState.grid[r][col] !== null) {
      showConflict('💥 Chevauchement !');
      loseLife();
      return;
    }
  }

  // Placer l'événement
  for (let r = row; r < row + dur; r++) {
    gameState.grid[r][col] = evt.id;
    const cell = getCell(r, col);
    if (cell) {
      cell.classList.add('occupied');
      if (r === row) {
        const block = document.createElement('div');
        block.className = 't-block';
        block.style.background = evt.color;
        block.style.boxShadow = `0 0 8px ${evt.color}66`;
        block.textContent = evt.name;
        cell.appendChild(block);
      } else {
        const block = document.createElement('div');
        block.className = 't-block';
        block.style.background = evt.color;
        block.style.opacity = '0.75';
        cell.appendChild(block);
      }
    }
  }

  // Calculer le score
  gameState.combo++;
  const speedBonus = Math.max(0, Math.floor(gameState.timeLeft / GAME_DURATION * 50));
  const comboMult = gameState.combo >= 3 ? 2 : 1;
  const dayBonus = 1; // Bonus pour le bon jour
  const pts = (BASE_PTS + speedBonus) * comboMult * dur * dayBonus;
  gameState.score += pts;
  gameState.placed++;

  evt.placed = true;
  gameState.selectedEvent = null;

  const msg = gameState.combo >= 3
    ? `🔥 COMBO x${gameState.combo}! +${pts}pts`
    : `✅ Placé ! +${pts}pts`;
  showToast(msg);

  checkFullRows(row, dur);

  renderHUD();
  renderQueue();
  renderNextCard();
  clearHighlight();

  const remaining = gameState.events.filter(e => !e.placed);
  if (remaining.length === 0) endGame('win');
}

function checkFullRows(startRow, dur) {
  let bonusRows = 0;
  for (let r = startRow; r < startRow + dur && r < TOTAL_ROWS; r++) {
    const rowData = gameState.grid[r];
    if (rowData.every(cell => cell !== null)) {
      bonusRows++;
      for (let c = 0; c < DAYS; c++) {
        const cell = getCell(r, c);
        if (cell) cell.classList.add('row-complete');
      }
    }
  }
  if (bonusRows > 0) {
    gameState.score += bonusRows * 500;
    showToast(`🌟 ${bonusRows} ligne${bonusRows > 1 ? 's' : ''} complète${bonusRows > 1 ? 's' : ''} ! +${bonusRows*500}pts`);
    renderHUD();
  }
}

function loseLife() {
  gameState.combo = 0;
  gameState.lives--;
  renderHUD();
  if (gameState.lives <= 0) endGame('dead');
}

function showConflict(msg) {
  const board = document.getElementById('t-board');
  board.style.animation = 'none';
  void board.offsetWidth;
  board.style.animation = 'tShake 0.4s ease';
  if (!document.querySelector('#shakeStyle')) {
    const st = document.createElement('style');
    st.id = 'shakeStyle';
    st.textContent = '@keyframes tShake{0%,100%{transform:translateX(0)}20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}';
    document.head.appendChild(st);
  }
  showToast(msg, '#f43f5e');
}

function renderQueue() {
  const container = document.getElementById('t-queue');
  if (!container) return;
  
  container.innerHTML = '';
  
  gameState.events.forEach(evt => {
    const el = document.createElement('div');
    el.className = 'q-event' +
      (evt.placed ? ' placed' : '') +
      (gameState.selectedEvent?.id === evt.id ? ' selected' : '');
    el.style.setProperty('--evt-q-color', evt.color);

    const durMin = evt.duration * SLOT_MINS;
    const h = Math.floor(durMin / 60);
    const m = durMin % 60;
    const durLabel = h > 0 ? `${h}h${m > 0 ? m + 'min' : ''}` : `${m}min`;

    el.innerHTML = `
      <div class="q-evt-name">${evt.name}</div>
      <div class="q-evt-time">📅 ${evt.originalDay || '?'} · ⏰ ${evt.originalTime || '?'}</div>
      <span class="q-evt-dur">${durLabel} (${evt.duration} crén.)</span>
    `;
    
    if (!evt.placed) {
      el.addEventListener('click', () => selectEvent(evt));
    }
    container.appendChild(el);
  });
}

function selectEvent(evt) {
  if (!gameState.running) return;
  gameState.selectedEvent = gameState.selectedEvent?.id === evt.id ? null : evt;
  renderQueue();
  renderNextCard();
  clearHighlight();
}

function renderNextCard() {
  const container = document.getElementById('t-next-card');
  if (!container) return;
  
  const evt = gameState.selectedEvent || gameState.events.find(e => !e.placed);
  if (!evt) {
    container.innerHTML = '<div style="color:rgba(165,180,252,0.4);font-size:.75rem;text-align:center;padding:.5rem;">Tous placés!</div>';
    return;
  }
  const durMin = evt.duration * SLOT_MINS;
  const durH = Math.floor(durMin / 60);
  const durM = durMin % 60;
  const durLabel = durH > 0 ? `${durH}h${durM > 0 ? durM + 'min' : ''}` : `${durM}min`;

  container.innerHTML = `
    <div class="next-card-name" style="color:${evt.color}">${evt.name}</div>
    <div class="next-card-time">📅 ${evt.originalDay || '?'} · ⏰ ${evt.originalTime || '?'}</div>
    <span class="next-card-dur">${durLabel} · ${evt.duration} créneaux</span>
  `;
}

function showToast(msg, color) {
  const wrap = document.getElementById('t-board')?.closest('.tetris-board-wrap') || document.getElementById('tetrisModal');
  const toast = document.createElement('div');
  toast.className = 't-toast';
  toast.textContent = msg;
  if (color) toast.style.borderColor = color + '55';
  wrap.style.position = 'relative';
  wrap.appendChild(toast);
  setTimeout(() => toast.remove(), 1300);
}

function endGame(reason) {
  stopTimer();
  gameState.running = false;

  try {
    const prev = parseInt(localStorage.getItem('tetris_best') || '0');
    if (gameState.score > prev) {
      localStorage.setItem('tetris_best', gameState.score);
      document.getElementById('t-best').textContent = gameState.score;
    }
  } catch(e) {}

  const msgEl = document.getElementById('t-message');
  const iconEl = document.getElementById('t-msg-icon');
  const titleEl = document.getElementById('t-msg-title');
  const bodyEl = document.getElementById('t-msg-body');

  const placed = gameState.placed;
  const total = gameState.events.length;

  if (reason === 'win') {
    iconEl.textContent = '🏆';
    titleEl.textContent = 'Parfait !';
    bodyEl.innerHTML = `Tu as placé <strong style="color:#fbbf24">${placed}</strong> événements !<br>Score final : <strong style="color:#a5b4fc">${gameState.score.toLocaleString()} pts</strong>`;
  } else if (reason === 'time') {
    iconEl.textContent = '⏱';
    titleEl.textContent = 'Temps écoulé !';
    bodyEl.innerHTML = `${placed} / ${total} placés<br>Score : <strong style="color:#a5b4fc">${gameState.score.toLocaleString()} pts</strong>`;
  } else {
    iconEl.textContent = '💀';
    titleEl.textContent = 'Game Over !';
    bodyEl.innerHTML = `Plus de vies...<br>Score : <strong style="color:#a5b4fc">${gameState.score.toLocaleString()} pts</strong>`;
  }

  msgEl.style.display = 'flex';
}

// ── INIT ──
document.addEventListener('DOMContentLoaded', function () {

  if (typeof lucide !== 'undefined') lucide.createIcons();

  const dayCells = document.querySelectorAll('.day-cell:not(.empty-cell)');
  dayCells.forEach((cell, i) => {
    cell.style.opacity = '0';
    cell.style.transform = 'translateY(14px)';
    cell.style.transition = 'opacity 0.35s ease, transform 0.35s cubic-bezier(0.16,1,0.3,1)';
    setTimeout(() => {
      cell.style.opacity = '1';
      cell.style.transform = 'translateY(0)';
    }, 40 + i * 12);
  });

  document.querySelectorAll('.stat-tag').forEach(tag => {
    const n = parseInt(tag.textContent);
    if (!isNaN(n) && n > 0) {
      let cur = 0;
      const step = Math.ceil(n / 20);
      const timer = setInterval(() => {
        cur = Math.min(cur + step, n);
        tag.textContent = cur;
        if (cur >= n) clearInterval(timer);
      }, 40);
    }
  });

  dayCells.forEach(cell => {
    cell.addEventListener('click', function (e) {
      const ripple = document.createElement('span');
      const rect = cell.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height);
      ripple.style.cssText = `
        position:absolute; border-radius:50%;
        width:${size}px; height:${size}px;
        left:${e.clientX - rect.left - size/2}px;
        top:${e.clientY - rect.top - size/2}px;
        background:rgba(79,70,229,0.12);
        transform:scale(0); pointer-events:none;
        animation:ripple 0.5s ease-out forwards;
      `;
      if (!document.querySelector('#rippleStyle')) {
        const style = document.createElement('style');
        style.id = 'rippleStyle';
        style.textContent = '@keyframes ripple{to{transform:scale(2.5);opacity:0}}';
        document.head.appendChild(style);
      }
      cell.appendChild(ripple);
      setTimeout(() => ripple.remove(), 500);
    });
  });

  // Initialiser la mascotte avec chargement depuis localStorage
  console.log('Init mascotte...');
  
  // Essayer de charger depuis localStorage d'abord
  const saved = loadMascotStats();
  if (saved.streak > 0) {
    console.log('Stats chargées depuis localStorage:', saved);
  }
  
  // Première mise à jour après un délai
  setTimeout(() => {
    updateMascot();
  }, 500);

  document.getElementById('tetrisModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeTetris();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && document.getElementById('tetrisModal')?.style.display !== 'none') {
      closeTetris();
    }
  });

  // Mise à jour périodique plus fréquente (toutes les 10 secondes)
  setInterval(updateMascot, 10000);

  // Vérifier les flashes de feedback
  {% set feedbackSuccess = app.flashes('feedback_success') %}
  {% if feedbackSuccess|length > 0 %}
      {% set feedbackValues = app.flashes('feedback_value')|default([]) %}
      {% set feedbackTitles = app.flashes('feedback_title')|default([]) %}
      
      {% for key, message in feedbackSuccess %}
          {% set feedbackValue = feedbackValues[key] is defined ? feedbackValues[key] : 3 %}
          {% set feedbackTitle = feedbackTitles[key] is defined ? feedbackTitles[key]|escape('js') : 'Session' %}
          
          setTimeout(() => {
              showFeedbackAnimation({{ message }}, {{ feedbackValue }}, "{{ feedbackTitle|raw }}");
              animateFeedbackIcon({{ message }}, {{ feedbackValue }});
              setTimeout(() => {
                  updateMascot();
              }, 1000);
          }, 500);
      {% endfor %}
  {% endif %}

});

// Forcer une mise à jour quand la page est chargée depuis le cache
window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
        console.log('Page chargée depuis le cache, mise à jour de la mascotte...');
        setTimeout(() => {
            updateMascot();
        }, 500);
    }
});

// Mettre à jour la mascotte quand l'onglet redevient actif
document.addEventListener('visibilitychange', function() {
    if (!document.hidden) {
        console.log('Onglet réactivé, mise à jour de la mascotte...');
        updateMascot();
    }
});
</script>
</body>
{% endblock %}