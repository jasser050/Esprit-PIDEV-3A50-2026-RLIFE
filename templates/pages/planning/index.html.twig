{% extends 'base.html.twig' %}

{% block title %}Planning{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Schedule</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Manage your schedule and events</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="{{ path('app_planning_new') }}" class="btn btn-primary">
                <i data-lucide="plus" class="w-5 h-5"></i>
                Add Event
            </a>

            <a href="{{ path('app_seance_index') }}" class="btn btn-primary">
                <i data-lucide="file-plus" class="w-5 h-5"></i>
                Manage Session
            </a>

            <a href="{{ path('app_type_seance_index') }}" class="btn btn-primary">
                <i data-lucide="file-plus" class="w-5 h-5"></i>
                Manage Types of Session
            </a>
            
            <a href="{{ path('app_planning_week', { date: today }) }}"
               class="btn btn-secondary btn-sm"
               title="Week view">
                Week
            </a>
        </div>
    </div>

    {# Notification pour feedbacks en attente #}
    {% set pending_feedback = [] %}
    {% for date, day_events in events_by_date %}
        {% if date < today %}
            {% for event in day_events %}
                {% if not event.is_google and event.feedback is null %}
                    {% set pending_feedback = pending_feedback|merge([event]) %}
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if pending_feedback|length > 0 %}
        <div class="alert alert-warning">
            <i data-lucide="message-square" class="w-5 h-5 alert-icon"></i>
            <div class="flex-1">
                <p class="font-medium">You have {{ pending_feedback|length }} session(s) waiting for feedback</p>
                <p class="text-sm mt-0.5">Help us improve by sharing your experience!</p>
            </div>
            <button onclick="openFeedbackModal({{ pending_feedback[0].id }}, '{{ pending_feedback[0].title|e('js') }}')" 
                    class="btn btn-sm btn-primary">
                Give Feedback
            </button>
        </div>
    {% endif %}

    {% if conflicts is defined and conflicts|length > 0 %}
        <div class="alert alert-warning">
            <i data-lucide="alert-triangle" class="w-5 h-5 alert-icon"></i>
            <div>
                <p class="font-medium">Scheduling Conflicts Detected</p>
                <p class="text-sm mt-0.5">You have {{ conflicts|length }} event(s) with time conflicts. Review your schedule.</p>
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Calendar -->
        <div class="lg:col-span-3 card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                            <i data-lucide="calendar" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                        </div>
                        <h2 class="text-xl font-semibold text-secondary-900 dark:text-white">
                            {{ (current_year ~ '-' ~ current_month ~ '-01')|date('F Y') }}
                        </h2>
                    </div>

                    <div class="flex items-center gap-2">
                        {% set prev_month = current_month == 1 ? 12 : current_month - 1 %}
                        {% set prev_year = current_month == 1 ? current_year - 1 : current_year %}
                        {% set next_month = current_month == 12 ? 1 : current_month + 1 %}
                        {% set next_year = current_month == 12 ? current_year + 1 : current_year %}

                        <a href="{{ path('app_planning', {month: prev_month, year: prev_year}) }}"
                           class="btn btn-ghost btn-icon"
                           title="Previous month">
                            <i data-lucide="chevron-left" class="w-5 h-5"></i>
                        </a>

                        <a href="{{ path('app_planning') }}" class="btn btn-secondary btn-sm" title="Go to current month">
                            Today
                        </a>

                        <a href="{{ path('app_planning', {month: next_month, year: next_year}) }}"
                           class="btn btn-ghost btn-icon"
                           title="Next month">
                            <i data-lucide="chevron-right" class="w-5 h-5"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="p-4">
                <div class="calendar-grid">
                    {% for day in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] %}
                        <div class="calendar-cell-header">{{ day }}</div>
                    {% endfor %}

                    {% for i in 1..(first_day_of_week - 1) %}
                        <div class="calendar-cell bg-secondary-50/50 dark:bg-secondary-900/30"></div>
                    {% endfor %}

                    {% for day in 1..days_in_month %}
                        {% set date = current_year ~ '-' ~ (current_month < 10 ? '0' ~ current_month : current_month) ~ '-' ~ (day < 10 ? '0' ~ day : day) %}
                        {% set day_events = events_by_date[date] ?? [] %}
                        {% set is_today = date == today %}

                        <div class="calendar-cell {{ is_today ? 'ring-2 ring-primary-500 ring-inset' : '' }}">
                            <div class="flex items-center justify-between mb-2">
                                <span class="calendar-day-number {{ is_today ? 'today' : '' }}">{{ day }}</span>
                                {% if day_events|length > 0 %}
                                    <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
                                {% endif %}
                            </div>

                            <div class="space-y-2">
                                {% for event in day_events|slice(0, 4) %}
                                    {% if event.is_google|default(false) %}
                                        <div class="rounded-lg px-2 py-1
                                                    {{ event.ui.bg|default('bg-indigo-100 dark:bg-indigo-900/30') }}
                                                    hover:shadow transition-all flex flex-col group opacity-70 pointer-events-none">
                                            <span class="text-xs font-bold text-primary-700 dark:text-primary-400 leading-4">
                                                {{ event.start_time }}
                                                {% if event.end_time %}–{{ event.end_time }}{% endif %}
                                            </span>
                                            <span class="text-xs font-semibold text-secondary-900 dark:text-white truncate">
                                                {{ event.title }}
                                            </span>
                                            <span class="text-2xs text-green-800 dark:text-green-200">
                                                (Google)
                                            </span>
                                        </div>
                                    {% else %}
                                        {% set is_past = event.date < today or (event.date == today and event.end_time < 'now'|date('H:i')) %}
                                        {% set needs_feedback = is_past and event.feedback is null %}
                                        
                                        <a href="{{ path('app_planning_edit', {id: event.id}) }}"
                                           class="rounded-lg px-2 py-1 relative
                                                  {{ event.ui.bg|default('bg-indigo-100 dark:bg-indigo-900/30') }}
                                                  {{ event.conflict ?? false ? 'ring-1 ring-danger-500' : '' }}
                                                  hover:shadow transition-all cursor-pointer flex flex-col group"
                                           title="Edit event">
                                            
                                            {# Badge Feedback needed #}
                                            {% if needs_feedback %}
                                                <span class="absolute -top-1 -right-1 w-2 h-2 bg-orange-500 rounded-full animate-pulse"></span>
                                            {% endif %}
                                            
                                            <span class="text-xs font-bold text-primary-700 dark:text-primary-400 leading-4">
                                                {{ event.start_time }}
                                                {% if event.end_time %}–{{ event.end_time }}{% endif %}
                                            </span>
                                            <span class="text-xs font-semibold text-secondary-900 dark:text-white group-hover:underline truncate">
                                                {{ event.title }}
                                            </span>
                                            
                                            {# Bouton feedback pour les séances passées #}
                                            {% if needs_feedback %}
                                                <button onclick="event.preventDefault(); event.stopPropagation(); openFeedbackModal({{ event.id }}, '{{ event.title|e('js') }}')"
                                                        class="mt-1 text-2xs bg-orange-500 text-white px-2 py-0.5 rounded hover:bg-orange-600 transition-colors">
                                                    Give Feedback
                                                </button>
                                            {% elseif event.feedback %}
                                                <div class="mt-1 text-2xs flex items-center gap-1">
                                                    <span>{{ ['😡', '😕', '😐', '🙂', '🤩'][event.feedback - 1] }}</span>
                                                </div>
                                            {% endif %}
                                        </a>
                                    {% endif %}
                                {% else %}
                                    <div class="text-2xs text-secondary-400 italic text-center pt-4">
                                        —
                                    </div>
                                {% endfor %}
                                
                                {% if day_events|length > 4 %}
                                    <div class="text-2xs text-secondary-500 dark:text-secondary-400 text-center pt-1">
                                        +{{ day_events|length - 4 }} more
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-5">
            <!-- Upcoming Events -->
            <div class="card overflow-hidden">
                <div class="p-4 border-b border-secondary-200 dark:border-secondary-800">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                            <i data-lucide="calendar-clock" class="w-5 h-5 text-accent-500"></i>
                            <h3 class="font-semibold text-secondary-900 dark:text-white">Upcoming</h3>
                        </div>

                        <span class="text-xs text-secondary-500 dark:text-secondary-400">
                            {{ upcoming_total|default(0) }}
                        </span>
                    </div>

                    <form method="get" action="{{ path('app_planning') }}" class="mt-3 grid grid-cols-1 gap-2">
                        <input type="hidden" name="month" value="{{ current_month }}">
                        <input type="hidden" name="year" value="{{ current_year }}">

                        <div class="flex gap-2">
                            <input
                                type="text"
                                name="up_q"
                                value="{{ upcoming_q|default('') }}"
                                placeholder="Search upcoming..."
                                class="input input-sm w-full"
                            >

                            <select name="up_sort" class="input input-sm" onchange="this.form.submit()">
                                <option value="date_asc"  {% if up_sort|default('date_asc') == 'date_asc' %}selected{% endif %}>Date ↑</option>
                                <option value="date_desc" {% if up_sort|default('date_asc') == 'date_desc' %}selected{% endif %}>Date ↓</option>
                                <option value="title_asc" {% if up_sort|default('date_asc') == 'title_asc' %}selected{% endif %}>Title A→Z</option>
                            </select>
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <input type="date" name="up_start" value="{{ up_start|default('') }}" class="input input-sm w-full">
                            <input type="date" name="up_end" value="{{ up_end|default('') }}" class="input input-sm w-full">
                        </div>

                        <div class="flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm w-full">Apply</button>

                            <a class="btn btn-secondary btn-sm"
                               href="{{ path('app_planning', {month: current_month, year: current_year}) }}"
                               title="Reset">
                                Reset
                            </a>
                        </div>
                    </form>
                </div>

                <div class="p-3 max-h-[70vh] overflow-y-auto flex flex-col gap-2">
                    {% for event in upcoming|default([]) %}
                        {% if event.is_google|default(false) %}
                            <div class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors">
                                <div class="w-1 h-10 rounded-full {{ event.ui.bar|default('bg-green-500') }} flex-shrink-0"></div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-medium text-sm text-secondary-900 dark:text-white truncate">{{ event.title }}</p>
                                    <p class="text-xs text-secondary-500 dark:text-secondary-400 flex items-center gap-1 mt-0.5">
                                        <i data-lucide="calendar" class="w-3 h-3"></i>
                                        {{ event.date|date('M j') }} at {{ event.start_time }}
                                        <span class="ml-2 text-green-600 dark:text-green-300">(Google)</span>
                                    </p>
                                </div>
                            </div>
                        {% else %}
                            <a href="{{ path('app_planning_edit', {id: event.id}) }}"
                               class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors {{ event.conflict ?? false ? 'ring-1 ring-danger-500' : '' }}">
                                <div class="w-1 h-10 rounded-full {{ event.ui.bar|default('bg-primary-500') }} flex-shrink-0"></div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-medium text-sm text-secondary-900 dark:text-white truncate">{{ event.title }}</p>
                                    <p class="text-xs text-secondary-500 dark:text-secondary-400 flex items-center gap-1 mt-0.5">
                                        <i data-lucide="calendar" class="w-3 h-3"></i>
                                        {{ event.date|date('M j') }} at {{ event.start_time }}
                                    </p>
                                </div>
                            </a>
                        {% endif %}
                    {% else %}
                        <div class="empty-state py-6">
                            <i data-lucide="calendar-off" class="w-8 h-8 text-secondary-300 dark:text-secondary-600"></i>
                            <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-2">
                                {% if upcoming_q|default('') %}
                                    No results for "{{ upcoming_q }}"
                                {% else %}
                                    No upcoming events
                                {% endif %}
                            </p>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="card p-4">
                <div class="flex items-center gap-3 mb-3">
                    <i data-lucide="bar-chart-3" class="w-5 h-5 text-secondary-400"></i>
                    <h3 class="font-semibold text-secondary-900 dark:text-white">This Month</h3>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-secondary-500 dark:text-secondary-400">Total Events</span>
                        <span class="font-semibold text-secondary-900 dark:text-white">
                            {{ events_by_date|reduce((carry, v) => carry + v|length, 0) }}
                        </span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-sm text-secondary-500 dark:text-secondary-400">Classes</span>
                        <span class="badge badge-primary badge-pill">
                            {{ events_by_date|reduce((carry, v) => carry + v|filter(e => e.type == 'class')|length, 0) }}
                        </span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="text-sm text-secondary-500 dark:text-secondary-400">Exams</span>
                        <span class="badge badge-danger badge-pill">
                            {{ events_by_date|reduce((carry, v) => carry + v|filter(e => e.type == 'exam')|length, 0) }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if google_events_count is defined %}
        <div class="alert alert-info mb-4">
            Google events loaded: {{ google_events_count }}
            {% if google_load_error %}
                <div class="text-sm mt-1">Google load error: {{ google_load_error }}</div>
            {% endif %}
        </div>
    {% endif %}
</div>

{# Modal de feedback SIMPLIFIÉ #}
<div id="feedbackModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center">
    <div class="bg-white dark:bg-secondary-800 rounded-2xl shadow-2xl max-w-md w-full mx-4 p-6 animate-scale-in">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-secondary-900 dark:text-white">Session Feedback</h3>
            <button onclick="closeFeedbackModal()" class="text-secondary-400 hover:text-secondary-600 dark:hover:text-secondary-200">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>

        <div id="feedbackContent">
            <p class="text-secondary-600 dark:text-secondary-300 mb-6 text-center">
                How was your session: <br><strong id="sessionTitle" class="text-lg"></strong>?
            </p>

            <form id="feedbackForm" method="post">
                <div class="space-y-3">
                    <label class="feedback-option">
                        <input type="radio" name="feedback" value="1" required>
                        <span class="feedback-label">😡 Very Bad</span>
                    </label>
                    <label class="feedback-option">
                        <input type="radio" name="feedback" value="2" required>
                        <span class="feedback-label">😕 Bad</span>
                    </label>
                    <label class="feedback-option">
                        <input type="radio" name="feedback" value="3" required>
                        <span class="feedback-label">😐 Neutral</span>
                    </label>
                    <label class="feedback-option">
                        <input type="radio" name="feedback" value="4" required>
                        <span class="feedback-label">🙂 Good</span>
                    </label>
                    <label class="feedback-option">
                        <input type="radio" name="feedback" value="5" required>
                        <span class="feedback-label">🤩 Excellent</span>
                    </label>
                </div>

                <div class="flex gap-3 mt-6">
                    <button type="submit" class="btn btn-primary flex-1">
                        <i data-lucide="send" class="w-4 h-4"></i>
                        Submit Feedback
                    </button>
                    <button type="button" onclick="closeFeedbackModal()" class="btn btn-secondary">
                        Cancel
                    </button>
                </div>
            </form>
        </div>

        <div id="feedbackSuccess" class="hidden text-center py-8">
            <div class="text-6xl mb-4">✅</div>
            <p class="text-lg font-semibold text-secondary-900 dark:text-white mb-2">
                Thank you for your feedback!
            </p>
            <p class="text-secondary-600 dark:text-secondary-400 mb-4">
                Your input helps us improve.
            </p>
            <button onclick="closeFeedbackModal()" class="btn btn-primary">
                Close
            </button>
        </div>
    </div>
</div>

<script>
let currentPlanningId = null;

function openFeedbackModal(planningId, title) {
    currentPlanningId = planningId;
    document.getElementById('sessionTitle').textContent = title;
    document.getElementById('feedbackForm').action = `/planning/${planningId}/feedback`;
    document.getElementById('feedbackModal').classList.remove('hidden');
    document.getElementById('feedbackModal').classList.add('flex');
    document.getElementById('feedbackContent').classList.remove('hidden');
    document.getElementById('feedbackSuccess').classList.add('hidden');
    
    // Réinitialiser le formulaire
    document.getElementById('feedbackForm').reset();
    
    // Réinitialiser les icônes Lucide si nécessaire
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
}

function closeFeedbackModal() {
    document.getElementById('feedbackModal').classList.add('hidden');
    document.getElementById('feedbackModal').classList.remove('flex');
    currentPlanningId = null;
}

// Fermer le modal en cliquant à l'extérieur
document.getElementById('feedbackModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
        closeFeedbackModal();
    }
});

// Fermer avec la touche Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !document.getElementById('feedbackModal').classList.contains('hidden')) {
        closeFeedbackModal();
    }
});

// Soumettre le feedback via AJAX
document.getElementById('feedbackForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    // Vérifier qu'un emoji est sélectionné
    const selectedFeedback = formData.get('feedback');
    if (!selectedFeedback) {
        alert('Please select a feedback emoji');
        return;
    }
    
    try {
        const response = await fetch(this.action, {
            method: 'POST',
            body: formData
        });
        
        const data = await response.json();
        
        if (response.ok && data.success) {
            // Afficher le message de succès
            document.getElementById('feedbackContent').classList.add('hidden');
            document.getElementById('feedbackSuccess').classList.remove('hidden');
            
            // Réinitialiser les icônes dans le message de succès
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
            
            // Actualiser la page après 2 secondes
            setTimeout(() => {
                window.location.reload();
            }, 2000);
        } else {
            alert(data.error || 'Error submitting feedback. Please try again.');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error submitting feedback. Please try again.');
    }
});
</script>
{% endblock %}