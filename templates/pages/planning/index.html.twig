// Sauvegarder les stats dans localStorage pour persistance
function saveMascotStats(streak, avgFeedback) {
    try {
        localStorage.setItem('mascot_streak', streak);
        localStorage.setItem('mascot_avg_feedback', avgFeedback || '');
        localStorage.setItem('mascot_last_update', Date.now().toString());
        console.log('Stats mascotte sauvegardées:', { streak, avgFeedback });
    } catch(e) {
        console.error('Erreur sauvegarde mascotte:', e);
    }
}

function loadMascotStats() {
    try {
        const streak = parseInt(localStorage.getItem('mascot_streak') || '0');
        const avgFeedback = localStorage.getItem('mascot_avg_feedback') || null;
        const lastUpdate = parseInt(localStorage.getItem('mascot_last_update') || '0');
        
        // Si la dernière mise à jour date de plus de 24h, réinitialiser
        if (Date.now() - lastUpdate > 24 * 60 * 60 * 1000) {
            console.log('Stats mascotte expirées (24h)');
            return { streak: 0, avgFeedback: null };
        }
        
        console.log('Stats mascotte chargées:', { streak, avgFeedback });
        return { 
            streak: streak, 
            avgFeedback: avgFeedback ? parseFloat(avgFeedback) : null 
        };
    } catch(e) {
        console.error('Erreur chargement mascotte:', e);
        return { streak: 0, avgFeedback: null };
    }
}

function calculateStats() {
    try {
        const eventsData = {{ events_by_date|json_encode|raw }};
        const today = "{{ today }}";
        
        console.log('=== Calcul des statistiques ===');
        console.log('Events data:', eventsData);
        console.log('Today:', today);
        
        let streak = 0;
        let feedbackSum = 0;
        let feedbackCount = 0;
        let currentDate = new Date(today);
        
        // Parcourir les 30 derniers jours max
        let daysChecked = 0;
        const maxDays = 30;
        
        while (daysChecked < maxDays) {
            const dateStr = currentDate.toISOString().split('T')[0];
            
            // Vérifier si on a des événements pour cette date
            if (eventsData[dateStr] && eventsData[dateStr].length > 0) {
                const events = eventsData[dateStr];
                
                // Vérifier si c'est un jour de repos (Day Off)
                const dayOff = events.filter(e => e.title && e.title.toLowerCase() === 'day off');
                
                if (dayOff.length > 0) {
                    console.log('Jour de repos (Day Off) trouvé à:', dateStr, '- Arrêt du streak');
                    break;
                }
                
                // Jour normal avec des séances
                streak++;
                console.log('Jour avec événements:', dateStr, 'streak:', streak);
                
                // Compter les feedbacks pour ce jour
                events.forEach(event => {
                    if (event.feedback && !isNaN(event.feedback) && event.feedback > 0) {
                        feedbackSum += parseInt(event.feedback);
                        feedbackCount++;
                        console.log('Feedback trouvé:', event.feedback, 'pour', event.title);
                    }
                });
                
                // Passer au jour précédent
                currentDate.setDate(currentDate.getDate() - 1);
                daysChecked++;
            } else {
                // Jour sans événements, on arrête
                console.log('Jour sans événements:', dateStr, '- Arrêt du streak');
                break;
            }
        }
        
        const avgFeedback = feedbackCount > 0 ? (feedbackSum / feedbackCount).toFixed(1) : null;
        
        console.log('Résultat final - Streak:', streak, 'Moyenne feedback:', avgFeedback, 'Nombre feedbacks:', feedbackCount);
        console.log('=== Fin calcul ===');
        
        // Sauvegarder dans localStorage
        saveMascotStats(streak, avgFeedback);
        
        return { streak, avgFeedback };
    } catch (error) {
        console.error('Erreur calcul stats:', error);
        // En cas d'erreur, essayer de charger depuis localStorage
        return loadMascotStats();
    }
}

function getNextLevelStreak(currentLevel) {
    const levels = [0, 4, 8, 15, 30];
    return levels[currentLevel] || null;
}

function addSparkles() {
    const container = document.getElementById('mascotSparkles');
    if (container) {
        container.innerHTML = `
            <div class="sparkle">✨</div>
            <div class="sparkle">⭐</div>
            <div class="sparkle">💫</div>
            <div class="sparkle">✨</div>
        `;
    }
}

function updateMascot() {
    console.log('=== MISE À JOUR MASCOTTE ===');
    try {
        const { streak, avgFeedback } = calculateStats();
        console.log('Stats calculées:', { streak, avgFeedback });
        
        // Vérifier que les éléments existent
        const mascotEmoji = document.getElementById('mascotEmoji');
        const mascotLevel = document.getElementById('mascotLevel');
        const mascotName = document.getElementById('mascotName');
        const streakDays = document.getElementById('streakDays');
        const avgMoodScore = document.getElementById('avgMoodScore');
        const mascotMood = document.getElementById('mascotMood');
        const mascotMessage = document.getElementById('mascotMessage');
        const mascotProgress = document.getElementById('mascotProgress');
        const mascotSparkles = document.getElementById('mascotSparkles');
        
        if (!mascotEmoji || !mascotLevel || !mascotName || !streakDays) {
            console.error('Éléments mascotte non trouvés');
            return;
        }
        
        // Determine state based on streak
        let state = mascotStates.beginner;
        for (const key in mascotStates) {
            const s = mascotStates[key];
            if (streak >= s.minStreak) {
                state = s;
            }
        }
        
        console.log('État déterminé:', state.name);
        
        // Update UI
        mascotEmoji.textContent = state.emoji;
        mascotLevel.textContent = state.level;
        mascotName.textContent = state.name;
        streakDays.textContent = streak;
        
        // Update mood
        if (avgFeedback !== null && avgMoodScore) {
            const moodEmoji = avgFeedback >= 4.5 ? moodEmojis[5] :
                             avgFeedback >= 3.5 ? moodEmojis[4] :
                             avgFeedback >= 2.5 ? moodEmojis[3] :
                             avgFeedback >= 1.5 ? moodEmojis[2] : moodEmojis[1];
            avgMoodScore.textContent = avgFeedback + ' ' + moodEmoji;
        } else if (avgMoodScore) {
            avgMoodScore.textContent = '- 😊';
        }
        
        // Update mood message
        let moodPrefix = '';
        if (avgFeedback !== null) {
            if (avgFeedback >= 4) moodPrefix = "Crushing it! ";
            else if (avgFeedback >= 3) moodPrefix = "Good vibes! ";
            else if (avgFeedback >= 2) moodPrefix = "Keep going! ";
            else moodPrefix = "Take care! ";
        }
        
        if (mascotMood) {
            mascotMood.textContent = moodPrefix + (avgFeedback !== null ? `(${avgFeedback}/5)` : '');
        }
        
        // Random message
        if (mascotMessage) {
            const randomMessage = state.messages[Math.floor(Math.random() * state.messages.length)];
            mascotMessage.textContent = randomMessage;
        }
        
        // Progress bar
        if (mascotProgress) {
            const nextLevelStreak = getNextLevelStreak(state.level);
            const progress = nextLevelStreak ? Math.min(100, (streak / nextLevelStreak) * 100) : 100;
            mascotProgress.style.width = progress + '%';
        }
        
        // Sparkles for high performers
        if (streak >= 7 || (avgFeedback !== null && avgFeedback >= 4)) {
            addSparkles();
        } else if (mascotSparkles) {
            mascotSparkles.innerHTML = '';
        }
        
        console.log('Mascotte mise à jour avec succès');
    } catch (error) {
        console.error('Erreur mise à jour mascotte:', error);
    }
    console.log('=== FIN MISE À JOUR ===');
}

function pulseMascot() {
    const mascotEmoji = document.getElementById('mascotEmoji');
