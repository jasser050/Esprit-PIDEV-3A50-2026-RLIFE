{% extends 'base.html.twig' %}

{% block title %}Planning — Calendar{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;0,9..144,700;1,9..144,400&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════
   PLANNING — LIGHT MODE DESIGN SYSTEM
   Clean · Airy · Professional · Maximized
══════════════════════════════════════════ */
:root {
  /* Base */
  --bg-root:        #f4f6fb;
  --bg-card:        #ffffff;
  --bg-subtle:      #f8faff;
  --bg-muted:       #f0f3fa;

  /* Borders */
  --border-light:   #e4e9f5;
  --border-medium:  #d0d8ef;

  /* Brand */
  --primary:         #4f46e5;
  --primary-light:   #eef0ff;
  --primary-mid:     #c7d2fe;
  --secondary:       #7c3aed;
  --rose:           #f43f5e;
  --emerald:        #10b981;
  --amber:          #f59e0b;
  --sky:            #0ea5e9;
  --google-green:   #34a853;
  --danger:         #ef4444;

  /* Gray */
  --gray-50:        #f9fafb;
  --gray-100:       #f3f4f6;
  --gray-200:       #e5e7eb;
  --gray-300:       #d1d5db;
  --gray-400:       #9ca3af;
  --gray-500:       #6b7280;
  --gray-600:       #4b5563;
  --gray-700:       #374151;
  --gray-800:       #1f2937;
  --gray-900:       #111827;

  /* Gradients */
  --grad-brand:     linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  --grad-rose:      linear-gradient(135deg, #f43f5e 0%, #f97316 100%);
  --grad-emerald:   linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
  --grad-amber:     linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);

  /* Text */
  --text-primary:   #0f172a;
  --text-secondary: #475569;
  --text-muted:     #94a3b8;
  --text-brand:     #4f46e5;

  /* Fonts */
  --font-display:   'Fraunces', Georgia, serif;
  --font-body:      'Sora', system-ui, sans-serif;

  /* Radius */
  --r-sm:  6px;
  --r-md:  12px;
  --r-lg:  18px;
  --r-xl:  24px;

  /* Shadows */
  --shadow-xs:  0 1px 3px rgba(15,23,42,0.06), 0 1px 2px rgba(15,23,42,0.04);
  --shadow-sm:  0 2px 8px rgba(15,23,42,0.08), 0 1px 3px rgba(15,23,42,0.05);
  --shadow-md:  0 4px 16px rgba(15,23,42,0.1), 0 2px 6px rgba(15,23,42,0.06);
  --shadow-lg:  0 8px 32px rgba(15,23,42,0.12), 0 4px 12px rgba(15,23,42,0.07);
  --shadow-brand: 0 4px 16px rgba(79,70,229,0.25);
}

/* ══ RESET ══ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body.planning-body {
  background: var(--bg-root);
  color: var(--text-primary);
  font-family: var(--font-body);
  min-height: 100vh;
  font-size: 14px;
  line-height: 1.5;
}

/* Subtle grid texture */
body.planning-body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  background-image: radial-gradient(circle at 1px 1px, rgba(79,70,229,0.035) 1px, transparent 0);
  background-size: 28px 28px;
  pointer-events: none;
}

/* ══ LAYOUT ══ */
.planner-wrap {
  position: relative;
  z-index: 1;
  max-width: 1600px;
  margin: 0 auto;
  padding: 2rem 1.75rem 4rem;
}

/* ══════════════════════════════════════════
   PAGE HEADER
══════════════════════════════════════════ */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.25rem;
  margin-bottom: 1.75rem;
  padding-bottom: 1.5rem;
  border-bottom: 2px solid var(--border-light);
  position: relative;
  animation: fadeUp 0.5s ease both;
}
.page-header::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 80px;
  height: 2px;
  background: var(--grad-brand);
  border-radius: 2px;
}
.header-left {}
.header-eyebrow {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-brand);
  margin-bottom: 0.4rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.header-eyebrow::before {
  content: '';
  width: 18px;
  height: 2px;
  background: var(--grad-brand);
  border-radius: 2px;
}
.header-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.header-title span {
  background: var(--grad-brand);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.header-sub {
  color: var(--text-secondary);
  font-size: 0.85rem;
  margin-top: 0.3rem;
}
.header-actions {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  align-items: center;
}

/* ══ BUTTONS ══ */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.6rem 1.2rem;
  border-radius: var(--r-md);
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.8rem;
  text-decoration: none;
  cursor: pointer;
  border: none;
  white-space: nowrap;
  transition: all 0.2s cubic-bezier(0.16,1,0.3,1);
}
.btn-primary {
  background: var(--grad-brand);
  color: #fff;
  box-shadow: var(--shadow-brand);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(79,70,229,0.38); }
.btn-outline {
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1.5px solid var(--border-light);
  box-shadow: var(--shadow-xs);
}
.btn-outline:hover {
  border-color: var(--primary-mid);
  color: var(--primary);
  background: var(--primary-light);
  transform: translateY(-1px);
}
.btn-sm { padding: 0.45rem 0.9rem; font-size: 0.75rem; }

/* ══════════════════════════════════════════
   QUOTE STRIP
══════════════════════════════════════════ */
.quote-strip {
  background: var(--bg-card);
  border: 1.5px solid var(--border-light);
  border-left: 4px solid var(--primary);
  border-radius: var(--r-lg);
  padding: 1rem 1.5rem;
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  box-shadow: var(--shadow-xs);
  animation: fadeUp 0.5s 0.1s ease both;
}
.quote-icon {
  font-size: 1.8rem;
  color: var(--primary-mid);
  flex-shrink: 0;
  line-height: 1;
}
.quote-text {
  font-family: var(--font-display);
  font-style: italic;
  color: var(--text-secondary);
  font-size: 0.92rem;
  line-height: 1.5;
}
.quote-author {
  color: var(--primary);
  font-size: 0.78rem;
  font-weight: 600;
  margin-top: 0.2rem;
}

/* ══════════════════════════════════════════
   ALERTS
══════════════════════════════════════════ */
.alert-banner {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1rem 1.5rem;
  border-radius: var(--r-lg);
  margin-bottom: 1.25rem;
  animation: fadeUp 0.5s 0.15s ease both;
  box-shadow: var(--shadow-xs);
}
.alert-feedback {
  background: var(--primary-light);
  border: 1.5px solid var(--primary-mid);
}
.alert-conflict {
  background: #fff5f7;
  border: 1.5px solid #fecdd3;
}
.alert-icon-wrap {
  flex-shrink: 0;
  width: 34px; height: 34px;
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  margin-top: 0.1rem;
}
.alert-feedback .alert-icon-wrap { background: var(--primary-mid); }
.alert-conflict .alert-icon-wrap { background: #fecdd3; }
.alert-title {
  font-weight: 700;
  color: var(--text-primary);
  font-size: 0.88rem;
  margin-bottom: 0.2rem;
}
.alert-sub { color: var(--text-secondary); font-size: 0.8rem; }
.alert-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
.alert-chip {
  display: inline-flex; align-items: center; gap: 0.35rem;
  background: #fff;
  border: 1.5px solid var(--primary-mid);
  border-radius: 999px;
  padding: 0.3rem 0.85rem;
  font-size: 0.75rem; font-weight: 600;
  color: var(--primary);
  text-decoration: none;
  transition: all 0.2s;
}
.alert-chip:hover {
  background: var(--grad-brand);
  color: #fff;
  border-color: transparent;
  transform: translateY(-1px);
}

/* ══════════════════════════════════════════
   MAIN LAYOUT — MAXIMIZED CALENDAR
══════════════════════════════════════════ */
.main-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 1.5rem;
  align-items: start;
  animation: fadeUp 0.5s 0.2s ease both;
}
@media (max-width: 1100px) {
  .main-layout { grid-template-columns: 1fr; }
}

/* ══════════════════════════════════════════
   CALENDAR CARD
══════════════════════════════════════════ */
.calendar-wrap {
  background: var(--bg-card);
  border: 1.5px solid var(--border-light);
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

/* ── Calendar Header ── */
.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  padding: 1.25rem 1.75rem;
  border-bottom: 1.5px solid var(--border-light);
  background: var(--bg-subtle);
}
.cal-month-block {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.cal-month-icon {
  width: 48px; height: 48px;
  border-radius: var(--r-md);
  background: var(--grad-brand);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.3rem;
  box-shadow: var(--shadow-brand);
  flex-shrink: 0;
}
.cal-month-name {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.1;
  letter-spacing: -0.01em;
}
.cal-event-count {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-top: 0.2rem;
}
.cal-event-count strong { color: var(--primary); font-weight: 700; }
.cal-nav { display: flex; align-items: center; gap: 0.5rem; }
.cal-nav-btn {
  width: 36px; height: 36px;
  border-radius: var(--r-sm);
  background: var(--bg-card);
  border: 1.5px solid var(--border-light);
  color: var(--text-secondary);
  display: flex; align-items: center; justify-content: center;
  text-decoration: none;
  transition: all 0.2s;
  box-shadow: var(--shadow-xs);
}
.cal-nav-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-light);
  transform: scale(1.05);
}
.cal-nav-today {
  padding: 0 1rem;
  width: auto;
  font-size: 0.7rem;
  font-weight: 700;
  font-family: var(--font-body);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--grad-brand);
  color: #fff;
  border: none;
  box-shadow: var(--shadow-brand);
}
.cal-nav-today:hover {
  transform: scale(1.05);
  box-shadow: 0 4px 16px rgba(79,70,229,0.4);
}

/* ── Calendar Grid ── */
.cal-grid-wrap { padding: 1.25rem 1.5rem 1.5rem; }
.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.6rem;
}
.weekday-label {
  text-align: center;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding: 0.4rem 0 0.75rem;
}

/* ══ DAY CELL — KEY PIECE, MAXIMIZED ══ */
.day-cell {
  background: var(--bg-card);
  border: 1.5px solid var(--border-light);
  border-radius: var(--r-md);
  padding: 0.75rem 0.7rem;
  min-height: 155px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: all 0.22s cubic-bezier(0.16,1,0.3,1);
  position: relative;
  cursor: pointer;
}
.day-cell.empty-cell {
  background: transparent;
  border-color: transparent;
  pointer-events: none;
}
.day-cell:not(.empty-cell):hover {
  border-color: var(--primary-mid);
  background: #fafbff;
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
  overflow-y: auto;
  z-index: 2;
}
.day-cell.is-today {
  background: var(--primary-light);
  border: 2px solid var(--primary);
  box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
}
.day-cell.is-weekend { background: var(--bg-subtle); }

/* Custom scrollbar for hovered cell */
.day-cell::-webkit-scrollbar { width: 3px; }
.day-cell::-webkit-scrollbar-track { background: transparent; }
.day-cell::-webkit-scrollbar-thumb { background: var(--primary-mid); border-radius: 999px; }

.cell-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.6rem;
  flex-shrink: 0;
}
.day-num {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-secondary);
  width: 28px; height: 28px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
  flex-shrink: 0;
}
.day-num.today-num {
  background: var(--grad-brand);
  color: #fff;
  box-shadow: var(--shadow-brand);
}
.evt-pill {
  font-size: 0.6rem;
  font-weight: 700;
  background: var(--primary-light);
  color: var(--primary);
  padding: 0.15rem 0.55rem;
  border-radius: 999px;
  border: 1px solid var(--primary-mid);
}

/* ══ DAY OFF ══ */
.day-off-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2px dashed rgba(16,185,129,0.3);
  border-radius: var(--r-sm);
  background: rgba(16,185,129,0.04);
  padding: 0.75rem;
}
.day-off-emoji { font-size: 1.5rem; }
.day-off-label {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--emerald);
  margin-top: 0.35rem;
  text-transform: uppercase;
}

/* ══ EVENT ITEMS — MAXIMIZED & CLEAR ══ */
.evt-list {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  flex: 1;
}

/* Main event item — full width, clearly readable */
.evt-item {
  display: flex;
  align-items: stretch;
  background: var(--bg-subtle);
  border-radius: var(--r-sm);
  overflow: hidden;
  font-size: 0.72rem;
  text-decoration: none;
  color: var(--text-primary);
  border: 1px solid var(--border-light);
  transition: all 0.18s;
  position: relative;
  min-height: 38px;
}
.evt-item:hover {
  border-color: currentColor;
  background: #fff;
  box-shadow: var(--shadow-xs);
  transform: translateX(2px);
}
.evt-item.google-evt {
  background: rgba(52,168,83,0.05);
  border-color: rgba(52,168,83,0.25);
}

/* Color accent bar on left */
.evt-color-bar {
  width: 4px;
  flex-shrink: 0;
  background: var(--evt-color, var(--primary));
  border-radius: 0;
}

/* Event content */
.evt-content {
  flex: 1;
  padding: 0.35rem 0.5rem;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.evt-time {
  font-size: 0.6rem;
  font-weight: 700;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 0.25rem;
  white-space: nowrap;
  margin-bottom: 0.15rem;
}
.evt-time.google-time { color: var(--google-green); }
.evt-name {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--text-primary);
  font-weight: 600;
  font-size: 0.72rem;
  line-height: 1.3;
}
.evt-feedback-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 0.4rem;
  font-size: 0.8rem;
}
.cell-empty-hint {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell-empty-hint span {
  font-size: 1.2rem;
  color: var(--border-medium);
}

/* ══ MORE EVENTS INDICATOR ══ */
.evt-more {
  font-size: 0.65rem;
  color: var(--primary);
  font-weight: 600;
  padding: 0.2rem 0.4rem;
  background: var(--primary-light);
  border-radius: var(--r-sm);
  text-align: center;
  cursor: pointer;
  border: 1px solid var(--primary-mid);
  transition: all 0.2s;
}
.evt-more:hover { background: var(--grad-brand); color: #fff; border-color: transparent; }

/* ══════════════════════════════════════════
   SIDEBAR
══════════════════════════════════════════ */
.sidebar-col {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  position: sticky;
  top: 1.5rem;
}
.side-card {
  background: var(--bg-card);
  border: 1.5px solid var(--border-light);
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}
.side-card-head {
  padding: 1.1rem 1.4rem;
  border-bottom: 1.5px solid var(--border-light);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-subtle);
}
.side-card-title {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 0.6rem;
}
.side-card-title .icon-wrap {
  width: 28px; height: 28px;
  border-radius: var(--r-sm);
  background: var(--grad-brand);
  display: flex; align-items: center; justify-content: center;
  font-size: 0.85rem;
}
.side-count {
  background: var(--grad-brand);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
  box-shadow: var(--shadow-brand);
}

/* ══ SEARCH ══ */
.search-section {
  padding: 1rem 1.25rem;
  border-bottom: 1.5px solid var(--border-light);
}
.search-row { display: flex; gap: 0.45rem; margin-bottom: 0.6rem; }
.s-input {
  flex: 1;
  background: var(--bg-subtle);
  border: 1.5px solid var(--border-light);
  border-radius: var(--r-sm);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 0.8rem;
  padding: 0.55rem 0.85rem;
  outline: none;
  transition: all 0.2s;
}
.s-input:focus {
  border-color: var(--primary);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(79,70,229,0.1);
}
.s-input::placeholder { color: var(--text-muted); }
.s-select {
  background: var(--bg-subtle);
  border: 1.5px solid var(--border-light);
  border-radius: var(--r-sm);
  color: var(--text-secondary);
  font-family: var(--font-body);
  font-size: 0.75rem;
  padding: 0.55rem 0.6rem;
  outline: none;
  width: 80px;
  cursor: pointer;
}
.date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.45rem; margin-bottom: 0.6rem; }
.action-row { display: flex; gap: 0.45rem; }
.s-btn {
  flex: 1;
  padding: 0.55rem;
  border-radius: var(--r-sm);
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  border: none;
  text-decoration: none;
  text-align: center;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.s-btn-apply {
  background: var(--grad-brand);
  color: #fff;
  box-shadow: var(--shadow-brand);
}
.s-btn-apply:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(79,70,229,0.4); }
.s-btn-reset {
  background: var(--bg-subtle);
  color: var(--text-secondary);
  border: 1.5px solid var(--border-light);
}
.s-btn-reset:hover { border-color: var(--border-medium); color: var(--text-primary); }

/* ══ UPCOMING LIST ══ */
.upcoming-scroll {
  max-height: 400px;
  overflow-y: auto;
  padding: 0.85rem;
}
.upcoming-scroll::-webkit-scrollbar { width: 3px; }
.upcoming-scroll::-webkit-scrollbar-track { background: transparent; }
.upcoming-scroll::-webkit-scrollbar-thumb { background: var(--primary-mid); border-radius: 999px; }

.upcoming-card {
  display: block;
  padding: 0.85rem 1rem;
  background: var(--bg-subtle);
  border: 1.5px solid var(--border-light);
  border-left: 4px solid var(--primary);
  border-radius: var(--r-md);
  margin-bottom: 0.6rem;
  text-decoration: none;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.upcoming-card:hover {
  border-left-color: var(--secondary);
  background: var(--primary-light);
  transform: translateX(3px);
  box-shadow: var(--shadow-sm);
}
.upcoming-card.google-up { border-left-color: var(--google-green); }
.upcoming-card.google-up:hover { background: rgba(52,168,83,0.06); }
.upcoming-card.conflict-up { border-left-color: var(--rose); }

.up-name {
  font-weight: 700;
  font-size: 0.82rem;
  color: var(--text-primary);
  margin-bottom: 0.4rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.google-tag {
  display: inline-block;
  font-size: 0.55rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  background: rgba(52,168,83,0.15);
  color: var(--google-green);
  padding: 0.1rem 0.45rem;
  border-radius: 999px;
  margin-left: 0.4rem;
  text-transform: uppercase;
}
.up-meta { display: flex; flex-direction: column; gap: 0.25rem; }
.up-meta-row {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.72rem;
  color: var(--text-secondary);
}
.up-fb { margin-top: 0.4rem; }
.up-fb-link {
  font-size: 0.72rem;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.2s;
}
.up-fb-link:hover { color: var(--primary); }
.empty-upcoming {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2.5rem 1rem;
  gap: 0.6rem;
  color: var(--text-muted);
}
.empty-upcoming p { font-size: 0.8rem; }

/* ══ STATS CARD ══ */
.stats-body { padding: 1rem 1.25rem; }
.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.7rem 0;
  border-bottom: 1.5px solid var(--border-light);
}
.stat-row:last-child { border-bottom: none; }
.stat-label {
  font-size: 0.8rem;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.stat-tag {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
}
.tag-gold   { background: var(--primary-light); color: var(--primary); border: 1px solid var(--primary-mid); }
.tag-rose   { background: #fff5f7; color: var(--rose); border: 1px solid #fecdd3; }
.tag-sage   { background: rgba(16,185,129,0.1); color: var(--emerald); border: 1px solid rgba(16,185,129,0.25); }
.tag-teal   { background: rgba(14,165,233,0.1); color: var(--sky); border: 1px solid rgba(14,165,233,0.25); }

/* ══ GOOGLE TOAST ══ */
.google-toast {
  position: fixed;
  bottom: 1.75rem;
  right: 1.75rem;
  z-index: 100;
  background: var(--bg-card);
  border: 1.5px solid var(--border-light);
  border-left: 4px solid var(--google-green);
  border-radius: var(--r-md);
  padding: 0.75rem 1.25rem;
  display: flex;
  align-items: center;
  gap: 0.65rem;
  box-shadow: var(--shadow-lg);
  font-size: 0.8rem;
  color: var(--text-secondary);
  animation: slideToast 0.4s cubic-bezier(0.16,1,0.3,1) both;
}
@keyframes slideToast {
  from { transform: translateY(24px) scale(0.96); opacity: 0; }
  to   { transform: translateY(0) scale(1); opacity: 1; }
}

/* ══ ANIMATIONS ══ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ══════════════════════════════════════════
   FEEDBACK TOAST ANIMATIONS
══════════════════════════════════════════ */
@keyframes feedbackPop {
    0% { transform: scale(0); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
}

@keyframes feedbackPulse {
    0% { transform: scale(1); }
    25% { transform: scale(1.3) rotate(10deg); }
    50% { transform: scale(1.5) rotate(-10deg); }
    75% { transform: scale(1.2) rotate(5deg); }
    100% { transform: scale(1); }
}

.feedback-toast {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    transform: translateX(120%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    max-width: 320px;
    pointer-events: none;
}

.feedback-toast.show {
    transform: translateX(0);
}

.feedback-toast-content {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
    background: white;
}

.dark .feedback-toast-content {
    background: var(--gray-800);
}

.feedback-toast-emoji {
    font-size: 2rem;
    line-height: 1;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
    animation: feedbackPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.feedback-toast-title {
    font-weight: 700;
    font-size: 0.9rem;
    color: #1f2937;
}

.dark .feedback-toast-title {
    color: #f9fafb;
}

.feedback-toast-subtitle {
    font-size: 0.8rem;
    color: #6b7280;
    margin-top: 2px;
}

.dark .feedback-toast-subtitle {
    color: #9ca3af;
}

.feedback-pulse {
    animation: feedbackPulse 0.6s ease-in-out;
}

/* ══════════════════════════════════════════
   MASCOTTE — AMÉLIORÉE
══════════════════════════════════════════ */
@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

@keyframes wiggle {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-5deg); }
    75% { transform: rotate(5deg); }
}

@keyframes glow {
    0%, 100% { box-shadow: 0 4px 12px rgba(79, 70, 229, 0.5); }
    50% { box-shadow: 0 8px 24px rgba(79, 70, 229, 0.8); }
}

@keyframes sparkle {
    0%, 100% { opacity: 0; transform: scale(0.5); }
    50% { opacity: 1; transform: scale(1.2); }
}

.mascot-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 1000;
    animation: float 3s ease-in-out infinite;
}

.mascot-card {
    background: white;
    border-radius: 1.5rem;
    padding: 1.5rem;
    box-shadow: 0 10px 40px rgba(79, 70, 229, 0.2);
    text-align: center;
    min-width: 220px;
    position: relative;
    border: 3px solid var(--primary);
    transition: all 0.3s ease;
}

.dark .mascot-card {
    background: var(--gray-800);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    border-color: var(--primary-light);
}

.mascot-card:hover {
    transform: scale(1.02);
    box-shadow: 0 15px 50px rgba(79, 70, 229, 0.3);
}

.mascot-toggle-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--gray-200);
    border: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
}

.dark .mascot-toggle-btn {
    background: var(--gray-700);
    color: var(--gray-300);
}

.mascot-toggle-btn:hover {
    background: var(--danger);
    color: white;
    transform: rotate(90deg);
}

.mascot-sparkles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
}

.sparkle {
    position: absolute;
    font-size: 1.5rem;
    animation: sparkle 2s ease-in-out infinite;
}

.sparkle:nth-child(1) { top: 15%; left: 10%; animation-delay: 0s; }
.sparkle:nth-child(2) { top: 25%; right: 10%; animation-delay: 0.5s; }
.sparkle:nth-child(3) { bottom: 15%; left: 15%; animation-delay: 1s; }
.sparkle:nth-child(4) { bottom: 25%; right: 15%; animation-delay: 1.5s; }

.mascot-avatar {
    width: 100px;
    height: 100px;
    margin: 0 auto 1rem;
    position: relative;
    cursor: pointer;
    transition: transform 0.3s ease;
}

.mascot-avatar:hover {
    animation: wiggle 0.5s ease-in-out;
}

.mascot-emoji {
    font-size: 5rem;
    line-height: 1;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.15));
    transition: all 0.3s ease;
}

.mascot-avatar:active .mascot-emoji {
    transform: scale(0.9);
}

.mascot-level-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1rem;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.5);
    animation: glow 2s ease-in-out infinite;
    border: 3px solid white;
}

.dark .mascot-level-badge {
    border-color: var(--gray-800);
}

.mascot-name {
    font-size: 1.3rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.25rem;
}

.mascot-mood {
    font-size: 0.9rem;
    color: var(--gray-600);
    margin-bottom: 1.25rem;
    font-weight: 500;
}

.dark .mascot-mood {
    color: var(--gray-400);
}

.mascot-stats {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

.mascot-stat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem;
    background: var(--gray-50);
    border-radius: 0.75rem;
    transition: all 0.3s ease;
}

.dark .mascot-stat {
    background: var(--gray-900);
}

.mascot-stat:hover {
    background: var(--gray-100);
    transform: translateX(3px);
}

.dark .mascot-stat:hover {
    background: var(--gray-700);
}

.mascot-stat-label {
    color: var(--gray-600);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
}

.dark .mascot-stat-label {
    color: var(--gray-400);
}

.mascot-stat-value {
    font-weight: 800;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 1.1rem;
}

.mascot-progress-bar {
    width: 100%;
    height: 10px;
    background: var(--gray-200);
    border-radius: 999px;
    overflow: hidden;
    margin-top: 0.75rem;
    position: relative;
}

.dark .mascot-progress-bar {
    background: var(--gray-700);
}

.mascot-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--secondary));
    border-radius: 999px;
    transition: width 0.8s ease;
    position: relative;
    overflow: hidden;
}

.mascot-progress-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: shimmer 2s infinite;
}

@keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

.mascot-message {
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(124, 58, 237, 0.1));
    border-radius: 0.75rem;
    padding: 0.875rem;
    font-size: 0.85rem;
    color: var(--gray-700);
    font-style: italic;
    position: relative;
    margin-top: 1rem;
    border: 2px solid var(--primary-light);
    font-weight: 500;
}

.dark .mascot-message {
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.2), rgba(124, 58, 237, 0.2));
    color: var(--gray-300);
    border-color: var(--primary);
}

.mascot-minimized {
    min-width: unset;
    width: 85px;
    height: 85px;
    padding: 0;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.mascot-minimized .mascot-avatar {
    width: 100%;
    height: 100%;
    margin: 0;
}

.mascot-minimized .mascot-emoji {
    font-size: 3.5rem;
}

.mascot-minimized .mascot-level-badge {
    top: -5px;
    right: -5px;
    width: 30px;
    height: 30px;
    font-size: 0.85rem;
}

@media (max-width: 768px) {
    .mascot-container {
        bottom: 1rem;
        right: 1rem;
    }

    .mascot-card {
        min-width: 180px;
        padding: 1.25rem;
    }
}

/* ══════════════════════════════════════════
   TETRIS MODAL STYLES
══════════════════════════════════════════ */
.tetris-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: rgba(10, 12, 30, 0.82);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 2rem;
  animation: tOverlayIn 0.3s ease;
}
@keyframes tOverlayIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.tetris-modal {
  background: #0f1128;
  border: 1.5px solid rgba(79,70,229,0.4);
  border-radius: 24px;
  width: 100%;
  max-width: 1050px;
  max-height: 92vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 0 80px rgba(79,70,229,0.3), 0 0 160px rgba(79,70,229,0.1);
  animation: tModalIn 0.4s cubic-bezier(0.16,1,0.3,1);
  position: relative;
  transform: translate(-60px, 30px);
}
@keyframes tModalIn {
  from { transform: scale(0.88) translateY(24px); opacity: 0; }
  to   { transform: scale(1) translateY(0); opacity: 1; }
}

.tetris-modal::before {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(255,255,255,0.015) 2px,
    rgba(255,255,255,0.015) 4px
  );
  pointer-events: none;
  z-index: 0;
  border-radius: 24px;
}

.tetris-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid rgba(79,70,229,0.25);
  background: linear-gradient(135deg, rgba(79,70,229,0.15), rgba(124,58,237,0.1));
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}
.tetris-header-left {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}
.tetris-logo {
  font-size: 2rem;
  animation: tLogoPulse 2s ease-in-out infinite;
}
@keyframes tLogoPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12) rotate(-5deg); }
}
.tetris-title {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
  background: linear-gradient(135deg, #a5b4fc, #c084fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.tetris-sub {
  font-size: 0.72rem;
  color: rgba(165,180,252,0.7);
  margin-top: 0.1rem;
}
.tetris-close {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.7);
  font-size: 1.3rem;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
  line-height: 1;
}
.tetris-close:hover {
  background: rgba(244,63,94,0.2);
  border-color: rgba(244,63,94,0.5);
  color: #f43f5e;
  transform: rotate(90deg);
}

.tetris-hud {
  display: flex;
  gap: 0;
  border-bottom: 1px solid rgba(79,70,229,0.2);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.hud-block {
  flex: 1;
  padding: 0.6rem 1rem;
  text-align: center;
  border-right: 1px solid rgba(79,70,229,0.15);
}
.hud-block:last-child { border-right: none; }
.hud-label {
  font-size: 0.58rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(165,180,252,0.6);
  margin-bottom: 0.2rem;
}
.hud-value {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #a5b4fc;
  line-height: 1;
  transition: all 0.3s;
}
.hud-value.pop {
  animation: tPop 0.3s ease;
}
@keyframes tPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.4); color: #fbbf24; }
  100% { transform: scale(1); }
}
.hud-timer.danger .hud-value {
  color: #f43f5e;
  animation: tBlink 0.5s ease infinite;
}
@keyframes tBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.tetris-game-area {
  display: grid;
  grid-template-columns: 200px 1fr 180px;
  flex: 1;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.tetris-queue-panel {
  border-right: 1px solid rgba(79,70,229,0.2);
  display: flex;
  flex-direction: column;
  padding: 0.75rem;
  background: rgba(79,70,229,0.04);
  overflow: hidden;
}
.queue-title {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(165,180,252,0.7);
  margin-bottom: 0.6rem;
}
.queue-list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.queue-list::-webkit-scrollbar { width: 3px; }
.queue-list::-webkit-scrollbar-thumb { background: rgba(79,70,229,0.4); border-radius: 99px; }

.q-event {
  background: rgba(255,255,255,0.04);
  border: 1.5px solid rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 0.5rem 0.65rem;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.q-event::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background: var(--evt-q-color, #a5b4fc);
  border-radius: 0 0 0 8px;
}
.q-event:hover {
  border-color: rgba(165,180,252,0.4);
  background: rgba(79,70,229,0.12);
  transform: translateX(3px);
}
.q-event.selected {
  border-color: #fbbf24;
  background: rgba(251,191,36,0.1);
  box-shadow: 0 0 12px rgba(251,191,36,0.25);
}
.q-event.placed {
  opacity: 0.3;
  pointer-events: none;
  text-decoration: line-through;
}
.q-evt-name {
  font-size: 0.72rem;
  font-weight: 600;
  color: #e2e8f0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 0.2rem;
}
.q-evt-time {
  font-size: 0.6rem;
  color: rgba(165,180,252,0.6);
}
.q-evt-dur {
  display: inline-block;
  font-size: 0.55rem;
  font-weight: 700;
  background: rgba(165,180,252,0.15);
  color: #a5b4fc;
  padding: 0.1rem 0.4rem;
  border-radius: 999px;
  margin-top: 0.2rem;
}
.queue-hint {
  font-size: 0.62rem;
  color: rgba(165,180,252,0.4);
  text-align: center;
  line-height: 1.5;
  margin-top: 0.6rem;
  padding-top: 0.6rem;
  border-top: 1px solid rgba(79,70,229,0.15);
}

.tetris-board-wrap {
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.board-label-row {
  display: grid;
  grid-template-columns: 52px repeat(7, 1fr);
  gap: 2px;
  padding: 0.5rem 0.5rem 0;
  flex-shrink: 0;
}
.board-corner { }
.day-col-label {
  text-align: center;
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: rgba(165,180,252,0.6);
  padding: 0.2rem;
  background: rgba(79,70,229,0.1);
  border-radius: 4px;
}
.board-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 0.25rem 0.5rem 0.5rem;
}
.board-scroll::-webkit-scrollbar { width: 4px; }
.board-scroll::-webkit-scrollbar-thumb { background: rgba(79,70,229,0.4); border-radius: 99px; }

.tetris-board {
  display: grid;
  grid-template-columns: 52px repeat(7, 1fr);
  gap: 2px;
}

.time-label {
  font-size: 0.55rem;
  color: rgba(165,180,252,0.45);
  text-align: right;
  padding-right: 6px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 36px;
}

.t-cell {
  height: 36px;
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(79,70,229,0.12);
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.15s;
  position: relative;
  overflow: hidden;
}
.t-cell:hover {
  background: rgba(165,180,252,0.1);
  border-color: rgba(165,180,252,0.35);
}
.t-cell.t-cell-highlight {
  background: rgba(251,191,36,0.12) !important;
  border-color: rgba(251,191,36,0.5) !important;
}
.t-cell.occupied {
  cursor: default;
}
.t-cell.occupied:hover {
  border-color: rgba(244,63,94,0.5);
  background: rgba(244,63,94,0.1);
}

.t-block {
  position: absolute;
  inset: 1px;
  border-radius: 3px;
  display: flex;
  align-items: center;
  padding: 0 6px;
  font-size: 0.58rem;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  animation: tBlockDrop 0.3s cubic-bezier(0.16,1,0.3,1);
}
@keyframes tBlockDrop {
  from { transform: scaleY(0); opacity: 0; transform-origin: top; }
  to   { transform: scaleY(1); opacity: 1; }
}

.t-cell.row-complete {
  animation: tRowFlash 0.5s ease forwards;
}
@keyframes tRowFlash {
  0%   { background: rgba(251,191,36,0.6); border-color: #fbbf24; }
  50%  { background: rgba(251,191,36,0.2); }
  100% { background: rgba(255,255,255,0.025); }
}

.tetris-info-panel {
  border-left: 1px solid rgba(79,70,229,0.2);
  padding: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  background: rgba(79,70,229,0.04);
  overflow-y: auto;
}
.tetris-info-panel::-webkit-scrollbar { width: 3px; }
.tetris-info-panel::-webkit-scrollbar-thumb { background: rgba(79,70,229,0.4); border-radius: 99px; }

.info-section {}
.info-title {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(165,180,252,0.6);
  margin-bottom: 0.4rem;
}

.next-card {
  background: rgba(255,255,255,0.04);
  border: 1.5px solid rgba(79,70,229,0.3);
  border-radius: 8px;
  padding: 0.65rem;
  min-height: 60px;
}
.next-card-name {
  font-size: 0.78rem;
  font-weight: 700;
  color: #c4b5fd;
  margin-bottom: 0.25rem;
}
.next-card-time {
  font-size: 0.62rem;
  color: rgba(165,180,252,0.5);
}
.next-card-dur {
  font-size: 0.6rem;
  background: rgba(165,180,252,0.1);
  color: #a5b4fc;
  padding: 0.15rem 0.5rem;
  border-radius: 999px;
  display: inline-block;
  margin-top: 0.25rem;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.rule-item {
  font-size: 0.65rem;
  color: rgba(226,232,240,0.6);
  line-height: 1.4;
}
.rule-item strong {
  color: #fbbf24;
}

.best-score {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.6rem;
  font-weight: 700;
  color: #fbbf24;
  text-shadow: 0 0 20px rgba(251,191,36,0.4);
}

.btn-restart {
  margin-top: auto;
  background: rgba(79,70,229,0.2);
  border: 1.5px solid rgba(79,70,229,0.4);
  color: #a5b4fc;
  border-radius: 8px;
  padding: 0.6rem;
  font-family: 'Sora', system-ui, sans-serif;
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  width: 100%;
}
.btn-restart:hover {
  background: rgba(79,70,229,0.4);
  border-color: #a5b4fc;
  color: #fff;
  transform: translateY(-1px);
}

.tetris-message {
  position: absolute;
  inset: 0;
  background: rgba(10,12,30,0.9);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  border-radius: 24px;
  animation: tOverlayIn 0.3s ease;
}
.t-msg-box {
  text-align: center;
  padding: 2rem;
  max-width: 360px;
}
.t-msg-icon {
  font-size: 4rem;
  margin-bottom: 0.75rem;
  animation: tMsgBounce 0.6s cubic-bezier(0.16,1,0.3,1);
}
@keyframes tMsgBounce {
  from { transform: scale(0) rotate(-20deg); }
  to   { transform: scale(1) rotate(0deg); }
}
.t-msg-title {
  font-family: 'Fraunces', Georgia, serif;
  font-size: 1.8rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 0.5rem;
  background: linear-gradient(135deg, #a5b4fc, #c084fc);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.t-msg-body {
  color: rgba(165,180,252,0.8);
  font-size: 0.85rem;
  line-height: 1.6;
  margin-bottom: 1.5rem;
}
.t-msg-actions {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
}
.btn-msg-play {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
  border: none;
  border-radius: 10px;
  padding: 0.65rem 1.4rem;
  font-family: 'Sora', system-ui, sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 4px 16px rgba(79,70,229,0.4);
}
.btn-msg-play:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(79,70,229,0.5); }
.btn-msg-close {
  background: rgba(255,255,255,0.06);
  color: rgba(165,180,252,0.8);
  border: 1.5px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  padding: 0.65rem 1.4rem;
  font-family: 'Sora', system-ui, sans-serif;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-msg-close:hover { background: rgba(244,63,94,0.15); border-color: rgba(244,63,94,0.4); color: #f43f5e; }

.t-toast {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(10,12,30,0.92);
  border: 1.5px solid rgba(165,180,252,0.3);
  border-radius: 12px;
  padding: 0.65rem 1.4rem;
  font-size: 0.9rem;
  font-weight: 700;
  color: #fff;
  z-index: 5;
  pointer-events: none;
  animation: tToastAnim 1.2s ease forwards;
  white-space: nowrap;
}
@keyframes tToastAnim {
  0%   { opacity: 0; transform: translate(-50%, -40%) scale(0.85); }
  20%  { opacity: 1; transform: translate(-50%, -50%) scale(1.05); }
  70%  { opacity: 1; transform: translate(-50%, -55%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -70%) scale(0.9); }
}

.kb-hint {
  position: absolute;
  bottom: 0.5rem;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.58rem;
  color: rgba(165,180,252,0.3);
  z-index: 1;
  letter-spacing: 0.08em;
}

@media (max-width: 768px) {
  .tetris-game-area { grid-template-columns: 1fr; }
  .tetris-queue-panel, .tetris-info-panel { display: none; }
}

/* ══ RESPONSIVE ══ */
@media (max-width: 768px) {
  .planner-wrap { padding: 1.25rem 0.9rem 3rem; }
  .cal-grid { gap: 0.4rem; }
  .day-cell { min-height: 110px; padding: 0.6rem 0.5rem; }
  .cal-header, .cal-grid-wrap { padding: 1rem 1.1rem; }
  .sidebar-col { position: static; }
}
</style>
{% endblock %}

{% block body %}
<body class="planning-body">
<div class="planner-wrap">

  <!-- ══ HEADER ══ -->
  <header class="page-header">
    <div class="header-left">
      <div class="header-eyebrow">Planning System</div>
      <h1 class="header-title">Your <span>Schedule</span></h1>
      <p class="header-sub">Manage your time, track your sessions, stay ahead.</p>
    </div>
    <div class="header-actions">
      <a href="{{ path('app_planning_new') }}" class="btn btn-primary">
        <i data-lucide="plus" style="width:15px;height:15px;"></i>
        Add Event
      </a>
      <a href="{{ path('app_seance_index') }}" class="btn btn-outline">
        <i data-lucide="file-plus" style="width:15px;height:15px;"></i>
        Sessions
      </a>
      <a href="{{ path('app_type_seance_index') }}" class="btn btn-outline">
        <i data-lucide="tags" style="width:15px;height:15px;"></i>
        Types
      </a>
      <a href="{{ path('app_planning_week', { date: today }) }}" class="btn btn-outline btn-sm">
        <i data-lucide="calendar-days" style="width:13px;height:13px;"></i>
        Week View
      </a>
      <!-- AI Planning Button -->
      <a href="{{ path('app_ai_planning_index') }}" class="btn btn-primary btn-sm">
        <i data-lucide="sparkles" style="width:13px;height:13px;"></i>
        AI Planning ✨
      </a>
      <!-- Fun Mode Button -->
      <button class="btn btn-outline btn-sm" onclick="openTetris()">
        <i data-lucide="gamepad-2" style="width:13px;height:13px;"></i>
        Fun Mode 🎮
      </button>
    </div>
  </header>

  <!-- ══ QUOTE ══ -->
  <div class="quote-strip">
    <div class="quote-icon">❝</div>
    <div>
      <div class="quote-text" id="quoteText">The best way to predict the future is to create it.</div>
      <div class="quote-author" id="quoteAuthor">— Peter Drucker</div>
    </div>
  </div>

  <!-- ══ ALERTS ══ -->
  {% set pending_feedback = [] %}
  {% for date, day_events in events_by_date %}
    {% if date < today %}
      {% for event in day_events %}
        {% if not event.is_google and event.feedback is null and event.title|lower != 'day off' %}
          {% set pending_feedback = pending_feedback|merge([event]) %}
        {% endif %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  {% if pending_feedback|length > 0 %}
  <div class="alert-banner alert-feedback">
    <div class="alert-icon-wrap">
      <i data-lucide="message-circle" style="width:17px;height:17px;color:#4f46e5;"></i>
    </div>
    <div style="flex:1;">
      <div class="alert-title">{{ pending_feedback|length }} session{{ pending_feedback|length > 1 ? 's' : '' }} awaiting feedback</div>
      <div class="alert-sub">Share your experience to improve your planning</div>
      <div class="alert-chips">
        {% for fb in pending_feedback %}
          <a href="{{ path('app_planning_feedback_form', { id: fb.id }) }}" class="alert-chip">
            💭 {{ fb.title|default('Session')|slice(0, 18) }}
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  {% if conflicts is defined and conflicts|length > 0 %}
  <div class="alert-banner alert-conflict">
    <div class="alert-icon-wrap">
      <i data-lucide="alert-triangle" style="width:17px;height:17px;color:#f43f5e;"></i>
    </div>
    <div>
      <div class="alert-title">{{ conflicts|length }} scheduling conflict{{ conflicts|length > 1 ? 's' : '' }} detected</div>
      <div class="alert-sub">Review your schedule to resolve overlapping events</div>
    </div>
  </div>
  {% endif %}

  <!-- ══ MAIN LAYOUT ══ -->
  <div class="main-layout">

    <!-- ████ CALENDAR ████ -->
    <div class="calendar-wrap">

      <!-- Calendar Header -->
      <div class="cal-header">
        <div class="cal-month-block">
          <div class="cal-month-icon">📅</div>
          <div>
            <div class="cal-month-name">{{ (current_year ~ '-' ~ current_month ~ '-01')|date('F Y') }}</div>
            <div class="cal-event-count">
              <strong>{{ events_by_date|reduce((carry, v) => carry + v|length, 0) }}</strong> events this month
            </div>
          </div>
        </div>
        <div class="cal-nav">
          {% set prev_month = current_month == 1 ? 12 : current_month - 1 %}
          {% set prev_year  = current_month == 1 ? current_year - 1 : current_year %}
          {% set next_month = current_month == 12 ? 1 : current_month + 1 %}
          {% set next_year  = current_month == 12 ? current_year + 1 : current_year %}
          <a href="{{ path('app_planning', {month: prev_month, year: prev_year}) }}" class="cal-nav-btn" title="Previous month">
            <i data-lucide="chevron-left" style="width:17px;height:17px;"></i>
          </a>
          <a href="{{ path('app_planning') }}" class="cal-nav-btn cal-nav-today">Today</a>
          <a href="{{ path('app_planning', {month: next_month, year: next_year}) }}" class="cal-nav-btn" title="Next month">
            <i data-lucide="chevron-right" style="width:17px;height:17px;"></i>
          </a>
        </div>
      </div>

      <!-- Calendar Grid -->
      <div class="cal-grid-wrap">
        <div class="cal-grid">

          <!-- Weekday headers -->
          {% for day in ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'] %}
            <div class="weekday-label">{{ day }}</div>
          {% endfor %}

          <!-- Empty cells before month start -->
          {% for i in 1..(first_day_of_week - 1) %}
            <div class="day-cell empty-cell"></div>
          {% endfor %}

          <!-- Day cells -->
          {% for day in 1..days_in_month %}
            {% set date_key  = current_year ~ '-' ~ (current_month < 10 ? '0' ~ current_month : current_month) ~ '-' ~ (day < 10 ? '0' ~ day : day) %}
            {% set day_events = events_by_date[date_key] ?? [] %}
            {% set is_today   = date_key == today %}
            {% set day_off    = day_events|filter(e => e.title|lower == 'day off')|first %}
            {# Determine if weekend (SAT=6, SUN=0) #}
            {% set dow = (date_key)|date('N') %}
            {% set is_weekend = (dow == 6 or dow == 7) %}

            <div class="day-cell {{ is_today ? 'is-today' : '' }} {{ is_weekend and not is_today ? 'is-weekend' : '' }}" data-date="{{ date_key }}">
              <div class="cell-top">
                <span class="day-num {{ is_today ? 'today-num' : '' }}">{{ day }}</span>
                {% if day_events|length > 0 and not day_off %}
                  <span class="evt-pill">{{ day_events|length }}</span>
                {% endif %}
              </div>

              {% if day_off %}
                <div class="day-off-block">
                  <span class="day-off-emoji">🌴</span>
                  <span class="day-off-label">Day Off</span>
                </div>

              {% else %}
                <div class="evt-list">
                  {% for event in day_events %}
                    {% set is_google = event.is_google|default(false) %}
                    {% set evt_color = is_google ? '#34a853' : event.ui.color|default('#4f46e5') %}

                    {% if is_google %}
                      <div class="evt-item google-evt" style="--evt-color: {{ evt_color }};" title="{{ event.title }} (Google Calendar — read only)">
                    {% else %}
                      <a href="{{ path('app_planning_edit', {id: event.id}) }}" class="evt-item" style="--evt-color: {{ evt_color }};" title="{{ event.title }}">
                    {% endif %}

                      <div class="evt-color-bar" style="background: {{ evt_color }};"></div>

                      <div class="evt-content">
                        <div class="evt-time {{ is_google ? 'google-time' : '' }}">
                          {% if is_google %}
                            <i data-lucide="chrome" style="width:8px;height:8px;"></i>
                          {% else %}
                            <i data-lucide="clock" style="width:8px;height:8px;"></i>
                          {% endif %}
                          {{ event.start_time }}{% if event.end_time %}–{{ event.end_time }}{% endif %}
                        </div>
                        <span class="evt-name">{{ event.title }}</span>
                      </div>

                      {% if not is_google and event.feedback is not null %}
                        <div class="evt-feedback-icon">
                          {% if event.feedback == 1 %}😡
                          {% elseif event.feedback == 2 %}😕
                          {% elseif event.feedback == 3 %}😐
                          {% elseif event.feedback == 4 %}🙂
                          {% else %}🤩{% endif %}
                        </div>
                      {% endif %}

                    {% if is_google %}</div>{% else %}</a>{% endif %}
                  {% endfor %}

                  {% if day_events|length == 0 %}
                    <div class="cell-empty-hint"><span>·</span></div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}

        </div>
      </div>
    </div>
    <!-- end calendar-wrap -->

    <!-- ████ SIDEBAR ████ -->
    <div class="sidebar-col">

      <!-- Upcoming Events -->
      <div class="side-card">
        <div class="side-card-head">
          <div class="side-card-title">
            <div class="icon-wrap">📌</div>
            Upcoming
          </div>
          <span class="side-count">{{ upcoming_total|default(0) }}</span>
        </div>

        <div class="search-section">
          <form method="get" action="{{ path('app_planning') }}">
            <input type="hidden" name="month" value="{{ current_month }}">
            <input type="hidden" name="year"  value="{{ current_year }}">
            <div class="search-row">
              <input type="text" name="up_q" value="{{ upcoming_q|default('') }}" placeholder="Search events…" class="s-input">
              <select name="up_sort" class="s-select" onchange="this.form.submit()">
                <option value="date_asc"  {% if up_sort|default('date_asc')=='date_asc' %}selected{% endif %}>Date</option>
                <option value="title_asc" {% if up_sort|default('date_asc')=='title_asc' %}selected{% endif %}>Title</option>
              </select>
            </div>
            <div class="date-row">
              <input type="date" name="up_start" value="{{ up_start|default('') }}" class="s-input">
              <input type="date" name="up_end"   value="{{ up_end|default('') }}"   class="s-input">
            </div>
            <div class="action-row">
              <button type="submit" class="s-btn s-btn-apply">Apply</button>
              <a href="{{ path('app_planning', {month: current_month, year: current_year}) }}" class="s-btn s-btn-reset">Reset</a>
            </div>
          </form>
        </div>

        <div class="upcoming-scroll">
          {% for event in upcoming|default([]) %}
            {% set is_google = event.is_google|default(false) %}
            <div class="upcoming-card {{ is_google ? 'google-up' : '' }} {{ event.conflict ?? false ? 'conflict-up' : '' }}"
                 style="border-left-color: {{ is_google ? '#34a853' : event.ui.bar|default('#4f46e5') }};">
              <div class="up-name">
                {{ event.title }}
                {% if is_google %}<span class="google-tag">Google</span>{% endif %}
              </div>
              <div class="up-meta">
                <div class="up-meta-row">
                  <i data-lucide="calendar" style="width:11px;height:11px;color:#4f46e5;"></i>
                  {{ event.date|date('M j, Y') }}
                </div>
                <div class="up-meta-row">
                  <i data-lucide="clock" style="width:11px;height:11px;color:#94a3b8;"></i>
                  {{ event.start_time }}{% if event.end_time %} – {{ event.end_time }}{% endif %}
                </div>
              </div>
              {% if not is_google %}
                <div class="up-fb">
                  {% if event.feedback is not null %}
                    <span style="font-size:.82rem;">
                      {% if event.feedback==1 %}😡{% elseif event.feedback==2 %}😕{% elseif event.feedback==3 %}😐{% elseif event.feedback==4 %}🙂{% else %}🤩{% endif %}
                    </span>
                  {% else %}
                    <a href="{{ path('app_planning_feedback_form', {id: event.id}) }}" class="up-fb-link">💭 Add feedback</a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% else %}
            <div class="empty-upcoming">
              <i data-lucide="calendar-off" style="width:32px;height:32px;"></i>
              <p>No upcoming events</p>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Stats Card -->
      <div class="side-card">
        <div class="side-card-head">
          <div class="side-card-title">
            <div class="icon-wrap">📊</div>
            This Month
          </div>
        </div>
        <div class="stats-body">
          <div class="stat-row">
            <span class="stat-label">
              <i data-lucide="calendar" style="width:13px;height:13px;color:#4f46e5;"></i>
              Total events
            </span>
            <span class="stat-tag tag-gold">{{ events_by_date|reduce((carry, v) => carry + v|length, 0) }}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">
              <i data-lucide="message-circle" style="width:13px;height:13px;color:#0ea5e9;"></i>
              With feedback
            </span>
            <span class="stat-tag tag-teal">{{ events_by_date|reduce((carry, v) => carry + v|filter(e => e.feedback is not null)|length, 0) }}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">
              <i data-lucide="alert-circle" style="width:13px;height:13px;color:#f43f5e;"></i>
              Pending feedback
            </span>
            <span class="stat-tag tag-rose">{{ pending_feedback|length }}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">
              <i data-lucide="chrome" style="width:13px;height:13px;color:#34a853;"></i>
              Google events
            </span>
            <span class="stat-tag tag-sage">{{ events_by_date|reduce((carry, v) => carry + v|filter(e => e.is_google|default(false))|length, 0) }}</span>
          </div>
        </div>
      </div>

    </div>
    <!-- end sidebar -->
  </div>
  <!-- end main-layout -->

  {% if google_events_count is defined and google_events_count > 0 %}
  <div class="google-toast">
    <i data-lucide="chrome" style="width:15px;height:15px;color:#34a853;"></i>
    <span>{{ google_events_count }} Google events synced</span>
  </div>
  {% endif %}

  <!-- ══ MASCOTTE AMÉLIORÉE ══ -->
  <div class="mascot-container" id="mascotContainer">
    <div class="mascot-card" id="mascotCard">
      <button class="mascot-toggle-btn" onclick="toggleMascot(event)" title="Minimize">
