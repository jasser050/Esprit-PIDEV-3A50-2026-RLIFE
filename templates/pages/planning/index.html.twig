{% extends 'base.html.twig' %}

{% block title %}Planning{% endblock %}

{% block body %}
<div class="space-y-6 animate-fade-in">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">Planning</h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Manage your schedule and events</p>
        </div>
        <a href="{{ path('app_planning_new') }}" class="btn btn-primary">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Add Event
        </a>
    </div>

    {% if conflicts|length > 0 %}
    <div class="alert alert-warning">
        <i data-lucide="alert-triangle" class="w-5 h-5 alert-icon"></i>
        <div>
            <p class="font-medium">Scheduling Conflicts Detected</p>
            <p class="text-sm mt-0.5">You have {{ conflicts|length }} event(s) with time conflicts. Review your schedule.</p>
        </div>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <!-- Calendar -->
        <div class="lg:col-span-3 card overflow-hidden">
            <!-- Calendar Header -->
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                            <i data-lucide="calendar" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                        </div>
                        <h2 class="text-xl font-semibold text-secondary-900 dark:text-white">
                            {{ (current_year ~ '-' ~ current_month ~ '-01')|date('F Y') }}
                        </h2>
                    </div>
                    <div class="flex items-center gap-2">
                        {% set prev_month = current_month == 1 ? 12 : current_month - 1 %}
                        {% set prev_year = current_month == 1 ? current_year - 1 : current_year %}
                        {% set next_month = current_month == 12 ? 1 : current_month + 1 %}
                        {% set next_year = current_month == 12 ? current_year + 1 : current_year %}

                        <a href="{{ path('app_planning', {month: prev_month, year: prev_year}) }}"
                           class="btn btn-ghost btn-icon">
                            <i data-lucide="chevron-left" class="w-5 h-5"></i>
                        </a>
                        <a href="{{ path('app_planning') }}" class="btn btn-secondary btn-sm">Today</a>
                        <a href="{{ path('app_planning', {month: next_month, year: next_year}) }}"
                           class="btn btn-ghost btn-icon">
                            <i data-lucide="chevron-right" class="w-5 h-5"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Calendar Grid -->
            <div class="p-4">
                <div class="calendar-grid">
                    <!-- Day Headers -->
                    {% for day in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] %}
                    <div class="calendar-cell-header">{{ day }}</div>
                    {% endfor %}

                    <!-- Empty cells for days before first of month -->
                    {% for i in 1..(first_day_of_week - 1) %}
                    <div class="calendar-cell bg-secondary-50/50 dark:bg-secondary-900/30"></div>
                    {% endfor %}

                    <!-- Days of the month -->
                    {% for day in 1..days_in_month %}
                        {% set date = current_year ~ '-' ~ (current_month < 10 ? '0' ~ current_month : current_month) ~ '-' ~ (day < 10 ? '0' ~ day : day) %}
                        {% set day_events = events_by_date[date] ?? [] %}
                        {% set is_today = date == today %}

                        <div class="calendar-cell {{ is_today ? 'ring-2 ring-primary-500 ring-inset' : '' }}">
                            <div class="flex items-center justify-between mb-1">
                                <span class="calendar-day-number {{ is_today ? 'today' : '' }}">{{ day }}</span>
                                {% if day_events|length > 0 %}
                                    <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
                                {% endif %}
                            </div>
                            <div class="space-y-0.5">
                                {% for event in day_events|slice(0, 3) %}
                                <div class="calendar-event bg-{{ event.color }}-100 dark:bg-{{ event.color }}-900/30 text-{{ event.color }}-700 dark:text-{{ event.color }}-300 {{ event.conflict ?? false ? 'ring-1 ring-danger-500' : '' }}">
                                    {{ event.start_time }} {{ event.title }}
                                </div>
                                {% endfor %}
                                {% if day_events|length > 3 %}
                                <div class="text-2xs text-secondary-500 dark:text-secondary-400 px-1">+{{ day_events|length - 3 }} more</div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Upcoming Events Sidebar -->
        <div class="space-y-5">
            <div class="card overflow-hidden">
                <div class="p-4 border-b border-secondary-200 dark:border-secondary-800">
                    <div class="flex items-center gap-2">
                        <i data-lucide="calendar-clock" class="w-5 h-5 text-accent-500"></i>
                        <h3 class="font-semibold text-secondary-900 dark:text-white">Upcoming</h3>
                    </div>
                </div>
                <div class="p-3 space-y-2">
                    {% set upcoming = [] %}
                    {% for date, events in events_by_date %}
                        {% if date >= today %}
                            {% for event in events %}
                                {% set upcoming = upcoming|merge([event|merge({date: date})]) %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}

                    {% for event in upcoming|slice(0, 5) %}
                    <div class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors {{ event.conflict ?? false ? 'ring-1 ring-danger-500' : '' }}">
                        <div class="w-1 h-10 rounded-full bg-{{ event.color }}-500 flex-shrink-0"></div>
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-sm text-secondary-900 dark:text-white truncate">{{ event.title }}</p>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400 flex items-center gap-1 mt-0.5">
                                <i data-lucide="calendar" class="w-3 h-3"></i>
                                {{ event.date|date('M j') }} at {{ event.start_time }}
                            </p>
                        </div>
                    </div>
                    {% else %}
                    <div class="empty-state py-6">
                        <i data-lucide="calendar-off" class="w-8 h-8 text-secondary-300 dark:text-secondary-600"></i>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-2">No upcoming events</p>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {% if conflicts|length > 0 %}
            <div class="card overflow-hidden border-danger-200 dark:border-danger-800">
                <div class="p-4 border-b border-danger-200 dark:border-danger-800 bg-danger-50 dark:bg-danger-900/20">
                    <div class="flex items-center gap-2">
                        <i data-lucide="alert-triangle" class="w-5 h-5 text-danger-500"></i>
                        <h3 class="font-semibold text-danger-700 dark:text-danger-300">Conflicts</h3>
                    </div>
                </div>
                <div class="p-3 space-y-2">
                    {% for conflict in conflicts %}
                    <div class="flex items-start gap-3 p-2.5 rounded-xl bg-danger-50 dark:bg-danger-900/20">
                        <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                        <div>
                            <p class="font-medium text-sm text-secondary-900 dark:text-white">{{ conflict.title }}</p>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">{{ conflict.date|date('M j') }} at {{ conflict.start_time }}</p>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Quick Stats -->
            <div class="card p-4">
                <div class="flex items-center gap-3 mb-3">
                    <i data-lucide="bar-chart-3" class="w-5 h-5 text-secondary-400"></i>
                    <h3 class="font-semibold text-secondary-900 dark:text-white">This Month</h3>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-secondary-500 dark:text-secondary-400">Total Events</span>
                        <span class="font-semibold text-secondary-900 dark:text-white">{{ events_by_date|reduce((carry, v) => carry + v|length, 0) }}</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-secondary-500 dark:text-secondary-400">Classes</span>
                        <span class="badge badge-primary badge-pill">{{ events_by_date|reduce((carry, v) => carry + v|filter(e => e.type == 'class')|length, 0) }}</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-sm text-secondary-500 dark:text-secondary-400">Exams</span>
                        <span class="badge badge-danger badge-pill">{{ events_by_date|reduce((carry, v) => carry + v|filter(e => e.type == 'exam')|length, 0) }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
