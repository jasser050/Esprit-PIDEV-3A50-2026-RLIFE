{% extends 'base.html.twig' %}

{% block title %}New Event{% endblock %}

{% block body %}
<div class="space-y-6 max-w-2xl mx-auto">
    {% include 'components/breadcrumbs.html.twig' with {
        items: [
            { label: 'Dashboard', href: path('app_dashboard') },
            { label: 'Planning', href: path('app_planning') },
            { label: 'New Event' }
        ]
    } %}

    {% include 'components/page_header.html.twig' with {
        title: 'New Event',
        subtitle: 'Add a new event to your calendar'
    } %}

    <form action="{{ path('app_planning_new') }}" method="POST" class="card p-6">
        <div class="space-y-6">
            {# Session (required) #}
            {% include 'components/select.html.twig' with {
                name: 'seance_id',
                label: 'Session',
                required: true,
                options: seances|default([])|map(s => { value: s.id, label: s.titre ?? ('Seance #' ~ s.id) })
            } %}

            {# Date #}
            {% include 'components/input.html.twig' with {
                name: 'date',
                label: 'Date',
                type: 'date',
                value: preselected_date|default(''),
                required: true
            } %}

            <div class="grid grid-cols-2 gap-4">
                {# Start Time #}
                {% include 'components/input.html.twig' with {
                    name: 'start_time',
                    label: 'Start Time',
                    type: 'time',
                    required: true
                } %}

                {# End Time #}
                {% include 'components/input.html.twig' with {
                    name: 'end_time',
                    label: 'End Time',
                    type: 'time',
                    required: true
                } %}
            </div>

            {# Color #}
            {% include 'components/select.html.twig' with {
                name: 'color',
                label: 'Color',
                options: [
                    { value: 'indigo', label: 'Indigo (Primary)' },
                    { value: 'teal', label: 'Teal (Secondary)' },
                    { value: 'amber', label: 'Amber (Accent)' },
                    { value: 'blue', label: 'Blue' },
                    { value: 'green', label: 'Green' },
                    { value: 'red', label: 'Red' },
                    { value: 'purple', label: 'Purple' },
                    { value: 'pink', label: 'Pink' }
                ]
            } %}

            {# Feedback (optional) #}
            <div class="space-y-2">
                <label class="text-sm font-medium text-light-text dark:text-dark-text">
                    Feedback (Optional)
                </label>

                <div class="flex items-center gap-4">
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="feedback" value="1" class="accent-indigo-600">
                        <span class="text-xl">😡</span>
                    </label>
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="feedback" value="2" class="accent-indigo-600">
                        <span class="text-xl">😕</span>
                    </label>
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="feedback" value="3" class="accent-indigo-600">
                        <span class="text-xl">😐</span>
                    </label>
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="feedback" value="4" class="accent-indigo-600">
                        <span class="text-xl">🙂</span>
                    </label>
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="feedback" value="5" class="accent-indigo-600">
                        <span class="text-xl">🤩</span>
                    </label>
                </div>

                <p class="text-xs text-light-muted dark:text-dark-muted">
                    Choose one reaction (optional).
                </p>
            </div>

            {# Actions #}
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-light-border dark:border-dark-border">
                <a href="{{ path('app_planning') }}" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Create Event
                </button>
            </div>
        </div>
    </form>
</div>
{% endblock %}