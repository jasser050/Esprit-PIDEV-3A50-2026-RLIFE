{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier Question Stress{% endblock %}

{% block body %}
<div class="container mx-auto p-6 max-w-3xl">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white">Modifier la question</h1>
            <p class="text-gray-400 mt-1">Modifiez le texte et les paramètres de la question</p>
        </div>
        <a href="{{ path('app_admin_question_stress_index') }}" class="btn btn-outline gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Retour à la liste
        </a>
    </div>

    <div class="card bg-base-200 shadow-xl">
        <div class="card-body">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

            <!-- Champ Question -->
            <div class="form-control">
                {{ form_label(form.label, null, {'label_attr': {'class': 'label-text font-medium text-lg'}}) }}
                {{ form_widget(form.label, {'attr': {'class': 'textarea textarea-bordered w-full h-28 text-base'}}) }}
                {{ form_errors(form.label, {'attr': {'class': 'text-error text-sm mt-1'}}) }}
            </div>

            <!-- Champs numériques en grille -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="form-control">
                    {{ form_label(form.orderIndex) }}
                    {{ form_widget(form.orderIndex, {'attr': {'class': 'input input-bordered w-full'}}) }}
                    {{ form_errors(form.orderIndex) }}
                </div>

                <div class="form-control">
                    {{ form_label(form.minValue) }}
                    {{ form_widget(form.minValue, {'attr': {'class': 'input input-bordered w-full'}}) }}
                    {{ form_errors(form.minValue) }}
                </div>

                <div class="form-control">
                    {{ form_label(form.maxValue) }}
                    {{ form_widget(form.maxValue, {'attr': {'class': 'input input-bordered w-full'}}) }}
                    {{ form_errors(form.maxValue) }}
                </div>
            </div>

            <!-- Boutons d'action -->
            <div class="flex justify-between items-center pt-8 mt-8 border-t border-base-300">
                <div>
                    {{ include('question_stress/_delete_form.html.twig') }}
                </div>

                <div class="flex gap-4">
                    <a href="{{ path('app_admin_question_stress_index') }}" class="btn btn-outline">
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-primary gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        Enregistrer les modifications
                    </button>
                </div>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}