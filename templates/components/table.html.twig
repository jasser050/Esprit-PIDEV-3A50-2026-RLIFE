{#
    Table Component

    Usage:
    {% include 'components/table.html.twig' with {
        headers: ['Name', 'Email', 'Status', 'Actions'],
        rows: [
            ['John Doe', 'john@example.com', '<span class="badge badge-success">Active</span>', '<button>Edit</button>'],
            ['Jane Doe', 'jane@example.com', '<span class="badge badge-warning">Pending</span>', '<button>Edit</button>']
        ],
        striped: true,
        hoverable: true,
        compact: false,
        emptyMessage: 'No data available',
        emptyIcon: 'inbox'
    } %}
#}

{% set striped = striped|default(false) %}
{% set hoverable = hoverable|default(true) %}
{% set compact = compact|default(false) %}
{% set emptyIcon = emptyIcon|default('inbox') %}

<div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 {{ class|default('') }}">
    <table class="w-full">
        <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                {% for header in headers|default([]) %}
                    <th class="text-left text-xs font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wider {{ compact ? 'px-4 py-2' : 'px-6 py-3' }}">{{ header }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
            {% if rows is defined and rows|length > 0 %}
                {% for row in rows %}
                    <tr class="{{ striped and loop.index is odd ? 'bg-slate-50/50 dark:bg-slate-800/30' : '' }} {{ hoverable ? 'hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors' : '' }}">
                        {% for cell in row %}
                            <td class="text-sm text-slate-700 dark:text-slate-300 {{ compact ? 'px-4 py-2' : 'px-6 py-4' }}">{{ cell|raw }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="{{ headers|length }}" class="px-6 py-12">
                        <div class="flex flex-col items-center justify-center text-center">
                            <div class="w-12 h-12 mb-3 rounded-xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center">
                                <i data-lucide="{{ emptyIcon }}" class="w-6 h-6 text-slate-400 dark:text-slate-500"></i>
                            </div>
                            <p class="text-slate-500 dark:text-slate-400">{{ emptyMessage|default('No data available') }}</p>
                        </div>
                    </td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</div>
