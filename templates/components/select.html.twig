{#
    Select Component

    Usage:
    {% include 'components/select.html.twig' with {
        name: 'country',
        label: 'Country',
        options: [
            { value: 'fr', label: 'France' },
            { value: 'us', label: 'United States' }
        ],
        value: 'fr',
        placeholder: 'Select a country',
        hint: 'Choose your country',
        error: '',
        icon: 'globe',       // Lucide icon name
        required: true,
        disabled: false
    } %}
#}

{% set required = required|default(false) %}
{% set disabled = disabled|default(false) %}

<div class="space-y-1.5 {{ wrapperClass|default('') }}">
    {% if label is defined and label %}
        <label for="{{ name }}" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
            {{ label }}
            {% if required %}<span class="text-danger-500 ml-0.5">*</span>{% endif %}
        </label>
    {% endif %}

    <div class="relative">
        {% if icon is defined and icon %}
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <i data-lucide="{{ icon }}" class="w-5 h-5 text-slate-400"></i>
            </div>
        {% endif %}

        <select
            id="{{ name }}"
            name="{{ name }}"
            {% if required %}required{% endif %}
            {% if disabled %}disabled{% endif %}
            class="w-full px-4 py-2.5 pr-10 text-sm bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-slate-100 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed appearance-none {{ icon is defined and icon ? 'pl-11' : '' }} {{ error is defined and error ? 'border-danger-500 focus:ring-danger-500' : '' }} {{ class|default('') }}"
            {% if error is defined and error %}aria-invalid="true" aria-describedby="{{ name }}-error"{% endif %}
        >
            {% if placeholder is defined and placeholder %}
                <option value="" disabled {{ value is not defined or value == '' ? 'selected' : '' }}>{{ placeholder }}</option>
            {% endif %}
            {% for option in options|default([]) %}
                <option value="{{ option.value }}" {{ value is defined and value == option.value ? 'selected' : '' }}>
                    {{ option.label }}
                </option>
            {% endfor %}
        </select>

        <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none">
            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
        </div>
    </div>

    {% if error is defined and error %}
        <p id="{{ name }}-error" class="flex items-center gap-1.5 text-sm text-danger-600 dark:text-danger-400">
            <i data-lucide="alert-circle" class="w-4 h-4"></i>
            {{ error }}
        </p>
    {% elseif hint is defined and hint %}
        <p class="text-sm text-slate-500 dark:text-slate-400">{{ hint }}</p>
    {% endif %}
</div>
