{#
    Badge/Chip Component

    Usage:
    {% include 'components/badge.html.twig' with {
        label: 'Active',
        variant: 'success',  // primary, secondary, accent, success, warning, danger, gray
        size: 'md',          // sm, md
        dot: false,          // Show dot indicator
        removable: false,    // Show remove button
        icon: 'check'        // Lucide icon name
    } %}
#}

{% set variant = variant|default('primary') %}
{% set size = size|default('md') %}
{% set dot = dot|default(false) %}
{% set removable = removable|default(false) %}

{% set variantClasses = {
    'primary': 'bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300',
    'secondary': 'bg-secondary-100 dark:bg-secondary-900/30 text-secondary-700 dark:text-secondary-300',
    'accent': 'bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300',
    'success': 'bg-success-100 dark:bg-success-900/30 text-success-700 dark:text-success-300',
    'warning': 'bg-warning-100 dark:bg-warning-900/30 text-warning-700 dark:text-warning-300',
    'danger': 'bg-danger-100 dark:bg-danger-900/30 text-danger-700 dark:text-danger-300',
    'gray': 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'
} %}

{% set sizeClasses = {
    'sm': 'text-xs px-2 py-0.5 gap-1',
    'md': 'text-xs px-2.5 py-1 gap-1.5'
} %}

{% set dotColors = {
    'primary': 'bg-primary-500',
    'secondary': 'bg-secondary-500',
    'accent': 'bg-accent-500',
    'success': 'bg-success-500',
    'warning': 'bg-warning-500',
    'danger': 'bg-danger-500',
    'gray': 'bg-slate-500'
} %}

<span class="inline-flex items-center font-medium rounded-full {{ variantClasses[variant] }} {{ sizeClasses[size] }} {{ class|default('') }}">
    {% if dot %}
        <span class="w-1.5 h-1.5 rounded-full {{ dotColors[variant] }}"></span>
    {% endif %}
    {% if icon is defined and icon %}
        <i data-lucide="{{ icon }}" class="w-3 h-3"></i>
    {% endif %}
    {{ label }}
    {% if removable %}
        <button type="button" class="hover:opacity-70 transition-opacity -mr-0.5" aria-label="Remove">
            <i data-lucide="x" class="w-3 h-3"></i>
        </button>
    {% endif %}
</span>
