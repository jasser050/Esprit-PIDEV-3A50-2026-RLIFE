{#
    Button Component

    Usage:
    {% include 'components/button.html.twig' with {
        label: 'Click me',
        variant: 'primary',  // primary, secondary, accent, ghost, outline, danger, success
        size: 'md',          // sm, md, lg
        icon: 'plus',        // Lucide icon name
        iconPosition: 'left', // left, right
        type: 'button',      // button, submit, reset
        href: '/path',       // If set, renders as <a> instead of <button>
        disabled: false,
        fullWidth: false,
        loading: false,
        class: ''            // Additional classes
    } %}
#}

{% set variant = variant|default('primary') %}
{% set size = size|default('md') %}
{% set type = type|default('button') %}
{% set iconPosition = iconPosition|default('left') %}
{% set disabled = disabled|default(false) %}
{% set fullWidth = fullWidth|default(false) %}
{% set loading = loading|default(false) %}

{% set variantClasses = {
    'primary': 'bg-primary-600 hover:bg-primary-700 text-white shadow-sm focus:ring-primary-500',
    'secondary': 'bg-secondary-600 hover:bg-secondary-700 text-white shadow-sm focus:ring-secondary-500',
    'accent': 'bg-accent-500 hover:bg-accent-600 text-white shadow-sm focus:ring-accent-500',
    'ghost': 'bg-transparent hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 focus:ring-slate-500',
    'outline': 'bg-transparent border-2 border-slate-300 dark:border-slate-600 hover:border-slate-400 dark:hover:border-slate-500 text-slate-700 dark:text-slate-300 focus:ring-slate-500',
    'danger': 'bg-danger-600 hover:bg-danger-700 text-white shadow-sm focus:ring-danger-500',
    'success': 'bg-success-600 hover:bg-success-700 text-white shadow-sm focus:ring-success-500'
} %}

{% set sizeClasses = {
    'sm': 'px-3 py-1.5 text-sm gap-1.5',
    'md': 'px-4 py-2.5 text-sm gap-2',
    'lg': 'px-6 py-3 text-base gap-2.5'
} %}

{% set iconSizes = {
    'sm': 'w-4 h-4',
    'md': 'w-4 h-4',
    'lg': 'w-5 h-5'
} %}

{% set baseClasses = 'inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-900 disabled:opacity-50 disabled:cursor-not-allowed' %}
{% set allClasses = [baseClasses, variantClasses[variant], sizeClasses[size], fullWidth ? 'w-full' : '', class|default('')]|join(' ')|trim %}

{% if href is defined and href %}
    <a href="{{ href }}" class="{{ allClasses }}" {% if disabled %}aria-disabled="true" tabindex="-1"{% endif %}>
        {% if loading %}
            <svg class="animate-spin {{ iconSizes[size] }}" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        {% elseif icon is defined and icon and iconPosition == 'left' %}
            <i data-lucide="{{ icon }}" class="{{ iconSizes[size] }}"></i>
        {% endif %}
        {{ label|default('Button') }}
        {% if icon is defined and icon and iconPosition == 'right' and not loading %}
            <i data-lucide="{{ icon }}" class="{{ iconSizes[size] }}"></i>
        {% endif %}
    </a>
{% else %}
    <button type="{{ type }}" class="{{ allClasses }}" {% if disabled or loading %}disabled{% endif %}>
        {% if loading %}
            <svg class="animate-spin {{ iconSizes[size] }}" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
        {% elseif icon is defined and icon and iconPosition == 'left' %}
            <i data-lucide="{{ icon }}" class="{{ iconSizes[size] }}"></i>
        {% endif %}
        {{ label|default('Button') }}
        {% if icon is defined and icon and iconPosition == 'right' and not loading %}
            <i data-lucide="{{ icon }}" class="{{ iconSizes[size] }}"></i>
        {% endif %}
    </button>
{% endif %}
