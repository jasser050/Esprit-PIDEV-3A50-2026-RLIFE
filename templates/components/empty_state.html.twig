{#
    Empty State Component

    Usage:
    {% include 'components/empty_state.html.twig' with {
        icon: 'inbox',       // Lucide icon name
        title: 'No items found',
        description: 'Get started by creating your first item.',
        action: {
            label: 'Create Item',
            href: '/items/new',
            icon: 'plus',
            variant: 'primary'
        }
    } %}
#}

{% set icon = icon|default('inbox') %}

<div class="flex flex-col items-center justify-center text-center py-12 px-4 {{ class|default('') }}">
    <div class="w-16 h-16 mb-4 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
        <i data-lucide="{{ icon }}" class="w-8 h-8 text-slate-400 dark:text-slate-500"></i>
    </div>

    <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">
        {{ title|default('No items yet') }}
    </h3>

    {% if description is defined and description %}
        <p class="text-slate-500 dark:text-slate-400 mb-6 max-w-sm">
            {{ description }}
        </p>
    {% endif %}

    {% if action is defined and action %}
        {% include 'components/button.html.twig' with {
            label: action.label,
            href: action.href,
            variant: action.variant|default('primary'),
            icon: action.icon|default(null)
        } %}
    {% endif %}
</div>
