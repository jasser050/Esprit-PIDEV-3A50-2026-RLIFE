{#
    Modal Component

    Usage:
    {% include 'components/modal.html.twig' with {
        id: 'my-modal',
        title: 'Modal Title',
        size: 'md',         // sm, md, lg, xl, full
        closable: true,
        body: 'Modal content here',
        footer: '<button class="btn btn-primary">Save</button>'
    } %}

    Trigger with:
    <button data-action="click->modal#open" data-modal-id-param="my-modal">Open Modal</button>
#}

{% set size = size|default('md') %}
{% set closable = closable|default(true) %}

{% set sizeClasses = {
    'sm': 'max-w-sm',
    'md': 'max-w-lg',
    'lg': 'max-w-2xl',
    'xl': 'max-w-4xl',
    'full': 'max-w-full mx-4'
} %}

<div id="{{ id }}" class="fixed inset-0 z-50 hidden" data-controller="modal" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title">
    <!-- Backdrop -->
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" {% if closable %}data-action="click->modal#close"{% endif %}></div>

    <!-- Modal container -->
    <div class="fixed inset-0 overflow-y-auto">
        <div class="flex min-h-full items-center justify-center p-4">
            <!-- Modal content -->
            <div class="relative w-full {{ sizeClasses[size] }} bg-white dark:bg-slate-800 rounded-2xl shadow-xl transform transition-all {{ class|default('') }}">
                <!-- Header -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 id="{{ id }}-title" class="text-lg font-semibold text-slate-900 dark:text-white">{{ title|default('Modal') }}</h3>
                    {% if closable %}
                        <button type="button" class="p-2 -mr-2 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors" data-action="click->modal#close" aria-label="Close">
                            <i data-lucide="x" class="w-5 h-5"></i>
                        </button>
                    {% endif %}
                </div>

                <!-- Body -->
                <div class="px-6 py-4">
                    {{ body|default('')|raw }}
                </div>

                <!-- Footer -->
                {% if footer is defined and footer %}
                    <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 rounded-b-2xl">
                        {{ footer|raw }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
