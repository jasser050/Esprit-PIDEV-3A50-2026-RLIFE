{#
    Page Header Component

    Usage (simple - HTML string):
    {% include 'components/page_header.html.twig' with {
        title: 'Page Title',
        subtitle: 'Optional description',
        actions: '<a href="/new" class="btn btn-primary">Add New</a>'
    } %}

    Usage (new - array actions):
    {% include 'components/page_header.html.twig' with {
        title: 'Stress & Wellbeing',
        subtitle: 'Track your mental health',
        actions: [
            { label: 'Coping Tools', url: path('app_wellbeing_tools'), variant: 'secondary', icon: '♥' },
            { label: 'Daily Check-in', url: path('app_wellbeing_checkin_new'), variant: 'primary', icon: '+' }
        ]
    } %}
#}

<div class="mb-8 {{ class|default('') }}">
    {% if backLink is defined and backLink %}
        <a href="{{ backLink.href }}"
           class="inline-flex items-center gap-1.5 text-sm text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 mb-4 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            {{ backLink.label|default('Back') }}
        </a>
    {% endif %}

    <div class="flex items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold">{{ title|default('') }}</h1>
            {% if subtitle is defined and subtitle %}
                <p class="mt-1 text-sm text-light-muted dark:text-dark-muted">{{ subtitle }}</p>
            {% endif %}
        </div>

        {# ✅ ACTIONS: supporte STRING (ancien) + ARRAY (nouveau) #}
        {% if actions is defined and actions %}
            {# CASE 1: actions est un tableau [{label,url,...}, ...] #}
            {% if actions is iterable %}
                {% if actions|length > 0 %}
                    <div class="flex items-center gap-2">
                        {% for action in actions %}
                            <a href="{{ action.url }}"
                               class="btn btn-{{ action.variant|default('primary') }}">
                                {% if action.icon is defined and action.icon %}
                                    <span class="mr-2 inline-flex items-center">
                                        {{ action.icon }}
                                    </span>
                                {% endif %}
                                {{ action.label }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

            {# CASE 2: actions est un string HTML (ancien usage) #}
            {% else %}
                <div class="flex items-center gap-2">
                    {{ actions|raw }}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
