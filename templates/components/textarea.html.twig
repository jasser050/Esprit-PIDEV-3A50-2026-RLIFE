{#
    Textarea Component

    Usage:
    {% include 'components/textarea.html.twig' with {
        name: 'description',
        label: 'Description',
        placeholder: 'Enter description...',
        value: '',
        rows: 4,
        hint: 'Max 500 characters',
        error: '',
        required: false,
        disabled: false,
        resize: 'vertical'   // none, vertical, horizontal, both
    } %}
#}

{% set rows = rows|default(4) %}
{% set required = required|default(false) %}
{% set disabled = disabled|default(false) %}
{% set resize = resize|default('vertical') %}

{% set resizeClasses = {
    'none': 'resize-none',
    'vertical': 'resize-y',
    'horizontal': 'resize-x',
    'both': 'resize'
} %}

<div class="space-y-1.5 {{ wrapperClass|default('') }}">
    {% if label is defined and label %}
        <label for="{{ name }}" class="block text-sm font-medium text-slate-700 dark:text-slate-300">
            {{ label }}
            {% if required %}<span class="text-danger-500 ml-0.5">*</span>{% endif %}
        </label>
    {% endif %}

    <textarea
        id="{{ name }}"
        name="{{ name }}"
        rows="{{ rows }}"
        {% if placeholder is defined %}placeholder="{{ placeholder }}"{% endif %}
        {% if required %}required{% endif %}
        {% if disabled %}disabled{% endif %}
        class="w-full px-4 py-3 text-sm bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent disabled:opacity-50 disabled:cursor-not-allowed {{ resizeClasses[resize] }} {{ error is defined and error ? 'border-danger-500 focus:ring-danger-500' : '' }} {{ class|default('') }}"
        {% if error is defined and error %}aria-invalid="true" aria-describedby="{{ name }}-error"{% endif %}
    >{{ value|default('') }}</textarea>

    {% if error is defined and error %}
        <p id="{{ name }}-error" class="flex items-center gap-1.5 text-sm text-danger-600 dark:text-danger-400">
            <i data-lucide="alert-circle" class="w-4 h-4"></i>
            {{ error }}
        </p>
    {% elseif hint is defined and hint %}
        <p class="text-sm text-slate-500 dark:text-slate-400">{{ hint }}</p>
    {% endif %}
</div>
