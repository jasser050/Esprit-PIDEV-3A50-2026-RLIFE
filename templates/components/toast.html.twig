{#
    Toast Notification Component

    Usage:
    {% include 'components/toast.html.twig' with {
        message: 'Operation successful!',
        type: 'success',     // success, error, warning, info
        dismissible: true,
        duration: 5000       // Auto-dismiss in ms (0 = no auto-dismiss)
    } %}
#}

{% set type = type|default('info') %}
{% set dismissible = dismissible|default(true) %}
{% set duration = duration|default(5000) %}

{% set typeConfig = {
    'success': {
        'bg': 'bg-success-50 dark:bg-success-900/30',
        'border': 'border-success-200 dark:border-success-800',
        'text': 'text-success-800 dark:text-success-200',
        'icon': 'check-circle'
    },
    'error': {
        'bg': 'bg-danger-50 dark:bg-danger-900/30',
        'border': 'border-danger-200 dark:border-danger-800',
        'text': 'text-danger-800 dark:text-danger-200',
        'icon': 'x-circle'
    },
    'warning': {
        'bg': 'bg-warning-50 dark:bg-warning-900/30',
        'border': 'border-warning-200 dark:border-warning-800',
        'text': 'text-warning-800 dark:text-warning-200',
        'icon': 'alert-triangle'
    },
    'info': {
        'bg': 'bg-primary-50 dark:bg-primary-900/30',
        'border': 'border-primary-200 dark:border-primary-800',
        'text': 'text-primary-800 dark:text-primary-200',
        'icon': 'info'
    }
} %}

{% set config = typeConfig[type] %}

<div class="flex items-center gap-3 px-4 py-3 rounded-xl border {{ config.bg }} {{ config.border }} {{ config.text }} shadow-lg animate-slide-in-right" data-controller="toast" data-toast-duration-value="{{ duration }}" role="alert">
    <i data-lucide="{{ config.icon }}" class="w-5 h-5 flex-shrink-0"></i>
    <p class="text-sm font-medium flex-1">{{ message }}</p>
    {% if dismissible %}
        <button type="button" class="flex-shrink-0 p-1 -mr-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors" data-action="click->toast#dismiss" aria-label="Dismiss">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    {% endif %}
</div>
