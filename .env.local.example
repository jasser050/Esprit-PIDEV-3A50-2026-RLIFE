# Copy this file to .env.local and configure your local settings
# .env.local is gitignored and should contain your actual credentials

###> symfony/mailer ###
# Configure your email service credentials here
# For Gmail: Use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
MAILER_DSN=gmail+smtp://YOUR_EMAIL@gmail.com:YOUR_APP_PASSWORD@default
###< symfony/mailer ###

###> symfony/admin-mailer ###
# The sender email address for admin emails
ADMIN_SENDER_EMAIL=admin@example.com
ADMIN_SENDER_NAME="PIDEV Admin"
###< symfony/admin-mailer ###
