<script>
const MODEL_URL = '/models';
let modelsLoaded = false;
let stream = null;
let faceDescriptorData = null;

function el(id) { return document.getElementById(id); }

function setFaceStatus(msg, color) {
    var colors = { indigo:'#6366f1', purple:'#a855f7', green:'#10b981', red:'#ef4444', gray:'#94a3b8' };
    var e = el('face-status-msg');
    e.style.color = colors[color] || '#94a3b8';
    e.textContent = msg;
}

function stopStream() {
    if (stream) {
        stream.getTracks().forEach(function(t) { t.stop(); });
        stream = null;
    }
    var video = el('face-video');
    if (video) { video.pause(); video.srcObject = null; }
}

async function loadModels() {
    if (modelsLoaded) return;
    await Promise.all([
        faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
        faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
        faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL),
    ]);
    modelsLoaded = true;
}

async function openFaceCamera() {
    stopStream();
    setFaceStatus('Loading models…', 'indigo');

    try { await loadModels(); }
    catch(e) { setFaceStatus('Model load failed: ' + e.message, 'red'); return; }

    setFaceStatus('Starting camera…', 'indigo');

    try {
        stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
    } catch(e) {
        var msgs = {
            NotAllowedError:      'Permission denied — allow camera in browser settings.',
            PermissionDeniedError:'Permission denied — allow camera in browser settings.',
            NotFoundError:        'No camera detected on this device.',
            NotReadableError:     'Camera is busy — close other apps using it.',
            OverconstrainedError: 'Camera does not support the requested settings.',
        };
        setFaceStatus(msgs[e.name] || 'Camera error: ' + e.message, 'red');
        return;
    }

    // Attach stream directly to the existing video element
    var video = el('face-video');
    video.srcObject = stream;

    // Poll until the first frame is decoded (readyState >= 2 and videoWidth > 0)
    var poll = function() {
        if (video.readyState >= 2 && video.videoWidth > 0) {
            video.style.display = 'block';
            video.play().catch(function() {});
            el('face-idle').style.display            = 'none';
            el('face-scanning').style.display        = 'block';
            el('face-success-overlay').style.display = 'none';
            el('face-open-btn').style.display        = 'none';
            el('face-capture-btn').style.display     = 'flex';
            el('face-retake-btn').style.display      = 'none';
            el('face-status-dot').style.background   = '#a855f7';
            setFaceStatus('Centre your face in the circle, then click Capture', 'purple');
        } else {
            setTimeout(poll, 100);
        }
    };
    setTimeout(poll, 200);
}

async function captureFace() {
    var video = el('face-video');
    if (!stream || video.readyState < 2 || video.videoWidth === 0) {
        setFaceStatus('Camera not ready — please wait.', 'red'); return;
    }

    setFaceStatus('Analysing…', 'indigo');

    var offscreen = document.createElement('canvas');
    offscreen.width  = video.videoWidth;
    offscreen.height = video.videoHeight;
    offscreen.getContext('2d').drawImage(video, 0, 0);

    var detection;
    try {
        detection = await faceapi
            .detectSingleFace(offscreen, new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.4 }))
            .withFaceLandmarks()
            .withFaceDescriptor();
    } catch(e) {
        setFaceStatus('Detection error: ' + e.message, 'red'); return;
    }

    if (!detection) {
        setFaceStatus('No face detected — ensure good lighting and centre your face.', 'red');
        return;
    }

    faceDescriptorData = Array.from(detection.descriptor);
    el('face_descriptor_input').value = JSON.stringify(faceDescriptorData);

    var canvas = el('face-canvas');
    canvas.width  = offscreen.width;
    canvas.height = offscreen.height;
    canvas.getContext('2d').drawImage(offscreen, 0, 0);
    canvas.style.display = 'block';
    video.style.display  = 'none';
    stopStream();

    el('face-scanning').style.display        = 'none';
    el('face-success-overlay').style.display = 'flex';
    el('face-capture-btn').style.display     = 'none';
    el('face-retake-btn').style.display      = 'flex';
    el('face-status-dot').style.background   = '#10b981';
    setFaceStatus('Face captured! Click Create account to finish.', 'green');
    lucide.createIcons();
}

function retakeFace() {
    faceDescriptorData = null;
    el('face_descriptor_input').value = '';
    stopStream();
    el('face-video').style.display           = 'none';
    el('face-canvas').style.display          = 'none';
    el('face-success-overlay').style.display = 'none';
    el('face-scanning').style.display        = 'none';
    el('face-retake-btn').style.display      = 'none';
    el('face-capture-btn').style.display     = 'none';
    el('face-idle').style.display            = 'flex';
    el('face-open-btn').style.display        = 'flex';
    el('face-status-dot').style.background   = '#94a3b8';
    setFaceStatus('Click "Open Camera" to try again.', 'gray');
}

window.addEventListener('beforeunload', stopStream);
window.addEventListener('pagehide', stopStream);
</script>

