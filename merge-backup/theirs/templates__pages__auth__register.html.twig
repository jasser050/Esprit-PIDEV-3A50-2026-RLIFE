{% extends 'layouts/public.html.twig' %}

{% block title %}Create your account{% endblock %}

{% block styles %}
{{ parent() }}
<style>
    spline-viewer {
        width: 100% !important;
        height: 100% !important;
        background: transparent !important;
    }

    .spline-viewer {
        z-index: 1 !important;
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<!-- Spline 3D Viewer -->
<script type="module" src="https://unpkg.com/@splinetool/viewer@1.12.57/build/spline-viewer.js"></script>
<!-- face-api.js for Face ID -->
<script src="/js/face-api.min.js"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen flex dark" data-controller="theme wizard password" data-wizard-total-value="3">
    <!-- Left Panel - Form -->
    <div class="flex-1 flex flex-col justify-center px-4 sm:px-6 lg:px-8 xl:px-12 bg-slate-900 pt-16 lg:pt-0">
        <div class="w-full max-w-[480px] mx-auto">
            <!-- Logo and back link -->
            <div class="mb-8">
                <a href="{{ path('app_landing') }}" class="inline-flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-colors mb-8">
                    <i data-lucide="arrow-left" class="w-4 h-4"></i>
                    Back to home
                </a>

                <a href="{{ path('app_landing') }}" class="flex items-center gap-2.5 mb-2">
                    <img src="{{ asset('image/logo0.png') }}" alt="RLIFE Logo" class="w-14 h-14 object-cover">
                    <span class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">RLIFE</span>
                </a>
            </div>

            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    Create your account
                </h1>
                <p class="mt-2 text-slate-600 dark:text-slate-300">
                    Start organising your semester in minutes
                </p>
            </div>

            <!-- Flash Messages -->
            {% for message in app.flashes('error') %}
            <div class="p-4 mb-4 bg-danger-50 dark:bg-danger-900/20 border border-danger-200 dark:border-danger-800 rounded-xl animate-fade-in">
                <div class="flex items-start gap-3">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-danger-800 dark:text-danger-200">Error</p>
                        <p class="text-sm text-danger-600 dark:text-danger-300 mt-0.5">{{ message }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}

            {% for message in app.flashes('success') %}
            <div class="p-4 mb-4 bg-success-50 dark:bg-success-900/20 border border-success-200 dark:border-success-800 rounded-xl animate-fade-in">
                <div class="flex items-start gap-3">
                    <i data-lucide="check-circle" class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5"></i>
                    <div>
                        <p class="font-medium text-success-800 dark:text-success-200">Success</p>
                        <p class="text-sm text-success-600 dark:text-success-300 mt-0.5">{{ message }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}

            <!-- Step Indicator -->
            <div class="flex items-center gap-4 mb-8">
                <div class="flex items-center gap-3" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-primary-600 border-primary-600 text-white flex items-center justify-center text-sm font-semibold transition-colors">
                        1
                    </div>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Account</span>
                    <div class="step-line w-8 h-0.5 bg-slate-200 dark:bg-slate-700 transition-colors"></div>
                </div>
                <div class="flex items-center gap-3" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600 text-slate-500 flex items-center justify-center text-sm font-semibold transition-colors">
                        2
                    </div>
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Preferences</span>
                    <div class="step-line w-8 h-0.5 bg-slate-200 dark:bg-slate-700 transition-colors"></div>
                </div>
                <div class="flex items-center gap-3" data-wizard-target="indicator">
                    <div class="step-circle w-8 h-8 rounded-full border-2 bg-white dark:bg-slate-800 border-slate-300 dark:border-slate-600 text-slate-500 flex items-center justify-center text-sm font-semibold transition-colors">
                        3
                    </div>
                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Face ID</span>
                </div>
            </div>

            <!-- Registration Form -->
            <form action="{{ path('app_register') }}" method="POST" data-turbo="false" novalidate>
                <!-- Step 1: Account Details -->
                <div data-wizard-target="step" class="space-y-5">
                    <!-- First Name -->
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="first_name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                First name
                            </label>
                            <input
                                type="text"
                                id="first_name"
                                name="first_name"
                                value="{{ old.first_name ?? '' }}"
                                autocomplete="given-name"
                                placeholder="John"
                                class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border {% if errors.first_name is defined %}border-red-500 dark:border-red-400{% elseif submitted and 'first_name' in validFields %}border-green-500 dark:border-green-400{% else %}border-slate-200 dark:border-slate-700{% endif %} rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                            >
                            <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Min 2 characters, letters only (spaces, hyphens, apostrophes allowed)</p>
                            {% if errors.first_name is defined %}
                                <div class="mt-2 flex items-start gap-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                                    <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                                    <span>{{ errors.first_name }}</span>
                                </div>
                            {% endif %}
                        </div>
                        <div>
                            <label for="last_name" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                                Last name
                            </label>
                            <input
                                type="text"
                                id="last_name"
                                name="last_name"
                                value="{{ old.last_name ?? '' }}"
                                autocomplete="family-name"
                                placeholder="Doe"
                                class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border {% if errors.last_name is defined %}border-red-500 dark:border-red-400{% elseif submitted and 'last_name' in validFields %}border-green-500 dark:border-green-400{% else %}border-slate-200 dark:border-slate-700{% endif %} rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                            >
                            <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Min 2 characters, letters only (spaces, hyphens, apostrophes allowed)</p>
                            {% if errors.last_name is defined %}
                                <div class="mt-2 flex items-start gap-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                                    <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                                    <span>{{ errors.last_name }}</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Username -->
                    <div>
                        <label for="username" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Username
                        </label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            value="{{ old.username ?? '' }}"
                            autocomplete="username"
                            placeholder="johndoe"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border {% if errors.username is defined %}border-red-500 dark:border-red-400{% elseif submitted and 'username' in validFields %}border-green-500 dark:border-green-400{% else %}border-slate-200 dark:border-slate-700{% endif %} rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Min 3 characters, letters, numbers and underscores only</p>
                        {% if errors.username is defined %}
                            <div class="mt-2 flex items-start gap-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                                <span>{{ errors.username }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Email address
                        </label>
                        <input
                            type="text"
                            id="email"
                            name="email"
                            value="{{ old.email ?? '' }}"
                            autocomplete="email"
                            placeholder="you@university.edu"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border {% if errors.email is defined %}border-red-500 dark:border-red-400{% elseif submitted and 'email' in validFields %}border-green-500 dark:border-green-400{% else %}border-slate-200 dark:border-slate-700{% endif %} rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Use your .edu email for free access</p>
                        {% if errors.email is defined %}
                            <div class="mt-2 flex items-start gap-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                                <span>{{ errors.email }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Password -->
                    <div>
                        <label for="password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Password
                        </label>
                        <div class="relative">
                            <input
                                type="password"
                                id="password"
                                name="password"
                                autocomplete="new-password"
                                placeholder="Create a strong password"
                                data-password-target="input"
                                class="block w-full px-4 py-3 pr-12 bg-slate-50 dark:bg-slate-800 border {% if errors.password is defined %}border-red-500 dark:border-red-400{% elseif submitted and 'password' in validFields %}border-green-500 dark:border-green-400{% else %}border-slate-200 dark:border-slate-700{% endif %} rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                            >
                            <button
                                type="button"
                                data-password-target="toggle"
                                data-action="click->password#toggleVisibility"
                                class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 transition-colors"
                            >
                                <i data-lucide="eye" class="w-5 h-5 icon-show"></i>
                                <i data-lucide="eye-off" class="w-5 h-5 icon-hide hidden"></i>
                            </button>
                        </div>
                        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Min 8 characters, must include uppercase, lowercase and number</p>
                        {% if errors.password is defined %}
                            <div class="mt-2 flex items-start gap-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                                <span>{{ errors.password }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label for="confirm_password" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5">
                            Confirm password
                        </label>
                        <input
                            type="password"
                            id="confirm_password"
                            name="confirm_password"
                            autocomplete="new-password"
                            placeholder="Confirm your password"
                            class="block w-full px-4 py-3 bg-slate-50 dark:bg-slate-800 border {% if errors.confirm_password is defined %}border-red-500 dark:border-red-400{% elseif submitted and 'confirm_password' in validFields %}border-green-500 dark:border-green-400{% else %}border-slate-200 dark:border-slate-700{% endif %} rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-colors"
                        >
                        {% if errors.confirm_password is defined %}
                            <div class="mt-2 flex items-start gap-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                                <span>{{ errors.confirm_password }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Terms -->
                    <div>
                        <div class="flex items-start gap-3">
                            <input
                                type="checkbox"
                                id="terms"
                                name="terms"
                                class="mt-1 w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-primary-600 focus:ring-primary-500 bg-slate-50 dark:bg-slate-800"
                            >
                            <label for="terms" class="text-sm text-slate-600 dark:text-slate-300">
                                I agree to the <a href="#" class="font-medium text-primary-600 dark:text-primary-400 hover:underline">Terms of Service</a> and <a href="#" class="font-medium text-primary-600 dark:text-primary-400 hover:underline">Privacy Policy</a>
                            </label>
                        </div>
                        {% if errors.terms is defined %}
                            <div class="mt-2 flex items-start gap-2 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg px-3 py-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 mt-0.5 flex-shrink-0"></i>
                                <span>{{ errors.terms }}</span>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Step 2: Preferences -->
                <div data-wizard-target="step" class="hidden space-y-6">
                    <!-- Gender -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">Gender</label>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="relative cursor-pointer">
                                <input type="radio" name="gender" value="male" class="peer sr-only" checked>
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Male</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="gender" value="female" class="peer sr-only">
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="user" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Female</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Study Level -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">What's your study level?</label>
                        <div class="grid grid-cols-3 gap-3">
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="beginner" class="peer sr-only" checked>
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="sprout" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Beginner</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="intermediate" class="peer sr-only">
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="trending-up" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Intermediate</span>
                                </div>
                            </label>
                            <label class="relative cursor-pointer">
                                <input type="radio" name="study_level" value="advanced" class="peer sr-only">
                                <div class="p-4 text-center bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl peer-checked:border-primary-500 peer-checked:bg-primary-50 dark:peer-checked:bg-primary-900/20 transition-colors">
                                    <i data-lucide="rocket" class="w-6 h-6 mx-auto mb-2 text-slate-400"></i>
                                    <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Advanced</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Weekly Goal -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">
                            Weekly study goal: <span id="goal-display" class="text-primary-600 dark:text-primary-400">5 hours</span>
                        </label>
                        <input type="range" name="weekly_goal" min="1" max="10" value="5"
                            class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-full appearance-none cursor-pointer accent-primary-600"
                            oninput="document.getElementById('goal-display').textContent = this.value + ' hours'">
                        <div class="flex justify-between text-xs text-slate-400 dark:text-slate-500 mt-1">
                            <span>1h</span><span>10h</span>
                        </div>
                    </div>

                    <!-- Interests -->
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-3">What are you interested in?</label>
                        <div class="flex flex-wrap gap-2">
                            {% set interests = ['Web Dev', 'Data Science', 'Design', 'Business', 'Languages', 'Math', 'Science', 'Arts', 'Engineering'] %}
                            {% for interest in interests %}
                            <label class="cursor-pointer">
                                <input type="checkbox" name="interests[]" value="{{ interest|lower|replace({' ': '_'}) }}" class="peer sr-only">
                                <span class="inline-flex px-4 py-2 text-sm font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-full border-2 border-transparent peer-checked:bg-primary-100 dark:peer-checked:bg-primary-900/30 peer-checked:text-primary-700 dark:peer-checked:text-primary-300 peer-checked:border-primary-300 dark:peer-checked:border-primary-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                                    {{ interest }}
                                </span>
                            </label>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Notifications -->
                    <div class="p-4 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700">
                        <div class="flex items-start gap-3">
                            <input type="checkbox" id="notifications" name="notifications" checked
                                class="mt-1 w-4 h-4 rounded border-slate-300 dark:border-slate-600 text-primary-600 focus:ring-primary-500 bg-white dark:bg-slate-700">
                            <div>
                                <label for="notifications" class="text-sm font-medium text-slate-700 dark:text-slate-300">Enable gentle reminders</label>
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">We'll send you helpful study reminders and deadline notifications</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <!-- Hidden face descriptor field -->
                <input type="hidden" name="face_descriptor" id="face_descriptor_input">

                <!-- Step 3: Face ID Setup -->
                <div data-wizard-target="step" class="hidden space-y-5">
                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-3" style="background:linear-gradient(135deg,#6366f1,#a855f7);">
                            <i data-lucide="scan-face" class="w-7 h-7 text-white"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Face ID Setup</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Register your face to log in instantly</p>
                    </div>

                    <!-- Camera viewport -->
                    <!-- Outer wrapper: holds the gradient ring + status dot, no overflow clipping -->
                    <div class="relative mx-auto" style="width:246px;height:246px;">

                        <!-- Gradient ring: padding creates the border effect, inner div clips the video -->
                        <div id="face-ring" style="position:absolute;inset:0;border-radius:50%;padding:3px;background:linear-gradient(135deg,#6366f1,#a855f7,#ec4899);animation:ringPulse 2.5s ease-in-out infinite;">

                            <!-- Inner clipping circle: overflow:hidden clips video to circle shape -->
                            <!-- transform:translateZ(0) on the video fixes Chrome black-frame GPU bug -->
                            <div id="camera-container" style="width:100%;height:100%;border-radius:50%;background:#0f172a;overflow:hidden;position:relative;">

                                <!-- Live video feed -->
                                <video id="face-video" autoplay muted playsinline
                                    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:translateZ(0);display:none;"></video>

                                <!-- Frozen snapshot after capture -->
                                <canvas id="face-canvas"
                                    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none;"></canvas>

                                <!-- Idle placeholder -->
                                <div id="face-idle" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;">
                                    <i data-lucide="camera" class="w-12 h-12 text-slate-500 mb-1"></i>
                                    <span style="font-size:11px;color:#94a3b8;">Camera off</span>
                                </div>

                                <!-- Scan line animation -->
                                <div id="face-scanning" style="display:none;position:absolute;inset:0;pointer-events:none;">
                                    <div style="position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#a855f7,#6366f1,transparent);animation:scanLine 2s ease-in-out infinite;"></div>
                                </div>

                                <!-- Success overlay -->
