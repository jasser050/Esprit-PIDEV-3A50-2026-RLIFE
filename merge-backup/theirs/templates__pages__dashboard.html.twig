{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<!-- Avatar Container for Dashboard Animation -->
<div id="avatar-container" class="fixed inset-0 z-50 pointer-events-none"></div>

<div class="space-y-6 animate-fade-in">
    <!-- Welcome Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">
                Good {{ "now"|date("G") < 12 ? "morning" : ("now"|date("G") < 17 ? "afternoon" : "evening") }}, Student
            </h1>
            <p class="text-secondary-500 dark:text-secondary-400 mt-1">Here's what's happening with your studies today</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="card p-3 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-accent-400 to-accent-600 flex items-center justify-center">
                    <i data-lucide="flame" class="w-5 h-5 text-white"></i>
                </div>
                <div>
                    <p class="text-2xl font-bold text-secondary-900 dark:text-white">{{ stats.current_streak }}</p>
                    <p class="text-xs text-secondary-500 dark:text-secondary-400 font-medium">Day streak</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Due Soon -->
        <div class="card card-hover p-5">
            <div class="flex items-start justify-between">
                <div class="w-11 h-11 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                    <i data-lucide="clock" class="w-5 h-5 text-primary-600 dark:text-primary-400"></i>
                </div>
                <span class="badge badge-primary badge-pill">This week</span>
            </div>
            <div class="mt-4">
                <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.assignments_due_soon }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-1">Assignments due</p>
            </div>
        </div>

        <!-- Completed -->
        <div class="card card-hover p-5">
            <div class="flex items-start justify-between">
                <div class="w-11 h-11 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                    <i data-lucide="check-circle-2" class="w-5 h-5 text-success-600 dark:text-success-400"></i>
                </div>
                <span class="badge badge-success badge-pill">+3</span>
            </div>
            <div class="mt-4">
                <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.assignments_completed_this_week }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-1">Completed</p>
            </div>
        </div>

        <!-- Study Hours -->
        <div class="card card-hover p-5">
            <div class="flex items-start justify-between">
                <div class="w-11 h-11 rounded-xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                    <i data-lucide="timer" class="w-5 h-5 text-accent-600 dark:text-accent-400"></i>
                </div>
            </div>
            <div class="mt-4">
                <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.study_hours_this_week }}<span class="text-lg font-medium text-secondary-400">h</span></p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-1">Study time</p>
            </div>
        </div>

        <!-- Cards Reviewed -->
        <div class="card card-hover p-5">
            <div class="flex items-start justify-between">
                <div class="w-11 h-11 rounded-xl bg-warning-100 dark:bg-warning-900/30 flex items-center justify-center">
                    <i data-lucide="layers" class="w-5 h-5 text-warning-600 dark:text-warning-400"></i>
                </div>
            </div>
            <div class="mt-4">
                <p class="text-3xl font-bold text-secondary-900 dark:text-white">{{ stats.flashcards_reviewed_today }}</p>
                <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-1">Cards reviewed</p>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Study Time Chart -->
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                            <i data-lucide="bar-chart-3" class="w-4 h-4 text-primary-600 dark:text-primary-400"></i>
                        </div>
                        <div>
                            <h2 class="font-semibold text-secondary-900 dark:text-white">Study Time</h2>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400">Hours per day this week</p>
                        </div>
                    </div>
                    <span class="badge badge-primary badge-pill">This Week</span>
                </div>
            </div>
            <div class="p-5">
                <div class="h-64"
                     data-controller="chart"
                     data-chart-type-value="line"
                     data-chart-data-value='{{ {
                         "labels": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
                         "datasets": [{
                             "label": "Study Hours",
                             "data": [stats.study_hours_by_day.mon|default(2.5), stats.study_hours_by_day.tue|default(3.2), stats.study_hours_by_day.wed|default(4.1), stats.study_hours_by_day.thu|default(2.8), stats.study_hours_by_day.fri|default(3.5), stats.study_hours_by_day.sat|default(5.0), stats.study_hours_by_day.sun|default(4.2)],
                             "fill": true,
                             "colorKey": "primary"
                         }]
                     }|json_encode|e("html_attr") }}'>
                    <canvas data-chart-target="canvas"></canvas>
                </div>
            </div>
        </div>

        <!-- Weekly Progress Chart -->
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                            <i data-lucide="trending-up" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                        </div>
                        <div>
                            <h2 class="font-semibold text-secondary-900 dark:text-white">Weekly Progress</h2>
                            <p class="text-xs text-secondary-500 dark:text-secondary-400">Tasks completed vs pending</p>
                        </div>
                    </div>
                    <span class="badge badge-success badge-pill">+{{ stats.assignments_completed_this_week|default(3) }}</span>
                </div>
            </div>
            <div class="p-5">
                <div class="h-64"
                     data-controller="chart"
                     data-chart-type-value="bar"
                     data-chart-data-value='{{ {
                         "labels": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
                         "datasets": [{
                             "label": "Completed",
                             "data": [stats.tasks_completed_by_day.mon|default(3), stats.tasks_completed_by_day.tue|default(5), stats.tasks_completed_by_day.wed|default(4), stats.tasks_completed_by_day.thu|default(6), stats.tasks_completed_by_day.fri|default(2), stats.tasks_completed_by_day.sat|default(4), stats.tasks_completed_by_day.sun|default(3)],
                             "colorKey": "success"
                         }, {
                             "label": "Pending",
                             "data": [stats.tasks_pending_by_day.mon|default(2), stats.tasks_pending_by_day.tue|default(1), stats.tasks_pending_by_day.wed|default(3), stats.tasks_pending_by_day.thu|default(1), stats.tasks_pending_by_day.fri|default(4), stats.tasks_pending_by_day.sat|default(2), stats.tasks_pending_by_day.sun|default(2)],
                             "colorKey": "warning"
                         }]
                     }|json_encode|e("html_attr") }}'>
                    <canvas data-chart-target="canvas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Today's Schedule -->
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                            <i data-lucide="calendar" class="w-4 h-4 text-primary-600 dark:text-primary-400"></i>
                        </div>
                        <h2 class="font-semibold text-secondary-900 dark:text-white">Today's Schedule</h2>
                    </div>
                    <a href="{{ path('app_planning') }}" class="text-sm text-primary-600 dark:text-primary-400 hover:underline font-medium">View all</a>
                </div>
            </div>
            <div class="p-4 space-y-2">
                {% if today_events|length > 0 %}
                    {% for event in today_events|slice(0, 5) %}
                    <div class="flex items-center gap-3 p-3 rounded-xl hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors group">
                        <div class="w-1 h-12 rounded-full bg-{{ event.color }}-500 flex-shrink-0"></div>
                        <div class="flex-1 min-w-0">
                            <p class="font-medium text-secondary-900 dark:text-white truncate group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{{ event.title }}</p>
                            <div class="flex items-center gap-2 text-sm text-secondary-500 dark:text-secondary-400 mt-0.5">
                                <i data-lucide="clock" class="w-3 h-3"></i>
                                <span>{{ event.start_time }}</span>
                                {% if event.location %}
                                <span class="text-secondary-300 dark:text-secondary-600">·</span>
                                <i data-lucide="map-pin" class="w-3 h-3"></i>
                                <span class="truncate">{{ event.location }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <span class="badge badge-{{ event.color }} badge-pill text-2xs">{{ event.type|upper }}</span>
                    </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-state py-8">
                        <i data-lucide="calendar-off" class="w-12 h-12 text-slate-300 dark:text-slate-600"></i>
                        <p class="empty-state-title">No events today</p>
                        <p class="empty-state-description">Your schedule is clear for today</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Upcoming Assignments -->
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center">
                            <i data-lucide="clipboard-list" class="w-4 h-4 text-accent-600 dark:text-accent-400"></i>
                        </div>
                        <h2 class="font-semibold text-secondary-900 dark:text-white">Upcoming Tasks</h2>
                    </div>
                    <a href="{{ path('app_assignments') }}" class="text-sm text-primary-600 dark:text-primary-400 hover:underline font-medium">View all</a>
                </div>
            </div>
            <div class="p-4 space-y-2">
                {% for assignment in upcoming_assignments %}
                <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors group">
                    <div class="mt-0.5">
                        {% if assignment.status == 'completed' %}
                            <div class="w-5 h-5 rounded-full bg-success-500 flex items-center justify-center">
                                <i data-lucide="check" class="w-3 h-3 text-white"></i>
                            </div>
                        {% elseif assignment.status == 'in_progress' %}
                            <div class="w-5 h-5 rounded-full border-2 border-primary-500 border-t-transparent animate-spin"></div>
                        {% else %}
                            <div class="w-5 h-5 rounded-full border-2 border-secondary-300 dark:border-secondary-600 group-hover:border-primary-400 transition-colors"></div>
                        {% endif %}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-medium text-secondary-900 dark:text-white truncate">{{ assignment.title }}</p>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400 mt-0.5">{{ assignment.course }}</p>
                    </div>
                    <div class="text-right flex flex-col items-end gap-1">
                        <span class="badge badge-{{ assignment.priority == 'high' ? 'danger' : (assignment.priority == 'medium' ? 'warning' : 'success') }} badge-pill text-2xs">
                            {{ assignment.priority|upper }}
                        </span>
                        <p class="text-xs text-secondary-500 dark:text-secondary-400">{{ assignment.due_date|date('M j') }}</p>
                    </div>
                </div>
                {% else %}
                    <div class="empty-state py-8">
                        <i data-lucide="inbox" class="w-12 h-12 text-slate-300 dark:text-slate-600"></i>
                        <p class="empty-state-title">All caught up!</p>
                        <p class="empty-state-description">No upcoming assignments</p>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Activity Feed -->
        <div class="card overflow-hidden">
            <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-success-100 dark:bg-success-900/30 flex items-center justify-center">
                        <i data-lucide="activity" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                    </div>
                    <h2 class="font-semibold text-secondary-900 dark:text-white">Recent Activity</h2>
                </div>
            </div>
            <div class="p-4 space-y-3">
                {% for activity in activity_feed %}
                <div class="flex items-start gap-3">
                    <div class="w-8 h-8 rounded-lg
                        {% if activity.type == 'assignment' %}bg-primary-100 dark:bg-primary-900/30{% endif %}
                        {% if activity.type == 'flashcard' %}bg-warning-100 dark:bg-warning-900/30{% endif %}
                        {% if activity.type == 'streak' %}bg-accent-100 dark:bg-accent-900/30{% endif %}
                        {% if activity.type == 'course' %}bg-success-100 dark:bg-success-900/30{% endif %}
                        flex items-center justify-center flex-shrink-0">
                        {% if activity.icon == 'check' %}
                            <i data-lucide="check" class="w-4 h-4 text-primary-600 dark:text-primary-400"></i>
                        {% elseif activity.icon == 'cards' %}
                            <i data-lucide="layers" class="w-4 h-4 text-warning-600 dark:text-warning-400"></i>
                        {% elseif activity.icon == 'fire' %}
                            <i data-lucide="flame" class="w-4 h-4 text-accent-600 dark:text-accent-400"></i>
                        {% else %}
                            <i data-lucide="file-text" class="w-4 h-4 text-success-600 dark:text-success-400"></i>
                        {% endif %}
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-secondary-700 dark:text-secondary-300">{{ activity.message }}</p>
                        <p class="text-xs text-secondary-400 dark:text-secondary-500 mt-0.5">{{ activity.time }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Course Progress Section -->
    <div class="card overflow-hidden">
        <div class="p-5 border-b border-secondary-200 dark:border-secondary-800">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center">
                        <i data-lucide="graduation-cap" class="w-4 h-4 text-primary-600 dark:text-primary-400"></i>
                    </div>
                    <div>
                        <h2 class="font-semibold text-secondary-900 dark:text-white">Course Progress</h2>
                        <p class="text-sm text-secondary-500 dark:text-secondary-400">Track your learning journey</p>
                    </div>
                </div>
                <a href="{{ path('app_courses') }}" class="btn btn-secondary btn-sm">
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    View all
                </a>
            </div>
        </div>
        <div class="p-5">
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                {% for course in courses %}
                <a href="{{ path('app_courses_show', {id: course.id}) }}" class="group block p-4 rounded-xl border border-secondary-200 dark:border-secondary-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-soft-md transition-all">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-xl bg-{{ course.color }}-100 dark:bg-{{ course.color }}-900/30 flex items-center justify-center">
                            <i data-lucide="book-open" class="w-5 h-5 text-{{ course.color }}-600 dark:text-{{ course.color }}-400"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-semibold text-secondary-400 dark:text-secondary-500 uppercase tracking-wider">{{ course.code }}</p>
                            <p class="font-medium text-secondary-900 dark:text-white truncate group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{{ course.name }}</p>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-secondary-500 dark:text-secondary-400">Progress</span>
                            <span class="font-semibold text-secondary-900 dark:text-white">{{ course.progress }}%</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-bar-fill progress-bar-fill-primary" style="width: {{ course.progress }}%"></div>
                        </div>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="{{ path('app_assignments') }}?action=new" class="card card-interactive p-4 flex flex-col items-center text-center group">
            <div class="w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <i data-lucide="plus-circle" class="w-6 h-6 text-primary-600 dark:text-primary-400"></i>
            </div>
            <p class="font-medium text-secondary-900 dark:text-white">Add Assignment</p>
            <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">Track new tasks</p>
        </a>
        <a href="{{ path('app_planning') }}?action=new" class="card card-interactive p-4 flex flex-col items-center text-center group">
            <div class="w-12 h-12 rounded-xl bg-accent-100 dark:bg-accent-900/30 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <i data-lucide="calendar-plus" class="w-6 h-6 text-accent-600 dark:text-accent-400"></i>
            </div>
            <p class="font-medium text-secondary-900 dark:text-white">Schedule Event</p>
            <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">Plan your time</p>
        </a>
        <a href="{{ path('app_revisions') }}" class="card card-interactive p-4 flex flex-col items-center text-center group">
            <div class="w-12 h-12 rounded-xl bg-success-100 dark:bg-success-900/30 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <i data-lucide="brain" class="w-6 h-6 text-success-600 dark:text-success-400"></i>
            </div>
            <p class="font-medium text-secondary-900 dark:text-white">Start Revision</p>
            <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">Review flashcards</p>
        </a>
        <a href="{{ path('app_wellbeing') }}" class="card card-interactive p-4 flex flex-col items-center text-center group">
            <div class="w-12 h-12 rounded-xl bg-danger-100 dark:bg-danger-900/30 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                <i data-lucide="heart" class="w-6 h-6 text-danger-600 dark:text-danger-400"></i>
            </div>
            <p class="font-medium text-secondary-900 dark:text-white">Wellness Check</p>
            <p class="text-xs text-secondary-500 dark:text-secondary-400 mt-0.5">How are you feeling?</p>
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
